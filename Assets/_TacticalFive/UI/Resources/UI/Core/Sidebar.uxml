<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="Sidebar" class="sidebar">
        <ui:VisualElement class="sidebar-nav">
            <ui:Button name="NavDashboard" class="nav-item">
                <ui:VisualElement name="NavDashboardIcon" class="nav-icon"/>
                <ui:Label text="{loc:ui.core_sidebar.inicio}" class="nav-label"/>
            </ui:Button>
            <ui:Button name="NavRoster" class="nav-item">
                <ui:VisualElement name="NavRosterIcon" class="nav-icon"/>
                <ui:Label text="{loc:ui.core_sidebar.plantilla}" class="nav-label"/>
                <ui:Label text="▼" class="nav-arrow" />
            </ui:Button>
            <ui:VisualElement name="RosterSubmenu" class="nav-submenu">
                <ui:Button name="SubmenuJugadores" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.jugadores}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuQuinteto" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.quinteto}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuRotacion" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.rotacion}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuEntrenamiento" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.entrenamiento}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuEmpleados" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.empleados}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuLesionados" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.lesionados}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuDorsales" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.dorsales}" class="nav-submenu-label"/>
                </ui:Button>

            </ui:VisualElement>
            <ui:Button name="NavCalendar" class="nav-item">
                <ui:VisualElement name="NavCalendarIcon" class="nav-icon"/>
                <ui:Label text="{loc:ui.core_sidebar.calendario}" class="nav-label"/>
            </ui:Button>
            <ui:Button name="NavCompeticiones" class="nav-item">
                <ui:VisualElement name="NavCompeticionesIcon" class="nav-icon"/>
                <ui:Label text="{loc:ui.core_sidebar.competiciones}" class="nav-label"/>
                <ui:Label text="▼" class="nav-arrow" />
            </ui:Button>
            <ui:VisualElement name="CompetitionsSubmenu" class="nav-submenu">
                <ui:Button name="SubmenuResultados" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.resultados}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuClasificacion" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.clasificacion}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuInfoLiga" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.info_liga}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuGLeague" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.g_league}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuRivalidades" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.rivalidades}" class="nav-submenu-label"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:Button name="NavPalmares" class="nav-item">
                <ui:VisualElement name="NavPalmaresIcon" class="nav-icon"/>
                <ui:Label text="{loc:ui.core_sidebar.logros}" class="nav-label"/>
                <ui:Label text="▼" class="nav-arrow" />
            </ui:Button>
            <ui:VisualElement name="PalmaresSubmenu" class="nav-submenu">
                <ui:Button name="SubmenuPalmares" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.palmares}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuRecords" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.records}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuPremios" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.premios}" class="nav-submenu-label"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:Button name="NavPlayoffs" class="nav-item">
                <ui:VisualElement name="NavPlayoffsIcon" class="nav-icon"/>
                <ui:Label text="{loc:ui.core_sidebar.playoffs}" class="nav-label"/>
            </ui:Button>
            <ui:Button name="NavStats" class="nav-item">
                <ui:VisualElement name="NavStatsIcon" class="nav-icon"/>
                <ui:Label text="{loc:ui.core_sidebar.estadisticas}" class="nav-label"/>
            </ui:Button>
            <ui:Button name="NavMarket" class="nav-item">
                <ui:VisualElement name="NavMarketIcon" class="nav-icon" />
                <ui:Label class="nav-label" text="{loc:ui.core_sidebar.mercado}" />
                <ui:Label text="▼" class="nav-arrow" />
            </ui:Button>
            <ui:VisualElement name="MarketSubmenu" class="nav-submenu">
                <ui:Button name="SubmenuOfertas" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.ofertas}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuCartera" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.cartera}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuHistorial" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.historial}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuBuscador" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.buscador}" class="nav-submenu-label"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:Button name="NavFinances" class="nav-item">
                <ui:VisualElement name="NavFinancesIcon" class="nav-icon"/>
                <ui:Label class="nav-label" text="{loc:ui.core_sidebar.finanzas}" />
                <ui:Label text="▼" class="nav-arrow" />
            </ui:Button>
            <ui:VisualElement name="FinanceSubmenu" class="nav-submenu">
                <ui:Button name="SubmenuDecisiones" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.decisiones}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuPrestamos" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.prestamos}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuSponsors" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.patrocinadores}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuTV" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.television}" class="nav-submenu-label"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:Button name="NavCity" class="nav-item">
                <ui:VisualElement name="NavCityIcon" class="nav-icon"/>
                <ui:Label text="{loc:ui.core_sidebar.la_ciudad}" class="nav-label"/>
                <ui:Label text="▼" class="nav-arrow" />
            </ui:Button>
            <ui:VisualElement name="CitySubmenu" class="nav-submenu">
                <ui:Button name="SubmenuVerCiudad" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.ver_ciudad}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuPabellon" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.pabellon}" class="nav-submenu-label"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:Button name="NavManager" class="nav-item">
                <ui:VisualElement name="NavManagerIcon" class="nav-icon"/>
                <ui:Label text="{loc:ui.core_sidebar.manager}" class="nav-label"/>
                <ui:Label text="▼" class="nav-arrow" />
            </ui:Button>
            <ui:VisualElement name="ManagerSubmenu" class="nav-submenu">
                <ui:Button name="SubmenuManager" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.info_manager}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuLogros" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.logros_del_gm}" class="nav-submenu-label"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:Button name="NavActualidad" class="nav-item">
                <ui:VisualElement name="NavActualidadIcon" class="nav-icon"/>
                <ui:Label text="{loc:ui.core_sidebar.actualidad}" class="nav-label"/>
                <ui:Label text="▼" class="nav-arrow" />
            </ui:Button>
            <ui:VisualElement name="ActualidadSubmenu" class="nav-submenu">
                <ui:Button name="SubmenuNoticias" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.noticias}" class="nav-submenu-label"/>
                </ui:Button>
                <ui:Button name="SubmenuHilos" class="nav-submenu-item">
                    <ui:Label text="{loc:ui.core_sidebar.hilos}" class="nav-submenu-label"/>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
