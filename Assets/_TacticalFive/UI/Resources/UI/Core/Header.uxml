<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="TopHeader" class="top-header">
        <ui:VisualElement class="header-brand">
            <ui:Label text="{loc:ui.core_header.tf}" class="header-brand-icon"/>
            <ui:Label text="{loc:ui.core_header.tactical}" class="header-brand-text"/>
            <ui:Label text="{loc:ui.core_header.five}" class="header-brand-text-gold"/>
        </ui:VisualElement>
        <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo" />
        <ui:VisualElement class="header-team-info">
            <ui:Label name="HeaderTeamName" class="header-team-name" text="" />
            <ui:Label name="HeaderManagerName" class="header-manager-name" text="" />
        </ui:VisualElement>
        <ui:VisualElement class="header-stat">
            <ui:Label class="header-stat-label" text="{loc:ui.core_header.presupuesto}" />
            <ui:Label name="HeaderBudget" class="header-stat-value" text="" />
        </ui:VisualElement>
        <ui:VisualElement class="header-stat">
            <ui:Label class="header-stat-label" text="{loc:ui.core_header.masa_salarial}" />
            <ui:Label name="HeaderPayroll" class="header-stat-value header-stat-value--neutral" text="" />
        </ui:VisualElement>
        <ui:VisualElement class="header-stat">
            <ui:Label class="header-stat-label" text="{loc:ui.core_header.margen_salarial}" />
            <ui:Label name="HeaderMargin" class="header-stat-value" text="" />
        </ui:VisualElement>
        <ui:VisualElement class="header-stat">
            <ui:Label class="header-stat-label" text="{loc:ui.core_header.quimica_de_equipo}" />
            <ui:Label name="HeaderChemistry" class="header-stat-value" text="" />
        </ui:VisualElement>
        <ui:VisualElement class="header-spacer" />
        <ui:VisualElement class="header-season-info">
            <ui:Label name="HeaderSeason" class="header-season-label" text="" />
            <ui:Label name="HeaderDate" class="header-date-label" text="" />
        </ui:VisualElement>
        <ui:Button name="BtnAction" class="btn-action" text="{loc:ui.core_header.btn_action}" />
        <ui:VisualElement name="ConfigIcon" class="header-config-icon" />
    </ui:VisualElement>
</ui:UXML>
