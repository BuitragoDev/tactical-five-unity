/* === FLEX LAYOUTS === */

.flex-row {
    flex-direction: row;
}

.flex-col {
    flex-direction: column;
}

.flex-1 {
    flex-grow: 1;
}

.items-center {
    align-items: center;
}

.items-start {
    align-items: flex-start;
}

.justify-center {
    justify-content: center;
}

.justify-between {
    justify-content: space-between;
}

.justify-end {
    justify-content: flex-end;
}

/* === ESPACIADO === */

.p-0 { padding: 0; }
.p-4 { padding: 4px; }
.p-8 { padding: 8px; }
.p-12 { padding: 12px; }
.p-16 { padding: 16px; }
.p-24 { padding: 24px; }
.p-32 { padding: 32px; }
.p-40 { padding: 40px; }

.m-0 { margin: 0; }
.m-4 { margin: 4px; }
.m-8 { margin: 8px; }
.m-16 { margin: 16px; }

/* === TAMAÑOS === */

.w-full {
    width: 100%;
}

.h-full {
    height: 100%;
}

.w-100pct {
    width: 100%;
}

/* === BORDES === */

.border-0 {
    border-width: 0;
}

.rounded-4 {
    border-radius: 4px;
}

.rounded-8 {
    border-radius: 8px;
}
/* F7-03: ningún modal debe exceder el viewport de referencia. */
.modal-box,
.trade-modal-box,
.fired-modal-box,
.ns-roster-box,
.ns-option-box,
.editor-modal-box,
.market-fa-modal-box,
.market-trade-modal-box,
.offer-result-modal-box,
.renew-modal-box,
.recovery-modal-box,
.load-mgmt-modal-box,
.match-modal-box,
.training-modal-box,
.dismiss-modal-box,
.hire-modal-box,
.injured-modal-box,
.injury-modal-box,
.empty-modal-box,
.fastsim-modal-box,
.deadline-modal-box,
.lottery-box {
    max-width: 100%;
    max-height: 100%;
}
