:root {
    /* === FONDOS === */
    --bg-primary: rgb(11, 16, 23);
    --bg-secondary: rgb(17, 24, 34);
    --bg-card: rgb(20, 30, 42);
    --bg-modal: rgba(0, 0, 0, 0.8);

    /* === BORDES === */
    --border-default: rgb(30, 45, 61);
    --border-accent: rgb(42, 74, 107);

    /* === TEXTO === */
    --text-primary: rgb(255, 255, 255);
    --text-secondary: rgb(136, 153, 170);
    --text-muted: rgb(85, 102, 119);

    /* === ACENTOS === */
    --accent-blue: rgb(59, 130, 246);
    --accent-gold: rgb(245, 166, 35);
    --accent-green: rgb(34, 197, 94);

    /* === COMPONENTES === */
    --card-border-top: rgb(59, 130, 246);
    --rating-star: rgb(245, 166, 35);
    --rating-empty: rgb(42, 58, 74);

    /* === BOTONES === */
    --btn-primary-bg: rgb(59, 130, 246);
    --btn-back-bg: rgb(30, 45, 61);
}