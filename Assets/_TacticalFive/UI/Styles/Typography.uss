/* === TIPOGRAFÍA BASE === */

.text-xs {
    font-size: 10px;
    letter-spacing: 1px;
}

.text-sm {
    font-size: 12px;
    letter-spacing: 1px;
}

.text-base {
    font-size: 14px;
}

.text-md {
    font-size: 16px;
}

.text-lg {
    font-size: 20px;
    letter-spacing: 2px;
}

.text-xl {
    font-size: 28px;
    letter-spacing: 3px;
}

.text-2xl {
    font-size: 40px;
    letter-spacing: 4px;
}

.text-hero {
    font-size: 80px;
    letter-spacing: 6px;
}

/* === COLORES DE TEXTO === */

.text-white {
    color: rgb(255, 255, 255);
}

.text-secondary {
    color: rgb(136, 153, 170);
}

.text-muted {
    color: rgb(85, 102, 119);
}

.text-gold {
    color: rgb(245, 166, 35);
}

.text-blue {
    color: rgb(59, 130, 246);
}

.text-green {
    color: rgb(34, 197, 94);
}

/* === UTILIDADES === */

.uppercase {
    -unity-text-transform: upper;
}

.text-center {
    -unity-text-align: middle-center;
}

.text-left {
    -unity-text-align: middle-left;
}

.text-right {
    -unity-text-align: middle-right;
}