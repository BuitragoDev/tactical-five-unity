/* ══════════════════════════════════════════
   PLAYER AWARDS — PlayerAwards.uss
   ══════════════════════════════════════════ */

/* ── ROOT ── */
.pa-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ═══════════════════════════════════════════
   HEADER (copied from SeasonSummary)
   ═══════════════════════════════════════════ */
.pa-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 12px 28px;
    background-color: rgb(22, 26, 36);
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 160, 23);
    flex-shrink: 0;
    min-height: 80px;
}

.pa-header-left {
    flex-direction: row;
    align-items: center;
}

.pa-header-logo {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    margin-right: 16px;
}

.pa-header-info {
    flex-direction: column;
}

.pa-header-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
}

.pa-header-manager {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
}

.pa-header-right {
    flex-direction: row;
    align-items: center;
}

.pa-header-season {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    letter-spacing: 1px;
    margin-right: 16px;
}

.pa-header-date {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    padding: 0 16px;
    margin-right: 20px;
    border-left-width: 1px;
    border-left-color: rgb(42, 51, 71);
    border-right-width: 1px;
    border-right-color: rgb(42, 51, 71);
}

.pa-btn-quintos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    min-width: 250px;
    background-color: rgba(42, 95, 201, 0.10);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(120, 160, 230);
    font-size: 22px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 18px;
    -unity-text-align: middle-center;
    border-radius: 8px;
    flex-shrink: 0;
    cursor: pointer;
}
.pa-btn-quintos:hover {
    background-color: rgba(42, 95, 201, 0.25);
    color: rgb(150, 190, 255);
}

/* ═══════════════════════════════════════════
   SCREEN HEADER
   ═══════════════════════════════════════════ */
.pa-screen-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 48px 32px;
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/Backgrounds/banner_premios.png");
    background-size: cover;
    background-position: center;
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 160, 23);
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
}

.pa-screen-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(22, 26, 36, 0.82);
}

.pa-screen-header-left {
    flex-direction: row;
    align-items: center;
}

.pa-screen-title-group {
    flex-direction: column;
}

.pa-screen-title-row {
    flex-direction: row;
    align-items: center;
}

.pa-screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 56px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
    margin-right: 16px;
}

.pa-season-badge {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
    font-size: 24px;
    letter-spacing: 2px;
    padding: 4px 12px;
    -unity-text-transform: upper;
}

.pa-screen-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 22px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    margin-top: 4px;
}

/* ═══════════════════════════════════════════
   CONTENT AREA
   ═══════════════════════════════════════════ */
.pa-awards-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 24px 28px;
    overflow-y: auto;
}

/* ═══════════════════════════════════════════
   PLAYER AWARDS ROW (5 cards)
   ═══════════════════════════════════════════ */
.pa-player-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 20px;
    min-height: 400px;
}

.pa-player-card {
    flex-direction: column;
    align-items: center;
    background-color: rgb(17, 24, 34);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 12px 14px 16px 14px;
    flex-grow: 1;
    margin-right: 12px;
    position: relative;
}
.pa-player-card:last-child {
    margin-right: 0;
}

.pa-player-card--gold {
    border-color: rgb(212, 160, 23);
    border-width: 2px;
}

/* ── BADGE ROW ── */
.pa-card-badge-row {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    margin-bottom: 10px;
}

.pa-badge-icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin-right: 8px;
    background-size: contain;
    background-position: center;
}

.pa-badge-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(122, 138, 170);
}

/* ── PHOTO AREA ── */
.pa-photo-area {
    width: 150px;
    height: 150px;
    position: relative;
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
}

.pa-player-photo {
    width: 150px;
    height: 150px;
    background-size: cover;
    background-position: top center;
}

.pa-team-logo-overlay {
    position: absolute;
    top: 50%;
    right: -47px;
    width: 64px;
    height: 64px;
    background-size: contain;
    background-position: center;
}

.pa-team-logo-overlay--small {
    width: 64px;
    height: 64px;
}

/* ── PLAYER INFO ── */
.pa-player-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.pa-player-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

/* ── STATS ROW ── */
.pa-stats-row {
    flex-direction: row;
    justify-content: center;
}

.pa-stat-box {
    flex-direction: column;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 4px 12px;
    min-width: 52px;
    margin-right: 8px;
}
.pa-stat-box:last-child {
    margin-right: 0;
}

.pa-stat-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.pa-stat-lbl {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

/* ═══════════════════════════════════════════
   TEAM / STAFF AWARDS ROW (3 cards)
   ═══════════════════════════════════════════ */
.pa-team-row {
    flex-direction: row;
    justify-content: center;
}

.pa-team-card {
    flex-direction: column;
    align-items: center;
    background-color: rgb(17, 24, 34);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 12px 14px 16px 14px;
    flex-grow: 1;
    margin-right: 12px;
}
.pa-team-card:last-child {
    margin-right: 0;
}

.pa-team-card-body {
    flex-direction: column;
    align-items: center;
}

/* ── COACH PHOTO ── */
.pa-coach-photo-wrapper {
    width: 100px;
    height: 100px;
    position: relative;
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
}

.pa-coach-logo {
    width: 100px;
    height: 100px;
    background-size: contain;
    background-position: center;
}

/* ── BIG TEAM LOGO ── */
.pa-big-team-logo {
    width: 100px;
    height: 100px;
    margin-bottom: 10px;
    background-size: contain;
    background-position: center;
}

/* ── RECORD DISPLAY ── */
.pa-record-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.pa-record-lbl {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 11px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    -unity-text-transform: upper;
    -unity-text-align: middle-center;
}
