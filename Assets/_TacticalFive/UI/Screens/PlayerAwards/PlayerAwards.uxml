<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_TacticalFive/UI/Screens/PlayerAwards/PlayerAwards.uss"/>
    <ui:VisualElement name="PlayerAwardsRoot" class="pa-root">

        <!-- HEADER (SeasonSummary style) -->
        <ui:VisualElement class="pa-header">
            <ui:VisualElement class="pa-header-left">
                <ui:VisualElement name="HeaderTeamLogo" class="pa-header-logo"/>
                <ui:VisualElement class="pa-header-info">
                    <ui:Label name="HeaderTeamName" class="pa-header-team" text=""/>
                    <ui:Label name="HeaderManagerName" class="pa-header-manager" text=""/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="pa-header-right">
                <ui:Label name="HeaderSeason" class="pa-header-season" text=""/>
                <ui:Label name="HeaderDate" class="pa-header-date" text=""/>
                <ui:Button name="BtnGoQuintos" class="pa-btn-quintos" text="VER QUINTETOS"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- SCREEN HEADER -->
        <ui:VisualElement class="pa-screen-header">
            <ui:VisualElement class="pa-screen-overlay"/>
            <ui:VisualElement class="pa-screen-title-group">
                <ui:VisualElement class="pa-screen-title-row">
                    <ui:Label text="PREMIOS INDIVIDUALES" class="pa-screen-title"/>
                    <ui:Label name="SeasonTag" text="" class="pa-season-badge"/>
                </ui:VisualElement>
                <ui:Label text="MEJORES JUGADORES DE LA TEMPORADA" class="pa-screen-subtitle"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- PLAYER AWARDS ROW -->
        <ui:VisualElement class="pa-awards-content">
            <ui:VisualElement class="pa-player-row">

                <!-- MVP -->
                <ui:VisualElement class="pa-player-card pa-player-card--gold">
                    <ui:VisualElement class="pa-card-badge-row">
                        <ui:VisualElement name="MvpBadgeIcon" class="pa-badge-icon"/>
                        <ui:Label text="MVP DE LA TEMPORADA" class="pa-badge-text"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="pa-photo-area">
                        <ui:VisualElement name="MvpPhoto" class="pa-player-photo"/>
                        <ui:VisualElement name="MvpTeamLogo" class="pa-team-logo-overlay"/>
                    </ui:VisualElement>
                    <ui:Label name="MvpName" text="" class="pa-player-name"/>
                    <ui:Label name="MvpTeam" text="" class="pa-player-team"/>
                    <ui:VisualElement class="pa-stats-row">
                        <ui:VisualElement class="pa-stat-box">
                            <ui:Label name="MvpPts" text="--" class="pa-stat-val"/>
                            <ui:Label text="PTS" class="pa-stat-lbl"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="pa-stat-box">
                            <ui:Label name="MvpReb" text="--" class="pa-stat-val"/>
                            <ui:Label text="REB" class="pa-stat-lbl"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="pa-stat-box">
                            <ui:Label name="MvpAst" text="--" class="pa-stat-val"/>
                            <ui:Label text="AST" class="pa-stat-lbl"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- DPOY -->
                <ui:VisualElement class="pa-player-card">
                    <ui:VisualElement class="pa-card-badge-row">
                        <ui:VisualElement name="DpoyBadgeIcon" class="pa-badge-icon"/>
                        <ui:Label text="MEJOR DEFENSOR" class="pa-badge-text"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="pa-photo-area">
                        <ui:VisualElement name="DpoyPhoto" class="pa-player-photo"/>
                        <ui:VisualElement name="DpoyTeamLogo" class="pa-team-logo-overlay"/>
                    </ui:VisualElement>
                    <ui:Label name="DpoyName" text="" class="pa-player-name"/>
                    <ui:Label name="DpoyTeam" text="" class="pa-player-team"/>
                    <ui:VisualElement class="pa-stats-row">
                        <ui:VisualElement class="pa-stat-box">
                            <ui:Label name="DpoyPts" text="--" class="pa-stat-val"/>
                            <ui:Label text="ROB" class="pa-stat-lbl"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="pa-stat-box">
                            <ui:Label name="DpoyReb" text="--" class="pa-stat-val"/>
                            <ui:Label text="TAP" class="pa-stat-lbl"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ROOKIE -->
                <ui:VisualElement class="pa-player-card">
                    <ui:VisualElement class="pa-card-badge-row">
                        <ui:VisualElement name="RookieBadgeIcon" class="pa-badge-icon"/>
                        <ui:Label text="MEJOR NOVATO" class="pa-badge-text"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="pa-photo-area">
                        <ui:VisualElement name="RookiePhoto" class="pa-player-photo"/>
                        <ui:VisualElement name="RookieTeamLogo" class="pa-team-logo-overlay"/>
                    </ui:VisualElement>
                    <ui:Label name="RookieName" text="" class="pa-player-name"/>
                    <ui:Label name="RookieTeam" text="" class="pa-player-team"/>
                    <ui:VisualElement class="pa-stats-row">
                        <ui:VisualElement class="pa-stat-box">
                            <ui:Label name="RookiePts" text="--" class="pa-stat-val"/>
                            <ui:Label text="PTS" class="pa-stat-lbl"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="pa-stat-box">
                            <ui:Label name="RookieReb" text="--" class="pa-stat-val"/>
                            <ui:Label text="REB" class="pa-stat-lbl"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="pa-stat-box">
                            <ui:Label name="RookieAst" text="--" class="pa-stat-val"/>
                            <ui:Label text="AST" class="pa-stat-lbl"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- SIXTH MAN -->
                <ui:VisualElement class="pa-player-card">
                    <ui:VisualElement class="pa-card-badge-row">
                        <ui:VisualElement name="SixthBadgeIcon" class="pa-badge-icon"/>
                        <ui:Label text="MEJOR SEXTO HOMBRE" class="pa-badge-text"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="pa-photo-area">
                        <ui:VisualElement name="SixthPhoto" class="pa-player-photo"/>
                        <ui:VisualElement name="SixthTeamLogo" class="pa-team-logo-overlay"/>
                    </ui:VisualElement>
                    <ui:Label name="SixthName" text="" class="pa-player-name"/>
                    <ui:Label name="SixthTeam" text="" class="pa-player-team"/>
                    <ui:VisualElement class="pa-stats-row">
                        <ui:VisualElement class="pa-stat-box">
                            <ui:Label name="SixthPts" text="--" class="pa-stat-val"/>
                            <ui:Label text="PTS" class="pa-stat-lbl"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="pa-stat-box">
                            <ui:Label name="SixthReb" text="--" class="pa-stat-val"/>
                            <ui:Label text="REB" class="pa-stat-lbl"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="pa-stat-box">
                            <ui:Label name="SixthAst" text="--" class="pa-stat-val"/>
                            <ui:Label text="AST" class="pa-stat-lbl"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- MIP -->
                <ui:VisualElement class="pa-player-card">
                    <ui:VisualElement class="pa-card-badge-row">
                        <ui:VisualElement name="MipBadgeIcon" class="pa-badge-icon"/>
                        <ui:Label text="JUGADOR MÁS MEJORADO" class="pa-badge-text"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="pa-photo-area">
                        <ui:VisualElement name="MipPhoto" class="pa-player-photo"/>
                        <ui:VisualElement name="MipTeamLogo" class="pa-team-logo-overlay"/>
                    </ui:VisualElement>
                    <ui:Label name="MipName" text="" class="pa-player-name"/>
                    <ui:Label name="MipTeam" text="" class="pa-player-team"/>
                    <ui:VisualElement class="pa-stats-row">
                        <ui:VisualElement class="pa-stat-box">
                            <ui:Label name="MipPts" text="--" class="pa-stat-val"/>
                            <ui:Label text="PTS" class="pa-stat-lbl"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="pa-stat-box">
                            <ui:Label name="MipReb" text="--" class="pa-stat-val"/>
                            <ui:Label text="REB" class="pa-stat-lbl"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="pa-stat-box">
                            <ui:Label name="MipAst" text="--" class="pa-stat-val"/>
                            <ui:Label text="AST" class="pa-stat-lbl"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- TEAM / STAFF AWARDS ROW -->
            <ui:VisualElement class="pa-team-row">

                <!-- COACH -->
                <ui:VisualElement class="pa-team-card">
                    <ui:VisualElement class="pa-card-badge-row">
                        <ui:VisualElement name="CoachBadgeIcon" class="pa-badge-icon"/>
                        <ui:Label text="ENTRENADOR DEL AÑO" class="pa-badge-text"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="pa-team-card-body">
                        <ui:VisualElement name="CoachPhoto" class="pa-big-team-logo"/>
                        <ui:Label name="CoachName" text="" class="pa-player-name"/>
                        <ui:Label name="CoachTeam" text="" class="pa-player-team"/>
                        <ui:Label name="CoachRecord" text="" class="pa-record-val"/>
                        <ui:Label name="CoachRecordLabel" text="RÉCORD" class="pa-record-lbl"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- BEST TEAM -->
                <ui:VisualElement class="pa-team-card">
                    <ui:VisualElement class="pa-card-badge-row">
                        <ui:VisualElement name="BestBadgeIcon" class="pa-badge-icon"/>
                        <ui:Label text="MEJOR EQUIPO" class="pa-badge-text"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="pa-team-card-body">
                        <ui:VisualElement name="BestTeamLogo" class="pa-big-team-logo"/>
                        <ui:Label name="BestTeamName" text="" class="pa-player-name"/>
                        <ui:Label name="BestTeamRecord" text="" class="pa-record-val"/>
                        <ui:Label text="TEMPORADA REGULAR" class="pa-record-lbl"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- WORST TEAM -->
                <ui:VisualElement class="pa-team-card">
                    <ui:VisualElement class="pa-card-badge-row">
                        <ui:VisualElement name="WorstBadgeIcon" class="pa-badge-icon"/>
                        <ui:Label text="PEOR EQUIPO" class="pa-badge-text"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="pa-team-card-body">
                        <ui:VisualElement name="WorstTeamLogo" class="pa-big-team-logo"/>
                        <ui:Label name="WorstTeamName" text="" class="pa-player-name"/>
                        <ui:Label name="WorstTeamRecord" text="" class="pa-record-val"/>
                        <ui:Label text="TEMPORADA REGULAR" class="pa-record-lbl"/>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
