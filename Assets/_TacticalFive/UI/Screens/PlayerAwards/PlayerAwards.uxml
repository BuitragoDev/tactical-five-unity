<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_TacticalFive/UI/Screens/PlayerAwards/PlayerAwards.uss?fileID=7433441132597879392&amp;guid=d84a42483e87475d908d9da695768c14&amp;type=3#PlayerAwards"/>
    <ui:VisualElement name="PlayerAwardsRoot" class="player-awards-root">
        <ui:VisualElement name="TopHeader" class="top-header">
            <ui:VisualElement class="header-left">
                <ui:VisualElement class="header-brand">
                    <ui:Label text="TF" class="header-brand-icon"/>
                    <ui:Label text="TACTICAL" class="header-brand-text"/>
                    <ui:Label text="FIVE" class="header-brand-text-gold"/>
                </ui:VisualElement>
                <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo"/>
                <ui:VisualElement class="header-team-info">
                    <ui:VisualElement class="header-team-name-row">
                        <ui:Label name="HeaderTeamName" class="header-team-name" text=""/>
                        <ui:Label name="HeaderSubtitle" class="header-subtitle" text="(PREMIOS DE JUGADORES)"/>
                    </ui:VisualElement>
                    <ui:Label name="HeaderManagerName" class="header-manager-name" text=""/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="header-right-group">
                <ui:VisualElement class="header-season-info">
                    <ui:Label name="HeaderSeason" class="header-season-label" text=""/>
                </ui:VisualElement>
                <ui:Label name="HeaderDate" class="header-date-label" text=""/>
                <ui:Button name="BtnGoQuintos" class="btn-action" text="VER QUINTETOS"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ContentArea" class="content-area">
            <ui:VisualElement class="summary-header">
                <ui:Label text="Premios Individuales" class="summary-title"/>
                <ui:Label name="SeasonTag" text="" class="season-tag"/>
            </ui:VisualElement>
            <ui:VisualElement name="AwardsRow" class="awards-row">
                <ui:VisualElement name="MvpCard" class="award-card mvp-card">
                    <ui:Label text="MVP de la Temporada" class="award-label"/>
                    <ui:VisualElement class="award-photo-wrapper">
                        <ui:VisualElement name="MvpPlayerPhoto" class="award-player-photo"/>
                    </ui:VisualElement>
                    <ui:Label name="MvpPlayerName" text="" class="award-player-name"/>
                    <ui:Label name="MvpPlayerTeam" text="" class="award-player-team"/>
                    <ui:VisualElement class="award-stat-row">
                        <ui:VisualElement class="award-stat-box">
                            <ui:Label name="MvpPts" text="--" class="award-stat-val"/>
                            <ui:Label text="PTS" class="award-stat-lbl"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="award-stat-box">
                            <ui:Label name="MvpReb" text="--" class="award-stat-val"/>
                            <ui:Label text="REB" class="award-stat-lbl"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="award-stat-box">
                            <ui:Label name="MvpAst" text="--" class="award-stat-val"/>
                            <ui:Label text="AST" class="award-stat-lbl"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="RookieCard" class="award-card rookie-card">
                    <ui:Label text="Rookie del Año" class="award-label"/>
                    <ui:VisualElement class="award-photo-wrapper">
                        <ui:VisualElement name="RookiePlayerPhoto" class="award-player-photo"/>
                    </ui:VisualElement>
                    <ui:Label name="RookiePlayerName" text="" class="award-player-name"/>
                    <ui:Label name="RookiePlayerTeam" text="" class="award-player-team"/>
                    <ui:VisualElement class="award-stat-row">
                        <ui:VisualElement class="award-stat-box">
                            <ui:Label name="RookiePts" text="--" class="award-stat-val"/>
                            <ui:Label text="PTS" class="award-stat-lbl"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="award-stat-box">
                            <ui:Label name="RookieReb" text="--" class="award-stat-val"/>
                            <ui:Label text="REB" class="award-stat-lbl"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="award-stat-box">
                            <ui:Label name="RookieAst" text="--" class="award-stat-val"/>
                            <ui:Label text="AST" class="award-stat-lbl"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="ExtraAwardsRow" class="extra-awards-row">
                <ui:VisualElement name="DpoyCard" class="extra-card dpoy-card">
                    <ui:Label text="Mejor Defensor" class="extra-card-title"/>
                    <ui:VisualElement class="award-photo-wrapper extra-photo">
                        <ui:VisualElement name="DpoyPlayerPhoto" class="award-player-photo"/>
                    </ui:VisualElement>
                    <ui:Label name="DpoyPlayerName" text="" class="extra-player-name"/>
                    <ui:Label name="DpoyPlayerTeam" text="" class="extra-player-team"/>
                    <ui:VisualElement class="award-stat-row extra-stat-row">
                        <ui:VisualElement class="award-stat-box">
                            <ui:Label name="DpoyStl" text="--" class="award-stat-val"/>
                            <ui:Label text="ROB" class="award-stat-lbl"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="award-stat-box">
                            <ui:Label name="DpoyBlk" text="--" class="award-stat-val"/>
                            <ui:Label text="TAP" class="award-stat-lbl"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="extra-card sixth-card">
                    <ui:Label text="Sexto Hombre" class="extra-card-title"/>
                    <ui:VisualElement class="award-photo-wrapper extra-photo">
                        <ui:VisualElement name="SixthPlayerPhoto" class="award-player-photo"/>
                    </ui:VisualElement>
                    <ui:Label name="SixthPlayerName" text="" class="extra-player-name"/>
                    <ui:Label name="SixthPlayerTeam" text="" class="extra-player-team"/>
                    <ui:VisualElement class="award-stat-row extra-stat-row">
                        <ui:VisualElement class="award-stat-box">
                            <ui:Label name="SixthPts" text="--" class="award-stat-val"/>
                            <ui:Label text="PTS" class="award-stat-lbl"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="award-stat-box">
                            <ui:Label name="SixthReb" text="--" class="award-stat-val"/>
                            <ui:Label text="REB" class="award-stat-lbl"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="award-stat-box">
                            <ui:Label name="SixthAst" text="--" class="award-stat-val"/>
                            <ui:Label text="AST" class="award-stat-lbl"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="extra-card mip-card">
                    <ui:Label text="Jugador Más Mejorado" class="extra-card-title"/>
                    <ui:VisualElement class="award-photo-wrapper extra-photo">
                        <ui:VisualElement name="MipPlayerPhoto" class="award-player-photo"/>
                    </ui:VisualElement>
                    <ui:Label name="MipPlayerName" text="" class="extra-player-name"/>
                    <ui:Label name="MipPlayerTeam" text="" class="extra-player-team"/>
                    <ui:VisualElement class="award-stat-row extra-stat-row">
                        <ui:VisualElement class="award-stat-box">
                            <ui:Label name="MipNow" text="--" class="award-stat-val"/>
                            <ui:Label text="AHORA" class="award-stat-lbl"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="award-stat-box">
                            <ui:Label name="MipPrev" text="--" class="award-stat-val"/>
                            <ui:Label text="ANTES" class="award-stat-lbl"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="extra-card coach-card">
                    <ui:Label text="Entrenador del Año" class="extra-card-title"/>
                    <ui:VisualElement class="award-photo-wrapper extra-photo">
                        <ui:VisualElement name="CoachPlayerPhoto" class="extra-coach-logo"/>
                    </ui:VisualElement>
                    <ui:Label name="CoachPlayerName" text="" class="extra-player-name"/>
                    <ui:Label name="CoachPlayerTeam" text="" class="extra-player-team"/>
                    <ui:VisualElement class="award-stat-row extra-stat-row">
                        <ui:VisualElement class="award-stat-box">
                            <ui:Label name="CoachCount" text="--" class="award-stat-val"/>
                            <ui:Label text="ENTRENADOR DEL MES" class="extra-stat-lbl-long"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>