/* ══════════════════════════════════════════
   PRESEASON — Preseason.uss
   ══════════════════════════════════════════ */

/* ── ROOT ── */
.preseason-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ── HEADER ── */
.header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    height: 100px;
    background-color: rgb(22, 26, 36);
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 160, 23);
    flex-shrink: 0;
}
.btn-back {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 200px;
    background-color: rgb(20, 28, 45);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(100, 160, 230);
    font-size: 24px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 10px 26px;
    -unity-text-align: middle-center;
    border-radius: 8px;
}
.btn-back:hover {
    background-color: rgb(24, 40, 71);
    color: rgb(140, 190, 255);
}
.header-title {
    flex-direction: row;
    align-items: center;
}
.header-title-white {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(255, 255, 255);
    font-size: 32px;
    letter-spacing: 3px;
    text-transform: uppercase;
}
.header-title-gold {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(212, 160, 23);
    font-size: 32px;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-left: 6px;
    margin-right: 6px;
}
.btn-continue {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 200px;
    background-color: rgb(20, 36, 35);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    color: rgb(100, 200, 140);
    font-size: 24px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 10px 26px;
    -unity-text-align: middle-center;
    border-radius: 8px;
}
.btn-continue:hover {
    background-color: rgb(23, 59, 45);
    color: rgb(140, 220, 170);
}
.btn-continue:disabled {
    background-color: rgb(25, 28, 36);
    border-color: rgb(100, 110, 130);
    color: rgb(100, 110, 130);
}

/* ── INFO BAR ── */
.info-bar {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 100px;
    padding: 0 40px;
    background-color: rgb(17, 24, 34);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}
.info-bar-logo {
    width: 64px;
    height: 64px;
    margin-right: 12px;
    flex-shrink: 0;
}
.info-bar-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(255, 255, 255);
    margin-right: 24px;
}
.info-bar-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(122, 138, 170);
}
.info-bar-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(212, 160, 23);
    margin-left: 8px;
    margin-right: 32px;
}

/* ── CONTENT AREA (slots) ── */
.content-area {
    flex-direction: row;
    flex-shrink: 0;
    padding: 16px 24px;
    background-color: rgb(15, 17, 23);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
}

/* ── SLOTS ROW ── */
.slots-row {
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
}

/* Slot individual */
.game-slot {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    margin: 0 6px;
    padding: 14px 10px;
    height: 230px;
    overflow: hidden;
}
.game-slot--empty {
    justify-content: center;
    border-color: rgb(42, 51, 71);
}
.game-slot--filled {
    border-color: rgb(58, 74, 99);
    background-color: rgb(20, 26, 38);
}

/* Número del slot */
.game-slot-number {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgb(58, 74, 99);
    margin-bottom: 10px;
    -unity-text-align: middle-center;
    width: 100%;
    flex-shrink: 0;
}
.game-slot-number--filled {
    color: rgb(212, 160, 23);
}

/* Cuerpo de 2 columnas */
.game-slot-body {
    flex-direction: row;
    align-items: stretch;
    width: 100%;
    flex-grow: 1;
}
.game-slot-left {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-basis: 50%;
    padding-right: 6px;
}
.game-slot-right {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-basis: 50%;
    padding-left: 6px;
}

/* Logo rival en slot */
.game-slot-logo {
    width: 120px;
    height: 120px;
    margin-bottom: 6px;
    flex-shrink: 0;
}

/* Nombre rival en slot */
.game-slot-rival {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    white-space: normal;
    width: 100%;
    flex-shrink: 0;
}

/* Badge LOCAL / VISITANTE */
.game-slot-location {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 2px;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
    flex-shrink: 0;
}
.game-slot-location--home {
    background-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
}
.game-slot-location--away {
    background-color: rgb(42, 51, 71);
    color: rgb(122, 138, 170);
}

/* Fecha en slot */
.game-slot-date {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 22px;
    letter-spacing: 1px;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
    width: 100%;
    flex-shrink: 0;
}

/* Texto vacío */
.game-slot-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(42, 51, 71);
    -unity-text-align: middle-center;
}

/* Botón quitar en slot */
.btn-remove-slot {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(35, 25, 30);
    border-width: 2px;
    border-color: rgb(192, 57, 43);
    border-radius: 8px;
    color: rgb(230, 120, 100);
    font-size: 16px;
    letter-spacing: 1px;
    padding: 8px 12px;
    flex-shrink: 0;
    margin-top: 44px;
    min-width: 120px;
    -unity-text-align: middle-center;
}
.btn-remove-slot:hover {
    background-color: rgb(62, 30, 32);
    color: rgb(240, 145, 125);
}

/* ── BOTTOM AREA ── */
.bottom-area {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    padding: 16px 24px;
}

/* Toggle LOCAL / VISITANTE */
.location-toggle {
    flex-direction: row;
    margin-bottom: 14px;
    margin-left: 10px;
    flex-shrink: 0;
    width: 300px;
}
.toggle-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    color: rgb(122, 138, 170);
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    min-height: 48px;
    padding: 12px 10px;
    -unity-text-align: middle-center;
}
.location-toggle-icon {
    position: absolute;
    left: 10px;
    top: 50%;
    width: 22px;
    height: 22px;
    margin-top: -11px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}
.toggle-btn--left {
    margin-right: 4px;
}
#BtnAway {
    padding-left: 26px;
}
.toggle-btn--active {
    background-color: rgb(42, 95, 201);
    border-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
}

/* Scroll del grid (barra propia: viewport + content + track/thumb) */
.teams-scroll-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}
.teams-viewport {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    position: relative;
}
.teams-scrollbar {
    width: 12px;
    min-width: 12px;
    flex-shrink: 0;
    align-self: stretch;
    margin-left: 4px;
    background-color: rgb(18, 24, 34);
    border-left-width: 1px;
    border-left-color: rgb(26, 47, 89);
    position: relative;
}
.teams-scrollbar-thumb {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 0;
    height: 40px;
    background-color: rgb(42, 95, 201);
    border-radius: 3px;
}
.teams-scrollbar:hover .teams-scrollbar-thumb {
    background-color: rgb(70, 130, 230);
}

/* Grid de equipos */
.teams-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    flex-shrink: 0;
    padding: 4px;
}

/* Item de equipo */
.team-item {
    width: 147px;
    height: 140px;
    margin: 5px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 2px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    flex-shrink: 0;
    padding: 8px 4px;
}
.team-item:hover {
    border-color: rgb(58, 74, 99);
    background-color: rgb(28, 33, 48);
}
.team-item--used {
    opacity: 0.3;
}
.team-logo {
    width: 80px;
    height: 80px;
    margin-bottom: 6px;
}
.team-overall {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-center;
}
