.allstar-root {
    flex-grow: 1;
    flex-direction: row;
    background-color: rgb(10, 11, 15);
}

.allstar-main {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
}

/* ── SCREEN HEADER ── */

.allstar-screen-header {
    flex-shrink: 0;
    margin: 16px 20px 12px 20px;
    padding: 0;
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    background-color: rgba(120, 95, 30, 0.15);
    border-radius: 4px;
    overflow: hidden;
}

.allstar-screen-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    background-color: rgba(120, 95, 30, 0.15);
}

.allstar-screen-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.allstar-screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
}

.allstar-screen-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(212, 160, 23);
    padding: 4px 14px;
    background-color: rgba(120, 95, 30, 0.15);
}

/* ── CONTENT ── */

.allstar-content {
    flex-grow: 1;
    flex-direction: column;
    padding: 0 20px 16px 20px;
    min-height: 0;
}

.allstar-tabs {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 12px;
}

.allstar-page {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
}

.allstar-tables-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.allstar-panel {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    border-width: 1px;
    border-color: rgb(120, 95, 30);
    background-color: rgb(18, 21, 28);
    border-radius: 4px;
    margin-right: 12px;
    min-width: 0;
}

.allstar-panel--wide {
    margin-right: 0;
}

.allstar-panel-header {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    background-color: rgba(120, 95, 30, 0.15);
    border-bottom-width: 1px;
    border-bottom-color: rgb(120, 95, 30);
}

.allstar-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
}

.allstar-table-wrapper {
    flex-direction: column;
    flex-grow: 1;
    padding: 6px 10px 10px 10px;
    min-height: 0;
}

.allstar-header-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

.allstar-table {
    flex-direction: column;
    flex-grow: 1;
}

.allstar-row {
    flex-direction: row;
    align-items: center;
    height: 34px;
    min-height: 34px;
    flex-shrink: 0;
    padding: 0 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 51, 71, 0.4);
}

.allstar-row--starter {
    background-color: rgba(212, 160, 23, 0.10);
}

.allstar-row--my-team {
    border-left-width: 3px;
    border-left-color: rgb(212, 160, 23);
}

.allstar-col-pos {
    width: 40px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    color: rgb(212, 160, 23);
}

.allstar-col-name {
    flex-grow: 1;
    min-width: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(220, 226, 240);
    white-space: nowrap;
    overflow: hidden;
}

.allstar-col-team {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    margin: 0 6px;
}

.allstar-col-ovr {
    width: 46px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(179, 190, 214);
}

.allstar-col-score {
    width: 60px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(150, 162, 190);
}

.allstar-col-role {
    width: 92px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    padding: 3px 0;
    border-radius: 6px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 13px;
    letter-spacing: 1px;
}

.allstar-col-role--starter {
    color: rgb(255, 214, 120);
    background-color: rgba(212, 160, 23, 0.22);
    border-width: 1px;
    border-color: rgb(212, 160, 23);
}

.allstar-col-role--reserve {
    color: rgb(150, 162, 190);
    background-color: rgba(42, 51, 71, 0.6);
    border-width: 1px;
    border-color: rgb(70, 82, 110);
}

.allstar-hint-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-top: 12px;
}

.allstar-hint {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 15px;
    color: rgb(150, 162, 190);
    flex-grow: 1;
    min-width: 0;
    white-space: normal;
}

.allstar-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgba(39, 174, 96, 0.10);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    color: rgb(100, 200, 140);
    font-size: 16px;
    letter-spacing: 1px;
    padding: 8px 18px;
    -unity-text-align: middle-center;
    border-radius: 8px;
    cursor: pointer;
    white-space: nowrap;
}

.allstar-btn:hover {
    background-color: rgba(39, 174, 96, 0.25);
}

.allstar-medal {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    margin-right: 6px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.allstar-empty {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(150, 162, 190);
    white-space: normal;
    padding: 14px;
}
