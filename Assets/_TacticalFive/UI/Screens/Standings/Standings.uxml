<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="Standings.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />

    <ui:VisualElement name="StandingsRoot" class="standings-root">

        <!-- ══ SIDEBAR ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="standings-main">

            <!-- SCREEN HEADER -->
            <ui:VisualElement class="standings-screen-header panel--gold">
                <ui:VisualElement class="standings-screen-header-row">
                    <ui:VisualElement name="StandingsScreenIcon" class="standings-screen-icon" />
                    <ui:Label text="{loc:ui.standings.clasificacion}" class="standings-screen-title" />
                </ui:VisualElement>
                <ui:Label name="StandingsSubtitle" text="" class="standings-screen-subtitle" />
            </ui:VisualElement>

            <!-- STANDINGS CONTENT -->
            <ui:VisualElement class="standings-content">

                <!-- LEFT: standings table (75%) -->
                <ui:VisualElement class="standings-left">
                    <!-- Conference tabs -->
                    <ui:VisualElement class="standings-tabs">
                        <ui:Button name="TabEast" class="standings-tab" text="{loc:ui.standings.tab_east}" />
                        <ui:Button name="TabWest" class="standings-tab" text="{loc:ui.standings.tab_west}" />
                        <ui:Button name="TabCup" class="standings-tab" text="{loc:ui.standings.tab_cup}" />
                    </ui:VisualElement>
                    <ui:VisualElement name="CupTabs" class="standings-cup-tabs" style="display:none">
                        <ui:Button name="CupTabEast" class="standings-tab standings-cup-tab" text="{loc:ui.standings.cup_tab_east}" />
                        <ui:Button name="CupTabWest" class="standings-tab standings-cup-tab" text="{loc:ui.standings.cup_tab_west}" />
                        <ui:Button name="CupTabKnockout" class="standings-tab standings-cup-tab" text="{loc:ui.standings.cup_tab_knockout}" />
                    </ui:VisualElement>

                    <!-- Standings table -->
                    <ui:ScrollView class="standings-scroll"
                                   horizontal-scrolling-enabled="false"
                                   mode="Vertical">
                        <ui:VisualElement class="standings-table-container">
                            <!-- Header row -->
                            <ui:VisualElement name="StandingsHeaderRow" class="standings-header-row">
                                <ui:Label class="col-rank col-stat--header" text="#" />
                                <ui:VisualElement class="col-logo-space" />
                                <ui:Label class="col-team-name col-stat--header" text="{loc:ui.standings.equipo}" />
                                <ui:Label class="col-stat col-stat--header" text="{loc:ui.standings.pj}" />
                                <ui:Label class="col-stat col-stat--header" text="{loc:ui.standings.g}" />
                                <ui:Label class="col-stat col-stat--header" text="{loc:ui.standings.p}" />
                                <ui:Label class="col-stat col-stat--header" text="%" />
                                <ui:Label class="col-diff col-stat--header" text="{loc:ui.standings.dif}" />
                                <ui:Label class="col-streak col-stat--header" text="{loc:ui.standings.racha}" />
                                <ui:Label class="col-last10 col-stat--header" text="{loc:ui.standings.ult_10}" />
                            </ui:VisualElement>

                            <!-- Body -->
                            <ui:VisualElement name="StandingsBody" class="standings-table" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>

                <!-- RIGHT: stat cards (25%) -->
                <ui:VisualElement class="standings-right">
                    <ui:Label class="standings-right-title" text="{loc:ui.standings.lideres_de_la_temporada}" />
                    <ui:VisualElement name="CardBestAttack" class="stat-card">
                        <ui:Label class="stat-card-title" text="{loc:ui.standings.mejor_ataque}" />
                        <ui:VisualElement name="CardBestAttackLogo" class="stat-card-logo" />
                        <ui:Label name="CardBestAttackTeam" class="stat-card-team" text="" />
                        <ui:Label name="CardBestAttackValue" class="stat-card-value" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement name="CardBestDefense" class="stat-card">
                        <ui:Label class="stat-card-title" text="{loc:ui.standings.mejor_defensa}" />
                        <ui:VisualElement name="CardBestDefenseLogo" class="stat-card-logo" />
                        <ui:Label name="CardBestDefenseTeam" class="stat-card-team" text="" />
                        <ui:Label name="CardBestDefenseValue" class="stat-card-value" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement name="CardBestStreak" class="stat-card">
                        <ui:Label class="stat-card-title" text="{loc:ui.standings.mejor_racha}" />
                        <ui:VisualElement name="CardBestStreakLogo" class="stat-card-logo" />
                        <ui:Label name="CardBestStreakTeam" class="stat-card-team" text="" />
                        <ui:Label name="CardBestStreakValue" class="stat-card-value" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement name="CardWorstStreak" class="stat-card">
                        <ui:Label class="stat-card-title" text="{loc:ui.standings.peor_racha}" />
                        <ui:VisualElement name="CardWorstStreakLogo" class="stat-card-logo" />
                        <ui:Label name="CardWorstStreakTeam" class="stat-card-team" text="" />
                        <ui:Label name="CardWorstStreakValue" class="stat-card-value" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

        <!-- ══ MODAL CONFIGURACIÓN ══ -->
        <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigModalBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.standings.configuracion}" />
                <ui:VisualElement class="modal-body">
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.standings.audio}" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.standings.volumen_general}" />
                            <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.standings.musica}" />
                            <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.standings.efectos}" />
                            <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.standings.graficos}" />
                        <ui:VisualElement class="settings-quality-row">
                            <ui:Label class="settings-label" text="{loc:ui.standings.calidad}" />
                            <ui:VisualElement class="settings-quality-options">
                                <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="{loc:ui.standings.config_btn_quality_low}" />
                                <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="{loc:ui.standings.config_btn_quality_medium}" />
                                <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="{loc:ui.standings.config_btn_quality_high}" />
                                <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="{loc:ui.standings.config_btn_quality_ultra}" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.standings.juego}" />
                        <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="{loc:ui.standings.config_btn_main_menu}" />
                        <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="{loc:ui.standings.config_btn_exit}" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ConfigBtnCerrar" class="modal-close" text="{loc:ui.standings.config_btn_cerrar}" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR VOLVER AL MENÚ PRINCIPAL ══ -->
        <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.standings.volver_al_menu_principal}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.standings.estas_seguro_de_que_quieres_volver_al_me_6f548452}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.standings.se_perdera_el_progreso_no_guardado_de_la_b10b7334}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="{loc:ui.standings.config_btn_main_menu_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="{loc:ui.standings.config_btn_main_menu_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR SALIR DEL JUEGO ══ -->
        <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.standings.salir_del_juego}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.standings.estas_seguro_de_que_quieres_salir_del_ju_c65dd5f1}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.standings.tu_progreso_se_guarda_automaticamente_du_10fb1edb}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="{loc:ui.standings.config_btn_exit_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="{loc:ui.standings.config_btn_exit_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

</ui:UXML>
