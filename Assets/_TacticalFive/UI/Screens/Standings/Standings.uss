/* ══════════════════════════════════════════
   STANDINGS — Standings.uss
   ══════════════════════════════════════════ */

.standings-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.standings-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

/* ── SCREEN HEADER ── */
.standings-screen-header.panel--gold {
    flex-shrink: 0;
    padding: 0;
    margin: 16px 20px 12px 20px;
    border-color: rgb(212, 160, 23);
    border-width: 1px;
    background-color: rgb(33, 32, 28);
    border-radius: 4px;
    overflow: hidden;
}
.standings-screen-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    background-color: rgb(33, 32, 28);
}
.standings-screen-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.standings-screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    white-space: normal;
}
.standings-screen-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(212, 160, 23);
    padding: 0 14px;
    background-color: rgb(33, 32, 28);
}

.standings-left {
    flex-direction: column;
    flex-grow: 3;
    flex-basis: 0;
    min-height: 0;
    overflow: hidden;
    margin-right: 16px;
}

.standings-right {
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    overflow-y: auto;
    margin-top: 13px;
}

.standings-right-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(212, 160, 23);
    margin-bottom: 12px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.stat-card {
    flex-direction: column;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(120, 95, 30);
    padding: 8px 13px;
    margin-bottom: 8px;
    flex-shrink: 0;
    width: 100%;
}

.stat-card-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(58, 74, 99);
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}

.stat-card-logo {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    margin-bottom: 4px;
}

.stat-card-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: rgb(208, 216, 232);
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}

.stat-card-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-center;
}

.stat-card-unit {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    margin-left: 10px;
}

.standings-content {
    flex-direction: row;
    flex-grow: 1;
    padding: 20px 20px 10px 20px;
    min-height: 0;
}

.standings-tabs {
    flex-direction: row;
    margin-bottom: 16px;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
}

.standings-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 10px 16px;
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: transparent;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-right: 2px;
}

.standings-tab:hover {
    color: rgb(208, 216, 232);
}

.standings-tab--active {
    color: rgb(212, 160, 23);
    border-bottom-color: rgb(212, 160, 23);
    background-color: transparent;
}

/* Pestañas NBA Cup: comparten fila con las de conferencia. */
.standings-cup-tab {
    font-size: 16px;
    padding: 10px 12px;
    letter-spacing: 2px;
}

.standings-scroll {
    flex-grow: 1;
    min-height: 0;
}

.standings-table-container {
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 2px;
    overflow: hidden;
}

.standings-header-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 16px 10px 16px;
    min-height: 48px;
    background-color: rgb(17, 24, 34);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    flex-shrink: 0;
}

.standings-table {
    flex-direction: column;
    flex-grow: 1;
}

.standings-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 16px 10px 16px;
    min-height: 48px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}

.standings-row:hover {
    background-color: rgb(28, 33, 48);
}
.standings-row--cup {
    min-height: 40px;
    padding: 6px 16px;
}
.standings-cup-group {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: rgb(212, 160, 23);
    letter-spacing: 1px;
    margin: 6px 0 2px 10px;
}
.standings-cup-ko-header,
.standings-cup-ko-row {
    flex-direction: row;
    align-items: center;
    padding: 7px 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
}
.standings-cup-ko-header {
    min-height: 34px;
    background-color: rgb(17, 24, 34);
}
.standings-cup-ko-row {
    min-height: 46px;
    padding: 6px 16px;
}
.standings-cup-ko-header-team {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 12px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    text-transform: uppercase;
}
.standings-cup-ko-header-result {
    width: 150px;
    flex-shrink: 0;
    font-size: 12px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    text-transform: uppercase;
}
.standings-cup-ko-team {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    min-width: 0;
}
.standings-cup-ko-team--away {
    margin-left: 12px;
}
.standings-cup-ko-logo {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.standings-cup-ko-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 15px;
    color: rgb(208, 216, 232);
    white-space: normal;
    flex-shrink: 1;
}
.standings-cup-ko-name--winner {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(39, 174, 96);
}
.standings-cup-ko-result {
    width: 150px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.standings-cup-ko-score {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
}
.standings-cup-ko-score--winner {
    color: rgb(39, 174, 96);
}
.standings-cup-ko-dash {
    font-size: 15px;
    color: rgb(122, 138, 170);
    margin: 0 5px;
}
.standings-cup-message {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(179, 190, 214);
    padding: 18px 16px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.standings-row--my-team {
    background-color: rgb(20, 28, 48);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}

.standings-row--my-team .col-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(212, 160, 23);
}

.standings-row--playoff {
    border-left-width: 3px;
    border-left-color: rgb(39, 174, 96);
}

.standings-row--playin {
    border-left-width: 3px;
    border-left-color: rgb(212, 160, 23);
}

.standings-row--lottery {
    border-left-width: 3px;
    border-left-color: rgb(122, 138, 170);
}

/* Column widths — must match between header and rows */
.col-rank {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 36px;
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.col-team-logo {
    width: 32px;
    height: 32px;
    margin-right: 12px;
    margin-left: 8px;
    flex-shrink: 0;
}

.col-logo-space {
    width: 32px;
    height: 32px;
    margin-right: 12px;
    margin-left: 8px;
    flex-shrink: 0;
    font-size: 1px;
    color: transparent;
    -unity-text-align: middle-center;
}

.col-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    width: 240px;
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    text-transform: uppercase;
    flex-shrink: 0;
}

.col-stat {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    width: 60px;
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    flex-shrink: 0;
    flex-grow: 1;
}

.col-stat--header {
    color: rgb(58, 74, 99);
    font-size: 18px;
    letter-spacing: 1px;
}

.col-wins {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(39, 174, 96);
}

.col-losses {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(192, 57, 43);
}

.col-diff {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    width: 70px;
    font-size: 18px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    flex-grow: 1;
}

.col-streak {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    width: 70px;
    font-size: 18px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    flex-grow: 1;
}

.streak-win  { color: rgb(39, 174, 96); }
.streak-loss { color: rgb(192, 57, 43); }
.streak-none { color: rgb(58, 74, 99); }

.col-last10 {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    width: 80px;
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    flex-shrink: 0;
    flex-grow: 1;
}
