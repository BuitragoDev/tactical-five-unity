/* ══════════════════════════════════════════
   STANDINGS — Standings.uss
   ══════════════════════════════════════════ */

.standings-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.standings-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.standings-split {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}

.standings-left {
    flex-direction: column;
    flex-grow: 3;
    flex-basis: 0;
    padding: 20px;
    min-height: 0;
    overflow: hidden;
}

.standings-right {
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0;
    padding: 20px 20px 20px 0;
    min-height: 0;
    overflow-y: auto;
}

.standings-right-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
    margin-bottom: 12px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.stat-card {
    flex-direction: column;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 14px;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.stat-card-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 12px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(58, 74, 99);
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.stat-card-logo {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.stat-card-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(208, 216, 232);
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}

.stat-card-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 22px;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-center;
}

.standings-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 20px;
    min-height: 0;
}

.standings-tabs {
    flex-direction: row;
    margin-bottom: 16px;
    flex-shrink: 0;
}

.standings-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 13px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 24px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-right: 4px;
}

.standings-tab:hover {
    color: rgb(208, 216, 232);
    border-color: rgb(74, 128, 240);
}

.standings-tab--active {
    background-color: rgb(28, 33, 48);
    border-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
}

.standings-scroll {
    flex-grow: 1;
    min-height: 0;
}

.standings-table-container {
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 2px;
    overflow: hidden;
}

.standings-header-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 16px 10px 16px;
    min-height: 48px;
    background-color: rgb(17, 24, 34);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    flex-shrink: 0;
}

.standings-table {
    flex-direction: column;
    flex-grow: 1;
}

.standings-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 16px 10px 16px;
    min-height: 48px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}

.standings-row:hover {
    background-color: rgb(28, 33, 48);
}

.standings-row--my-team {
    background-color: rgb(20, 28, 48);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}

.standings-row--my-team .col-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    color: rgb(212, 160, 23);
}

.standings-row--playoff {
    border-left-width: 3px;
    border-left-color: rgb(39, 174, 96);
}

.standings-row--playin {
    border-left-width: 3px;
    border-left-color: rgb(212, 160, 23);
}

.standings-row--lottery {
    border-left-width: 3px;
    border-left-color: rgb(122, 138, 170);
}

/* Column widths — must match between header and rows */
.col-rank {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    width: 36px;
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.col-team-logo {
    width: 32px;
    height: 32px;
    margin-right: 12px;
    margin-left: 8px;
    flex-shrink: 0;
}

.col-logo-space {
    width: 32px;
    height: 32px;
    margin-right: 12px;
    margin-left: 8px;
    flex-shrink: 0;
    font-size: 1px;
    color: transparent;
    -unity-text-align: middle-center;
}

.col-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    width: 240px;
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    -unity-text-transform: upper;
    flex-shrink: 0;
}

.col-stat {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    width: 60px;
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    flex-shrink: 0;
    flex-grow: 1;
}

.col-stat--header {
    color: rgb(58, 74, 99);
    font-size: 18px;
    letter-spacing: 1px;
}

.col-wins {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    color: rgb(39, 174, 96);
}

.col-losses {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    color: rgb(192, 57, 43);
}

.col-diff {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    width: 70px;
    font-size: 18px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    flex-grow: 1;
}

.col-streak {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    width: 70px;
    font-size: 18px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    flex-grow: 1;
}

.streak-win  { color: rgb(39, 174, 96); }
.streak-loss { color: rgb(192, 57, 43); }
.streak-none { color: rgb(58, 74, 99); }

.col-last10 {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    width: 80px;
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    flex-shrink: 0;
    flex-grow: 1;
}
