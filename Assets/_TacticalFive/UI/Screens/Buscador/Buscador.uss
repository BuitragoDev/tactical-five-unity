/* ══════════════════════════════════════════
   BUSCADOR — Buscador.uss
   (La tabla reutiliza los estilos de Stats.uss)
   ══════════════════════════════════════════ */

.buscador-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.buscador-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.buscador-content {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    padding: 16px 24px;
}

/* ══ FILTROS ══ */

.buscador-filters {
    flex-direction: column;
    flex-shrink: 0;
    margin-bottom: 12px;
    padding: 10px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
}

.buscador-filter-group {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.buscador-filter-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    color: rgb(85, 102, 119);
    width: 110px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

.buscador-filter-options {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    flex-grow: 1;
}

.buscador-team-grid {
    flex-direction: column;
    flex-grow: 1;
    width: 100%;
    min-height: 0;
}

.buscador-team-row {
    flex-direction: row;
    width: 100%;
    flex-grow: 1;
}

.buscador-team-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 3px;
    padding: 6px 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 4px;
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}

.buscador-team-btn:hover {
    color: rgb(208, 216, 232);
    border-color: rgb(85, 102, 119);
}

.buscador-team-btn--active {
    color: rgb(212, 160, 23);
    border-color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.08);
}

.buscador-clear-btn {
    color: rgb(192, 57, 43);
    margin-left: 16px;
}

.buscador-clear-btn:hover {
    color: rgb(231, 76, 60);
}

/* Filas compactas para el listado de jugadores. */
.buscador-root .stats-row {
    padding: 4px 24px;
    min-height: 38px;
}

.buscador-root .stats-panel-header {
    padding: 8px 24px;
}

.buscador-sort-header {
    padding: 0;
    margin: 0;
    background-color: transparent;
    border-width: 0;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
}

.buscador-sort-header:hover {
    color: rgb(212, 160, 23);
}

/* Paginación de resultados: 12 jugadores por página. */
.buscador-pagination {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-height: 48px;
    padding: 6px 24px;
    background-color: rgb(17, 24, 34);
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
}

.buscador-page-btn {
    width: 38px;
    height: 32px;
    padding: 6px;
    margin: 0 12px;
    align-items: center;
    justify-content: center;
    color: rgb(122, 138, 170);
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 3px;
    -unity-text-align: middle-center;
}

.buscador-page-btn:hover {
    color: rgb(212, 160, 23);
    border-color: rgb(212, 160, 23);
}

.buscador-page-jump-btn {
    width: 64px;
    flex-direction: row;
    flex-wrap: nowrap;
}

.buscador-page-icon {
    width: 18px;
    height: 18px;
    margin: 0;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.buscador-page-btn:disabled {
    color: rgb(55, 65, 84);
    background-color: rgb(17, 24, 34);
    border-color: rgb(28, 33, 48);
}

.buscador-page-label {
    min-width: 80px;
    height: 24px;
    flex-shrink: 0;
    font-size: 16px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
}
