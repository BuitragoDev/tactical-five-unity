<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="../Stats/Stats.uss" />
    <Style src="Buscador.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />

    <ui:VisualElement name="BuscadorRoot" class="buscador-root">

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="buscador-main">

            <!-- ══ HEADER ══ -->
            <ui:VisualElement class="screen-header panel--gold">
                <ui:VisualElement class="screen-header-row">
                    <ui:VisualElement name="BuscadorScreenIcon" class="screen-icon" />
                    <ui:Label class="screen-title" text="{loc:ui.buscador.buscador}" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- CONTENT -->
            <ui:VisualElement name="BuscadorContent" class="buscador-content">

                <!-- FILTERS -->
                <ui:VisualElement name="BuscadorFilters" class="buscador-filters">

                    <!-- Posición -->
                    <ui:VisualElement class="buscador-filter-group">
                        <ui:Label class="buscador-filter-label" text="{loc:ui.buscador.posicion}" />
                        <ui:VisualElement class="buscador-filter-options">
                            <ui:Button name="PosTodos" class="filter-btn filter-btn--active" text="{loc:ui.buscador.pos_todos}" />
                            <ui:Button name="PosPG" class="filter-btn" text="{loc:ui.buscador.pos_pg}" />
                            <ui:Button name="PosSG" class="filter-btn" text="{loc:ui.buscador.pos_sg}" />
                            <ui:Button name="PosSF" class="filter-btn" text="{loc:ui.buscador.pos_sf}" />
                            <ui:Button name="PosPF" class="filter-btn" text="{loc:ui.buscador.pos_pf}" />
                            <ui:Button name="PosC" class="filter-btn" text="{loc:ui.buscador.pos_c}" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Edad -->
                    <ui:VisualElement class="buscador-filter-group">
                        <ui:Label class="buscador-filter-label" text="{loc:ui.buscador.edad}" />
                        <ui:VisualElement class="buscador-filter-options">
                            <ui:Button name="AgeTodas" class="filter-btn filter-btn--active" text="{loc:ui.buscador.age_todas}" />
                            <ui:Button name="Age20" class="filter-btn" text="≤ 20" />
                            <ui:Button name="Age24" class="filter-btn" text="21-24" />
                            <ui:Button name="Age29" class="filter-btn" text="25-29" />
                            <ui:Button name="Age30" class="filter-btn" text="30+" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Equipo -->
                    <ui:VisualElement class="buscador-filter-group">
                        <ui:Label class="buscador-filter-label" text="{loc:ui.buscador.equipo}" />
                        <ui:VisualElement class="buscador-filter-options">
                            <ui:VisualElement name="BuscadorTeamGrid" class="buscador-team-grid" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Media -->
                    <ui:VisualElement class="buscador-filter-group">
                        <ui:Label class="buscador-filter-label" text="{loc:ui.buscador.media}" />
                        <ui:VisualElement class="buscador-filter-options">
                            <ui:Button name="OvrTodas" class="filter-btn filter-btn--active" text="{loc:ui.buscador.ovr_todas}" />
                            <ui:Button name="Ovr85" class="filter-btn" text="85+" />
                            <ui:Button name="Ovr80" class="filter-btn" text="80+" />
                            <ui:Button name="Ovr75" class="filter-btn" text="75+" />
                            <ui:Button name="Ovr70" class="filter-btn" text="70+" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Extra -->
                    <ui:VisualElement class="buscador-filter-group">
                        <ui:Label class="buscador-filter-label" text="{loc:ui.buscador.estado}" />
                        <ui:VisualElement class="buscador-filter-options">
                            <ui:Button name="ToggleOnlyFA" class="filter-btn" text="{loc:ui.buscador.toggle_only_fa}" />
                            <ui:Button name="BtnClearFilters" class="filter-btn buscador-clear-btn" text="{loc:ui.buscador.btn_clear_filters}" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- RESULTS -->
                <ui:VisualElement class="stats-panel">
                    <ui:VisualElement class="stats-panel-header">
                        <ui:Label name="PanelTitle" class="stats-title" text="{loc:ui.buscador.panel_title}" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stats-table-wrapper">
                        <!-- Fixed header -->
                        <ui:VisualElement name="BuscadorTableHeader" class="stats-header-row" />
                        <!-- Body with custom scrollbar -->
                        <ui:VisualElement class="stats-scroll-row">
                            <ui:VisualElement name="BuscadorViewport" class="stats-viewport">
                                <ui:VisualElement name="BuscadorTableBody" class="stats-table" />
                            </ui:VisualElement>
                            <ui:VisualElement name="BuscadorScrollTrack" class="stats-scrollbar">
                                <ui:VisualElement name="BuscadorScrollThumb" class="stats-scrollbar-thumb" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ══ MODAL CONFIGURACIÓN ══ -->
        <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigModalBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.buscador.configuracion}" />
                <ui:VisualElement class="modal-body">
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.buscador.audio}" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.buscador.volumen_general}" />
                            <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.buscador.musica}" />
                            <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.buscador.efectos}" />
                            <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.buscador.graficos}" />
                        <ui:VisualElement class="settings-quality-row">
                            <ui:Label class="settings-label" text="{loc:ui.buscador.calidad}" />
                            <ui:VisualElement class="settings-quality-options">
                                <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="{loc:ui.buscador.config_btn_quality_low}" />
                                <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="{loc:ui.buscador.config_btn_quality_medium}" />
                                <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="{loc:ui.buscador.config_btn_quality_high}" />
                                <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="{loc:ui.buscador.config_btn_quality_ultra}" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.buscador.juego}" />
                        <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="{loc:ui.buscador.config_btn_main_menu}" />
                        <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="{loc:ui.buscador.config_btn_exit}" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ConfigBtnCerrar" class="modal-close" text="{loc:ui.buscador.config_btn_cerrar}" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR VOLVER AL MENÚ PRINCIPAL ══ -->
        <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.buscador.volver_al_menu_principal}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.buscador.estas_seguro_de_que_quieres_volver_al_me_6f548452}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.buscador.se_perdera_el_progreso_no_guardado_de_la_b10b7334}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="{loc:ui.buscador.config_btn_main_menu_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="{loc:ui.buscador.config_btn_main_menu_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR SALIR DEL JUEGO ══ -->
        <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.buscador.salir_del_juego}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.buscador.estas_seguro_de_que_quieres_salir_del_ju_c65dd5f1}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.buscador.tu_progreso_se_guarda_automaticamente_du_10fb1edb}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="{loc:ui.buscador.config_btn_exit_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="{loc:ui.buscador.config_btn_exit_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
