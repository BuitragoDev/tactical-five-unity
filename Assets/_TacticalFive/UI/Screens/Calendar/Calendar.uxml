<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Calendar.uss" />
    <Style src="../Dashboard/Dashboard.uss" />

    <ui:VisualElement name="CalendarRoot" class="calendar-root">

        <!-- ══ SIDEBAR ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="calendar-main">

            <!-- TOP HEADER -->

            <!-- CALENDAR CONTENT -->
            <ui:VisualElement class="calendar-content">

                <!-- TITLE BOX -->
                <ui:VisualElement class="calendar-title-box">
                    <ui:Label text="CALENDARIO" class="calendar-title-box-label" />
                </ui:VisualElement>

                <!-- Month navigation -->
                <ui:VisualElement class="calendar-nav">
                    <ui:Button name="BtnPrevMonth" class="calendar-nav-btn" text="◀" />
                    <ui:Label name="CurrentMonth" class="calendar-month-label" text="" />
                    <ui:Button name="BtnNextMonth" class="calendar-nav-btn" text="▶" />
                </ui:VisualElement>

                <!-- Calendar body: grid left, games right -->
                <ui:VisualElement class="calendar-body">

                    <!-- Calendar grid -->
                    <ui:VisualElement class="calendar-grid-container">
                        <!-- Day headers -->
                        <ui:VisualElement class="calendar-day-headers">
                            <ui:Label class="calendar-day-header" text="LUN" />
                            <ui:Label class="calendar-day-header" text="MAR" />
                            <ui:Label class="calendar-day-header" text="MIÉ" />
                            <ui:Label class="calendar-day-header" text="JUE" />
                            <ui:Label class="calendar-day-header" text="VIE" />
                            <ui:Label class="calendar-day-header" text="SÁB" />
                            <ui:Label class="calendar-day-header" text="DOM" />
                        </ui:VisualElement>

                        <!-- Calendar days -->
                        <ui:VisualElement name="CalendarDays" class="calendar-days" />
                    </ui:VisualElement>

                    <!-- Selected day games panel -->
                    <ui:VisualElement name="SelectedDayPanel" class="selected-day-panel">
                        <ui:VisualElement class="panel-header">
                            <ui:Label name="SelectedDayTitle" class="panel-title" text="" />
                        </ui:VisualElement>
                        <ui:ScrollView class="selected-day-games-scroll"
                                       horizontal-scrolling-enabled="false"
                                       mode="Vertical">
                            <ui:VisualElement name="SelectedDayGames" class="selected-day-games" />
                        </ui:ScrollView>
                        <ui:Label name="NoGamesText" class="no-games-text" text="NO HAY PARTIDOS ESTE DÍA" />
                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
