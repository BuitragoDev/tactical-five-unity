<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Calendar.uss" />
    <Style src="../Dashboard/Dashboard.uss" />

    <ui:VisualElement name="CalendarRoot" class="calendar-root">

        <!-- ══ SIDEBAR ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="calendar-main">

            <!-- TOP HEADER -->
            <ui:VisualElement name="TopHeader" class="top-header">
                <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo" />
                <ui:VisualElement class="header-team-info">
                    <ui:Label name="HeaderTeamName"    class="header-team-name"    text="" />
                    <ui:Label name="HeaderManagerName" class="header-manager-name" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="PRESUPUESTO" />
                    <ui:Label name="HeaderBudget" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MASA SALARIAL" />
                    <ui:Label name="HeaderPayroll" class="header-stat-value header-stat-value--neutral" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MARGEN SALARIAL" />
                    <ui:Label name="HeaderMargin" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="QUÍMICA DE EQUIPO" />
                    <ui:Label name="HeaderChemistry" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-spacer" />
                <ui:VisualElement class="header-season-info">
                    <ui:Label name="HeaderSeason" class="header-season-label" text="" />
                    <ui:Label name="HeaderDate"   class="header-date-label"   text="" />
                </ui:VisualElement>
                <ui:Button name="BtnAction" class="btn-action" text="CONTINUAR" />
                <ui:VisualElement name="ConfigIcon" class="header-config-icon" />
            </ui:VisualElement>

            <!-- CALENDAR CONTENT -->
            <ui:VisualElement class="calendar-content">

                <!-- TITLE BOX -->
                <ui:VisualElement class="calendar-title-box">
                    <ui:Label text="CALENDARIO" class="calendar-title-box-label" />
                </ui:VisualElement>

                <!-- Month navigation -->
                <ui:VisualElement class="calendar-nav">
                    <ui:Button name="BtnPrevMonth" class="calendar-nav-btn" text="◀" />
                    <ui:Label name="CurrentMonth" class="calendar-month-label" text="" />
                    <ui:Button name="BtnNextMonth" class="calendar-nav-btn" text="▶" />
                </ui:VisualElement>

                <!-- Calendar body: grid left, games right -->
                <ui:VisualElement class="calendar-body">

                    <!-- Calendar grid -->
                    <ui:VisualElement class="calendar-grid-container">
                        <!-- Day headers -->
                        <ui:VisualElement class="calendar-day-headers">
                            <ui:Label class="calendar-day-header" text="LUN" />
                            <ui:Label class="calendar-day-header" text="MAR" />
                            <ui:Label class="calendar-day-header" text="MIÉ" />
                            <ui:Label class="calendar-day-header" text="JUE" />
                            <ui:Label class="calendar-day-header" text="VIE" />
                            <ui:Label class="calendar-day-header" text="SÁB" />
                            <ui:Label class="calendar-day-header" text="DOM" />
                        </ui:VisualElement>

                        <!-- Calendar days -->
                        <ui:VisualElement name="CalendarDays" class="calendar-days" />
                    </ui:VisualElement>

                    <!-- Selected day games panel -->
                    <ui:VisualElement name="SelectedDayPanel" class="selected-day-panel">
                        <ui:VisualElement class="panel-header">
                            <ui:Label name="SelectedDayTitle" class="panel-title" text="" />
                        </ui:VisualElement>
                        <ui:ScrollView class="selected-day-games-scroll"
                                       horizontal-scrolling-enabled="false"
                                       mode="Vertical">
                            <ui:VisualElement name="SelectedDayGames" class="selected-day-games" />
                        </ui:ScrollView>
                        <ui:Label name="NoGamesText" class="no-games-text" text="NO HAY PARTIDOS ESTE DÍA" />
                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
