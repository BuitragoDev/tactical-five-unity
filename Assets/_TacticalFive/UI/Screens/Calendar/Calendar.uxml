<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Calendar.uss" />
    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />

    <ui:VisualElement name="CalendarRoot" class="calendar-root">

        <!-- ══ SIDEBAR ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="calendar-main">

            <!-- TOP HEADER -->
            <!-- SCREEN HEADER -->
            <ui:VisualElement class="calendar-screen-header panel--gold">
                <ui:VisualElement class="calendar-screen-header-row">
                    <ui:VisualElement name="CalendarScreenIcon" class="calendar-screen-icon" />
                    <ui:Label text="{loc:ui.calendar.calendario}" class="calendar-screen-title" />
                </ui:VisualElement>
                <ui:Label name="CalendarSubtitle" text="" class="calendar-screen-subtitle" />
            </ui:VisualElement>

            <!-- CALENDAR CONTENT -->
            <ui:VisualElement class="calendar-content">

                <!-- Month navigation -->
                <ui:VisualElement class="calendar-nav">
                    <ui:Button name="BtnPrevMonth" class="calendar-nav-btn" text="◀" />
                    <ui:Label name="CurrentMonth" class="calendar-month-label" text="" />
                    <ui:Button name="BtnNextMonth" class="calendar-nav-btn" text="▶" />
                </ui:VisualElement>

                <!-- Calendar body: grid left, games right -->
                <ui:VisualElement class="calendar-body">

                    <!-- Calendar grid -->
                    <ui:VisualElement class="calendar-grid-container">
                        <!-- Day headers -->
                        <ui:VisualElement class="calendar-day-headers">
                            <ui:Label class="calendar-day-header" text="{loc:ui.calendar.lun}" />
                            <ui:Label class="calendar-day-header" text="{loc:ui.calendar.mar}" />
                            <ui:Label class="calendar-day-header" text="{loc:ui.calendar.mie}" />
                            <ui:Label class="calendar-day-header" text="{loc:ui.calendar.jue}" />
                            <ui:Label class="calendar-day-header" text="{loc:ui.calendar.vie}" />
                            <ui:Label class="calendar-day-header" text="{loc:ui.calendar.sab}" />
                            <ui:Label class="calendar-day-header" text="{loc:ui.calendar.dom}" />
                        </ui:VisualElement>

                        <!-- Calendar days -->
                        <ui:VisualElement name="CalendarDays" class="calendar-days" />
                    </ui:VisualElement>

                    <!-- Selected day games panel -->
                    <ui:VisualElement name="SelectedDayPanel" class="selected-day-panel">
                        <ui:VisualElement class="panel-header">
                            <ui:Label name="SelectedDayTitle" class="panel-title" text="" />
                        </ui:VisualElement>
                        <ui:ScrollView class="selected-day-games-scroll"
                                       horizontal-scrolling-enabled="false"
                                       mode="Vertical">
                            <ui:VisualElement name="SelectedDayGames" class="selected-day-games" />
                        </ui:ScrollView>
                        <ui:Label name="NoGamesText" class="no-games-text" text="{loc:ui.calendar.no_games_text}" />
                        <ui:Button name="BtnSimulateToDate" class="btn-fastsim" text="{loc:ui.calendar.btn_simulate_to_date}" />
                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR SIMULACIÓN RÁPIDA ══ -->
        <ui:VisualElement name="FastSimConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="FastSimConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.calendar.simular_hasta_fecha}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label name="FastSimConfirmText" class="modal-paragraph" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="FastSimCancelBtn" class="modal-btn modal-btn--secondary" text="{loc:ui.calendar.fast_sim_cancel_btn}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="FastSimConfirmBtn" class="modal-btn modal-btn--primary" text="{loc:ui.calendar.fast_sim_confirm_btn}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIGURACIÓN ══ -->
        <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigModalBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.calendar.configuracion}" />
                <ui:VisualElement class="modal-body">
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.calendar.audio}" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.calendar.volumen_general}" />
                            <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.calendar.musica}" />
                            <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.calendar.efectos}" />
                            <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.calendar.graficos}" />
                        <ui:VisualElement class="settings-quality-row">
                            <ui:Label class="settings-label" text="{loc:ui.calendar.calidad}" />
                            <ui:VisualElement class="settings-quality-options">
                                <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="{loc:ui.calendar.config_btn_quality_low}" />
                                <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="{loc:ui.calendar.config_btn_quality_medium}" />
                                <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="{loc:ui.calendar.config_btn_quality_high}" />
                                <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="{loc:ui.calendar.config_btn_quality_ultra}" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.calendar.juego}" />
                        <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="{loc:ui.calendar.config_btn_main_menu}" />
                        <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="{loc:ui.calendar.config_btn_exit}" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ConfigBtnCerrar" class="modal-close" text="{loc:ui.calendar.config_btn_cerrar}" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR VOLVER AL MENÚ PRINCIPAL ══ -->
        <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.calendar.volver_al_menu_principal}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.calendar.estas_seguro_de_que_quieres_volver_al_me_6f548452}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.calendar.se_perdera_el_progreso_no_guardado_de_la_b10b7334}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="{loc:ui.calendar.config_btn_main_menu_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="{loc:ui.calendar.config_btn_main_menu_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR SALIR DEL JUEGO ══ -->
        <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.calendar.salir_del_juego}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.calendar.estas_seguro_de_que_quieres_salir_del_ju_c65dd5f1}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.calendar.tu_progreso_se_guarda_automaticamente_du_10fb1edb}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="{loc:ui.calendar.config_btn_exit_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="{loc:ui.calendar.config_btn_exit_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

</ui:UXML>
