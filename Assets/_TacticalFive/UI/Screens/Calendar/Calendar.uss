/* ══════════════════════════════════════════
   CALENDAR — Calendar.uss
   ══════════════════════════════════════════ */

.calendar-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.calendar-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

/* ── SCREEN HEADER ── */
.calendar-screen-header.panel--gold {
    flex-shrink: 0;
    padding: 0;
    margin: 16px 20px 12px 20px;
    border-color: rgb(212, 160, 23);
    border-width: 1px;
    background-color: rgba(120, 95, 30, 0.15);
    border-radius: 4px;
    overflow: hidden;
}
.calendar-screen-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    background-color: rgba(120, 95, 30, 0.15);
}
.calendar-screen-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.calendar-screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    white-space: normal;
}
.calendar-screen-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(212, 160, 23);
    padding: 0 14px;
    background-color: rgba(120, 95, 30, 0.15);
}

.calendar-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 20px;
    min-height: 0;
}

/* Month navigation */
.calendar-nav {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    flex-shrink: 0;
}

.calendar-nav-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(30, 45, 61);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 2px;
    color: rgb(208, 216, 232);
    font-size: 16px;
    padding: 8px 14px;
    -unity-text-align: middle-center;
}

.calendar-nav-btn:hover {
    background-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
}

.calendar-month-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin: 0 20px;
    min-width: 200px;
}

/* Calendar body: grid + games side by side */
.calendar-body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

/* Calendar grid */
.calendar-grid-container {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    margin-right: 16px;
}

.calendar-day-headers {
    flex-direction: row;
    background-color: rgb(17, 24, 34);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

.calendar-day-header {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 14.2857%;
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
    padding: 8px 0;
    border-right-width: 1px;
    border-right-color: rgb(42, 51, 71);
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.calendar-days {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    min-height: 0;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-top-width: 0;
}

.calendar-day-cell {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 14.2857%;
    min-height: 120px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-right-width: 1px;
    border-right-color: rgb(42, 51, 71);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    border-top-width: 0;
    border-left-width: 0;
    padding: 4px;
    position: relative;
}

.calendar-day-cell--my-game {
    background-color: rgb(30, 40, 60);
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 160, 23);
}

.calendar-day-cell--empty {
    background-color: rgb(15, 17, 23);
}

.calendar-day-cell--today {
    background-color: rgb(26, 80, 150);
    border-left-width: 4px;
    border-left-color: rgb(212, 160, 23);
}

.calendar-day-number {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

.calendar-day-cell--today .calendar-day-number {
    color: rgb(255, 255, 255);
}

.calendar-day-cell--my-game .calendar-day-number {
    color: rgb(212, 160, 23);
}

.calendar-day-number--top-right {
    position: absolute;
    top: 4px;
    right: 6px;
    -unity-text-align: middle-right;
}

/* Selected day panel (right side) */
.selected-day-panel {
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 2px;
    flex-shrink: 0;
    width: 490px;
    min-height: 0;
}

.selected-day-games-scroll {
    flex-grow: 1;
    min-height: 0;
}

.selected-day-games {
    flex-direction: column;
    padding: 0;
}

.selected-game-row {
    flex-direction: row;
    align-items: center;
    padding: 12px 16px;
    background-color: rgb(17, 24, 34);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}

.selected-game-row--my-game {
    background-color: rgb(20, 28, 48);
    border-left-width: 4px;
    border-left-color: rgb(212, 160, 23);
}

.selected-game-row--played {
    opacity: 0.7;
}

.selected-game-teams {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.selected-game-team-logo {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    flex-shrink: 0;
}

.selected-game-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-transform: upper;
    flex-shrink: 0;
    width: 100px;
}

.selected-game-vs {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(58, 74, 99);
    margin: 0 8px;
    flex-shrink: 0;
}

.selected-game-score {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(255, 255, 255);
    margin-left: 10px;
    flex-shrink: 0;
    width: 75px;
    -unity-text-align: middle-center;
}

.selected-game-type {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
    margin-left: 10px;
    flex-shrink: 0;
}

.no-games-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(58, 74, 99);
    -unity-text-align: middle-start;
    padding: 30px 16px;
}

/* Botón simular hasta fecha */
.btn-fastsim {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    cursor: pointer;
    font-size: 18px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(120, 160, 230);
    background-color: rgba(42, 95, 201, 0.10);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    border-radius: 8px;
    padding: 12px 18px;
    margin: 12px 16px;
    -unity-text-align: middle-center;
}

.btn-fastsim:hover {
    background-color: rgba(42, 95, 201, 0.25);
    color: rgb(150, 190, 255);
}

.btn-fastsim:disabled {
    background-color: rgba(60, 60, 70, 0.25);
    border-color: rgb(60, 60, 70);
    color: rgb(80, 85, 95);
    cursor: default;
}

/* ── MODAL FAST SIM ── */
#FastSimConfirmBox {
    width: 620px;
    background-color: rgb(13, 14, 18);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    border-radius: 12px;
    padding: 0;
    flex-direction: column;
    overflow: hidden;
}
#FastSimConfirmBox .modal-title {
    padding: 10px 24px;
    background-color: rgba(42, 95, 201, 0.15);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 95, 201);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 34px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
}
#FastSimConfirmBox .modal-body {
    padding: 20px 24px;
}
#FastSimConfirmBox .modal-paragraph {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 20px;
    color: rgb(179, 190, 214);
    white-space: normal;
    -unity-text-align: middle-center;
}
#FastSimConfirmBox .modal-actions {
    width: auto;
    align-self: stretch;
    margin: 8px 20px 16px;
    justify-content: space-between;
}
#FastSimCancelBtn {
    flex-grow: 1;
    min-width: 0;
    background-color: rgba(100, 110, 130, 0.10);
    border-width: 2px;
    border-color: rgb(100, 110, 130);
    color: rgb(160, 170, 190);
    border-radius: 8px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
}
#FastSimCancelBtn:hover {
    background-color: rgba(100, 110, 130, 0.25);
    color: rgb(190, 200, 220);
}
#FastSimConfirmBtn {
    flex-grow: 1;
    min-width: 0;
    margin-left: 16px;
    background-color: rgba(42, 95, 201, 0.10);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(120, 160, 230);
    border-radius: 8px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
}
#FastSimConfirmBtn:hover {
    background-color: rgba(42, 95, 201, 0.25);
    color: rgb(150, 190, 255);
}
