/* ══════════════════════════════════════════
   FINANCES — Finances.uss
   ══════════════════════════════════════════ */

.finances-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.finances-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.finances-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 16px 30px 24px 30px;
    min-height: 0;
    overflow: auto;
}

/* ── TITLE BOX ── */

.finances-title-box {
    flex-direction: row;
    align-items: center;
    margin: 16px 24px 0;
    padding: 10px 18px;
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    background-color: rgba(42, 95, 201, 0.08);
}
.finances-title-box-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 3px;
    color: rgb(208, 216, 232);
    text-transform: uppercase;
}

/* ══ 4 Summary Boxes ══ */
.finances-summary {
    flex-direction: row;
    width: 100%;
    margin-bottom: 24px;
}

.finance-summary-box {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 6px;
    padding: 16px;
    margin-right: 16px;
}

.finance-summary-box:last-child {
    margin-right: 0;
}

.finance-summary-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(120, 130, 150);
    margin-bottom: 6px;
}

.finance-summary-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 28px;
    color: rgb(208, 216, 232);
}

.finance-summary-value--income {
    color: rgb(39, 174, 96);
}

.finance-summary-value--expense {
    color: rgb(192, 57, 43);
}

/* ══ Tabs ══ */
.finances-tabs {
    flex-direction: row;
    margin-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
}

.finances-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(122, 138, 170);
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: transparent;
    padding: 10px 20px;
    margin-right: 8px;
    -unity-text-align: middle-center;
}

.finances-tab:hover {
    color: rgb(208, 216, 232);
}

.finances-tab--active {
    color: rgb(248, 196, 64);
    border-bottom-color: rgb(248, 196, 64);
}

/* ══ Panels ══ */
.finances-panel {
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 6px;
    padding: 0;
    flex-grow: 0;
}

.finances-panel-header {
    flex-direction: row;
    align-items: center;
    padding: 14px 20px;
    background-color: rgb(28, 30, 38);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

.finances-panel-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(248, 196, 64);
}

/* ══ Tickets Config ══ */
.tickets-config {
    flex-direction: row;
    padding: 24px;
    gap: 24px;
}

.ticket-config-col {
    flex-direction: column;
    flex-grow: 1;
    align-items: center;
    padding: 20px;
    background-color: rgb(18, 21, 30);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 6px;
    position: relative;
    overflow: visible;
    margin-right: 24px;
}

.ticket-config-col:last-child {
    margin-right: 0;
}

.ticket-config-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(208, 216, 232);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.price-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
    max-width: 460px;
    margin-top: 8px;
}

.price-btn {
    width: 120px;
    height: 48px;
    margin: 10px;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    color: rgb(208, 216, 232);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 20px;
    -unity-text-align: middle-center;
}

.price-btn:hover {
    background-color: rgb(38, 43, 58);
    border-color: rgb(85, 102, 119);
}

.price-btn--selected {
    background-color: rgb(248, 196, 64);
    border-color: rgb(248, 196, 64);
    color: rgb(15, 17, 23);
}

.price-btn--selected:hover {
    background-color: rgb(255, 210, 80);
    border-color: rgb(255, 210, 80);
}

.price-btn--disabled {
    opacity: 0.5;
    background-color: rgb(20, 24, 34);
    border-color: rgb(42, 51, 71);
    color: rgb(85, 102, 119);
    cursor: default;
    pointer-events: none;
}

.price-btn--disabled:hover {
    background-color: rgb(20, 24, 34);
    border-color: rgb(42, 51, 71);
}

/* ══ Table ══ */
.finances-table {
    flex-direction: column;
    padding: 0 20px;
}

.finances-row {
    flex-direction: row;
    align-items: center;
    padding: 14px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(32, 38, 54);
}

.finances-row:last-child {
    border-bottom-width: 0;
}

.finances-row-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
}

.finances-row-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 20px;
    width: 140px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

.finances-row-value--income {
    color: rgb(39, 174, 96);
}

.finances-row-value--expense {
    color: rgb(192, 57, 43);
}

/* Total row */
.finances-total-row {
    flex-direction: row;
    align-items: center;
    padding: 16px 20px;
    background-color: rgb(18, 21, 30);
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.finances-total-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(248, 196, 64);
    flex-grow: 1;
}

.finances-total-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    width: 140px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

.finances-total-value--income {
    color: rgb(39, 174, 96);
}

.finances-total-value--expense {
    color: rgb(192, 57, 43);
}

/* ══ Chart ══ */
.chart-container {
    flex-direction: column;
    align-items: center;
    padding: 24px;
    flex-grow: 1;
}

.chart-bars {
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    height: 260px;
    width: 100%;
    padding-bottom: 8px;
}

.chart-bar-wrapper {
    flex-direction: column;
    align-items: center;
    width: 120px;
    margin: 0 10px;
}

.chart-bar {
    width: 100px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

.chart-bar--income {
    background-color: rgb(39, 174, 96);
}

.chart-bar--expense {
    background-color: rgb(192, 57, 43);
}

.chart-labels {
    flex-direction: row;
    justify-content: center;
    width: 100%;
    margin-top: 10px;
}

.chart-month-label {
    width: 120px;
    margin: 0 10px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 18px;
    color: rgb(120, 130, 150);
    -unity-text-align: middle-center;
}

.chart-month-value {
    width: 90px;
    margin: 0 10px;
    margin-bottom: 6px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    -unity-text-align: middle-center;
}

.chart-month-value--income {
    color: rgb(39, 174, 96);
}

.chart-month-value--expense {
    color: rgb(192, 57, 43);
}

.chart-legend {
    flex-direction: row;
    justify-content: center;
    padding: 12px;
    margin-top: 8px;
}

.chart-legend-item {
    flex-direction: row;
    align-items: center;
    margin: 0 12px;
}

.chart-legend-dot {
    width: 18px;
    height: 18px;
    border-radius: 2px;
    margin-right: 6px;
}

.chart-legend-dot--income {
    background-color: rgb(39, 174, 96);
}

.chart-legend-dot--expense {
    background-color: rgb(192, 57, 43);
}

.chart-legend-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 18px;
    color: rgb(120, 130, 150);
}
