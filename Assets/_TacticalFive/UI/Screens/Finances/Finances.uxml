<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Finances.uss" />
    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />

    <ui:VisualElement name="FinancesRoot" class="finances-root">

        <!-- ══ SIDEBAR ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="finances-main">

            <!-- TOP HEADER -->

            <!-- FINANCES CONTENT -->
            <ui:VisualElement class="finances-content">

                <!-- 4 Summary Boxes -->
                <ui:VisualElement class="finances-summary">
                    <ui:VisualElement class="finance-summary-box">
                        <ui:Label class="finance-summary-label" text="PRESUPUESTO" />
                        <ui:Label name="SummaryBudget" class="finance-summary-value" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement class="finance-summary-box">
                        <ui:Label class="finance-summary-label" text="NÓMINA ANUAL" />
                        <ui:Label name="SummaryAnnualPayroll" class="finance-summary-value" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement class="finance-summary-box">
                        <ui:Label class="finance-summary-label" text="NÓMINA MENSUAL" />
                        <ui:Label name="SummaryMonthlyPayroll" class="finance-summary-value" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement class="finance-summary-box">
                        <ui:Label class="finance-summary-label" text="BALANCE NETO" />
                        <ui:Label name="SummaryNetBalance" class="finance-summary-value" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Tabs -->
                <ui:VisualElement class="finances-tabs">
                    <ui:Button name="TabTickets"      class="finances-tab finances-tab--active" text="🎫  TAQUILLA" />
                    <ui:Button name="TabIncome"       class="finances-tab" text="💰  INGRESOS" />
                    <ui:Button name="TabExpenses"     class="finances-tab" text="💸  GASTOS" />
                    <ui:Button name="TabCap"          class="finances-tab" text="💼  CAP SHEET" />
                    <ui:Button name="TabChart"        class="finances-tab" text="📊  GRÁFICO" />
                </ui:VisualElement>

                <!-- Tab Content: TAQUILLA -->
                <ui:VisualElement name="PanelTickets" class="finances-panel">
                    <ui:VisualElement class="finances-panel-header">
                        <ui:Label class="finances-panel-title" text="CONFIGURACIÓN DE TAQUILLA" />
                    </ui:VisualElement>
                    <ui:VisualElement class="tickets-config">
                        <!-- Precio Entrada -->
                        <ui:VisualElement class="ticket-config-col">
                            <ui:Label class="ticket-config-label" text="PRECIO ENTRADA INDIVIDUAL" />
                            <ui:VisualElement name="TicketPriceGrid" class="price-grid" />
                        </ui:VisualElement>
                        <!-- Precio Abono -->
                        <ui:VisualElement class="ticket-config-col">
                            <ui:Label class="ticket-config-label" text="PRECIO ABONO TEMPORADA" />
                            <ui:VisualElement name="SubscriptionPriceGrid" class="price-grid" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Tab Content: INGRESOS -->
                <ui:VisualElement name="PanelIncome" class="finances-panel" style="display:none;">
                    <ui:VisualElement class="finances-panel-header">
                        <ui:Label class="finances-panel-title" text="INGRESOS TOTALES" />
                    </ui:VisualElement>
                    <ui:VisualElement name="IncomeTable" class="finances-table" />
                    <ui:VisualElement class="finances-total-row">
                        <ui:Label class="finances-total-label" text="TOTAL INGRESOS" />
                        <ui:Label name="TotalIncomeValue" class="finances-total-value finances-total-value--income" text="$0" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Tab Content: GASTOS -->
                <ui:VisualElement name="PanelExpenses" class="finances-panel" style="display:none;">
                    <ui:VisualElement class="finances-panel-header">
                        <ui:Label class="finances-panel-title" text="GASTOS TOTALES" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ExpensesTable" class="finances-table" />
                    <ui:VisualElement class="finances-total-row">
                        <ui:Label class="finances-total-label" text="TOTAL GASTOS" />
                        <ui:Label name="TotalExpensesValue" class="finances-total-value finances-total-value--expense" text="$0" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Tab Content: CAP SHEET -->
                <ui:VisualElement name="PanelCap" class="finances-panel" style="display:none;">
                    <ui:VisualElement class="finances-panel-header">
                        <ui:Label class="finances-panel-title" text="CAP SHEET — MASA SALARIAL" />
                    </ui:VisualElement>
                    <ui:VisualElement class="cap-summary">
                        <ui:VisualElement class="cap-summary-box">
                            <ui:Label class="cap-summary-label" text="NÓMINA ACTUAL" />
                            <ui:Label name="CapSheetSalaryLabel" class="cap-summary-value" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement class="cap-summary-box">
                            <ui:Label class="cap-summary-label" text="CAP" />
                            <ui:Label name="CapSheetCapLabel" class="cap-summary-value" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement class="cap-summary-box">
                            <ui:Label class="cap-summary-label" text="ESPACIO" />
                            <ui:Label name="CapSheetSpaceLabel" class="cap-summary-value" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement class="cap-summary-box">
                            <ui:Label class="cap-summary-label" text="1º APRON" />
                            <ui:Label name="CapSheetApronLabel" class="cap-summary-value" text="" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="cap-section">
                        <ui:Label class="cap-section-title" text="PROYECCIÓN A 5 AÑOS" />
                        <ui:VisualElement name="CapProjectionTable" class="cap-projection-table" />
                    </ui:VisualElement>
                    <ui:VisualElement class="cap-section">
                        <ui:Label class="cap-section-title" text="JUGADORES QUE EXPIRAN" />
                        <ui:Label name="CapExpiringLabel" class="cap-expiring-label" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement class="cap-section">
                        <ui:Label class="cap-section-title" text="EXCEPCIONES DISPONIBLES" />
                        <ui:VisualElement name="CapExceptionsRow" class="cap-exceptions-row">
                            <ui:VisualElement class="cap-exception-box">
                                <ui:Label class="cap-exception-name" text="NT-MLE" />
                                <ui:Label name="CapExceptionNtMle" class="cap-exception-value" text="" />
                            </ui:VisualElement>
                            <ui:VisualElement class="cap-exception-box">
                                <ui:Label class="cap-exception-name" text="T-MLE" />
                                <ui:Label name="CapExceptionTMle" class="cap-exception-value" text="" />
                            </ui:VisualElement>
                            <ui:VisualElement class="cap-exception-box">
                                <ui:Label class="cap-exception-name" text="SALARIO MÍNIMO" />
                                <ui:Label name="CapExceptionMin" class="cap-exception-value" text="" />
                            </ui:VisualElement>
                            <ui:VisualElement class="cap-exception-box">
                                <ui:Label class="cap-exception-name" text="LUXURY / 2º APRON" />
                                <ui:Label name="CapExceptionApron" class="cap-exception-value" text="" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Tab Content: GRÁFICO -->
                <ui:VisualElement name="PanelChart" class="finances-panel" style="display:none;">
                    <ui:VisualElement class="finances-panel-header">
                        <ui:Label class="finances-panel-title" text="BALANCE MENSUAL" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ChartContainer" class="chart-container">
                        <ui:VisualElement name="ChartBars" class="chart-bars" />
                        <ui:VisualElement name="ChartLabels" class="chart-labels" />
                    </ui:VisualElement>
                    <ui:VisualElement class="chart-legend">
                        <ui:VisualElement class="chart-legend-item">
                            <ui:VisualElement class="chart-legend-dot chart-legend-dot--income" />
                            <ui:Label class="chart-legend-text" text="Superávit" />
                        </ui:VisualElement>
                        <ui:VisualElement class="chart-legend-item">
                            <ui:VisualElement class="chart-legend-dot chart-legend-dot--expense" />
                            <ui:Label class="chart-legend-text" text="Déficit" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

        <!-- ══ MODAL CONFIGURACIÓN ══ -->
        <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigModalBox" class="modal-box">
                <ui:Label class="modal-title" text="CONFIGURACIÓN" />
                <ui:VisualElement class="modal-body">
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="AUDIO" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="Volumen General" />
                            <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="Música" />
                            <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="Efectos" />
                            <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="GRÁFICOS" />
                        <ui:VisualElement class="settings-quality-row">
                            <ui:Label class="settings-label" text="Calidad" />
                            <ui:VisualElement class="settings-quality-options">
                                <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="Baja" />
                                <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="Media" />
                                <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="Alta" />
                                <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="Ultra" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="JUEGO" />
                        <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="VOLVER AL MENÚ PRINCIPAL" />
                        <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="SALIR DEL JUEGO" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ConfigBtnCerrar" class="modal-close" text="CERRAR" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR VOLVER AL MENÚ PRINCIPAL ══ -->
        <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="VOLVER AL MENÚ PRINCIPAL" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="¿Estás seguro de que quieres volver al menú principal?" />
                    <ui:Label class="modal-paragraph" text="Se perderá el progreso no guardado de la partida actual. Asegúrate de haber guardado antes de continuar." />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="NO, QUEDARME" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="SÍ, VOLVER" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR SALIR DEL JUEGO ══ -->
        <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="SALIR DEL JUEGO" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="¿Estás seguro de que quieres salir del juego?" />
                    <ui:Label class="modal-paragraph" text="Se cerrará la aplicación. Asegúrate de haber guardado tu progreso si lo deseas." />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="NO" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="SÍ, SALIR" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

</ui:UXML>
