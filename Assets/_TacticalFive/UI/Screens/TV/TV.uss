/* ══════════════════════════════════════════
   TV — TV.uss
   ══════════════════════════════════════════ */

.tv-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.tv-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.tv-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 20px;
    min-height: 0;
    overflow: auto;
}

.panel-tv {
    margin-bottom: 20px;
}

.tv-deals {
    flex-direction: column;
    padding: 16px;
}

.tv-deal-item {
    flex-direction: row;
    align-items: center;
    padding: 12px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
}

.tv-channel-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    color: rgb(208, 216, 232);
    width: 150px;
    flex-shrink: 0;
}

.tv-deal-type {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 12px;
    color: rgb(85, 102, 119);
    width: 120px;
    flex-shrink: 0;
}

.tv-deal-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    color: rgb(39, 174, 96);
    flex-grow: 1;
    -unity-text-align: middle-right;
}

.tv-schedule {
    flex-direction: column;
}

.tv-schedule-item {
    flex-direction: row;
    align-items: center;
    padding: 12px 16px;
    background-color: rgb(22, 26, 36);
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
}

.tv-schedule-date {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 12px;
    color: rgb(58, 74, 99);
    width: 80px;
    flex-shrink: 0;
}

.tv-schedule-matchup {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
}

.tv-schedule-channel {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 12px;
    color: rgb(85, 102, 119);
    width: 120px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}
