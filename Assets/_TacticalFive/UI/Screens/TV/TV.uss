/* ══════════════════════════════════════════
   TV — TV.uss
   ══════════════════════════════════════════ */

.tv-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ══ SCREEN HEADER ══ */
.screen-header.panel--gold {
    flex-shrink: 0;
    padding: 0;
    margin: 16px 20px 12px 20px;
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    background-color: rgb(33, 32, 28);
    border-radius: 4px;
    overflow: hidden;
}
.screen-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    background-color: rgb(33, 32, 28);
}
.screen-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    white-space: normal;
}

.tv-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.tv-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 16px 40px 30px 40px;
    min-height: 0;
    overflow: auto;
    align-items: center;
}

/* ── Current TV Banner ── */
.current-tv-banner {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    padding: 14px 20px;
    margin-bottom: 24px;
}

.current-tv-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(248, 196, 64);
    letter-spacing: 2px;
    margin-right: 12px;
}

.current-tv-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(208, 216, 232);
}

/* ── Cards Container ── */
.tv-cards-container {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 40px;
    width: 100%;
}

/* ── TV Card ── */
.tv-card {
    flex-direction: column;
    width: 360px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    padding: 28px;
    align-items: center;
    margin: 0 16px;
}

.tv-card-logo {
    width: 300px;
    height: 279px;
    margin-bottom: 16px;
    border-radius: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.tv-card-logo--grayscale {
    -unity-background-image-tint-color: rgb(80, 80, 80);
}

.tv-card-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    color: rgb(208, 216, 232);
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.tv-card-row {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
}

.tv-card-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(85, 102, 119);
}

.tv-card-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
}

/* ── Contract Button ── */
.tv-card-btn {
    margin-top: 20px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(100, 200, 140);
    background-color: rgb(20, 36, 35);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    border-radius: 8px;
    padding: 12px 20px;
    width: 100%;
    -unity-text-align: middle-center;
    cursor: pointer;
}

.tv-card-btn:hover {
    background-color: rgb(23, 59, 45);
    color: rgb(150, 220, 180);
}

.tv-card-btn:active {
    background-color: rgb(25, 75, 52);
}

.tv-card-btn--disabled {
    background-color: rgb(26, 30, 38);
    border-color: rgb(100, 110, 130);
    color: rgb(120, 130, 150);
}

.tv-card-btn--disabled:hover {
    background-color: rgb(26, 30, 38);
    color: rgb(120, 130, 150);
}

/* ── Info Message ── */
.tv-info-message {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(85, 102, 119);
    margin-top: 30px;
    -unity-text-align: middle-center;
}
