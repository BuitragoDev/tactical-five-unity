<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="TV.uss" />
    <Style src="../Dashboard/Dashboard.uss" />

    <ui:VisualElement name="TVRoot" class="tv-root">

        <!-- ══ SIDEBAR ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="tv-main">

            <!-- TOP HEADER -->

            <!-- TITLE BOX -->
            <ui:VisualElement class="tv-title-box">
                <ui:Label class="tv-title-box-label" text="TELEVISIÓN" />
            </ui:VisualElement>

            <!-- TV CONTENT -->
            <ui:VisualElement class="tv-content">

                <!-- Current TV banner -->
                <ui:VisualElement name="CurrentTVBanner" class="current-tv-banner" style="display:none;">
                    <ui:Label class="current-tv-label" text="CONTRATO ACTUAL" />
                    <ui:Label name="CurrentTVName" class="current-tv-name" text="" />
                </ui:VisualElement>

                <!-- Cards container -->
                <ui:VisualElement name="TVCardsContainer" class="tv-cards-container" />

                <!-- Info message -->
                <ui:Label name="TVInfoMessage" class="tv-info-message" text="Los contratos con cadenas de televisión solo se pueden firmar en el mes de octubre." />

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
