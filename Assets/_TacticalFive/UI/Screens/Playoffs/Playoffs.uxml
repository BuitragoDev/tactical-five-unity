<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_TacticalFive/UI/Screens/Playoffs/Playoffs.uss?fileID=7433441132597879392&amp;guid=4c70296125342de6a9e29705f64cc0eb&amp;type=3#Playoffs"/>
    <Style src="project://database/Assets/_TacticalFive/UI/Screens/Dashboard/Dashboard.uss?fileID=7433441132597879392&amp;guid=4ea72934f300e2fc78940e1d76d7e1a8&amp;type=3#Dashboard"/>
    <Style src="../LegalNotice/LegalNotice.uss" />
    <ui:VisualElement name="PlayoffsRoot" class="playoffs-root">
        <ui:VisualElement class="playoffs-main">
            <!-- SCREEN HEADER -->
            <ui:VisualElement class="playoffs-screen-header panel--gold">
                <ui:VisualElement class="playoffs-screen-header-row">
                    <ui:VisualElement name="PlayoffsScreenIcon" class="playoffs-screen-icon" />
                    <ui:Label text="{loc:ui.playoffs.eliminatorias_de_play_in_y_playoff}" class="playoffs-screen-title" />
                </ui:VisualElement>
                <ui:Label name="PlayoffsSubtitle" text="" class="playoffs-screen-subtitle" />
            </ui:VisualElement>
            <ui:VisualElement class="playoffs-body">
                <ui:VisualElement class="playoffs-scroll-row">
                    <ui:VisualElement name="PlayoffsViewport" class="playoffs-viewport">
                        <ui:VisualElement name="PlayoffsContent" class="playoffs-content">
                        <ui:VisualElement name="RegularSeasonEmpty" class="bracket-empty" style="display: none;">
                            <ui:Label text="🏀" class="bracket-empty-icon"/>
                            <ui:Label text="{loc:ui.playoffs.temporada_regular_en_curso}" class="bracket-empty-title"/>
                            <ui:Label text="{loc:ui.playoffs.el_bracket_de_playoffs_y_play_in_estara_fb0b45f0}" class="bracket-empty-subtitle"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="PlayInPanel" class="panel panel-playoffs">
                            <ui:VisualElement class="panel-header" style="background-color: rgb(157, 114, 3);">
                                <ui:Label text="{loc:ui.playoffs.play_in_tournament}" class="panel-title"/>
                                <ui:Label text="▼" class="panel-toggle-arrow"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="PlayInBody" class="playoffs-bracket"/>
                            <ui:Label name="NoPlayInText" text="{loc:ui.playoffs.no_play_in_text}" class="no-data-text"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="panel panel-playoffs">
                            <ui:VisualElement class="panel-header" style="background-color: rgb(8, 134, 138);">
                                <ui:Label text="{loc:ui.playoffs.playoffs_conferencia_este}" class="panel-title"/>
                                <ui:Label text="▼" class="panel-toggle-arrow"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="EastBracket" class="playoffs-bracket"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="panel panel-playoffs">
                            <ui:VisualElement class="panel-header" style="background-color: rgb(8, 138, 82);">
                                <ui:Label text="{loc:ui.playoffs.playoffs_conferencia_oeste}" class="panel-title"/>
                                <ui:Label text="▼" class="panel-toggle-arrow"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="WestBracket" class="playoffs-bracket"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="FinalsPanel" class="panel panel-playoffs panel-finals">
                            <ui:VisualElement class="panel-header" style="background-color: rgb(157, 114, 3);">
                                <ui:Label text="{loc:ui.playoffs.finales_nba}" class="panel-title"/>
                                <ui:Label text="▼" class="panel-toggle-arrow"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="FinalsBody" class="playoffs-bracket"/>
                            <ui:Label name="NoFinalsText" text="{loc:ui.playoffs.no_finals_text}" class="no-data-text"/>
                        </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="PlayoffsScrollTrack" class="playoffs-scrollbar">
                        <ui:VisualElement name="PlayoffsScrollThumb" class="playoffs-scrollbar-thumb" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

        <!-- ══ MODAL CONFIGURACIÓN ══ -->
        <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigModalBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.playoffs.configuracion}" />
                <ui:VisualElement class="modal-body">
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.playoffs.audio}" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.playoffs.volumen_general}" />
                            <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.playoffs.musica}" />
                            <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.playoffs.efectos}" />
                            <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.playoffs.graficos}" />
                        <ui:VisualElement class="settings-quality-row">
                            <ui:Label class="settings-label" text="{loc:ui.playoffs.calidad}" />
                            <ui:VisualElement class="settings-quality-options">
                                <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="{loc:ui.playoffs.config_btn_quality_low}" />
                                <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="{loc:ui.playoffs.config_btn_quality_medium}" />
                                <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="{loc:ui.playoffs.config_btn_quality_high}" />
                                <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="{loc:ui.playoffs.config_btn_quality_ultra}" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.playoffs.juego}" />
                        <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="{loc:ui.playoffs.config_btn_main_menu}" />
                        <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="{loc:ui.playoffs.config_btn_exit}" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ConfigBtnCerrar" class="modal-close" text="{loc:ui.playoffs.config_btn_cerrar}" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR VOLVER AL MENÚ PRINCIPAL ══ -->
        <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.playoffs.volver_al_menu_principal}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.playoffs.estas_seguro_de_que_quieres_volver_al_me_6f548452}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.playoffs.se_perdera_el_progreso_no_guardado_de_la_b10b7334}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="{loc:ui.playoffs.config_btn_main_menu_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="{loc:ui.playoffs.config_btn_main_menu_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR SALIR DEL JUEGO ══ -->
        <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.playoffs.salir_del_juego}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.playoffs.estas_seguro_de_que_quieres_salir_del_ju_c65dd5f1}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.playoffs.tu_progreso_se_guarda_automaticamente_du_10fb1edb}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="{loc:ui.playoffs.config_btn_exit_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="{loc:ui.playoffs.config_btn_exit_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
</ui:UXML>
