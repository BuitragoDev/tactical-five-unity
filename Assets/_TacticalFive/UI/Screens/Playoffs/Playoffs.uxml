<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Playoffs.uss" />
    <Style src="../Dashboard/Dashboard.uss" />

    <ui:VisualElement name="PlayoffsRoot" class="playoffs-root">

        <!-- ══ SIDEBAR ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="playoffs-main">

            <!-- TOP HEADER -->

            <!-- PLAYOFFS BODY (clipping container) -->
            <ui:VisualElement class="playoffs-body">
                <ui:ScrollView class="playoffs-scroll"
                               horizontal-scrolling-enabled="false"
                               mode="Vertical">

                    <!-- Regular season empty state -->
                    <ui:VisualElement name="RegularSeasonEmpty" class="bracket-empty" style="display: none;">
                        <ui:Label class="bracket-empty-icon" text="🏀" />
                        <ui:Label class="bracket-empty-title" text="TEMPORADA REGULAR EN CURSO" />
                        <ui:Label class="bracket-empty-subtitle" text="El bracket de Playoffs y Play-In estará disponible cuando termine la temporada regular." />
                    </ui:VisualElement>

                    <!-- Play-In -->
                    <ui:VisualElement name="PlayInPanel" class="panel panel-playoffs" style="border-color: rgb(212, 160, 23);">
                        <ui:VisualElement class="panel-header">
                            <ui:Label class="panel-title" text="PLAY-IN TOURNAMENT" />
                        </ui:VisualElement>
                        <ui:VisualElement name="PlayInBody" class="playoffs-bracket" />
                        <ui:Label name="NoPlayInText" class="no-data-text" text="PLAY-IN NO DISPONIBLE AÚN" />
                    </ui:VisualElement>

                    <!-- Eastern Conference -->
                    <ui:VisualElement class="panel panel-playoffs"  style="border-color: rgb(8, 134, 138);">
                        <ui:VisualElement class="panel-header">
                            <ui:Label class="panel-title" text="PLAYOFFS — CONFERENCIA ESTE" />
                        </ui:VisualElement>
                        <ui:VisualElement name="EastBracket" class="playoffs-bracket" />
                    </ui:VisualElement>

                    <!-- Western Conference -->
                    <ui:VisualElement class="panel panel-playoffs"  style="border-color: rgb(8, 138, 82);">
                        <ui:VisualElement class="panel-header">
                            <ui:Label class="panel-title" text="PLAYOFFS — CONFERENCIA OESTE" />
                        </ui:VisualElement>
                        <ui:VisualElement name="WestBracket" class="playoffs-bracket" />
                    </ui:VisualElement>

                    <!-- NBA Finals -->
                    <ui:VisualElement name="FinalsPanel" class="panel panel-playoffs panel-finals"  style="border-color: rgb(212, 160, 23);">
                        <ui:VisualElement class="panel-header">
                            <ui:Label class="panel-title" text="FINALES NBA" />
                        </ui:VisualElement>
                        <ui:VisualElement name="FinalsBody" class="playoffs-bracket" />
                        <ui:Label name="NoFinalsText" class="no-data-text" text="FINALES NO DISPONIBLES AÚN" />
                    </ui:VisualElement>

                </ui:ScrollView>
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
