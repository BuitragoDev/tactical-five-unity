/* ══════════════════════════════════════════
   PLAYOFFS — Playoffs.uss
   ══════════════════════════════════════════ */

.playoffs-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.playoffs-main {
    flex-direction: column;
    flex-grow: 1;
}

/* ── SCREEN HEADER ── */
.playoffs-screen-header.panel--gold {
    flex-shrink: 0;
    padding: 0;
    margin: 16px 20px 12px 20px;
    border-color: rgb(212, 160, 23);
    border-width: 1px;
    background-color: rgb(33, 32, 28);
    border-radius: 4px;
    overflow: hidden;
}
.playoffs-screen-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    background-color: rgb(33, 32, 28);
}
.playoffs-screen-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.playoffs-screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    white-space: normal;
}
.playoffs-screen-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(212, 160, 23);
    padding: 0 14px;
    background-color: rgb(33, 32, 28);
}

.playoffs-body {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}

.playoffs-scroll-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}
.playoffs-viewport {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    position: relative;
}
.playoffs-content {
    flex-direction: column;
    flex-shrink: 0;
    padding: 20px;
}
.playoffs-scrollbar {
    width: 12px;
    min-width: 12px;
    flex-shrink: 0;
    align-self: stretch;
    margin-left: 4px;
    background-color: rgb(18, 24, 34);
    border-left-width: 1px;
    border-left-color: rgb(26, 47, 89);
    position: relative;
}
.playoffs-scrollbar-thumb {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 0;
    height: 40px;
    background-color: rgb(42, 95, 201);
    border-radius: 3px;
}
.playoffs-scrollbar:hover .playoffs-scrollbar-thumb {
    background-color: rgb(70, 130, 230);
}

.panel-playoffs {
    margin-bottom: 16px;
    flex-shrink: 0;
    max-width: 100%;
    margin-left: 0;
}

.panel-finals {
    border-top-width: 3px;
    border-top-color: rgb(212, 160, 23);
}

.panel-toggle-arrow {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(255, 255, 255);
    margin-left: auto;
    -unity-text-align: middle-right;
}

.playoffs-bracket {
    flex-direction: column;
    padding: 12px 18px;
}

.playoff-series {
    flex-direction: column;
    margin-bottom: 12px;
    background-color: rgb(17, 24, 34);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 2px;
}

.playoff-series--my-team {
    border-left-width: 3px;
    border-left-color: rgb(212, 160, 23);
}

.playoff-series-header {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    background-color: rgb(22, 26, 36);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}

.playoff-round-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(85, 102, 119);
    flex-grow: 1;
}

.playoff-series-status {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: rgb(212, 160, 23);
}

.playoff-game-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}

.playoff-game-row--my-game {
    background-color: rgb(20, 28, 48);
}

.playoff-game-teams {
    flex: 1 1 auto;
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.playoff-team-block {
    flex-direction: row;
    align-items: center;
    flex: 0 0 auto;
    min-width: 0;
}

.playoff-team-logo {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin: 0 8px;
}

.playoff-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    text-transform: uppercase;
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    -unity-text-align: middle-left;
}

.playoff-team-block--away .playoff-team-name {
    -unity-text-align: middle-right;
}

.playoff-team-block--home {
    justify-content: flex-start;
    width: 260px;
    flex: 0 0 260px;
}

.playoff-team-block--away {
    justify-content: flex-end;
    width: 260px;
    flex: 0 0 260px;
}

.playoff-score-block {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    width: 80px;
    justify-content: center;
    margin: 0 12px;
}

.playoff-score {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.playoff-score--winner {
    color: rgb(212, 160, 23);
}

.playoff-score-sep {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(58, 74, 99);
    margin: 0 4px;
}

.playoff-game-type {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: rgb(85, 102, 119);
    margin-left: 12px;
    flex-shrink: 0;
    width: 60px;
}

.no-data-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(58, 74, 99);
    -unity-text-align: middle-center;
    padding: 24px;
}

/* Bracket empty state */
.bracket-empty {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    min-height: 400px;
}

.bracket-empty-icon {
    font-size: 64px;
    color: rgb(58, 74, 99);
    -unity-text-align: middle-center;
    margin-bottom: 24px;
    opacity: 0.3;
}

.bracket-empty-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.bracket-empty-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    max-width: 600px;
}

/* ── Dynamically created bracket elements ── */

.playoff-round-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(212, 160, 23);
    padding: 16px 0 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    margin-bottom: 8px;
    flex-shrink: 0;
}

.playoff-placeholder {
    flex-direction: column;
    padding: 16px;
    margin-bottom: 12px;
}

.playoff-placeholder-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 12px;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
}

.playoff-series-type {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: rgb(85, 102, 119);
    flex-shrink: 0;
}

.playoff-series-matchup {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: 6px 0px;
    background-color: rgb(15, 20, 28);
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
}

.playoff-matchup-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    text-transform: uppercase;
    color: rgb(140, 155, 180);
    width: 80px;
    -unity-text-align: middle-center;
}

.playoff-matchup-leader {
    color: rgb(212, 160, 23);
}

.playoff-matchup-score {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(200, 210, 230);
    margin: 0 12px;
    min-width: 40px;
    -unity-text-align: middle-center;
}