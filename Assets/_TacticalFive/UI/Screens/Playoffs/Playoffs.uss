/* ══════════════════════════════════════════
   PLAYOFFS — Playoffs.uss
   ══════════════════════════════════════════ */

.playoffs-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.playoffs-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.playoffs-scroll {
    flex-grow: 1;
    min-height: 0;
}

.playoffs-content {
    flex-direction: column;
    padding: 20px;
}

.panel-playoffs {
    margin-bottom: 16px;
}

.panel-finals {
    border-top-width: 3px;
    border-top-color: rgb(212, 160, 23);
}

.playoffs-bracket {
    flex-direction: column;
    padding: 12px 18px;
}

.playoff-series {
    flex-direction: column;
    margin-bottom: 12px;
    background-color: rgb(17, 24, 34);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 2px;
}

.playoff-series--my-team {
    border-left-width: 3px;
    border-left-color: rgb(212, 160, 23);
}

.playoff-series-header {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    background-color: rgb(22, 26, 36);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}

.playoff-round-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 11px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(85, 102, 119);
    flex-grow: 1;
}

.playoff-series-status {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 12px;
    color: rgb(212, 160, 23);
}

.playoff-game-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}

.playoff-game-row--my-game {
    background-color: rgb(20, 28, 48);
}

.playoff-game-teams {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.playoff-team-block {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    width: 140px;
}

.playoff-team-block--away {
    justify-content: flex-end;
}

.playoff-team-logo {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
}

.playoff-team-block--away .playoff-team-logo {
    margin-right: 6px;
}

.playoff-team-block--home .playoff-team-logo {
    margin-left: 6px;
}

.playoff-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 12px;
    color: rgb(208, 216, 232);
    -unity-text-transform: upper;
}

.playoff-team-block--away .playoff-team-name {
    margin-right: 6px;
    -unity-text-align: middle-right;
}

.playoff-team-block--home .playoff-team-name {
    margin-left: 6px;
    -unity-text-align: middle-left;
}

.playoff-score-block {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    width: 80px;
    justify-content: center;
}

.playoff-score {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.playoff-score--winner {
    color: rgb(212, 160, 23);
}

.playoff-score-sep {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 12px;
    color: rgb(58, 74, 99);
    margin: 0 4px;
}

.playoff-game-type {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 10px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(85, 102, 119);
    margin-left: 12px;
    flex-shrink: 0;
    width: 60px;
}

.no-data-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(58, 74, 99);
    -unity-text-align: middle-center;
    padding: 24px;
}

/* Bracket empty state */
.bracket-empty {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    min-height: 400px;
}

.bracket-empty-icon {
    font-size: 64px;
    color: rgb(58, 74, 99);
    -unity-text-align: middle-center;
    margin-bottom: 24px;
    opacity: 0.3;
}

.bracket-empty-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.bracket-empty-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 14px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    max-width: 400px;
}
