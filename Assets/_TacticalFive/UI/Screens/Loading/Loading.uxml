<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Loading.uss" />

    <ui:VisualElement name="LoadingRoot" class="loading-root">
        <ui:VisualElement name="LoadingLogo" class="loading-logo" />
        <ui:Label class="loading-prompt" text="Pulsa cualquier tecla o haz clic para continuar" />
        <ui:VisualElement class="loading-spacer" />
        <ui:Label name="LoadingTip" class="loading-tip" text="" />
    </ui:VisualElement>

</ui:UXML>
