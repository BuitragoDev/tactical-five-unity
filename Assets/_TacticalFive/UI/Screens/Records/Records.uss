/* ══════════════════════════════════════════
   RECORDS — Records.uss
   ══════════════════════════════════════════ */

.records-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.records-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.records-scroll {
    flex-grow: 1;
    min-height: 0;
}

.records-content {
    flex-direction: column;
    padding: 20px;
}

.panel-records {
    margin-bottom: 16px;
}

.records-table {
    flex-direction: column;
    padding: 12px 18px;
}

.record-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    background-color: rgb(17, 24, 34);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}

.record-stat {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 13px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(85, 102, 119);
    width: 100px;
    flex-shrink: 0;
}

.record-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 20px;
    color: rgb(212, 160, 23);
    width: 50px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.record-player {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
}

.record-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 12px;
    color: rgb(85, 102, 119);
    width: 50px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

.record-date {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 12px;
    color: rgb(58, 74, 99);
    width: 100px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}
