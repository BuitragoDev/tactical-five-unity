/* ══════════════════════════════════════════
   RECORDS — Records.uss (fichas 3x3)
   ══════════════════════════════════════════ */

.records-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.records-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

/* ══ SCREEN HEADER ══ */
.screen-header.panel--gold {
    flex-shrink: 0;
    padding: 0;
    margin: 16px 20px 12px 20px;
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    background-color: rgba(120, 95, 30, 0.15);
    border-radius: 4px;
    overflow: hidden;
}
.screen-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    background-color: rgba(120, 95, 30, 0.15);
}
.screen-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    white-space: normal;
}

.records-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 18px 28px 0;
    min-height: 0;
}

/* ── PAGE HEADER ── */


/* ── TABS ── */

.records-tabs {
    flex-direction: row;
    margin-bottom: 18px;
    flex-shrink: 0;
}

.records-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 24px;
    background-color: rgb(18, 23, 34);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 6px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-right: 8px;
    cursor: pointer;
}
.records-tab:hover {
    color: rgb(208, 216, 232);
    border-color: rgb(74, 94, 119);
}

.records-tab--active {
    background-color: rgb(212, 160, 23);
    border-color: rgb(212, 160, 23);
    color: rgb(15, 17, 23);
}
.records-tab--active:hover {
    color: rgb(15, 17, 23);
    border-color: rgb(212, 160, 23);
}

/* ── SCROLL / GRID ── */

.records-scroll {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow-y: auto;
}

.records-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-left: -9px;
    margin-right: -9px;
}

/* ── CARD ── */

.record-card {
    flex-basis: 33.33%;
    min-width: 0;
    padding: 0 9px;
    margin-bottom: 18px;
}

.record-card-inner {
    flex-direction: column;
    background-color: rgb(13, 20, 33);
    border-width: 1px;
    border-color: rgb(30, 42, 62);
    border-radius: 8px;
    padding: 16px 18px;
    min-height: 198px;
    position: relative;
    overflow: hidden;
}
.record-card-inner:hover {
    background-color: rgb(16, 24, 40);
    border-color: rgb(45, 62, 90);
}

.record-card--featured .record-card-inner {
    border-color: rgb(212, 160, 23);
}

/* watermark */
.record-card-watermark {
    position: absolute;
    top: 34px;
    right: 10px;
    width: 118px;
    height: 118px;
    opacity: 0.06;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(120, 170, 255);
}

/* head */
.record-card-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.record-card-badge {
    width: 46px;
    height: 46px;
    border-radius: 23px;
    background-color: rgba(42, 95, 201, 0.12);
    border-width: 1px;
    border-color: rgba(74, 128, 240, 0.45);
    align-items: center;
    justify-content: center;
    margin-right: 14px;
    flex-shrink: 0;
}

.record-card-badge-img {
    width: 24px;
    height: 24px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(120, 170, 255);
}

.record-card-head-text {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.record-card-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
}

.record-card-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-transform: upper;
    margin-top: 1px;
    white-space: normal;
}

/* body */
.record-card-body {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.record-card-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 48px;
    color: rgb(212, 160, 23);
    min-width: 92px;
    -unity-text-align: middle-left;
    flex-shrink: 0;
    margin-right: 12px;
}

.record-card-info {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.record-card-player {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(255, 255, 255);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 6px;
}

.record-card-team-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.record-card-team-logo {
    width: 32px;
    height: 32px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.record-card-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(179, 190, 214);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.record-card-date-row {
    flex-direction: row;
    align-items: center;
}

.record-card-date-icon {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(122, 138, 170);
}

.record-card-date {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
}

/* ── EMPTY ── */

.records-empty {
    flex-basis: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
}

.records-empty-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}
