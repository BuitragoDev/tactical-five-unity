<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Records.uss" />
    <Style src="../Dashboard/Dashboard.uss" />

    <ui:VisualElement name="RecordsRoot" class="records-root">

        <!-- ══ SIDEBAR ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="records-main">

            <!-- TOP HEADER -->
            <ui:VisualElement name="TopHeader" class="top-header">
                <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo" />
                <ui:VisualElement class="header-team-info">
                    <ui:Label name="HeaderTeamName"    class="header-team-name"    text="" />
                    <ui:Label name="HeaderManagerName" class="header-manager-name" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="PRESUPUESTO" />
                    <ui:Label name="HeaderBudget" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MASA SALARIAL" />
                    <ui:Label name="HeaderPayroll" class="header-stat-value header-stat-value--neutral" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MARGEN SALARIAL" />
                    <ui:Label name="HeaderMargin" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="QUÍMICA DE EQUIPO" />
                    <ui:Label name="HeaderChemistry" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-spacer" />
                <ui:VisualElement class="header-season-info">
                    <ui:Label name="HeaderSeason" class="header-season-label" text="" />
                    <ui:Label name="HeaderDate"   class="header-date-label"   text="" />
                </ui:VisualElement>
                <ui:Button name="BtnAction" class="btn-action" text="CONTINUAR →" />
                <ui:VisualElement name="ConfigIcon" class="header-config-icon" />
            </ui:VisualElement>

            <!-- RECORDS TITLE BOX -->
            <ui:VisualElement class="records-title-box">
                <ui:Label class="records-title-box-label" text="RÉCORDS HISTÓRICOS" />
            </ui:VisualElement>

            <!-- RECORDS CONTENT -->
            <ui:VisualElement class="records-content">

                <!-- Filter tabs -->
                <ui:VisualElement class="records-tabs">
                    <ui:Button name="TabTeam"       class="records-tab records-tab--active" text="MI EQUIPO" />
                    <ui:Button name="TabSeason"     class="records-tab" text="TEMPORADA" />
                    <ui:Button name="TabHistorical" class="records-tab" text="HISTÓRICO" />
                </ui:VisualElement>

                <!-- Records table -->
                <ui:VisualElement class="records-panel">
                    <ui:VisualElement class="records-header-row">
                        <ui:Label class="records-col records-col--stat" text="ESTADÍSTICA" />
                        <ui:Label class="records-col records-col--value" text="VALOR" />
                        <ui:Label class="records-col records-col--player" text="JUGADOR" />
                        <ui:Label name="HeaderTeamCol" class="records-col records-col--team" text="EQUIPO" />
                        <ui:Label class="records-col records-col--date" text="FECHA" />
                    </ui:VisualElement>
                    <ui:VisualElement name="RecordsBody" class="records-table" />
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
