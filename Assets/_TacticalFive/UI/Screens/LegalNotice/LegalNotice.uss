/* ── OVERLAY ── */
.modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(18, 21, 28);
    align-items: center;
    justify-content: center;
    display: none;
}

.modal-overlay--visible {
    background-color: rgb(0, 0, 0);
    display: flex;
}

/* ── CAJA MODAL ── */
.modal-box {
    position: absolute;
    width: 820px;
    background-color: rgb(13, 14, 18);
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    border-radius: 12px;
    padding: 0;
    overflow: hidden;
    display: none;
}

.modal-box--visible {
    display: flex;
    flex-direction: column;
}

/* ── TÍTULO ── */
.modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 34px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
    padding: 10px 24px;
    background-color: rgb(33, 32, 28);
    border-bottom-width: 1px;
    border-bottom-color: rgb(212, 160, 23);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}

/* ── CUERPO ── */
.modal-body {
    width: 100%;
    padding: 20px 24px;
    flex-direction: column;
}

.modal-paragraph {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    white-space: normal;
    margin-bottom: 16px;
    width: 100%;
}

.modal-paragraph--highlight {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(208, 216, 232);
}

.modal-paragraph--gold {
    color: rgb(240, 192, 64);
}

.modal-copyright {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(180, 190, 210);
    margin-top: 8px;
    width: 100%;
}

/* ── BOTÓN CERRAR ── */
.modal-close {
    cursor: pointer;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    color: rgb(120, 160, 230);
    background-color: rgb(20, 28, 45);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    border-radius: 8px;
    padding: 12px 32px;
    margin: 12px 16px;
    -unity-text-align: middle-center;
}

.modal-close:hover {
    background-color: rgb(24, 40, 71);
    color: rgb(150, 190, 255);
}

/* ── ACCIONES MODAL ── */
.modal-actions {
    flex-direction: row;
    justify-content: flex-end;
    width: auto;
    align-self: stretch;
    margin: 8px 20px 16px;
}

.modal-spacer {
    width: 16px;
    flex-shrink: 0;
}

.modal-btn {
    cursor: pointer;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    border-width: 2px;
    border-radius: 8px;
    padding: 12px 32px;
    -unity-text-align: middle-center;
    min-width: 170px;
}

.modal-btn--secondary {
    background-color: rgb(26, 30, 38);
    border-color: rgb(100, 110, 130);
    color: rgb(160, 170, 190);
}

.modal-btn--secondary:hover {
    background-color: rgb(38, 43, 54);
    color: rgb(200, 210, 230);
}

.modal-btn--danger {
    background-color: rgb(35, 25, 30);
    border-color: rgb(192, 57, 43);
    color: rgb(230, 120, 100);
}

.modal-btn--danger:hover {
    background-color: rgb(62, 30, 32);
    color: rgb(240, 145, 125);
}

.modal-btn--primary {
    background-color: rgb(20, 28, 45);
    border-color: rgb(42, 95, 201);
    color: rgb(120, 160, 230);
}

.modal-btn--primary:hover {
    background-color: rgb(24, 40, 71);
    color: rgb(150, 190, 255);
}

/* ══ CONFIG MODAL (global, heredado por UIScreenController) ══ */
#ConfigModalBox {
    width: 650px;
}
#ConfigBtnCerrar {
    color: rgb(212, 160, 23);
    background-color: rgb(37, 35, 28);
    border-color: rgb(212, 160, 23);
    margin: 16px 20px;
}
#ConfigBtnCerrar:hover {
    background-color: rgb(66, 56, 27);
}

/* ── VARIANTE ROJA (peligro/borrado) ──
   Misma estructura que .modal-box pero en rojo; se aplica junto a la clase base. */
.modal-box--danger {
    border-color: rgb(192, 57, 43);
}
.modal-box--danger .modal-title {
    background-color: rgb(44, 26, 30);
    border-bottom-color: rgb(192, 57, 43);
}
