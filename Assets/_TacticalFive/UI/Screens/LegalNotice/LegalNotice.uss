/* ── OVERLAY ── */
.modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
    display: none;
}

.modal-overlay--visible {
    background-color: rgb(0, 0, 0);
    opacity: 0.85;
    display: flex;
}

/* ── CAJA MODAL ── */
.modal-box {
    position: absolute;
    width: 820px;
    background-color: rgb(30, 37, 53);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-top-width: 3px;
    border-top-color: rgb(212, 160, 23);
    padding: 44px 52px;
    align-items: flex-start;
    display: none;
}

.modal-box--visible {
    display: flex;
    flex-direction: column;
}

/* ── TÍTULO ── */
.modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-transform: upper;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    width: 100%;
}

/* ── CUERPO ── */
.modal-body {
    width: 100%;
    flex-direction: column;
}

.modal-paragraph {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 17px;
    color: rgb(122, 138, 170);
    white-space: normal;
    margin-bottom: 16px;
    width: 100%;
}

.modal-paragraph--highlight {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    color: rgb(208, 216, 232);
}

.modal-paragraph--gold {
    color: rgb(240, 192, 64);
}

.modal-copyright {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 15px;
    color: rgb(180, 190, 210);
    margin-top: 8px;
    width: 100%;
}

/* ── BOTÓN CERRAR ── */
.modal-close {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
    background-color: rgb(42, 95, 201);
    border-width: 0;
    padding: 12px 32px;
    margin-top: 28px;
    -unity-text-align: middle-center;
}

.modal-close:hover {
    background-color: rgb(74, 128, 240);
}

/* ── ACCIONES MODAL ── */
.modal-actions {
    flex-direction: row;
    justify-content: flex-end;
    width: 100%;
    margin-top: 28px;
}

.modal-spacer {
    width: 16px;
    flex-shrink: 0;
}

.modal-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
    border-width: 0;
    padding: 12px 32px;
    -unity-text-align: middle-center;
}

.modal-btn--secondary {
    background-color: rgb(58, 74, 99);
}

.modal-btn--secondary:hover {
    background-color: rgb(74, 94, 119);
}

.modal-btn--danger {
    background-color: rgb(192, 57, 43);
}

.modal-btn--danger:hover {
    background-color: rgb(210, 70, 55);
}