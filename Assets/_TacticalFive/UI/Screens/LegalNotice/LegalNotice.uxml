<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="LegalNotice.uss" />

    <!-- OVERLAY -->
    <ui:VisualElement name="ModalOverlay" class="modal-overlay">

        <!-- CAJA -->
        <ui:VisualElement name="ModalBox" class="modal-box">

            <!-- Título -->
            <ui:Label class="modal-title" text="{loc:ui.legal_notice.aviso_legal}" />

            <!-- Cuerpo -->
            <ui:VisualElement class="modal-body">

                <ui:Label class="modal-paragraph"
                    text="{loc:ui.legal_notice.tactical_five_es_un_videojuego_de_simula_f4a8b719}" />

                <ui:Label class="modal-paragraph"
                    text="{loc:ui.legal_notice.los_nombres_de_equipos_jugadores_y_logot_bcf4bdee}" />

                <ui:Label class="modal-paragraph"
                    text="{loc:ui.legal_notice.este_proyecto_es_de_uso_privado_y_no_tie_117d9e54}" />

                <ui:Label class="modal-copyright"
                    text="{loc:ui.legal_notice.2026_tactical_five_todos_los_derechos_re_7e789423}" />

            </ui:VisualElement>

            <!-- Botón cerrar -->
            <ui:Button name="BtnCerrar" class="modal-close" text="{loc:ui.legal_notice.btn_cerrar}" />

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>