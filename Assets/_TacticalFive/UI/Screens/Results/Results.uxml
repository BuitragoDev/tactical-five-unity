<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Results.uss" />
    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />

    <ui:VisualElement name="ResultsRoot" class="results-root">

        <!-- ══ SIDEBAR ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="results-main">

            <!-- SCREEN HEADER -->
            <ui:VisualElement class="results-screen-header panel--gold">
                <ui:VisualElement class="results-screen-header-row">
                    <ui:VisualElement name="ResultsScreenIcon" class="results-screen-icon" />
                    <ui:Label text="{loc:ui.results.resultados}" class="results-screen-title" />
                </ui:VisualElement>
                <ui:Label name="ResultsSubtitle" text="" class="results-screen-subtitle" />
            </ui:VisualElement>

            <!-- DATE NAVIGATOR -->
            <ui:VisualElement class="results-date-nav">
                <ui:Button name="BtnPrevDate" class="results-nav-btn" text="◀" />
                <ui:VisualElement class="results-date-center">
                    <ui:VisualElement name="ResultsDateIcon" class="results-date-icon" />
                    <ui:Label name="CurrentDateLabel" class="results-date-display" text="" />
                </ui:VisualElement>
                <ui:Button name="BtnHoy" class="results-today-btn" text="{loc:ui.results.btn_hoy}" />
                <ui:Button name="BtnNextDate" class="results-nav-btn" text="▶" />
            </ui:VisualElement>

            <!-- RESULTS GRID (scrollable) -->
            <ui:VisualElement name="ResultsContent" class="results-scroll">
                <ui:VisualElement name="ResultsBody" class="results-grid" />
            </ui:VisualElement>

            <!-- GAMES PAGINATOR -->
            <ui:VisualElement name="ResultsPaginator" class="results-paginator" />

        </ui:VisualElement>

    </ui:VisualElement>

    <!-- ══ MODAL DETALLES DE PARTIDO ══ -->
    <ui:VisualElement name="MatchModalOverlay" class="match-modal-overlay">
        <ui:VisualElement name="MatchModalBox" class="match-modal-box">

            <!-- HEADER -->
            <ui:VisualElement class="match-modal-header">
                <ui:VisualElement class="match-modal-header-text">
                    <ui:Label name="MatchModalSubtitle" class="match-modal-subtitle" text="" />
                    <ui:Label name="MatchModalTitle" class="match-modal-title" text="" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ARENA -->
            <ui:VisualElement class="match-modal-arena">
                <ui:VisualElement name="MatchArenaImage" class="match-modal-arena-image" />
                <ui:VisualElement class="match-modal-arena-info">
                    <ui:Label name="MatchArenaName" class="match-modal-arena-name" text="" />
                    <ui:Label name="MatchArenaAttendance" class="match-modal-arena-attendance" text="" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- TEAMS (lado a lado) -->
            <ui:VisualElement class="match-modal-teams">
                <ui:VisualElement name="MatchHomeCol" class="match-modal-team-col" />
                <ui:VisualElement name="MatchAwayCol" class="match-modal-team-col" />
            </ui:VisualElement>

            <!-- FOOTER -->
            <ui:VisualElement class="match-modal-actions">
                <ui:Button name="BtnMatchCloseFooter" class="match-modal-btn" text="{loc:ui.results.btn_match_close_footer}" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>

        <!-- ══ MODAL CONFIGURACIÓN ══ -->
        <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigModalBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.results.configuracion}" />
                <ui:VisualElement class="modal-body">
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.results.audio}" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.results.volumen_general}" />
                            <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.results.musica}" />
                            <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.results.efectos}" />
                            <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.results.graficos}" />
                        <ui:VisualElement class="settings-quality-row">
                            <ui:Label class="settings-label" text="{loc:ui.results.calidad}" />
                            <ui:VisualElement class="settings-quality-options">
                                <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="{loc:ui.results.config_btn_quality_low}" />
                                <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="{loc:ui.results.config_btn_quality_medium}" />
                                <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="{loc:ui.results.config_btn_quality_high}" />
                                <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="{loc:ui.results.config_btn_quality_ultra}" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.results.juego}" />
                        <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="{loc:ui.results.config_btn_main_menu}" />
                        <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="{loc:ui.results.config_btn_exit}" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ConfigBtnCerrar" class="modal-close" text="{loc:ui.results.config_btn_cerrar}" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR VOLVER AL MENÚ PRINCIPAL ══ -->
        <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.results.volver_al_menu_principal}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.results.estas_seguro_de_que_quieres_volver_al_me_6f548452}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.results.se_perdera_el_progreso_no_guardado_de_la_b10b7334}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="{loc:ui.results.config_btn_main_menu_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="{loc:ui.results.config_btn_main_menu_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR SALIR DEL JUEGO ══ -->
        <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.results.salir_del_juego}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.results.estas_seguro_de_que_quieres_salir_del_ju_c65dd5f1}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.results.tu_progreso_se_guarda_automaticamente_du_10fb1edb}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="{loc:ui.results.config_btn_exit_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="{loc:ui.results.config_btn_exit_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

</ui:UXML>
