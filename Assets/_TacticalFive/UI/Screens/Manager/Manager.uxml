<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Manager.uss" />
    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />

    <ui:VisualElement name="ManagerRoot" class="manager-root">

        <ui:VisualElement class="manager-main">
            <ui:VisualElement class="manager-title-row">
                <ui:Label name="ManagerTitle" class="manager-title" text="MANAGER" />
            </ui:VisualElement>

            <ui:VisualElement class="manager-body">

                <!-- LEFT COLUMN -->
                <ui:VisualElement class="manager-left">

                    <!-- Estadísticas Liga Regular -->
                    <ui:VisualElement class="manager-panel">
                        <ui:Label class="manager-panel-title" text="TEMPORADA REGULAR" />
                        <ui:VisualElement class="manager-stats-grid">
                            <ui:VisualElement class="manager-stat-item">
                                <ui:Label class="manager-stat-value" name="RegGames" text="0" />
                                <ui:Label class="manager-stat-label" text="Partidos" />
                            </ui:VisualElement>
                            <ui:VisualElement class="manager-stat-item">
                                <ui:Label class="manager-stat-value manager-stat-value--win" name="RegWins" text="0" />
                                <ui:Label class="manager-stat-label" text="Victorias" />
                            </ui:VisualElement>
                            <ui:VisualElement class="manager-stat-item">
                                <ui:Label class="manager-stat-value manager-stat-value--loss" name="RegLosses" text="0" />
                                <ui:Label class="manager-stat-label" text="Derrotas" />
                            </ui:VisualElement>
                            <ui:VisualElement class="manager-stat-item">
                                <ui:Label class="manager-stat-value" name="RegPct" text=".000" />
                                <ui:Label class="manager-stat-label" text="% Victorias" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Estadísticas Playoffs -->
                    <ui:VisualElement class="manager-panel">
                        <ui:Label class="manager-panel-title" text="PLAYOFFS" />
                        <ui:VisualElement class="manager-stats-grid">
                            <ui:VisualElement class="manager-stat-item">
                                <ui:Label class="manager-stat-value" name="PoGames" text="0" />
                                <ui:Label class="manager-stat-label" text="Partidos" />
                            </ui:VisualElement>
                            <ui:VisualElement class="manager-stat-item">
                                <ui:Label class="manager-stat-value manager-stat-value--win" name="PoWins" text="0" />
                                <ui:Label class="manager-stat-label" text="Victorias" />
                            </ui:VisualElement>
                            <ui:VisualElement class="manager-stat-item">
                                <ui:Label class="manager-stat-value manager-stat-value--loss" name="PoLosses" text="0" />
                                <ui:Label class="manager-stat-label" text="Derrotas" />
                            </ui:VisualElement>
                            <ui:VisualElement class="manager-stat-item">
                                <ui:Label class="manager-stat-value" name="PoPct" text=".000" />
                                <ui:Label class="manager-stat-label" text="% Victorias" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Relaciones -->
                    <ui:VisualElement class="manager-panel">
                        <ui:Label class="manager-panel-title" text="RELACIONES" />
                        <ui:VisualElement class="board-columns">
                            <ui:VisualElement class="board-col">
                                <ui:VisualElement name="CircleTrust" class="board-circle">
                                    <ui:Label name="ValTrust" class="board-circle-val" text="50%" />
                                </ui:VisualElement>
                                <ui:Label class="board-col-label" text="DIRECTIVA" />
                            </ui:VisualElement>
                            <ui:VisualElement class="board-col-sep" />
                            <ui:VisualElement class="board-col">
                                <ui:VisualElement name="CircleMorale" class="board-circle">
                                    <ui:Label name="ValMorale" class="board-circle-val" text="50%" />
                                </ui:VisualElement>
                                <ui:Label class="board-col-label" text="JUGADORES" />
                            </ui:VisualElement>
                            <ui:VisualElement class="board-col-sep" />
                            <ui:VisualElement class="board-col">
                                <ui:VisualElement name="CircleFanConfidence" class="board-circle">
                                    <ui:Label name="ValFanConfidence" class="board-circle-val" text="50%" />
                                </ui:VisualElement>
                                <ui:Label class="board-col-label" text="FANS" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Objetivo -->
                    <ui:VisualElement class="manager-panel">
                        <ui:Label name="ManagerObjectiveTitle" class="manager-panel-title" text="OBJETIVO DE TEMPORADA" />
                        <ui:Label name="ManagerObjectivePosition" class="manager-objective-position" text="" />
                        <ui:Label name="ManagerObjectiveStatus" class="manager-objective-status" text="" />
                    </ui:VisualElement>

                    <!-- Anillos + Manager del Mes (dos columnas) -->
                    <ui:VisualElement class="manager-awards-row">
                        <ui:VisualElement class="manager-panel manager-rings-panel manager-awards-col manager-awards-col--left">
                            <ui:VisualElement class="manager-rings-row">
                                <ui:VisualElement name="ManagerRingsTrophy" class="manager-rings-trophy" />
                                <ui:VisualElement class="manager-rings-info">
                                    <ui:Label class="manager-rings-label" text="CAMPEONATOS GANADOS" />
                                    <ui:Label name="ManagerRingsCount" class="manager-rings-count" text="0" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="manager-panel manager-awards-col manager-awards-col--right">
                            <ui:VisualElement class="manager-rings-row">
                                <ui:VisualElement class="manager-rings-info">
                                    <ui:Label class="manager-rings-label" text="MANAGER DEL MES" />
                                    <ui:Label name="ManagerMonthlyAwards" class="manager-rings-count" text="0" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- RIGHT COLUMN — RANKING -->
                <ui:VisualElement class="manager-right">
                    <ui:VisualElement class="manager-panel manager-ranking-panel">
                        <ui:Label class="manager-panel-title" text="RANKING DE ENTRENADORES" />
                        <ui:ScrollView name="RankingScroll" class="ranking-scroll" horizontal-scrolling-enabled="false" mode="Vertical">
                            <ui:VisualElement name="RankingHeader" class="ranking-header">
                                <ui:Label class="ranking-col-rank-header" text="#" />
                                <ui:Label class="ranking-col-name-header" text="ENTRENADOR" />
                                <ui:Label class="ranking-col-team-header" text="EQUIPO" />
                                <ui:Label class="ranking-col-score-header" text="PUNTOS" />
                                <ui:Label class="ranking-col-badge-header" text="" />
                            </ui:VisualElement>
                            <ui:VisualElement name="RankingBody" class="ranking-body" />
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

    <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
        <ui:VisualElement name="ConfigModalBox" class="modal-box">
            <ui:Label class="modal-title" text="CONFIGURACIÓN" />
            <ui:VisualElement class="modal-body">
                <ui:VisualElement class="settings-section">
                    <ui:Label class="settings-section-title" text="AUDIO" />
                    <ui:VisualElement class="settings-row">
                        <ui:Label class="settings-label" text="Volumen General" />
                        <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                            <ui:VisualElement class="custom-slider-track" />
                            <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                            <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                        </ui:VisualElement>
                        <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-row">
                        <ui:Label class="settings-label" text="Música" />
                        <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                            <ui:VisualElement class="custom-slider-track" />
                            <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                            <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                        </ui:VisualElement>
                        <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-row">
                        <ui:Label class="settings-label" text="Efectos" />
                        <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                            <ui:VisualElement class="custom-slider-track" />
                            <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                            <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                        </ui:VisualElement>
                        <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="settings-section">
                    <ui:Label class="settings-section-title" text="GRÁFICOS" />
                    <ui:VisualElement class="settings-quality-row">
                        <ui:Label class="settings-label" text="Calidad" />
                        <ui:VisualElement class="settings-quality-options">
                            <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="Baja" />
                            <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="Media" />
                            <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="Alta" />
                            <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="Ultra" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="settings-section">
                    <ui:Label class="settings-section-title" text="JUEGO" />
                    <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="VOLVER AL MENÚ PRINCIPAL" />
                    <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="SALIR DEL JUEGO" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="ConfigBtnCerrar" class="modal-close" text="CERRAR" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
        <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
            <ui:Label class="modal-title" text="VOLVER AL MENÚ PRINCIPAL" />
            <ui:VisualElement class="modal-body">
                <ui:Label class="modal-paragraph modal-paragraph--highlight" text="¿Estás seguro de que quieres volver al menú principal?" />
                <ui:Label class="modal-paragraph" text="Se perderá el progreso no guardado de la partida actual. Asegúrate de haber guardado antes de continuar." />
            </ui:VisualElement>
            <ui:VisualElement class="modal-actions">
                <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="NO, QUEDARME" />
                <ui:VisualElement class="modal-spacer" />
                <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="SÍ, VOLVER" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
        <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
            <ui:Label class="modal-title" text="SALIR DEL JUEGO" />
            <ui:VisualElement class="modal-body">
                <ui:Label class="modal-paragraph modal-paragraph--highlight" text="¿Estás seguro de que quieres salir del juego?" />
                <ui:Label class="modal-paragraph" text="Se cerrará la aplicación. Asegúrate de haber guardado tu progreso si lo deseas." />
            </ui:VisualElement>
            <ui:VisualElement class="modal-actions">
                <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="NO" />
                <ui:VisualElement class="modal-spacer" />
                <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="SÍ, SALIR" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

</ui:UXML>
