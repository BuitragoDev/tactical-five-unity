/* ══════════════════════════════════════════
   MANAGER — Manager.uss
   ══════════════════════════════════════════ */

.manager-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    flex-grow: 1;
}

.manager-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding: 20px 24px;
}

.manager-title-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
    flex-shrink: 0;
}

.manager-title {
    font-size: 28px;
    color: rgb(200, 170, 80);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf?fileID=4800000&guid=0b839cefea68a5446946e734e71a15b2&type=3#Saira_Condensed-SemiBold");
    text-transform: uppercase;
}

.manager-body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
}

.manager-left {
    width: 60%;
    flex-direction: column;
    min-width: 360px;
    margin-right: 20px;
}

.manager-right {
    flex-grow: 1;
    min-width: 300px;
    min-height: 0;
}

/* Panels */

.manager-panel {
    background-color: rgb(20, 24, 34);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(35, 41, 58);
    padding: 14px 16px;
    flex-direction: column;
    margin-bottom: 14px;
    overflow: hidden;
}

.manager-panel:last-child {
    margin-bottom: 0;
}

.manager-panel-title {
    font-size: 24px;
    color: rgb(140, 156, 188);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf?fileID=4800000&guid=0b839cefea68a5446946e734e71a15b2&type=3#Saira_Condensed-SemiBold");
    text-transform: uppercase;
    margin-bottom: 10px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(35, 41, 58);
}

.manager-ranking-panel {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
}

/* Stats grid */

.manager-stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.manager-stat-item {
    flex-direction: column;
    align-items: center;
    min-width: 65px;
    flex-grow: 1;
    margin-right: 8px;
}

.manager-stat-item:last-child {
    margin-right: 0;
}

.manager-stat-value {
    font-size: 24px;
    color: rgb(220, 228, 245);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf?fileID=4800000&guid=0b839cefea68a5446946e734e71a15b2&type=3#Saira_Condensed-SemiBold");
}

.manager-stat-value--win {
    color: rgb(46, 204, 113);
}

.manager-stat-value--loss {
    color: rgb(231, 76, 60);
}

.manager-stat-label {
    font-size: 16px;
    color: rgb(110, 126, 155);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf?fileID=4800000&guid=3f9a9e566c791b44f9e015bd8897f06e&type=3#Saira_Condensed-Regular");
    text-transform: uppercase;
    margin-top: 2px;
}

/* Relationship circles */

.board-columns {
    flex-direction: row;
    justify-content: space-around;
    padding: 8px 0;
}

.board-col {
    flex-direction: column;
    align-items: center;
    min-width: 60px;
}

.board-col > .board-circle {
    margin-bottom: 8px;
}

.board-col-sep {
    width: 1px;
    background-color: rgb(35, 41, 58);
}

.board-col-label {
    font-size: 16px;
    color: rgb(110, 126, 155);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf?fileID=4800000&guid=3f9a9e566c791b44f9e015bd8897f06e&type=3#Saira_Condensed-Regular");
    text-transform: uppercase;
    text-align: center;
    -unity-text-align: middle;
}

.board-circle {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    border-width: 2px;
    align-items: center;
    justify-content: center;
}

.board-circle-val {
    font-size: 32px;
    color: rgb(220, 228, 245);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf?fileID=4800000&guid=0b839cefea68a5446946e734e71a15b2&type=3#Saira_Condensed-SemiBold");
}

/* Objective */

.manager-objective-text {
    font-size: 18px;
    color: rgb(220, 228, 245);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf?fileID=4800000&guid=0b839cefea68a5446946e734e71a15b2&type=3#Saira_Condensed-SemiBold");
}

.manager-objective-position {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf?fileID=4800000&guid=3f9a9e566c791b44f9e015bd8897f06e&type=3#Saira_Condensed-Regular");
    font-size: 18px;
    color: rgb(140, 156, 188);
    margin-top: 6px;
}

.manager-objective-status {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf?fileID=4800000&guid=0b839cefea68a5446946e734e71a15b2&type=3#Saira_Condensed-SemiBold");
    font-size: 22px;
    margin-top: 4px;
    text-transform: uppercase;
}

.manager-objective-status--met {
    color: rgb(46, 204, 113);
}

.manager-objective-status--not-met {
    color: rgb(231, 76, 60);
}

/* Rings panel */

.manager-rings-row {
    flex-direction: row;
    align-items: center;
}

.manager-rings-trophy {
    width: 64px;
    height: 64px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    flex-shrink: 0;
    margin-right: 16px;
}

.manager-rings-info {
    flex-direction: column;
}

.manager-rings-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf?fileID=4800000&guid=0b839cefea68a5446946e734e71a15b2&type=3#Saira_Condensed-SemiBold");
    font-size: 16px;
    color: rgb(140, 156, 188);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.manager-rings-count {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf?fileID=4800000&guid=0b839cefea68a5446946e734e71a15b2&type=3#Saira_Condensed-Bold");
    font-size: 36px;
    color: rgb(212, 160, 23);
}

/* Ranking */

.ranking-header {
    flex-direction: row;
    padding: 6px 10px;
    background-color: rgb(15, 18, 26);
    border-radius: 4px;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.ranking-header > Label {
    font-size: 16px;
    color: rgb(110, 126, 155);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf?fileID=4800000&guid=0b839cefea68a5446946e734e71a15b2&type=3#Saira_Condensed-SemiBold");
    text-transform: uppercase;
}

.ranking-col-rank-header {
    width: 30px;
}

.ranking-col-name-header {
    flex-grow: 1;
}

.ranking-col-team-header {
    width: 64px;
    -unity-text-align: middle-center;
}

.ranking-col-score-header {
    width: 72px;
    -unity-text-align: middle-center;
}

.ranking-col-badge-header {
    width: 120px;
}

.ranking-scroll {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
}

.ranking-body {
    flex-direction: column;
}

.ranking-row {
    flex-direction: row;
    padding: 6px 10px;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    min-height: 44px;
}

.ranking-row--player {
    background-color: rgba(200, 170, 80, 0.15);
    border-left-width: 3px;
    border-left-color: rgb(200, 170, 80);
}

.ranking-col-rank {
    width: 30px;
    font-size: 18px;
    color: rgb(140, 156, 188);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf?fileID=4800000&guid=0b839cefea68a5446946e734e71a15b2&type=3#Saira_Condensed-SemiBold");
}

.ranking-col-name {
    flex-grow: 1;
    font-size: 18px;
    color: rgb(220, 228, 245);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf?fileID=4800000&guid=3f9a9e566c791b44f9e015bd8897f06e&type=3#Saira_Condensed-Regular");
}

.ranking-col-team {
    width: 64px;
    font-size: 18px;
    color: rgb(140, 156, 188);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf?fileID=4800000&guid=0b839cefea68a5446946e734e71a15b2&type=3#Saira_Condensed-SemiBold");
    -unity-text-align: middle-center;
}

.ranking-col-score {
    width: 72px;
    font-size: 18px;
    color: rgb(220, 228, 245);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf?fileID=4800000&guid=0b839cefea68a5446946e734e71a15b2&type=3#Saira_Condensed-SemiBold");
    -unity-text-align: middle-center;
}

.ranking-col-badge {
    width: 120px;
    flex-direction: row;
    justify-content: flex-end;
}

.ranking-badge {
    font-size: 16px;
    padding: 2px 6px;
    border-radius: 3px;
    color: rgb(220, 228, 245);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf?fileID=4800000&guid=3f9a9e566c791b44f9e015bd8897f06e&type=3#Saira_Condensed-Regular");
    text-transform: uppercase;
    -unity-text-align: middle;
    -unity-font-style: bold;
}

.ranking-badge--historical {
    background-color: rgba(110, 126, 155, 0.3);
    color: rgb(160, 176, 200);
}

.ranking-badge--inactive {
    background-color: rgba(212, 160, 23, 0.25);
    color: rgb(231, 180, 60);
}

.ranking-badge--player {
    background-color: rgba(200, 170, 80, 0.35);
    color: rgb(220, 190, 100);
}

.ranking-badge--active {
    background-color: rgba(46, 204, 113, 0.3);
    color: rgb(46, 204, 113);
}
