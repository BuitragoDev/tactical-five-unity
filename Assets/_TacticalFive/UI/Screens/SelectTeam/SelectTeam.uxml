<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_TacticalFive/UI/Screens/SelectTeam/SelectTeam.uss?fileID=7433441132597879392&amp;guid=82b29e8b19665c60bb46d66235574a55&amp;type=3#SelectTeam"/>
    <ui:VisualElement name="SelectTeamRoot" class="select-team-root">
        <ui:VisualElement name="Header" class="header">
            <ui:Button name="BtnBack" text="VOLVER" class="btn-back"/>
            <ui:VisualElement class="header-title">
                <ui:Label text="LIGA" class="header-title-white"/>
                <ui:Label name="HeaderMode" text="MANAGER" class="header-title-gold"/>
                <ui:Label text="· SELECCIONAR EQUIPO" class="header-title-white"/>
            </ui:VisualElement>
            <ui:Button name="BtnContinue" text="CONTINUAR" class="btn-continue"/>
        </ui:VisualElement>
        <ui:VisualElement class="manager-bar">
            <ui:Label text="NOMBRE DEL MANAGER" class="manager-label"/>
            <ui:TextField name="ManagerNameInput" max-length="30" class="manager-input"/>
        </ui:VisualElement>
        <ui:VisualElement class="content-area">
            <ui:VisualElement class="left-panel">
                <ui:VisualElement class="tabs-bar">
                    <ui:Button name="TabAll" text="TODOS (30)" class="tab-btn tab-btn--active"/>
                    <ui:Button name="TabEast" text="ESTE" class="tab-btn"/>
                    <ui:Button name="TabWest" text="OESTE" class="tab-btn"/>
                </ui:VisualElement>
                <ui:ScrollView name="GridScroll" horizontal-scrolling-enabled="false" mode="Vertical" class="grid-scroll">
                    <ui:VisualElement name="TeamsGrid" class="teams-grid"/>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="RightPanel" class="right-panel">
                <ui:VisualElement name="DetailPlaceholder" class="detail-placeholder">
                    <ui:Label text="SELECCIONA UN EQUIPO" class="placeholder-text"/>
                </ui:VisualElement>
                <ui:ScrollView name="DetailScroll" horizontal-scrolling-enabled="false" mode="Vertical" class="right-scroll">
                    <ui:VisualElement name="DetailPanel" class="detail-panel">
                        <ui:VisualElement class="detail-header">
                            <ui:VisualElement name="DetailLogo" class="detail-logo"/>
                            <ui:VisualElement class="detail-name-wrap">
                                <ui:Label name="DetailTeamName" text="" class="detail-team-name"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label text="Ciudad" class="detail-row-label"/>
                            <ui:Label name="DetailCity" text="" class="detail-row-value"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label text="Conferencia" class="detail-row-label"/>
                            <ui:Label name="DetailConferenceVal" text="" class="detail-row-value"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label text="División" class="detail-row-label"/>
                            <ui:Label name="DetailDivision" text="" class="detail-row-value"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label text="Propietario" class="detail-row-label"/>
                            <ui:Label name="DetailOwner" text="" class="detail-row-value"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label text="Pabellón" class="detail-row-label"/>
                            <ui:Label name="DetailArena" text="" class="detail-row-value"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label text="Aforo" class="detail-row-label"/>
                            <ui:Label name="DetailCapacity" text="" class="detail-row-value"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label text="Reputación" class="detail-row-label"/>
                            <ui:VisualElement name="DetailReputation" class="stars-wrap"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label text="Instalaciones" class="detail-row-label"/>
                            <ui:VisualElement name="DetailFacilities" class="stars-wrap"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label text="Objetivo temporada" class="detail-row-label"/>
                            <ui:Label name="DetailObjective" text="" class="detail-row-value"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label text="Presupuesto" class="detail-row-label"/>
                            <ui:Label name="DetailBudget" text="" class="detail-row-value"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label text="Margen salarial" class="detail-row-label"/>
                            <ui:Label name="DetailSalaryMargin" text="" class="detail-row-value"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="stats-row">
                            <ui:VisualElement class="stat-circle">
                                <ui:VisualElement class="stat-circle-ring">
                                    <ui:Label name="DetailAttack" text="--" class="stat-circle-value"/>
                                </ui:VisualElement>
                                <ui:Label text="ATAQUE" class="stat-circle-label"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="stat-circle">
                                <ui:VisualElement class="stat-circle-ring stat-circle-ring--defense">
                                    <ui:Label name="DetailDefense" text="--" class="stat-circle-value"/>
                                </ui:VisualElement>
                                <ui:Label text="DEFENSA" class="stat-circle-label"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="stat-circle">
                                <ui:VisualElement class="stat-circle-ring stat-circle-ring--overall">
                                    <ui:Label name="DetailOverall" text="--" class="stat-circle-value"/>
                                </ui:VisualElement>
                                <ui:Label text="MEDIA" class="stat-circle-label"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Button name="BtnShowSquad" text="VER PLANTILLA" class="btn-squad"/>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="SquadModalOverlay" class="modal-overlay" style="display: none;">
        <ui:VisualElement name="SquadModalBox" class="modal-box">
            <ui:VisualElement class="modal-header">
                <ui:VisualElement name="SquadModalLogo" class="modal-logo"/>
                <ui:VisualElement class="modal-header-info">
                    <ui:Label name="SquadModalTeamName" class="modal-team-name"/>
                    <ui:VisualElement class="stat-circle modal-avg-circle">
                        <ui:VisualElement class="stat-circle-ring stat-circle-ring--overall">
                            <ui:Label name="SquadModalAvg" text="--" class="stat-circle-value"/>
                        </ui:VisualElement>
                        <ui:Label text="MEDIA" class="stat-circle-label"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView class="modal-scroll" horizontal-scrolling-enabled="false" mode="Vertical">
                <ui:VisualElement class="modal-columns">
                    <ui:VisualElement name="SquadColumnLeft" class="modal-column"/>
                    <ui:VisualElement name="SquadColumnRight" class="modal-column"/>
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:Button name="BtnCloseSquad" text="CERRAR" class="modal-close"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
