<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="SelectTeam.uss" />

    <ui:VisualElement name="SelectTeamRoot" class="select-team-root">

        <!-- ══ HEADER ══ -->
        <ui:VisualElement name="Header" class="header">
            <ui:Button name="BtnBack" class="btn-back" text="← VOLVER" />
            <ui:VisualElement class="header-title">
                <ui:Label class="header-title-white" text="LIGA" />
                <ui:Label name="HeaderMode" class="header-title-gold" text="MANAGER" />
                <ui:Label class="header-title-white" text="· SELECCIONAR EQUIPO" />
            </ui:VisualElement>
            <ui:Button name="BtnContinue" class="btn-continue" text="CONTINUAR →" />
        </ui:VisualElement>

        <!-- ══ MANAGER NAME ══ -->
        <ui:VisualElement class="manager-bar">
            <ui:Label class="manager-label" text="NOMBRE DEL MANAGER" />
            <ui:TextField name="ManagerNameInput" class="manager-input"
                          placeholder-text="Escribe tu nombre..." />
        </ui:VisualElement>

        <!-- ══ CONTENT ══ -->
        <ui:VisualElement class="content-area">

            <!-- LEFT -->
            <ui:VisualElement class="left-panel">

                <!-- Tabs -->
                <ui:VisualElement class="tabs-bar">
                    <ui:Button name="TabAll"  class="tab-btn tab-btn--active" text="TODOS (30)" />
                    <ui:Button name="TabEast" class="tab-btn"                 text="ESTE" />
                    <ui:Button name="TabWest" class="tab-btn"                 text="OESTE" />
                </ui:VisualElement>

                <!-- ScrollView con el grid -->
                <ui:ScrollView name="GridScroll" class="grid-scroll"
                               horizontal-scrolling-enabled="false"
                               mode="Vertical">
                    <ui:VisualElement name="TeamsGrid" class="teams-grid" />
                </ui:ScrollView>

            </ui:VisualElement>

            <!-- RIGHT -->
            <ui:VisualElement name="RightPanel" class="right-panel">

                <!-- Placeholder -->
                <ui:VisualElement name="DetailPlaceholder" class="detail-placeholder">
                    <ui:Label class="placeholder-text" text="SELECCIONA UN EQUIPO" />
                </ui:VisualElement>

                <!-- Panel detalles en ScrollView -->
                <ui:ScrollView name="DetailScroll" class="right-scroll"
                               horizontal-scrolling-enabled="false"
                               mode="Vertical">
                    <ui:VisualElement name="DetailPanel" class="detail-panel">

                        <ui:VisualElement class="detail-header">
                            <ui:VisualElement name="DetailLogo" class="detail-logo" />
                            <ui:VisualElement class="detail-name-wrap">
                                <ui:Label name="DetailTeamName"   class="detail-team-name"  text="" />
                                <ui:Label name="DetailConference" class="detail-conference" text="" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="detail-row">
                            <ui:Label class="detail-row-label" text="Ciudad" />
                            <ui:Label name="DetailCity" class="detail-row-value" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label class="detail-row-label" text="Conferencia" />
                            <ui:Label name="DetailConferenceVal" class="detail-row-value" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label class="detail-row-label" text="División" />
                            <ui:Label name="DetailDivision" class="detail-row-value" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label class="detail-row-label" text="Propietario" />
                            <ui:Label name="DetailOwner" class="detail-row-value" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label class="detail-row-label" text="Pabellón" />
                            <ui:Label name="DetailArena" class="detail-row-value" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label class="detail-row-label" text="Aforo" />
                            <ui:Label name="DetailCapacity" class="detail-row-value" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label class="detail-row-label" text="Reputación" />
                            <ui:VisualElement name="DetailReputation" class="stars-wrap" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label class="detail-row-label" text="Instalaciones" />
                            <ui:VisualElement name="DetailFacilities" class="stars-wrap" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label class="detail-row-label" text="Presupuesto" />
                            <ui:Label name="DetailBudget" class="detail-row-value" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label class="detail-row-label" text="Margen salarial" />
                            <ui:Label name="DetailSalaryMargin" class="detail-row-value" text="" />
                        </ui:VisualElement>

                        <ui:VisualElement class="stats-row">
                            <ui:VisualElement class="stat-circle">
                                <ui:VisualElement class="stat-circle-ring">
                                    <ui:Label name="DetailAttack" class="stat-circle-value" text="--" />
                                </ui:VisualElement>
                                <ui:Label class="stat-circle-label" text="ATAQUE" />
                            </ui:VisualElement>
                            <ui:VisualElement class="stat-circle">
                                <ui:VisualElement class="stat-circle-ring stat-circle-ring--defense">
                                    <ui:Label name="DetailDefense" class="stat-circle-value" text="--" />
                                </ui:VisualElement>
                                <ui:Label class="stat-circle-label" text="DEFENSA" />
                            </ui:VisualElement>
                            <ui:VisualElement class="stat-circle">
                                <ui:VisualElement class="stat-circle-ring stat-circle-ring--overall">
                                    <ui:Label name="DetailOverall" class="stat-circle-value" text="--" />
                                </ui:VisualElement>
                                <ui:Label class="stat-circle-label" text="OVERALL" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="jerseys-row">
                            <ui:VisualElement name="JerseyHome" class="jersey-img" />
                            <ui:VisualElement name="JerseyAway" class="jersey-img" />
                        </ui:VisualElement>

                    </ui:VisualElement>
                </ui:ScrollView>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>