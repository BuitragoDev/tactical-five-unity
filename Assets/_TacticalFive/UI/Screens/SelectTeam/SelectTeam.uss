/* ══════════════════════════════════════════
   SELECT TEAM — SelectTeam.uss
   ══════════════════════════════════════════ */

/* ── ROOT ── */
.select-team-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ── HEADER ── */
.header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    height: 100px;
    background-color: rgb(22, 26, 36);
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 160, 23);
    flex-shrink: 0;
}
.btn-back {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 200px;
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 26px;
    -unity-text-align: middle-center;
}
.btn-back:hover {
    background-color: rgb(74, 128, 240);
}
.header-title {
    flex-direction: row;
    align-items: center;
}
.header-title-white {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(255, 255, 255);
    font-size: 32px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
}
.header-title-gold {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(212, 160, 23);
    font-size: 32px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    margin-left: 6px;
    margin-right: 6px;
}
.btn-continue {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 200px;
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 26px;
    -unity-text-align: middle-center;
}
.btn-continue:hover {
    background-color: rgb(74, 128, 240);
}
.btn-continue:disabled {
    background-color: rgb(42, 51, 71);
    color: rgb(85, 102, 119);
}

/* ── MANAGER NAME BAR ── */
.manager-bar {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 100px;
    padding: 0 40px;
    background-color: rgb(17, 24, 34);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}
.manager-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    color: rgb(122, 138, 170);
    margin-right: 16px;
    -unity-text-align: middle-center;
}
.manager-input {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    width: 400px;
    height: 50px;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    color: rgb(208, 216, 232);
    font-size: 24px;
    padding: 8px 12px;
    -unity-text-align: middle-left;
}
.manager-input > #unity-text-input {
    -unity-text-align: middle-left;
    padding: 0;
    margin: 0;
}
.manager-input:focus {
    border-color: rgb(42, 95, 201);
}

/* ── CONTENT AREA ── */
.content-area {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    background-color: rgb(15, 17, 23);
}

/* ── LEFT PANEL ── */
.left-panel {
    flex-direction: column;
    width: 1400px;
    flex-shrink: 0;
    padding: 16px;
    background-color: rgb(15, 17, 23);
    min-height: 0;
}

/* Tabs */
.tabs-bar {
    flex-direction: row;
    margin-bottom: 12px;
    flex-shrink: 0;
    justify-content: flex-end;
    margin-right: 16px;
}
.tab-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    color: rgb(122, 138, 170);
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 8px 20px;
    margin-left: 8px;
    -unity-text-align: middle-center;
}
.tab-btn:hover {
    color: rgb(208, 216, 232);
    border-color: rgb(58, 74, 99);
}
.tab-btn--active {
    background-color: rgb(28, 33, 48);
    border-color: rgb(42, 95, 201);
    border-bottom-width: 2px;
    color: rgb(255, 255, 255);
}

/* ScrollView del grid */
.grid-scroll {
    flex-grow: 1;
    min-height: 0;
    background-color: rgb(15, 17, 23);
}

/* Grid items */
.teams-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    flex-shrink: 0;
    padding: 4px;
}
.team-item {
    width: 158px;
    height: 150px;
    margin: 5px;
    align-items: center;
    justify-content: center;
    background-color: rgb(22, 26, 36);
    border-width: 2px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    flex-shrink: 0;
}
.team-item:hover {
    border-color: rgb(58, 74, 99);
    background-color: rgb(28, 33, 48);
}
.team-item--selected {
    border-color: rgb(212, 160, 23);
    background-color: rgb(35, 30, 10);
}
.team-item--disabled {
    opacity: 0.3;
}
.team-logo {
    width: 120px;
    height: 120px;
}

/* ── RIGHT PANEL ── */
.right-panel {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(17, 24, 34);
    border-left-width: 1px;
    border-left-color: rgb(42, 51, 71);
    min-height: 0;
    min-width: 0;
}

/* ScrollView del panel derecho */
.right-scroll {
    flex-grow: 1;
    min-height: 0;
    background-color: rgb(17, 24, 34);
}

/* Placeholder */
.detail-placeholder {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(17, 24, 34);
}
.placeholder-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
}

/* Panel detalles */
.detail-panel {
    flex-direction: column;
    flex-shrink: 0;
    padding: 24px 28px;
    background-color: rgb(17, 24, 34);
    align-items: stretch;
}

/* Cabecera detalle — logo centrado + nombre debajo */
.detail-header {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    width: 100%;
}
.detail-logo {
    width: 120px;
    height: 120px;
    margin-bottom: 10px;
    flex-shrink: 0;
}
.detail-name-wrap {
    flex-direction: column;
    align-items: center;
    width: 100%;
}
.detail-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
    letter-spacing: 2px;
    white-space: nowrap;
    -unity-text-align: middle-center;
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Filas info */
.detail-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 3px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}
.detail-row-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    -unity-text-transform: upper;
    flex-shrink: 0;
    min-width: 120px;
}
.detail-row-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-right;
    flex-grow: 1;
    white-space: normal;
}

/* Estrellas */
.stars-wrap {
    flex-direction: row;
    justify-content: flex-end;
    flex-grow: 1;
}
.star {
    width: 16px;
    height: 16px;
    margin-left: 4px;
    border-radius: 8px;
    background-color: rgb(42, 58, 74);
    flex-shrink: 0;
}
.star--filled {
    background-color: rgb(212, 160, 23);
}

/* Stats circulares */
.stats-row {
    flex-direction: row;
    justify-content: space-around;
    margin-top: 20px;
    margin-bottom: 20px;
}
.stat-circle {
    align-items: center;
    justify-content: center;
    flex-direction: column;
}
.stat-circle-ring {
    width: 80px;
    height: 80px;
    border-radius: 36px;
    border-width: 5px;
    border-color: rgb(42, 95, 201);
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
}
.stat-circle-ring--defense {
    border-color: rgb(39, 174, 96);
}
.stat-circle-ring--overall {
    border-color: rgb(212, 160, 23);
}
.stat-circle-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}
.stat-circle-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

/* Botón ver plantilla */
.btn-squad {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
    background-color: rgb(42, 95, 201);
    border-width: 0;
    padding: 12px 0;
    width: 100%;
    -unity-text-align: middle-center;
    margin-top: 10px;
    flex-shrink: 0;
    cursor: pointer;
}
.btn-squad:hover {
    background-color: rgb(74, 128, 240);
}

/* Modal overlay */
.modal-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
}
.modal-box {
    flex-direction: column;
    width: 1100px;
    max-height: 85%;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 6px;
    padding: 24px;
}
.modal-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}
.modal-logo {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    margin-right: 16px;
}
.modal-header-info {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    justify-content: space-between;
}
.modal-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 26px;
    color: rgb(255, 255, 255);
    letter-spacing: 2px;
    -unity-text-transform: upper;
    flex-grow: 1;
}
.modal-avg-circle .stat-circle-ring {
    width: 60px;
    height: 60px;
    border-radius: 50px;
}
.modal-avg-circle .stat-circle-value {
    font-size: 24px;
}
.modal-scroll {
    flex-grow: 1;
    min-height: 0;
}
.modal-columns {
    flex-direction: row;
    flex-grow: 1;
}
.modal-column {
    flex-direction: column;
    flex-grow: 1;
    width: 0;
    min-width: 0;
    margin-right: 12px;
}
.modal-header-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    min-height: 28px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}
.modal-header-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.modal-player-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    min-height: 44px;
}
.modal-player-row:hover {
    background-color: rgb(28, 33, 48);
}
.modal-player-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.modal-player-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    width: 70px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.modal-player-flag {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin: 0 6px;
    -unity-background-scale-mode: scale-to-fit;
}
.modal-player-age {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    width: 30px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.modal-player-avg {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    width: 40px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.modal-player-avg--high {
    color: rgb(39, 174, 96);
}
.modal-player-avg--mid {
    color: rgb(212, 160, 23);
}
.modal-player-avg--low {
    color: rgb(192, 57, 43);
}
.modal-close {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
    background-color: rgb(42, 95, 201);
    border-width: 0;
    padding: 12px 0;
    width: 100%;
    -unity-text-align: middle-center;
    margin-top: 24px;
    flex-shrink: 0;
}
.modal-close:hover {
    background-color: rgb(74, 128, 240);
}

