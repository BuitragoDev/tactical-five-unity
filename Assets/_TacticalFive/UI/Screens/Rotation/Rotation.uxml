<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Rotation.uss" />
    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />

    <ui:VisualElement name="RotationRoot" class="rotation-root">

        <!-- ══ MAIN CONTENT ══ -->
        <ui:VisualElement name="RotationMain" class="rotation-main">

            <!-- ══ SCREEN HEADER ══ -->
            <ui:VisualElement class="screen-header panel--gold">
                <ui:VisualElement class="screen-header-row">
                    <ui:VisualElement name="ScreenIcon" class="screen-icon" />
                    <ui:Label class="screen-title" text="{loc:ui.rotation.rotacion_de_minutos}" />
                </ui:VisualElement>
                <ui:Label name="ScreenSubtitle" class="screen-subtitle" text="" />
            </ui:VisualElement>

            <ui:VisualElement name="RotationContent" class="rotation-content">

                <!-- ══ LEFT: LISTA DE MINUTOS ══ -->
                <ui:VisualElement class="rotation-col rotation-col--left">

                    <ui:VisualElement class="rotation-section">
                        <ui:VisualElement class="rotation-section-header">
                            <ui:Label class="rotation-section-title" text="{loc:ui.rotation.titulares}" />
                            <ui:Label class="rotation-section-subtitle" text="{loc:ui.rotation.5_jugadores}" />
                        </ui:VisualElement>
                        <ui:VisualElement class="rotation-list-header">
                            <ui:Label class="rot-col rot-col--name rot-col--head" text="{loc:ui.rotation.jugador}" />
                            <ui:Label class="rot-col rot-col--pos rot-col--head" text="{loc:ui.rotation.pos}" />
                            <ui:Label class="rot-col rot-col--role rot-col--head" text="{loc:ui.rotation.rol}" />
                            <ui:Label class="rot-col rot-col--ovr rot-col--head" text="{loc:ui.rotation.med}" />
                            <ui:Label class="rot-col rot-col--min rot-col--head" text="{loc:ui.rotation.minutos}" />
                            <ui:Label class="rot-col rot-col--val rot-col--head" text="{loc:ui.rotation.min}" />
                            <ui:Label class="rot-col rot-col--sug rot-col--head" text="{loc:ui.rotation.sug}" />
                        </ui:VisualElement>
                        <ui:VisualElement name="StartersList" class="rotation-list" />
                    </ui:VisualElement>

                    <ui:VisualElement class="rotation-section">
                        <ui:VisualElement class="rotation-section-header">
                            <ui:Label class="rotation-section-title" text="{loc:ui.rotation.banquillo}" />
                            <ui:Label class="rotation-section-subtitle" text="{loc:ui.rotation.7_jugadores}" />
                        </ui:VisualElement>
                        <ui:VisualElement class="rotation-list-header">
                            <ui:Label class="rot-col rot-col--name rot-col--head" text="{loc:ui.rotation.jugador}" />
                            <ui:Label class="rot-col rot-col--pos rot-col--head" text="{loc:ui.rotation.pos}" />
                            <ui:Label class="rot-col rot-col--role rot-col--head" text="{loc:ui.rotation.rol}" />
                            <ui:Label class="rot-col rot-col--ovr rot-col--head" text="{loc:ui.rotation.med}" />
                            <ui:Label class="rot-col rot-col--min rot-col--head" text="{loc:ui.rotation.minutos}" />
                            <ui:Label class="rot-col rot-col--val rot-col--head" text="{loc:ui.rotation.min}" />
                            <ui:Label class="rot-col rot-col--sug rot-col--head" text="{loc:ui.rotation.sug}" />
                        </ui:VisualElement>
                        <ui:VisualElement name="BenchList" class="rotation-list" />
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- ══ RIGHT: RESUMEN + ACCIONES ══ -->
                <ui:VisualElement class="rotation-col rotation-col--right">

                    <!-- ══ MINUTOS POR POSICIÓN (solo lectura) ══ -->
                    <ui:VisualElement class="rotation-section">
                        <ui:VisualElement class="rotation-section-header">
                            <ui:Label class="rotation-section-title" text="{loc:ui.rotation.minutos_por_posicion}" />
                            <ui:Label class="rotation-section-subtitle" text="{loc:ui.rotation.principal_secundaria}" />
                        </ui:VisualElement>
                        <ui:VisualElement name="PosSummary" class="pos-summary" />
                    </ui:VisualElement>

                    <!-- ══ MINUTOS RESTANTES ══ -->
                    <ui:VisualElement name="RemainingBox" class="remaining-box">
                        <ui:Label name="RemainingCaption" class="remaining-caption" text="{loc:ui.rotation.remaining_caption}" />
                        <ui:Label name="RemainingValue" class="remaining-value" text="240" />
                        <ui:Label name="RemainingHint" class="remaining-hint" text="" />
                    </ui:VisualElement>

                    <!-- ══ ACCIONES ══ -->
                    <ui:VisualElement class="rotation-actions">
                        <ui:Button name="AutoMinutesBtn" class="rot-btn rot-btn--primary rot-btn--lead" text="{loc:ui.rotation.auto_minutes_btn}" />
                        <ui:Button name="ResetMinutesBtn" class="rot-btn rot-btn--danger" text="{loc:ui.rotation.reset_minutes_btn}" />
                    </ui:VisualElement>

                    <ui:VisualElement class="rotation-help">
                        <ui:Label class="rotation-help-text"
                                  text="{loc:ui.rotation.arrastra_la_barra_de_cada_jugador_para_f_f8b27d30}" />
                        <ui:Label class="rotation-help-text"
                                  text="{loc:ui.rotation.auto_reparte_los_240_minutos_del_partido_6c85a4d5}" />
                        <ui:Label class="rotation-help-text"
                                  text="{loc:ui.rotation.los_lesionados_y_los_asignados_a_la_g_le_7027bdf4}" />
                        <ui:Label class="rotation-help-text rotation-help-text--last"
                                  text="{loc:ui.rotation.estos_minutos_son_vinculantes_en_tus_par_a73c4b6a}" />
                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

    <!-- ══ MODAL CONFIGURACIÓN ══ -->
    <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
        <ui:VisualElement name="ConfigModalBox" class="modal-box">
            <ui:Label class="modal-title" text="{loc:ui.rotation.configuracion}" />
            <ui:VisualElement class="modal-body">
                <ui:VisualElement class="settings-section">
                    <ui:Label class="settings-section-title" text="{loc:ui.rotation.audio}" />
                    <ui:VisualElement class="settings-row">
                        <ui:Label class="settings-label" text="{loc:ui.rotation.volumen_general}" />
                        <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                            <ui:VisualElement class="custom-slider-track" />
                            <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                            <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                        </ui:VisualElement>
                        <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-row">
                        <ui:Label class="settings-label" text="{loc:ui.rotation.musica}" />
                        <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                            <ui:VisualElement class="custom-slider-track" />
                            <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                            <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                        </ui:VisualElement>
                        <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-row">
                        <ui:Label class="settings-label" text="{loc:ui.rotation.efectos}" />
                        <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                            <ui:VisualElement class="custom-slider-track" />
                            <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                            <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                        </ui:VisualElement>
                        <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="settings-section">
                    <ui:Label class="settings-section-title" text="{loc:ui.rotation.graficos}" />
                    <ui:VisualElement class="settings-quality-row">
                        <ui:Label class="settings-label" text="{loc:ui.rotation.calidad}" />
                        <ui:VisualElement class="settings-quality-options">
                            <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="{loc:ui.rotation.config_btn_quality_low}" />
                            <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="{loc:ui.rotation.config_btn_quality_medium}" />
                            <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="{loc:ui.rotation.config_btn_quality_high}" />
                            <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="{loc:ui.rotation.config_btn_quality_ultra}" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="settings-section">
                    <ui:Label class="settings-section-title" text="{loc:ui.rotation.juego}" />
                    <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="{loc:ui.rotation.config_btn_main_menu}" />
                    <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="{loc:ui.rotation.config_btn_exit}" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="ConfigBtnCerrar" class="modal-close" text="{loc:ui.rotation.config_btn_cerrar}" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- ══ MODAL CONFIRMAR VOLVER AL MENÚ PRINCIPAL ══ -->
    <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
        <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
            <ui:Label class="modal-title" text="{loc:ui.rotation.volver_al_menu_principal}" />
            <ui:VisualElement class="modal-body">
                <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.rotation.estas_seguro_de_que_quieres_volver_al_me_6f548452}" />
                <ui:Label class="modal-paragraph" text="{loc:ui.rotation.se_perdera_el_progreso_no_guardado_de_la_b10b7334}" />
            </ui:VisualElement>
            <ui:VisualElement class="modal-actions">
                <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="{loc:ui.rotation.config_btn_main_menu_no}" />
                <ui:VisualElement class="modal-spacer" />
                <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="{loc:ui.rotation.config_btn_main_menu_yes}" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- ══ MODAL CONFIRMAR SALIR DEL JUEGO ══ -->
    <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
        <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
            <ui:Label class="modal-title" text="{loc:ui.rotation.salir_del_juego}" />
            <ui:VisualElement class="modal-body">
                <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.rotation.estas_seguro_de_que_quieres_salir_del_ju_c65dd5f1}" />
                <ui:Label class="modal-paragraph" text="{loc:ui.rotation.tu_progreso_se_guarda_automaticamente_du_10fb1edb}" />
            </ui:VisualElement>
            <ui:VisualElement class="modal-actions">
                <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="{loc:ui.rotation.config_btn_exit_no}" />
                <ui:VisualElement class="modal-spacer" />
                <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="{loc:ui.rotation.config_btn_exit_yes}" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

</ui:UXML>
