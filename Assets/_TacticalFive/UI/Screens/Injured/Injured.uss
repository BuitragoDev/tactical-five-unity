/* ══════════════════════════════════════════
   INJURED — Injured.uss
   ══════════════════════════════════════════ */

.injured-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.injured-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.injured-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 20px;
}
.injured-scroll-wrapper {
    flex-direction: column;
    flex-grow: 1;
    overflow-y: auto;
    min-height: 0;
}

.section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
    margin-bottom: 12px;
}

/* ── MEDICAL STAFF ── */

.med-staff-section {
    flex-direction: column;
    margin-bottom: 24px;
}

.med-staff-body {
    flex-direction: row;
}

.med-staff-card {
    flex-direction: row;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 14px 18px;
    min-width: 320px;
}

.med-staff-icon {
    width: 64px;
    height: 64px;
    margin-right: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.med-staff-info {
    flex-direction: column;
    flex-grow: 1;
}

.med-staff-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(208, 216, 232);
    -unity-text-transform: upper;
}

.med-staff-reputation {
    font-size: 14px;
    color: rgb(212, 160, 23);
    margin-top: 2px;
}

.med-staff-empty {
    flex-direction: column;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px 18px;
    min-width: 320px;
}

.med-staff-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

.med-staff-star {
    width: 18px;
    height: 18px;
    margin-right: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.med-staff-star--empty {
    opacity: 0.25;
}

/* ── INJURED TABLE ── */

.injured-section {
    flex-direction: column;
    flex-grow: 1;
}

.injured-table {
    flex-direction: column;
}

.injured-header-row {
    flex-direction: row;
    background-color: rgb(20, 28, 48);
    padding: 10px 14px;
    margin-bottom: 4px;
}

.injured-col-num {
    width: 40px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

.injured-col-name {
    width: 300px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-left;
}

.injured-col-pos {
    width: 70px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

.injured-col-injury {
    flex: 1;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-left;
}

.injured-col-days {
    width: 80px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

.injured-col-action {
    width: 140px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

.injured-col-ir {
    width: 210px;
    margin-right: 15px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

.injured-row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 10px 14px;
    margin-bottom: 4px;
}

.injured-row-num {
    width: 40px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

.injured-row-name {
    width: 300px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-transform: upper;
}

.injured-row-pos {
    width: 70px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

.injured-row-injury {
    flex: 1;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(192, 57, 43);
    -unity-text-align: middle-left;
}

.injured-row-days {
    width: 80px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(192, 57, 43);
    -unity-text-align: middle-center;
}

.btn-treat {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(181, 42, 37);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 16px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 6px 14px;
    -unity-text-align: middle-center;
    width: 140px;
    border-radius: 4px;
}
.btn-treat:hover {
    background-color: rgb(145, 32, 32);
}

.btn-treat--disabled {
    background-color: rgb(42, 51, 71);
    color: rgb(90, 103, 128);
}

.btn-ir {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(39, 84, 148);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    padding: 6px 14px;
    -unity-text-align: middle-center;
    width: 210px;
    border-radius: 4px;
    margin-right: 10px;
}
.btn-ir:hover {
    background-color: rgb(31, 68, 122);
}

.btn-ir--on {
    background-color: rgb(39, 174, 96);
}
.btn-ir--on:hover {
    background-color: rgb(30, 140, 78);
}

.btn-ir--disabled {
    background-color: rgb(42, 51, 71);
    color: rgb(90, 103, 128);
}

.injured-empty {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    margin-top: 10px;
}

/* ── TREATMENT RESULT MODAL ── */

.injured-modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    display: none;
}

.injured-modal-box {
    width: 480px;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-top-width: 3px;
    border-top-color: rgb(39, 174, 96);
    padding: 28px;
    flex-direction: column;
    align-items: center;
}

.injured-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 28px;
    letter-spacing: 4px;
    color: rgb(39, 174, 96);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.injured-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(179, 190, 214);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
    white-space: normal;
}

.injured-modal-buttons {
    flex-direction: row;
    margin-top: 16px;
}

.btn-modal-ok {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(179, 190, 214);
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 24px;
    -unity-text-align: middle-center;
}
.btn-modal-ok:hover {
    background-color: rgb(52, 115, 231);
}

/* ── LEAGUE INJURED BUTTON ── */
.btn-league-injured {
    width: 100%;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    background-color: rgb(42, 95, 201);
    color: white;
    border-width: 0;
    border-radius: 4px;
    padding: 12px;
    cursor: pointer;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.btn-league-injured:hover {
    background-color: rgb(52, 115, 231);
}

/* ── LEAGUE INJURED MODAL ── */
.league-injured-header {
    flex-direction: row;
    padding: 0 14px;
    background-color: rgb(20, 28, 48);
    flex-shrink: 0;
    width: 100%;
    height: 32px;
    align-items: center;
}
.league-injured-col-logo {
    width: 42px;
    flex-shrink: 0;
}
.league-injured-col-team {
    width: 240px;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-left;
}
.league-injured-col-name {
    width: 240px;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-left;
}
.league-injured-col-injury {
    flex: 1;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-left;
}
.league-injured-col-days {
    width: 80px;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}
.league-injured-scroll-wrapper {
    width: 100%;
    height: 380px;
    flex-shrink: 0;
    overflow: hidden;
}
.league-injured-scroll {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
}
.league-injured-row {
    flex-direction: row;
    align-items: center;
    padding: 0 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    background-color: rgb(22, 26, 36);
    height: 38px;
    min-height: 38px;
    flex-shrink: 0;
}
.league-injured-row:hover {
    background-color: rgb(28, 33, 48);
}
.league-injured-row-logo {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 10px;
}
.league-injured-row-team {
    width: 240px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    flex-shrink: 0;
}
.league-injured-row-name {
    width: 240px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    -unity-text-transform: upper;
    flex-shrink: 0;
}
.league-injured-row-injury {
    flex: 1;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(192, 57, 43);
    -unity-text-align: middle-left;
}
.league-injured-row-days {
    width: 80px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(192, 57, 43);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.league-injured-empty {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-top: 30px;
}

.btn-hire {
    width: 100%;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    background-color: rgb(42, 95, 201);
    color: white;
    border-width: 0;
    border-radius: 4px;
    padding: 10px;
    cursor: pointer;
    -unity-text-align: middle-center;
    margin-top: 8px;
}

.btn-hire:hover {
    background-color: rgb(52, 115, 231);
}
