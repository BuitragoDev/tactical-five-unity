/* ══════════════════════════════════════════
   INJURED — Injured.uss (card layout)
   ══════════════════════════════════════════ */

.injured-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.injured-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

/* ── SCREEN HEADER ── */
.screen-header.panel--gold {
    flex-shrink: 0;
    padding: 0;
    margin: 16px 20px 12px 20px;
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    background-color: rgb(33, 32, 28);
    border-radius: 4px;
    overflow: hidden;
}
.screen-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    background-color: rgb(33, 32, 28);
}
.screen-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    white-space: normal;
}
.screen-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(212, 160, 23);
    padding: 0 14px;
    background-color: rgb(33, 32, 28);
}

.injured-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 20px;
}
.injured-scroll-wrapper {
    flex-direction: column;
    flex-grow: 1;
    overflow-y: auto;
    min-height: 0;
}

.section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
    margin-bottom: 12px;
}

/* ── MEDICAL STAFF ── */

.med-staff-section {
    flex-direction: column;
    margin-bottom: 24px;
}

.med-staff-body {
    flex-direction: row;
}

.med-staff-card {
    flex-direction: row;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 14px 18px;
    min-width: 320px;
}

.med-staff-icon {
    width: 80px;
    height: 80px;
    margin-right: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.med-staff-info {
    flex-direction: column;
    flex-grow: 1;
}

.med-staff-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(208, 216, 232);
    -unity-text-transform: upper;
}

.med-staff-reputation {
    font-size: 14px;
    color: rgb(212, 160, 23);
    margin-top: 2px;
}

.med-staff-empty {
    flex-direction: column;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px 18px;
    min-width: 320px;
}

.med-staff-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

.med-staff-star {
    width: 18px;
    height: 18px;
    margin-right: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.med-staff-star--empty {
    opacity: 0.25;
}

.med-staff-recovery {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    margin-top: 8px;
}

/* ── INJURED CARDS ── */

.injured-section {
    flex-direction: column;
    flex-shrink: 0;
}

/* Fila: viewport + barra de scroll propia (alto de una fila de tarjetas). */
.injured-scroll-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.injured-viewport {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    height: 280px;
    overflow: hidden;
    position: relative;
}

.injured-scrollbar {
    width: 12px;
    min-width: 12px;
    flex-shrink: 0;
    align-self: stretch;
    margin-left: 4px;
    background-color: rgb(24, 18, 10);
    border-left-width: 1px;
    border-left-color: rgb(54, 47, 29);
    position: relative;
}

.injured-scrollbar-thumb {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 0;
    height: 40px;
    background-color: rgb(160, 128, 30);
    border-radius: 3px;
}

.injured-scrollbar:hover .injured-scrollbar-thumb {
    background-color: rgb(212, 160, 23);
}

.injured-cards {
    flex-direction: column;
    margin: 0 -8px;
    flex-shrink: 0;
}

/* Fila de 3 cards: el espaciado entre filas está aquí (no en la card). La última
   fila lleva solo un colchón pequeño para que el scroll no corte las cards. */
.injury-row {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 100px;
}

.injury-row--last {
    margin-bottom: 10px;
}

/* ── CARD ── */

.injury-card {
    flex-basis: 33.33%;
    min-width: 0;
    padding: 0 8px;
}

.injury-card-inner {
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    overflow: hidden;
}

.injury-card--injured .injury-card-inner {
    border-top-width: 3px;
    border-top-color: rgb(192, 57, 43);
}

.injury-card--recovered .injury-card-inner {
    border-top-width: 3px;
    border-top-color: rgb(39, 174, 96);
}

/* ── CARD HEADER ── */

.card-header {
    flex-direction: row;
    align-items: center;
    padding: 12px 14px 8px;
}

.card-jersey {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    background-color: rgb(30, 40, 60);
    border-radius: 4px;
    padding: 2px 8px;
    margin-right: 6px;
    -unity-text-align: middle-center;
    min-width: 28px;
}

.card-position {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(255, 255, 255);
    background-color: rgb(42, 95, 201);
    border-radius: 4px;
    padding: 2px 10px;
    margin-right: 10px;
    -unity-text-align: middle-center;
    min-width: 28px;
}

.card-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
    flex-grow: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.card-status {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    padding: 3px 8px;
    border-radius: 4px;
    flex-shrink: 0;
    margin-left: 6px;
}

.card-status--injured {
    color: rgb(230, 120, 100);
    background-color: rgb(44, 26, 30);
}

.card-status--recovered {
    color: rgb(100, 200, 140);
    background-color: rgb(21, 44, 38);
}

/* ── CARD BODY ── */

.card-body {
    flex-direction: row;
    align-items: center;
    padding: 4px 14px 12px;
}

.card-photo {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    margin-right: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgb(30, 35, 48);
}

.card-injury-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: rgb(44, 26, 30);
    margin-right: 14px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.card-injury-icon--recovered {
    background-color: rgb(21, 44, 38);
}

.card-injury-icon-img {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
}

.card-injury-info {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.card-injury-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(192, 57, 43);
    white-space: normal;
}

.card-injury-name--recovered {
    color: rgb(100, 200, 140);
}

.card-injury-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    margin-top: 2px;
}

.card-injury-days {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.card-injury-days-icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.card-injury-days-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(192, 57, 43);
}

.card-injury-days-text--recovered {
    color: rgb(100, 200, 140);
}

/* ── CARD FOOTER ── */

.card-footer {
    flex-direction: row;
    align-items: center;
    padding: 0 14px 12px;
}

.card-flag {
    width: 36px;
    height: 24px;
    margin-left: 6px;
    margin-right: 2px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.card-severity {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
}

.card-severity-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    margin-right: 8px;
    flex-shrink: 0;
}

.card-severity-label--leve {
    color: rgb(212, 160, 23);
}

.card-severity-label--moderada {
    color: rgb(212, 160, 23);
}

.card-severity-label--severa {
    color: rgb(192, 57, 43);
}

.card-severity-label--safe {
    color: rgb(39, 174, 96);
}

/* ── PARTE MÉDICO (E2): pronóstico, progreso y riesgo ── */

.card-pronostico {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(150, 162, 190);
    letter-spacing: 1px;
    margin-top: 2px;
}

.card-progress-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.card-progress-track {
    width: 120px;
    height: 6px;
    border-radius: 3px;
    background-color: rgb(42, 51, 71);
    flex-shrink: 0;
    overflow: hidden;
}

.card-progress-fill {
    height: 6px;
    border-radius: 3px;
    background-color: rgb(39, 174, 96);
}

.card-progress-fill--mid {
    background-color: rgb(212, 160, 23);
}

.card-progress-fill--low {
    background-color: rgb(192, 57, 43);
}

.card-progress-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: rgb(179, 190, 214);
    letter-spacing: 1px;
    margin-left: 8px;
}

.card-risk-badge {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(230, 120, 100);
    background-color: rgb(44, 26, 30);
    border-width: 1px;
    border-color: rgb(192, 57, 43);
    border-radius: 6px;
    padding: 2px 8px;
    margin-left: 8px;
    flex-shrink: 0;
}

.btn-card-force {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(35, 25, 30);
    border-width: 2px;
    border-color: rgb(192, 57, 43);
    color: rgb(230, 120, 100);
    font-size: 18px;
    letter-spacing: 1px;
    padding: 6px 14px;
    -unity-text-align: middle-center;
    border-radius: 6px;
    cursor: pointer;
    min-width: 0;
    white-space: nowrap;
    margin-left: 8px;
}

.btn-card-force:hover {
    background-color: rgb(62, 30, 32);
    color: rgb(240, 145, 125);
}

/* ── CARD BUTTONS ── */

.card-buttons {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
    flex-shrink: 0;
}

.btn-card-no-apt {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(20, 28, 45);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(100, 150, 230);
    font-size: 18px;
    letter-spacing: 1px;
    padding: 6px 14px;
    -unity-text-align: middle-center;
    border-radius: 6px;
    cursor: pointer;
    min-width: 0;
    white-space: nowrap;
}
.btn-card-no-apt:hover {
    background-color: rgb(24, 40, 71);
}

/* Deshabilitado: el hover no debe cambiar el color */
.btn-card-no-apt.btn-card-no-apt--disabled:hover {
    background-color: rgb(20, 24, 32);
    color: rgb(90, 103, 128);
}

.btn-card-apt {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(20, 36, 35);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    color: rgb(100, 200, 140);
    font-size: 18px;
    letter-spacing: 1px;
    padding: 6px 14px;
    -unity-text-align: middle-center;
    border-radius: 6px;
    cursor: pointer;
    min-width: 0;
    white-space: nowrap;
}
.btn-card-apt:hover {
    background-color: rgb(23, 59, 45);
}

.btn-card-treat {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(35, 25, 30);
    border-width: 2px;
    border-color: rgb(192, 57, 43);
    color: rgb(230, 120, 100);
    font-size: 18px;
    letter-spacing: 1px;
    padding: 6px 14px;
    -unity-text-align: middle-center;
    border-radius: 6px;
    cursor: pointer;
    margin-left: 6px;
    min-width: 0;
    white-space: nowrap;
}
.btn-card-treat:hover {
    background-color: rgb(62, 30, 32);
}

.btn-card-treat--disabled {
    background-color: rgb(20, 24, 32);
    border-color: rgb(42, 51, 71);
    color: rgb(90, 103, 128);
}

/* Deshabilitado: el hover no debe cambiar el color (mayor especificidad que el :hover base) */
.btn-card-treat.btn-card-treat--disabled:hover {
    background-color: rgb(20, 24, 32);
    color: rgb(90, 103, 128);
}

.btn-card-force.btn-card-no-apt--disabled:hover {
    background-color: rgb(20, 24, 32);
    color: rgb(90, 103, 128);
}

.btn-card-treat--done {
    background-color: rgb(21, 44, 38);
    border-color: rgb(39, 174, 96);
    color: rgb(100, 200, 140);
}
.btn-card-treat--done:hover {
    background-color: rgb(21, 44, 38);
}

.btn-card-no-apt--disabled {
    background-color: rgb(20, 24, 32);
    border-color: rgb(42, 51, 71);
    color: rgb(90, 103, 128);
}

/* ── EMPTY STATE ── */

.injured-empty-card {
    flex-basis: 33.33%;
    min-width: 0;
    padding: 0 8px;
    margin-bottom: 16px;
}

.injured-empty-inner {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    padding: 32px 16px;
    min-height: 200px;
}

.injured-empty-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 12px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.3;
}

.injured-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ── TREATMENT RESULT MODAL ── */

.injured-modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(3, 3, 4);
    align-items: center;
    justify-content: center;
    display: none;
}

.injured-modal-box {
    width: 480px;
    background-color: rgb(13, 14, 18);
    border-width: 1px;
    border-color: rgb(39, 174, 96);
    border-radius: 12px;
    padding: 32px;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
}

/* Advertencia del riesgo de recaída en el modal de alta forzada */
.force-return-risk--low {
    color: rgb(100, 200, 140);
}
.force-return-risk--mid {
    color: rgb(212, 160, 23);
}
.force-return-risk--high {
    color: rgb(230, 120, 100);
}

.injured-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 34px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.injured-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 20px;
    color: rgb(179, 190, 214);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
    white-space: normal;
}

.injured-modal-buttons {
    flex-direction: row;
    width: 100%;
    margin-top: 24px;
}

/* ── LEAGUE INJURED BUTTON ── */
.btn-league-injured {
    width: 100%;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    background-color: rgb(20, 28, 45);
    color: rgb(100, 150, 230);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    border-radius: 8px;
    padding: 12px;
    cursor: pointer;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.btn-league-injured:hover {
    background-color: rgb(24, 40, 71);
}

/* ── LEAGUE INJURED MODAL ── */
.league-injured-header {
    flex-direction: row;
    padding: 0 14px;
    background-color: rgb(20, 28, 48);
    flex-shrink: 0;
    width: auto;
    align-self: stretch;
    height: 32px;
    align-items: center;
}
.league-injured-col-logo {
    width: 42px;
    flex-shrink: 0;
}
.league-injured-col-team {
    width: 240px;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-left;
}
.league-injured-col-name {
    width: 240px;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-left;
}
.league-injured-col-injury {
    flex: 1;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-left;
}
.league-injured-col-days {
    width: 80px;
    flex-shrink: 0;
    padding-right: 10px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}
.league-injured-list-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    align-items: stretch;
}
.league-injured-scroll-wrapper {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    height: auto;
    overflow: hidden;
    position: relative;
}
.league-injured-list {
    flex-direction: column;
    flex-shrink: 0;
}
.league-injured-scrollbar {
    width: 12px;
    min-width: 12px;
    flex-shrink: 0;
    align-self: stretch;
    margin-left: 4px;
    background-color: rgb(24, 18, 10);
    border-left-width: 1px;
    border-left-color: rgb(54, 47, 29);
    position: relative;
}
.league-injured-scrollbar-thumb {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 0;
    height: 40px;
    background-color: rgb(160, 128, 30);
    border-radius: 3px;
}
.league-injured-scrollbar:hover .league-injured-scrollbar-thumb {
    background-color: rgb(212, 160, 23);
}
.league-injured-row {
    flex-direction: row;
    align-items: center;
    padding: 0 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    background-color: rgb(22, 26, 36);
    height: 38px;
    min-height: 38px;
    flex-shrink: 0;
}
.league-injured-row:hover {
    background-color: rgb(28, 33, 48);
}
.league-injured-row-logo {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 10px;
}
.league-injured-row-team {
    width: 240px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    flex-shrink: 0;
}
.league-injured-row-name {
    width: 240px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    -unity-text-transform: upper;
    flex-shrink: 0;
}
.league-injured-row-injury {
    flex: 1;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(192, 57, 43);
    -unity-text-align: middle-left;
}
.league-injured-row-days {
    width: 80px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(192, 57, 43);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.league-injured-empty {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-top: 30px;
}

.btn-hire {
    width: 100%;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    background-color: rgb(20, 28, 45);
    color: rgb(100, 150, 230);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    border-radius: 6px;
    padding: 10px;
    cursor: pointer;
    -unity-text-align: middle-center;
    margin-top: 8px;
}

.btn-hire:hover {
    background-color: rgb(24, 40, 71);
}

/* ── LEAGUE INJURED MODAL — modern gold border ── */
#LeagueInjuredBox {
    background-color: rgb(13, 14, 18);
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    border-radius: 12px;
    padding: 0;
    overflow: hidden;
}
#LeagueInjuredBox .modal-title {
    padding: 10px 24px;
    background-color: rgb(33, 32, 28);
    border-bottom-width: 1px;
    border-bottom-color: rgb(212, 160, 23);
}
#BtnLeagueInjuredClose {
    margin: 16px 24px 20px;
    background-color: rgb(37, 35, 28);
    border-width: 2px;
    border-color: rgb(212, 160, 23);
    color: rgb(212, 160, 23);
    border-radius: 8px;
}
#BtnLeagueInjuredClose:hover {
    background-color: rgb(66, 56, 27);
    color: rgb(240, 200, 80);
}
