/* ══════════════════════════════════════════
   INJURED — Injured.uss (card layout)
   ══════════════════════════════════════════ */

.injured-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.injured-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

/* ── SCREEN HEADER ── */
.screen-header.panel--gold {
    flex-shrink: 0;
    padding: 0;
    margin: 16px 20px 12px 20px;
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    background-color: rgba(120, 95, 30, 0.15);
    border-radius: 4px;
    overflow: hidden;
}
.screen-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    background-color: rgba(120, 95, 30, 0.15);
}
.screen-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    white-space: normal;
}
.screen-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(212, 160, 23);
    padding: 0 14px;
    background-color: rgba(120, 95, 30, 0.15);
}

.injured-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 20px;
}
.injured-scroll-wrapper {
    flex-direction: column;
    flex-grow: 1;
    overflow-y: auto;
    min-height: 0;
}

.section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
    margin-bottom: 12px;
}

/* ── MEDICAL STAFF ── */

.med-staff-section {
    flex-direction: column;
    margin-bottom: 24px;
}

.med-staff-body {
    flex-direction: row;
}

.med-staff-card {
    flex-direction: row;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 14px 18px;
    min-width: 320px;
}

.med-staff-icon {
    width: 80px;
    height: 80px;
    margin-right: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.med-staff-info {
    flex-direction: column;
    flex-grow: 1;
}

.med-staff-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(208, 216, 232);
    -unity-text-transform: upper;
}

.med-staff-reputation {
    font-size: 14px;
    color: rgb(212, 160, 23);
    margin-top: 2px;
}

.med-staff-empty {
    flex-direction: column;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px 18px;
    min-width: 320px;
}

.med-staff-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

.med-staff-star {
    width: 18px;
    height: 18px;
    margin-right: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.med-staff-star--empty {
    opacity: 0.25;
}

.med-staff-recovery {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    margin-top: 8px;
}

/* ── INJURED CARDS ── */

.injured-section {
    flex-direction: column;
    flex-grow: 1;
}

.injured-cards {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 0 -8px;
}

/* ── CARD ── */

.injury-card {
    flex-basis: 33.33%;
    min-width: 0;
    padding: 0 8px;
    margin-bottom: 16px;
}

.injury-card-inner {
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    overflow: hidden;
}

.injury-card--injured .injury-card-inner {
    border-top-width: 3px;
    border-top-color: rgb(192, 57, 43);
}

.injury-card--recovered .injury-card-inner {
    border-top-width: 3px;
    border-top-color: rgb(39, 174, 96);
}

/* ── CARD HEADER ── */

.card-header {
    flex-direction: row;
    align-items: center;
    padding: 12px 14px 8px;
}

.card-jersey {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    background-color: rgb(30, 40, 60);
    border-radius: 4px;
    padding: 2px 8px;
    margin-right: 6px;
    -unity-text-align: middle-center;
    min-width: 28px;
}

.card-position {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(255, 255, 255);
    background-color: rgb(42, 95, 201);
    border-radius: 4px;
    padding: 2px 10px;
    margin-right: 10px;
    -unity-text-align: middle-center;
    min-width: 28px;
}

.card-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
    flex-grow: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.card-status {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    padding: 3px 8px;
    border-radius: 4px;
    flex-shrink: 0;
    margin-left: 6px;
}

.card-status--injured {
    color: rgb(230, 120, 100);
    background-color: rgba(192, 57, 43, 0.15);
}

.card-status--recovered {
    color: rgb(100, 200, 140);
    background-color: rgba(39, 174, 96, 0.15);
}

/* ── CARD BODY ── */

.card-body {
    flex-direction: row;
    align-items: center;
    padding: 4px 14px 12px;
}

.card-photo {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    margin-right: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgb(30, 35, 48);
}

.card-injury-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: rgba(192, 57, 43, 0.15);
    margin-right: 14px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.card-injury-icon--recovered {
    background-color: rgba(39, 174, 96, 0.15);
}

.card-injury-icon-img {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
}

.card-injury-info {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.card-injury-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(192, 57, 43);
    white-space: normal;
}

.card-injury-name--recovered {
    color: rgb(100, 200, 140);
}

.card-injury-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    margin-top: 2px;
}

.card-injury-days {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.card-injury-days-icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.card-injury-days-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(192, 57, 43);
}

.card-injury-days-text--recovered {
    color: rgb(100, 200, 140);
}

/* ── CARD FOOTER ── */

.card-footer {
    flex-direction: row;
    align-items: center;
    padding: 0 14px 12px;
}

.card-flag {
    width: 36px;
    height: 24px;
    margin-left: 6px;
    margin-right: 2px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.card-severity {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
}

.card-severity-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    margin-right: 8px;
    flex-shrink: 0;
}

.card-severity-label--leve {
    color: rgb(212, 160, 23);
}

.card-severity-label--moderada {
    color: rgb(212, 160, 23);
}

.card-severity-label--severa {
    color: rgb(192, 57, 43);
}

.card-severity-label--safe {
    color: rgb(39, 174, 96);
}

.card-severity-bar {
    flex-direction: row;
    flex-shrink: 0;
}

.severity-segment {
    width: 14px;
    height: 6px;
    margin-right: 3px;
    border-radius: 2px;
    background-color: rgb(42, 51, 71);
}

.severity-segment--filled-red {
    background-color: rgb(192, 57, 43);
}

.severity-segment--filled-orange {
    background-color: rgb(212, 160, 23);
}

.severity-segment--filled-green {
    background-color: rgb(39, 174, 96);
}

/* ── CARD BUTTONS ── */

.card-buttons {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
    flex-shrink: 0;
}

.btn-card-no-apt {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgba(42, 95, 201, 0.10);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(100, 150, 230);
    font-size: 18px;
    letter-spacing: 1px;
    padding: 6px 14px;
    -unity-text-align: middle-center;
    border-radius: 6px;
    cursor: pointer;
    min-width: 0;
    white-space: nowrap;
}
.btn-card-no-apt:hover {
    background-color: rgba(42, 95, 201, 0.25);
}

.btn-card-apt {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgba(39, 174, 96, 0.10);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    color: rgb(100, 200, 140);
    font-size: 18px;
    letter-spacing: 1px;
    padding: 6px 14px;
    -unity-text-align: middle-center;
    border-radius: 6px;
    cursor: pointer;
    min-width: 0;
    white-space: nowrap;
}
.btn-card-apt:hover {
    background-color: rgba(39, 174, 96, 0.25);
}

.btn-card-treat {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgba(192, 57, 43, 0.10);
    border-width: 2px;
    border-color: rgb(192, 57, 43);
    color: rgb(230, 120, 100);
    font-size: 18px;
    letter-spacing: 1px;
    padding: 6px 14px;
    -unity-text-align: middle-center;
    border-radius: 6px;
    cursor: pointer;
    margin-left: 6px;
    min-width: 0;
    white-space: nowrap;
}
.btn-card-treat:hover {
    background-color: rgba(192, 57, 43, 0.25);
}

.btn-card-treat--disabled {
    background-color: rgba(42, 51, 71, 0.10);
    border-color: rgb(42, 51, 71);
    color: rgb(90, 103, 128);
}

.btn-card-treat--done {
    background-color: rgba(39, 174, 96, 0.15);
    border-color: rgb(39, 174, 96);
    color: rgb(100, 200, 140);
}
.btn-card-treat--done:hover {
    background-color: rgba(39, 174, 96, 0.15);
}

.btn-card-no-apt--disabled {
    background-color: rgba(42, 51, 71, 0.10);
    border-color: rgb(42, 51, 71);
    color: rgb(90, 103, 128);
}

/* ── EMPTY STATE ── */

.injured-empty-card {
    flex-basis: 33.33%;
    min-width: 0;
    padding: 0 8px;
    margin-bottom: 16px;
}

.injured-empty-inner {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    padding: 32px 16px;
    min-height: 200px;
}

.injured-empty-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 12px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.3;
}

.injured-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ── PAGINATOR ── */

.injured-paginator {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    align-self: stretch;
    flex-shrink: 0;
    margin-top: 12px;
    margin-bottom: 10px;
    padding: 8px 0;
}

.injured-paginator-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgba(42, 95, 201, 0.10);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(100, 150, 230);
    font-size: 14px;
    padding: 6px 16px;
    border-radius: 6px;
    cursor: pointer;
    min-width: 40px;
    -unity-text-align: middle-center;
}
.injured-paginator-btn:hover {
    background-color: rgba(42, 95, 201, 0.25);
}

.injured-paginator-btn--disabled {
    background-color: rgba(42, 51, 71, 0.10);
    border-color: rgb(42, 51, 71);
    color: rgb(90, 103, 128);
}

.injured-paginator-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    color: rgb(179, 190, 214);
    margin-left: 16px;
    margin-right: 16px;
    -unity-text-align: middle-center;
}

/* ── TREATMENT RESULT MODAL ── */

.injured-modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    display: none;
}

.injured-modal-box {
    width: 480px;
    background-color: rgb(13, 14, 18);
    border-width: 1px;
    border-color: rgb(39, 174, 96);
    border-radius: 12px;
    padding: 32px;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
}

.injured-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 34px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.injured-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 20px;
    color: rgb(179, 190, 214);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
    white-space: normal;
}

.injured-modal-buttons {
    flex-direction: row;
    width: 100%;
    margin-top: 24px;
}

/* ── LEAGUE INJURED BUTTON ── */
.btn-league-injured {
    width: 100%;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    background-color: rgba(42, 95, 201, 0.10);
    color: rgb(100, 150, 230);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    border-radius: 8px;
    padding: 12px;
    cursor: pointer;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.btn-league-injured:hover {
    background-color: rgba(42, 95, 201, 0.25);
}

/* ── LEAGUE INJURED MODAL ── */
.league-injured-header {
    flex-direction: row;
    padding: 0 14px;
    background-color: rgb(20, 28, 48);
    flex-shrink: 0;
    width: 100%;
    height: 32px;
    align-items: center;
}
.league-injured-col-logo {
    width: 42px;
    flex-shrink: 0;
}
.league-injured-col-team {
    width: 240px;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-left;
}
.league-injured-col-name {
    width: 240px;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-left;
}
.league-injured-col-injury {
    flex: 1;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-left;
}
.league-injured-col-days {
    width: 80px;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}
.league-injured-scroll-wrapper {
    width: 100%;
    height: 380px;
    flex-shrink: 0;
    overflow: hidden;
}
.league-injured-scroll {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
}
.league-injured-row {
    flex-direction: row;
    align-items: center;
    padding: 0 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    background-color: rgb(22, 26, 36);
    height: 38px;
    min-height: 38px;
    flex-shrink: 0;
}
.league-injured-row:hover {
    background-color: rgb(28, 33, 48);
}
.league-injured-row-logo {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 10px;
}
.league-injured-row-team {
    width: 240px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    flex-shrink: 0;
}
.league-injured-row-name {
    width: 240px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    -unity-text-transform: upper;
    flex-shrink: 0;
}
.league-injured-row-injury {
    flex: 1;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(192, 57, 43);
    -unity-text-align: middle-left;
}
.league-injured-row-days {
    width: 80px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(192, 57, 43);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.league-injured-empty {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-top: 30px;
}

.btn-hire {
    width: 100%;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    background-color: rgba(42, 95, 201, 0.10);
    color: rgb(100, 150, 230);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    border-radius: 6px;
    padding: 10px;
    cursor: pointer;
    -unity-text-align: middle-center;
    margin-top: 8px;
}

.btn-hire:hover {
    background-color: rgba(42, 95, 201, 0.25);
}
