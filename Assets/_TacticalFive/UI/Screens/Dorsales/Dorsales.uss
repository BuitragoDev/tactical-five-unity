/* ══════════════════════════════════════════
   DORSALES — Dorsales.uss
   ══════════════════════════════════════════ */

.dorsales-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.dorsales-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

/* ── SCREEN HEADER ── */
.screen-header.panel--gold {
    flex-shrink: 0;
    padding: 0;
    margin: 16px 20px 12px 20px;
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    background-color: rgba(120, 95, 30, 0.15);
    border-radius: 4px;
    overflow: hidden;
}
.screen-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    background-color: rgba(120, 95, 30, 0.15);
}
.screen-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    white-space: normal;
}
.screen-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(212, 160, 23);
    padding: 0 14px;
    background-color: rgba(120, 95, 30, 0.15);
}

.dorsales-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 20px 30px;
}

.dorsales-scroll-wrapper {
    flex-direction: column;
    flex-grow: 1;
    overflow-y: auto;
    min-height: 0;
}

/* ── PANEL ── */

.dorsales-panel {
    flex-direction: column;
    border-width: 1px;
    border-color: rgb(120, 95, 30);
    background-color: rgb(18, 21, 28);
    border-radius: 4px;
    padding: 0;
    margin-bottom: 24px;
    overflow: hidden;
}

/* ── PANEL HEADER ── */

.dorsales-panel-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0px 14px;
    background-color: rgba(120, 95, 30, 0.15);
    border-bottom-width: 1px;
    border-bottom-color: rgb(120, 95, 30);
}

.dorsales-panel-header-left {
    flex-direction: row;
    align-items: center;
}

.dorsales-panel-icon {
    width: 44px;
    height: 44px;
    margin-right: 16px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.dorsales-panel-header-text {
    flex-direction: column;
}

.dorsales-panel-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
}

.dorsales-panel-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(255, 255, 255);
    margin-top: 2px;
}

.dorsales-panel-header-right {
    flex-direction: column;
    align-items: flex-end;
}

.dorsales-panel-count-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(212, 160, 23);
}

.dorsales-panel-count-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(255, 255, 255);
}

/* ── CARDS ── */

.dorsales-cards {
    flex-direction: column;
    padding: 16px 24px;
}

.dorsales-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.dorsales-card {
    flex-direction: column;
    align-items: center;
    width: 165px;
    margin-right: 12px;
    margin-bottom: 8px;
    background-color: rgb(20, 24, 34);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    padding: 4px 8px 4px 8px;
}

.dorsales-card:hover {
    border-color: rgb(74, 100, 140);
    background-color: rgb(25, 30, 42);
}

.dorsales-card-shirt {
    width: 80px;
    height: 80px;
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: scale-to-fit;
}

.dorsales-card-number {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 36px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-top: 20px;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
}

.dorsales-card-number--retired {
    font-size: 32px;
    color: rgb(255, 255, 255);
}

.dorsales-card-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 0.5px;
    color: rgb(180, 190, 210);
    -unity-text-align: middle-center;
    margin-top: 6px;
    max-width: 130px;
    white-space: normal;
}

/* ── PAGINATOR ── */

.dorsales-paginator {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: 12px 24px 18px 24px;
    flex-shrink: 0;
}

.dorsales-paginator-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: transparent;
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(100, 150, 230);
    font-size: 14px;
    padding: 6px 14px;
    border-radius: 6px;
    cursor: pointer;
    -unity-text-align: middle-center;
    min-width: 0;
}

.dorsales-paginator-btn:hover {
    background-color: rgba(42, 95, 201, 0.15);
}

.dorsales-paginator-btn--disabled {
    border-color: rgb(42, 51, 71);
    color: rgb(60, 70, 90);
    cursor: default;
}

.dorsales-paginator-btn--disabled:hover {
    background-color: transparent;
}

.dorsales-paginator-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    color: rgb(208, 216, 232);
    margin-left: 16px;
    margin-right: 16px;
}

/* ── EMPTY ── */

.dorsales-empty {
    padding: 20px 0;
    font-size: 18px;
    color: rgb(140, 150, 170);
    -unity-text-align: middle-center;
}
