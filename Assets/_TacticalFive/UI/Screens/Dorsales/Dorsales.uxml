<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="../Dorsales/Dorsales.uss" />
    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />

    <ui:VisualElement name="DorsalesRoot" class="dorsales-root">

        <!-- MAIN -->
        <ui:VisualElement class="dorsales-main">

            <!-- ══ SCREEN HEADER ══ -->
            <ui:VisualElement class="screen-header panel--gold">
                <ui:VisualElement class="screen-header-row">
                    <ui:VisualElement name="ScreenIcon" class="screen-icon" />
                    <ui:Label class="screen-title" text="{loc:ui.dorsales.gestion_de_dorsales}" />
                </ui:VisualElement>
                <ui:Label name="ScreenSubtitle" class="screen-subtitle" text="" />
            </ui:VisualElement>

            <!-- CONTENT -->
            <ui:VisualElement class="dorsales-content">

                <!-- SCROLLABLE WRAPPER -->
                <ui:VisualElement class="dorsales-scroll-wrapper">

                    <!-- ══ DORSALES ACTUALES ══ -->
                    <ui:VisualElement name="PanelActuales" class="dorsales-panel">
                        <ui:VisualElement class="dorsales-panel-header">
                            <ui:VisualElement class="dorsales-panel-header-left">
                                <ui:VisualElement name="IconActuales" class="dorsales-panel-icon" />
                                <ui:VisualElement class="dorsales-panel-header-text">
                                    <ui:Label class="dorsales-panel-title" text="{loc:ui.dorsales.dorsales_actuales}" />
                                    <ui:Label class="dorsales-panel-subtitle" text="{loc:ui.dorsales.numeros_de_la_plantilla}" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="dorsales-panel-header-right">
                                <ui:Label class="dorsales-panel-count-label" text="{loc:ui.dorsales.activos}" />
                                <ui:Label name="CountActivos" class="dorsales-panel-count-value" text="0/0" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="TablaActuales" class="dorsales-cards" />
                    </ui:VisualElement>

                    <!-- ══ DORSALES RETIRADOS ══ -->
                    <ui:VisualElement name="PanelRetirados" class="dorsales-panel">
                        <ui:VisualElement class="dorsales-panel-header">
                            <ui:VisualElement class="dorsales-panel-header-left">
                                <ui:VisualElement name="IconRetirados" class="dorsales-panel-icon" />
                                <ui:VisualElement class="dorsales-panel-header-text">
                                    <ui:Label class="dorsales-panel-title" text="{loc:ui.dorsales.dorsales_retirados}" />
                                    <ui:Label class="dorsales-panel-subtitle" text="{loc:ui.dorsales.historicos_que_nunca_se_volveran_a_utili_6b574eac}" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="dorsales-panel-header-right">
                                <ui:Label class="dorsales-panel-count-label" text="{loc:ui.dorsales.retirados}" />
                                <ui:Label name="CountRetirados" class="dorsales-panel-count-value" text="0" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="TablaRetirados" class="dorsales-cards" />
                        <ui:VisualElement name="PaginatorRetirados" class="dorsales-paginator" />
                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ══ MODAL CONFIGURACIÓN ══ -->
        <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigModalBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.dorsales.configuracion}" />
                <ui:VisualElement class="modal-body">
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.dorsales.audio}" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.dorsales.volumen_general}" />
                            <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.dorsales.musica}" />
                            <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.dorsales.efectos}" />
                            <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.dorsales.graficos}" />
                        <ui:VisualElement class="settings-quality-row">
                            <ui:Label class="settings-label" text="{loc:ui.dorsales.calidad}" />
                            <ui:VisualElement class="settings-quality-options">
                                <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="{loc:ui.dorsales.config_btn_quality_low}" />
                                <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="{loc:ui.dorsales.config_btn_quality_medium}" />
                                <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="{loc:ui.dorsales.config_btn_quality_high}" />
                                <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="{loc:ui.dorsales.config_btn_quality_ultra}" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.dorsales.juego}" />
                        <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="{loc:ui.dorsales.config_btn_main_menu}" />
                        <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="{loc:ui.dorsales.config_btn_exit}" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ConfigBtnCerrar" class="modal-close" text="{loc:ui.dorsales.config_btn_cerrar}" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR VOLVER AL MENÚ PRINCIPAL ══ -->
        <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.dorsales.volver_al_menu_principal}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.dorsales.estas_seguro_de_que_quieres_volver_al_me_6f548452}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.dorsales.se_perdera_el_progreso_no_guardado_de_la_b10b7334}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="{loc:ui.dorsales.config_btn_main_menu_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="{loc:ui.dorsales.config_btn_main_menu_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR SALIR DEL JUEGO ══ -->
        <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.dorsales.salir_del_juego}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.dorsales.estas_seguro_de_que_quieres_salir_del_ju_c65dd5f1}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.dorsales.tu_progreso_se_guarda_automaticamente_du_10fb1edb}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="{loc:ui.dorsales.config_btn_exit_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="{loc:ui.dorsales.config_btn_exit_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
