<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Employees.uss" />
    <Style src="../Dashboard/Dashboard.uss" />

    <ui:VisualElement name="EmployeesRoot" class="employees-root">

        <!-- ══ SIDEBAR ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="employees-main">

            <!-- TOP HEADER -->
            <ui:VisualElement name="TopHeader" class="top-header">
                <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo" />
                <ui:VisualElement class="header-team-info">
                    <ui:Label name="HeaderTeamName"    class="header-team-name"    text="" />
                    <ui:Label name="HeaderManagerName" class="header-manager-name" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="PRESUPUESTO" />
                    <ui:Label name="HeaderBudget" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MASA SALARIAL" />
                    <ui:Label name="HeaderPayroll" class="header-stat-value header-stat-value--neutral" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MARGEN SALARIAL" />
                    <ui:Label name="HeaderMargin" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="QUÍMICA DE EQUIPO" />
                    <ui:Label name="HeaderChemistry" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-spacer" />
                <ui:VisualElement class="header-season-info">
                    <ui:Label name="HeaderSeason" class="header-season-label" text="" />
                    <ui:Label name="HeaderDate"   class="header-date-label"   text="" />
                </ui:VisualElement>
                <ui:Button name="BtnAction" class="btn-action" text="DASHBOARD" />
                <ui:VisualElement name="ConfigIcon" class="header-config-icon" />
            </ui:VisualElement>

            <!-- CONTENT -->
            <ui:VisualElement class="employees-content">

                <!-- TITLE BOX -->
                <ui:VisualElement class="employees-title-box">
                    <ui:Label class="employees-title-box-label" text="EMPLEADOS" />
                </ui:VisualElement>

                <!-- YOUR STAFF -->
                <ui:VisualElement class="staff-section">
                    <ui:Label class="staff-section-title" text="TU PERSONAL" />
                    <ui:VisualElement name="MyStaffBody" class="staff-grid" />
                </ui:VisualElement>

                <!-- MARKET -->
                <ui:VisualElement class="market-section">
                    <ui:Label class="market-section-title" text="MERCADO DE PERSONAL" />
                    <ui:VisualElement name="MarketBody" class="market-grid" />
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ══ MODAL CONTRATAR ══ -->
        <ui:VisualElement name="HireOverlay" class="hire-modal-overlay">
            <ui:VisualElement name="HireBox" class="hire-modal-box">
                <ui:Label name="HireTitle" class="hire-modal-title" text="CONTRATAR EMPLEADO" />
                <ui:Label name="HireText1" class="hire-modal-text" text="" />
                <ui:Label name="HireText2" class="hire-modal-text" text="" />
                <ui:Label name="HireText3" class="hire-modal-text" text="" />
                <ui:VisualElement class="hire-modal-buttons">
                    <ui:Button name="BtnHireCancel"  class="btn-modal-cancel" text="CANCELAR" />
                    <ui:Button name="BtnHireConfirm" class="btn-modal-confirm" text="CONTRATAR" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL RESULTADO ══ -->
        <ui:VisualElement name="HireResultOverlay" class="hire-modal-overlay">
            <ui:VisualElement name="HireResultBox" class="hire-modal-box">
                <ui:Label name="HireResultTitle" class="hire-modal-title" text="" />
                <ui:Label name="HireResultText"  class="hire-modal-text"  text="" />
                <ui:VisualElement class="hire-modal-buttons">
                    <ui:Button name="BtnHireResultOk" class="btn-modal-cancel" text="ENTENDIDO" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
