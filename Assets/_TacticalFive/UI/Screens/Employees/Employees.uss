/* ══════════════════════════════════════════
   EMPLOYEES — Employees.uss
   ══════════════════════════════════════════ */

.employees-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.sidebar {
    width: 200px;
    height: 100%;
    flex-shrink: 0;
    flex-direction: column;
    background-color: rgb(11, 14, 20);
    border-right-width: 1px;
    border-right-color: rgb(28, 33, 48);
}

.sidebar-logo {
    flex-direction: row;
    align-items: center;
    padding: 0 16px;
    height: 100px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    flex-shrink: 0;
}
.sidebar-logo-icon {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
    font-size: 28px;
    padding: 4px 8px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-right: 10px;
}
.sidebar-logo-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    text-transform: uppercase;
}
.sidebar-logo-text-gold {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
    text-transform: uppercase;
}

.sidebar-nav {
    flex-direction: column;
    flex-grow: 1;
    padding: 8px 0;
    overflow: hidden;
    background-color: rgb(0, 0, 0);
}

.nav-item {
    flex-direction: row;
    align-items: center;
    padding: 12px 12px;
    border-width: 0;
    background-color: rgb(0, 0, 0);
}
.nav-item:hover {
    background-color: rgb(22, 26, 36);
}
.nav-item--active {
    background-color: rgb(20, 28, 48);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}
.nav-icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}
.nav-label {
    font-size: 16px;
    color: rgb(122, 138, 170);
    margin-left: 18px;
    -unity-text-align: middle-left;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    text-transform: uppercase;
    letter-spacing: 1px;
}
.nav-item:hover .nav-label {
    color: rgb(208, 216, 232);
}
.nav-item--active .nav-label {
    color: rgb(255, 255, 255);
}

/* ── MAIN ── */

.employees-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

/* ── SCREEN HEADER ── */
.screen-header.panel--gold {
    flex-shrink: 0;
    padding: 0;
    margin: 16px 20px 12px 20px;
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    background-color: rgb(33, 32, 28);
    border-radius: 4px;
    overflow: hidden;
}
.screen-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    background-color: rgb(33, 32, 28);
}
.screen-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    white-space: normal;
}
.screen-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(212, 160, 23);
    padding: 0 14px;
    background-color: rgb(33, 32, 28);
}

.employees-content {
    flex-direction: column;
    flex-grow: 1;
    overflow-y: auto;
    padding: 20px 24px;
}

/* ── TAB BAR ── */

.employees-tab-bar {
    flex-direction: row;
    margin-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
}

.employees-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgb(122, 138, 170);
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: transparent;
    padding: 12px 24px;
    margin-right: 4px;
}
.employees-tab:hover {
    color: rgb(208, 216, 232);
}
.employees-tab--active {
    color: rgb(212, 160, 23);
    border-bottom-color: rgb(212, 160, 23);
}

/* ── PAGES ── */

.employees-page {
    flex-direction: column;
    flex-grow: 1;
}

/* ── TABLE ── */

.emp-table-header {
    flex-direction: row;
    align-items: center;
    background-color: rgb(20, 28, 48);
    padding: 10px 14px;
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
    margin-bottom: 2px;
}

.emp-table-body {
    flex-direction: column;
}

.emp-table-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    background-color: rgb(15, 17, 23);
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    min-height: 44px;
}
.emp-table-row:hover {
    background-color: rgb(22, 26, 36);
}
.emp-table-row--clickable {
    cursor: hand;
}
.emp-table-row--selected {
    background-color: rgb(28, 33, 52);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}

.emp-col {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.emp-table-header .emp-col {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(212, 160, 23);
}

.emp-col--nombre {
    width: 250px;
    flex-shrink: 0;
}

.emp-col--puesto {
    width: 220px;
    flex-shrink: 0;
}

.emp-col--nacionalidad {
    width: 300px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.emp-col--reputacion {
    width: 130px;
    flex-shrink: 0;
}

.emp-col--sueldo {
    width: 150px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

.emp-col--contrato {
    width: 150px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.emp-col--acciones {
    width: 150px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

/* ── FLAG ICON ── */

.flag-icon {
    width: 32px;
    height: 24px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* ── NATIONALITY CELL ── */

.nat-cell {
    flex-direction: row;
    align-items: center;
}

/* ── STARS ── */

.emp-stars {
    flex-direction: row;
    align-items: center;
}

.emp-star {
    width: 16px;
    height: 16px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 2px;
}

.emp-star--empty {
    opacity: 0.25;
}

/* ── EMPTY ROW ── */

.emp-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(80, 90, 110);
    font-style: italic;
}

/* ── BUTTONS ── */

.btn-fire-table {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(35, 25, 30);
    border-width: 2px;
    border-color: rgb(192, 57, 43);
    color: rgb(230, 120, 100);
    font-size: 14px;
    letter-spacing: 1px;
    padding: 6px 14px;
    -unity-text-align: middle-center;
    border-radius: 6px;
    cursor: pointer;
}
.btn-fire-table:hover {
    background-color: rgb(62, 30, 32);
}

.btn-hire-table {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(20, 36, 35);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    color: rgb(100, 200, 140);
    font-size: 14px;
    letter-spacing: 1px;
    padding: 6px 14px;
    -unity-text-align: middle-center;
    border-radius: 6px;
    cursor: pointer;
}
.btn-hire-table:hover {
    background-color: rgb(23, 59, 45);
}

.btn-replace-table {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(37, 35, 28);
    border-width: 2px;
    border-color: rgb(212, 160, 23);
    color: rgb(230, 190, 70);
    font-size: 14px;
    letter-spacing: 1px;
    padding: 6px 14px;
    -unity-text-align: middle-center;
    border-radius: 6px;
    cursor: pointer;
}
.btn-replace-table:hover {
    background-color: rgb(66, 56, 27);
}

/* ── MARKET SUB-TABS ── */

.market-tab-bar {
    flex-direction: row;
    margin-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    flex-wrap: wrap;
}

.market-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(122, 138, 170);
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    padding: 8px 16px;
    margin-right: 2px;
}
.market-tab:hover {
    color: rgb(208, 216, 232);
}
.market-tab--active {
    color: rgb(212, 160, 23);
    border-bottom-color: rgb(212, 160, 23);
}

/* ── MARKET EMPLOYEE ── */

.emp-employee-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
}

/* ── MODAL STARS ── */

.hire-modal-stars {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

.hire-modal-star {
    width: 24px;
    height: 24px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 3px;
}

.hire-modal-star--empty {
    opacity: 0.25;
}

/* ── HIRE MODAL ── */

.hire-modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(4, 9, 17);
    align-items: center;
    justify-content: center;
    display: none;
}

.hire-modal-overlay--visible {
    display: flex;
}

.hire-modal-box {
    width: 650px;
    background-color: rgb(13, 24, 42);
    border-width: 1px;
    border-color: rgb(39, 174, 96);
    border-radius: 10px;
    padding: 0;
    flex-direction: column;
    overflow: hidden;
}

.hire-modal-header {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    padding: 14px 18px;
    background-color: rgb(21, 45, 39);
    border-bottom-width: 1px;
    border-bottom-color: rgb(39, 174, 96);
}

.hire-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    margin-bottom: 0;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.hire-modal-body {
    padding: 20px 24px 22px 24px;
    flex-direction: column;
    align-items: center;
}

.hire-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(179, 190, 214);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    white-space: normal;
}

.hire-modal-text:last-of-type {
    margin-bottom: 0;
}

.hire-modal-buttons {
    flex-direction: row;
    width: 100%;
    align-self: stretch;
    margin-top: 16px;
}

/* ── Hire variant (red) ── */

.hire-modal-box--negative {
    border-color: rgb(192, 57, 43);
}

.hire-modal-box--negative .hire-modal-header {
    background-color: rgb(46, 27, 30);
    border-bottom-color: rgb(192, 57, 43);
}

/* ── Hire variant (gold) ── */

.hire-modal-box--gold {
    border-color: rgb(212, 160, 23);
}

.hire-modal-box--gold .hire-modal-header {
    background-color: rgb(49, 43, 27);
    border-bottom-color: rgb(212, 160, 23);
}

/* ── Hire modal button styles ── */

.hire-modal-box .btn-modal-cancel {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    flex-grow: 1;
    flex-basis: 0;
    background-color: rgb(26, 30, 38);
    border-width: 2px;
    border-color: rgb(100, 110, 130);
    color: rgb(160, 170, 190);
    font-size: 18px;
    letter-spacing: 1px;
    padding: 12px 20px;
    -unity-text-align: middle-center;
    border-radius: 8px;
    cursor: pointer;
    min-width: 0;
    white-space: normal;
}

.hire-modal-box .btn-modal-cancel:hover {
    background-color: rgb(38, 43, 54);
}

.hire-modal-box .btn-modal-confirm {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 6px;
    background-color: rgb(20, 36, 35);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    color: rgb(100, 200, 140);
    font-size: 18px;
    letter-spacing: 1px;
    padding: 12px 20px;
    -unity-text-align: middle-center;
    border-radius: 8px;
    cursor: pointer;
    min-width: 0;
    white-space: normal;
}

.hire-modal-box .btn-modal-confirm:hover {
    background-color: rgb(23, 59, 45);
}

.hire-modal-box .btn-modal-confirm--gold {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 6px;
    background-color: rgb(37, 35, 28);
    border-width: 2px;
    border-color: rgb(212, 160, 23);
    color: rgb(232, 190, 80);
    font-size: 18px;
    letter-spacing: 1px;
    padding: 12px 20px;
    -unity-text-align: middle-center;
    border-radius: 8px;
    cursor: pointer;
    min-width: 0;
    white-space: normal;
}

.hire-modal-box .btn-modal-confirm--gold:hover {
    background-color: rgb(66, 56, 27);
}

.hire-modal-box .btn-modal-confirm--danger {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 6px;
    background-color: rgb(35, 25, 30);
    border-width: 2px;
    border-color: rgb(192, 57, 43);
    color: rgb(230, 120, 100);
    font-size: 18px;
    letter-spacing: 1px;
    padding: 12px 20px;
    -unity-text-align: middle-center;
    border-radius: 8px;
    cursor: pointer;
    min-width: 0;
    white-space: normal;
}

.hire-modal-box .btn-modal-confirm--danger:hover {
    background-color: rgb(62, 30, 32);
}

/* ── EMPLOYEE DETAIL ROW ── */

.emp-detail-row {
    flex-direction: row;
    margin-top: 16px;
    min-height: 400px;
    max-height: 400px;
    flex-shrink: 0;
}

.emp-detail-left {
    flex: 1;
    margin-right: 16px;
    min-height: 400px;
    max-height: 400px;
    border-width: 1px;
    border-color: rgb(120, 95, 30);
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/Backgrounds/background1.png");
    background-size: cover;
    background-position: center;
    overflow: hidden;
}

.emp-detail-left-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(15, 17, 23);
}

.emp-detail-left-content {
    flex-direction: row;
    align-items: center;
    padding: 24px;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.emp-detail-left-logo {
    width: 120px;
    height: 120px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    flex-shrink: 0;
    margin-right: 50px;
}

.emp-detail-left-text {
    flex-direction: column;
}

.emp-detail-left-quote {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Kindergarten.ttf");
    font-size: 24px;
    line-height: 30px;
    color: rgb(110, 180, 255);
    white-space: normal;
}

.emp-detail-left-quote--second {
    margin-bottom: 12px;
}

.emp-detail-left-teamname {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Kindergarten.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
}

/* ── EMPLOYEE DETAIL PANEL ── */

.emp-detail-panel {
    flex-direction: column;
    flex: 1;
    min-height: 400px;
    max-height: 400px;
    border-width: 1px;
    border-color: rgb(120, 95, 30);
    background-color: rgb(15, 17, 23);
    overflow: hidden;
}

.emp-detail-header {
    background: linear-gradient(to right, rgb(100, 20, 20), rgb(140, 40, 30));
    padding: 10px 20px;
}

.emp-detail-position {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgb(255, 255, 255);
}

.emp-detail-body {
    flex-direction: row;
    padding: 20px;
    background-color: rgb(22, 26, 36);
}

.emp-detail-photo {
    width: 120px;
    height: 140px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    flex-shrink: 0;
    margin-right: 24px;
}

.emp-detail-info {
    flex-direction: column;
    flex-grow: 1;
    justify-content: center;
}

.emp-detail-name-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    padding: 8px 12px;
    background-color: rgb(28, 33, 48);
    border-radius: 4px;
}

.emp-detail-flag {
    width: 32px;
    height: 24px;
    margin-right: 12px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.emp-detail-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    color: rgb(255, 255, 255);
}

.emp-detail-stat-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 6px 12px;
    margin-bottom: 4px;
}

.emp-detail-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
}

.emp-detail-stars {
    flex-direction: row;
    align-items: center;
}

.emp-detail-star {
    width: 20px;
    height: 20px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 2px;
}

.emp-detail-star--empty {
    opacity: 0.25;
}

.emp-detail-salary {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    color: rgb(39, 174, 96);
}

.emp-detail-info-header {
    background: linear-gradient(to right, rgb(100, 20, 20), rgb(140, 40, 30));
    padding: 8px 20px;
}

.emp-detail-info-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgb(255, 255, 255);
}

.emp-detail-description {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    line-height: 24px;
    color: rgb(179, 190, 214);
    padding: 16px 20px;
    white-space: normal;
}

/* ── LEGACY (kept for sidebar compat) ── */

.staff-section {
    flex-direction: column;
    margin-bottom: 24px;
}

.staff-section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgb(212, 160, 23);
    margin-bottom: 12px;
}
