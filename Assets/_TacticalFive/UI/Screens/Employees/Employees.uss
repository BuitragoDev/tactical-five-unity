/* ══════════════════════════════════════════
   EMPLOYEES — Employees.uss
   ══════════════════════════════════════════ */

.employees-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.sidebar {
    width: 200px;
    height: 100%;
    flex-shrink: 0;
    flex-direction: column;
    background-color: rgb(11, 14, 20);
    border-right-width: 1px;
    border-right-color: rgb(28, 33, 48);
}

.sidebar-logo {
    flex-direction: row;
    align-items: center;
    padding: 0 16px;
    height: 100px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    flex-shrink: 0;
}
.sidebar-logo-icon {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
    font-size: 28px;
    padding: 4px 8px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-right: 10px;
}
.sidebar-logo-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
}
.sidebar-logo-text-gold {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
    -unity-text-transform: upper;
}

.sidebar-nav {
    flex-direction: column;
    flex-grow: 1;
    padding: 8px 0;
    overflow: hidden;
    background-color: rgb(0, 0, 0);
}

.nav-item {
    flex-direction: row;
    align-items: center;
    padding: 12px 12px;
    border-width: 0;
    background-color: rgb(0, 0, 0);
}
.nav-item:hover {
    background-color: rgb(22, 26, 36);
}
.nav-item--active {
    background-color: rgb(20, 28, 48);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}
.nav-icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}
.nav-label {
    font-size: 16px;
    color: rgb(122, 138, 170);
    margin-left: 18px;
    -unity-text-align: middle-left;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    -unity-text-transform: upper;
    letter-spacing: 1px;
}
.nav-item:hover .nav-label {
    color: rgb(208, 216, 232);
}
.nav-item--active .nav-label {
    color: rgb(255, 255, 255);
}

/* ── MAIN ── */

.employees-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.employees-content {
    flex-direction: column;
    flex-grow: 1;
    overflow-y: auto;
    padding: 20px 24px;
}

/* ── TAB BAR ── */

.employees-tab-bar {
    flex-direction: row;
    margin-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
}

.employees-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    color: rgb(122, 138, 170);
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: transparent;
    padding: 12px 24px;
    margin-right: 4px;
}
.employees-tab:hover {
    color: rgb(208, 216, 232);
}
.employees-tab--active {
    color: rgb(212, 160, 23);
    border-bottom-color: rgb(212, 160, 23);
}

/* ── PAGES ── */

.employees-page {
    flex-direction: column;
    flex-grow: 1;
}

/* ── TABLE ── */

.emp-table-header {
    flex-direction: row;
    align-items: center;
    background-color: rgb(20, 28, 48);
    padding: 10px 14px;
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
    margin-bottom: 2px;
}

.emp-table-body {
    flex-direction: column;
}

.emp-table-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    background-color: rgb(15, 17, 23);
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    min-height: 44px;
}
.emp-table-row:hover {
    background-color: rgb(22, 26, 36);
}

.emp-col {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.emp-table-header .emp-col {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
}

.emp-col--nombre {
    width: 250px;
    flex-shrink: 0;
}

.emp-col--puesto {
    width: 220px;
    flex-shrink: 0;
}

.emp-col--nacionalidad {
    width: 300px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.emp-col--reputacion {
    width: 130px;
    flex-shrink: 0;
}

.emp-col--sueldo {
    width: 150px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

.emp-col--contrato {
    width: 150px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.emp-col--acciones {
    width: 150px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

/* ── FLAG ICON ── */

.flag-icon {
    width: 32px;
    height: 24px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* ── NATIONALITY CELL ── */

.nat-cell {
    flex-direction: row;
    align-items: center;
}

/* ── STARS ── */

.emp-stars {
    flex-direction: row;
    align-items: center;
}

.emp-star {
    width: 16px;
    height: 16px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 2px;
}

.emp-star--empty {
    opacity: 0.25;
}

/* ── EMPTY ROW ── */

.emp-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(80, 90, 110);
    font-style: italic;
}

/* ── BUTTONS ── */

.btn-fire-table {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(140, 40, 30);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    padding: 5px 10px;
    -unity-text-align: middle-center;
    border-radius: 3px;
}
.btn-fire-table:hover {
    background-color: rgb(192, 57, 43);
}

.btn-hire-table {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(5, 115, 51);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    padding: 5px 10px;
    -unity-text-align: middle-center;
    border-radius: 3px;
}
.btn-hire-table:hover {
    background-color: rgb(8, 141, 64);
}

.btn-replace-table {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(180, 100, 20);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    padding: 5px 10px;
    -unity-text-align: middle-center;
    border-radius: 3px;
}
.btn-replace-table:hover {
    background-color: rgb(212, 160, 23);
}

/* ── MARKET SUB-TABS ── */

.market-tab-bar {
    flex-direction: row;
    margin-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    flex-wrap: wrap;
}

.market-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(122, 138, 170);
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    padding: 8px 16px;
    margin-right: 2px;
}
.market-tab:hover {
    color: rgb(208, 216, 232);
}
.market-tab--active {
    color: rgb(212, 160, 23);
    border-bottom-color: rgb(212, 160, 23);
}

/* ── MARKET EMPLOYEE ── */

.emp-employee-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
}

/* ── MODAL STARS ── */

.hire-modal-stars {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

.hire-modal-star {
    width: 24px;
    height: 24px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 3px;
}

.hire-modal-star--empty {
    opacity: 0.25;
}

/* ── HIRE MODAL ── */

.hire-modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    display: none;
}

.hire-modal-box {
    width: 550px;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-top-width: 3px;
    border-top-color: rgb(39, 174, 96);
    padding: 28px;
    flex-direction: column;
    align-items: center;
}

.hire-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 28px;
    letter-spacing: 4px;
    color: rgb(39, 174, 96);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.hire-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(179, 190, 214);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
    white-space: normal;
}

.hire-modal-buttons {
    flex-direction: row;
    margin-top: 16px;
}

.btn-modal-cancel {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 24px;
    -unity-text-align: middle-center;
    margin-right: 10px;
}
.btn-modal-cancel:hover {
    background-color: rgb(74, 128, 240);
}

.btn-modal-confirm {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(5, 115, 51);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 24px;
    -unity-text-align: middle-center;
}
.btn-modal-confirm:hover {
    background-color: rgb(8, 141, 64);
}

.hire-modal-box--negative {
    border-top-color: rgb(192, 57, 43);
}
.hire-modal-title--negative {
    color: rgb(192, 57, 43);
}

/* ── LEGACY (kept for sidebar compat) ── */

.staff-section {
    flex-direction: column;
    margin-bottom: 24px;
}

.staff-section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
    margin-bottom: 12px;
}
