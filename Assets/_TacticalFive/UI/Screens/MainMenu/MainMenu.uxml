<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_TacticalFive/UI/Screens/MainMenu/MainMenu.uss?fileID=7433441132597879392&amp;guid=2b99c20946e41924185896be51aea01e&amp;type=3#MainMenu"/>
    <Style src="project://database/Assets/_TacticalFive/UI/Screens/LegalNotice/LegalNotice.uss?fileID=7433441132597879392&amp;guid=deb7c919a769e08a5a963187da128735&amp;type=3#LegalNotice"/>
    <ui:VisualElement name="MainMenuRoot" class="main-menu-root">
        <ui:VisualElement name="Header" class="header">
            <ui:VisualElement class="header-logo-wrap">
                <ui:Label text="TF" class="header-logo-icon"/>
                <ui:Label text="TACTICAL" class="header-logo-text"/>
                <ui:Label text="FIVE" class="header-logo-text-gold"/>
            </ui:VisualElement>
            <ui:VisualElement class="header-right">
                <ui:VisualElement name="ConfigIcon" class="config-icon"/>
                <ui:Button name="BtnLegal" text="AVISO LEGAL" class="btn-legal"/>
                <ui:Button name="BtnBugReport" text="INFORME DE ERRORES" class="btn-bug-report"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Hero" class="hero">
            <ui:VisualElement name="SeasonBar" class="season-bar">
                <ui:VisualElement class="season-bar-line"/>
                <ui:VisualElement class="season-bar-inner">
                    <ui:VisualElement class="season-dot"/>
                    <ui:Label text="TEMPORADA 2026 · 2027" class="season-label"/>
                </ui:VisualElement>
                <ui:VisualElement class="season-bar-line"/>
            </ui:VisualElement>
            <ui:Label name="TitleLine1" text="TACTICAL" class="hero-title-line1"/>
            <ui:Label name="TitleLine2" text="FIVE" class="hero-title-line2"/>
            <ui:VisualElement class="hero-divider">
                <ui:VisualElement class="divider-line"/>
                <ui:Label text="ELIGE TU MODO DE JUEGO" class="divider-text"/>
                <ui:VisualElement class="divider-line"/>
            </ui:VisualElement>
            <ui:VisualElement name="MenuGrid" class="menu-grid">
                <ui:Button name="BtnManager" class="menu-card card-manager">
                    <ui:Label text="LIGA&#10;MANAGER" class="card-title"/>
                    <ui:VisualElement class="card-sep"/>
                    <ui:Label text="Dirige tu club con estabilidad y visión a largo plazo. Construye un proyecto, gestiona cada temporada y mantente al frente hasta que tú decidas… o la directiva decida por ti." class="card-desc"/>
                    <ui:VisualElement name="CtaManager" class="card-cta">
                        <ui:Label text="COMENZAR" class="cta-label"/>
                        <ui:Label text="→" class="cta-arrow"/>
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="BtnProManager" class="menu-card card-pro">
                    <ui:Label text="LIGA&#10;PROMANAGER" class="card-title"/>
                    <ui:VisualElement class="card-sep"/>
                    <ui:Label text="Empieza desde abajo y haz que tu carrera hable por ti. Tus resultados abrirán nuevas puertas cada temporada: quédate, progresa… o salta a un desafío mayor." class="card-desc"/>
                    <ui:VisualElement name="CtaPro" class="card-cta">
                        <ui:Label text="COMENZAR" class="cta-label"/>
                        <ui:Label text="→" class="cta-arrow"/>
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="BtnLoadGame" class="menu-card card-load">
                    <ui:Label text="CARGAR&#10;PARTIDA" class="card-title"/>
                    <ui:VisualElement class="card-sep"/>
                    <ui:Label text="Continúa tu carrera donde la dejaste. Carga una partida guardada o gestiona tus archivos de guardado." class="card-desc"/>
                    <ui:VisualElement name="CtaLoad" class="card-cta">
                        <ui:Label text="ABRIR" class="cta-label"/>
                        <ui:Label text="→" class="cta-arrow"/>
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="BtnEditor" class="menu-card card-editor">
                    <ui:Label text="EDITOR&#10;BASE DE DATOS" class="card-title"/>
                    <ui:VisualElement class="card-sep"/>
                    <ui:Label text="Edita jugadores, equipos, atributos y estadísticas. Crea tu liga personalizada y ajusta cada detalle antes de empezar tu partida." class="card-desc"/>
                    <ui:VisualElement name="CtaEditor" class="card-cta">
                        <ui:Label text="ABRIR" class="cta-label"/>
                        <ui:Label text="→" class="cta-arrow"/>
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="BtnExit" class="menu-card card-exit last">
                    <ui:Label text="SALIR&#10;DEL JUEGO" class="card-title"/>
                    <ui:VisualElement class="card-sep"/>
                    <ui:Label text="Cierra el juego y vuelve al escritorio. Asegúrate de haber guardado tu progreso si lo deseas." class="card-desc"/>
                    <ui:VisualElement name="CtaExit" class="card-cta">
                        <ui:Label text="SALIR" class="cta-label"/>
                        <ui:Label text="→" class="cta-arrow"/>
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="StatsStrip" class="stats-strip">
                <ui:VisualElement class="stat-item">
                    <ui:Label text="30" class="stat-val"/>
                    <ui:Label text="FRANQUICIAS" class="stat-lbl"/>
                </ui:VisualElement>
                <ui:VisualElement class="stat-item">
                    <ui:Label text="600+" class="stat-val stat-val-accent"/>
                    <ui:Label text="JUGADORES" class="stat-lbl"/>
                </ui:VisualElement>
                <ui:VisualElement class="stat-item">
                    <ui:Label text="82" class="stat-val"/>
                    <ui:Label text="PARTIDOS / TEMPORADA" class="stat-lbl"/>
                </ui:VisualElement>
                <ui:VisualElement class="stat-item last">
                    <ui:Label text="∞" class="stat-val stat-val-accent"/>
                    <ui:Label text="TEMPORADAS" class="stat-lbl"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Footer" class="footer">
            <ui:VisualElement class="version-tag">
                <ui:VisualElement class="version-dot"/>
                <ui:Label text="v1.0.0 · Beta" class="version-label"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ModalBox" class="modal-box">
                <ui:Label text="AVISO LEGAL" class="modal-title"/>
                <ui:VisualElement class="modal-body">
                    <ui:Label text="Tactical Five es un videojuego de simulación deportiva desarrollado con fines educativos y de entretenimiento personal." class="modal-paragraph"/>
                    <ui:Label text="Los nombres de equipos, jugadores y logotipos de la NBA son propiedad de sus respectivos dueños. Tactical Five no está afiliado, patrocinado ni respaldado por la NBA, sus equipos ni sus jugadores." class="modal-paragraph"/>
                    <ui:Label text="Este proyecto es de uso privado y no tiene carácter comercial. Todos los datos utilizados son de dominio público o uso educativo bajo el principio de fair use." class="modal-paragraph"/>
                    <ui:Label text="© 2026 Tactical Five  ·  Todos los derechos reservados" class="modal-copyright"/>
                </ui:VisualElement>
                <ui:Button name="BtnCerrar" text="CERRAR" class="modal-close"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ExitModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ExitModalBox" class="modal-box">
                <ui:Label text="SALIR DEL JUEGO" class="modal-title"/>
                <ui:VisualElement class="modal-body">
                    <ui:Label text="¿Estás seguro de que quieres salir del juego?" class="modal-paragraph"/>
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="BtnExitNo" text="NO" class="modal-btn modal-btn--secondary"/>
                    <ui:VisualElement class="modal-spacer"/>
                    <ui:Button name="BtnExitYes" text="SÍ, SALIR" class="modal-btn modal-btn--danger"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigModalBox" class="modal-box">
                <ui:Label text="CONFIGURACIÓN" class="modal-title"/>
                <ui:VisualElement class="modal-body">
                    <ui:VisualElement class="settings-section">
                        <ui:Label text="AUDIO" class="settings-section-title"/>
                        <ui:VisualElement class="settings-row">
                            <ui:Label text="Volumen General" class="settings-label"/>
                            <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track"/>
                                <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill"/>
                                <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger"/>
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMaster" text="100%" class="settings-value"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label text="Música" class="settings-label"/>
                            <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track"/>
                                <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill"/>
                                <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger"/>
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMusic" text="100%" class="settings-value"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label text="Efectos" class="settings-label"/>
                            <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track"/>
                                <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill"/>
                                <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger"/>
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelSFX" text="100%" class="settings-value"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label text="GRÁFICOS" class="settings-section-title"/>
                        <ui:VisualElement class="settings-quality-row">
                            <ui:Label text="Calidad" class="settings-label"/>
                            <ui:VisualElement class="settings-quality-options">
                                <ui:Button name="ConfigBtnQualityLow" text="Baja" class="settings-quality-btn"/>
                                <ui:Button name="ConfigBtnQualityMedium" text="Media" class="settings-quality-btn"/>
                                <ui:Button name="ConfigBtnQualityHigh" text="Alta" class="settings-quality-btn"/>
                                <ui:Button name="ConfigBtnQualityUltra" text="Ultra" class="settings-quality-btn"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label text="SIMULACIÓN" class="settings-section-title"/>
                        <ui:VisualElement class="settings-quality-row">
                            <ui:Label text="Vista de Partido" class="settings-label"/>
                            <ui:VisualElement class="settings-quality-options">
                                <ui:Button name="ConfigBtnSimDirect" text="Directa" class="settings-quality-btn"/>
                                <ui:Button name="ConfigBtnSimPlay" text="Play-by-play" class="settings-quality-btn settings-quality-btn--wide"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ConfigBtnCerrar" text="CERRAR" class="modal-close"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BugReportOverlay" class="modal-overlay" style="display: none;">
            <ui:VisualElement name="BugReportBox" class="modal-box">
                <ui:Label text="INFORME DE ERRORES" class="modal-title"/>
                <ui:VisualElement class="modal-body">
                    <ui:Label text="Si has encontrado un error o quieres sugerir una mejora, descríbenoslo aquí. Tu mensaje se enviará directamente a nuestro equipo de desarrollo." class="modal-paragraph"/>
                    <ui:VisualElement name="BugReportInputContainer" class="bug-report-input"/>
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="BtnBugReportCerrar" text="CERRAR" class="modal-btn modal-btn--secondary"/>
                    <ui:VisualElement class="modal-spacer"/>
                    <ui:Button name="BtnBugReportSend" text="ENVIAR" class="modal-btn modal-btn--primary"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
