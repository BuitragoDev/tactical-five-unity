/* ══════════════════════════════════════════
   MAIN MENU — MainMenu.uss
   ══════════════════════════════════════════ */

/* ── ROOT ── */
.main-menu-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
}

/* ── BACKGROUND ── */
.bg-base {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(10, 13, 20);
}

/* ── HEADER ── */
.header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
    height: 56px;
    background-color: rgb(22, 26, 36);
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 160, 23);
    flex-shrink: 0;
}
.logo-wrap {
    flex-direction: row;
    align-items: center;
}
.logo-icon {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
    font-size: 18px;
    letter-spacing: 1px;
    padding: 6px 20px 6px 12px;
    -unity-text-align: middle-center;
}
.logo-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    padding-left: 16px;
    -unity-text-align: middle-left;
    -unity-text-transform: upper;
}
.logo-text-gold {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 3px;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-left;
    -unity-text-transform: upper;
}
.btn-legal {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    color: rgb(122, 138, 170);
    font-size: 13px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    padding: 7px 16px;
    -unity-text-align: middle-center;
}
.btn-legal:hover {
    border-color: rgb(212, 160, 23);
    color: rgb(212, 160, 23);
    background-color: rgb(30, 25, 10);
}

/* ── HERO ── */
.hero {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 50px 40px 36px;
}

/* Season bar */
.season-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 36px;
}
.season-bar-inner {
    flex-direction: row;
    align-items: center;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    padding: 8px 28px;
}
.season-bar-line {
    width: 40px;
    height: 1px;
    background-color: rgb(58, 74, 99);
    margin: 0 12px;
}
.season-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: rgb(212, 160, 23);
    margin-right: 10px;
    flex-shrink: 0;
}
.season-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 18px;
    letter-spacing: 4px;
    color: rgb(122, 138, 170);
    -unity-text-transform: upper;
    -unity-text-align: middle-center;
}

/* Título */
.hero-title-line1 {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 72px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    letter-spacing: 6px;
    -unity-text-transform: upper;
    -unity-text-align: middle-center;
    margin-bottom: -4px;
}
.hero-title-line2 {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 48px;
    color: rgb(212, 160, 23);
    letter-spacing: 14px;
    -unity-text-transform: upper;
    -unity-text-align: middle-center;
}

/* Divisor */
.hero-divider {
    flex-direction: row;
    align-items: center;
    margin-top: 20px;
    margin-bottom: 44px;
    width: 700px;
}
.divider-line {
    flex-grow: 1;
    height: 1px;
    background-color: rgb(42, 51, 71);
}
.divider-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 15px;
    letter-spacing: 5px;
    -unity-text-transform: upper;
    color: rgb(122, 138, 170);
    margin: 0 16px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* ── MENU GRID ── */
.menu-grid {
    flex-direction: row;
    width: 1280px;
    max-width: 96%;
    align-self: center;
    margin-bottom: 36px;
    border-width: 1px;
    border-color: rgb(42, 51, 71);
}
.menu-card {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    padding: 32px 28px 28px;
    border-right-width: 1px;
    border-right-color: rgb(42, 51, 71);
    border-top-width: 3px;
    border-top-color: rgb(42, 51, 71);
    border-bottom-width: 0;
    border-left-width: 0;
    height: 260px;
}
.menu-card:hover {
    background-color: rgb(28, 33, 48);
}
.card-manager { border-top-color: rgb(74, 128, 240); }
.card-pro     { border-top-color: rgb(212, 160, 23); }
.card-load    { border-top-color: rgb(39, 174, 96); }
.card-editor  { border-top-color: rgb(122, 138, 170); }
.card-exit    { border-top-color: rgb(192, 57, 43); }

.last {
    border-right-width: 0;
}

.card-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-transform: upper;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    margin-bottom: 8px;
    white-space: normal;
    -unity-text-align: upper-left;
}
.card-sep {
    width: 32px;
    height: 2px;
    margin-bottom: 12px;
    background-color: rgb(42, 51, 71);
}
.card-manager .card-sep { background-color: rgb(74, 128, 240); }
.card-pro .card-sep     { background-color: rgb(212, 160, 23); }
.card-load .card-sep    { background-color: rgb(39, 174, 96); }
.card-editor .card-sep  { background-color: rgb(122, 138, 170); }
.card-exit .card-sep    { background-color: rgb(192, 57, 43); }

.card-desc {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 13px;
    color: rgb(122, 138, 170);
    flex-grow: 1;
    white-space: normal;
    -unity-text-align: upper-left;
}
.card-cta {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
    opacity: 0;
}
.card-manager .cta-label,
.card-manager .cta-arrow {
    color: rgb(74, 128, 240);
}
.card-pro .cta-label,
.card-pro .cta-arrow {
    color: rgb(212, 160, 23);
}
.card-load .cta-label,
.card-load .cta-arrow {
    color: rgb(39, 174, 96);
}
.card-editor .cta-label,
.card-editor .cta-arrow {
    color: rgb(122, 138, 170);
}
.card-exit .cta-label,
.card-exit .cta-arrow {
    color: rgb(192, 57, 43);
}
.cta-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Medium.ttf");
    font-size: 13px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
}
.cta-arrow {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Medium.ttf");
    font-size: 16px;
    margin-left: 6px;
    color: rgb(255, 255, 255);
}

/* ── STATS STRIP ── */
.stats-strip {
    flex-direction: row;
    width: 1280px;
    max-width: 96%;
    align-self: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
}
.stat-item {
    flex-grow: 1;
    flex-direction: column;
    padding: 18px 24px;
    border-right-width: 1px;
    border-right-color: rgb(42, 51, 71);
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}
.stat-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    margin-bottom: 4px;
}
.stat-val-accent {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-left;
    margin-bottom: 4px;
}
.stat-lbl {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-left;
}

/* ── FOOTER ── */
.footer {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgb(22, 26, 36);
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    padding: 14px 40px;
    flex-shrink: 0;
}
.version-tag {
    flex-direction: row;
    align-items: center;
}
.version-dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background-color: rgb(39, 174, 96);
    margin-right: 10px;
    flex-shrink: 0;
}
.version-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}