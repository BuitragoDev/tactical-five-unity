/* ══════════════════════════════════════════
   THE CITY — TheCity.uss
   Hub vivo + capa ligera de proyectos/eventos (F7-05)
   ══════════════════════════════════════════ */

.thecity-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.thecity-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    background-color: rgb(15, 17, 23);
}

.thecity-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 12px 20px 16px 20px;
    min-height: 0;
    overflow: hidden;
}

/* ══ PULSO DE LA CIUDAD ══ */

.city-pulse-row {
    flex-direction: row;
    height: 68px;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.city-pulse-brand {
    width: 190px;
    flex-shrink: 0;
    justify-content: center;
    padding: 0 12px;
    margin-right: 8px;
    border-width: 1px;
    border-color: rgb(120, 95, 30);
    background-color: rgb(18, 21, 28);
    border-radius: 6px;
}

.city-pulse-kicker {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    color: rgb(212, 160, 23);
    letter-spacing: 2px;
}

.city-pulse-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 15px;
    color: rgb(179, 190, 214);
    margin-top: 2px;
}

.city-pulse-card {
    flex-grow: 1;
    flex-basis: 0;
    justify-content: center;
    padding: 6px 12px;
    margin-right: 8px;
    min-width: 0;
    border-width: 1px;
    border-color: rgb(48, 55, 68);
    background-color: rgb(18, 21, 28);
    border-radius: 6px;
}

.city-pulse-card--alert {
    border-color: rgb(120, 95, 30);
}

.city-pulse-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: rgb(120, 132, 155);
    letter-spacing: 1px;
    text-transform: uppercase;
}

.city-pulse-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 26px;
    color: rgb(255, 255, 255);
    margin-top: 1px;
    white-space: normal;
}

.city-pulse-value--small {
    font-size: 16px;
    color: rgb(212, 160, 23);
}

/* ══ MAPA + INSPECTOR ══ */

.city-workspace {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.city-map {
    flex-grow: 1;
    min-width: 0;
    border-width: 1px;
    border-color: rgb(120, 95, 30);
    border-radius: 8px;
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/TheCity/city_map.png");
    -unity-background-scale-mode: scale-and-crop;
    position: relative;
    overflow: hidden;
}

/* ══ CITY HOTSPOTS ══ */

.city-hotspot {
    position: absolute;
    width: 200px;
    height: 86px;
    align-items: center;
}

.city-bubble {
    width: 200px;
    min-height: 42px;
    padding: 8px 12px;
    color: rgb(232, 238, 248);
    background-color: rgb(17, 24, 34);
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    border-radius: 21px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    cursor: pointer;
}
.city-bubble:hover {
    background-color: rgb(212, 160, 23);
    border-width: 2px;
    border-color: rgb(0, 0, 0);
    color: rgb(0, 0, 0);
}

.city-bubble-tail {
    position: absolute;
    width: 14px;
    height: 14px;
    bottom: 33px;
    left: 93px;
    background-color: rgb(17, 24, 34);
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-right-color: rgb(212, 160, 23);
    border-bottom-color: rgb(212, 160, 23);
    rotate: 45deg;
}

.city-status {
    width: 200px;
    margin-top: 12px;
    padding: 1px 8px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(212, 160, 23);
    background-color: rgb(13, 15, 20);
    border-width: 1px;
    border-color: rgb(70, 62, 40);
    border-radius: 9px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Posiciones iniciales, referidas al edificio de la imagen de fondo. */
.city-hotspot--hospital { left: 9%; top: 8%; }
.city-hotspot--arena { left: 49%; top: 4%; }
.city-hotspot--training { right: 7%; top: 11%; }
.city-hotspot--league { left: 60%; top: 30%; }
.city-hotspot--personnel { left: 17%; top: 34%; }
.city-hotspot--bank { left: 38%; top: 45%; }
.city-hotspot--newspaper { left: 6%; top: 56%; }
.city-hotspot--statistics { left: 27%; top: 63%; }
.city-hotspot--museum { left: 64%; top: 60%; }

/* ══ INSPECTOR ══ */

.city-inspector {
    width: 420px;
    min-width: 360px;
    max-width: 460px;
    margin-left: 12px;
    padding: 14px;
    flex-direction: column;
    background-color: rgb(18, 21, 28);
    border-width: 1px;
    border-color: rgb(120, 95, 30);
    border-radius: 8px;
    min-height: 0;
    overflow: hidden;
}

.city-inspector-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 27px;
    color: rgb(255, 255, 255);
    letter-spacing: 1px;
}

.city-inspector-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(212, 160, 23);
    margin-top: 2px;
    margin-bottom: 10px;
    white-space: normal;
}

.city-tabs {
    flex-direction: row;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.city-tab {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 4px;
    padding: 7px 4px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    letter-spacing: 1px;
    color: rgb(150, 160, 180);
    background-color: rgb(23, 27, 35);
    border-width: 1px;
    border-color: rgb(48, 55, 68);
    border-radius: 4px;
    -unity-text-align: middle-center;
    cursor: pointer;
    text-transform: uppercase;
}
.city-tab:hover {
    color: rgb(255, 255, 255);
    border-color: rgb(120, 95, 30);
}
.city-tab--active {
    color: rgb(212, 160, 23);
    border-color: rgb(212, 160, 23);
    background-color: rgb(33, 32, 28);
}

.city-inspector-body {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    flex-direction: column;
}

.city-section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    color: rgb(212, 160, 23);
    letter-spacing: 1px;
    margin-top: 10px;
    margin-bottom: 6px;
    text-transform: uppercase;
}

.city-info-row {
    flex-direction: row;
    margin-bottom: 4px;
}

.city-info-label {
    width: 105px;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    color: rgb(120, 132, 155);
}

.city-info-value {
    flex-grow: 1;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(232, 238, 248);
    white-space: normal;
}

.city-description {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(179, 190, 214);
    white-space: normal;
    margin-top: 4px;
}

.city-action {
    width: 100%;
    margin-top: 8px;
    padding: 9px 12px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(100, 200, 140);
    background-color: rgb(20, 36, 35);
    border-width: 1px;
    border-color: rgb(39, 174, 96);
    border-radius: 6px;
    -unity-text-align: middle-center;
    white-space: normal;
    cursor: pointer;
    text-transform: uppercase;
}
.city-action:hover {
    background-color: rgb(23, 59, 45);
}
.city-action--ghost {
    color: rgb(212, 160, 23);
    background-color: rgb(33, 32, 28);
    border-color: rgb(120, 95, 30);
}
.city-action--ghost:hover {
    background-color: rgb(44, 40, 28);
}
.city-action--danger {
    color: rgb(230, 120, 100);
    background-color: rgb(35, 25, 30);
    border-color: rgb(192, 57, 43);
}
.city-action--danger:hover {
    background-color: rgb(62, 30, 32);
}
.city-action--disabled {
    opacity: 0.55;
}

.city-project-card {
    flex-direction: column;
    padding: 9px 10px;
    margin-bottom: 8px;
    background-color: rgb(23, 27, 35);
    border-width: 1px;
    border-color: rgb(48, 55, 68);
    border-radius: 5px;
}

.city-project-head {
    flex-direction: row;
    align-items: center;
}

.city-project-name {
    flex-grow: 1;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(255, 255, 255);
    white-space: normal;
}

.city-project-level {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    color: rgb(212, 160, 23);
    margin-left: 6px;
}

.city-project-desc {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 15px;
    color: rgb(179, 190, 214);
    white-space: normal;
    margin-top: 2px;
}

.city-project-status {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: rgb(130, 145, 170);
    margin-top: 4px;
    white-space: normal;
}

.city-event-card {
    flex-direction: column;
    padding: 10px;
    background-color: rgb(33, 32, 28);
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    border-radius: 6px;
    margin-bottom: 8px;
}

.city-event-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 17px;
    color: rgb(255, 255, 255);
    letter-spacing: 1px;
    white-space: normal;
}

.city-event-desc {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 15px;
    color: rgb(179, 190, 214);
    white-space: normal;
    margin-top: 3px;
}

.city-choice {
    width: 100%;
    margin-top: 7px;
    padding: 8px 10px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    color: rgb(232, 238, 248);
    background-color: rgb(23, 27, 35);
    border-width: 1px;
    border-color: rgb(70, 78, 92);
    border-radius: 5px;
    -unity-text-align: middle-center;
    white-space: normal;
    cursor: pointer;
}
.city-choice:hover {
    border-color: rgb(212, 160, 23);
    color: rgb(212, 160, 23);
}
.city-choice--disabled {
    opacity: 0.55;
}

.city-choice-effect {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 13px;
    color: rgb(130, 145, 170);
    margin-top: 1px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.city-notice {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    color: rgb(100, 200, 140);
    min-height: 18px;
    margin-top: 6px;
    white-space: normal;
}

.city-empty {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(130, 145, 170);
    white-space: normal;
    margin-top: 8px;
}
