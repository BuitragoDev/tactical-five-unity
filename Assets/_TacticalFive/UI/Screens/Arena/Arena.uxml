<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Arena.uss" />
    <Style src="../Dashboard/Dashboard.uss" />

    <ui:VisualElement name="ArenaRoot" class="arena-root">

        <!-- ══ SIDEBAR ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="arena-main">

            <!-- TOP HEADER -->
            <ui:VisualElement name="TopHeader" class="top-header">
                <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo" />
                <ui:VisualElement class="header-team-info">
                    <ui:Label name="HeaderTeamName"    class="header-team-name"    text="" />
                    <ui:Label name="HeaderManagerName" class="header-manager-name" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="PRESUPUESTO" />
                    <ui:Label name="HeaderBudget" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MASA SALARIAL" />
                    <ui:Label name="HeaderPayroll" class="header-stat-value header-stat-value--neutral" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MARGEN SALARIAL" />
                    <ui:Label name="HeaderMargin" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="QUÍMICA DE EQUIPO" />
                    <ui:Label name="HeaderChemistry" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-spacer" />
                <ui:VisualElement class="header-season-info">
                    <ui:Label name="HeaderSeason" class="header-season-label" text="" />
                    <ui:Label name="HeaderDate"   class="header-date-label"   text="" />
                </ui:VisualElement>
                <ui:Button name="BtnAction" class="btn-action" text="CONTINUAR →" />
                <ui:VisualElement name="ConfigIcon" class="header-config-icon" />
            </ui:VisualElement>

            <!-- ARENA TITLE BOX -->
            <ui:VisualElement class="arena-title-box">
                <ui:Label class="arena-title-box-label" text="PABELLÓN" />
            </ui:VisualElement>

            <!-- ARENA CONTENT -->
            <ui:VisualElement class="arena-content">

                <!-- TOP ROW: 3 panels -->
                <ui:VisualElement class="arena-top-row">

                    <!-- Panel 1: Arena Info -->
                    <ui:VisualElement class="arena-panel arena-panel--info">
                        <ui:VisualElement class="arena-panel-header">
                            <ui:Label class="arena-panel-header-icon" text="🏟" />
                            <ui:Label name="ArenaNameHeader" class="arena-panel-header-title" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement name="ArenaInfoBody" class="arena-info-body" />
                    </ui:VisualElement>

                    <!-- Panel 2: Arena Level -->
                    <ui:VisualElement class="arena-panel arena-panel--level">
                        <ui:VisualElement class="arena-panel-header">
                            <ui:Label class="arena-panel-header-icon" text="⭐" />
                            <ui:Label class="arena-panel-header-title" text="NIVEL DEL PABELLÓN" />
                        </ui:VisualElement>
                        <ui:VisualElement class="arena-level-body">
                            <ui:VisualElement name="ArenaStars" class="arena-stars" />
                            <ui:VisualElement name="ArenaStatus" class="arena-status" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Panel 3: Arena Image -->
                    <ui:VisualElement class="arena-panel arena-panel--image">
                        <ui:VisualElement name="ArenaImage" class="arena-image" />
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- BOTTOM ROW: Upgrades -->
                <ui:VisualElement class="arena-upgrades-section">
                    <ui:VisualElement class="arena-upgrades-header">
                        <ui:Label class="arena-upgrades-header-icon" text="🔧" />
                        <ui:Label class="arena-upgrades-header-title" text="MEJORAS DISPONIBLES" />
                    </ui:VisualElement>

                    <!-- Warning message -->
                    <ui:VisualElement name="RenovationWarning" class="renovation-warning" style="display:none;">
                        <ui:Label class="renovation-warning-icon" text="⏳" />
                        <ui:Label name="RenovationWarningText" class="renovation-warning-text" text="" />
                    </ui:VisualElement>

                    <!-- Upgrade cards -->
                    <ui:VisualElement name="UpgradeCardsContainer" class="upgrade-cards-container" />

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
