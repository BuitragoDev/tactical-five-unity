/* ══════════════════════════════════════════
   ARENA — Arena.uss
   ══════════════════════════════════════════ */

.arena-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.arena-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.arena-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 20px;
    min-height: 0;
    overflow: auto;
}

.panel-arena {
    margin-bottom: 20px;
}

.arena-info {
    flex-direction: column;
    padding: 16px;
}

.arena-detail-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
}

.arena-detail-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 12px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(85, 102, 119);
    width: 180px;
    flex-shrink: 0;
}

.arena-detail-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
}

.arena-upgrades {
    flex-direction: column;
}

.upgrade-item {
    flex-direction: row;
    align-items: center;
    padding: 16px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 2px;
    margin-bottom: 8px;
}

.upgrade-info {
    flex-direction: column;
    flex-grow: 1;
    margin-right: 16px;
}

.upgrade-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    color: rgb(208, 216, 232);
    margin-bottom: 4px;
}

.upgrade-desc {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 12px;
    color: rgb(85, 102, 119);
}

.upgrade-cost {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    color: rgb(192, 57, 43);
    width: 100px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

.btn-upgrade {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 12px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(208, 216, 232);
    background-color: rgb(248, 196, 64);
    border-width: 0;
    border-radius: 2px;
    padding: 8px 16px;
    min-width: 100px;
    -unity-text-align: middle-center;
}

.btn-upgrade:hover {
    background-color: rgb(255, 210, 80);
}

.btn-upgrade:active {
    background-color: rgb(230, 175, 50);
}
