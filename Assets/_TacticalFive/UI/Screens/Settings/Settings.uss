/* ══════════════════════════════════════════
   SETTINGS — Settings.uss
   ══════════════════════════════════════════ */

.settings-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.settings-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.settings-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 24px 30px;
    min-height: 0;
    align-items: center;
}

/* Title row */
.settings-title-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    width: 700px;
    max-width: 100%;
}

.settings-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
}

/* Scroll area */
.settings-scroll {
    flex-grow: 1;
    min-height: 0;
    width: 700px;
    max-width: 100%;
}

.settings-body {
    flex-direction: column;
    align-items: stretch;
}

/* Section */
.settings-section {
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 6px;
    padding: 20px 24px;
    margin-bottom: 16px;
}

.settings-section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(150, 160, 180);
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
}

/* Row */
.settings-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.settings-label {
    width: 160px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
}

/* Custom Slider */
.custom-slider {
    position: relative;
    flex-grow: 1;
    height: 24px;
    min-height: 24px;
    margin: 0;
    margin-right: 12px;
    padding: 0;
}

.custom-slider-track {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: auto;
    height: 4px;
    background-color: rgb(42, 51, 71);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.custom-slider-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    margin: auto;
    height: 4px;
    width: 0%;
    background-color: rgb(248, 196, 64);
    border-top-left-radius: 2px;
    border-bottom-left-radius: 2px;
}

.custom-slider-dragger {
    position: absolute;
    top: 0;
    bottom: 0;
    margin: auto;
    width: 16px;
    height: 16px;
    margin-left: -8px;
    margin-top: -7px;
    left: 0%;
    background-color: rgb(248, 196, 64);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.settings-value {
    width: 50px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    color: rgb(248, 196, 64);
    -unity-text-align: middle-right;
}

/* Quality options */
.settings-quality-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.settings-quality-options {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-end;
}

.settings-quality-btn {
    width: 70px;
    height: 36px;
    margin-left: 6px;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    color: rgb(208, 216, 232);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    -unity-text-align: middle-center;
    -unity-text-transform: upper;
    transition-property: background-color, border-color, color;
    transition-duration: 0.15s;
}

.settings-quality-btn:hover {
    background-color: rgb(28, 33, 48);
    border-color: rgb(58, 74, 99);
}

.settings-quality-btn--active {
    background-color: rgb(248, 196, 64);
    border-color: rgb(248, 196, 64);
    color: rgb(15, 17, 23);
}

.settings-quality-btn--active:hover {
    background-color: rgb(255, 215, 90);
    border-color: rgb(255, 215, 90);
}

/* Buttons */
.settings-btn {
    height: 44px;
    width: 300px;
    max-width: 100%;
    border-radius: 4px;
    border-width: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    -unity-text-transform: upper;
    margin-top: 8px;
    align-self: center;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.settings-btn--secondary {
    background-color: rgb(42, 51, 71);
    color: rgb(208, 216, 232);
}

.settings-btn--secondary:hover {
    background-color: rgb(58, 74, 99);
}

.settings-btn--danger {
    background-color: rgb(192, 57, 43);
    color: rgb(255, 255, 255);
}

.settings-btn--danger:hover {
    background-color: rgb(231, 76, 60);
}
