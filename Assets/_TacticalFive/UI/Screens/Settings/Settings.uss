/* ══════════════════════════════════════════
   SETTINGS — Settings.uss
   ══════════════════════════════════════════ */

.settings-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.settings-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.settings-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 24px 30px;
    min-height: 0;
}

/* Title row */
.settings-title-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
}

.settings-icon {
    font-size: 20px;
    margin-right: 10px;
    color: rgb(248, 196, 64);
}

.settings-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(248, 196, 64);
}

/* Scroll area */
.settings-scroll {
    flex-grow: 1;
    min-height: 0;
}

.settings-body {
    flex-direction: column;
}

/* Section */
.settings-section {
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 6px;
    padding: 20px 24px;
    margin-bottom: 16px;
}

.settings-section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(150, 160, 180);
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
}

/* Row */
.settings-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.settings-label {
    width: 160px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
}

.settings-slider {
    flex-grow: 1;
    height: 20px;
    margin-right: 12px;
}

.settings-slider .unity-base-slider__tracker {
    background-color: rgb(42, 51, 71);
    border-radius: 4px;
    height: 6px;
}

.settings-slider .unity-base-slider__dragger {
    background-color: rgb(248, 196, 64);
    border-radius: 50%;
    width: 16px;
    height: 16px;
    border-width: 0;
    margin-top: -5px;
}

.settings-value {
    width: 50px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    color: rgb(248, 196, 64);
    -unity-text-align: middle-right;
}

/* Dropdown */
.settings-dropdown {
    width: 200px;
    height: 36px;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    color: rgb(208, 216, 232);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
}

.settings-dropdown .unity-base-field__label {
    display: none;
}

/* Buttons */
.settings-btn {
    height: 44px;
    border-radius: 4px;
    border-width: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    margin-top: 8px;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.settings-btn--secondary {
    background-color: rgb(42, 51, 71);
    color: rgb(208, 216, 232);
}

.settings-btn--secondary:hover {
    background-color: rgb(58, 74, 99);
}

.settings-btn--danger {
    background-color: rgb(192, 57, 43);
    color: rgb(255, 255, 255);
}

.settings-btn--danger:hover {
    background-color: rgb(231, 76, 60);
}
