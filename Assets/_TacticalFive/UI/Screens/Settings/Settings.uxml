<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Settings.uss" />
    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />

    <ui:VisualElement name="SettingsRoot" class="settings-root">

        <!-- ══ SIDEBAR ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="settings-main">

            <!-- TOP HEADER -->
            <ui:VisualElement name="TopHeader" class="top-header">
                <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo" />
                <ui:VisualElement class="header-team-info">
                    <ui:Label name="HeaderTeamName"    class="header-team-name"    text="" />
                    <ui:Label name="HeaderManagerName" class="header-manager-name" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="PRESUPUESTO" />
                    <ui:Label name="HeaderBudget" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MASA SALARIAL" />
                    <ui:Label name="HeaderPayroll" class="header-stat-value header-stat-value--neutral" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MARGEN SALARIAL" />
                    <ui:Label name="HeaderMargin" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="QUÍMICA DE EQUIPO" />
                    <ui:Label name="HeaderChemistry" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-spacer" />
                <ui:VisualElement class="header-season-info">
                    <ui:Label name="HeaderSeason" class="header-season-label" text="" />
                    <ui:Label name="HeaderDate"   class="header-date-label"   text="" />
                </ui:VisualElement>
                <ui:Button name="BtnAction" class="btn-action" text="CONTINUAR →" />
                <ui:VisualElement name="ConfigIcon" class="header-config-icon" />
            </ui:VisualElement>

            <!-- SETTINGS CONTENT -->
            <ui:VisualElement class="settings-content">

                <!-- Title -->
                <ui:VisualElement class="settings-title-row">
                    <ui:Label class="settings-title" text="CONFIGURACIÓN" />
                </ui:VisualElement>

                <ui:ScrollView class="settings-scroll"
                               horizontal-scrolling-enabled="false"
                               mode="Vertical">
                    <ui:VisualElement class="settings-body">

                        <!-- AUDIO -->
                        <ui:VisualElement class="settings-section">
                            <ui:Label class="settings-section-title" text="AUDIO" />

                            <ui:VisualElement class="settings-row">
                                <ui:Label class="settings-label" text="Volumen General" />
                                <ui:VisualElement name="SliderMaster" class="custom-slider">
                                    <ui:VisualElement class="custom-slider-track" />
                                    <ui:VisualElement name="FillMaster" class="custom-slider-fill" />
                                    <ui:VisualElement name="DraggerMaster" class="custom-slider-dragger" />
                                </ui:VisualElement>
                                <ui:Label name="LabelMaster" class="settings-value" text="100%" />
                            </ui:VisualElement>

                            <ui:VisualElement class="settings-row">
                                <ui:Label class="settings-label" text="Música" />
                                <ui:VisualElement name="SliderMusic" class="custom-slider">
                                    <ui:VisualElement class="custom-slider-track" />
                                    <ui:VisualElement name="FillMusic" class="custom-slider-fill" />
                                    <ui:VisualElement name="DraggerMusic" class="custom-slider-dragger" />
                                </ui:VisualElement>
                                <ui:Label name="LabelMusic" class="settings-value" text="100%" />
                            </ui:VisualElement>

                            <ui:VisualElement class="settings-row">
                                <ui:Label class="settings-label" text="Efectos" />
                                <ui:VisualElement name="SliderSFX" class="custom-slider">
                                    <ui:VisualElement class="custom-slider-track" />
                                    <ui:VisualElement name="FillSFX" class="custom-slider-fill" />
                                    <ui:VisualElement name="DraggerSFX" class="custom-slider-dragger" />
                                </ui:VisualElement>
                                <ui:Label name="LabelSFX" class="settings-value" text="100%" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- GRAPHICS -->
                        <ui:VisualElement class="settings-section">
                            <ui:Label class="settings-section-title" text="GRÁFICOS" />
                            <ui:VisualElement class="settings-quality-row">
                                <ui:Label class="settings-label" text="Calidad" />
                                <ui:VisualElement class="settings-quality-options">
                                    <ui:Button name="BtnQualityLow"    class="settings-quality-btn" text="Baja" />
                                    <ui:Button name="BtnQualityMedium" class="settings-quality-btn" text="Media" />
                                    <ui:Button name="BtnQualityHigh"   class="settings-quality-btn" text="Alta" />
                                    <ui:Button name="BtnQualityUltra"  class="settings-quality-btn" text="Ultra" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- GAME -->
                        <ui:VisualElement class="settings-section">
                            <ui:Label class="settings-section-title" text="JUEGO" />
                            <ui:Button name="BtnMainMenu" class="settings-btn settings-btn--secondary"
                                       text="VOLVER AL MENÚ PRINCIPAL" />
                            <ui:Button name="BtnExit" class="settings-btn settings-btn--danger"
                                       text="SALIR DEL JUEGO" />
                        </ui:VisualElement>

                    </ui:VisualElement>
                </ui:ScrollView>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ══ MODAL VOLVER AL MENÚ PRINCIPAL ══ -->
        <ui:VisualElement name="MainMenuModalOverlay" class="modal-overlay">
            <ui:VisualElement name="MainMenuModalBox" class="modal-box">
                <ui:Label class="modal-title" text="VOLVER AL MENÚ PRINCIPAL" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight"
                        text="¿Estás seguro de que quieres volver al menú principal?" />
                    <ui:Label class="modal-paragraph"
                        text="Se perderá el progreso no guardado de la partida actual. Asegúrate de haber guardado antes de continuar." />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="BtnMainMenuNo" class="modal-btn modal-btn--secondary" text="NO, QUEDARME" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="BtnMainMenuYes" class="modal-btn modal-btn--danger" text="SÍ, VOLVER" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL SALIR DEL JUEGO ══ -->
        <ui:VisualElement name="ExitModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ExitModalBox" class="modal-box">
                <ui:Label class="modal-title" text="SALIR DEL JUEGO" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight"
                        text="¿Estás seguro de que quieres salir del juego?" />
                    <ui:Label class="modal-paragraph"
                        text="Se cerrará la aplicación. Asegúrate de haber guardado tu progreso si lo deseas." />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="BtnExitNo" class="modal-btn modal-btn--secondary" text="NO" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="BtnExitYes" class="modal-btn modal-btn--danger" text="SÍ, SALIR" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
