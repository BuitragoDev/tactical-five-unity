<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="../Stats/Stats.uss" />
    <Style src="../Standings/Standings.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />
    <Style src="GLeague.uss" />

    <ui:VisualElement name="GLeagueRoot" class="gleague-root">

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="gleague-main">

            <!-- SCREEN HEADER -->
            <ui:VisualElement class="gleague-screen-header panel--gold">
                <ui:VisualElement class="gleague-screen-header-row">
                    <ui:VisualElement name="GLeagueScreenIcon" class="gleague-screen-icon" />
                    <ui:Label text="{loc:ui.gleague.liga_de_desarrollo_g_league}" class="gleague-screen-title" />
                </ui:VisualElement>
                <ui:Label name="GLeagueSubtitle" text="" class="gleague-screen-subtitle" />
            </ui:VisualElement>

            <!-- CONTENT -->
            <ui:VisualElement name="GLeagueContent" class="gleague-content">

                <!-- PESTAÑAS -->
                <ui:VisualElement class="gleague-tabs">
                    <ui:Button name="TabPlantilla" class="standings-tab standings-tab--active" text="{loc:ui.gleague.tab_plantilla}" />
                    <ui:Button name="TabResultados" class="standings-tab" text="{loc:ui.gleague.tab_resultados}" />
                    <ui:Button name="TabClasificacion" class="standings-tab" text="{loc:ui.gleague.tab_clasificacion}" />
                    <ui:Button name="TabEstadisticas" class="standings-tab" text="{loc:ui.gleague.tab_estadisticas}" />
                </ui:VisualElement>

                <!-- ══ PÁGINA 1 · PLANTILLA ══ -->
                <ui:VisualElement name="PagePlantilla" class="gleague-page">

                    <ui:VisualElement class="gleague-tables-row">
                    <!-- ASIGNADOS -->
                    <ui:VisualElement name="AssignedPanel" class="stats-panel">
                        <ui:VisualElement class="stats-panel-header">
                            <ui:Label name="AssignedTitle" class="stats-title" text="{loc:ui.gleague.assigned_title}" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stats-table-wrapper">
                            <ui:VisualElement name="AssignedHeader" class="stats-header-row" />
                            <ui:VisualElement class="stats-scroll-row">
                                <ui:VisualElement name="AssignedViewport" class="stats-viewport">
                                    <ui:VisualElement name="AssignedBody" class="stats-table" />
                                </ui:VisualElement>
                                <ui:VisualElement name="AssignedScrollTrack" class="stats-scrollbar">
                                    <ui:VisualElement name="AssignedScrollThumb" class="stats-scrollbar-thumb" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ELEGIBLES -->
                    <ui:VisualElement name="EligiblePanel" class="stats-panel">
                        <ui:VisualElement class="stats-panel-header">
                            <ui:Label class="stats-title" text="{loc:ui.gleague.elegibles_para_asignar}" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stats-table-wrapper">
                            <ui:VisualElement name="EligibleHeader" class="stats-header-row" />
                            <ui:VisualElement class="stats-scroll-row">
                                <ui:VisualElement name="EligibleViewport" class="stats-viewport">
                                    <ui:VisualElement name="EligibleBody" class="stats-table" />
                                </ui:VisualElement>
                                <ui:VisualElement name="EligibleScrollTrack" class="stats-scrollbar">
                                    <ui:VisualElement name="EligibleScrollThumb" class="stats-scrollbar-thumb" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- ══ PÁGINA 2 · RESULTADOS ══ -->
                <ui:VisualElement name="PageResultados" class="gleague-page" style="display:none">
                    <ui:VisualElement class="stats-panel gl-results-panel">
                        <ui:VisualElement class="stats-panel-header">
                            <ui:Label class="stats-title" text="{loc:ui.gleague.resultados_g_league}" />
                            <ui:Label name="ResultsAffiliate" class="gl-results-affiliate" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement name="ResultsHeader" class="gl-table-header" />
                        <ui:VisualElement class="gl-results-list-row">
                            <ui:VisualElement name="ResultsViewport" class="gl-results-viewport">
                                <ui:VisualElement name="ResultsBody" class="gl-table-body" />
                            </ui:VisualElement>
                            <ui:VisualElement name="ResultsScrollTrack" class="gl-results-scrollbar">
                                <ui:VisualElement name="ResultsScrollThumb" class="gl-results-scrollbar-thumb" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ══ PÁGINA 3 · CLASIFICACIÓN ══ -->
                <ui:VisualElement name="PageClasificacion" class="gleague-page" style="display:none">
                    <ui:VisualElement class="standings-tabs">
                        <ui:Button name="GlTabEast" class="standings-tab standings-tab--active" text="{loc:ui.gleague.gl_tab_east}" />
                        <ui:Button name="GlTabWest" class="standings-tab" text="{loc:ui.gleague.gl_tab_west}" />
                    </ui:VisualElement>

                    <ui:ScrollView class="standings-scroll"
                                   horizontal-scrolling-enabled="false"
                                   mode="Vertical">
                        <ui:VisualElement class="standings-table-container">
                            <ui:VisualElement class="standings-header-row">
                                <ui:Label class="col-rank col-stat--header" text="#" />
                                <ui:VisualElement class="col-logo-space" />
                                <ui:Label class="col-team-name col-stat--header" text="{loc:ui.gleague.filial}" />
                                <ui:Label class="col-stat col-stat--header" text="{loc:ui.gleague.pj}" />
                                <ui:Label class="col-stat col-stat--header" text="{loc:ui.gleague.g}" />
                                <ui:Label class="col-stat col-stat--header" text="{loc:ui.gleague.p}" />
                                <ui:Label class="col-stat col-stat--header" text="%" />
                                <ui:Label class="col-diff col-stat--header" text="{loc:ui.gleague.dif}" />
                                <ui:Label class="col-streak col-stat--header" text="{loc:ui.gleague.racha}" />
                            </ui:VisualElement>
                            <ui:VisualElement name="GlStandingsBody" class="standings-table" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>

                <!-- ══ PÁGINA 4 · ESTADÍSTICAS ══ -->
                <ui:VisualElement name="PageEstadisticas" class="gleague-page" style="display:none">
                    <ui:VisualElement class="gl-leaders-row">
                        <ui:VisualElement name="PanelPts" class="stats-panel gl-leader-panel">
                            <ui:VisualElement class="stats-panel-header"><ui:Label class="stats-title" text="{loc:ui.gleague.puntos_por_partido}" /></ui:VisualElement>
                            <ui:VisualElement name="LeadersPts" class="stats-table gl-leader-body" />
                        </ui:VisualElement>
                        <ui:VisualElement name="PanelReb" class="stats-panel gl-leader-panel">
                            <ui:VisualElement class="stats-panel-header"><ui:Label class="stats-title" text="{loc:ui.gleague.rebotes_por_partido}" /></ui:VisualElement>
                            <ui:VisualElement name="LeadersReb" class="stats-table gl-leader-body" />
                        </ui:VisualElement>
                        <ui:VisualElement name="PanelAst" class="stats-panel gl-leader-panel">
                            <ui:VisualElement class="stats-panel-header"><ui:Label class="stats-title" text="{loc:ui.gleague.asistencias_por_partido}" /></ui:VisualElement>
                            <ui:VisualElement name="LeadersAst" class="stats-table gl-leader-body" />
                        </ui:VisualElement>
                        <ui:VisualElement name="PanelVal" class="stats-panel gl-leader-panel">
                            <ui:VisualElement class="stats-panel-header"><ui:Label class="stats-title" text="{loc:ui.gleague.valoracion_por_partido}" /></ui:VisualElement>
                            <ui:VisualElement name="LeadersVal" class="stats-table gl-leader-body" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ══ MODAL CONFIGURACIÓN ══ -->
        <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigModalBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.gleague.configuracion}" />
                <ui:VisualElement class="modal-body">
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.gleague.audio}" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.gleague.volumen_general}" />
                            <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.gleague.musica}" />
                            <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.gleague.efectos}" />
                            <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.gleague.graficos}" />
                        <ui:VisualElement class="settings-quality-row">
                            <ui:Label class="settings-label" text="{loc:ui.gleague.calidad}" />
                            <ui:VisualElement class="settings-quality-options">
                                <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="{loc:ui.gleague.config_btn_quality_low}" />
                                <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="{loc:ui.gleague.config_btn_quality_medium}" />
                                <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="{loc:ui.gleague.config_btn_quality_high}" />
                                <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="{loc:ui.gleague.config_btn_quality_ultra}" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.gleague.juego}" />
                        <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="{loc:ui.gleague.config_btn_main_menu}" />
                        <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="{loc:ui.gleague.config_btn_exit}" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ConfigBtnCerrar" class="modal-close" text="{loc:ui.gleague.config_btn_cerrar}" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR VOLVER AL MENÚ PRINCIPAL ══ -->
        <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.gleague.volver_al_menu_principal}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.gleague.estas_seguro_de_que_quieres_volver_al_me_6f548452}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.gleague.se_perdera_el_progreso_no_guardado_de_la_b10b7334}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="{loc:ui.gleague.config_btn_main_menu_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="{loc:ui.gleague.config_btn_main_menu_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR SALIR DEL JUEGO ══ -->
        <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.gleague.salir_del_juego}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.gleague.estas_seguro_de_que_quieres_salir_del_ju_c65dd5f1}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.gleague.tu_progreso_se_guarda_automaticamente_du_10fb1edb}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="{loc:ui.gleague.config_btn_exit_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="{loc:ui.gleague.config_btn_exit_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
