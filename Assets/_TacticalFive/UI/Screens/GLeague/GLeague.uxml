<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="../Stats/Stats.uss" />
    <Style src="../Standings/Standings.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />
    <Style src="GLeague.uss" />

    <ui:VisualElement name="GLeagueRoot" class="gleague-root">

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="gleague-main">

            <!-- CONTENT -->
            <ui:VisualElement name="GLeagueContent" class="gleague-content">

                <!-- PESTAÑAS -->
                <ui:VisualElement class="gleague-tabs">
                    <ui:Button name="TabPlantilla" class="standings-tab standings-tab--active" text="PLANTILLA" />
                    <ui:Button name="TabResultados" class="standings-tab" text="RESULTADOS" />
                    <ui:Button name="TabClasificacion" class="standings-tab" text="CLASIFICACIÓN" />
                    <ui:Button name="TabEstadisticas" class="standings-tab" text="ESTADÍSTICAS" />
                </ui:VisualElement>

                <!-- ══ PÁGINA 1 · PLANTILLA ══ -->
                <ui:VisualElement name="PagePlantilla" class="gleague-page">

                    <!-- RESUMEN -->
                    <ui:VisualElement class="gleague-summary">
                        <ui:VisualElement class="gleague-summary-card">
                            <ui:Label name="SummaryAssigned" class="gleague-summary-value" text="0" />
                            <ui:Label class="gleague-summary-label" text="ASIGNADOS A G-LEAGUE" />
                        </ui:VisualElement>
                        <ui:VisualElement class="gleague-summary-card">
                            <ui:Label name="SummaryTwoWay" class="gleague-summary-value" text="0" />
                            <ui:Label class="gleague-summary-label" text="CONTRATOS TWO-WAY" />
                        </ui:VisualElement>
                        <ui:VisualElement class="gleague-summary-note">
                            <ui:Label class="gleague-summary-note-text" text="Los jugadores asignados a la G-League no juegan en la NBA y mejoran +1 atributo cada 7 días (hasta su potencial)." />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="gleague-tables-row">
                    <!-- ASIGNADOS -->
                    <ui:VisualElement name="AssignedPanel" class="stats-panel">
                        <ui:VisualElement class="stats-panel-header">
                            <ui:Label name="AssignedTitle" class="stats-title" text="ASIGNADOS A G-LEAGUE" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stats-table-wrapper">
                            <ui:VisualElement name="AssignedHeader" class="stats-header-row" />
                            <ui:VisualElement name="AssignedBody" class="stats-table" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ELEGIBLES -->
                    <ui:VisualElement name="EligiblePanel" class="stats-panel">
                        <ui:VisualElement class="stats-panel-header">
                            <ui:Label class="stats-title" text="ELEGIBLES PARA ASIGNAR" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stats-table-wrapper">
                            <ui:VisualElement name="EligibleHeader" class="stats-header-row" />
                            <ui:VisualElement name="EligibleBody" class="stats-table" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- ══ PÁGINA 2 · RESULTADOS ══ -->
                <ui:VisualElement name="PageResultados" class="gleague-page" style="display:none">
                    <ui:VisualElement class="stats-panel gl-results-panel">
                        <ui:VisualElement class="stats-panel-header">
                            <ui:Label class="stats-title" text="RESULTADOS G-LEAGUE" />
                            <ui:Label name="ResultsAffiliate" class="gl-results-affiliate" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement name="ResultsHeader" class="gl-table-header" />
                        <ui:VisualElement class="gl-results-scroll-wrap">
                            <ui:ScrollView class="gl-results-scroll" horizontal-scrolling-enabled="false" mode="Vertical">
                                <ui:VisualElement name="ResultsBody" class="gl-table-body" />
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ══ PÁGINA 3 · CLASIFICACIÓN ══ -->
                <ui:VisualElement name="PageClasificacion" class="gleague-page" style="display:none">
                    <ui:VisualElement class="standings-tabs">
                        <ui:Button name="GlTabEast" class="standings-tab standings-tab--active" text="CONFERENCIA ESTE" />
                        <ui:Button name="GlTabWest" class="standings-tab" text="CONFERENCIA OESTE" />
                    </ui:VisualElement>

                    <ui:ScrollView class="standings-scroll"
                                   horizontal-scrolling-enabled="false"
                                   mode="Vertical">
                        <ui:VisualElement class="standings-table-container">
                            <ui:VisualElement class="standings-header-row">
                                <ui:Label class="col-rank col-stat--header" text="#" />
                                <ui:VisualElement class="col-logo-space" />
                                <ui:Label class="col-team-name col-stat--header" text="FILIAL" />
                                <ui:Label class="col-stat col-stat--header" text="PJ" />
                                <ui:Label class="col-stat col-stat--header" text="G" />
                                <ui:Label class="col-stat col-stat--header" text="P" />
                                <ui:Label class="col-stat col-stat--header" text="%" />
                                <ui:Label class="col-diff col-stat--header" text="DIF" />
                                <ui:Label class="col-streak col-stat--header" text="RACHA" />
                            </ui:VisualElement>
                            <ui:VisualElement name="GlStandingsBody" class="standings-table" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>

                <!-- ══ PÁGINA 4 · ESTADÍSTICAS ══ -->
                <ui:VisualElement name="PageEstadisticas" class="gleague-page" style="display:none">
                    <ui:VisualElement class="gl-leaders-row">
                        <ui:VisualElement name="PanelPts" class="stats-panel gl-leader-panel">
                            <ui:VisualElement class="stats-panel-header"><ui:Label class="stats-title" text="PUNTOS POR PARTIDO" /></ui:VisualElement>
                            <ui:VisualElement name="LeadersPts" class="stats-table gl-leader-body" />
                        </ui:VisualElement>
                        <ui:VisualElement name="PanelReb" class="stats-panel gl-leader-panel">
                            <ui:VisualElement class="stats-panel-header"><ui:Label class="stats-title" text="REBOTES POR PARTIDO" /></ui:VisualElement>
                            <ui:VisualElement name="LeadersReb" class="stats-table gl-leader-body" />
                        </ui:VisualElement>
                        <ui:VisualElement name="PanelAst" class="stats-panel gl-leader-panel">
                            <ui:VisualElement class="stats-panel-header"><ui:Label class="stats-title" text="ASISTENCIAS POR PARTIDO" /></ui:VisualElement>
                            <ui:VisualElement name="LeadersAst" class="stats-table gl-leader-body" />
                        </ui:VisualElement>
                        <ui:VisualElement name="PanelVal" class="stats-panel gl-leader-panel">
                            <ui:VisualElement class="stats-panel-header"><ui:Label class="stats-title" text="VALORACION POR PARTIDO" /></ui:VisualElement>
                            <ui:VisualElement name="LeadersVal" class="stats-table gl-leader-body" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ══ MODAL CONFIGURACIÓN ══ -->
        <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigModalBox" class="modal-box">
                <ui:Label class="modal-title" text="CONFIGURACIÓN" />
                <ui:VisualElement class="modal-body">
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="AUDIO" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="Volumen General" />
                            <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="Música" />
                            <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="Efectos" />
                            <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="GRÁFICOS" />
                        <ui:VisualElement class="settings-quality-row">
                            <ui:Label class="settings-label" text="Calidad" />
                            <ui:VisualElement class="settings-quality-options">
                                <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="Baja" />
                                <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="Media" />
                                <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="Alta" />
                                <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="Ultra" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="JUEGO" />
                        <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="VOLVER AL MENÚ PRINCIPAL" />
                        <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="SALIR DEL JUEGO" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ConfigBtnCerrar" class="modal-close" text="CERRAR" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR VOLVER AL MENÚ PRINCIPAL ══ -->
        <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="VOLVER AL MENÚ PRINCIPAL" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="¿Estás seguro de que quieres volver al menú principal?" />
                    <ui:Label class="modal-paragraph" text="Se perderá el progreso no guardado de la partida actual. Asegúrate de haber guardado antes de continuar." />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="NO, QUEDARME" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="SÍ, VOLVER" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR SALIR DEL JUEGO ══ -->
        <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="SALIR DEL JUEGO" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="¿Estás seguro de que quieres salir del juego?" />
                    <ui:Label class="modal-paragraph" text="Tu progreso se guarda automáticamente durante la partida. Al volver a cargarla continuarás desde el último estado guardado." />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="NO" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="SÍ, SALIR" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
