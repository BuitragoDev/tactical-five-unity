/* ══════════════════════════════════════════
   G-LEAGUE — GLeague.uss
   (La tabla reutiliza los estilos de Stats.uss)
   ══════════════════════════════════════════ */

.gleague-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.gleague-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

/* ── SCREEN HEADER ── */
.gleague-screen-header.panel--gold {
    flex-shrink: 0;
    padding: 0;
    margin: 16px 20px 12px 20px;
    border-color: rgb(212, 160, 23);
    border-width: 1px;
    background-color: rgb(33, 32, 28);
    border-radius: 4px;
    overflow: hidden;
}
.gleague-screen-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    background-color: rgb(33, 32, 28);
}
.gleague-screen-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.gleague-screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    white-space: normal;
}
.gleague-screen-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(212, 160, 23);
    padding: 0 14px;
    background-color: rgb(33, 32, 28);
}

.gleague-content {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    padding: 16px 24px;
}

/* ══ PANELES (2 columnas lado a lado) ══ */

.gleague-tables-row {
    flex-direction: row;
    width: 100%;
    flex-grow: 1;
    min-height: 0;
    align-items: stretch;
}

.gleague-tables-row .stats-panel {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-bottom: 0;
    margin-right: 20px;
}

#AssignedPanel {
    flex-basis: 100px;
}

#EligiblePanel {
    margin-right: 0;
}

/* Cabeceras de los paneles de la pestaña PLANTILLA sin padding vertical */
#AssignedPanel .stats-panel-header,
#EligiblePanel .stats-panel-header {
    padding-top: 0;
    padding-bottom: 0;
}

/* Columnas más compactas para que quepan las dos tablas lado a lado */
.gleague-root .col-stat {
    width: 54px;
    font-size: 16px;
}

.gleague-root .col-pos {
    width: 40px;
}

.gleague-root .gleague-role {
    width: 40px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.gleague-role-icon {
    width: 24px;
    height: 24px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    flex-shrink: 0;
}

.gleague-root .gleague-player {
    width: 340px;
}

.gleague-root .gleague-action {
    width: 84px;
}

/* Filas más compactas para que quepan 17 jugadores en pantalla */
.gleague-root .stats-row {
    padding: 0 16px;
    min-height: 42px;
}

.gleague-root .stats-header-row {
    padding: 6px 16px;
}

/* ══ AVATAR EN LA COLUMNA JUGADOR ══ */

.gleague-player {
    flex-direction: row;
    align-items: center;
    width: 300px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

.gleague-avatar {
    width: 36px;
    height: 36px;
    border-radius: 4px;
    margin-right: 10px;
    flex-shrink: 0;
    background-color: rgb(205, 205, 206);
}

.gleague-player-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
}

/* ══ BOTÓN DE ACCIÓN (RECUPERAR / ASIGNAR) ══ */

.gleague-action {
    width: 110px;
    flex-shrink: 0;
}

.gleague-action-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 13px;
    letter-spacing: 1px;
    padding: 6px 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    background-color: rgb(22, 26, 36);
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

.gleague-action-btn:hover {
    border-color: rgb(212, 160, 23);
    color: rgb(212, 160, 23);
}

.gleague-action-btn--on {
    border-color: rgb(39, 84, 148);
    background-color: rgb(39, 84, 148);
    color: rgb(190, 220, 255);
}

.gleague-action-btn--on:hover {
    border-color: rgb(190, 220, 255);
    color: rgb(255, 255, 255);
}

/* ══════════════════════════════════════════
   PESTAÑAS Y PÁGINAS
   ══════════════════════════════════════════ */

.gleague-tabs {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
}

.gleague-tabs .standings-tab {
    margin-right: 8px;
}

.gleague-page {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
}

/* ══ RESULTADOS ══ */

.gl-results-panel {
    flex-grow: 1;
    min-height: 0;
}

.gl-results-panel .stats-table-wrapper {
    display: none;
}

.gl-results-list-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.gl-results-viewport {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    position: relative;
}

/* ── Custom scrollbar (gold) ── */
.gl-results-scrollbar {
    width: 12px;
    min-width: 12px;
    flex-shrink: 0;
    align-self: stretch;
    margin-left: 4px;
    background-color: rgb(24, 18, 10);
    border-left-width: 1px;
    border-left-color: rgb(54, 47, 29);
    position: relative;
}

.gl-results-scrollbar-thumb {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 0;
    height: 40px;
    background-color: rgb(160, 128, 30);
    border-radius: 3px;
}
.gl-results-scrollbar:hover .gl-results-scrollbar-thumb {
    background-color: rgb(212, 160, 23);
}

.gl-table-body {
    flex-direction: column;
    flex-shrink: 0;
}

.gl-table-header {
    flex-direction: row;
    align-items: center;
    min-height: 34px;
    padding: 6px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
}

.gl-table-row {
    flex-direction: row;
    align-items: center;
    min-height: 46px;
    padding: 4px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(22, 26, 36);
}

.gl-table-row--playoff {
    border-left-width: 3px;
    border-left-color: rgb(212, 160, 23);
}

.gl-c-date {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    width: 108px;
    flex-shrink: 0;
    margin-right: 18px;
    -unity-text-align: middle-left;
}

.gl-c-logo {
    width: 32px;
    height: 32px;
    margin-right: 12px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    align-self: center;
}

.gl-c-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    width: 250px;
    flex-shrink: 0;
    margin-right: 18px;
    overflow: hidden;
    -unity-text-align: middle-left;
}

.gl-c-vs {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 13px;
    color: rgb(85, 102, 119);
    width: 28px;
    flex-shrink: 0;
    margin-right: 18px;
    -unity-text-align: middle-left;
}

.gl-c-score {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 17px;
    color: rgb(208, 216, 232);
    width: 100px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

.gl-cell--header {
    color: rgb(58, 74, 99);
}

.gl-cell--bold {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.gl-results-affiliate {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    margin-left: auto;
}

/* ══ LÍDERES ESTADÍSTICOS ══ */

.gl-leaders-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    align-items: stretch;
}

.gl-leader-panel {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 14px;
    margin-bottom: 0;
}

.gl-leader-panel:last-of-type {
    margin-right: 0;
}

.gl-leader-body {
    padding-bottom: 8px;
}

.gl-leader-row {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    padding: 2px 10px;
}

.gl-leader-rank {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    color: rgb(85, 102, 119);
    width: 24px;
    flex-shrink: 0;
}

.gl-leader-avatar {
    width: 56px;
    height: 56px;
    border-radius: 4px;
    margin-right: 10px;
    flex-shrink: 0;
    background-color: rgb(205, 205, 206);
}

.gl-leader-info {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
}

.gl-leader-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    overflow: hidden;
}

.gl-leader-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(85, 102, 119);
}

.gl-leader-games {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
}

.gl-leader-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    margin-left: 8px;
    flex-shrink: 0;
}


/* ── CLASIFICACIÓN: filas más compactas ── */
.gleague-page .standings-row {
    padding: 8px 16px;
    min-height: 44px;
}
