<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Market.uss" />
    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />

    <ui:VisualElement name="MarketRoot" class="market-root">

        <!-- ══ SIDEBAR ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="market-main">

            <!-- TOP HEADER -->
            <!-- MARKET CONTENT -->
            <ui:VisualElement class="market-content">

                <!-- ══ DEADLINE COUNTDOWN ══ -->
                <ui:VisualElement name="DeadlineCountdownBar" class="market-deadline-countdown-bar" style="display: none;">
                    <ui:Label name="DeadlineCountdownText" class="market-deadline-countdown-text" text="" />
                </ui:VisualElement>

                <!-- ══ TEAM SELECTION ══ -->
                <ui:VisualElement class="market-section">
                    <ui:VisualElement class="market-section-title">
                        <ui:Label class="market-section-icon" text="🛒" />
                        <ui:Label class="market-section-title-text" text="SELECCIONA UN EQUIPO PARA NEGOCIAR" />
                    </ui:VisualElement>
                    <ui:VisualElement name="TeamGrid" class="market-team-grid" />
                </ui:VisualElement>

                    <!-- ══ NEGOTIATE BUTTON ══ -->
                    <ui:Button name="BtnNegotiate" class="market-btn-negotiate">
                        <ui:Label name="NegotiateBtnText" class="market-btn-negotiate-text" text="SELECCIONA UN EQUIPO PARA NEGOCIAR" />
                    </ui:Button>

                    <!-- ══ FREE AGENTS PANEL ══ -->
                    <ui:VisualElement name="FreeAgentsPanel" class="market-fa-panel" style="display: none;">
                        <ui:VisualElement class="market-fa-panel-inner">
                            <ui:VisualElement class="market-fa-panel-header">
                                <ui:Label class="market-fa-panel-name" text="AGENTES LIBRES" />
                            </ui:VisualElement>
                            <ui:VisualElement name="FreeAgentsTableHeader" class="market-table-header" />
                            <ui:VisualElement class="market-fa-scroll-row">
                                <ui:VisualElement name="FAViewport" class="market-fa-viewport">
                                    <ui:VisualElement name="FreeAgentsBody" class="market-fa-content" />
                                </ui:VisualElement>
                                <ui:VisualElement name="FAScrollTrack" class="market-fa-scrollbar">
                                    <ui:VisualElement name="FAScrollThumb" class="market-fa-scrollbar-thumb" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ══ TRANSFER WINDOW CLOSED OVERLAY ══ -->
                    <ui:VisualElement name="MarketClosedOverlay" class="market-closed-overlay" style="display: none;">
                        <ui:VisualElement class="market-closed-overlay-box">
                            <ui:Label class="market-closed-overlay-icon" text="🚫" />
                            <ui:Label class="market-closed-overlay-title" text="PERIODO DE TRASPASOS FINALIZADO" />
                            <ui:Label class="market-closed-overlay-text" text="El plazo de traspasos ha finalizado. No puedes realizar operaciones hasta la próxima temporada." />
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>

        </ui:VisualElement>

        <!-- ══ TRADE MODAL (full-screen overlay, outside market-main) ══ -->
        <ui:VisualElement name="TradePanels" class="market-trade-modal" style="display: none;">
            <ui:VisualElement class="market-trade-modal-box">
                <!-- HEADER -->
                <ui:VisualElement class="market-trade-modal-header">
                    <ui:VisualElement class="market-trade-modal-heading">
                        <ui:VisualElement name="TradeModalIcon" class="market-trade-modal-icon" />
                        <ui:VisualElement>
                            <ui:Label class="market-trade-modal-title" text="PROPONER TRASPASO" />
                            <ui:Label class="market-trade-modal-subtitle" text="Selecciona los jugadores y activos que quieres incluir en la oferta." />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="market-trade-modal-header-actions">
                        <ui:Button name="BtnConfirmTrade" class="market-trade-btn market-trade-btn--confirm" text="ENVIAR OFERTA" />
                        <ui:Button name="BtnCloseTradeModal" class="market-trade-btn market-trade-btn--danger" text="CERRAR" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 3-COLUMN CONTENT -->
                <ui:VisualElement class="market-trade-modal-content">

                    <!-- ══ LEFT: MY TEAM ══ -->
                    <ui:VisualElement class="market-trade-panel market-trade-panel--mine">
                        <ui:VisualElement class="market-trade-panel-header">
                            <ui:VisualElement name="MyTeamLogo" class="market-trade-panel-logo" />
                            <ui:VisualElement class="market-trade-panel-header-text">
                                <ui:Label name="MyTeamName" class="market-trade-panel-name" text="" />
                                <ui:Label class="market-trade-panel-subtitle" text="Tú" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="market-trade-panel-stats">
                            <ui:VisualElement class="market-trade-stat">
                                <ui:Label class="market-trade-stat-label" text="SALARIO ACTUAL" />
                                <ui:Label name="MyTeamSalary" class="market-trade-stat-value" text="$0M" />
                            </ui:VisualElement>
                            <ui:VisualElement class="market-trade-stat">
                                <ui:Label class="market-trade-stat-label" text="MARGEN SALARIAL" />
                                <ui:Label name="MyTeamCapSpace" class="market-trade-stat-value market-trade-stat-value--green" text="$0M" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="market-trade-panel-section-title market-trade-picks-title-bar">
                            <ui:Label class="market-trade-panel-section-text" text="ACTIVOS ADICIONALES" />
                        </ui:VisualElement>
                        <ui:VisualElement class="market-trade-picks-section">
                            <ui:VisualElement class="market-trade-picks-row">
                                <ui:Label class="market-trade-picks-icon" text="🏀" />
                                <ui:VisualElement class="market-trade-picks-info">
                                    <ui:Label class="market-trade-picks-label" text="Rondas de draft" />
                                    <ui:Label name="MyPicksCount" class="market-trade-picks-sub" text="0 picks disponibles" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="market-trade-picks-list-row">
                                <ui:VisualElement name="MyPicksViewport" class="market-trade-picks-scroll">
                                    <ui:VisualElement name="MyPicksBody" class="market-trade-picks-content" />
                                </ui:VisualElement>
                                <ui:VisualElement name="MyPicksScrollTrack" class="market-trade-picks-scrollbar">
                                    <ui:VisualElement name="MyPicksScrollThumb" class="market-trade-picks-scrollbar-thumb" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="market-trade-panel-section-title">
                            <ui:Label class="market-trade-panel-section-text" text="JUGADORES DISPONIBLES" />
                        </ui:VisualElement>
                        <ui:VisualElement name="MyFilterTabs" class="market-trade-filter-tabs">
                            <ui:Button name="MyFilterAll" class="market-trade-filter-btn market-trade-filter-btn--active" text="TODOS" />
                            <ui:Button name="MyFilterPG" class="market-trade-filter-btn" text="BASE" />
                            <ui:Button name="MyFilterSG" class="market-trade-filter-btn" text="ESCOLTA" />
                            <ui:Button name="MyFilterSF" class="market-trade-filter-btn" text="ALERO" />
                            <ui:Button name="MyFilterPF" class="market-trade-filter-btn" text="ALA-PÍVOT" />
                            <ui:Button name="MyFilterC" class="market-trade-filter-btn" text="PÍVOT" />
                        </ui:VisualElement>
                        <ui:VisualElement name="MyTableHeader" class="market-trade-table-header" />
                        <ui:VisualElement class="market-trade-player-list-row">
                            <ui:VisualElement name="MyPlayerViewport" class="market-trade-panel-body">
                                <ui:VisualElement name="MyTeamBody" class="market-trade-panel-content" />
                            </ui:VisualElement>
                            <ui:VisualElement name="MyPlayerScrollTrack" class="market-trade-scrollbar">
                                <ui:VisualElement name="MyPlayerScrollThumb" class="market-trade-scrollbar-thumb" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ══ CENTER: OTHER TEAM ══ -->
                    <ui:VisualElement class="market-trade-panel market-trade-panel--other">
                        <ui:VisualElement class="market-trade-panel-header">
                            <ui:VisualElement name="OtherTeamLogo" class="market-trade-panel-logo" />
                            <ui:VisualElement class="market-trade-panel-header-text">
                                <ui:Label name="OtherTeamName" class="market-trade-panel-name" text="" />
                                <ui:Label class="market-trade-panel-subtitle" text="Negociación" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="market-trade-panel-stats">
                            <ui:VisualElement class="market-trade-stat">
                                <ui:Label class="market-trade-stat-label" text="SALARIO ACTUAL" />
                                <ui:Label name="OtherTeamSalary" class="market-trade-stat-value" text="$0M" />
                            </ui:VisualElement>
                            <ui:VisualElement class="market-trade-stat">
                                <ui:Label class="market-trade-stat-label" text="MARGEN SALARIAL" />
                                <ui:Label name="OtherTeamCapSpace" class="market-trade-stat-value market-trade-stat-value--green" text="$0M" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="market-trade-panel-section-title market-trade-picks-title-bar">
                            <ui:Label class="market-trade-panel-section-text" text="ACTIVOS ADICIONALES" />
                        </ui:VisualElement>
                        <ui:VisualElement class="market-trade-picks-section">
                            <ui:VisualElement class="market-trade-picks-row">
                                <ui:Label class="market-trade-picks-icon" text="🏀" />
                                <ui:VisualElement class="market-trade-picks-info">
                                    <ui:Label class="market-trade-picks-label" text="Rondas de draft" />
                                    <ui:Label name="OtherPicksCount" class="market-trade-picks-sub" text="0 picks disponibles" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="market-trade-picks-list-row">
                                <ui:VisualElement name="OtherPicksViewport" class="market-trade-picks-scroll">
                                    <ui:VisualElement name="OtherPicksBody" class="market-trade-picks-content" />
                                </ui:VisualElement>
                                <ui:VisualElement name="OtherPicksScrollTrack" class="market-trade-picks-scrollbar">
                                    <ui:VisualElement name="OtherPicksScrollThumb" class="market-trade-picks-scrollbar-thumb" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="market-trade-panel-section-title">
                            <ui:Label class="market-trade-panel-section-text" text="JUGADORES EN SU PLANTILLA" />
                        </ui:VisualElement>
                        <ui:VisualElement name="OtherFilterTabs" class="market-trade-filter-tabs">
                            <ui:Button name="OtherFilterAll" class="market-trade-filter-btn market-trade-filter-btn--active" text="TODOS" />
                            <ui:Button name="OtherFilterPG" class="market-trade-filter-btn" text="BASE" />
                            <ui:Button name="OtherFilterSG" class="market-trade-filter-btn" text="ESCOLTA" />
                            <ui:Button name="OtherFilterSF" class="market-trade-filter-btn" text="ALERO" />
                            <ui:Button name="OtherFilterPF" class="market-trade-filter-btn" text="ALA-PÍVOT" />
                            <ui:Button name="OtherFilterC" class="market-trade-filter-btn" text="PÍVOT" />
                        </ui:VisualElement>
                        <ui:VisualElement name="OtherTableHeader" class="market-trade-table-header" />
                        <ui:VisualElement class="market-trade-player-list-row">
                            <ui:VisualElement name="OtherPlayerViewport" class="market-trade-panel-body">
                                <ui:VisualElement name="OtherTeamBody" class="market-trade-panel-content" />
                            </ui:VisualElement>
                            <ui:VisualElement name="OtherPlayerScrollTrack" class="market-trade-scrollbar">
                                <ui:VisualElement name="OtherPlayerScrollThumb" class="market-trade-scrollbar-thumb" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ══ RIGHT: SUMMARY ══ -->
                    <ui:VisualElement class="market-trade-summary">
                        <ui:Label class="market-summary-title-text" text="RESUMEN DEL TRASPASO" />

                        <!-- My team receives -->
                        <ui:VisualElement class="market-summary-receive-section">
                            <ui:VisualElement class="market-summary-receive-header">
                                <ui:Label name="SummaryMyTeamBadge" class="market-summary-badge" text="TF" />
                                <ui:Label name="SummaryMyReceiveLabel" class="market-summary-receive-title" text="EQUIPO RECIBE" />
                            </ui:VisualElement>
                            <ui:VisualElement name="SummaryMyReceivedPlayers" class="market-summary-received-players" />
                        </ui:VisualElement>

                        <!-- Other team receives -->
                        <ui:VisualElement class="market-summary-receive-section">
                            <ui:VisualElement class="market-summary-receive-header market-summary-receive-header--other">
                                <ui:Label name="SummaryOtherTeamBadge" class="market-summary-badge market-summary-badge--other" text="TF" />
                                <ui:Label name="SummaryOtherReceiveLabel" class="market-summary-receive-title" text="EQUIPO RECIBE" />
                            </ui:VisualElement>
                            <ui:VisualElement name="SummaryOtherReceivedPlayers" class="market-summary-received-players" />
                        </ui:VisualElement>

                        <!-- Salary totals -->
                        <ui:VisualElement class="market-summary-salary-section">
                            <ui:VisualElement class="market-summary-salary-row">
                                <ui:Label name="SummaryMySalaryLabel" class="market-summary-salary-label" text="SALARIO DE LA OFERTA" />
                                <ui:Label name="SummaryMySalaryTotal" class="market-summary-salary-value" text="$0" />
                            </ui:VisualElement>
                            <ui:VisualElement class="market-summary-salary-row">
                                <ui:Label name="SummaryOtherSalaryLabel" class="market-summary-salary-label" text="SALARIO DE LA OFERTA" />
                                <ui:Label name="SummaryOtherSalaryTotal" class="market-summary-salary-value" text="$0" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- Validation -->
                        <ui:VisualElement name="TradeStatus" class="market-trade-status" />
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODALS ══ -->
        <!-- FA Roster Full Modal -->
        <ui:VisualElement name="FARosterFullModal" class="renew-modal-overlay" style="display: none;">
            <ui:VisualElement class="renew-modal-box renew-modal-box--negative">
                <ui:VisualElement name="FARosterFullIcon" class="renew-modal-icon"/>
                <ui:Label class="renew-modal-title renew-modal-title--negative" text="PLANTILLA COMPLETA" />
                <ui:Label name="FARosterFullText" class="renew-modal-text" text="" />
                <ui:Label class="renew-modal-text" text="Debes liberar plazas antes de poder fichar." />
                <ui:VisualElement class="renew-modal-buttons">
                    <ui:Button name="BtnCloseFARosterFull" class="btn-modal-danger" text="ENTENDIDO" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- FA Confirm Modal -->
        <!-- ══ MODAL OFERTA AGENTE LIBRE ══ -->
         <ui:VisualElement name="FAConfirmModal" class="market-modal-overlay">
            <ui:VisualElement name="FABox" class="market-fa-modal-box">
                <ui:VisualElement class="market-fa-modal-header">
                    <ui:VisualElement class="market-fa-modal-heading">
                        <ui:VisualElement name="FAIcon" class="market-fa-modal-icon"/>
                        <ui:VisualElement>
                            <ui:Label name="FATitle" class="market-fa-modal-title" text="OFERTA DE CONTRATO" />
                            <ui:Label name="FAText1" class="market-fa-modal-subtitle" text="" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="market-fa-modal-body">
                <ui:VisualElement name="FAFormRowSalary" class="renew-form-row">
                    <ui:Label class="renew-form-label" text="SALARIO ($)" />
                    <ui:VisualElement class="renew-spinner-row">
                        <ui:Label name="FASalaryDec" class="btn-spin" text="◀" />
                        <ui:Label name="FASalaryValue" class="renew-spin-label" text="" />
                        <ui:Label name="FASalaryInc" class="btn-spin" text="▶" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="FAFormRowYears" class="renew-form-row">
                    <ui:Label class="renew-form-label" text="DURACIÓN (años)" />
                    <ui:VisualElement class="renew-spinner-row">
                        <ui:Label name="FAYearsDec" class="btn-spin" text="◀" />
                        <ui:Label name="FAYearsValue" class="renew-spin-label" text="" />
                        <ui:Label name="FAYearsInc" class="btn-spin" text="▶" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="FAFormRowOptions" class="renew-form-row renew-options-row">
                    <ui:Label class="renew-form-label" text="OPCIONES" />
                    <ui:VisualElement class="renew-options-toggles">
                        <ui:Button name="FATeamOption" class="renew-toggle-btn" text="TO (Team Option)" />
                        <ui:Button name="FAPlayerOption" class="renew-toggle-btn" text="PO (Player Option)" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="FAFormRowTwoWay" class="renew-form-row renew-options-row" style="display: none;">
                    <ui:Label class="renew-form-label" text="CONTRATO" />
                    <ui:VisualElement class="renew-options-toggles">
                        <ui:Button name="FATwoWayToggle" class="renew-toggle-btn" text="TWO-WAY" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="FAText2" class="renew-modal-text" text="" />
                <ui:Label name="FAWarningText" class="renew-modal-text renew-modal-text--warning" style="display: none;" text="" />
                <ui:Label name="FAMaxInfo" class="renew-modal-text renew-modal-text--info" style="display: none;" text="" />
                <ui:Label name="FAPendingText" class="renew-modal-text renew-modal-text--pending" style="display: none;" text="OFERTA ENVIADA. Recibirás la respuesta en tu Dashboard en 7 días." />
                 <ui:VisualElement class="market-fa-modal-actions">
                     <ui:Button name="BtnCancelFA" class="btn-modal-cancel" text="CERRAR" />
                     <ui:Button name="BtnConfirmFA" class="btn-modal-confirm" text="ENVIAR OFERTA" />
                 </ui:VisualElement>
                </ui:VisualElement>
             </ui:VisualElement>
         </ui:VisualElement>

        <!-- Trade Success Modal (professional) -->
        <ui:VisualElement name="TradeSuccessOverlay" class="trade-overlay">
            <ui:VisualElement name="TradeSuccessBox" class="trade-box">
                <!-- Header -->
                <ui:VisualElement class="trade-header">
                    <ui:VisualElement class="trade-check-icon" />
                    <ui:VisualElement class="trade-header-text">
                        <ui:Label name="TradeSuccessTitle" class="trade-title" text="¡TRASPASO REALIZADO!" />
                        <ui:Label class="trade-subtitle" text="El siguiente traspaso ha sido completado exitosamente." />
                    </ui:VisualElement>
                    <ui:Button name="BtnTradeSuccessCloseX" class="trade-close-x" text="✕" />
                </ui:VisualElement>
                <ui:VisualElement class="trade-green-line" />
                <!-- Two team panels -->
                <ui:VisualElement class="trade-panels-row">
                    <!-- Left: Equipo que envía -->
                    <ui:VisualElement class="trade-team-panel">
                        <ui:VisualElement class="trade-team-header-row">
                            <ui:VisualElement name="TradeSuccessMyTeamLogo" class="trade-team-logo-lg" />
                            <ui:VisualElement class="trade-team-info-col">
                                <ui:Label name="TradeSuccessMyTeamName" class="trade-team-name-lg" text="" />
                                <ui:Label class="trade-team-role" text="RECIBE" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="trade-table">
                            <ui:VisualElement class="trade-table-header">
                                <ui:Label class="trade-th trade-th-player" text="JUGADOR / ACTIVO" />
                                <ui:Label class="trade-th trade-th-pos" text="POS" />
                                <ui:Label class="trade-th trade-th-tipo" text="TIPO" />
                            </ui:VisualElement>
                            <ui:VisualElement name="TradeSuccessMyPlayersBody" class="trade-table-body" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <!-- Swap icon -->
                    <ui:VisualElement class="trade-swap-icon">
                        <ui:Label text="⇄" />
                    </ui:VisualElement>
                    <!-- Right: Equipo que recibe -->
                    <ui:VisualElement class="trade-team-panel">
                        <ui:VisualElement class="trade-team-header-row">
                            <ui:VisualElement name="TradeSuccessOtherTeamLogo" class="trade-team-logo-lg" />
                            <ui:VisualElement class="trade-team-info-col">
                                <ui:Label name="TradeSuccessOtherTeamName" class="trade-team-name-lg" text="" />
                                <ui:Label class="trade-team-role" text="RECIBE" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="trade-table">
                            <ui:VisualElement class="trade-table-header">
                                <ui:Label class="trade-th trade-th-player" text="JUGADOR / ACTIVO" />
                                <ui:Label class="trade-th trade-th-pos" text="POS" />
                                <ui:Label class="trade-th trade-th-tipo" text="TIPO" />
                            </ui:VisualElement>
                            <ui:VisualElement name="TradeSuccessOtherPlayersBody" class="trade-table-body" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <!-- Bottom info bar -->
                <ui:VisualElement class="trade-info-bar">
                    <ui:VisualElement class="trade-info-item">
                        <ui:Label class="trade-info-icon" text="📅" />
                        <ui:VisualElement class="trade-info-text">
                            <ui:Label class="trade-info-label" text="FECHA DEL TRASPASO" />
                            <ui:Label name="TradeSuccessDate" class="trade-info-value" text="" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="trade-info-divider" />
                    <ui:VisualElement class="trade-info-item">
                        <ui:Label class="trade-info-icon" text="📋" />
                        <ui:VisualElement class="trade-info-text">
                            <ui:Label class="trade-info-label" text="TIPO DE TRASPASO" />
                            <ui:Label name="TradeSuccessType" class="trade-info-value" text="" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="trade-info-divider" />
                    <ui:VisualElement class="trade-info-item">
                        <ui:Label class="trade-info-icon" text="🤝" />
                        <ui:VisualElement class="trade-info-text">
                            <ui:Label class="trade-info-label" text="ESTADO" />
                            <ui:Label class="trade-info-status" text="✓ COMPLETADO" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <!-- Button -->
                <ui:VisualElement class="trade-actions">
                    <ui:Button name="BtnTradeSuccessClose" text="IR A PLANTILLA" class="trade-btn" />
                    <ui:Button name="BtnTradeSuccessCloseOnly" text="CERRAR" class="trade-btn" style="margin-left: 12px; background-color: rgba(100, 110, 130, 0.10); border-color: rgb(100, 110, 130); color: rgb(160, 170, 190);" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

        <!-- ══ MODAL CONFIGURACIÓN ══ -->
        <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigModalBox" class="modal-box">
                <ui:Label class="modal-title" text="CONFIGURACIÓN" />
                <ui:VisualElement class="modal-body">
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="AUDIO" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="Volumen General" />
                            <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="Música" />
                            <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="Efectos" />
                            <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="GRÁFICOS" />
                        <ui:VisualElement class="settings-quality-row">
                            <ui:Label class="settings-label" text="Calidad" />
                            <ui:VisualElement class="settings-quality-options">
                                <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="Baja" />
                                <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="Media" />
                                <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="Alta" />
                                <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="Ultra" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="JUEGO" />
                        <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="VOLVER AL MENÚ PRINCIPAL" />
                        <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="SALIR DEL JUEGO" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ConfigBtnCerrar" class="modal-close" text="CERRAR" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR VOLVER AL MENÚ PRINCIPAL ══ -->
        <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="VOLVER AL MENÚ PRINCIPAL" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="¿Estás seguro de que quieres volver al menú principal?" />
                    <ui:Label class="modal-paragraph" text="Se perderá el progreso no guardado de la partida actual. Asegúrate de haber guardado antes de continuar." />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="NO, QUEDARME" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="SÍ, VOLVER" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR SALIR DEL JUEGO ══ -->
        <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="SALIR DEL JUEGO" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="¿Estás seguro de que quieres salir del juego?" />
                    <ui:Label class="modal-paragraph" text="Tu progreso se guarda automáticamente durante la partida. Al volver a cargarla continuarás desde el último estado guardado." />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="NO" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="SÍ, SALIR" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

</ui:UXML>
