                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="{loc:ui.market.config_btn_main_menu_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
