<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Market.uss" />
    <Style src="../Dashboard/Dashboard.uss" />

    <ui:VisualElement name="MarketRoot" class="market-root">

        <!-- ══ SIDEBAR ══ -->
        <ui:VisualElement name="Sidebar" class="sidebar">
            <ui:VisualElement class="sidebar-logo">
                <ui:Label class="sidebar-logo-icon" text="TF" />
                <ui:Label class="sidebar-logo-text" text="TACTICAL" />
                <ui:Label class="sidebar-logo-text-gold" text="FIVE" />
            </ui:VisualElement>
            <ui:VisualElement class="sidebar-nav">
                <ui:Button name="NavDashboard" class="nav-item">
                    <ui:VisualElement name="NavDashboardIcon" class="nav-icon" />
                    <ui:Label class="nav-label" text="Inicio" />
                </ui:Button>
                <ui:Button name="NavRoster" class="nav-item">
                    <ui:VisualElement name="NavRosterIcon" class="nav-icon" />
                    <ui:Label class="nav-label" text="Plantilla" />
                    <ui:Label text="▼" class="nav-arrow" />
                </ui:Button>
                <ui:VisualElement name="RosterSubmenu" class="nav-submenu">
                    <ui:Button name="SubmenuJugadores" class="nav-submenu-item">
                        <ui:Label text="Jugadores" class="nav-submenu-label"/>
                    </ui:Button>
                    <ui:Button name="SubmenuQuinteto" class="nav-submenu-item">
                        <ui:Label text="Quinteto" class="nav-submenu-label"/>
                    </ui:Button>
                    <ui:Button name="SubmenuEntrenamiento" class="nav-submenu-item">
                        <ui:Label text="Entrenamiento" class="nav-submenu-label"/>
                    </ui:Button>
                    <ui:Button name="SubmenuEmpleados" class="nav-submenu-item">
                        <ui:Label text="Empleados" class="nav-submenu-label"/>
                    </ui:Button>
                    <ui:Button name="SubmenuLesionados" class="nav-submenu-item">
                        <ui:Label text="Lesionados" class="nav-submenu-label"/>
                    </ui:Button>
                                    <ui:Button name="SubmenuVestuario" class="nav-submenu-item">
                        <ui:Label text="Vestuario" class="nav-submenu-label"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:Button name="NavCalendar" class="nav-item">
                    <ui:VisualElement name="NavCalendarIcon" class="nav-icon" />
                    <ui:Label class="nav-label" text="Calendario" />
                </ui:Button>
                <ui:Button name="NavResults" class="nav-item">
                    <ui:VisualElement name="NavResultsIcon" class="nav-icon" />
                    <ui:Label class="nav-label" text="Resultados" />
                </ui:Button>
                <ui:Button name="NavStandings" class="nav-item">
                    <ui:VisualElement name="NavStandingsIcon" class="nav-icon" />
                    <ui:Label class="nav-label" text="Clasificación" />
                </ui:Button>
                <ui:Button name="NavPalmares" class="nav-item">
                    <ui:VisualElement name="NavPalmaresIcon" class="nav-icon" />
                    <ui:Label class="nav-label" text="Palmarés" />
                    <ui:Label text="▼" class="nav-arrow" />
                </ui:Button>
                <ui:VisualElement name="PalmaresSubmenu" class="nav-submenu">
                    <ui:Button name="SubmenuPalmares" class="nav-submenu-item">
                        <ui:Label text="Palmarés" class="nav-submenu-label"/>
                    </ui:Button>
                    <ui:Button name="SubmenuRecords" class="nav-submenu-item">
                        <ui:Label text="Records" class="nav-submenu-label"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:Button name="NavPlayoffs" class="nav-item">
                    <ui:VisualElement name="NavPlayoffsIcon" class="nav-icon" />
                    <ui:Label class="nav-label" text="Playoffs" />
                </ui:Button>
                <ui:Button name="NavStats" class="nav-item">
                    <ui:VisualElement name="NavStatsIcon" class="nav-icon" />
                    <ui:Label class="nav-label" text="Estadísticas" />
                </ui:Button>

                <ui:Button name="NavMarket" class="nav-item">
                    <ui:VisualElement name="NavMarketIcon" class="nav-icon" />
                    <ui:Label class="nav-label" text="Mercado" />
                    <ui:Label text="▼" class="nav-arrow" />
                </ui:Button>
                <ui:VisualElement name="MarketSubmenu" class="nav-submenu nav-submenu--visible">
                    <ui:Button name="SubmenuOfertas" class="nav-submenu-item nav-submenu-item--active">
                        <ui:Label text="Ofertas" class="nav-submenu-label"/>
                    </ui:Button>
                    <ui:Button name="SubmenuCartera" class="nav-submenu-item">
                        <ui:Label text="Cartera" class="nav-submenu-label"/>
                    </ui:Button>
                    <ui:Button name="SubmenuHistorial" class="nav-submenu-item">
                        <ui:Label text="Historial" class="nav-submenu-label"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:Button name="NavFinances" class="nav-item">
                    <ui:VisualElement name="NavFinancesIcon" class="nav-icon" />
                    <ui:Label class="nav-label" text="Finanzas" />
                    <ui:Label text="▼" class="nav-arrow" />
                </ui:Button>
                <ui:VisualElement name="FinanceSubmenu" class="nav-submenu">
                    <ui:Button name="SubmenuDecisiones" class="nav-submenu-item">
                        <ui:Label text="Decisiones" class="nav-submenu-label"/>
                    </ui:Button>
                    <ui:Button name="SubmenuPrestamos" class="nav-submenu-item">
                        <ui:Label text="Préstamos Bancarios" class="nav-submenu-label"/>
                    </ui:Button>
                    <ui:Button name="SubmenuSponsors" class="nav-submenu-item">
                        <ui:Label text="Patrocinadores" class="nav-submenu-label"/>
                    </ui:Button>
                    <ui:Button name="SubmenuTV" class="nav-submenu-item">
                        <ui:Label text="Televisión" class="nav-submenu-label"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:Button name="NavArena" class="nav-item">
                    <ui:VisualElement name="NavArenaIcon" class="nav-icon" />
                    <ui:Label class="nav-label" text="Pabellón" />
                </ui:Button>
                <ui:Button name="NavMessages" class="nav-item">
                    <ui:VisualElement name="NavMessagesIcon" class="nav-icon" />
                    <ui:Label class="nav-label" text="Mensajes" />
                </ui:Button>

            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="market-main">

            <!-- TOP HEADER -->
            <ui:VisualElement name="TopHeader" class="top-header">
                <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo" />
                <ui:VisualElement class="header-team-info">
                    <ui:Label name="HeaderTeamName"    class="header-team-name"    text="" />
                    <ui:Label name="HeaderManagerName" class="header-manager-name" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="PRESUPUESTO" />
                    <ui:Label name="HeaderBudget" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MASA SALARIAL" />
                    <ui:Label name="HeaderPayroll" class="header-stat-value header-stat-value--neutral" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MARGEN SALARIAL" />
                    <ui:Label name="HeaderMargin" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="QUÍMICA DE EQUIPO" />
                    <ui:Label name="HeaderChemistry" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-spacer" />
                <ui:VisualElement class="header-season-info">
                    <ui:Label name="HeaderSeason" class="header-season-label" text="" />
                    <ui:Label name="HeaderDate"   class="header-date-label"   text="" />
                </ui:VisualElement>
                <ui:Button name="BtnAction" class="btn-action" text="CONTINUAR" />
                <ui:VisualElement name="ConfigIcon" class="header-config-icon" />
            </ui:VisualElement>

            <!-- MARKET TITLE BOX -->
            <ui:VisualElement class="market-title-box">
                <ui:Label class="market-title-box-label" text="MERCADO DE JUGADORES" />
            </ui:VisualElement>

            <!-- MARKET CONTENT -->
            <ui:VisualElement class="market-content">

                <!-- ══ TEAM SELECTION ══ -->
                <ui:VisualElement class="market-section">
                    <ui:VisualElement class="market-section-title">
                        <ui:Label class="market-section-icon" text="🛒" />
                        <ui:Label class="market-section-title-text" text="SELECCIONA UN EQUIPO PARA NEGOCIAR" />
                    </ui:VisualElement>
                    <ui:VisualElement name="TeamGrid" class="market-team-grid" />
                </ui:VisualElement>

                    <!-- ══ NEGOTIATE BUTTON ══ -->
                    <ui:Button name="BtnNegotiate" class="market-btn-negotiate" style="display: none;">
                        <ui:Label class="market-btn-negotiate-icon" text="" />
                        <ui:Label name="NegotiateBtnText" class="market-btn-negotiate-text" text="NEGOCIAR" />
                    </ui:Button>

                    <!-- ══ TRADE PANELS ══ -->
                    <ui:VisualElement name="TradePanels" class="market-trade-panels" style="display: none;">
                        <ui:VisualElement class="market-trade-panels-grid">
                            <!-- My Team Panel -->
                            <ui:VisualElement class="market-trade-panel">
                                <ui:VisualElement class="market-trade-panel-header">
                                    <ui:VisualElement name="MyTeamLogo" class="market-trade-panel-logo" />
                                    <ui:Label name="MyTeamName" class="market-trade-panel-name" text="" />
                                </ui:VisualElement>
                                <ui:VisualElement name="MyTableHeader" class="market-table-header" />
                                <ui:ScrollView class="market-trade-panel-body"
                                               horizontal-scrolling-enabled="false"
                                               mode="Vertical">
                                    <ui:VisualElement name="MyTeamBody" class="market-trade-panel-content" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                            <!-- Other Team Panel -->
                            <ui:VisualElement class="market-trade-panel">
                                <ui:VisualElement class="market-trade-panel-header">
                                    <ui:VisualElement name="OtherTeamLogo" class="market-trade-panel-logo" />
                                    <ui:Label name="OtherTeamName" class="market-trade-panel-name" text="" />
                                </ui:VisualElement>
                                <ui:VisualElement name="OtherTableHeader" class="market-table-header" />
                                <ui:ScrollView class="market-trade-panel-body"
                                               horizontal-scrolling-enabled="false"
                                               mode="Vertical">
                                    <ui:VisualElement name="OtherTeamBody" class="market-trade-panel-content" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- ══ TRADE SUMMARY ══ -->
                        <ui:VisualElement class="market-trade-summary">
                            <ui:VisualElement class="market-summary-title">
                                <ui:Label class="market-summary-title-text" text="RESUMEN DE OFERTA" />
                            </ui:VisualElement>
                            <ui:VisualElement class="market-summary-grid">
                                <ui:VisualElement class="market-summary-col">
                                    <ui:Label name="SummaryMyTeamName" class="market-summary-team" text="" />
                                    <ui:VisualElement class="market-summary-row">
                                        <ui:Label class="market-summary-label" text="Jugadores después" />
                                        <ui:Label name="SummaryMyPlayerCount" class="market-summary-value" text="0" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="market-summary-row">
                                        <ui:Label class="market-summary-label" text="Margen salarial" />
                                        <ui:Label name="SummaryMySalaryMargin" class="market-summary-value market-summary-positive" text="$0" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="market-summary-row">
                                        <ui:Label class="market-summary-label" text="Salario enviado" />
                                        <ui:Label name="SummaryMySalaryOut" class="market-summary-value market-summary-negative" text="$0" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="market-summary-row">
                                        <ui:Label class="market-summary-label" text="Salario recibido" />
                                        <ui:Label name="SummaryMySalaryIn" class="market-summary-value market-summary-positive" text="$0" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="market-summary-col">
                                    <ui:Label name="SummaryOtherTeamName" class="market-summary-team" text="" />
                                    <ui:VisualElement class="market-summary-row">
                                        <ui:Label class="market-summary-label" text="Jugadores después" />
                                        <ui:Label name="SummaryOtherPlayerCount" class="market-summary-value" text="0" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="market-summary-row">
                                        <ui:Label class="market-summary-label" text="Margen salarial" />
                                        <ui:Label name="SummaryOtherSalaryMargin" class="market-summary-value market-summary-positive" text="$0" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="market-summary-row">
                                        <ui:Label class="market-summary-label" text="Salario enviado" />
                                        <ui:Label name="SummaryOtherSalaryOut" class="market-summary-value market-summary-negative" text="$0" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="market-summary-row">
                                        <ui:Label class="market-summary-label" text="Salario recibido" />
                                        <ui:Label name="SummaryOtherSalaryIn" class="market-summary-value market-summary-positive" text="$0" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="TradeStatus" class="market-trade-status" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ══ FREE AGENTS PANEL ══ -->
                    <ui:VisualElement name="FreeAgentsPanel" class="market-fa-panel" style="display: none;">
                        <ui:VisualElement class="market-fa-panel-inner">
                            <ui:VisualElement class="market-fa-panel-header">
                                <ui:Label class="market-fa-panel-name" text="AGENTES LIBRES" />
                            </ui:VisualElement>
                            <ui:VisualElement name="FreeAgentsTableHeader" class="market-table-header" />
                            <ui:ScrollView class="market-fa-body"
                                           horizontal-scrolling-enabled="false"
                                           mode="Vertical">
                                <ui:VisualElement name="FreeAgentsBody" class="market-fa-content" />
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ══ TRANSFER WINDOW CLOSED OVERLAY ══ -->
                    <ui:VisualElement name="MarketClosedOverlay" class="market-closed-overlay" style="display: none;">
                        <ui:VisualElement class="market-closed-overlay-box">
                            <ui:Label class="market-closed-overlay-icon" text="🚫" />
                            <ui:Label class="market-closed-overlay-title" text="PERIODO DE TRASPASOS FINALIZADO" />
                            <ui:Label class="market-closed-overlay-text" text="El plazo de traspasos ha finalizado. No puedes realizar operaciones hasta la próxima temporada." />
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>

        </ui:VisualElement>

        <!-- ══ MODALS ══ -->
        <!-- FA Roster Full Modal -->
        <ui:VisualElement name="FARosterFullModal" class="renew-modal-overlay" style="display: none;">
            <ui:VisualElement class="renew-modal-box renew-modal-box--negative">
                <ui:VisualElement name="FARosterFullIcon" class="renew-modal-icon"/>
                <ui:Label class="renew-modal-title renew-modal-title--negative" text="PLANTILLA COMPLETA" />
                <ui:Label name="FARosterFullText" class="renew-modal-text" text="" />
                <ui:Label class="renew-modal-text" text="Debes liberar plazas antes de poder fichar." />
                <ui:VisualElement class="renew-modal-buttons">
                    <ui:Button name="BtnCloseFARosterFull" class="btn-modal-danger" text="ENTENDIDO" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- FA Confirm Modal -->
        <!-- ══ MODAL OFERTA AGENTE LIBRE ══ -->
        <ui:VisualElement name="FAConfirmModal" class="renew-modal-overlay">
            <ui:VisualElement name="FABox" class="renew-modal-box">
                <ui:VisualElement name="FAIcon" class="renew-modal-icon"/>
                <ui:Label name="FATitle" class="renew-modal-title" text="OFERTA DE CONTRATO" />
                <ui:Label name="FAText1" class="renew-modal-text" text="" />
                <ui:VisualElement name="FAFormRowSalary" class="renew-form-row">
                    <ui:Label class="renew-form-label" text="SALARIO ($)" />
                    <ui:VisualElement class="renew-spinner-row">
                        <ui:Label name="FASalaryDec" class="btn-spin" text="◀" />
                        <ui:Label name="FASalaryValue" class="renew-spin-label" text="" />
                        <ui:Label name="FASalaryInc" class="btn-spin" text="▶" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="FAFormRowYears" class="renew-form-row">
                    <ui:Label class="renew-form-label" text="DURACIÓN (años)" />
                    <ui:VisualElement class="renew-spinner-row">
                        <ui:Label name="FAYearsDec" class="btn-spin" text="◀" />
                        <ui:Label name="FAYearsValue" class="renew-spin-label" text="" />
                        <ui:Label name="FAYearsInc" class="btn-spin" text="▶" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="FAText2" class="renew-modal-text" text="" />
                <ui:Label name="FAWarningText" class="renew-modal-text renew-modal-text--warning" style="display: none;" text="" />
                <ui:Label name="FAMaxInfo" class="renew-modal-text renew-modal-text--info" style="display: none;" text="" />
                <ui:Label name="FAPendingText" class="renew-modal-text renew-modal-text--pending" style="display: none;" text="OFERTA ENVIADA. Recibirás la respuesta en tu Dashboard en 7 días." />
                <ui:VisualElement class="renew-modal-buttons">
                    <ui:Button name="BtnCancelFA" class="btn-modal-cancel" text="CERRAR" />
                    <ui:Button name="BtnConfirmFA" class="btn-modal-confirm" text="ENVIAR OFERTA" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Trade Success Modal -->
        <ui:VisualElement name="TradeSuccessOverlay" class="renew-modal-overlay">
            <ui:VisualElement name="TradeSuccessBox" class="renew-modal-box renew-modal-box--positive">
                <ui:VisualElement name="TradeSuccessIcon" class="renew-modal-icon" />
                <ui:Label name="TradeSuccessTitle" class="renew-modal-title renew-modal-title--positive" text="¡TRASPASO REALIZADO!" />
                <ui:Label name="TradeSuccessText1" class="renew-modal-text" text="" />
                <ui:Label name="TradeSuccessText2" class="renew-modal-text" text="" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
