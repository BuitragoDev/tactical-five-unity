/* ══════════════════════════════════════════
   MARKET — Market.uss
   ══════════════════════════════════════════ */

.market-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.market-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.market-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 20px;
    min-height: 0;
}

.market-tabs {
    flex-direction: row;
    margin-bottom: 16px;
    flex-shrink: 0;
}

.market-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 13px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 24px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-right: 4px;
}

.market-tab:hover {
    color: rgb(208, 216, 232);
}

.market-tab--active {
    background-color: rgb(28, 33, 48);
    border-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
}

.market-panel {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
}

.market-scroll {
    flex-grow: 1;
    min-height: 0;
}

.market-body {
    flex-direction: column;
}

.market-player-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 16px;
    background-color: rgb(22, 26, 36);
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}

.market-player-row:hover {
    background-color: rgb(28, 33, 48);
}

.market-player-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 12px;
    color: rgb(255, 255, 255);
    background-color: rgb(42, 95, 201);
    padding: 2px 8px;
    margin-right: 10px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    width: 36px;
}

.market-player-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
    -unity-text-transform: upper;
}

.market-player-ovr {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    color: rgb(255, 255, 255);
    width: 36px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.market-player-meta {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 12px;
    color: rgb(85, 102, 119);
    width: 100px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

.market-player-salary {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 13px;
    color: rgb(39, 174, 96);
    width: 80px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

.market-player-action {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 12px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    padding: 6px 16px;
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-left: 12px;
}

.market-player-action:hover {
    background-color: rgb(74, 128, 240);
}

.no-data-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(58, 74, 99);
    -unity-text-align: middle-center;
    padding: 48px;
}
