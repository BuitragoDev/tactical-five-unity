/* ══════════════════════════════════════════
   MARKET — Market.uss
   ══════════════════════════════════════════ */

.market-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.market-title-box {
    flex-direction: row;
    align-items: center;
    margin: 16px 24px 0;
    padding: 10px 18px;
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    background-color: rgba(42, 95, 201, 0.08);
}
.market-title-box-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 3px;
    color: rgb(208, 216, 232);
    text-transform: uppercase;
}

.market-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.market-content {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    padding: 24px 28px;
    gap: 16px;
}

/* ── SECTIONS ── */
.market-section {
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
}

.market-section-title {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 14px 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    background-color: rgba(212, 160, 23, 0.04);
}

.market-section-icon {
    font-size: 20px;
}

.market-section-title-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 1.5px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
}

/* ── TEAM GRID ── */
.market-team-grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
    padding: 16px 20px;
}

.market-team-chip {
    width: 80px;
    height: 80px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 6px;
    padding: 8px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}

.market-team-chip:hover {
    border-color: rgb(58, 74, 99);
    background-color: rgb(30, 37, 53);
}

.market-team-chip.active {
    border-color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.08);
}

.market-team-chip-logo {
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
}

.market-team-chip-fa {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 20px;
    font-weight: 700;
    -unity-text-align: middle-center;
}

/* ── NEGOTIATE BUTTON ── */
.market-btn-negotiate {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 14px;
    border-radius: 6px;
    cursor: pointer;
    flex-shrink: 0;
    margin-top: 12px;
}

.market-btn-negotiate:hover {
    background-color: rgb(74, 128, 240);
}

.market-btn-negotiate-icon {
    font-size: 20px;
}

.market-btn-negotiate-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
}

/* ── TRADE PANELS ── */
.market-trade-panels {
    flex-direction: column;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    overflow: visible;
    flex-shrink: 0;
    margin-top: 12px;
}

.market-trade-panels-grid {
    flex-direction: row;
    flex-shrink: 0;
}

.market-trade-panel {
    flex: 1;
    border-right-width: 1px;
    border-right-color: rgb(42, 51, 71);
    flex-direction: column;
    overflow: hidden;
    height: 246px;
    min-height: 0;
}

.market-trade-panel:last-child {
    border-right-width: 0;
}

.market-trade-panel-header {
    flex-direction: row;
    align-items: center;
    padding: 12px 16px;
    background-color: rgba(212, 160, 23, 0.04);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

.market-trade-panel-logo {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
    margin-right: 16px;
}

.market-trade-panel-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
}

.market-trade-panel-body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}

.market-trade-panel-content {
    flex-direction: column;
}

.market-fa-panel {
    width: 50%;
    align-self: flex-start;
    min-height: 0;
    margin-top: 16px;
}

.market-fa-panel-inner {
    flex-grow: 1;
    min-height: 0;
    flex-direction: column;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    overflow: hidden;
    position: relative;
}

.market-fa-panel-header {
    flex-direction: row;
    align-items: center;
    padding: 14px 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

.market-fa-panel-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 1.5px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
}

.market-fa-body {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}

.market-fa-content {
    flex-direction: column;
}

/* ── TRADE TABLE ── */
.market-trade-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 51, 71, 0.3);
    min-height: 30px;
}

.market-trade-row:hover {
    background-color: rgba(255, 255, 255, 0.03);
}

.market-trade-row.selected {
    background-color: rgba(212, 160, 23, 0.06);
}

.market-trade-col-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
    -unity-text-transform: upper;
    align-self: center;
}

.market-trade-col-pos {
    width: 40px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    font-weight: 600;
    color: rgb(122, 138, 170);
    align-self: center;
}

.market-trade-col-ovr {
    width: 40px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    font-weight: 700;
    color: rgb(212, 160, 23);
    align-self: center;
}

.market-trade-col-salary {
    width: 100px;
    -unity-text-align: middle-right;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    font-weight: 500;
    color: rgb(208, 216, 232);
    align-self: center;
}

/* ── TRADE SUMMARY ── */
.market-trade-summary {
    padding: 16px 20px;
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
    background-color: rgba(0, 0, 0, 0.15);
    flex-shrink: 0;
}

.market-summary-title {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.market-summary-title-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 1.5px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
}

.market-summary-grid {
    flex-direction: row;
    margin-bottom: 16px;
}

.market-summary-grid > .market-summary-col:first-child {
    margin-right: 20px;
}

.market-summary-col {
    flex: 1;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 6px;
    padding: 12px 16px;
    color: rgb(212, 160, 23);
}

.market-summary-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
}

.market-summary-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 4px 0;
}

.market-summary-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 16px;
    font-weight: 600;
    color: rgb(255, 255, 255);
    flex-shrink: 0;
    min-width: 140px;
    min-height: 20px;
    margin-right: 8px;
    -unity-text-align: middle-left;
    overflow: visible;
}

.market-summary-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    font-weight: 600;
    color: rgb(255, 255, 255);
    flex-shrink: 0;
    -unity-text-align: middle-right;
    min-width: 80px;
}

.market-summary-positive {
    color: rgb(39, 174, 96);
}

.market-summary-negative {
    color: rgb(192, 57, 43);
}

/* ── TRADE STATUS ── */
.market-trade-status {
    margin-top: 12px;
}

.market-trade-status-box {
    flex-direction: row;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 6px;
}

.market-trade-status-box.invalid {
    background-color: rgba(192, 57, 43, 0.1);
    border-width: 1px;
    border-color: rgba(192, 57, 43, 0.3);
}

.market-trade-status-box.valid {
    background-color: rgba(39, 174, 96, 0.1);
    border-width: 1px;
    border-color: rgba(39, 174, 96, 0.3);
}

.market-trade-status-box.rejected {
    background-color: rgba(230, 126, 34, 0.1);
    border-width: 1px;
    border-color: rgba(230, 126, 34, 0.3);
}

.market-trade-status-icon {
    font-size: 24px;
    flex-shrink: 0;
    margin-top: 2px;
}

.market-trade-status-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    color: rgb(255, 255, 255);
    font-weight: 600;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    display: block;
}

.market-trade-status-errors {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    margin-top: 6px;
    font-size: 16px;
    color: rgb(122, 138, 170);
    flex-direction: column;
}

.market-trade-status-score {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 13px;
    color: rgb(122, 138, 170);
    margin-top: 4px;
}

.market-btn-confirm-trade {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    background-color: rgb(39, 174, 96);
    border-width: 0;
    color: rgb(255, 255, 255);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1.5px;
    -unity-text-transform: upper;
    padding: 12px;
    border-radius: 4px;
    cursor: pointer;
    margin-top: 12px;
}

.market-btn-confirm-trade:hover {
    background-color: rgb(46, 204, 113);
}

/* Sign & Trade toggle */
.market-btn-sat-toggle {
    flex-direction: row;
    align-items: center;
    padding: 6px 12px;
    border-width: 1px;
    border-color: rgb(200, 160, 30);
    border-radius: 4px;
    cursor: pointer;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 13px;
    color: rgb(200, 160, 30);
    background-color: rgba(200, 160, 30, 0.1);
    white-space: normal;
}
.market-btn-sat-toggle:hover {
    background-color: rgba(200, 160, 30, 0.25);
}

/* ── FREE AGENTS ── */
.market-fa-row {
    flex-direction: row;
    align-items: center;
    padding: 16px 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 51, 71, 0.3);
}

.market-fa-row:hover {
    background-color: rgba(255, 255, 255, 0.03);
}

.market-fa-col-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
    -unity-text-transform: upper;
    align-self: center;
    -unity-text-align: middle-left;
}

.market-fa-col-pos {
    width: 40px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    font-weight: 600;
    color: rgb(122, 138, 170);
}

.market-fa-col-ovr {
    width: 40px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    font-weight: 700;
    color: rgb(212, 160, 23);
}

.market-fa-col-salary {
    width: 100px;
    -unity-text-align: middle-right;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    font-weight: 500;
    color: rgb(208, 216, 232);
}

.market-fa-col-action {
    width: 120px;
    -unity-text-align: middle-center;
}

.market-btn-fa-sign {
    background-color: rgb(39, 174, 96);
    border-width: 0;
    color: rgb(255, 255, 255);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    padding: 11px 16px;
    border-radius: 4px;
    cursor: pointer;
    min-height: 24px;
    margin-left: 10px;
}

.market-btn-fa-sign:hover {
    background-color: rgb(46, 204, 113);
}

.market-btn-fa-sign:disabled {
    background-color: rgb(100, 100, 100);
    cursor: default;
    opacity: 0.85;
}

.market-empty-fa {
    padding: 40px 20px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
}

/* ── MODALS ── */
.market-modal {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 1000;
    align-items: center;
    justify-content: center;
}

.market-modal-content {
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    width: 520px;
}

.market-modal-header {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 16px 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
}

.market-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 1px;
    -unity-text-transform: upper;
}

.market-modal-body {
    padding: 32px;
    flex-direction: column;
    align-items: center;
}

.market-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    line-height: 1.6;
    margin-bottom: 10px;
}

.market-modal-text:last-child {
    margin-bottom: 0;
}

.market-modal-highlight {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 24px;
    color: rgb(212, 160, 23);
    font-weight: 700;
    margin-bottom: 10px;
}

.market-modal-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 12px;
}

.market-modal-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    width: 120px;
    flex-shrink: 0;
}

.market-modal-footer {
    flex-direction: row;
    gap: 10px;
    padding: 16px 20px;
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
    justify-content: flex-end;
}

.btn-modal-cancel {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    background-color: rgb(30, 37, 53);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    color: rgb(122, 138, 170);
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 10px 24px;
    margin-right: 10px;
    -unity-text-align: middle-center;
}
.btn-modal-cancel:hover {
    border-color: rgb(122, 138, 170);
    color: rgb(208, 216, 232);
}
.btn-modal-confirm {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    background-color: rgb(23, 110, 59);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 10px 24px;
    -unity-text-align: middle-center;
}
.btn-modal-confirm:hover {
    background-color: rgb(39, 174, 96);
}

.btn-modal-danger {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    background-color: rgb(155, 30, 30);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 10px 24px;
    -unity-text-align: middle-center;
}
.btn-modal-danger:hover {
    background-color: rgb(192, 57, 43);
}

/* ── TRANSFER WINDOW CLOSED ── */
.market-closed-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    z-index: 500;
}
.market-closed-overlay-box {
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 40px;
}
.market-closed-overlay-icon {
    width: 64px;
    height: 64px;
    font-size: 48px;
    -unity-text-align: middle-center;
    color: rgb(192, 57, 43);
}
.market-closed-overlay-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 28px;
    letter-spacing: 2px;
    color: rgb(192, 57, 43);
    -unity-text-transform: upper;
    -unity-text-align: middle-center;
}
.market-closed-overlay-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    max-width: 500px;
}

/* ── TABLE HEADERS ── */
.market-table-header {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    background-color: rgb(28, 33, 48);
    min-height: 40px;
    flex-shrink: 0;
}

.market-table-header-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(122, 138, 170);
}

.market-table-header-spacer {
    width: 18px;
    margin-right: 12px;
}

.market-table-header-name {
    flex-grow: 1;
}

.market-table-header-pos {
    width: 40px;
    -unity-text-align: middle-center;
}

.market-table-header-ovr {
    width: 40px;
    -unity-text-align: middle-center;
}

.market-table-header-salary {
    width: 100px;
    -unity-text-align: middle-right;
}

.market-table-header-action {
    width: 120px;
    -unity-text-align: middle-center;
}

.market-fa-panel-inner > .market-table-header {
    padding-left: 20px;
    padding-right: 20px;
}

/* ── TRADE SUCCESS MODAL (copied from Roster renew modal) ── */
.renew-modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0.95;
    align-items: center;
    justify-content: center;
    display: none;
}
.renew-modal-overlay--visible {
    display: flex;
}
.renew-modal-box {
    position: absolute;
    width: 520px;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-top-width: 3px;
    border-top-color: rgb(39, 174, 96);
    padding: 32px;
    flex-direction: column;
    align-items: center;
}
.renew-modal-box--positive {
    border-top-color: rgb(39, 174, 96);
}
.renew-modal-box--negative {
    border-top-color: rgb(192, 57, 43);
}
.renew-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}
.renew-modal-title--positive {
    color: rgb(39, 174, 96);
}
.renew-modal-title--negative {
    color: rgb(192, 57, 43);
}
.renew-modal-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-to-fit;
}
.renew-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    margin-top: 8px;
    margin-bottom: 18px;
    -unity-text-align: middle-center;
}
.renew-modal-text--warning {
    color: rgb(212, 160, 23);
    font-size: 18px;
    margin-top: 4px;
    -unity-text-align: middle-center;
}
.renew-modal-text--info {
    color: rgb(122, 138, 170);
    font-size: 18px;
    margin-top: 6px;
    -unity-text-align: middle-center;
}
.renew-modal-text--pending {
    color: rgb(212, 160, 23);
    font-size: 20px;
    margin-top: 8px;
}
.renew-modal-buttons {
    flex-direction: row;
    margin-top: 24px;
    gap: 12px;
}
.renew-form-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 12px;
}
.renew-form-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    width: 120px;
    flex-shrink: 0;
}
.renew-form-field {
    flex-grow: 1;
    height: 36px;
    font-size: 18px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    color: rgb(208, 216, 232);
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    padding: 4px 8px;
    -unity-text-align: middle-left;
}

/* ── Spinner (increment/decrement buttons + label) ── */
.renew-spinner-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    margin-left: 8px;
}

.renew-spin-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    flex-grow: 1;
    padding: 0 4px;
}

.btn-spin {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 20px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    width: 36px;
    height: 36px;
    background-color: rgb(42, 51, 71);
    flex-shrink: 0;
    border-width: 0;
    padding: 0;
}

.btn-spin:hover {
    background-color: rgb(58, 74, 99);
}

.btn-spin--disabled {
    background-color: rgb(30, 34, 46);
    color: rgb(80, 90, 110);
}

.market-trade-picks-section {
    border-top-width: 1px;
    border-top-color: rgb(58, 74, 99);
    padding-top: 6px;
    margin-top: 4px;
}

.market-trade-columns {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.market-trade-col-players {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    min-width: 0;
}

.market-trade-col-picks {
    width: 230px;
    flex-shrink: 0;
    flex-direction: column;
    border-left-width: 1px;
    border-left-color: rgb(58, 74, 99);
    margin-left: 6px;
    padding-left: 6px;
    min-height: 0;
}

.market-trade-picks-header {
    height: 40px;
    justify-content: center;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 74, 99);
    margin-bottom: 4px;
}

.market-trade-picks-scroll {
    flex-grow: 1;
    min-height: 0;
}

.market-trade-picks-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    color: rgb(160, 174, 192);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.market-trade-picks-content {
    flex-direction: column;
}

.market-pick-row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(30, 34, 46);
    border-radius: 4px;
    padding: 4px 8px;
    margin: 2px 0;
    height: 28px;
}

.market-pick-row:hover {
    background-color: rgb(45, 52, 70);
}

.market-pick-row.selected {
    background-color: rgb(39, 174, 96);
}

.market-pick-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    color: rgb(236, 240, 241);
    font-size: 18px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.market-pick-round {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    color: rgb(241, 196, 15);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    width: 24px;
}
