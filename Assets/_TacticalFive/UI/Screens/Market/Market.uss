/* ══════════════════════════════════════════
   MARKET — Market.uss
   ══════════════════════════════════════════ */

.market-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.market-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.market-content {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    padding: 24px 28px;
    gap: 16px;
}

/* ── SECTIONS ── */
.market-section {
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
}

.market-section-title {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 6px 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    background-color: rgb(42, 95, 201);
}

.market-section-icon {
    font-size: 20px;
}

.market-section-title-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1.5px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
}

/* ── TEAM GRID ── */
.market-team-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 16px 20px;
}

.market-team-chip {
    width: 80px;
    height: 80px;
    margin: 6px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 6px;
    padding: 8px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}

.market-team-chip:hover {
    border-color: rgb(58, 74, 99);
    background-color: rgb(30, 37, 53);
}

.market-team-chip.active {
    border-color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.08);
}

.market-team-chip-logo {
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ── NEGOTIATE BUTTON ── */
.market-btn-negotiate {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    background-color: rgba(42, 95, 201, 0.10);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(100, 150, 230);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 14px 20px;
    border-radius: 8px;
    cursor: pointer;
    flex-shrink: 0;
    margin-top: 12px;
}

.market-btn-negotiate:hover {
    background-color: rgba(42, 95, 201, 0.25);
    border-color: rgb(74, 128, 240);
    color: rgb(150, 190, 255);
}

.market-btn-negotiate-icon {
    display: none;
}

.market-btn-negotiate-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(100, 150, 230);
}

.market-btn-negotiate:hover .market-btn-negotiate-text {
    color: rgb(150, 190, 255);
}

/* ── TRADE PANELS ── */
.market-trade-panels {
    flex-direction: column;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    overflow: visible;
    flex-shrink: 0;
    margin-top: 12px;
}

.market-trade-panels-grid {
    flex-direction: row;
    flex-shrink: 0;
}

.market-trade-panel {
    flex: 1;
    border-right-width: 1px;
    border-right-color: rgb(42, 51, 71);
    flex-direction: column;
    overflow: hidden;
    height: 366px;
    min-height: 0;
}

.market-trade-panel-header {
    flex-direction: row;
    align-items: center;
    padding: 6px 16px;
    background-color: rgb(16, 56, 92);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

.market-trade-panel-logo {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
    margin-right: 16px;
}

.market-trade-panel-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
}

.market-trade-panel-body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}

.market-trade-panel-content {
    flex-direction: column;
}

.market-fa-panel {
    width: 50%;
    flex-grow: 1;
    min-height: 0;
    margin-top: 16px;
}

.market-fa-panel-inner {
    flex-grow: 1;
    min-height: 0;
    flex-direction: column;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    overflow: hidden;
    position: relative;
}

.market-fa-panel-header {
    flex-direction: row;
    align-items: center;
    padding: 14px 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

.market-fa-panel-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 1.5px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
}

.market-fa-body {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}

.market-fa-content {
    flex-direction: column;
    flex-grow: 1;
    align-content: flex-start;
    min-height: 0;
    overflow: hidden;
}

/* ── TRADE TABLE ── */
.market-trade-row {
    flex-direction: row;
    align-items: center;
    padding: 18px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 51, 71, 0.3);
    min-height: 40px;
}

.market-trade-row:hover {
    background-color: rgba(255, 255, 255, 0.03);
}

.market-trade-row.selected {
    background-color: rgb(16, 56, 92);
}

.market-trade-sat-section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 13px;
    color: rgb(200, 160, 30);
    padding: 8px 10px 2px 10px;
    background-color: rgba(200, 160, 30, 0.08);
    border-top-width: 1px;
    border-top-color: rgba(200, 160, 30, 0.4);
}

.market-trade-col-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
    align-self: center;
    -unity-text-align: middle-left;
}

.market-trade-col-pos {
    width: 40px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    font-weight: 600;
    color: rgb(122, 138, 170);
    align-self: center;
}

.market-trade-col-ovr {
    width: 40px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    font-weight: 700;
    color: rgb(255, 255, 255);
    align-self: center;
}
.market-trade-col-ovr--high {
    color: rgb(39, 174, 96);
}
.market-trade-col-ovr--mid {
    color: rgb(212, 160, 23);
}
.market-trade-col-ovr--low {
    color: rgb(192, 57, 43);
}

.market-trade-col-salary {
    width: 100px;
    -unity-text-align: middle-right;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    font-weight: 500;
    color: rgb(208, 216, 232);
    align-self: center;
}

.market-trade-col-restantes {
    width: 70px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    font-weight: 500;
    color: rgb(208, 216, 232);
    align-self: center;
}

/* ── TRADE SUMMARY ── */
.market-trade-summary {
    padding: 16px 20px;
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
    background-color: rgba(0, 0, 0, 0.15);
    flex-shrink: 0;
}

.market-summary-title {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.market-summary-title-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 1.5px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
}

.market-summary-grid {
    flex-direction: row;
    margin-bottom: 16px;
}

.market-summary-grid .market-summary-col {
    flex: 1;
    min-width: 0;
    margin-right: 12px;
}

.market-summary-grid .market-summary-col:last-child {
    margin-right: 0;
}

.market-summary-col {
    flex: 1;
    min-width: 0;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 6px;
    padding: 12px 16px;
    color: rgb(212, 160, 23);
}

.market-summary-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
}

.market-summary-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 4px 0;
}

.market-summary-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    font-weight: 600;
    color: rgb(255, 255, 255);
    flex-shrink: 0;
    min-width: 140px;
    min-height: 20px;
    margin-right: 8px;
    -unity-text-align: middle-left;
    overflow: visible;
}

.market-summary-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    font-weight: 600;
    color: rgb(255, 255, 255);
    flex-shrink: 0;
    -unity-text-align: middle-right;
    min-width: 80px;
}

.market-summary-positive {
    color: rgb(39, 174, 96);
}

.market-summary-negative {
    color: rgb(192, 57, 43);
}

/* ── TRADE STATUS ── */
.market-trade-status {
    margin-top: 12px;
    flex-grow: 1;
}

.market-trade-status-box {
    flex-direction: row;
    align-items: flex-start;
    gap: 12px;
    padding: 8px 16px;
    border-radius: 6px;
    flex-grow: 1;
}

.market-trade-status-box.invalid {
    background-color: rgba(192, 57, 43, 0.1);
    border-width: 1px;
    border-color: rgba(192, 57, 43, 0.3);
}

.market-trade-status-box.valid {
    background-color: rgba(39, 174, 96, 0.1);
    border-width: 1px;
    border-color: rgba(39, 174, 96, 0.3);
}

.market-trade-status-box.rejected {
    background-color: rgba(230, 126, 34, 0.1);
    border-width: 1px;
    border-color: rgba(230, 126, 34, 0.3);
}

.market-trade-status-icon {
    font-size: 24px;
    flex-shrink: 0;
    margin-top: 2px;
}

.market-trade-status-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(255, 255, 255);
    font-weight: 600;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    display: block;
}

.market-trade-status-errors {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    margin-top: 6px;
    font-size: 16px;
    color: rgb(122, 138, 170);
    flex-direction: column;
}

.market-trade-status-score {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 13px;
    color: rgb(122, 138, 170);
    margin-top: 4px;
}

.market-btn-confirm-trade {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    background-color: rgb(39, 174, 96);
    border-width: 0;
    color: rgb(255, 255, 255);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 1.5px;
    -unity-text-transform: upper;
    padding: 6px;
    border-radius: 4px;
    cursor: pointer;
    margin-top: 12px;
    -unity-text-align: middle-center;
}

.market-btn-confirm-trade:hover {
    background-color: rgb(46, 204, 113);
}

/* Sign & Trade toggle */
.market-btn-sat-toggle {
    flex-direction: row;
    align-items: center;
    padding: 8px 20px;
    border-width: 1px;
    border-color: rgb(200, 160, 30);
    border-radius: 4px;
    cursor: pointer;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    color: rgb(200, 160, 30);
    background-color: rgba(200, 160, 30, 0.1);
    white-space: nowrap;
    flex-shrink: 0;
}
.market-btn-sat-toggle:hover {
    background-color: rgba(200, 160, 30, 0.25);
}

/* ── FREE AGENTS ── */
.market-fa-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 51, 71, 0.3);
    height: 48px;
    min-height: 48px;
    max-height: 48px;
    flex-grow: 0;
    flex-shrink: 0;
}

.market-fa-row:hover {
    background-color: rgba(255, 255, 255, 0.03);
}

.market-fa-col-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
    -unity-text-transform: upper;
    align-self: center;
    -unity-text-align: middle-left;
}

.market-fa-col-pos {
    width: 40px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    font-weight: 600;
    color: rgb(122, 138, 170);
}

.market-fa-col-ovr {
    width: 40px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    font-weight: 700;
    color: rgb(255, 255, 255);
}
.market-fa-col-ovr--high {
    color: rgb(39, 174, 96);
}
.market-fa-col-ovr--mid {
    color: rgb(212, 160, 23);
}
.market-fa-col-ovr--low {
    color: rgb(192, 57, 43);
}

.market-fa-col-salary {
    width: 100px;
    -unity-text-align: middle-right;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    font-weight: 500;
    color: rgb(208, 216, 232);
}

.market-fa-col-action {
    width: 220px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    -unity-text-align: middle-center;
}

.market-fa-col-photo {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    margin-right: 12px;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
}

.market-btn-fa-sign {
    background-color: rgba(39, 174, 96, 0.10);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    color: rgb(100, 200, 140);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    padding: 8px 14px;
    border-radius: 6px;
    cursor: pointer;
    min-height: 24px;
}

.market-btn-fa-sign:hover {
    background-color: rgba(39, 174, 96, 0.25);
    color: rgb(150, 220, 180);
}

.market-btn-fa-sign:disabled {
    background-color: rgba(100, 110, 130, 0.10);
    border-color: rgb(100, 110, 130);
    color: rgb(120, 130, 150);
    cursor: default;
    opacity: 0.7;
}

.market-btn-fa-profile {
    background-color: rgba(42, 95, 201, 0.10);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(100, 150, 230);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    padding: 8px 14px;
    border-radius: 6px;
    cursor: pointer;
    min-height: 24px;
    margin-left: 6px;
}

.market-btn-fa-profile:hover {
    background-color: rgba(42, 95, 201, 0.25);
    color: rgb(150, 190, 255);
}

.market-empty-fa {
    padding: 40px 20px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
}

/* ── MODALS ── */
.market-modal {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 1000;
    align-items: center;
    justify-content: center;
}

.market-modal-content {
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    width: 520px;
}

.market-modal-header {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 16px 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
}

.market-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 1px;
    -unity-text-transform: upper;
}

.market-modal-body {
    padding: 32px;
    flex-direction: column;
    align-items: center;
}

.market-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    line-height: 1.6;
    margin-bottom: 10px;
}

.market-modal-highlight {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(212, 160, 23);
    font-weight: 700;
    margin-bottom: 10px;
}

.market-modal-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 12px;
}

.market-modal-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    width: 120px;
    flex-shrink: 0;
}

.market-modal-footer {
    flex-direction: row;
    gap: 10px;
    padding: 16px 20px;
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
    justify-content: flex-end;
}

.btn-modal-cancel {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(30, 37, 53);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    color: rgb(122, 138, 170);
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 10px 24px;
    margin-right: 10px;
    -unity-text-align: middle-center;
}
.btn-modal-cancel:hover {
    border-color: rgb(122, 138, 170);
    color: rgb(208, 216, 232);
}
.btn-modal-confirm {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(23, 110, 59);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 10px 24px;
    -unity-text-align: middle-center;
}
.btn-modal-confirm:hover {
    background-color: rgb(39, 174, 96);
}

.btn-modal-danger {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(155, 30, 30);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 10px 24px;
    -unity-text-align: middle-center;
}
.btn-modal-danger:hover {
    background-color: rgb(192, 57, 43);
}

/* ── DEADLINE COUNTDOWN ── */
.market-deadline-countdown-bar {
    padding: 10px 24px;
    background-color: rgb(212, 160, 23);
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    border-radius: 4px;
}
.market-deadline-countdown-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: rgb(0, 0, 0);
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

/* ── TRANSFER WINDOW CLOSED ── */
.market-closed-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    z-index: 500;
}
.market-closed-overlay-box {
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 40px;
}
.market-closed-overlay-icon {
    width: 64px;
    height: 64px;
    font-size: 48px;
    -unity-text-align: middle-center;
    color: rgb(192, 57, 43);
}
.market-closed-overlay-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 28px;
    letter-spacing: 2px;
    color: rgb(192, 57, 43);
    -unity-text-transform: upper;
    -unity-text-align: middle-center;
}
.market-closed-overlay-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    max-width: 500px;
}

/* ── TABLE HEADERS ── */
.market-table-header {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    background-color: rgb(28, 33, 48);
    min-height: 40px;
    flex-shrink: 0;
}

.market-table-header-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(122, 138, 170);
}

.market-table-header-spacer {
    width: 18px;
    margin-right: 12px;
}

.market-table-header-name {
    flex-grow: 1;
}

.market-table-header-pos {
    width: 40px;
    -unity-text-align: middle-center;
}

.market-table-header-ovr {
    width: 40px;
    -unity-text-align: middle-center;
}

.market-table-header-salary {
    width: 100px;
    -unity-text-align: middle-right;
}

.market-table-header-restantes {
    width: 70px;
    -unity-text-align: middle-center;
}

.market-table-header-action {
    width: 220px;
    -unity-text-align: middle-center;
}

.market-fa-panel-inner > .market-table-header {
    padding-left: 20px;
    padding-right: 20px;
}

/* ══════════════════════════════════════════
   MARKET REDESIGN — main market + trade modal
   ══════════════════════════════════════════ */
.market-content {
    padding: 16px 20px 20px 20px;
}

.market-section {
    background-color: rgb(18, 25, 39);
    border-color: rgb(42, 95, 201);
    border-radius: 10px;
}
.market-section-title {
    padding: 10px 18px;
    background-color: rgba(42, 95, 201, 0.16);
    border-bottom-color: rgba(42, 95, 201, 0.55);
}
.market-section-title-text {
    font-size: 20px;
    letter-spacing: 2px;
}
.market-team-grid {
    padding: 12px 14px 14px 14px;
    align-items: flex-start;
}
.market-team-chip {
    width: 96px;
    height: 104px;
    margin: 5px;
    padding: 8px 5px;
    background-color: rgb(13, 20, 33);
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    align-items: center;
    justify-content: center;
}
.market-team-chip:hover {
    border-color: rgb(100, 150, 230);
    background-color: rgba(42, 95, 201, 0.18);
}
.market-team-chip.active {
    border-width: 2px;
    border-color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.12);
}
.market-team-chip-logo {
    width: 62px;
    height: 62px;
}

.market-btn-negotiate {
    width: 100%;
    margin-top: 0;
    padding: 12px 20px;
    background-color: rgba(39, 174, 96, 0.10);
    border-color: rgb(39, 174, 96);
    color: rgb(100, 200, 140);
}
.market-btn-negotiate:hover {
    background-color: rgba(39, 174, 96, 0.25);
    border-color: rgb(70, 210, 125);
    color: rgb(160, 235, 185);
}
.market-btn-negotiate-text,
.market-btn-negotiate:hover .market-btn-negotiate-text {
    color: inherit;
}

.market-fa-panel {
    width: 100%;
    margin-top: 12px;
    flex-grow: 1;
}
.market-fa-panel-inner {
    background-color: rgb(18, 25, 39);
    border-color: rgb(42, 95, 201);
    border-radius: 10px;
}
.market-fa-panel-header {
    padding: 12px 18px;
    background-color: rgba(42, 95, 201, 0.12);
    border-bottom-color: rgba(42, 95, 201, 0.45);
}
.market-fa-panel-name {
    font-size: 20px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
}
.market-fa-row {
    height: 58px;
    min-height: 58px;
    max-height: 58px;
    padding: 7px 20px;
    background-color: rgba(13, 20, 33, 0.55);
}
.market-fa-row:hover {
    background-color: rgba(42, 95, 201, 0.16);
}
.market-fa-col-photo {
    width: 44px;
    height: 44px;
    margin-right: 14px;
    border-radius: 6px;
}
.market-fa-col-name {
    font-size: 18px;
}
.market-fa-col-pos,
.market-fa-col-ovr,
.market-fa-col-salary {
    font-size: 17px;
}
.market-fa-col-action {
    width: 290px;
}

/* ── trade modal ── */
.market-trade-modal {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 900;
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 8, 16, 0.90);
    padding: 20px;
}
.market-trade-modal-box {
    width: 96%;
    height: 94%;
    min-height: 0;
    flex-direction: column;
    background-color: rgb(8, 20, 38);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    border-radius: 10px;
    overflow: hidden;
}
.market-trade-modal-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    padding: 12px 18px;
    background-color: rgba(42, 95, 201, 0.13);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 95, 201);
}
.market-trade-modal-heading,
.market-fa-modal-heading {
    flex-direction: row;
    align-items: center;
}
.market-trade-modal-icon {
    width: 48px;
    margin-right: 12px;
    color: rgb(120, 160, 230);
    font-size: 42px;
    -unity-text-align: middle-center;
}
.market-trade-modal-title,
.market-fa-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 28px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
}
.market-trade-modal-subtitle,
.market-fa-modal-subtitle {
    margin-top: 2px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(150, 180, 220);
}
.market-trade-modal-close,
.market-modal-close {
    width: 38px;
    height: 38px;
    padding: 0;
    background-color: rgba(192, 57, 43, 0.10);
    border-width: 2px;
    border-color: rgb(192, 57, 43);
    border-radius: 8px;
    color: rgb(230, 120, 100);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 25px;
    -unity-text-align: middle-center;
    cursor: pointer;
}
.market-trade-modal-close:hover,
.market-modal-close:hover {
    background-color: rgba(192, 57, 43, 0.25);
    color: rgb(255, 170, 150);
}
.market-trade-modal-content {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    padding: 12px;
}
.market-trade-panels-grid {
    width: 68%;
    min-width: 0;
    height: 100%;
}
.market-trade-panel {
    height: 100%;
    background-color: rgb(11, 28, 51);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    border-radius: 8px;
    margin-right: 8px;
}
.market-trade-panel-header {
    padding: 10px 14px;
    background-color: rgba(42, 95, 201, 0.18);
}
.market-trade-panel-name {
    font-size: 20px;
}
.market-trade-summary {
    width: 32%;
    height: 100%;
    min-width: 0;
    margin-left: 4px;
    padding: 14px;
    background-color: rgb(9, 24, 44);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    border-radius: 8px;
    overflow: hidden;
}
.market-summary-title-text {
    font-size: 20px;
}
.market-summary-grid {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}
.market-summary-grid .market-summary-col {
    width: 100%;
    flex-grow: 0;
    margin-right: 0;
    margin-bottom: 8px;
    padding: 10px 12px;
}
.market-summary-col--result {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}
.market-summary-team {
    font-size: 17px;
}
.market-summary-label,
.market-summary-value {
    font-size: 15px;
}
.market-trade-status {
    overflow: hidden;
}
.market-trade-status-box {
    padding: 10px;
}
.market-btn-confirm-trade {
    padding: 11px 14px;
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    border-radius: 8px;
    background-color: rgba(39, 174, 96, 0.14);
    color: rgb(100, 210, 145);
}
.market-btn-confirm-trade:hover {
    background-color: rgba(39, 174, 96, 0.30);
}

/* ── modern free-agent offer modal ── */
.market-modal-overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1000;
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 8, 16, 0.90);
    display: none;
}
.market-fa-modal-box {
    width: 720px;
    max-height: 88%;
    background-color: rgb(13, 24, 42);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    border-radius: 10px;
    overflow: hidden;
    flex-direction: column;
}
.market-fa-modal-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    background-color: rgba(42, 95, 201, 0.16);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 95, 201);
}
.market-fa-modal-icon {
    width: 54px;
    height: 54px;
    margin-right: 12px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    flex-shrink: 0;
}
.market-fa-modal-body {
    padding: 20px 24px 22px 24px;
    flex-direction: column;
    overflow: hidden;
}
.market-fa-modal-body .renew-form-row {
    margin-bottom: 14px;
    padding: 10px 12px;
    background-color: rgba(7, 16, 30, 0.65);
    border-width: 1px;
    border-color: rgba(42, 95, 201, 0.35);
    border-radius: 6px;
}
.market-fa-modal-body .renew-form-label {
    width: 150px;
    color: rgb(170, 190, 220);
}
.market-fa-modal-body .renew-spin-label {
    font-size: 21px;
    color: rgb(255, 255, 255);
}
.market-fa-modal-body .btn-spin {
    width: 34px;
    height: 34px;
    background-color: rgba(42, 95, 201, 0.16);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    border-radius: 6px;
    color: rgb(120, 170, 235);
}
.market-fa-modal-body .btn-spin:hover {
    background-color: rgba(42, 95, 201, 0.35);
}
.market-fa-modal-body .renew-options-toggles {
    flex-direction: row;
    flex-grow: 1;
}
.market-fa-modal-body .renew-toggle-btn {
    flex-grow: 1;
    margin-left: 6px;
    padding: 9px 10px;
    background-color: rgba(42, 95, 201, 0.10);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    border-radius: 7px;
    color: rgb(130, 170, 230);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
}
.market-fa-modal-body .renew-toggle-btn:hover {
    background-color: rgba(42, 95, 201, 0.25);
}
.market-fa-modal-body .renew-modal-text {
    width: 100%;
    margin-top: 8px;
    margin-bottom: 8px;
    padding: 9px 12px;
    background-color: rgba(7, 16, 30, 0.50);
    border-radius: 6px;
    font-size: 16px;
}
.market-fa-modal-body .renew-modal-text--warning {
    color: rgb(230, 185, 70);
    border-left-width: 3px;
    border-left-color: rgb(212, 160, 23);
}
.market-fa-modal-body .renew-modal-text--info {
    color: rgb(140, 180, 235);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}
.market-fa-modal-body .renew-modal-text--pending {
    color: rgb(100, 210, 145);
    border-left-width: 3px;
    border-left-color: rgb(39, 174, 96);
}
.market-fa-modal-actions {
    flex-direction: row;
    align-self: stretch;
    margin-top: 18px;
}
.market-fa-modal-actions .btn-modal-cancel,
.market-fa-modal-actions .btn-modal-confirm {
    flex-grow: 1;
    margin-left: 6px;
    border-width: 2px;
    border-radius: 8px;
    padding: 11px 16px;
    cursor: pointer;
}
.market-fa-modal-actions .btn-modal-cancel {
    background-color: rgba(192, 57, 43, 0.10);
    border-color: rgb(192, 57, 43);
    color: rgb(230, 120, 100);
}
.market-fa-modal-actions .btn-modal-cancel:hover {
    background-color: rgba(192, 57, 43, 0.25);
}
.market-fa-modal-actions .btn-modal-confirm {
    background-color: rgba(39, 174, 96, 0.12);
    border-color: rgb(39, 174, 96);
    color: rgb(100, 210, 145);
}
.market-fa-modal-actions .btn-modal-confirm:hover {
    background-color: rgba(39, 174, 96, 0.28);
}

/* ── TRADE SUCCESS MODAL (copied from Roster renew modal) ── */
.renew-modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0.95;
    align-items: center;
    justify-content: center;
    display: none;
}
.renew-modal-overlay--visible {
    display: flex;
}
.renew-modal-box {
    position: absolute;
    width: 520px;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-top-width: 3px;
    border-top-color: rgb(39, 174, 96);
    padding: 32px;
    flex-direction: column;
    align-items: center;
}
.renew-modal-box--positive {
    border-top-color: rgb(39, 174, 96);
}
.renew-modal-box--negative {
    border-top-color: rgb(192, 57, 43);
}
.renew-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}
.renew-modal-title--positive {
    color: rgb(39, 174, 96);
}
.renew-modal-title--negative {
    color: rgb(192, 57, 43);
}
.renew-modal-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-to-fit;
}
.renew-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    margin-top: 8px;
    margin-bottom: 18px;
    -unity-text-align: middle-center;
}
.renew-modal-text--warning {
    color: rgb(212, 160, 23);
    font-size: 18px;
    margin-top: 4px;
    -unity-text-align: middle-center;
}
.renew-modal-text--info {
    color: rgb(122, 138, 170);
    font-size: 18px;
    margin-top: 6px;
    -unity-text-align: middle-center;
}
.renew-modal-text--pending {
    color: rgb(212, 160, 23);
    font-size: 20px;
    margin-top: 8px;
}
.renew-modal-buttons {
    flex-direction: row;
    margin-top: 24px;
    gap: 12px;
}
.renew-form-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 12px;
}
.renew-form-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    width: 120px;
    flex-shrink: 0;
}
.renew-form-field {
    flex-grow: 1;
    height: 36px;
    font-size: 18px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(208, 216, 232);
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    padding: 4px 8px;
    -unity-text-align: middle-left;
}

/* ── Spinner (increment/decrement buttons + label) ── */
.renew-spinner-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    margin-left: 8px;
}

.renew-spin-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    flex-grow: 1;
    padding: 0 4px;
}

.btn-spin {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    width: 36px;
    height: 36px;
    background-color: rgb(42, 51, 71);
    flex-shrink: 0;
    border-width: 0;
    padding: 0;
}

.btn-spin:hover {
    background-color: rgb(58, 74, 99);
}

.btn-spin--disabled {
    background-color: rgb(30, 34, 46);
    color: rgb(80, 90, 110);
}

.market-trade-picks-section {
    border-top-width: 1px;
    border-top-color: rgb(58, 74, 99);
    padding-top: 6px;
    margin-top: 4px;
}

.market-trade-columns {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.market-trade-col-players {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    min-width: 0;
}

.market-trade-col-picks {
    width: 330px;
    flex-shrink: 0;
    flex-direction: column;
    border-left-width: 1px;
    border-left-color: rgb(58, 74, 99);
    margin-left: 6px;
    padding-left: 6px;
    min-height: 0;
}

.market-trade-picks-header {
    height: 40px;
    justify-content: center;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 74, 99);
    margin-bottom: 4px;
}

.market-trade-picks-scroll {
    flex-grow: 1;
    min-height: 0;
}

.market-trade-picks-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: rgb(160, 174, 192);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.market-trade-picks-content {
    flex-direction: column;
}

.market-pick-row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(30, 34, 46);
    border-radius: 4px;
    padding: 4px 8px;
    margin: 2px 6px;
    min-height: 28px;
}

.market-pick-dropdown {
    margin-left: 6px;
    flex-shrink: 0;
    max-width: 160px;
}

.market-pick-trigger {
    flex-direction: row;
    align-items: center;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 2px 6px;
    height: 24px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    cursor: pointer;
}

.market-pick-trigger:hover {
    border-color: rgb(85, 102, 119);
}

.market-pick-trigger-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 13px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.market-pick-trigger-arrow {
    font-size: 12px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-right;
    margin-left: 6px;
}

.market-pick-trigger-value--swap {
    color: rgb(76, 209, 55);
}

.market-pick-dropdown-list {
    position: absolute;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    flex-direction: column;
    min-width: 150px;
}

.market-pick-dropdown-item {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(208, 216, 232);
    background-color: rgb(28, 33, 48);
    border-width: 0;
    padding: 3px 12px;
    -unity-text-align: middle-left;
    cursor: pointer;
}

.market-pick-dropdown-item:hover {
    background-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
}

.market-pick-dropdown-item--selected {
    color: rgb(212, 160, 23);
}

.market-pick-dropdown-item--swap.active {
    color: rgb(76, 209, 55);
}

.market-pick-dropdown-item--swap {
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
}

.market-pick-row:hover {
    background-color: rgb(45, 52, 70);
}

.market-pick-row.selected {
    background-color: rgb(16, 56, 92);
}

.market-pick-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(236, 240, 241);
    font-size: 18px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.market-pick-round {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(241, 196, 15);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    width: 24px;
}

.renew-options-row {
    min-height: unset;
    margin-bottom: 8px;
}

.renew-options-toggles {
    flex-direction: row;
    flex-grow: 1;
    margin-left: 8px;
}

.renew-toggle-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    padding: 6px 14px;
    flex-grow: 1;
    -unity-text-align: middle-center;
}

.renew-toggle-btn:hover {
    background-color: rgb(28, 33, 48);
    border-color: rgb(85, 102, 119);
}

.renew-toggle-btn--team-active,
.renew-toggle-btn--team-active:hover {
    color: rgb(39, 174, 96);
    border-color: rgb(39, 174, 96);
    background-color: rgba(39, 174, 96, 0.15);
}

.renew-toggle-btn--player-active,
.renew-toggle-btn--player-active:hover {
    color: rgb(248, 196, 64);
    border-color: rgb(248, 196, 64);
    background-color: rgba(248, 196, 64, 0.15);
}

.renew-toggle-btn--tw-active,
.renew-toggle-btn--tw-active:hover {
    color: rgb(190, 220, 255);
    border-color: rgb(39, 84, 148);
    background-color: rgba(39, 84, 148, 0.25);
}

/* ── TABLE HEADER PHOTO ── */
.market-table-header-photo {
    width: 52px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

/* ══ PAGINACIÓN FA (10 resultados por página) ══ */
.market-pagination {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-height: 48px;
    padding: 6px 24px;
    background-color: rgb(17, 24, 34);
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
}

.market-page-btn {
    width: 38px;
    height: 32px;
    padding: 6px;
    margin: 0 12px;
    align-items: center;
    justify-content: center;
    color: rgb(122, 138, 170);
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 3px;
    -unity-text-align: middle-center;
}

.market-page-btn:hover {
    color: rgb(212, 160, 23);
    border-color: rgb(212, 160, 23);
}

.market-page-jump-btn {
    width: 64px;
    flex-direction: row;
    flex-wrap: nowrap;
}

.market-page-icon {
    width: 18px;
    height: 18px;
    margin: 0;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.market-page-btn:disabled {
    color: rgb(55, 65, 84);
    background-color: rgb(17, 24, 34);
    border-color: rgb(28, 33, 48);
}

.market-page-label {
    min-width: 80px;
    height: 24px;
    flex-shrink: 0;
    font-size: 16px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
}
