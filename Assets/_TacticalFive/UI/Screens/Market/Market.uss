/* ══════════════════════════════════════════
   MARKET — Market.uss
   ══════════════════════════════════════════ */

.market-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.market-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.market-content {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    padding: 24px 28px;
    gap: 16px;
}

/* ── SECTIONS ── */
.market-section {
    background-color: rgb(18, 21, 28);
    border-width: 1px;
    border-color: rgb(120, 95, 30);
    border-radius: 4px;
    overflow: hidden;
    flex-shrink: 0;
}

.market-section-title {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(120, 95, 30);
    background-color: rgba(120, 95, 30, 0.15);
}

.market-section-icon {
    font-size: 20px;
}

.market-section-title-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1.5px;
    color: rgb(212, 160, 23);
}

/* ── TEAM GRID ── */
.market-team-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 16px 20px;
}

.market-team-chip {
    width: 90px;
    height: 90px;
    margin: 6px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 6px;
    padding: 8px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}

.market-team-chip:hover {
    border-color: rgb(58, 74, 99);
    background-color: rgb(30, 37, 53);
}

.market-team-chip.active {
    border-color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.08);
}

.market-team-chip-logo {
    width: 80px;
    height: 80px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ── NEGOTIATE BUTTON ── */
.market-btn-negotiate {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    background-color: rgba(42, 95, 201, 0.10);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    border-radius: 8px;
    padding: 14px 20px;
    cursor: pointer;
    flex-shrink: 0;
    margin-top: 12px;
}

.market-btn-negotiate:hover {
    background-color: rgba(42, 95, 201, 0.25);
    border-color: rgb(74, 128, 240);
}

.market-btn-negotiate-icon {
    display: none;
}

.market-btn-negotiate-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    letter-spacing: 2px;
    color: rgb(100, 160, 230);
    -unity-text-align: middle-center;
}

.market-btn-negotiate:hover .market-btn-negotiate-text {
    color: rgb(140, 190, 255);
}

.market-btn-negotiate--disabled {
    background-color: rgba(100, 110, 130, 0.08);
    border-color: rgba(100, 110, 130, 0.30);
    cursor: default;
    pointer-events: none;
}
.market-btn-negotiate--disabled:hover {
    background-color: rgba(100, 110, 130, 0.08);
    border-color: rgba(100, 110, 130, 0.30);
}
.market-btn-negotiate--disabled .market-btn-negotiate-text {
    color: rgba(100, 110, 130, 0.50);
}
.market-btn-negotiate--disabled:hover .market-btn-negotiate-text {
    color: rgba(100, 110, 130, 0.50);
}

/* ── TRADE PANELS ── */
.market-trade-panels {
    flex-direction: column;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    overflow: visible;
    flex-shrink: 0;
    margin-top: 12px;
}

.market-trade-panels-grid {
    flex-direction: row;
    flex-shrink: 0;
}

.market-fa-panel {
    width: 50%;
    flex-grow: 1;
    min-height: 0;
    margin-top: 16px;
}

.market-fa-panel-inner {
    flex-grow: 1;
    min-height: 0;
    flex-direction: column;
    background-color: rgb(18, 21, 28);
    border-width: 1px;
    border-color: rgb(120, 95, 30);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
}

.market-fa-panel-header {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    background-color: rgba(120, 95, 30, 0.15);
    border-bottom-width: 1px;
    border-bottom-color: rgb(120, 95, 30);
    flex-shrink: 0;
}

.market-fa-panel-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
}

.market-fa-body {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}

.market-fa-content {
    flex-direction: column;
    flex-grow: 1;
    align-content: flex-start;
    min-height: 0;
    overflow: hidden;
}

/* ── TRADE TABLE ── */
.market-trade-row {
    flex-direction: row;
    align-items: center;
    padding: 7px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 51, 71, 0.3);
    min-height: 37px;
}

.market-trade-row:hover {
    background-color: rgba(255, 255, 255, 0.03);
}

.market-trade-row.selected {
    background-color: rgb(16, 56, 92);
}

.market-trade-sat-section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 13px;
    color: rgb(200, 160, 30);
    padding: 8px 10px 2px 10px;
    background-color: rgba(200, 160, 30, 0.08);
    border-top-width: 1px;
    border-top-color: rgba(200, 160, 30, 0.4);
}

.market-trade-col-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
    align-self: center;
    -unity-text-align: middle-left;
}

.market-trade-col-pos {
    width: 40px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    font-weight: 600;
    color: rgb(122, 138, 170);
    align-self: center;
}

.market-trade-col-ovr {
    width: 40px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    font-weight: 700;
    color: rgb(255, 255, 255);
    align-self: center;
}
.market-trade-col-ovr--high {
    color: rgb(39, 174, 96);
}
.market-trade-col-ovr--mid {
    color: rgb(212, 160, 23);
}
.market-trade-col-ovr--low {
    color: rgb(192, 57, 43);
}

.market-trade-col-salary {
    width: 100px;
    -unity-text-align: middle-right;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    font-weight: 500;
    color: rgb(208, 216, 232);
    align-self: center;
}

.market-trade-col-restantes {
    width: 70px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    font-weight: 500;
    color: rgb(208, 216, 232);
    align-self: center;
}

/* ── TRADE SUMMARY (legacy summary classes shared by FA modal) ── */
.market-summary-title {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.market-summary-title-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 1.5px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
}

.market-summary-grid {
    flex-direction: row;
    margin-bottom: 16px;
}

.market-summary-grid .market-summary-col {
    flex: 1;
    min-width: 0;
    margin-right: 12px;
}

.market-summary-grid .market-summary-col:last-child {
    margin-right: 0;
}

.market-summary-col {
    flex: 1;
    min-width: 0;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 6px;
    padding: 12px 16px;
    color: rgb(212, 160, 23);
}

.market-summary-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
}

.market-summary-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 4px 0;
}

.market-summary-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    font-weight: 600;
    color: rgb(255, 255, 255);
    flex-shrink: 0;
    min-width: 140px;
    min-height: 20px;
    margin-right: 8px;
    -unity-text-align: middle-left;
    overflow: visible;
}

.market-summary-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    font-weight: 600;
    color: rgb(255, 255, 255);
    flex-shrink: 0;
    -unity-text-align: middle-right;
    min-width: 80px;
}

.market-summary-positive {
    color: rgb(39, 174, 96);
}

.market-summary-negative {
    color: rgb(192, 57, 43);
}

/* ── TRADE STATUS ── */
.market-trade-status {
    margin-top: 12px;
    flex-grow: 1;
}

.market-trade-status-box {
    flex-direction: row;
    align-items: flex-start;
    gap: 12px;
    padding: 8px 16px;
    border-radius: 6px;
    flex-grow: 1;
}

.market-trade-status-box.invalid {
    background-color: rgba(192, 57, 43, 0.1);
    border-width: 1px;
    border-color: rgba(192, 57, 43, 0.3);
}

.market-trade-status-box.valid {
    background-color: rgba(39, 174, 96, 0.1);
    border-width: 1px;
    border-color: rgba(39, 174, 96, 0.3);
}

.market-trade-status-box.rejected {
    background-color: rgba(230, 126, 34, 0.1);
    border-width: 1px;
    border-color: rgba(230, 126, 34, 0.3);
}

.market-trade-status-icon {
    font-size: 24px;
    flex-shrink: 0;
    margin-top: 2px;
}

.market-trade-status-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(255, 255, 255);
    font-weight: 600;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    display: block;
}

.market-trade-status-errors {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    margin-top: 6px;
    font-size: 16px;
    color: rgb(122, 138, 170);
    flex-direction: column;
}

.market-trade-status-score {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    margin-top: 4px;
}

.market-btn-confirm-trade {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    background-color: rgb(39, 174, 96);
    border-width: 0;
    color: rgb(255, 255, 255);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 1.5px;
    -unity-text-transform: upper;
    padding: 6px;
    border-radius: 4px;
    cursor: pointer;
    margin-top: 12px;
    -unity-text-align: middle-center;
}

.market-btn-confirm-trade:hover {
    background-color: rgb(46, 204, 113);
}

/* Sign & Trade toggle */
.market-btn-sat-toggle {
    flex-direction: row;
    align-items: center;
    padding: 8px 20px;
    border-width: 1px;
    border-color: rgb(200, 160, 30);
    border-radius: 4px;
    cursor: pointer;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(200, 160, 30);
    background-color: rgba(200, 160, 30, 0.1);
    white-space: nowrap;
    flex-shrink: 0;
}
.market-btn-sat-toggle:hover {
    background-color: rgba(200, 160, 30, 0.25);
}

/* ── FREE AGENTS ── */
.market-fa-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 51, 71, 0.3);
    height: 48px;
    min-height: 48px;
    max-height: 48px;
    flex-grow: 0;
    flex-shrink: 0;
}

.market-fa-row:hover {
    background-color: rgba(255, 255, 255, 0.03);
}

.market-fa-col-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
    -unity-text-transform: upper;
    align-self: center;
    -unity-text-align: middle-left;
}

.market-fa-col-pos {
    width: 40px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    font-weight: 600;
    color: rgb(122, 138, 170);
}

.market-fa-col-ovr {
    width: 40px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    font-weight: 700;
    color: rgb(255, 255, 255);
}
.market-fa-col-ovr--high {
    color: rgb(39, 174, 96);
}
.market-fa-col-ovr--mid {
    color: rgb(212, 160, 23);
}
.market-fa-col-ovr--low {
    color: rgb(192, 57, 43);
}

.market-fa-col-salary {
    width: 100px;
    -unity-text-align: middle-right;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    font-weight: 500;
    color: rgb(208, 216, 232);
}

.market-fa-col-action {
    width: 220px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    -unity-text-align: middle-center;
}

.market-fa-col-photo {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    margin-right: 12px;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
}

.market-btn-fa-sign {
    background-color: rgba(39, 174, 96, 0.10);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    color: rgb(100, 200, 140);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    padding: 8px 14px;
    border-radius: 6px;
    cursor: pointer;
    min-height: 24px;
}

.market-btn-fa-sign:hover {
    background-color: rgba(39, 174, 96, 0.25);
    color: rgb(150, 220, 180);
}

.market-btn-fa-sign:disabled {
    background-color: rgba(100, 110, 130, 0.10);
    border-color: rgb(100, 110, 130);
    color: rgb(120, 130, 150);
    cursor: default;
    opacity: 0.7;
}

.market-btn-fa-profile {
    background-color: rgba(42, 95, 201, 0.10);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(100, 150, 230);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    padding: 8px 14px;
    border-radius: 6px;
    cursor: pointer;
    min-height: 24px;
    margin-left: 6px;
}

.market-btn-fa-profile:hover {
    background-color: rgba(42, 95, 201, 0.25);
    color: rgb(150, 190, 255);
}

.market-empty-fa {
    padding: 40px 20px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
}

/* ── MODALS ── */
.market-modal {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 1000;
    align-items: center;
    justify-content: center;
}

.market-modal-content {
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    width: 520px;
}

.market-modal-header {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 16px 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
}

.market-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 1px;
    -unity-text-transform: upper;
}

.market-modal-body {
    padding: 32px;
    flex-direction: column;
    align-items: center;
}

.market-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    line-height: 1.6;
    margin-bottom: 10px;
}

.market-modal-highlight {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(212, 160, 23);
    font-weight: 700;
    margin-bottom: 10px;
}

.market-modal-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 12px;
}

.market-modal-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    width: 120px;
    flex-shrink: 0;
}

.market-modal-footer {
    flex-direction: row;
    gap: 10px;
    padding: 16px 20px;
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
    justify-content: flex-end;
}

.btn-modal-cancel {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(30, 37, 53);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    color: rgb(122, 138, 170);
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 10px 24px;
    margin-right: 10px;
    -unity-text-align: middle-center;
}
.btn-modal-cancel:hover {
    border-color: rgb(122, 138, 170);
    color: rgb(208, 216, 232);
}
.btn-modal-confirm {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(23, 110, 59);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 10px 24px;
    -unity-text-align: middle-center;
}
.btn-modal-confirm:hover {
    background-color: rgb(39, 174, 96);
}

.btn-modal-danger {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(155, 30, 30);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 10px 24px;
    -unity-text-align: middle-center;
}
.btn-modal-danger:hover {
    background-color: rgb(192, 57, 43);
}

/* ── DEADLINE COUNTDOWN ── */
.market-deadline-countdown-bar {
    padding: 10px 24px;
    background-color: rgb(212, 160, 23);
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    border-radius: 4px;
}
.market-deadline-countdown-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: rgb(0, 0, 0);
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

/* ── TRANSFER WINDOW CLOSED ── */
.market-closed-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    z-index: 500;
}
.market-closed-overlay-box {
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 40px;
}
.market-closed-overlay-icon {
    width: 64px;
    height: 64px;
    font-size: 48px;
    -unity-text-align: middle-center;
    color: rgb(192, 57, 43);
}
.market-closed-overlay-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 28px;
    letter-spacing: 2px;
    color: rgb(192, 57, 43);
    -unity-text-transform: upper;
    -unity-text-align: middle-center;
}
.market-closed-overlay-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    max-width: 500px;
}

/* ── TABLE HEADERS ── */
.market-table-header {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    background-color: rgb(28, 33, 48);
    min-height: 40px;
    flex-shrink: 0;
}

.market-table-header-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(122, 138, 170);
}

.market-table-header-spacer {
    width: 18px;
    margin-right: 12px;
}

.market-table-header-name {
    flex-grow: 1;
}

.market-table-header-pos {
    width: 40px;
    -unity-text-align: middle-center;
}

.market-table-header-ovr {
    width: 40px;
    -unity-text-align: middle-center;
}

.market-table-header-salary {
    width: 100px;
    -unity-text-align: middle-right;
}

.market-table-header-restantes {
    width: 70px;
    -unity-text-align: middle-center;
}

.market-table-header-action {
    width: 220px;
    -unity-text-align: middle-center;
}

.market-fa-panel-inner > .market-table-header {
    padding-left: 20px;
    padding-right: 20px;
}

/* ══════════════════════════════════════════
   MARKET REDESIGN — main market + trade modal
   ══════════════════════════════════════════ */
.market-content {
    padding: 16px 20px 20px 20px;
}

.market-section {
    background-color: rgb(18, 21, 28);
    border-width: 1px;
    border-color: rgb(120, 95, 30);
    border-radius: 4px;
    overflow: hidden;
    flex-shrink: 0;
}
.market-section-title {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    background-color: rgba(120, 95, 30, 0.15);
    border-bottom-width: 1px;
    border-bottom-color: rgb(120, 95, 30);
}
.market-section-title-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
}
.market-team-grid {
    padding: 12px 14px 14px 14px;
    align-items: flex-start;
}
.market-team-chip {
    width: 90px;
    height: 90px;
    margin: 5px;
    padding: 8px 5px;
    background-color: rgb(13, 20, 33);
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    align-items: center;
    justify-content: center;
}
.market-team-chip:hover {
    border-color: rgb(100, 150, 230);
    background-color: rgba(42, 95, 201, 0.18);
}
.market-team-chip.active {
    border-width: 2px;
    border-color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.12);
}
.market-team-chip-logo {
    width: 80px;
    height: 80px;
}

.market-fa-panel {
    width: 100%;
    margin-top: 12px;
    flex-grow: 1;
}
.market-fa-panel-inner {
    background-color: rgb(18, 21, 28);
    border-width: 1px;
    border-color: rgb(120, 95, 30);
    border-radius: 4px;
}
.market-fa-panel-header {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    background-color: rgba(120, 95, 30, 0.15);
    border-bottom-width: 1px;
    border-bottom-color: rgb(120, 95, 30);
}
.market-fa-panel-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
}
.market-fa-row {
    height: 56px;
    min-height: 56px;
    max-height: 56px;
    padding: 7px 20px;
    background-color: rgba(13, 20, 33, 0.55);
}
.market-fa-row:hover {
    background-color: rgba(42, 95, 201, 0.16);
}
.market-fa-col-photo {
    width: 44px;
    height: 44px;
    margin-right: 14px;
    border-radius: 6px;
}
.market-fa-col-name {
    font-size: 18px;
}
.market-fa-col-pos,
.market-fa-col-ovr,
.market-fa-col-salary {
    font-size: 17px;
}
.market-fa-col-action {
    width: 290px;
}

/* ── trade modal ── */
.market-trade-modal {
    position: absolute;
    top: 0; right: 0; bottom: 0; left: 0;
    z-index: 900;
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 8, 16, 0.92);
    padding: 16px;
}
.market-trade-modal-box {
    width: 98%;
    height: 96%;
    min-height: 0;
    flex-direction: column;
    background-color: rgb(18, 21, 28);
    border-width: 1px;
    border-color: rgba(120, 95, 30, 0.60);
    border-radius: 10px;
    overflow: hidden;
}
/* header */
.market-trade-modal-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    padding: 14px 20px;
    background-color: rgba(15, 17, 23, 0.95);
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 95, 201, 0.30);
}
.market-trade-modal-heading,
.market-fa-modal-heading {
    flex-direction: row;
    align-items: center;
}
.market-trade-modal-icon {
    width: 40px;
    height: 40px;
    margin-right: 14px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.market-trade-modal-title,
.market-fa-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 28px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
}
.market-trade-modal-subtitle,
.market-fa-modal-subtitle {
    margin-top: 2px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    color: rgb(140, 170, 210);
}
.market-trade-modal-subtitle {
    font-size: 16px;
}
.market-fa-modal-subtitle {
    font-size: 15px;
}
.market-trade-modal-header-actions {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
}
.market-trade-modal-header-actions .market-trade-btn {
    flex-grow: 0;
    width: 220px;
    padding: 14px 18px;
    margin-left: 6px;
    font-size: 22px;
}
.market-modal-close {
    width: 38px; height: 38px;
    padding: 0;
    background-color: rgba(192, 57, 43, 0.10);
    border-width: 2px;
    border-color: rgb(192, 57, 43);
    border-radius: 8px;
    color: rgb(230, 120, 100);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 25px;
    -unity-text-align: middle-center;
    cursor: pointer;
}
.market-modal-close:hover {
    background-color: rgba(192, 57, 43, 0.25);
    color: rgb(255, 170, 150);
}
/* 3-column content */
.market-trade-modal-content {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    padding: 10px;
    align-items: stretch;
}
/* team panels */
.market-trade-panel {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 5px;
    flex-direction: column;
    background-color: rgb(10, 24, 46);
    border-width: 1px;
    border-color: rgba(42, 95, 201, 0.50);
    border-radius: 8px;
    overflow: hidden;
}
.market-trade-panel--other {
    border-color: rgba(212, 80, 80, 0.50);
}
.market-trade-panel-header {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    background-color: rgba(42, 95, 201, 0.15);
    flex-shrink: 0;
}
.market-trade-panel--other .market-trade-panel-header {
    background-color: rgba(212, 80, 80, 0.12);
}
.market-trade-panel-logo {
    width: 64px; height: 64px;
    margin-right: 12px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    flex-shrink: 0;
}
.market-trade-panel-header-text {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}
.market-trade-panel-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 20px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    white-space: nowrap;
    flex-grow: 1;
}
.market-trade-panel-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(140, 170, 210);
    margin-top: 1px;
}
/* panel stats row */
.market-trade-panel-stats {
    flex-direction: row;
    padding: 8px 14px;
    background-color: rgba(42, 95, 201, 0.08);
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 95, 201, 0.25);
    flex-shrink: 0;
}
.market-trade-panel--other .market-trade-panel-stats {
    background-color: rgba(212, 80, 80, 0.06);
    border-bottom-color: rgba(212, 80, 80, 0.20);
}
.market-trade-stat {
    flex-direction: row;
    align-items: center;
    margin-right: 24px;
}
.market-trade-stat-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    color: rgb(120, 140, 170);
    white-space: nowrap;
}
.market-trade-stat-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 22px;
    color: rgb(255, 255, 255);
    margin-left: 8px;
    white-space: nowrap;
}
.market-trade-stat-value--green { color: rgb(39, 174, 96); }
.market-trade-stat-value--red { color: rgb(192, 57, 43); }
/* section titles inside panel */
.market-trade-panel-section-title {
    flex-shrink: 0;
    padding: 6px 14px;
    background-color: rgba(42, 95, 201, 0.10);
    border-top-width: 1px;
    border-top-color: rgba(42, 95, 201, 0.20);
}
.market-trade-panel--other .market-trade-panel-section-title {
    background-color: rgba(212, 80, 80, 0.08);
    border-top-color: rgba(212, 80, 80, 0.15);
}
.market-trade-panel-section-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 16px;
    letter-spacing: 1.5px;
    color: rgb(255, 255, 255);
}
/* filter tabs */
.market-trade-filter-tabs {
    flex-direction: row;
    flex-shrink: 0;
    padding: 6px 10px;
}
.market-trade-filter-btn {
    padding: 5px 12px;
    margin-left: 2px;
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(42, 95, 201, 0.30);
    border-radius: 4px;
    color: rgb(140, 160, 190);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    cursor: pointer;
}
.market-trade-filter-btn--active {
    background-color: rgba(42, 95, 201, 0.30);
    border-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
}
/* filtros del panel rival: tonos rojos */
.market-trade-panel--other .market-trade-filter-btn {
    border-color: rgba(212, 80, 80, 0.35);
    color: rgb(200, 150, 150);
}
.market-trade-panel--other .market-trade-filter-btn:hover {
    background-color: rgba(212, 80, 80, 0.20);
    color: rgb(240, 180, 180);
}
.market-trade-panel--other .market-trade-filter-btn--active {
    background-color: rgba(212, 80, 80, 0.40);
    border-color: rgb(212, 80, 80);
    color: rgb(255, 220, 220);
}
/* table header inside panel */
.market-trade-table-header {
    flex-direction: row;
    flex-shrink: 0;
    /* El listado pierde 16px por la barra lateral (12px + 4px de margen). */
    padding: 5px 26px 5px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 95, 201, 0.25);
}
.market-trade-panel--other .market-trade-table-header {
    border-bottom-color: rgba(212, 80, 80, 0.35);
}
/* panel body = viewport con scroll manual (sin ScrollView de Unity) */
.market-trade-panel-body {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    height: auto;
    overflow: hidden;
    position: relative;
}
.market-trade-panel-content {
    flex-direction: column;
    flex-shrink: 0;
}

/* ── lista de jugadores + barra de scroll externa (estilo ventana Windows) ── */
.market-trade-player-list-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    align-items: stretch;
}
.market-trade-scrollbar {
    width: 12px;
    min-width: 12px;
    flex-shrink: 0;
    align-self: stretch;
    margin-left: 4px;
    background-color: rgba(4, 12, 25, 0.92);
    border-left-width: 1px;
    border-left-color: rgba(65, 105, 165, 0.35);
    position: relative;
}
.market-trade-scrollbar-thumb {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 0;
    height: 40px;
    background-color: rgb(42, 95, 201);
    border-radius: 3px;
}
.market-trade-scrollbar:hover .market-trade-scrollbar-thumb {
    background-color: rgb(75, 135, 235);
}
/* barra del panel rival: tonos rojos */
.market-trade-panel--other .market-trade-scrollbar {
    border-left-color: rgba(212, 80, 80, 0.35);
}
.market-trade-panel--other .market-trade-scrollbar-thumb {
    background-color: rgb(212, 80, 80);
}
.market-trade-panel--other .market-trade-scrollbar:hover .market-trade-scrollbar-thumb {
    background-color: rgb(235, 120, 120);
}
/* picks section */
.market-trade-picks-section {
    flex-shrink: 0;
    height: 152px;
    min-height: 152px;
    padding: 6px 0px 6px 12px;
    overflow: hidden;
    background-color: rgba(4, 13, 28, 0.55);
}
.market-trade-picks-title-bar {
    flex-shrink: 0;
}
.market-trade-picks-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}
.market-trade-picks-icon {
    font-size: 18px;
    margin-right: 8px;
}
.market-trade-picks-info {
    flex-direction: column;
}
.market-trade-picks-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 16px;
    color: rgb(200, 215, 235);
}
.market-trade-picks-sub {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(120, 140, 170);
}
.market-trade-picks-list-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    align-items: stretch;
}
.market-trade-picks-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
    position: relative;
}
.market-trade-picks-content {
    flex-direction: column;
    flex-shrink: 0;
}
.market-trade-picks-scrollbar {
    width: 12px;
    min-width: 12px;
    flex-shrink: 0;
    align-self: stretch;
    margin-left: 4px;
    background-color: rgba(4, 12, 25, 0.92);
    border-left-width: 1px;
    border-left-color: rgba(65, 105, 165, 0.35);
    position: relative;
}
.market-trade-picks-scrollbar-thumb {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 0;
    height: 32px;
    background-color: rgb(42, 95, 201);
    border-radius: 3px;
}
.market-trade-picks-scrollbar:hover .market-trade-picks-scrollbar-thumb {
    background-color: rgb(75, 135, 235);
}
.market-trade-panel--other .market-trade-picks-scrollbar {
    border-left-color: rgba(212, 80, 80, 0.35);
}
.market-trade-panel--other .market-trade-picks-scrollbar-thumb {
    background-color: rgb(212, 80, 80);
}
.market-trade-panel--other .market-trade-picks-scrollbar:hover .market-trade-picks-scrollbar-thumb {
    background-color: rgb(235, 120, 120);
}
/* summary panel */
.market-trade-summary {
    width: 360px;
    min-width: 330px;
    flex-shrink: 0;
    margin: 0 5px;
    flex-direction: column;
    background-color: rgb(10, 24, 46);
    border-width: 1px;
    border-color: rgba(42, 95, 201, 0.50);
    border-radius: 8px;
    padding: 14px;
    overflow: hidden;
}
.market-summary-title-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 20px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    margin-bottom: 12px;
    flex-shrink: 0;
}
/* receive sections */
.market-summary-receive-section {
    flex-shrink: 0;
    margin-bottom: 10px;
    border-width: 1px;
    border-color: rgba(42, 95, 201, 0.30);
    border-radius: 6px;
    overflow: hidden;
}
.market-summary-receive-header {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    background-color: rgba(42, 95, 201, 0.15);
}
.market-summary-receive-header--other {
    background-color: rgba(212, 80, 80, 0.15);
}
.market-summary-badge {
    padding: 2px 6px;
    margin-right: 8px;
    background-color: rgba(42, 95, 201, 0.40);
    border-radius: 4px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(180, 210, 255);
}
.market-summary-badge--other {
    background-color: rgba(212, 80, 80, 0.40);
    color: rgb(255, 180, 180);
}
.market-summary-receive-title {
    flex-grow: 1;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(220, 230, 245);
}
.market-summary-team-logo-sm {
    width: 26px; height: 26px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    flex-shrink: 0;
}
.market-summary-received-players {
    flex-direction: column;
    max-height: 200px;
    overflow: hidden;
}
/* received player row */
.market-summary-player-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 95, 201, 0.10);
}
.market-summary-player-row:last-child {
    border-bottom-width: 0;
}
.market-summary-player-photo {
    width: 32px; height: 32px;
    border-radius: 50%;
    margin-right: 8px;
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
    background-color: rgba(42, 95, 201, 0.20);
}
.market-summary-player-name {
    flex-grow: 1;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 16px;
    color: rgb(230, 240, 255);
}
.market-summary-player-salary {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 16px;
    color: rgb(200, 215, 235);
    margin-left: 6px;
    flex-shrink: 0;
}
/* salary totals */
.market-summary-salary-section {
    flex-shrink: 0;
    padding: 8px 0;
    border-top-width: 1px;
    border-top-color: rgba(42, 95, 201, 0.25);
}
.market-summary-salary-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 3px;
}
.market-summary-salary-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(140, 160, 190);
}
.market-summary-salary-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    color: rgb(255, 255, 255);
}
.market-summary-salary-value--red { color: rgb(220, 80, 70); }
/* trade status */
.market-trade-status {
    flex-shrink: 0;
    overflow: hidden;
    margin: 6px 0;
}
.market-trade-status-box {
    flex-direction: row;
    align-items: flex-start;
    padding: 8px 10px;
    border-radius: 6px;
    border-width: 1px;
}
.market-trade-status-box.valid {
    background-color: rgba(39, 174, 96, 0.10);
    border-color: rgba(39, 174, 96, 0.40);
}
.market-trade-status-box.invalid {
    background-color: rgba(192, 57, 43, 0.10);
    border-color: rgba(192, 57, 43, 0.40);
}
.market-trade-status-box.rejected {
    background-color: rgba(192, 57, 43, 0.10);
    border-color: rgba(192, 57, 43, 0.40);
}
.market-trade-status-icon {
    font-size: 18px;
    margin-right: 8px;
    flex-shrink: 0;
}
.market-trade-status-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 18px;
    color: rgb(230, 240, 255);
}
.market-trade-status-score {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(160, 180, 210);
    margin-top: 2px;
}
.market-trade-status-errors {
    flex-direction: column;
    margin-top: 4px;
}
.market-trade-status-errors Label {
    font-size: 16px;
    color: rgb(200, 160, 160);
}
.market-btn-confirm-trade {
    padding: 10px 16px;
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    border-radius: 8px;
    background-color: rgba(39, 174, 96, 0.14);
    color: rgb(100, 210, 145);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    cursor: pointer;
}
.market-btn-confirm-trade:hover {
    background-color: rgba(39, 174, 96, 0.30);
}
/* action buttons */
.market-trade-btn {
    flex-grow: 1;
    padding: 10px 16px;
    border-radius: 8px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    letter-spacing: 1px;
    cursor: pointer;
    -unity-text-align: middle-center;
}
.market-trade-btn--confirm {
    background-color: rgba(42, 95, 201, 0.10);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(120, 160, 230);
    letter-spacing: 2px;
}
.market-trade-btn--confirm:hover {
    background-color: rgba(42, 95, 201, 0.25);
    color: rgb(150, 190, 255);
}
.market-trade-btn--confirm.market-trade-btn--disabled {
    background-color: rgba(100, 110, 130, 0.10);
    border-color: rgb(100, 110, 130);
    color: rgb(150, 155, 165);
}
.market-trade-btn--confirm.market-trade-btn--disabled:hover {
    background-color: rgba(100, 110, 130, 0.10);
    color: rgb(150, 155, 165);
}
.market-trade-btn--danger {
    background-color: rgba(192, 57, 43, 0.10);
    border-width: 2px;
    border-color: rgb(192, 57, 43);
    color: rgb(230, 120, 100);
    letter-spacing: 2px;
}
.market-trade-btn--danger:hover {
    background-color: rgba(192, 57, 43, 0.25);
    color: rgb(255, 150, 130);
}

/* ── modern free-agent offer modal ── */
.market-modal-overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1000;
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 8, 16, 0.90);
    display: none;
}
.market-fa-modal-box {
    width: 720px;
    max-height: 88%;
    background-color: rgb(13, 24, 42);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    border-radius: 10px;
    overflow: hidden;
    flex-direction: column;
}
.market-fa-modal-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    background-color: rgba(42, 95, 201, 0.16);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 95, 201);
}
.market-fa-modal-icon {
    width: 54px;
    height: 54px;
    margin-right: 12px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    flex-shrink: 0;
}
.market-fa-modal-body {
    padding: 20px 24px 22px 24px;
    flex-direction: column;
    overflow: hidden;
}
.market-fa-modal-body .renew-form-row {
    margin-bottom: 14px;
    padding: 10px 12px;
    background-color: rgba(7, 16, 30, 0.65);
    border-width: 1px;
    border-color: rgba(42, 95, 201, 0.35);
    border-radius: 6px;
}
.market-fa-modal-body .renew-form-label {
    width: 150px;
    color: rgb(170, 190, 220);
}
.market-fa-modal-body .renew-spin-label {
    font-size: 21px;
    color: rgb(255, 255, 255);
}
.market-fa-modal-body .btn-spin {
    width: 34px;
    height: 34px;
    background-color: rgba(42, 95, 201, 0.16);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    border-radius: 6px;
    color: rgb(120, 170, 235);
}
.market-fa-modal-body .btn-spin:hover {
    background-color: rgba(42, 95, 201, 0.35);
}
.market-fa-modal-body .renew-options-toggles {
    flex-direction: row;
    flex-grow: 1;
}
.market-fa-modal-body .renew-toggle-btn {
    flex-grow: 1;
    margin-left: 6px;
    padding: 9px 10px;
    background-color: rgba(42, 95, 201, 0.10);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    border-radius: 7px;
    color: rgb(130, 170, 230);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
}
.market-fa-modal-body .renew-modal-text {
    width: 100%;
    margin-top: 8px;
    margin-bottom: 8px;
    padding: 9px 12px;
    background-color: rgba(7, 16, 30, 0.50);
    border-radius: 6px;
    font-size: 16px;
}
.market-fa-modal-body .renew-modal-text--warning {
    color: rgb(230, 185, 70);
    border-left-width: 3px;
    border-left-color: rgb(212, 160, 23);
}
.market-fa-modal-body .renew-modal-text--info {
    color: rgb(140, 180, 235);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}
.market-fa-modal-body .renew-modal-text--pending {
    color: rgb(100, 210, 145);
    border-left-width: 3px;
    border-left-color: rgb(39, 174, 96);
}
.market-fa-modal-actions {
    flex-direction: row;
    align-self: stretch;
    margin-top: 18px;
}
.market-fa-modal-actions .btn-modal-cancel,
.market-fa-modal-actions .btn-modal-confirm {
    flex-grow: 1;
    margin-left: 6px;
    border-width: 2px;
    border-radius: 8px;
    padding: 11px 16px;
    cursor: pointer;
}
.market-fa-modal-actions .btn-modal-cancel {
    background-color: rgba(192, 57, 43, 0.10);
    border-color: rgb(192, 57, 43);
    color: rgb(230, 120, 100);
}
.market-fa-modal-actions .btn-modal-cancel:hover {
    background-color: rgba(192, 57, 43, 0.25);
}
.market-fa-modal-actions .btn-modal-confirm {
    background-color: rgba(39, 174, 96, 0.12);
    border-color: rgb(39, 174, 96);
    color: rgb(100, 210, 145);
}
.market-fa-modal-actions .btn-modal-confirm:hover {
    background-color: rgba(39, 174, 96, 0.28);
}

/* ── TRADE SUCCESS MODAL (copied from Roster renew modal) ── */
.renew-modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0.95;
    align-items: center;
    justify-content: center;
    display: none;
}
.renew-modal-overlay--visible {
    display: flex;
}
.renew-modal-box {
    position: absolute;
    width: 520px;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-top-width: 3px;
    border-top-color: rgb(39, 174, 96);
    padding: 32px;
    flex-direction: column;
    align-items: center;
}
.renew-modal-box--positive {
    border-top-color: rgb(39, 174, 96);
}
.renew-modal-box--negative {
    border-top-color: rgb(192, 57, 43);
}
.renew-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}
.renew-modal-title--positive {
    color: rgb(39, 174, 96);
}
.renew-modal-title--negative {
    color: rgb(192, 57, 43);
}
.renew-modal-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-to-fit;
}
.renew-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    margin-top: 8px;
    margin-bottom: 18px;
    -unity-text-align: middle-center;
}
.renew-modal-text--warning {
    color: rgb(212, 160, 23);
    font-size: 18px;
    margin-top: 4px;
    -unity-text-align: middle-center;
}
.renew-modal-text--info {
    color: rgb(122, 138, 170);
    font-size: 18px;
    margin-top: 6px;
    -unity-text-align: middle-center;
}
.renew-modal-text--pending {
    color: rgb(212, 160, 23);
    font-size: 20px;
    margin-top: 8px;
}
.renew-modal-buttons {
    flex-direction: row;
    margin-top: 24px;
    gap: 12px;
}

/* ══ TRADE SUCCESS MODAL ══ */
.trade-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.80);
    align-items: center;
    justify-content: center;
}
.trade-box {
    width: 1270px;
    background-color: rgb(8, 12, 30);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    border-radius: 12px;
    flex-direction: column;
    overflow: hidden;
}
/* Header */
.trade-header {
    flex-direction: row;
    align-items: center;
    padding: 20px 28px;
    background-color: rgba(39, 174, 96, 0.12);
    border-bottom-width: 1px;
    border-bottom-color: rgba(39, 174, 96, 0.30);
}
.trade-check-icon {
    width: 56px;
    height: 56px;
    margin-right: 18px;
    flex-shrink: 0;
    background-color: rgba(39, 174, 96, 0.15);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    border-radius: 28px;
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/Icons/boton-v-64px.png");
    background-size: 60% 60%;
    background-repeat: no-repeat;
    background-position: center;
}
.trade-header-text {
    flex-grow: 1;
    flex-direction: column;
}
.trade-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 30px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
}
.trade-title span {
    color: rgb(39, 174, 96);
}
.trade-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(255, 255, 255);
    margin-top: 4px;
}
.trade-close-x {
    background-color: transparent;
    border-width: 0;
    color: rgb(122, 160, 210);
    font-size: 26px;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    -unity-text-align: middle-center;
    cursor: pointer;
}
.trade-close-x:hover {
    background-color: rgba(192, 57, 43, 0.15);
    color: rgb(255, 255, 255);
}
/* Green line */
.trade-green-line {
    height: 3px;
    background-color: rgb(39, 174, 96);
}
/* Panels row */
.trade-panels-row {
    flex-direction: row;
    padding: 20px 24px;
    align-items: flex-start;
}
.trade-team-panel {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    border-width: 1px;
    border-color: rgba(0, 140, 210, 0.30);
    border-radius: 8px;
    background-color: rgba(10, 18, 45, 0.50);
    overflow: hidden;
}
.trade-team-header-row {
    flex-direction: row;
    align-items: center;
    padding: 14px 16px;
    background-color: rgba(10, 18, 45, 0.80);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 140, 210, 0.20);
}
.trade-team-logo-lg {
    width: 64px;
    height: 64px;
    margin-right: 14px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.trade-team-info-col {
    flex-direction: column;
}
.trade-team-name-lg {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    color: rgb(255, 255, 255);
    letter-spacing: 1px;
}
.trade-team-role {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(100, 150, 210);
    margin-top: 2px;
}
/* Table */
.trade-table {
    flex-direction: column;
}
.trade-table-header {
    flex-direction: row;
    padding: 8px 14px;
    background-color: rgba(15, 25, 55, 0.80);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 140, 210, 0.15);
}
.trade-th {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 13px;
    color: rgb(80, 130, 190);
    letter-spacing: 1px;
}
.trade-th-player {
    flex-grow: 1;
}
.trade-th-pos {
    width: 50px;
    -unity-text-align: middle-center;
}
.trade-th-tipo {
    width: 80px;
    -unity-text-align: middle-center;
}
.trade-table-body {
    flex-direction: column;
}
/* Table rows (built in C#) */
.trade-player-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 140, 210, 0.08);
}
.trade-player-row:last-child {
    border-bottom-width: 0;
}
.trade-player-photo {
    width: 50px;
    height: 50px;
    margin-right: 10px;
    flex-shrink: 0;
    border-radius: 25px;
    background-color: rgba(0, 140, 210, 0.15);
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    overflow: hidden;
}
.trade-player-name-col {
    flex-grow: 1;
    flex-direction: column;
}
.trade-player-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(230, 238, 255);
}
.trade-player-pos {
    width: 50px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(122, 160, 210);
    -unity-text-align: middle-center;
}
.trade-player-type {
    width: 80px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(100, 150, 210);
    -unity-text-align: middle-center;
}
/* Pick rows */
.trade-pick-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 140, 210, 0.08);
}
.trade-pick-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/Icons/d_icon.png");
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.trade-pick-label {
    flex-grow: 1;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(160, 190, 230);
}
.trade-pick-pos {
    width: 50px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(80, 110, 150);
    -unity-text-align: middle-center;
}
.trade-pick-type {
    width: 80px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(0, 160, 220);
    -unity-text-align: middle-center;
}
/* Swap arrows icon */
.trade-swap-icon {
    width: 48px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 80px;
}
.trade-swap-icon Label {
    font-size: 28px;
    color: rgb(0, 160, 220);
}
/* Info bar */
.trade-info-bar {
    flex-direction: row;
    margin: 0 24px 16px;
    padding: 14px 20px;
    background-color: rgba(10, 18, 45, 0.60);
    border-width: 1px;
    border-color: rgba(0, 140, 210, 0.20);
    border-radius: 8px;
    align-items: center;
}
.trade-info-item {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}
.trade-info-icon {
    font-size: 20px;
    margin-right: 10px;
}
.trade-info-text {
    flex-direction: column;
}
.trade-info-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(80, 130, 190);
    letter-spacing: 1px;
}
.trade-info-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(220, 230, 255);
    margin-top: 2px;
}
.trade-info-status {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(39, 174, 96);
    margin-top: 2px;
}
.trade-info-divider {
    width: 1px;
    height: 36px;
    background-color: rgba(0, 140, 210, 0.20);
    margin: 0 16px;
}
/* Button */
.trade-actions {
    flex-direction: row;
    justify-content: center;
    padding: 0 24px 24px;
}
.trade-btn {
    background-color: rgba(39, 174, 96, 0.12);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    color: rgb(39, 174, 96);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    padding: 14px 48px;
    border-radius: 8px;
    min-width: 300px;
    -unity-text-align: middle-center;
    cursor: pointer;
}
.trade-btn:hover {
    background-color: rgba(39, 174, 96, 0.25);
    color: rgb(80, 200, 140);
}

/* ══ FA RESULT MODAL ══ */
#FAResultOverlay.modal-overlay--visible {
    background-color: rgba(0, 0, 0, 0.75);
}
.fa-result-box {
    width: 480px;
    background-color: rgb(13, 14, 18);
    border-width: 1px;
    border-color: rgb(39, 174, 96);
    border-radius: 12px;
    padding: 0;
    flex-direction: column;
    overflow: hidden;
}
.fa-result-title {
    padding: 10px 24px;
    background-color: rgba(39, 174, 96, 0.15);
    border-bottom-width: 1px;
    border-bottom-color: rgb(39, 174, 96);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 28px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}
.fa-result-body {
    padding: 24px;
    flex-direction: column;
    align-items: center;
}
.fa-result-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(179, 190, 214);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}
.fa-result-actions {
    flex-direction: row;
    justify-content: center;
    padding: 8px 24px 20px;
}
.fa-result-btn {
    background-color: rgba(39, 174, 96, 0.15);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    color: rgb(100, 200, 140);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    padding: 12px 32px;
    border-radius: 8px;
    min-width: 200px;
    -unity-text-align: middle-center;
    cursor: pointer;
}
.fa-result-btn:hover {
    background-color: rgba(39, 174, 96, 0.30);
    color: rgb(130, 220, 170);
}
.renew-form-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 12px;
}
.renew-form-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    width: 120px;
    flex-shrink: 0;
}
.renew-form-field {
    flex-grow: 1;
    height: 36px;
    font-size: 18px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(208, 216, 232);
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    padding: 4px 8px;
    -unity-text-align: middle-left;
}

/* ── Spinner (increment/decrement buttons + label) ── */
.renew-spinner-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    margin-left: 8px;
}

.renew-spin-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    flex-grow: 1;
    padding: 0 4px;
}

.btn-spin {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    width: 36px;
    height: 36px;
    background-color: rgb(42, 51, 71);
    flex-shrink: 0;
    border-width: 0;
    padding: 0;
}

.btn-spin:hover {
    background-color: rgb(58, 74, 99);
}

.btn-spin--disabled {
    background-color: rgb(30, 34, 46);
    color: rgb(80, 90, 110);
}

.market-trade-picks-section {
    border-top-width: 1px;
    border-top-color: rgb(58, 74, 99);
    padding-top: 6px;
    margin-top: 4px;
}

.market-trade-columns {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.market-trade-col-players {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    min-width: 0;
}

.market-trade-col-picks {
    width: 330px;
    flex-shrink: 0;
    flex-direction: column;
    border-left-width: 1px;
    border-left-color: rgb(58, 74, 99);
    margin-left: 6px;
    padding-left: 6px;
    min-height: 0;
}

.market-trade-picks-header {
    height: 40px;
    justify-content: center;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 74, 99);
    margin-bottom: 4px;
}

.market-trade-picks-scroll {
    flex-grow: 1;
    min-height: 0;
}

.market-trade-picks-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: rgb(160, 174, 192);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.market-trade-picks-content {
    flex-direction: column;
}

.market-pick-row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(30, 34, 46);
    border-radius: 4px;
    padding: 4px 8px;
    margin: 2px 6px;
    min-height: 28px;
}

.market-pick-dropdown {
    margin-left: 6px;
    flex-shrink: 0;
    max-width: 160px;
}

.market-pick-trigger {
    flex-direction: row;
    align-items: center;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 2px 6px;
    height: 28px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    cursor: pointer;
}

.market-pick-trigger:hover {
    border-color: rgb(85, 102, 119);
}

.market-pick-trigger-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.market-pick-trigger-arrow {
    font-size: 12px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-right;
    margin-left: 6px;
}

.market-pick-trigger-value--swap {
    color: rgb(76, 209, 55);
}

.market-pick-dropdown-list {
    position: absolute;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    flex-direction: column;
    min-width: 150px;
}

.market-pick-dropdown-item {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    background-color: rgb(28, 33, 48);
    border-width: 0;
    padding: 3px 12px;
    -unity-text-align: middle-left;
    cursor: pointer;
}

.market-pick-dropdown-item:hover {
    background-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
}

.market-pick-dropdown-item--selected {
    color: rgb(212, 160, 23);
}

.market-pick-dropdown-item--swap.active {
    color: rgb(76, 209, 55);
}

.market-pick-dropdown-item--swap {
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
}

.market-pick-row:hover {
    background-color: rgb(45, 52, 70);
}

.market-pick-row.selected {
    background-color: rgb(16, 56, 92);
}

.market-pick-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(236, 240, 241);
    font-size: 18px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.market-pick-round {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(241, 196, 15);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    width: 24px;
}

.renew-options-row {
    min-height: unset;
    margin-bottom: 8px;
}

.renew-options-toggles {
    flex-direction: row;
    flex-grow: 1;
    margin-left: 8px;
}

.renew-toggle-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    padding: 6px 14px;
    flex-grow: 1;
    -unity-text-align: middle-center;
}

.renew-toggle-btn:hover {
    background-color: rgb(28, 33, 48);
    border-color: rgb(85, 102, 119);
}

.renew-toggle-btn--team-active,
.renew-toggle-btn--team-active:hover {
    color: rgb(39, 174, 96);
    border-color: rgb(39, 174, 96);
    background-color: rgba(39, 174, 96, 0.15);
}

.renew-toggle-btn--player-active,
.renew-toggle-btn--player-active:hover {
    color: rgb(39, 174, 96);
    border-color: rgb(39, 174, 96);
    background-color: rgba(39, 174, 96, 0.15);
}

.renew-toggle-btn--tw-active,
.renew-toggle-btn--tw-active:hover {
    color: rgb(39, 174, 96);
    border-color: rgb(39, 174, 96);
    background-color: rgba(39, 174, 96, 0.15);
}

/* ── TABLE HEADER PHOTO ── */
.market-table-header-photo {
    width: 52px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

/* ══ PAGINACIÓN FA (10 resultados por página) ══ */
.market-pagination {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-height: 48px;
    padding: 6px 24px;
    background-color: rgb(17, 24, 34);
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
}

.market-page-btn {
    width: 38px;
    height: 32px;
    padding: 6px;
    margin: 0 12px;
    align-items: center;
    justify-content: center;
    color: rgb(122, 138, 170);
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 3px;
    -unity-text-align: middle-center;
}

.market-page-btn:hover {
    color: rgb(212, 160, 23);
    border-color: rgb(212, 160, 23);
}

.market-page-jump-btn {
    width: 64px;
    flex-direction: row;
    flex-wrap: nowrap;
}

.market-page-icon {
    width: 18px;
    height: 18px;
    margin: 0;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.market-page-btn:disabled {
    color: rgb(55, 65, 84);
    background-color: rgb(17, 24, 34);
    border-color: rgb(28, 33, 48);
}

.market-page-label {
    min-width: 80px;
    height: 24px;
    flex-shrink: 0;
    font-size: 16px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
}
