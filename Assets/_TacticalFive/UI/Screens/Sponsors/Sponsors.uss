/* ══════════════════════════════════════════
   SPONSORS — Sponsors.uss
   ══════════════════════════════════════════ */

.sponsors-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.sponsors-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.sponsors-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 20px;
    min-height: 0;
    overflow: auto;
}

.panel-sponsors {
    margin-bottom: 20px;
}

.sponsors-current {
    flex-direction: column;
    padding: 16px;
}

.sponsor-current-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 20px;
    color: rgb(208, 216, 232);
    margin-bottom: 8px;
}

.sponsor-current-details {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 14px;
    color: rgb(85, 102, 119);
    margin-bottom: 4px;
}

.sponsor-current-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    color: rgb(39, 174, 96);
}

.sponsors-list {
    flex-direction: column;
}

.sponsor-item {
    flex-direction: row;
    align-items: center;
    padding: 16px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 2px;
    margin-bottom: 8px;
}

.sponsor-info {
    flex-direction: column;
    flex-grow: 1;
    margin-right: 16px;
}

.sponsor-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    margin-bottom: 4px;
}

.sponsor-details {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 12px;
    color: rgb(85, 102, 119);
}

.sponsor-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    color: rgb(39, 174, 96);
    width: 100px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

.btn-sign-sponsor {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 12px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(208, 216, 232);
    background-color: rgb(248, 196, 64);
    border-width: 0;
    border-radius: 2px;
    padding: 8px 16px;
    min-width: 120px;
    -unity-text-align: middle-center;
}

.btn-sign-sponsor:hover {
    background-color: rgb(255, 210, 80);
}

.btn-sign-sponsor:active {
    background-color: rgb(230, 175, 50);
}
