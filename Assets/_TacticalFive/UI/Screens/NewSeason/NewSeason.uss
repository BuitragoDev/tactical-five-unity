/* ── ROOT ── */
.new-season-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ── TOP HEADER (same as EndSeason) ── */
.new-season-root .top-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 28px;
    background-color: rgb(22, 26, 36);
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 160, 23);
    flex-shrink: 0;
    min-height: 100px;
}
.new-season-root .header-left {
    flex-direction: row;
    align-items: center;
}
.new-season-root .header-team-logo {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    margin-right: 16px;
}
.new-season-root .header-team-info {
    flex-direction: column;
}
.new-season-root .header-team-name-row {
    flex-direction: row;
    align-items: baseline;
}
.new-season-root .header-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
    margin-right: 12px;
}
.new-season-root .header-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    letter-spacing: 2px;
    -unity-text-transform: upper;
}
.new-season-root .header-manager-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
}
.new-season-root .header-right-group {
    flex-direction: row;
    align-items: center;
}
.new-season-root .header-season-info {
    flex-direction: column;
    align-items: flex-end;
    margin-right: 20px;
}
.new-season-root .header-date-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    padding: 0 12px;
    margin-right: 20px;
    border-left-width: 1px;
    border-left-color: rgb(42, 51, 71);
    border-right-width: 1px;
    border-right-color: rgb(42, 51, 71);
}
.new-season-root .header-season-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    letter-spacing: 1px;
}

/* ── BOTÓN ACCIÓN ── */
.new-season-root .btn-action {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 250px;
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 18px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.new-season-root .btn-action:hover {
    background-color: rgb(74, 128, 240);
}
.new-season-root .btn-start-season {
    background-color: rgb(23, 119, 63);
}
.new-season-root .btn-start-season:hover {
    background-color: rgb(28, 146, 77);
}

/* ── CONTENT ── */
.new-season-root .content-area {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    padding: 40px 28px;
    overflow-y: auto;
}

/* ── PAGE HEADER ── */
.new-season-root .next-season-header {
    align-items: center;
    margin-bottom: 40px;
}
.new-season-root .page-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 36px;
    letter-spacing: 4px;
    -unity-text-transform: upper;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
}
.new-season-root .season-tag {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
    font-size: 18px;
    letter-spacing: 2px;
    padding: 6px 16px;
    margin-top: 8px;
    -unity-text-align: middle-center;
}

/* ── TEAM SELECTION ── */
.team-selection {
    flex-direction: column;
    width: 100%;
    max-width: 600px;
}
.team-select-card {
    flex-direction: row;
    align-items: center;
    padding: 16px 20px;
    background-color: rgb(22, 26, 36);
    border-width: 2px;
    border-color: rgb(42, 51, 71);
    margin-bottom: 12px;
    flex-shrink: 0;
}
.team-select-card:hover {
    border-color: rgb(58, 74, 99);
    background-color: rgb(28, 33, 48);
}
.team-select-card.selected {
    border-color: rgb(212, 160, 23);
    background-color: rgb(30, 37, 53);
}
.team-select-logo {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    margin-right: 16px;
}
.team-select-info {
    flex-direction: column;
    flex-grow: 1;
}
.team-select-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 1px;
    color: rgb(208, 216, 232);
}
.team-select-detail {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    margin-top: 2px;
}
.team-select-badge {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.1);
    padding: 4px 12px;
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    flex-shrink: 0;
}

/* ── NOTE ── */
.ns-note {
    -unity-text-align: middle-center;
    color: rgb(122, 138, 170);
    font-size: 14px;
    margin-top: 8px;
}

/* ── ROSTER TRIM MODAL ── */
.ns-roster-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    display: none;
}
.ns-roster-box {
    width: 1700px;
    max-height: 90%;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-top-width: 3px;
    border-top-color: rgb(192, 57, 43);
    padding: 28px 24px 20px;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
}
.ns-roster-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 28px;
    letter-spacing: 3px;
    color: rgb(192, 57, 43);
    margin-bottom: 6px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.ns-roster-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 15px;
    color: rgb(122, 138, 170);
    margin-bottom: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-shrink: 0;
}
.ns-roster-count {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(192, 57, 43);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.ns-roster-grid {
    flex-direction: row;
    width: 100%;
    flex-shrink: 1;
    overflow-y: auto;
    min-height: 200px;
}
.ns-roster-col {
    flex: 1;
    flex-direction: column;
    padding: 0 8px;
}
.ns-roster-card {
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 10px 12px;
    margin-bottom: 6px;
}
.ns-roster-card-top {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}
.ns-roster-card-right {
    flex-direction: column;
    flex: 1;
    margin-left: 10px;
}
.ns-roster-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
}
.ns-roster-detail {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}
.ns-roster-med {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 42px;
    min-height: 42px;
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    background-color: rgb(15, 17, 23);
    padding: 3px 6px;
    flex-shrink: 0;
}
.ns-roster-med--high {
    background-color: rgba(39, 174, 96, 0.12);
    border-color: rgb(39, 174, 96);
}
.ns-roster-med--mid {
    background-color: rgba(212, 160, 23, 0.12);
    border-color: rgb(212, 160, 23);
}
.ns-roster-med--low {
    background-color: rgba(192, 57, 43, 0.12);
    border-color: rgb(192, 57, 43);
}
.ns-roster-med-lbl {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 10px;
    letter-spacing: 1px;
    color: inherit;
}
.ns-roster-med--high .ns-roster-med-lbl,
.ns-roster-med--high .ns-roster-med-val {
    color: rgb(39, 174, 96);
}
.ns-roster-med--mid .ns-roster-med-lbl,
.ns-roster-med--mid .ns-roster-med-val {
    color: rgb(212, 160, 23);
}
.ns-roster-med--low .ns-roster-med-lbl,
.ns-roster-med--low .ns-roster-med-val {
    color: rgb(192, 57, 43);
}
.ns-roster-med-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
}
.ns-roster-salary {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 15px;
    color: rgb(208, 216, 232);
    margin-right: 10px;
}
.ns-roster-years {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(122, 138, 170);
}
.ns-roster-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    background-color: rgb(192, 57, 43);
    border-width: 0;
    padding: 5px 10px;
    -unity-text-transform: upper;
    -unity-text-align: middle-center;
}
.ns-roster-btn:hover {
    background-color: rgb(220, 80, 66);
}
.ns-roster-btn--dismissed {
    background-color: rgb(42, 51, 71);
    color: rgb(86, 103, 143);
}
.ns-roster-btn--dismissed:hover {
    background-color: rgb(42, 51, 71);
}
.ns-roster-continue {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 20px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 12px 28px;
    -unity-text-align: middle-center;
    margin-top: 16px;
    flex-shrink: 0;
    background-color: rgb(23, 119, 63);
}
.ns-roster-continue:hover {
    background-color: rgb(28, 146, 77);
}
.ns-roster-continue:disabled {
    background-color: rgb(42, 51, 71);
    color: rgb(86, 103, 143);
}
.ns-roster-continue:disabled:hover {
    background-color: rgb(42, 51, 71);
}

/* ══ Team Option Modal ══ */
.ns-option-box {
    width: 700px;
}
.ns-option-list {
    flex-direction: column;
    padding: 12px 0;
}

.ns-option-row {
    flex-direction: row;
    align-items: center;
    padding: 14px 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
}

.ns-option-info {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
}

.ns-option-btns {
    flex-direction: row;
    gap: 12px;
    flex-shrink: 0;
}

.ns-option-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    border-width: 1px;
    border-radius: 4px;
    padding: 8px 20px;
    color: rgb(208, 216, 232);
    background-color: rgb(28, 33, 48);
    border-color: rgb(42, 51, 71);
}

.ns-option-btn:hover {
    background-color: rgb(38, 43, 58);
}

.ns-option-btn--exercise {
    border-color: rgb(39, 174, 96);
    color: rgb(39, 174, 96);
}

.ns-option-btn--exercise:hover {
    background-color: rgba(39, 174, 96, 0.15);
}

.ns-option-btn--exercise.ns-option-btn--selected {
    background-color: rgba(39, 174, 96, 0.25);
    border-color: rgb(39, 174, 96);
}

.ns-option-btn--decline {
    border-color: rgb(192, 57, 43);
    color: rgb(192, 57, 43);
}

.ns-option-btn--decline:hover {
    background-color: rgba(192, 57, 43, 0.15);
}

.ns-option-btn--decline.ns-option-btn--selected {
    background-color: rgba(192, 57, 43, 0.25);
    border-color: rgb(192, 57, 43);
}
