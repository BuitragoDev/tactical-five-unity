<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Quinteto.uss" />
    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />

    <ui:VisualElement name="QuintetoRoot" class="quinteto-root">

        <!-- ══ MAIN CONTENT ══ -->
        <ui:VisualElement name="QuintetoMain" class="quinteto-main">

            <!-- ══ SCREEN HEADER ══ -->
            <ui:VisualElement class="screen-header panel--gold">
                <ui:VisualElement class="screen-header-row">
                    <ui:VisualElement name="ScreenIcon" class="screen-icon" />
                    <ui:Label class="screen-title" text="{loc:ui.quinteto.quinteto_y_convocatoria}" />
                </ui:VisualElement>
                <ui:Label name="ScreenSubtitle" class="screen-subtitle" text="" />
            </ui:VisualElement>

            <!-- Lineup content -->
            <ui:VisualElement name="LineupContent" class="lineup-content">

                <!-- Left column + right panel -->
                <ui:VisualElement name="LineupColumns" class="lineup-columns">

                    <!-- Column 1: Starters + Court -->
                    <ui:VisualElement class="lineup-col lineup-col--left">

                        <!-- ══ TITULARES ══ -->
                        <ui:VisualElement class="lineup-section">
                            <ui:VisualElement class="lineup-section-header">
                                <ui:Label class="lineup-section-title" text="{loc:ui.quinteto.titulares}" />
                                <ui:Label class="lineup-section-subtitle" text="{loc:ui.quinteto.5_jugadores_en_la_pista}" />
                            </ui:VisualElement>
                            <ui:VisualElement name="StartersList" class="lineup-section-body">
                                <ui:VisualElement name="StarterSlotPG" class="starter-slot" data-pos="PG">
                                    <ui:Label class="starter-slot-label" text="{loc:ui.quinteto.b}" />
                                </ui:VisualElement>
                                <ui:VisualElement name="StarterSlotSG" class="starter-slot" data-pos="SG">
                                    <ui:Label class="starter-slot-label" text="{loc:ui.quinteto.e}" />
                                </ui:VisualElement>
                                <ui:VisualElement name="StarterSlotSF" class="starter-slot" data-pos="SF">
                                    <ui:Label class="starter-slot-label" text="{loc:ui.quinteto.a}" />
                                </ui:VisualElement>
                                <ui:VisualElement name="StarterSlotPF" class="starter-slot" data-pos="PF">
                                    <ui:Label class="starter-slot-label" text="{loc:ui.quinteto.ap}" />
                                </ui:VisualElement>
                                <ui:VisualElement name="StarterSlotC" class="starter-slot" data-pos="C">
                                    <ui:Label class="starter-slot-label" text="{loc:ui.quinteto.p}" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- ══ COURT + AUTO LINEUP ══ -->
                        <ui:VisualElement class="lineup-section lineup-section--court">
                            <ui:VisualElement name="CourtContainer" class="court-container" />
                        </ui:VisualElement>

                    </ui:VisualElement>

                    <!-- Column 2: Bench + Load Management -->
                    <ui:VisualElement class="lineup-col lineup-col--mid">

                        <!-- ══ BANQUILLO ══ -->
                        <ui:VisualElement class="lineup-section">
                            <ui:VisualElement class="lineup-section-header">
                                <ui:Label class="lineup-section-title" text="{loc:ui.quinteto.banquillo}" />
                                <ui:Label class="lineup-section-subtitle" text="{loc:ui.quinteto.7_jugadores_disponibles}" />
                            </ui:VisualElement>
                            <ui:VisualElement name="BenchList" class="lineup-section-body lineup-section-body--drop" />
                        </ui:VisualElement>

                        <!-- ══ LOAD MANAGEMENT ══ -->
                        <ui:VisualElement class="load-mgmt-row">
                            <ui:Button name="LoadMgmtBtnOn" class="load-mgmt-btn load-mgmt-btn--on" text="{loc:ui.quinteto.load_mgmt_btn_on}" />
                            <ui:Button name="LoadMgmtBtnOff" class="load-mgmt-btn load-mgmt-btn--off" text="{loc:ui.quinteto.load_mgmt_btn_off}" />
                        </ui:VisualElement>

                        <!-- ══ PLAN DE PARTIDO ══ -->
                        <ui:VisualElement class="lineup-section">
                            <ui:VisualElement class="lineup-section-header">
                                <ui:Label class="lineup-section-title" text="{loc:ui.quinteto.plan_de_partido}" />
                                <ui:Label class="lineup-section-subtitle" text="{loc:ui.quinteto.ritmo_ataque_defensa}" />
                            </ui:VisualElement>
                            <ui:VisualElement name="GamePlanBody" class="lineup-section-body" />
                        </ui:VisualElement>

                    </ui:VisualElement>

                    <!-- Right panel: NO CONVOCADOS + detail -->
                    <ui:VisualElement class="lineup-col lineup-col--right-panel">

                        <!-- ══ NO CONVOCADOS ══ -->
                        <ui:VisualElement class="lineup-section">
                            <ui:VisualElement class="lineup-section-header">
                                <ui:Label class="lineup-section-title" text="{loc:ui.quinteto.no_convocados}" />
                                <ui:Label class="lineup-section-subtitle" text="{loc:ui.quinteto.6_jugadores_no_seleccionados}" />
                            </ui:VisualElement>
                            <ui:VisualElement name="InactiveList" class="lineup-section-body lineup-section-body--drop" />
                        </ui:VisualElement>

                        <!-- ══ DETAIL PANEL ══ -->
                        <ui:VisualElement name="DetailEmpty" class="detail-empty">
                            <ui:Label class="detail-empty-text" text="{loc:ui.quinteto.pasa_el_raton_sobre_un_jugador}" />
                        </ui:VisualElement>
                        <ui:VisualElement name="DetailScrollRow" class="detail-scroll-row">
                          <ui:VisualElement name="DetailViewport" class="detail-viewport">
                            <ui:VisualElement name="DetailContent" class="detail-content">
                                <ui:VisualElement class="detail-top">
                                    <ui:VisualElement class="detail-name-block">
                                        <ui:Label name="DetailPlayerName" class="detail-player-name" text="" />
                                        <ui:Label name="DetailPlayerMeta" class="detail-player-meta" text="" />
                                        <ui:Label name="DetailPosBadge" class="detail-pos-badge" text="" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="DetailPhoto" class="detail-photo"/>
                                    <ui:VisualElement class="detail-ovr-block">
                                        <ui:Label name="DetailOvr" class="detail-ovr-val" text="" />
                                        <ui:Label class="detail-ovr-label" text="{loc:ui.quinteto.med}" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="DetailAttrs" class="detail-attrs" />
                                <ui:VisualElement name="DetailSeasonStats" class="detail-season-stats">
                                    <ui:VisualElement class="season-stat-card">
                                        <ui:Label name="StatPts" class="season-stat-val" text="0.0" />
                                        <ui:Label class="season-stat-label" text="{loc:ui.quinteto.pts}" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="season-stat-card">
                                        <ui:Label name="StatReb" class="season-stat-val" text="0.0" />
                                        <ui:Label class="season-stat-label" text="{loc:ui.quinteto.reb}" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="season-stat-card">
                                        <ui:Label name="StatAst" class="season-stat-val" text="0.0" />
                                        <ui:Label class="season-stat-label" text="{loc:ui.quinteto.ast}" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="season-stat-card">
                                        <ui:Label name="StatStl" class="season-stat-val" text="0.0" />
                                        <ui:Label class="season-stat-label" text="{loc:ui.quinteto.rob}" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="season-stat-card">
                                        <ui:Label name="StatBlk" class="season-stat-val" text="0.0" />
                                        <ui:Label class="season-stat-label" text="{loc:ui.quinteto.tap}" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                                        </ui:VisualElement>
                          </ui:VisualElement>
                          <ui:VisualElement name="DetailScrollTrack" class="detail-scrollbar">
                            <ui:VisualElement name="DetailScrollThumb" class="detail-scrollbar-thumb" />
                          </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

    <!-- ══ MODAL CONFIGURACIÓN ══ -->
    <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
        <ui:VisualElement name="ConfigModalBox" class="modal-box">
            <ui:Label class="modal-title" text="{loc:ui.quinteto.configuracion}" />
            <ui:VisualElement class="modal-body">
                <ui:VisualElement class="settings-section">
                    <ui:Label class="settings-section-title" text="{loc:ui.quinteto.audio}" />
                    <ui:VisualElement class="settings-row">
                        <ui:Label class="settings-label" text="{loc:ui.quinteto.volumen_general}" />
                        <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                            <ui:VisualElement class="custom-slider-track" />
                            <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                            <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                        </ui:VisualElement>
                        <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-row">
                        <ui:Label class="settings-label" text="{loc:ui.quinteto.musica}" />
                        <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                            <ui:VisualElement class="custom-slider-track" />
                            <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                            <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                        </ui:VisualElement>
                        <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-row">
                        <ui:Label class="settings-label" text="{loc:ui.quinteto.efectos}" />
                        <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                            <ui:VisualElement class="custom-slider-track" />
                            <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                            <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                        </ui:VisualElement>
                        <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="settings-section">
                    <ui:Label class="settings-section-title" text="{loc:ui.quinteto.graficos}" />
                    <ui:VisualElement class="settings-quality-row">
                        <ui:Label class="settings-label" text="{loc:ui.quinteto.calidad}" />
                        <ui:VisualElement class="settings-quality-options">
                            <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="{loc:ui.quinteto.config_btn_quality_low}" />
                            <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="{loc:ui.quinteto.config_btn_quality_medium}" />
                            <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="{loc:ui.quinteto.config_btn_quality_high}" />
                            <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="{loc:ui.quinteto.config_btn_quality_ultra}" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="settings-section">
                    <ui:Label class="settings-section-title" text="{loc:ui.quinteto.juego}" />
                    <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="{loc:ui.quinteto.config_btn_main_menu}" />
                    <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="{loc:ui.quinteto.config_btn_exit}" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="ConfigBtnCerrar" class="modal-close" text="{loc:ui.quinteto.config_btn_cerrar}" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- ══ MODAL CONFIRMAR VOLVER AL MENÚ PRINCIPAL ══ -->
    <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
        <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
            <ui:Label class="modal-title" text="{loc:ui.quinteto.volver_al_menu_principal}" />
            <ui:VisualElement class="modal-body">
                <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.quinteto.estas_seguro_de_que_quieres_volver_al_me_6f548452}" />
                <ui:Label class="modal-paragraph" text="{loc:ui.quinteto.se_perdera_el_progreso_no_guardado_de_la_b10b7334}" />
            </ui:VisualElement>
            <ui:VisualElement class="modal-actions">
                <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="{loc:ui.quinteto.config_btn_main_menu_no}" />
                <ui:VisualElement class="modal-spacer" />
                <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="{loc:ui.quinteto.config_btn_main_menu_yes}" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- ══ MODAL CONFIRMAR SALIR DEL JUEGO ══ -->
    <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
        <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
            <ui:Label class="modal-title" text="{loc:ui.quinteto.salir_del_juego}" />
            <ui:VisualElement class="modal-body">
                <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.quinteto.estas_seguro_de_que_quieres_salir_del_ju_c65dd5f1}" />
                <ui:Label class="modal-paragraph" text="{loc:ui.quinteto.tu_progreso_se_guarda_automaticamente_du_10fb1edb}" />
            </ui:VisualElement>
            <ui:VisualElement class="modal-actions">
                <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="{loc:ui.quinteto.config_btn_exit_no}" />
                <ui:VisualElement class="modal-spacer" />
                <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="{loc:ui.quinteto.config_btn_exit_yes}" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

</ui:UXML>
