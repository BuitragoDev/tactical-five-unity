/* ══ QUINTETO SCREEN ══ */

.quinteto-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
}

.quinteto-main {
    flex-direction: column;
    flex-grow: 1;
    background-color: rgb(18, 18, 18);
}

.quinteto-content {
    flex-grow: 1;
    flex-direction: column;
    padding: 20px;
}

.quinteto-title {
    font-size: 24px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 16px;
}
