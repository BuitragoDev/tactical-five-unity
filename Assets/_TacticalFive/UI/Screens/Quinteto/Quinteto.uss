/* ══ QUINTETO SCREEN ══ */

/* ── SCREEN HEADER ── */
.screen-header.panel--gold {
    flex-shrink: 0;
    padding: 0;
    margin: 16px 20px 12px 20px;
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    background-color: rgba(120, 95, 30, 0.15);
    border-radius: 4px;
    overflow: hidden;
}
.screen-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    background-color: rgba(120, 95, 30, 0.15);
}
.screen-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    white-space: normal;
}
.screen-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(212, 160, 23);
    padding: 0 14px;
    background-color: rgba(120, 95, 30, 0.15);
}

.quinteto-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    min-width: 0;
}

.quinteto-main {
    flex-direction: column;
    flex-grow: 1;
    background-color: rgb(15, 17, 23);
    min-width: 0;
    min-height: 0;
}

.lineup-content {
    flex-grow: 1;
    flex-direction: column;
    padding: 16px 24px;
    min-height: 0;
    min-width: 0;
}

.lineup-columns {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    align-items: flex-start;
    overflow: hidden;
}

.lineup-col {
    width: 500px;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

.lineup-col--left {
    overflow-y: auto;
    margin-right: 30px;
}

.lineup-col--mid {
    overflow-y: auto;
    margin-right: 16px;
}

.lineup-col--right-panel {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
}

/* ══ SECTION CONTAINERS (gold border) ══ */

.lineup-section {
    flex-direction: column;
    border-width: 1px;
    border-color: rgb(120, 95, 30);
    background-color: rgb(18, 21, 28);
    border-radius: 4px;
    margin-bottom: 16px;
}

.lineup-section--court {
    padding: 10px;
}


.lineup-section-header {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    background-color: rgba(120, 95, 30, 0.15);
    border-bottom-width: 1px;
    border-bottom-color: rgb(120, 95, 30);
}

.lineup-section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    letter-spacing: 2px;
    margin-right: 12px;
}

.lineup-section-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 13px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
}

.lineup-section-body {
    flex-direction: column;
    padding: 8px;
    min-height: 0;
}

.lineup-section-body--drop {
    background-color: rgba(255, 255, 255, 0.01);
    min-height: 60px;
}

/* ══ COURT ══ */

.court-container {
    width: 100%;
    height: 363px;
    flex-shrink: 0;
    position: relative;
    background-size: contain;
    background-position: center top;
    background-repeat: no-repeat;
}

.court-card {
    position: absolute;
    translate: -50% -50%;
    padding: 2px 6px;
    background-color: rgba(20, 20, 20, 0.85);
    border: 1px solid rgba(76, 175, 80, 0.5);
    border-radius: 3px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    pointer-events: none;
}

.court-card-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(220, 220, 220);
    -unity-text-align: middle-center;
}

/* ══ AUTO LINEUP BUTTON ══ */

.lineup-auto-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    padding: 14px 48px;
    border-radius: 8px;
    border-width: 2px;
    -unity-text-align: middle-center;
    background-color: rgba(212, 160, 23, 0.10);
    border-color: rgb(212, 160, 23);
    color: rgb(212, 160, 23);
    cursor: pointer;
}

.lineup-auto-btn:hover {
    background-color: rgba(212, 160, 23, 0.25);
    color: rgb(240, 200, 80);
}

/* ══ STARTER SLOTS ══ */

.starter-slot {
    flex-direction: row;
    align-items: center;
    max-height: 60px;
    padding: 6px 10px;
    background-color: rgb(22, 26, 36);
    border: 1px solid rgb(40, 48, 62);
    border-radius: 4px;
    margin-bottom: 6px;
}

.starter-slot--empty {
    border-style: dashed;
    border-color: rgb(60, 60, 60);
    background-color: rgba(255, 255, 255, 0.02);
}

.starter-slot-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(140, 140, 140);
    width: 30px;
    -unity-text-align: middle-center;
}

/* ══ BENCH & INACTIVE SLOTS ══ */

.bench-slot, .inactive-slot {
    flex-direction: row;
    align-items: center;
    max-height: 60px;
    padding: 6px 10px;
    background-color: rgb(22, 26, 36);
    border: 1px solid rgb(40, 48, 62);
    border-radius: 4px;
    margin-bottom: 6px;
}
.bench-slot--empty, .inactive-slot--empty {
    border-style: dashed;
    border-color: rgb(60, 60, 60);
    background-color: rgba(255, 255, 255, 0.02);
    justify-content: center;
}
.bench-slot--empty:hover, .inactive-slot--empty:hover {
    background-color: rgba(42, 95, 201, 0.12);
}
.bench-slot-label, .inactive-slot-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    color: rgb(70, 70, 70);
    -unity-text-align: middle-center;
    width: 100%;
}

/* ══ TRANSFER BUTTON ══ */

.slot-transfer-btn {
    width: 48px;
    height: 48px;
    padding: 4px 4px;
    background-color: rgb(42, 95, 201);
    border-radius: 4px;
    border-width: 0;
    flex-shrink: 0;
    align-self: center;
    margin-left: auto;
    margin-right: 4px;
    background-size: 32px 32px;
    background-position: center;
    background-repeat: no-repeat;
}
.slot-transfer-btn:hover {
    background-color: rgb(60, 120, 240);
}

/* ══ LOAD MANAGEMENT ══ */

.load-mgmt-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.load-mgmt-btn {
    flex: 1;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    padding: 14px 48px;
    border-radius: 8px;
    border-width: 2px;
    -unity-text-align: middle-center;
}

.load-mgmt-btn--on {
    background-color: rgba(39, 174, 96, 0.10);
    border-color: rgb(39, 174, 96);
    color: rgb(100, 210, 140);
    margin-right: 6px;
}

.load-mgmt-btn--on:hover {
    background-color: rgba(39, 174, 96, 0.25);
}

.load-mgmt-btn--off {
    background-color: rgba(42, 95, 201, 0.10);
    border-color: rgb(42, 95, 201);
    color: rgb(120, 160, 230);
    margin-left: 6px;
}

.load-mgmt-btn--off:hover {
    background-color: rgba(42, 95, 201, 0.25);
}

.load-mgmt-btn--on.load-mgmt-btn--active {
    border-color: rgb(212, 160, 23);
}

.load-mgmt-btn--off.load-mgmt-btn--active {
    border-color: rgb(212, 160, 23);
}

/* ══ PLAYER CARDS ══ */

.player-card {
    flex-direction: row;
    align-items: center;
    padding: 2px 10px;
    border: 2px solid rgb(40, 48, 62);
    border-radius: 4px;
    flex-grow: 1;
    flex-shrink: 0;
    margin-bottom: 6px;
}

.player-card:hover {
    border: 2px solid rgb(10, 146, 10);
}

.player-card-avatar {
    width: 52px;
    height: 52px;
    border-radius: 26px;
    background-color: rgb(200, 200, 200);
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
    margin-right: 8px;
    margin-top: 8px;
}

.player-card-info {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
}

.player-card-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(220, 220, 220);
    overflow: hidden;
    height: auto;
    margin-top: 6px;
}

.player-card-meta {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

/* ══ PLAYER CARD BADGES ══ */

.player-card-badge {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 13px;
    letter-spacing: 1px;
    padding: 0px 8px;
    border-radius: 3px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-right: 6px;
}

.player-card-badge--pos {
    background-color: rgba(42, 95, 201, 0.25);
    color: rgb(120, 160, 230);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    width: 60px;
}

.player-card-badge--high {
    background-color: rgba(39, 174, 96, 0.25);
    color: rgb(100, 210, 140);
    border-width: 1px;
    border-color: rgb(39, 174, 96);
    width: 70px;
}

.player-card-badge--mid {
    background-color: rgba(212, 160, 23, 0.25);
    color: rgb(230, 190, 70);
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    width: 70px;
}

.player-card-badge--low {
    background-color: rgba(192, 57, 43, 0.25);
    color: rgb(231, 100, 85);
    border-width: 1px;
    border-color: rgb(192, 57, 43);
    width: 70px;
}

.player-card-gl-badge {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: rgb(255, 255, 255);
    background-color: rgb(52, 152, 219);
    border-radius: 4px;
    padding-left: 6px;
    padding-right: 6px;
    margin-left: 8px;
    margin-bottom: 2px;
}

.slot-role-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    flex-shrink: 0;
    background-color: transparent;
}

.player-card--starter {
    border-color: rgb(60, 80, 60);
}

.player-card--bench {
    border-color: rgb(45, 50, 55);
}

.player-card--inactive {
    border-color: rgb(40, 40, 40);
}

.slot--selected {
    border-color: rgb(10, 146, 10);
    border-width: 2px;
}
.slot--selected .player-card-name {
    color: rgb(200, 255, 200);
}

.slot--injured {
    background-color: rgb(60, 20, 20);
}
.slot--injured > .player-card {
    border-color: rgb(120, 30, 30);
}

/* ══ PLAYER DETAIL PANEL ══ */
.detail-empty {
    min-height: 200px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: rgb(120, 95, 30);
}

.detail-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(58, 74, 99);
    -unity-text-align: middle-center;
}

.detail-scroll {
    flex-grow: 1;
    min-height: 0;
    border-width: 1px;
    border-color: rgb(120, 95, 30);
}

.detail-top {
    flex-direction: row;
    align-items: center;
    padding: 18px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(120, 95, 30);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    flex-shrink: 0;
}

.detail-name-block {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.detail-player-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(255, 255, 255);
    text-transform: uppercase;
    letter-spacing: 1px;
    white-space: normal;
}

.detail-player-meta {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    margin-top: 2px;
    margin-bottom: 6px;
}

.detail-pos-badge {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: rgb(255, 255, 255);
    background-color: rgba(42, 95, 201, 0.25);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    padding: 2px 10px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    align-self: flex-start;
}

.detail-photo {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
    margin-left: 12px;
    margin-right: 12px;
    background-color: rgb(40, 48, 62);
}

.detail-ovr-block {
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
}

.detail-ovr-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 36px;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-center;
}

.detail-ovr--high {
    color: rgb(39, 174, 96);
}
.detail-ovr--mid {
    color: rgb(212, 160, 23);
}
.detail-ovr--low {
    color: rgb(192, 57, 43);
}

.detail-ovr-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
}

.detail-attrs {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 8px 16px;
    flex-shrink: 0;
}

.attr-badge {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100px;
    height: 46px;
    padding: 6px 4px;
    margin: 3px;
    border-radius: 4px;
    background-color: rgb(39, 174, 96);
    flex-shrink: 0;
}

.attr-badge--mid {
    background-color: rgb(212, 160, 23);
}

.attr-badge--low {
    background-color: rgb(192, 57, 43);
}

.attr-badge-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 13px;
    letter-spacing: 0.5px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.attr-badge-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: nowrap;
    margin-top: 2px;
}

.detail-season-stats {
    flex-direction: row;
    justify-content: center;
    flex-shrink: 0;
    margin: 12px 16px;
}

.season-stat-card {
    flex-direction: column;
    align-items: center;
    background-color: rgba(42, 95, 201, 0.08);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    border-radius: 4px;
    padding: 6px 10px;
    margin-right: 6px;
    width: 90px;
}

.season-stat-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-center;
}

.season-stat-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
}

/* ── PLAN DE PARTIDO ── */
.plan-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}
.plan-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 96px;
    flex-shrink: 0;
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(150, 162, 186);
}
.plan-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    flex: 1;
    margin-left: 6px;
    font-size: 15px;
    letter-spacing: 1px;
    padding: 8px 6px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(60, 70, 92);
    background-color: rgba(42, 95, 201, 0.08);
    color: rgb(150, 162, 186);
    -unity-text-align: middle-center;
    cursor: pointer;
}
.plan-btn:hover {
    background-color: rgba(42, 95, 201, 0.20);
}
.plan-btn--active {
    border-color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.15);
    color: rgb(248, 196, 64);
}
.plan-caption {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(150, 162, 186);
    white-space: normal;
    margin-top: 4px;
}
