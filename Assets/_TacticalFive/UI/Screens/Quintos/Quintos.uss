/* ══════════════════════════════════════════
   QUINTOS — Quintos.uss
   ══════════════════════════════════════════ */

/* ── ROOT ── */
.qt-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ═══════════════════════════════════════════
   HEADER (PlayerAwards style)
   ═══════════════════════════════════════════ */
.qt-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 12px 28px;
    background-color: rgb(22, 26, 36);
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 160, 23);
    flex-shrink: 0;
    min-height: 80px;
}

.qt-header-left {
    flex-direction: row;
    align-items: center;
}

.qt-header-logo {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    margin-right: 16px;
}

.qt-header-info {
    flex-direction: column;
}

.qt-header-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
}

.qt-header-manager {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
}

.qt-header-right {
    flex-direction: row;
    align-items: center;
}

.qt-header-season {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    letter-spacing: 1px;
    margin-right: 16px;
}

.qt-header-date {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    padding: 0 16px;
    margin-right: 20px;
    border-left-width: 1px;
    border-left-color: rgb(42, 51, 71);
    border-right-width: 1px;
    border-right-color: rgb(42, 51, 71);
}

.qt-btn-end {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    min-width: 250px;
    background-color: rgba(42, 95, 201, 0.10);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(120, 160, 230);
    font-size: 22px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 18px;
    -unity-text-align: middle-center;
    border-radius: 8px;
    flex-shrink: 0;
    cursor: pointer;
}
.qt-btn-end:hover {
    background-color: rgba(42, 95, 201, 0.25);
    color: rgb(150, 190, 255);
}

/* ═══════════════════════════════════════════
   SCREEN HEADER
   ═══════════════════════════════════════════ */
.qt-screen-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 38px 32px;
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/Backgrounds/banner_premios.png");
    background-size: cover;
    background-position: center;
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 160, 23);
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
}

.qt-screen-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(22, 26, 36, 0.82);
}

.qt-screen-title-group {
    flex-direction: column;
}

.qt-screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 56px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
}

.qt-screen-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 24px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    margin-top: 4px;
}

/* ═══════════════════════════════════════════
   CONTENT — 2 COLUMNS
   ═══════════════════════════════════════════ */
.qt-content {
    flex-direction: row;
    flex-grow: 1;
    padding: 20px 24px;
    overflow-y: auto;
}

/* ═══════════════════════════════════════════
   PANEL (each quintet)
   ═══════════════════════════════════════════ */
.qt-panel {
    flex-direction: column;
    flex-grow: 1;
    background-color: rgb(17, 24, 34);
    border-width: 2px;
    padding: 20px 24px;
    margin-right: 16px;
}
.qt-panel:last-child {
    margin-right: 0;
}

.qt-panel--gold {
    border-color: rgb(212, 160, 23);
}

.qt-panel--blue {
    border-color: rgb(0, 140, 200);
}

/* ── PANEL HEADER ── */
.qt-panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
}

.qt-panel-title-group {
    flex-direction: column;
}

.qt-panel-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
}

.qt-panel-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    margin-top: 2px;
}

.qt-panel-subtitle--gold {
    color: rgb(212, 160, 23);
}

.qt-panel-subtitle--blue {
    color: rgb(0, 188, 200);
}

/* ── TROPHY BADGE ── */
.qt-trophy-badge {
    padding: 6px 14px;
    align-items: center;
    justify-content: center;
}

.qt-trophy-badge--gold {
    border-width: 1px;
    border-color: rgb(212, 160, 23);
}

.qt-trophy-badge--blue {
    border-width: 1px;
    border-color: rgb(0, 140, 200);
}

.qt-trophy-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
}

.qt-trophy-badge--gold .qt-trophy-label {
    color: rgb(212, 160, 23);
}

.qt-trophy-badge--blue .qt-trophy-label {
    color: rgb(0, 188, 200);
}

/* ── PANEL DESC ── */
.qt-panel-desc {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    margin-bottom: 16px;
}

/* ═══════════════════════════════════════════
   ROWS
   ═══════════════════════════════════════════ */
.qt-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 12px;
}
.qt-row:last-child {
    margin-bottom: 0;
}

.qt-row--top {
    justify-content: center;
}

.qt-row--bottom {
    justify-content: center;
}

/* ═══════════════════════════════════════════
   PLAYER CARD
   ═══════════════════════════════════════════ */
.qt-player-card {
    flex-direction: column;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    padding: 12px 14px 14px 14px;
    flex-grow: 1;
    margin-right: 10px;
    position: relative;
}
.qt-player-card:last-child {
    margin-right: 0;
}

.qt-player-card--gold {
    border-color: rgb(80, 70, 40);
}

.qt-player-card--blue {
    border-color: rgb(30, 60, 80);
}

/* ── POSITION BADGE ── */
.qt-pos-badge {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    padding: 2px 10px;
    align-self: flex-start;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.qt-pos-badge--gold {
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
}

.qt-pos-badge--blue {
    background-color: rgb(0, 140, 200);
    color: rgb(255, 255, 255);
}

/* ── PHOTO ── */
.qt-player-photo {
    width: 100px;
    height: 100px;
    background-size: cover;
    background-position: top center;
    margin-bottom: 8px;
}

/* ── PLAYER INFO ── */
.qt-player-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.qt-player-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

/* ── STATS ROW ── */
.qt-stats-row {
    flex-direction: row;
    justify-content: center;
}

.qt-stat-box {
    flex-direction: column;
    align-items: center;
    background-color: rgb(17, 24, 34);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 4px 10px;
    min-width: 48px;
    margin-right: 6px;
}
.qt-stat-box:last-child {
    margin-right: 0;
}

.qt-stat-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.qt-stat-lbl {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 12px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}
