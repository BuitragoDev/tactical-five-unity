<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="../Vestuario/Vestuario.uss" />
    <Style src="../Dashboard/Dashboard.uss" />

    <ui:VisualElement name="VestuarioRoot" class="vestuario-root">

        <!-- ══ SIDEBAR ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="vestuario-main">

            <!-- TOP HEADER -->
            <ui:VisualElement name="TopHeader" class="top-header">
                <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo" />
                <ui:VisualElement class="header-team-info">
                    <ui:Label name="HeaderTeamName"    class="header-team-name"    text="" />
                    <ui:Label name="HeaderManagerName" class="header-manager-name" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="PRESUPUESTO" />
                    <ui:Label name="HeaderBudget" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MASA SALARIAL" />
                    <ui:Label name="HeaderPayroll" class="header-stat-value header-stat-value--neutral" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MARGEN SALARIAL" />
                    <ui:Label name="HeaderMargin" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="QUÍMICA DE EQUIPO" />
                    <ui:Label name="HeaderChemistry" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-spacer" />
                <ui:VisualElement class="header-season-info">
                    <ui:Label name="HeaderSeason" class="header-season-label" text="" />
                    <ui:Label name="HeaderDate"   class="header-date-label"   text="" />
                </ui:VisualElement>
                <ui:Button name="BtnAction" class="btn-action" text="DASHBOARD" />
                <ui:VisualElement name="ConfigIcon" class="header-config-icon" />
            </ui:VisualElement>

            <!-- CONTENT -->
            <ui:VisualElement class="vestuario-content">

                <!-- TITLE BOX -->
                <ui:VisualElement class="vestuario-title-box">
                    <ui:Label text="RELACIONES DEL VESTUARIO" class="vestuario-title-box-label" />
                </ui:VisualElement>

                <!-- VESTUARIO OVERVIEW -->
                <ui:VisualElement name="VestuarioOverview" class="vestuario-overview">
                    <ui:Label class="section-title" text="QUÍMICA DEL VESTUARIO" />
                    <ui:VisualElement class="vestuario-stats">
                        <ui:VisualElement name="ChemRing" class="vestuario-chem-ring">
                            <ui:Label name="ChemRingVal" class="vestuario-chem-ring-val" text="--" />
                        </ui:VisualElement>
                        <ui:VisualElement class="vestuario-chem-info">
                            <ui:Label name="ChemLabel" class="vestuario-chem-label" text="Química de equipo" />
                            <ui:Label name="ChemDesc" class="vestuario-chem-desc" text="" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- LEGEND -->
                <ui:VisualElement name="PersonalitiesLegend" class="personalities-legend" />

                <!-- TWO-COLUMN CONTENT -->
                <ui:VisualElement class="vestuario-two-col">
                    <ui:VisualElement class="vestuario-col">
                        <ui:Label class="section-title" text="PERSONALIDADES" />
                        <ui:VisualElement class="col-scroll-wrap">
                            <ui:ScrollView name="PersonalitiesScrollView" class="col-scroll-view"
                                           horizontal-scrolling-enabled="false"
                                           mode="Vertical">
                                <ui:VisualElement name="PersonalitiesBody" class="personalities-body" />
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="vestuario-col vestuario-col--right">
                        <ui:Label class="section-title" text="RELACIONES ENTRE JUGADORES" />
                        <ui:VisualElement class="col-scroll-wrap">
                            <ui:ScrollView name="RelationsScrollView" class="col-scroll-view"
                                           horizontal-scrolling-enabled="false"
                                           mode="Vertical">
                                <ui:VisualElement name="RelationsBody" class="relations-body" />
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
