/* ══ ROOT ══ */
.training-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
}
.training-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

/* ══ CONTENT TWO PANELS ══ */
.training-content {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    padding: 16px;
    overflow: hidden;
}

.training-left {
    flex: 1;
    flex-basis: 0;
    margin-right: 12px;
    min-width: 0;
    overflow: hidden;
}

.training-scroll {
    flex-grow: 1;
}

.training-body {
    flex-direction: column;
}

.training-right {
    width: 500px;
}

.training-right-body {
    flex-direction: column;
    height: 100%;
}

/* ══ POSITION SECTION ══ */
.pos-section {
    flex-direction: column;
    margin-bottom: 8px;
}

.pos-header {
    flex-direction: row;
    align-items: center;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    margin-bottom: 4px;
}

.pos-badge {
    width: 28px;
    height: 20px;
    background-color: rgb(212, 160, 23);
    border-radius: 3px;
    font-size: 16px;
    color: rgb(11, 14, 20);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.pos-label {
    font-size: 16px;
    color: rgb(122, 138, 170);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    margin-left: 12px;
    letter-spacing: 2px;
}

/* ══ TRAINING PLAYER ROW ══ */
.training-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    background-color: rgb(22, 26, 36);
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    cursor: pointer;
}

.training-row:hover {
    background-color: rgb(28, 33, 48);
}

.training-row--selected {
    background-color: rgb(20, 28, 48);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}

.training-row--selected:hover {
    background-color: rgb(20, 28, 48);
}

.training-row-name {
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    flex-grow: 1;
    margin-left: 8px;
}

.training-row-ovr {
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 32px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.training-row-ovr-text {
    font-size: 11px;
    color: rgb(80, 94, 120);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 28px;
    margin-left: 4px;
    -unity-text-align: middle-left;
    flex-shrink: 0;
}

.training-badge {
    width: 40px;
    height: 24px;
    background-color: rgb(42, 95, 201);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-left: 8px;
}

.training-badge-label {
    font-size: 12px;
    color: white;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    -unity-text-align: middle-center;
}

/* ══ STAFF CARD (asistente) ══ */
.training-staff-section {
    flex-direction: column;
    margin-bottom: 12px;
}

.training-staff-card {
    flex-direction: row;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    padding: 12px;
}

.training-staff-icon {
    width: 64px;
    height: 64px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
    margin-right: 12px;
}

.training-staff-info {
    flex-direction: column;
    flex-grow: 1;
}

.training-staff-name {
    font-size: 24px;
    color: rgb(208, 216, 232);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.training-staff-stars {
    flex-direction: row;
    margin-bottom: 4px;
}

.training-staff-star {
    width: 18px;
    height: 18px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 2px;
}

.training-staff-star--empty {
    opacity: 0.25;
}

.training-staff-interest {
    font-size: 18px;
    color: rgb(212, 160, 23);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

.training-no-staff {
    display: none;
    flex-direction: column;
    align-items: center;
    padding: 20px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
}

.training-no-staff-label {
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.training-btn-hire {
    width: 100%;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    background-color: rgb(42, 95, 201);
    color: white;
    border-width: 0;
    border-radius: 4px;
    padding: 10px;
    cursor: pointer;
    -unity-text-align: middle-center;
}

.training-btn-hire:hover {
    background-color: rgb(52, 115, 231);
}

/* ══ PLAYER INFO ══ */
.training-player-info {
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    padding: 12px 14px;
    margin-bottom: 8px;
    display: none;
}

.training-player-info--visible {
    display: flex;
}

.training-player-name {
    font-size: 24px;
    color: rgb(208, 216, 232);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.training-player-meta {
    font-size: 16px;
    color: rgb(122, 138, 170);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

/* ══ ATTR PANEL ══ */
.training-attr-panel {
    flex-direction: column;
    flex-grow: 1;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    overflow: hidden;
}

.training-attr-title {
    font-size: 16px;
    color: rgb(122, 138, 170);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    letter-spacing: 2px;
    padding: 12px 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
}

.training-attr-scroll {
    flex-grow: 1;
}

.training-attr-body {
    flex-direction: column;
}

/* ══ ATTR ROW ══ */
.training-attr-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 51, 71, 0.4);
}

.training-attr-btn {
    width: 100px;
    height: 28px;
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-radius: 4px;
    background-color: rgb(39, 174, 96);
    flex-shrink: 0;
    cursor: pointer;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: white;
    letter-spacing: 1px;
    padding-left: 10px;
    padding-right: 10px;
    -unity-text-align: middle-center;
}

.training-attr-btn:hover {
    opacity: 0.8;
}

.training-attr-btn--disabled {
    background-color: rgb(42, 51, 71);
    color: rgb(122, 138, 170);
    cursor: default;
}

.training-attr-btn--disabled:hover {
    opacity: 1;
}

.training-attr-name {
    font-size: 16px;
    color: rgb(208, 216, 232);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    flex-grow: 1;
    margin-left: 12px;
    letter-spacing: 1px;
}

.training-attr-value {
    font-size: 20px;
    color: rgb(208, 216, 232);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 32px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

/* ══ AUTO BUTTON ══ */
.training-btn-auto {
    width: 100%;
    height: 36px;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 3px;
    color: white;
    background-color: rgb(42, 95, 201);
    border-width: 0;
    border-radius: 4px;
    margin-top: 8px;
    cursor: pointer;
    -unity-text-align: middle-center;
}

.training-btn-auto:hover {
    background-color: rgb(52, 115, 231);
}

/* ══ EMPTY STATE ══ */
.training-empty {
    display: flex;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    font-size: 20px;
    color: rgb(58, 74, 99);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    letter-spacing: 2px;
}

/* ══ MODAL ══ */
.training-modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    display: none;
}

.training-modal-overlay--visible {
    display: flex;
}

.training-modal-box {
    width: 480px;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-top-width: 3px;
    border-top-color: rgb(212, 160, 23);
    padding: 32px;
    flex-direction: column;
    align-items: center;
}

.training-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 4px;
    color: rgb(212, 160, 23);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.training-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 20px;
    color: rgb(179, 190, 214);
    -unity-text-align: middle-center;
    margin-bottom: 24px;
    white-space: normal;
}

.training-modal-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    background-color: rgb(212, 160, 23);
    color: white;
    border-width: 0;
    border-radius: 4px;
    padding: 12px 32px;
    cursor: pointer;
}

.training-modal-btn:hover {
    background-color: rgb(232, 180, 43);
}
