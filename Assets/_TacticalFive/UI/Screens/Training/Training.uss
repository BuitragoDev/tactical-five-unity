/* ══ ROOT ══ */
.training-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
}
.training-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

/* ── SCREEN HEADER ── */
.screen-header.panel--gold {
    flex-shrink: 0;
    padding: 0;
    margin: 16px 20px 12px 20px;
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    background-color: rgba(120, 95, 30, 0.15);
    border-radius: 4px;
    overflow: hidden;
}
.screen-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    background-color: rgba(120, 95, 30, 0.15);
}
.screen-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    white-space: normal;
}
.screen-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(212, 160, 23);
    padding: 0 14px;
    background-color: rgba(120, 95, 30, 0.15);
}

/* ══ CONTENT TWO PANELS ══ */
.training-content {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    padding: 16px;
    overflow: hidden;
}

.training-left {
    flex: 1;
    flex-basis: 0;
    margin-right: 12px;
    min-width: 0;
    overflow: hidden;
}

.training-scroll {
    flex-grow: 1;
}

.training-right {
    width: 500px;
}

.training-right-body {
    flex-direction: column;
    height: 100%;
}

.training-right-scroll {
    flex-grow: 1;
}

/* ══ POSITION SECTION ══ */
.pos-section {
    flex-direction: column;
    margin-bottom: 8px;
}

.pos-header {
    flex-direction: row;
    align-items: center;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    margin-bottom: 4px;
}

.pos-badge {
    width: 28px;
    height: 20px;
    background-color: rgb(212, 160, 23);
    border-radius: 3px;
    font-size: 16px;
    color: rgb(11, 14, 20);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.pos-label {
    font-size: 16px;
    color: rgb(122, 138, 170);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    margin-left: 12px;
    letter-spacing: 2px;
}

/* ══ PLANTILLA SECTION ══ */
.training-section {
    flex-direction: column;
    border-width: 1px;
    border-color: rgb(120, 95, 30);
    background-color: rgb(18, 21, 28);
    border-radius: 4px;
    margin-bottom: 16px;
}

.training-section-header {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    background-color: rgba(120, 95, 30, 0.15);
    border-bottom-width: 1px;
    border-bottom-color: rgb(120, 95, 30);
}

.training-section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    letter-spacing: 2px;
}

.training-section-body {
    padding: 8px;
}

/* ══ TRAINING PLAYER CARD ══ */
.training-cards-grid {
    flex-wrap: wrap;
    flex-direction: row;
    justify-content: center;
}

.training-card {
    flex-direction: column;
    width: 24%;
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: auto;
    min-width: 0;
    background-color: rgb(18, 24, 38);
    border-width: 1px;
    border-color: rgb(50, 90, 160);
    border-radius: 6px;
    margin-bottom: 10px;
    margin-left: 5px;
    margin-right: 5px;
    padding: 10px;
    cursor: pointer;
}

.training-card:hover {
    background-color: rgb(22, 30, 48);
    border-color: rgb(50, 75, 120);
}

.training-card--selected {
    background-color: rgb(20, 32, 55);
    border-color: rgb(212, 160, 23);
    border-width: 2px;
}

.training-card--selected:hover {
    background-color: rgb(20, 32, 55);
    border-color: rgb(212, 160, 23);
}

.training-card-top-row {
    flex-direction: row;
    align-items: flex-start;
}

.training-card-photo {
    width: 100px;
    height: 100px;
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
    margin-right: 10px;
}

.training-card-info {
    flex-direction: column;
    align-items: flex-start;
    flex-grow: 1;
    min-width: 0;
}

.training-card-name {
    flex-direction: column;
}

.training-card-firstname {
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

.training-card-lastname {
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.training-card-bottom {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.training-card-pos-badge {
    height: 22px;
    padding: 0 8px;
    background-color: rgb(42, 95, 201);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
}

.training-card-pos-badge-label {
    font-size: 16px;
    color: white;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    -unity-text-align: middle-center;
}

.training-card-med-badge {
    height: 22px;
    padding: 0 8px;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    margin-left: 6px;
    flex-shrink: 0;
}

.training-card-med-badge--high {
    background-color: rgba(39, 174, 96, 0.25);
}
.training-card-med-badge--mid {
    background-color: rgba(212, 160, 23, 0.25);
}
.training-card-med-badge--low {
    background-color: rgba(192, 57, 43, 0.25);
}

.training-card-med-badge-label {
    font-size: 16px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    -unity-text-align: middle-center;
}

.training-card-med-badge-label--high {
    color: rgb(39, 174, 96);
}
.training-card-med-badge-label--mid {
    color: rgb(212, 160, 23);
}
.training-card-med-badge-label--low {
    color: rgb(192, 57, 43);
}

.training-card-badge {
    width: 100%;
    padding: 0 8px;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    margin-top: 6px;
}

.training-card-badge-label {
    font-size: 18px;
    color: white;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    -unity-text-align: middle-center;
    letter-spacing: 0.5px;
}

.training-card-badge--none {
    background-color: rgb(42, 51, 71);
}

.training-card-badge--none .training-card-badge-label {
    color: rgb(122, 138, 170);
}

/* ══ STAFF CARD (asistente) ══ */
.training-staff-section {
    flex-direction: column;
    margin-bottom: 12px;
}

.training-staff-card {
    flex-direction: row;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    padding: 12px;
}

.training-staff-icon {
    width: 100px;
    height: 100px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
    margin-right: 12px;
}

.training-staff-info {
    flex-direction: column;
    flex-grow: 1;
}

.training-staff-name {
    font-size: 24px;
    color: rgb(208, 216, 232);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.training-staff-stars {
    flex-direction: row;
    margin-bottom: 4px;
}

.training-staff-star {
    width: 18px;
    height: 18px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 2px;
}

.training-staff-star--empty {
    opacity: 0.25;
}

.training-staff-interest {
    font-size: 18px;
    color: rgb(212, 160, 23);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

.training-no-staff {
    display: none;
    flex-direction: column;
    align-items: center;
    padding: 20px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
}

.training-no-staff-label {
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.training-btn-hire {
    width: 100%;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    letter-spacing: 2px;
    background-color: rgba(42, 95, 201, 0.10);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(120, 160, 230);
    border-radius: 8px;
    padding: 12px 20px;
    cursor: pointer;
    -unity-text-align: middle-center;
}

.training-btn-hire:hover {
    background-color: rgba(42, 95, 201, 0.25);
    color: rgb(150, 190, 255);
}

/* ══ PLAYER INFO ══ */
.training-player-info {
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    padding: 12px 14px;
    margin-bottom: 8px;
    display: none;
}

.training-player-info--visible {
    display: flex;
}

.training-player-name {
    font-size: 24px;
    color: rgb(208, 216, 232);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.training-player-meta {
    font-size: 16px;
    color: rgb(122, 138, 170);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

/* ══ ATTR PANEL ══ */
.training-attr-panel {
    flex-direction: column;
    flex-grow: 1;
    border-width: 1px;
    border-color: rgb(120, 95, 30);
    background-color: rgb(18, 21, 28);
    border-radius: 4px;
    overflow: hidden;
}

.training-attr-title {
    font-size: 16px;
    color: rgb(212, 160, 23);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    letter-spacing: 2px;
    padding: 10px 14px;
    background-color: rgba(120, 95, 30, 0.15);
    border-bottom-width: 1px;
    border-bottom-color: rgb(120, 95, 30);
}

.training-attr-scroll {
    flex-grow: 1;
}

.training-attr-body {
    flex-direction: column;
}

/* ══ ATTR ROW ══ */
.training-attr-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 51, 71, 0.4);
}

.training-attr-btn {
    width: 100px;
    height: 28px;
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-radius: 4px;
    background-color: rgb(39, 174, 96);
    flex-shrink: 0;
    cursor: pointer;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: white;
    letter-spacing: 1px;
    padding-left: 10px;
    padding-right: 10px;
    -unity-text-align: middle-center;
}

.training-attr-btn:hover {
    opacity: 0.8;
}

.training-attr-btn--disabled {
    background-color: rgb(42, 51, 71);
    color: rgb(122, 138, 170);
    cursor: default;
}

.training-attr-btn--disabled:hover {
    opacity: 1;
}

.training-attr-name {
    font-size: 16px;
    color: rgb(208, 216, 232);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    flex-grow: 1;
    margin-left: 12px;
    letter-spacing: 1px;
}

.training-attr-value {
    font-size: 20px;
    color: rgb(208, 216, 232);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 32px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.training-attr-value--high {
    color: rgb(39, 174, 96);
}

.training-attr-value--mid {
    color: rgb(212, 160, 23);
}

.training-attr-value--low {
    color: rgb(192, 57, 43);
}

/* ══ BUTTONS ROW ══ */
.training-btn-row {
    flex-direction: row;
    width: 100%;
    flex-shrink: 0;
    margin-top: 8px;
    margin-bottom: 8px;
}

/* ══ AUTO BUTTON ══ */
.training-btn-auto {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 2px;
    padding: 14px 48px;
    border-radius: 8px;
    border-width: 2px;
    -unity-text-align: middle-center;
    background-color: rgba(42, 95, 201, 0.10);
    border-color: rgb(42, 95, 201);
    color: rgb(120, 160, 230);
    cursor: pointer;
    margin-right: 6px;
}

.training-btn-auto:hover {
    background-color: rgba(42, 95, 201, 0.25);
}

/* ══ RESETEAR BUTTON ══ */
.training-btn-reset {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 2px;
    padding: 14px 48px;
    border-radius: 8px;
    border-width: 2px;
    -unity-text-align: middle-center;
    background-color: rgba(100, 110, 130, 0.10);
    border-color: rgb(100, 110, 130);
    color: rgb(160, 170, 190);
    cursor: pointer;
    margin-left: 6px;
}

.training-btn-reset:hover {
    background-color: rgba(100, 110, 130, 0.25);
}

/* ══ EMPTY STATE ══ */
.training-empty {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    -unity-text-align: upper-center;
    font-size: 20px;
    color: rgb(58, 74, 99);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    letter-spacing: 2px;
    margin-top: 8px;
}

/* ══ MODAL ══ */
.training-modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    display: none;
}

.training-modal-overlay--visible {
    display: flex;
}

.training-modal-box {
    width: 480px;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-top-width: 3px;
    border-top-color: rgb(212, 160, 23);
    padding: 32px;
    flex-direction: column;
    align-items: center;
}

.training-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 4px;
    color: rgb(212, 160, 23);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.training-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 20px;
    color: rgb(179, 190, 214);
    -unity-text-align: middle-center;
    margin-bottom: 24px;
    white-space: normal;
}

.training-modal-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    background-color: rgb(212, 160, 23);
    color: white;
    border-width: 0;
    border-radius: 4px;
    padding: 12px 32px;
    cursor: pointer;
}

.training-modal-btn:hover {
    background-color: rgb(232, 180, 43);
}
