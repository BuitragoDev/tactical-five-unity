<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Training.uss" />
    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />

    <ui:VisualElement name="TrainingRoot" class="training-root">

        <!-- ══ SIDEBAR ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="training-main">

            <!-- ══ SCREEN HEADER ══ -->
            <ui:VisualElement class="screen-header panel--gold">
                <ui:VisualElement class="screen-header-row">
                    <ui:VisualElement name="ScreenIcon" class="screen-icon" />
                    <ui:Label class="screen-title" text="{loc:ui.training.entrenamientos_personalizados}" />
                </ui:VisualElement>
                <ui:Label name="ScreenSubtitle" class="screen-subtitle" text="" />
            </ui:VisualElement>

            <!-- TOP HEADER -->
            <!-- CONTENT: TWO PANELS -->
            <ui:VisualElement class="training-content">

                <!-- LEFT PANEL -->
                <ui:VisualElement class="training-left">
                    <ui:VisualElement class="training-scroll-row">
                        <ui:VisualElement name="TrainingScrollViewport" class="training-scroll-viewport">
                            <ui:VisualElement name="TrainingScrollContent" class="training-section">
                                <ui:VisualElement class="training-section-header">
                                    <ui:Label class="training-section-title" text="{loc:ui.training.plantilla}" />
                                </ui:VisualElement>
                                <ui:VisualElement name="TrainingBody" class="training-section-body training-cards-grid" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="TrainingScrollTrack" class="training-scrollbar">
                            <ui:VisualElement name="TrainingScrollThumb" class="training-scrollbar-thumb" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- RIGHT PANEL -->
                <ui:VisualElement class="training-right">
                    <ui:VisualElement name="TrainingRightBody" class="training-right-body">
                        <!-- Asistente card -->
                        <ui:VisualElement name="AsistenteSection" class="training-staff-section">
                            <ui:VisualElement name="AsistenteCard" class="training-staff-card" />
                            <ui:VisualElement name="NoAsistente" class="training-no-staff" />
                        </ui:VisualElement>
                        <!-- Fixed buttons -->
                        <ui:VisualElement class="training-btn-row">
                            <ui:Button name="BtnAutoTrain" class="training-btn-auto" text="{loc:ui.training.btn_auto_train}" />
                            <ui:Button name="BtnResetTraining" class="training-btn-reset" text="{loc:ui.training.btn_reset_training}" />
                        </ui:VisualElement>
                        <!-- Scrollable content below buttons -->
                        <ui:ScrollView name="TrainingRightScroll" class="training-right-scroll">
                            <ui:VisualElement name="TrainingPlayerInfo" class="training-player-info">
                                <ui:Label name="TrainingPlayerName" class="training-player-name" text="" />
                                <ui:Label name="TrainingPlayerMeta" class="training-player-meta" text="" />
                            </ui:VisualElement>
                            <ui:VisualElement name="TrainingAttrPanel" class="training-attr-panel">
                                <ui:Label name="AttrPanelTitle" class="training-attr-title" text="{loc:ui.training.attr_panel_title}" />
                                <ui:VisualElement name="TrainingAttrBody" class="training-attr-body" />
                            </ui:VisualElement>
                        </ui:ScrollView>
                        <!-- Empty state -->
                        <ui:Label name="TrainingEmpty" class="training-empty" text="{loc:ui.training.training_empty}" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ══ NO ASISTENTE MODAL ══ -->
        <ui:VisualElement name="NoAsistenteOverlay" class="training-modal-overlay">
            <ui:VisualElement class="training-modal-box">
                <ui:VisualElement class="training-modal-header">
                    <ui:Label class="training-modal-title" text="{loc:ui.training.sin_asistente}" />
                </ui:VisualElement>
                <ui:VisualElement class="training-modal-body">
                    <ui:Label class="training-modal-text" text="{loc:ui.training.no_tienes_un_asistente_contratado_contra_74f417bd}" />
                    <ui:Button name="BtnNoAsistenteOk" class="training-modal-btn" text="{loc:ui.training.btn_no_asistente_ok}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

        <!-- ══ MODAL CONFIGURACIÓN ══ -->
        <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigModalBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.training.configuracion}" />
                <ui:VisualElement class="modal-body">
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.training.audio}" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.training.volumen_general}" />
                            <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.training.musica}" />
                            <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.training.efectos}" />
                            <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.training.graficos}" />
                        <ui:VisualElement class="settings-quality-row">
                            <ui:Label class="settings-label" text="{loc:ui.training.calidad}" />
                            <ui:VisualElement class="settings-quality-options">
                                <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="{loc:ui.training.config_btn_quality_low}" />
                                <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="{loc:ui.training.config_btn_quality_medium}" />
                                <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="{loc:ui.training.config_btn_quality_high}" />
                                <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="{loc:ui.training.config_btn_quality_ultra}" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.training.juego}" />
                        <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="{loc:ui.training.config_btn_main_menu}" />
                        <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="{loc:ui.training.config_btn_exit}" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ConfigBtnCerrar" class="modal-close" text="{loc:ui.training.config_btn_cerrar}" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR VOLVER AL MENÚ PRINCIPAL ══ -->
        <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.training.volver_al_menu_principal}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.training.estas_seguro_de_que_quieres_volver_al_me_6f548452}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.training.se_perdera_el_progreso_no_guardado_de_la_b10b7334}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="{loc:ui.training.config_btn_main_menu_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="{loc:ui.training.config_btn_main_menu_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR SALIR DEL JUEGO ══ -->
        <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.training.salir_del_juego}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.training.estas_seguro_de_que_quieres_salir_del_ju_c65dd5f1}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.training.tu_progreso_se_guarda_automaticamente_du_10fb1edb}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="{loc:ui.training.config_btn_exit_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="{loc:ui.training.config_btn_exit_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

</ui:UXML>
