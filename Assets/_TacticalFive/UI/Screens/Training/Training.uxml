<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Training.uss" />
    <Style src="../Dashboard/Dashboard.uss" />

    <ui:VisualElement name="TrainingRoot" class="training-root">

        <!-- ══ SIDEBAR ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="training-main">

            <!-- TOP HEADER -->
            <ui:VisualElement name="TopHeader" class="top-header">
                <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo" />
                <ui:VisualElement class="header-team-info">
                    <ui:Label name="HeaderTeamName"    class="header-team-name"    text="" />
                    <ui:Label name="HeaderManagerName" class="header-manager-name" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="PRESUPUESTO" />
                    <ui:Label name="HeaderBudget" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MASA SALARIAL" />
                    <ui:Label name="HeaderPayroll" class="header-stat-value header-stat-value--neutral" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MARGEN SALARIAL" />
                    <ui:Label name="HeaderMargin" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="QUÍMICA DE EQUIPO" />
                    <ui:Label name="HeaderChemistry" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-spacer" />
                <ui:VisualElement class="header-season-info">
                    <ui:Label name="HeaderSeason" class="header-season-label" text="" />
                    <ui:Label name="HeaderDate"   class="header-date-label"   text="" />
                </ui:VisualElement>
                <ui:Button name="BtnAction" class="btn-action" text="DASHBOARD" />
                <ui:VisualElement name="ConfigIcon" class="header-config-icon" />
            </ui:VisualElement>

            <!-- TITLE BOX -->
            <ui:VisualElement class="training-title-box">
                <ui:Label text="ENTRENAMIENTO DE JUGADORES" class="training-title-box-label" />
            </ui:VisualElement>

            <!-- CONTENT: TWO PANELS -->
            <ui:VisualElement class="training-content">

                <!-- LEFT PANEL -->
                <ui:VisualElement class="training-left">
                    <ui:ScrollView name="TrainingScroll" class="training-scroll">
                        <ui:VisualElement name="TrainingBody" class="training-body" />
                    </ui:ScrollView>
                </ui:VisualElement>

                <!-- RIGHT PANEL -->
                <ui:VisualElement class="training-right">
                    <ui:VisualElement name="TrainingRightBody" class="training-right-body">
                        <!-- Asistente card -->
                        <ui:VisualElement name="AsistenteSection" class="training-staff-section">
                            <ui:VisualElement name="AsistenteCard" class="training-staff-card" />
                            <ui:VisualElement name="NoAsistente" class="training-no-staff" />
                        </ui:VisualElement>
                        <!-- Player info -->
                        <ui:VisualElement name="TrainingPlayerInfo" class="training-player-info">
                            <ui:Label name="TrainingPlayerName" class="training-player-name" text="" />
                            <ui:Label name="TrainingPlayerMeta" class="training-player-meta" text="" />
                        </ui:VisualElement>
                        <!-- Attr table -->
                        <ui:VisualElement name="TrainingAttrPanel" class="training-attr-panel">
                            <ui:Label name="AttrPanelTitle" class="training-attr-title" text="ENTRENAMIENTOS DISPONIBLES" />
                            <ui:ScrollView name="TrainingAttrScroll" class="training-attr-scroll">
                                <ui:VisualElement name="TrainingAttrBody" class="training-attr-body" />
                            </ui:ScrollView>
                        </ui:VisualElement>
                        <ui:Button name="BtnAutoTrain" class="training-btn-auto" text="AUTO" />
                        <!-- Empty state -->
                        <ui:Label name="TrainingEmpty" class="training-empty" text="SELECCIONA UN JUGADOR" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ══ NO ASISTENTE MODAL ══ -->
        <ui:VisualElement name="NoAsistenteOverlay" class="training-modal-overlay">
            <ui:VisualElement class="training-modal-box">
                <ui:Label class="training-modal-title" text="SIN ASISTENTE" />
                <ui:Label class="training-modal-text" text="No tienes un Asistente contratado. Contrata uno en la sección de Empleados para poder entrenar a tus jugadores." />
                <ui:Button name="BtnNoAsistenteOk" class="training-modal-btn" text="ENTENDIDO" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
