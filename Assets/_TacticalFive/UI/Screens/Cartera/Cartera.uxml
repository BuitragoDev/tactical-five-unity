<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="Cartera.uss" />
    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="../Standings/Standings.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />

    <ui:VisualElement name="CarteraRoot" class="cartera-root">

        <!-- MAIN -->
        <ui:VisualElement class="cartera-main">

            <!-- ══ HEADER ══ -->
            <ui:VisualElement class="screen-header panel--gold">
                <ui:VisualElement class="screen-header-row">
                    <ui:VisualElement name="CarteraScreenIcon" class="screen-icon" />
                    <ui:Label class="screen-title" text="{loc:ui.cartera.gestion_de_la_cartera_de_jugadores}" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- CONTENT -->
            <ui:VisualElement class="cartera-content">

                <!-- PESTAÑAS -->
                <ui:VisualElement class="cartera-topbar">
                    <ui:VisualElement class="standings-tabs cartera-tabs">
                        <ui:Button name="TabOjear" class="standings-tab standings-tab--active" text="{loc:ui.cartera.tab_ojear}" />
                        <ui:Button name="TabCartera" class="standings-tab" text="{loc:ui.cartera.tab_cartera}" />
                        <ui:Button name="TabInformes" class="standings-tab" text="{loc:ui.cartera.tab_informes}" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ══ PÁGINA OJEAR ══ -->
                <ui:VisualElement name="PageOjear" class="cartera-page">
                    <!-- LEFT COLUMN -->
                    <ui:VisualElement class="cartera-left">
                        <ui:Label class="section-title" text="{loc:ui.cartera.ojeador}" />
                        <ui:VisualElement name="OjeadorBody" class="ojeador-body" />
                        <ui:Label class="section-title" text="{loc:ui.cartera.selecciona_un_equipo}" style="margin-top: 18px;" />
                        <ui:ScrollView name="TeamList" class="team-list" horizontal-scrolling-enabled="false" mode="Vertical" />
                    </ui:VisualElement>

                    <!-- RIGHT COLUMN -->
                    <ui:VisualElement class="cartera-right">
                        <ui:Label name="SelectedTeamLabel" class="section-title" text="" style="margin-top: 18px;" />
                        <ui:VisualElement class="cartera-player-scroll-row">
                            <ui:VisualElement name="PlayerListViewport" class="cartera-player-viewport">
                                <ui:VisualElement name="PlayerList" class="player-list" />
                            </ui:VisualElement>
                            <ui:VisualElement name="PlayerListScrollTrack" class="cartera-player-scrollbar">
                                <ui:VisualElement name="PlayerListScrollThumb" class="cartera-player-scrollbar-thumb" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ══ PÁGINA CARTERA ══ -->
                <ui:VisualElement name="PageCartera" class="cartera-page cartera-page--column" style="display: none;">
                    <ui:Label class="section-title" text="{loc:ui.cartera.jugadores_en_cartera}" />
                    <ui:Label class="section-subtitle" text="{loc:ui.cartera.jugadores_que_estas_ojeando_o_cuyo_infor_aa77ebf8}" />
                    <ui:VisualElement name="ScoutSlots" class="scout-slots" />
                </ui:VisualElement>

                <!-- ══ PÁGINA INFORMES ══ -->
                <ui:VisualElement name="PageInformes" class="cartera-page cartera-page--column" style="display: none;">
                    <ui:Label class="section-title" text="{loc:ui.cartera.informes_de_ojeo}" />
                    <ui:Label class="section-subtitle" text="{loc:ui.cartera.historial_de_jugadores_que_has_ojeado_el_5ec4b188}" />
                    <ui:VisualElement class="cartera-table-wrapper">
                        <ui:VisualElement name="InformesTableHeader" class="cartera-table-header" />
                        <ui:VisualElement class="cartera-informes-scroll-row">
                            <ui:VisualElement name="InformesViewport" class="cartera-informes-viewport">
                                <ui:VisualElement name="InformesTableBody" class="cartera-informes-table-body" />
                            </ui:VisualElement>
                            <ui:VisualElement name="InformesScrollTrack" class="cartera-informes-scrollbar">
                                <ui:VisualElement name="InformesScrollThumb" class="cartera-informes-scrollbar-thumb" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

        <!-- ══ MODAL CONFIGURACIÓN ══ -->
        <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigModalBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.cartera.configuracion}" />
                <ui:VisualElement class="modal-body">
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.cartera.audio}" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.cartera.volumen_general}" />
                            <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.cartera.musica}" />
                            <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.cartera.efectos}" />
                            <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.cartera.graficos}" />
                        <ui:VisualElement class="settings-quality-row">
                            <ui:Label class="settings-label" text="{loc:ui.cartera.calidad}" />
                            <ui:VisualElement class="settings-quality-options">
                                <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="{loc:ui.cartera.config_btn_quality_low}" />
                                <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="{loc:ui.cartera.config_btn_quality_medium}" />
                                <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="{loc:ui.cartera.config_btn_quality_high}" />
                                <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="{loc:ui.cartera.config_btn_quality_ultra}" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.cartera.juego}" />
                        <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="{loc:ui.cartera.config_btn_main_menu}" />
                        <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="{loc:ui.cartera.config_btn_exit}" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ConfigBtnCerrar" class="modal-close" text="{loc:ui.cartera.config_btn_cerrar}" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR VOLVER AL MENÚ PRINCIPAL ══ -->
        <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.cartera.volver_al_menu_principal}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.cartera.estas_seguro_de_que_quieres_volver_al_me_6f548452}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.cartera.se_perdera_el_progreso_no_guardado_de_la_b10b7334}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="{loc:ui.cartera.config_btn_main_menu_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="{loc:ui.cartera.config_btn_main_menu_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR SALIR DEL JUEGO ══ -->
        <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.cartera.salir_del_juego}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.cartera.estas_seguro_de_que_quieres_salir_del_ju_c65dd5f1}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.cartera.tu_progreso_se_guarda_automaticamente_du_10fb1edb}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="{loc:ui.cartera.config_btn_exit_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="{loc:ui.cartera.config_btn_exit_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
</ui:UXML>
