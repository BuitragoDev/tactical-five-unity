/* ══════════════════════════════════════════
   CARTERA — Cartera.uss
   ══════════════════════════════════════════ */

.cartera-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.cartera-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.cartera-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 20px 24px;
    min-height: 0;
    overflow-y: auto;
}

/* ── TOPBAR / TABS ── */

.cartera-topbar {
    flex-shrink: 0;
}

.cartera-tabs {
    margin-bottom: 18px;
}

.cartera-page {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.cartera-page--column {
    flex-direction: column;
}

/* ── SECTION TITLES ── */

.section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
    margin-bottom: 12px;
    flex-shrink: 0;
}

.section-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    margin-bottom: 16px;
    flex-shrink: 0;
}

/* ── LEFT COLUMN ── */

.cartera-left {
    flex-direction: column;
    flex: 1 1 47%;
    margin-right: 10px;
    min-width: 0;
}

/* Selector de equipos en fichas (grid, ~5 por fila) */
.team-list {
    flex-direction: column;
    margin-bottom: 16px;
    height: 560px;
    min-height: 560px;
    max-height: 560px;
    flex-grow: 0;
    flex-shrink: 0;
}

.team-list .unity-scroll-view__content-viewport {
    overflow: hidden;
}

.team-list .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.team-select-tile {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 18%;
    min-width: 74px;
    height: 78px;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 5px;
    padding: 8px 4px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    cursor: pointer;
}

.team-select-tile:hover {
    background-color: rgb(28, 33, 48);
    border-color: rgb(85, 102, 119);
}

.team-select-tile--selected {
    background-color: rgb(35, 40, 55);
    border-color: rgb(212, 160, 23);
}

.team-select-tile-logo {
    width: 40px;
    height: 40px;
    margin-bottom: 6px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.team-select-tile-abbrev {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    letter-spacing: 1px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
}

/* ── SORT BAR ── */

.player-list {
    flex-direction: column;
    flex-grow: 1;
    min-height: 200px;
}

/* ── PLAYER ROWS (ricas) ── */

.players-wrapper {
    flex-direction: row;
}

.player-row {
    flex-direction: row;
    align-items: center;
    min-height: 44px;
    flex-shrink: 0;
    padding: 0 8px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    margin-bottom: 4px;
    border-radius: 3px;
}

.player-row:hover {
    background-color: rgb(28, 32, 44);
}

.player-row-photo {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.player-row-main {
    flex-direction: column;
    flex: 1;
    min-width: 0;
}

.player-row-name-row {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.player-row-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-transform: upper;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.player-row-meta {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 13px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-left: 10px;
    flex-shrink: 0;
}

.player-row-stats {
    flex-direction: row;
    align-items: center;
    margin-left: 28px;
    flex-shrink: 0;
}

.player-row-ovr {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-right;
}

.player-row-salary {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 13px;
    color: rgb(130, 146, 175);
    -unity-text-align: middle-right;
    margin-left: 28px;
}

.player-row-view {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    background-color: rgb(42, 95, 201);
    border-width: 0;
    border-radius: 3px;
    padding: 6px 10px;
    width: 96px;
    margin-left: 12px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.player-row-view:hover {
    background-color: rgb(52, 115, 231);
}

.player-row-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: white;
    width: 60px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

/* ── BUTTON OJEAR ── */

.btn-scout {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(8, 63, 31);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 12px 14px;
    border-radius: 4px;
    -unity-text-align: middle-center;
}

.btn-scout:hover {
    background-color: rgb(10, 69, 35);
}

.btn-scout--row {
    font-size: 14px;
    letter-spacing: 1px;
    padding: 6px 10px;
    border-radius: 3px;
    width: 96px;
    margin-left: 12px;
    flex-shrink: 0;
}

.btn-scout--disabled {
    background-color: rgb(60, 63, 68);
    color: rgb(220, 220, 220);
}

.btn-scout--disabled:hover {
    background-color: rgb(60, 63, 68);
}

/* ── RIGHT COLUMN ── */

.cartera-right {
    flex-direction: column;
    flex: 1 1 53%;
    margin-left: 20px;
    min-width: 0;
    min-height: 0;
}

.ojeador-body {
    flex-direction: column;
}

/* ── SCOUT SLOTS ── */

.scout-slots {
    flex-direction: column;
}

.scout-slot {
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    padding: 14px;
    margin-bottom: 8px;
}

.scout-slot-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    cursor: pointer;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(208, 216, 232);
    -unity-text-transform: upper;
}

.scout-slot-header:hover {
    opacity: 0.8;
}

.scout-slot-header-arrow {
    font-size: 18px;
    color: rgb(122, 138, 170);
    margin-right: 8px;
    width: 16px;
    -unity-text-align: middle-center;
}

.scout-slot-header-name {
    font-size: 24px;
    color: rgb(208, 216, 232);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    -unity-text-transform: upper;
    flex: 1;
}

.scout-slot-header-pos {
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    margin-left: 8px;
}

.scout-slot-header-age {
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    margin-left: 8px;
}

.scout-slot-content {
    flex-direction: column;
}

.scout-card-top {
    flex-direction: row;
    margin-top: 10px;
}

.scout-player-photo {
    width: 120px;
    height: 120px;
    border-radius: 64px;
    background-color: rgb(200, 200, 200);
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
    margin-right: 16px;
}

.scout-attr-column {
    flex-direction: column;
    flex: 1;
    min-width: 0;
}

.scout-attr-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.scout-attr-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    width: 75px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

.scout-attr-bar-bg {
    flex-grow: 1;
    height: 7px;
    background-color: rgb(28, 33, 48);
    border-radius: 3px;
    overflow: hidden;
    margin: 0 6px;
}

.scout-attr-bar-fill {
    height: 7px;
    border-radius: 3px;
    background-color: rgb(39, 174, 96);
}

.scout-attr-bar-fill--mid {
    background-color: rgb(212, 160, 23);
}

.scout-attr-bar-fill--low {
    background-color: rgb(192, 57, 43);
}

.scout-attr-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    width: 28px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

.scout-card-bottom {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
}

.scout-card-salary {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    flex: 1;
}

.scout-card-remove-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(116, 34, 24);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 16px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 6px 16px;
    -unity-text-align: middle-center;
    border-radius: 4px;
    flex-shrink: 0;
}

.scout-card-remove-btn:hover {
    background-color: rgb(90, 19, 11);
}

.scout-slot--completed {
    border-color: rgb(39, 174, 96);
}

.scout-slot--scouting {
    border-color: rgb(212, 160, 23);
}

.scout-slot--empty {
    border-color: rgb(42, 51, 71);
    opacity: 0.5;
}

.scout-slot-timer {
    font-size: 18px;
    color: rgb(212, 160, 23);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    letter-spacing: 1px;
    margin-top: 4px;
}

.scout-slot-ready {
    font-size: 18px;
    color: rgb(39, 174, 96);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    letter-spacing: 1px;
    margin-top: 4px;
}

.scout-empty-text {
    font-size: 16px;
    color: rgb(80, 90, 110);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    padding: 16px 0;
    -unity-text-align: middle-center;
}

/* ── STAFF CARD (OJEADOR) ── */

.fin-staff-card {
    flex-direction: row;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    padding: 14px 18px;
}

.fin-staff-icon {
    width: 64px;
    height: 64px;
    margin-right: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.fin-staff-info {
    flex-direction: column;
    flex-grow: 1;
}

.fin-staff-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(208, 216, 232);
    -unity-text-transform: upper;
}

.fin-staff-star {
    width: 18px;
    height: 18px;
    margin-right: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.fin-staff-star--empty {
    opacity: 0.25;
}

.fin-staff-interest {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    margin-top: 4px;
}

.fin-staff-empty {
    flex-direction: column;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    padding: 16px 18px;
}

.fin-staff-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

.btn-hire {
    width: 100%;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    background-color: rgb(42, 95, 201);
    color: white;
    border-width: 0;
    border-radius: 4px;
    padding: 10px;
    cursor: pointer;
    -unity-text-align: middle-center;
    margin-top: 8px;
}

.btn-hire:hover {
    background-color: rgb(52, 115, 231);
}

/* ── INFORMES TABLE ── */

.cartera-table-wrapper {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    overflow: hidden;
}

.cartera-table-header {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    background-color: rgb(17, 24, 34);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

.cartera-table-body {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow-y: auto;
}

.cartera-th {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-left;
    padding: 0 6px;
}

.cartera-th-photo   { width: 60px;  flex-shrink: 0; -unity-text-align: middle-center; }
.cartera-th-name    { width: 220px; flex-shrink: 0; }
.cartera-th-pos     { width: 60px;  flex-shrink: 0; }
.cartera-th-age     { width: 60px;  flex-shrink: 0; }
.cartera-th-ovr     { width: 70px;  flex-shrink: 0; }
.cartera-th-salary  { width: 110px; flex-shrink: 0; }
.cartera-th-team    { width: 180px; flex-shrink: 0; }
.cartera-th-day     { width: 80px;  flex-shrink: 0; }
.cartera-th-action  { width: 90px;  flex-shrink: 0; }

.cartera-info-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 51, 71, 0.4);
}

.cartera-info-row:last-child {
    border-bottom-width: 0;
}

.cartera-info-row:hover {
    background-color: rgba(42, 51, 71, 0.2);
}

.cartera-td {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 15px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    padding: 0 6px;
}

.cartera-td-photo-img {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.cartera-td-photo   { width: 60px;  flex-shrink: 0; align-items: center; justify-content: center; }
.cartera-td-name    { width: 220px; flex-shrink: 0; overflow: hidden; text-overflow: ellipsis; }
.cartera-td-pos     { width: 60px;  flex-shrink: 0; }
.cartera-td-age     { width: 60px;  flex-shrink: 0; }
.cartera-td-ovr     { width: 70px;  flex-shrink: 0; }
.cartera-td-salary  { width: 110px; flex-shrink: 0; }
.cartera-td-team    { width: 180px; flex-shrink: 0; color: rgb(130, 146, 175); }
.cartera-td-day     { width: 80px;  flex-shrink: 0; color: rgb(130, 146, 175); }
.cartera-td-action  { width: 90px;  flex-shrink: 0; }

.cartera-view-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(74, 128, 240);
    background-color: transparent;
    border-width: 0;
    padding: 4px 6px;
    -unity-text-align: middle-center;
}

.cartera-view-btn:hover {
    color: rgb(120, 170, 255);
}

.cartera-empty {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(80, 90, 110);
    font-style: italic;
    padding: 20px 0;
    -unity-text-align: middle-center;
}

/* ── OVR COLORS ── */

.player-ovr--high { color: rgb(39, 174, 96); }
.player-ovr--mid  { color: rgb(212, 160, 23); }
.player-ovr--low  { color: rgb(192, 57, 43); }
