/* ══════════════════════════════════════════
   CARTERA — Cartera.uss
   ══════════════════════════════════════════ */

.cartera-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ══ SCREEN HEADER ══ */
.screen-header.panel--gold {
    flex-shrink: 0;
    padding: 0;
    margin: 16px 20px 12px 20px;
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    background-color: rgb(33, 32, 28);
    border-radius: 4px;
    overflow: hidden;
}
.screen-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    background-color: rgb(33, 32, 28);
}
.screen-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    white-space: normal;
}

.cartera-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.cartera-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 20px 24px;
    min-height: 0;
    overflow: hidden;
}

/* ── TOPBAR / TABS ── */

.cartera-topbar {
    flex-shrink: 0;
}

.cartera-tabs {
    margin-bottom: 18px;
}

.cartera-page {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.cartera-page--column {
    flex-direction: column;
    width: 100%;
    height: 0;
    flex-shrink: 1;
    align-self: stretch;
}

/* ── SECTION TITLES ── */

.section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgb(212, 160, 23);
    margin-bottom: 12px;
    flex-shrink: 0;
}

.section-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    margin-bottom: 16px;
    flex-shrink: 0;
}

/* ── LEFT COLUMN ── */

.cartera-left {
    flex-direction: column;
    flex: 1 1 47%;
    margin-right: 10px;
    min-width: 0;
}

/* Selector de equipos en fichas (grid, ~5 por fila) */
.team-list {
    flex-direction: column;
    margin-bottom: 16px;
    height: 560px;
    min-height: 560px;
    max-height: 560px;
    flex-grow: 0;
    flex-shrink: 0;
}

.team-list .unity-scroll-view__content-viewport {
    overflow: hidden;
}

.team-list .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.team-select-tile {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 18%;
    min-width: 74px;
    height: 78px;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 5px;
    padding: 8px 4px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    cursor: pointer;
}

.team-select-tile:hover {
    background-color: rgb(28, 33, 48);
    border-color: rgb(85, 102, 119);
}

.team-select-tile--selected {
    background-color: rgb(35, 40, 55);
    border-color: rgb(212, 160, 23);
}

.team-select-tile-logo {
    width: 40px;
    height: 40px;
    margin-bottom: 6px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.team-select-tile-abbrev {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    letter-spacing: 1px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
}

/* ── SORT BAR ── */

.player-list {
    flex-direction: column;
    flex-grow: 1;
    min-height: 200px;
}

/* ── PLAYER ROWS (ricas) ── */

.players-wrapper {
    flex-direction: row;
}

.player-row {
    flex-direction: row;
    align-items: center;
    min-height: 44px;
    flex-shrink: 0;
    padding: 0 8px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    margin-bottom: 4px;
    border-radius: 3px;
}

.player-row:hover {
    background-color: rgb(28, 32, 44);
}

.player-row-photo {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.player-row-main {
    flex-direction: column;
    flex: 1;
    min-width: 0;
}

.player-row-name-row {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.player-row-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.player-row-meta {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 13px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-left: 10px;
    flex-shrink: 0;
}

.player-row-stats {
    flex-direction: row;
    align-items: center;
    margin-left: 28px;
    flex-shrink: 0;
}

.player-row-ovr {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-right;
}

.player-row-salary {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 13px;
    color: rgb(130, 146, 175);
    -unity-text-align: middle-right;
    margin-left: 28px;
}

.player-row-view {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(120, 160, 230);
    background-color: rgb(20, 28, 45);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    border-radius: 8px;
    padding: 6px 10px;
    width: 96px;
    margin-left: 12px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    cursor: pointer;
}

.player-row-view:hover {
    background-color: rgb(24, 40, 71);
    color: rgb(150, 185, 245);
}

.player-row-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: white;
    width: 60px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

/* ── BUTTON OJEAR ── */

.btn-scout {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(20, 36, 35);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    color: rgb(100, 200, 140);
    font-size: 24px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 12px 14px;
    border-radius: 8px;
    -unity-text-align: middle-center;
    cursor: pointer;
}

.btn-scout:hover {
    background-color: rgb(23, 59, 45);
    color: rgb(130, 220, 165);
}

.btn-scout--row {
    font-size: 14px;
    letter-spacing: 1px;
    padding: 6px 10px;
    border-radius: 8px;
    width: 96px;
    margin-left: 12px;
    flex-shrink: 0;
}

.btn-scout--disabled {
    background-color: rgb(28, 32, 38);
    border-color: rgb(60, 63, 68);
    color: rgb(100, 105, 115);
}

.btn-scout--disabled:hover {
    background-color: rgb(28, 32, 38);
}

/* ── RIGHT COLUMN ── */

.cartera-right {
    flex-direction: column;
    flex: 1 1 53%;
    margin-left: 20px;
    min-width: 0;
    min-height: 0;
}

.ojeador-body {
    flex-direction: column;
}

/* ── SCOUT SLOTS ── */

.scout-slots {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    width: 100%;
    align-self: stretch;
}

.scout-slot {
    flex-direction: column;
    width: 49%;
    min-width: 0;
    flex-shrink: 0;
    align-self: flex-start;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    padding: 14px;
    margin: 0 0.5% 8px 0.5%;
}

.scout-slot-header {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 6px;
    cursor: pointer;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    text-transform: uppercase;
}

.scout-slot-header:hover {
    opacity: 0.8;
}

.scout-slot-header-arrow {
    font-size: 14px;
    color: rgb(122, 138, 170);
    margin-right: 6px;
    width: 12px;
    -unity-text-align: middle-center;
}

.scout-slot-header-name {
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    text-transform: uppercase;
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.scout-slot-header-pos {
    font-size: 16px;
    color: rgb(122, 138, 170);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    margin-left: 8px;
}

.scout-slot-header-age {
    font-size: 16px;
    color: rgb(122, 138, 170);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    margin-left: 8px;
}

.scout-slot-header-med {
    font-size: 16px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    margin-left: 8px;
}

.scout-slot-content {
    flex-direction: column;
}

.scout-card-top {
    flex-direction: row;
    margin-top: 10px;
}

.scout-player-photo {
    width: 80px;
    height: 80px;
    border-radius: 10px;
    background-color: rgb(200, 200, 200);
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
    margin-right: 12px;
    margin-top: 5px;
}

/* ── ATTR BADGES ── */

.cartera-attr-badges {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    padding: 2px 0;
    flex: 1;
    min-width: 0;
}

.cartera-attr-badge {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100px;
    height: 64px;
    padding: 6px 4px;
    margin: 3px;
    border-radius: 4px;
    background-color: rgb(39, 174, 96);
    flex-shrink: 0;
}

.cartera-attr-badge--mid { background-color: rgb(191, 142, 16); }
.cartera-attr-badge--low { background-color: rgb(192, 57, 43); }

.cartera-attr-badge-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    letter-spacing: 0.5px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.cartera-attr-badge-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: nowrap;
    margin-top: 2px;
}

.scout-card-bottom {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
}

.scout-card-salary {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    flex: 1;
}

.scout-card-remove-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(35, 25, 30);
    border-width: 2px;
    border-color: rgb(192, 57, 43);
    color: rgb(230, 120, 100);
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 10px 16px;
    -unity-text-align: middle-center;
    border-radius: 8px;
    flex-shrink: 0;
    cursor: pointer;
}

.scout-card-remove-btn:hover {
    background-color: rgb(62, 30, 32);
    color: rgb(240, 145, 125);
}

.scout-slot--completed {
    border-color: rgb(39, 174, 96);
}

.scout-slot--scouting {
    border-color: rgb(212, 160, 23);
}

.scout-slot--empty {
    border-color: rgb(42, 51, 71);
    opacity: 0.5;
}

.scout-slot-timer {
    font-size: 18px;
    color: rgb(212, 160, 23);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    letter-spacing: 1px;
    margin-top: 4px;
}

.scout-slot-ready {
    font-size: 18px;
    color: rgb(39, 174, 96);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    letter-spacing: 1px;
    margin-top: 4px;
}

.scout-empty-text {
    font-size: 16px;
    color: rgb(80, 90, 110);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    padding: 16px 0;
    -unity-text-align: middle-center;
}

/* ── STAFF CARD (OJEADOR) ── */

.fin-staff-card {
    flex-direction: row;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    padding: 14px 18px;
}

.fin-staff-icon {
    width: 64px;
    height: 64px;
    margin-right: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.fin-staff-info {
    flex-direction: column;
    flex-grow: 1;
}

.fin-staff-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(208, 216, 232);
    text-transform: uppercase;
}

.fin-staff-star {
    width: 18px;
    height: 18px;
    margin-right: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.fin-staff-star--empty {
    opacity: 0.25;
}

.fin-staff-interest {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    margin-top: 4px;
}

.fin-staff-empty {
    flex-direction: column;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    padding: 16px 18px;
}

.fin-staff-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

.btn-hire {
    width: 100%;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    background-color: rgb(20, 28, 45);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(120, 160, 230);
    border-radius: 8px;
    padding: 10px;
    cursor: pointer;
    -unity-text-align: middle-center;
    margin-top: 8px;
}

.btn-hire:hover {
    background-color: rgb(24, 40, 71);
    color: rgb(150, 185, 245);
}

/* ── INFORMES TABLE ── */

.cartera-table-wrapper {
    flex-direction: column;
    flex-grow: 1;
    height: 0;
    flex-shrink: 1;
    min-height: 0;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    overflow: hidden;
}

.cartera-table-header {
    flex-direction: row;
    align-items: center;
    padding: 6px 12px;
    background-color: rgb(17, 24, 34);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

.cartera-table-body-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    height: 0;
    min-height: 0;
    overflow: hidden;
}

.cartera-table-body {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}

/* ══ INFORMES SCROLLBAR (gold) ══ */

.cartera-informes-scroll-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.cartera-informes-viewport {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    position: relative;
}

.cartera-informes-table-body {
    flex-direction: column;
    flex-shrink: 0;
}

.cartera-informes-scrollbar {
    width: 12px;
    min-width: 12px;
    flex-shrink: 0;
    align-self: stretch;
    margin-left: 4px;
    background-color: rgb(24, 18, 10);
    border-left-width: 1px;
    border-left-color: rgb(54, 47, 29);
    position: relative;
}

.cartera-informes-scrollbar-thumb {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 0;
    height: 40px;
    background-color: rgb(160, 128, 30);
    border-radius: 3px;
}
.cartera-informes-scrollbar:hover .cartera-informes-scrollbar-thumb {
    background-color: rgb(212, 160, 23);
}

.cartera-th {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-left;
    padding: 0 6px;
}

/* Anchos de columna compartidos (cabecera y filas) */
.cartera-col-photo  { width: 60px;  flex: 0 0 60px; }
.cartera-col-name   { width: 220px; flex: 0 0 220px; }
.cartera-col-pos    { width: 60px;  flex: 0 0 60px; }
.cartera-col-age    { width: 60px;  flex: 0 0 60px; }
.cartera-col-ovr    { width: 70px;  flex: 0 0 70px; }
.cartera-col-salary { width: 110px; flex: 0 0 110px; }
.cartera-col-team   { width: 180px; flex: 0 0 280px; }
.cartera-col-day    { width: 100px; flex: 0 0 100px; }
.cartera-col-action { width: 96px;  flex: 0 0 96px; }

.cartera-info-row {
    flex-direction: row;
    align-items: center;
    height: 48px;
    min-height: 48px;
    max-height: 48px;
    flex-shrink: 0;
    padding: 6px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 45);
}

.cartera-info-row:last-child {
    border-bottom-width: 0;
}

.cartera-info-row:hover {
    background-color: rgb(23, 27, 37);
}

.cartera-td {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    padding: 0 6px;
}

.cartera-td-photo-img {
    width: 32px;
    height: 32px;
    border-radius: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.cartera-td-photo-center { align-items: center; justify-content: center; }
.cartera-td-ellipsis     { overflow: hidden; text-overflow: ellipsis; }
.cartera-td-muted        { color: rgb(130, 146, 175); }

.cartera-view-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(74, 128, 240);
    background-color: transparent;
    border-width: 0;
    padding: 4px 6px;
    -unity-text-align: middle-center;
}

.cartera-view-btn:hover {
    color: rgb(120, 170, 255);
}

.cartera-col-action.player-row-view {
    margin-left: 0;
    font-size: 16px;
}

.cartera-empty {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(80, 90, 110);
    font-style: italic;
    padding: 20px 0;
    -unity-text-align: middle-center;
}

/* ── OVR COLORS ── */

.player-ovr--high { color: rgb(39, 174, 96); }
.player-ovr--mid  { color: rgb(212, 160, 23); }
.player-ovr--low  { color: rgb(192, 57, 43); }
