/* ══════════════════════════════════════════
   CARTERA — Cartera.uss
   ══════════════════════════════════════════ */

.cartera-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.cartera-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.cartera-content {
    flex-direction: row;
    flex-grow: 1;
    padding: 20px 24px;
    overflow-y: auto;
}

.section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
    margin-bottom: 12px;
}

/* ── LEFT COLUMN ── */

.cartera-left {
    flex-direction: column;
    flex: 1;
    margin-right: 10px;
    min-width: 0;
}

.team-list {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.team-logo-btn {
    width: 64px;
    height: 64px;
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    background-color: rgb(22, 26, 36);
    margin: 5px;
    padding: 4px;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
}

.team-logo-img {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}
.team-logo-btn:hover {
    border-color: rgb(212, 160, 23);
    background-color: rgb(28, 32, 44);
}
.team-logo-btn--selected {
    border-color: rgb(212, 160, 23);
    background-color: rgb(35, 40, 55);
}

.player-list {
    flex-direction: column;
    flex-grow: 1;
    min-height: 200px;
}

.player-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    margin-bottom: 4px;
}
.player-row:hover {
    background-color: rgb(28, 32, 44);
}
.player-row--selected {
    border-color: rgb(212, 160, 23);
}

.player-row-name {
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    -unity-text-transform: upper;
    flex: 1;
}
.player-row-pos {
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    width: 30px;
    -unity-text-align: middle-center;
}
.player-row-age {
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    width: 30px;
    -unity-text-align: middle-center;
    margin-right: 10px;
}
.player-row-ovr {
    font-size: 18px;
    color: rgb(212, 160, 23);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 30px;
    -unity-text-align: middle-center;
    margin-right: 10px;
}

.btn-scout {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(8, 63, 31);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 12px 14px;
    border-radius: 4px;
    -unity-text-align: middle-center;
}
.btn-scout:hover {
    background-color: rgb(10, 69, 35);
}
.btn-scout--disabled {
    background-color: rgb(60, 63, 68);
    color: rgb(100, 100, 100);
}

/* ── RIGHT COLUMN ── */

.cartera-right {
    flex-direction: column;
    flex: 1;
    margin-left: 20px;
}

/* Ojeador card */

.ojeador-body {
    flex-direction: column;
}

/* Scout slots */

.scout-slots {
    flex-direction: column;
}

.scout-slot {
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 14px;
    margin-bottom: 8px;
}
.scout-slot--completed {
    border-color: rgb(39, 174, 96);
}
.scout-slot--scouting {
    border-color: rgb(212, 160, 23);
}
.scout-slot--empty {
    border-color: rgb(42, 51, 71);
    opacity: 0.5;
}

.scout-slot-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.scout-slot-name {
    font-size: 24px;
    color: rgb(208, 216, 232);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    -unity-text-transform: upper;
    flex: 1;
}

.scout-slot-pos {
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    margin-left: 8px;
    width: 30px;
    -unity-text-align: middle-center;
}

.scout-slot-age {
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    margin-left: 8px;
}

.scout-slot-timer {
    font-size: 18px;
    color: rgb(212, 160, 23);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    letter-spacing: 1px;
    margin-top: 4px;
}

.scout-slot-attributes {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.scout-attr {
    font-size: 18px;
    color: rgb(160, 170, 190);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    width: 15%;
    margin-bottom: 2px;
    min-width: 0;
}
.scout-attr-label {
    color: rgb(122, 138, 170);
}
.scout-attr-val {
    color: rgb(208, 216, 232);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.scout-slot-salary {
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

.scout-slot-contract {
    font-size: 16px;
    color: rgb(122, 138, 170);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

.scout-empty-text {
    font-size: 16px;
    color: rgb(80, 90, 110);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    padding: 20px 0;
    -unity-text-align: middle-center;
}

/* ── STAFF CARD (matching Loans.uss fin-staff-*) ── */

.fin-staff-card {
    flex-direction: row;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 14px 18px;
    width: 400px;
}

.fin-staff-icon {
    width: 64px;
    height: 64px;
    margin-right: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.fin-staff-info {
    flex-direction: column;
    flex-grow: 1;
}

.fin-staff-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(208, 216, 232);
    -unity-text-transform: upper;
}

.fin-staff-star {
    width: 18px;
    height: 18px;
    margin-right: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.fin-staff-star--empty {
    opacity: 0.25;
}

.fin-staff-interest {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    margin-top: 4px;
}

.fin-staff-empty {
    flex-direction: column;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px 18px;
    min-width: 320px;
}

.fin-staff-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

.btn-fire {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(116, 34, 24);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 4px 0;
    -unity-text-align: middle-center;
    width: 100%;
    border-radius: 4px;
    margin-top: 8px;
}
.btn-fire:hover {
    background-color: rgb(90, 19, 11);
}

/* ── SCOUT FULL MODAL ── */

.cartera-modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
}

.cartera-modal-box {
    width: 480px;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-top-width: 3px;
    border-top-color: rgb(212, 160, 23);
    padding: 28px;
    flex-direction: column;
    align-items: center;
}

.cartera-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 28px;
    letter-spacing: 4px;
    color: rgb(212, 160, 23);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.cartera-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(179, 190, 214);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
    white-space: normal;
}

.cartera-modal-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(39, 174, 96);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    padding: 10px 0;
    width: 200px;
    -unity-text-align: middle-center;
    margin-top: 20px;
}
.cartera-modal-btn:hover {
    background-color: rgb(46, 204, 113);
}

.btn-hire {
    width: 100%;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    background-color: rgb(42, 95, 201);
    color: white;
    border-width: 0;
    border-radius: 4px;
    padding: 10px;
    cursor: pointer;
    -unity-text-align: middle-center;
    margin-top: 8px;
}

.btn-hire:hover {
    background-color: rgb(52, 115, 231);
}

.player-ovr--high {
    color: rgb(39, 174, 96);
}

.player-ovr--mid {
    color: rgb(212, 160, 23);
}

.player-ovr--low {
    color: rgb(192, 57, 43);
}
