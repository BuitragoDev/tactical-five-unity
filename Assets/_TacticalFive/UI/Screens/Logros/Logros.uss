.logros-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.logros-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.logros-content {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    padding: 20px;
}

.logros-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
}

.logros-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: white;
    font-weight: bold;
}

.logros-progress {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 18px;
    color: rgb(255, 183, 77);
}

.logros-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 14px;
    border-bottom-width: 3px;
    border-bottom-color: rgb(28, 33, 48);
}

.logros-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(122, 138, 170);
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: transparent;
    padding: 10px 16px;
    margin-right: 2px;
}

.logros-tab:hover {
    color: rgb(208, 216, 232);
}

.logros-tab--active,
.logros-tab--active:hover {
    color: rgb(212, 160, 23);
    border-bottom-color: rgb(212, 160, 23);
    background-color: transparent;
}

.logros-scroll-wrapper {
    flex-grow: 1;
}

.logros-scroll {
    flex-grow: 1;
}

.logros-body {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    width: 100%;
}

.logros-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    width: 100%;
}

.logros-card {
    width: 16.4%;
    flex-direction: column;
    background-color: rgba(20, 24, 34, 0.9);
    border-width: 1px;
    border-color: rgb(35, 41, 58);
    border-radius: 8px;
    padding: 10px;
    margin: 0 0.2% 12px 0;
    box-sizing: border-box;
}

.logros-card--locked {
    opacity: 0.45;
}

.logros-card--unlocked {
    border-color: rgb(255, 183, 77);
}

.logros-card-icon {
    width: 40px;
    height: 40px;
    margin-bottom: 8px;
}

.logros-card-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 17px;
    color: white;
    margin-bottom: 4px;
}

.logros-card-desc {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 13px;
    color: rgb(150, 165, 195);
    flex-grow: 1;
}

.logros-card-status {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 13px;
    margin-top: 8px;
}

.logros-card-status--locked {
    color: rgb(120, 130, 155);
}

.logros-card-status--unlocked {
    color: rgb(100, 200, 255);
}

.logros-empty {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(100, 100, 100);
    font-style: italic;
    padding: 20px;
}
