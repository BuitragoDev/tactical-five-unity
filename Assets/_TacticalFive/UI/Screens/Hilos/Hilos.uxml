<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="../Palmares/Palmares.uss" />
    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />
    <Style src="Hilos.uss" />

    <ui:VisualElement name="HilosRoot" class="palmares-root">

        <ui:VisualElement class="palmares-main">

            <!-- ══ HEADER ══ -->
            <ui:VisualElement class="screen-header panel--gold">
                <ui:VisualElement class="screen-header-row">
                    <ui:VisualElement name="HilosScreenIcon" class="screen-icon" />
                    <ui:Label class="screen-title" text="{loc:ui.hilos.hilos_de_la_temporada}" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="palmares-content">
                <ui:VisualElement class="palmares-split">
                    <ui:VisualElement class="palmares-full">
                        <ui:Label class="palmares-section-title" text="{loc:ui.hilos.hilos_de_la_temporada}" />
                        <ui:Label class="historia-hint" text="{loc:ui.hilos.situaciones_que_se_abren_escalan_y_se_ci_3a3bba8d}" />
                        <ui:VisualElement class="palmares-scroll-row">
                            <ui:VisualElement name="HistoriaViewport" class="palmares-viewport">
                                <ui:VisualElement name="HistoriaBody" class="historia-body" />
                            </ui:VisualElement>
                            <ui:VisualElement name="HistoriaTrack" class="palmares-scrollbar">
                                <ui:VisualElement name="HistoriaThumb" class="palmares-scrollbar-thumb" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ══ MODAL CONFIGURACIÓN ══ -->
        <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigModalBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.hilos.configuracion}" />
                <ui:VisualElement class="modal-body">
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.hilos.audio}" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.hilos.volumen_general}" />
                            <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.hilos.musica}" />
                            <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.hilos.efectos}" />
                            <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.hilos.graficos}" />
                        <ui:VisualElement class="settings-quality-row">
                            <ui:Label class="settings-label" text="{loc:ui.hilos.calidad}" />
                            <ui:VisualElement class="settings-quality-options">
                                <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="{loc:ui.hilos.config_btn_quality_low}" />
                                <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="{loc:ui.hilos.config_btn_quality_medium}" />
                                <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="{loc:ui.hilos.config_btn_quality_high}" />
                                <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="{loc:ui.hilos.config_btn_quality_ultra}" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.hilos.juego}" />
                        <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="{loc:ui.hilos.config_btn_main_menu}" />
                        <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="{loc:ui.hilos.config_btn_exit}" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ConfigBtnCerrar" class="modal-close" text="{loc:ui.hilos.config_btn_cerrar}" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR VOLVER AL MENÚ PRINCIPAL ══ -->
        <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.hilos.volver_al_menu_principal}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.hilos.estas_seguro_de_que_quieres_volver_al_me_6f548452}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.hilos.se_perdera_el_progreso_no_guardado_de_la_b10b7334}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="{loc:ui.hilos.config_btn_main_menu_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="{loc:ui.hilos.config_btn_main_menu_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR SALIR DEL JUEGO ══ -->
        <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.hilos.salir_del_juego}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.hilos.estas_seguro_de_que_quieres_salir_del_ju_c65dd5f1}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.hilos.tu_progreso_se_guarda_automaticamente_du_10fb1edb}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="{loc:ui.hilos.config_btn_exit_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="{loc:ui.hilos.config_btn_exit_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
