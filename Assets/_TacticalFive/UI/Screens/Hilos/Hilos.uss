/* HILOS — pantalla de hilos narrativos (movida desde la pestaña HISTORIA de Palmarés).
   Reutiliza las clases palmares-*/historia-* de Palmares.uss. */

.hilos-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}
