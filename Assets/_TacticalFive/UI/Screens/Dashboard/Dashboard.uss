/* ══════════════════════════════════════════
   DASHBOARD — Dashboard.uss
   ══════════════════════════════════════════ */

/* ── ROOT ── */
.dashboard-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ══════════════════════════════════════════
   SIDEBAR
   ══════════════════════════════════════════ */
.sidebar {
    width: 200px;
    height: 100%;
    flex-shrink: 0;
    flex-direction: column;
    background-color: rgb(11, 14, 20);
    border-right-width: 1px;
    border-right-color: rgb(28, 33, 48);
}

.sidebar-logo {
    flex-direction: row;
    align-items: center;
    padding: 0 16px;
    height: 100px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    flex-shrink: 0;
}
.sidebar-logo-icon {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
    font-size: 28px;
    padding: 4px 8px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-right: 10px;
}
.sidebar-logo-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
}
.sidebar-logo-text-gold {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
    -unity-text-transform: upper;
}

.sidebar-nav {
    flex-direction: column;
    flex-grow: 1;
    padding: 8px 0;
    overflow: hidden;
    background-color: rgb(0, 0, 0);
}

.nav-item {
    flex-direction: row;
    align-items: center;
    padding: 12px 12px;
    border-width: 0;
    background-color: rgb(0, 0, 0);
}
.nav-item:hover {
    background-color: rgb(22, 26, 36);
}
.nav-item--active {
    background-color: rgb(20, 28, 48);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}
.nav-icon {
    width: 24px;
    height: 24px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}
.nav-label {
    font-size: 16px;
    color: rgb(122, 138, 170);
    margin-left: 18px;
    -unity-text-align: middle-left;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    -unity-text-transform: upper;
    letter-spacing: 1px;
}
.nav-item:hover .nav-label {
    color: rgb(208, 216, 232);
}
.nav-item--active .nav-label {
    color: rgb(255, 255, 255);
}
.nav-arrow {
    font-size: 10px;
    color: rgb(122, 138, 170);
    margin-left: auto;
    -unity-text-align: middle-right;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
}
.nav-item:hover .nav-arrow {
    color: rgb(208, 216, 232);
}
.nav-item--active .nav-arrow {
    color: rgb(255, 255, 255);
}
.nav-item:hover {
    background-color: rgb(22, 26, 36);
}

/* ── SUBMENÚS ── */
.nav-submenu {
    display: none;
    flex-direction: column;
    background-color: rgb(8, 10, 14);
}
.nav-submenu--visible {
    display: flex;
}
.nav-submenu-item {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: 10px 12px 10px 54px;
    border-width: 0;
    background-color: transparent;
}
.nav-submenu-item:hover {
    background-color: rgb(22, 26, 36);
}
.nav-submenu-item--active {
    background-color: rgb(20, 28, 48);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}
.nav-submenu-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    -unity-text-align: middle-left;
    color: rgb(100, 116, 148);
}
.nav-submenu-item:hover .nav-submenu-label {
    color: rgb(208, 216, 232);
}
.nav-submenu-item--active .nav-submenu-label {
    color: rgb(255, 255, 255);
}
.nav-item--active {
    background-color: rgb(20, 28, 48);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}
.nav-icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ══════════════════════════════════════════
   MAIN AREA
   ══════════════════════════════════════════ */
.main-area {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

/* ── TOP HEADER ── */
.top-header {
    flex-direction: row;
    align-items: center;
    height: 100px;
    padding: 0 24px;
    background-color: rgb(17, 24, 34);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

.header-team-logo {
    width: 64px;
    height: 64px;
    margin-right: 14px;
    flex-shrink: 0;
}
.header-team-info {
    flex-direction: column;
    margin-right: 32px;
    flex-shrink: 0;
}
.header-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
}
.header-manager-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
}

.header-stat {
    flex-direction: column;
    margin-right: 28px;
    flex-shrink: 0;
}
.header-stat-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(85, 102, 119);
}
.header-stat-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 22px;
    color: rgb(39, 174, 96);
}
.header-stat-value--negative {
    color: rgb(192, 57, 43);
}
.header-stat-value--neutral {
    color: rgb(208, 216, 232);
}
.header-stat-value--gold {
    color: rgb(212, 160, 23);
}

.header-spacer {
    flex-grow: 1;
}

.header-config-icon {
    width: 32px;
    height: 32px;
    margin-left: 18px;
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/Icons/configuracion.png");
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    flex-shrink: 0;
}
.header-config-icon:hover {
    opacity: 0.7;
}

.header-season-info {
    flex-direction: column;
    align-items: flex-end;
    margin-right: 24px;
    flex-shrink: 0;
}
.header-season-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
    -unity-text-transform: upper;
}
.header-date-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
}

/* Anillo de carga giratorio */
.loading-spinner {
    width: 28px;
    height: 28px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: rgb(212, 160, 23);
    border-right-color: rgba(122, 138, 170, 0.12);
    border-bottom-color: rgba(122, 138, 170, 0.12);
    border-left-color: rgba(122, 138, 170, 0.12);
    border-radius: 14px;
    flex-shrink: 0;
    margin: auto 10px auto 0;
}

/* Botón acción principal */
.btn-action {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 24px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.btn-action:hover {
    background-color: rgb(74, 128, 240);
}
.btn-action--match {
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
}
.btn-action--match:hover {
    background-color: rgb(240, 192, 64);
}
.btn-action--simulate {
    background-color: rgb(30, 37, 53);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    color: rgb(74, 128, 240);
}
.btn-action--simulate:hover {
    background-color: rgb(20, 28, 48);
}

/* ── CONTENT AREA ── */
.content-area {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}

.content-scroll {
    flex-grow: 1;
}
.content-scroll > #unity-content-viewport > #unity-content-container {
    flex-direction: column;
    padding: 20px;
}

/* ── GRID DE PANELS ── */
.panels-grid {
    flex-direction: column;
    padding: 20px;
}

.panels-row {
    flex-direction: row;
    margin-bottom: 16px;
    align-items: stretch;
}
.right-column {
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 16px;
}
.right-column > .panel {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 0;
}
.right-column > .panel-team-stats {
    margin-bottom: 16px;
}

/* Panel base */
.panel {
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 2px;
    margin-right: 16px;
    padding: 0;
    overflow: hidden;
}
.panel-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    flex-shrink: 0;
}
.panel-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    color: rgb(208, 216, 232);
}
.panel-date {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(85, 102, 119);
}
.panel-body {
    flex-direction: column;
    padding: 16px 18px;
    flex-grow: 1;
}

/* ══════════════════════════════════════════
   PANEL ÚLTIMO / PRÓXIMO PARTIDO
   ══════════════════════════════════════════ */
.panel-game {
    flex-grow: 1;
    flex-basis: 0;
}

.game-result {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
}
.game-team-block {
    flex-direction: column;
    align-items: center;
    width: 160px;
    flex-shrink: 0;
}
.game-team-logo-lg {
    width: 64px;
    height: 64px;
    margin-bottom: 8px;
}
.game-team-name-lg {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    white-space: normal;
}
.game-score-block {
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
    min-width: 150px;
    flex-shrink: 0;
}
.game-score-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 40px;
    letter-spacing: 4px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    flex-shrink: 0;
    min-width: 60px;
}
.game-score-sep {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 20px;
    color: rgb(58, 74, 99);
    -unity-text-align: middle-center;
    margin: 0 4px;
    flex-shrink: 0;
}
.game-vs-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 4px;
    color: rgb(58, 74, 99);
    -unity-text-align: middle-center;
}
.game-result-badge {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    padding: 5px 14px;
    -unity-text-align: middle-center;
    margin-top: 4px;
}
.badge-win {
    background-color: rgb(39, 174, 96);
    color: rgb(255, 255, 255);
}
.badge-loss {
    background-color: rgb(192, 57, 43);
    color: rgb(255, 255, 255);
}

.no-games-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(58, 74, 99);
    -unity-text-align: middle-center;
    padding: 24px;
    flex-grow: 1;
}

/* ── GAME META ROW ── */
.game-meta-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}
.game-meta-location {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 2px;
    -unity-text-align: middle-center;
    margin-right: 10px;
    flex-shrink: 0;
}
.game-meta-location--home {
    background-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
}
.game-meta-location--away {
    background-color: rgb(42, 51, 71);
    color: rgb(122, 138, 170);
}
.game-meta-arena {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    flex-grow: 1;
}
.game-meta-type {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-center;
    margin-left: 10px;
    flex-shrink: 0;
}

/* ══════════════════════════════════════════
   PANEL CLASIFICACIÓN
   ══════════════════════════════════════════ */
.panel-standings {
    flex-grow: 1;
    flex-basis: 0;
}

.conf-tabs {
    flex-direction: row;
}
.conf-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 12px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 6px 16px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-right: 4px;
}
.conf-tab:hover {
    color: rgb(208, 216, 232);
}
.conf-tab--active {
    background-color: rgb(28, 33, 48);
    border-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
}

.standings-table {
    flex-direction: column;
    flex-grow: 1;
}
.standings-header-row {
    flex-direction: row;
    padding: 6px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}
.standings-row {
    flex-direction: row;
    align-items: center;
    padding: 7px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}
.standings-row--my-team {
    background-color: rgb(20, 28, 48);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}
.standings-row--playoff {
    border-left-width: 2px;
    border-left-color: rgb(39, 174, 96);
}
.standings-row--playin {
    border-left-width: 2px;
    border-left-color: rgb(212, 160, 23);
}

.col-rank {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    width: 24px;
    font-size: 13px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.col-team-logo {
    width: 32px;
    height: 24px;
    margin-right: 8px;
    flex-shrink: 0;
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
}
.col-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    flex-grow: 1;
    font-size: 14px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    -unity-text-transform: upper;
}
.col-stat {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    width: 36px;
    font-size: 14px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.col-stat--header {
    color: rgb(58, 74, 99);
    font-size: 11px;
    letter-spacing: 1px;
}
.col-wins {
    color: rgb(39, 174, 96);
}
.col-losses {
    color: rgb(192, 57, 43);
}
.col-streak {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    width: 40px;
    font-size: 14px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.streak-win  { color: rgb(39, 174, 96); }
.streak-loss { color: rgb(192, 57, 43); }
.streak-none { color: rgb(58, 74, 99); }

/* ══════════════════════════════════════════
   PANEL ESTADÍSTICAS JUGADORES
   ══════════════════════════════════════════ */
.panel-player-stats {
    flex-grow: 1;
    flex-basis: 0;
}
.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
}
.stat-card {
    width: 50%;
    flex-direction: column;
    align-items: center;
    padding: 16px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(212, 160, 23);
    border-right-width: 1px;
    border-top-width: 0;
    border-left-width: 0;
}
.stat-card-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}
.stat-card-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 48px;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-center;
}
.stat-card-player {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    margin-top: 4px;
    min-width: 200px;
}
.stat-card-games {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 16px;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
    margin-top: 2px;
}

/* ══════════════════════════════════════════
   PANEL ESTADÍSTICAS DEL EQUIPO
   ══════════════════════════════════════════ */
.panel-team-stats {
    min-height: 320px;
}
.team-stat-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 51, 71, 0.4);
}
.team-stat-row:last-child {
    border-bottom-width: 0;
}
.team-stat-icon-bg {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background-color: rgb(212, 160, 23);
    align-items: center;
    justify-content: center;
    margin-right: 10px;
    flex-shrink: 0;
}
.team-stat-icon-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 12px;
    color: rgb(255, 255, 255);
}
.team-stat-arena-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/Icons/arena.png");
    -unity-background-scale-mode: scale-to-fit;
}
.team-stat-trophy-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/Icons/trofeo.png");
    -unity-background-scale-mode: scale-to-fit;
}
.team-stat-logo {
    width: 32px;
    height: 32px;
    margin-right: 12px;
    flex-shrink: 0;
}
.team-stat-info {
    flex-direction: column;
    flex-grow: 1;
    justify-content: center;
}
.team-stat-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-SemiBold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    letter-spacing: 0.5px;
}
.team-stat-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    margin-top: 1px;
}
.team-stat-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-right;
    min-width: 32px;
    flex-shrink: 0;
}
.team-stat-value--green {
    color: rgb(39, 174, 96);
}
.team-stat-value--red {
    color: rgb(192, 57, 43);
}
.team-stat-status-icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
    margin-right: 5px;
}
.team-stat-ring {
    width: 42px;
    height: 42px;
    border-radius: 18px;
    border-width: 3px;
    border-color: rgb(212, 160, 23);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.team-stat-ring-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
}
.team-stat-stars {
    flex-direction: row;
    flex-shrink: 0;
}
.team-stat-star {
    font-size: 14px;
    margin-right: 2px;
}

/* ══════════════════════════════════════════
   PANEL RELACIONES
   ══════════════════════════════════════════ */
.panel-board {
}
.board-columns {
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    padding: 6px 0;
}
.board-col {
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
}
.board-circle {
    width: 96px;
    height: 96px;
    border-radius: 28px;
    border-width: 3px;
    border-color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.15);
    align-items: center;
    justify-content: center;
    margin-top: 16px;
    margin-bottom: 16px;
    flex-shrink: 0;
}
.board-circle-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 24px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
}
.board-col-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    white-space: normal;
}
.board-col-sep {
    width: 1px;
    height: 136px;
    background-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

/* ══ FIRED MODAL ══ */

.fired-modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    display: none;
}

.fired-modal-box {
    width: 520px;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-top-width: 3px;
    border-top-color: rgb(192, 57, 43);
    padding: 32px;
    flex-direction: column;
    align-items: center;
}

.fired-modal-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 8px;
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/Icons/boton-x.png");
    -unity-background-scale-mode: scale-to-fit;
}

.fired-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 36px;
    letter-spacing: 4px;
    color: rgb(192, 57, 43);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.fired-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 20px;
    color: rgb(179, 190, 214);
    -unity-text-align: middle-center;
    margin-bottom: 24px;
    white-space: normal;
}

.fired-modal-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    background-color: rgb(192, 57, 43);
    color: white;
    border-width: 0;
    border-radius: 4px;
    padding: 12px 32px;
    cursor: pointer;
}

.fired-modal-box--warning {
    border-top-color: rgb(212, 160, 23);
}

.fired-modal-title--warning {
    color: rgb(212, 160, 23);
}