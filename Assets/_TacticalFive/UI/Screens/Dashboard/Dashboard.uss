/* ══════════════════════════════════════════
   DASHBOARD — Dashboard.uss
   ══════════════════════════════════════════ */

/* ── ROOT ── */
.dashboard-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ══════════════════════════════════════════
   SIDEBAR
   ══════════════════════════════════════════ */
.sidebar {
    width: 200px;
    height: 100%;
    flex-shrink: 0;
    flex-direction: column;
    background-color: rgb(11, 14, 20);
    border-right-width: 1px;
    border-right-color: rgb(28, 33, 48);
}

.sidebar-logo {
    flex-direction: row;
    align-items: center;
    padding: 0 16px;
    height: 100px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    flex-shrink: 0;
}
.sidebar-logo-icon {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
    font-size: 28px;
    padding: 4px 8px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-right: 10px;
}
.sidebar-logo-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
}
.sidebar-logo-text-gold {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
    -unity-text-transform: upper;
}

.sidebar-nav {
    flex-direction: column;
    flex-grow: 1;
    padding: 8px 0;
    overflow: hidden;
    background-color: rgb(0, 0, 0);
}

.nav-item {
    flex-direction: row;
    align-items: center;
    padding: 12px 12px;
    border-width: 0;
    background-color: rgb(0, 0, 0);
}
.nav-item:hover {
    background-color: rgb(22, 26, 36);
}
.nav-item--active {
    background-color: rgb(20, 28, 48);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}
.nav-icon {
    width: 24px;
    height: 24px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}
.nav-label {
    font-size: 16px;
    color: rgb(122, 138, 170);
    margin-left: 18px;
    -unity-text-align: middle-left;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    -unity-text-transform: upper;
    letter-spacing: 1px;
}
.nav-item:hover .nav-label {
    color: rgb(208, 216, 232);
}
.nav-item--active .nav-label {
    color: rgb(255, 255, 255);
}
.nav-arrow {
    font-size: 10px;
    color: rgb(122, 138, 170);
    margin-left: auto;
    -unity-text-align: middle-right;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}
.nav-item:hover .nav-arrow {
    color: rgb(208, 216, 232);
}
.nav-item--active .nav-arrow {
    color: rgb(255, 255, 255);
}
.nav-item:hover {
    background-color: rgb(22, 26, 36);
}

/* ── SUBMENÚS ── */
.nav-submenu {
    display: none;
    flex-direction: column;
    background-color: rgb(8, 10, 14);
}
.nav-submenu--visible {
    display: flex;
}
.nav-submenu-item {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: 10px 12px 10px 54px;
    border-width: 0;
    background-color: transparent;
}
.nav-submenu-item:hover {
    background-color: rgb(22, 26, 36);
}
.nav-submenu-item--active {
    background-color: rgb(20, 28, 48);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}
.nav-submenu-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    -unity-text-align: middle-left;
    color: rgb(100, 116, 148);
}
.nav-submenu-item:hover .nav-submenu-label {
    color: rgb(208, 216, 232);
}
.nav-submenu-item--active .nav-submenu-label {
    color: rgb(255, 255, 255);
}
.nav-item--active {
    background-color: rgb(20, 28, 48);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}
.nav-icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ══════════════════════════════════════════
   MAIN AREA
   ══════════════════════════════════════════ */
.main-area {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

/* ── TOP HEADER ── */
.top-header {
    flex-direction: row;
    align-items: center;
    height: 100px;
    padding: 0 24px;
    background-color: rgb(17, 24, 34);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

.header-brand {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 24px;
}
.header-brand-icon {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
    font-size: 28px;
    padding: 4px 8px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-right: 10px;
}
.header-brand-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
}
.header-brand-text-gold {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
    -unity-text-transform: upper;
}

.header-team-logo {
    width: 64px;
    height: 64px;
    margin-right: 14px;
    flex-shrink: 0;
}
.header-team-info {
    flex-direction: column;
    margin-right: 32px;
    flex-shrink: 0;
}
.header-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
}
.header-manager-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
}

.header-stat {
    flex-direction: column;
    margin-right: 28px;
    flex-shrink: 0;
}
.header-stat-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(85, 102, 119);
}
.header-stat-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    color: rgb(39, 174, 96);
}
.header-stat-value--negative {
    color: rgb(192, 57, 43);
}
.header-stat-value--neutral {
    color: rgb(208, 216, 232);
}
.header-stat-value--gold {
    color: rgb(212, 160, 23);
}

.header-spacer {
    flex-grow: 1;
}

.header-config-icon {
    width: 32px;
    height: 32px;
    margin-left: 18px;
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/Icons/configuracion.png");
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    flex-shrink: 0;
}
.header-config-icon:hover {
    opacity: 0.7;
}

.header-season-info {
    flex-direction: column;
    align-items: flex-end;
    margin-right: 24px;
    flex-shrink: 0;
}
.header-season-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
    -unity-text-transform: upper;
}
.header-date-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
}

/* Anillo de carga giratorio */
.loading-spinner {
    width: 28px;
    height: 28px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: rgb(212, 160, 23);
    border-right-color: rgba(122, 138, 170, 0.12);
    border-bottom-color: rgba(122, 138, 170, 0.12);
    border-left-color: rgba(122, 138, 170, 0.12);
    border-radius: 14px;
    flex-shrink: 0;
    margin: auto 10px auto 0;
}

/* Botón acción principal */
.btn-action {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 250px;
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 18px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.btn-action:hover {
    background-color: rgb(74, 128, 240);
}
.btn-action--match {
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
}
.btn-action--match:hover {
    background-color: rgb(240, 192, 64);
}
.btn-action--simulate {
    background-color: rgb(30, 37, 53);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    color: rgb(74, 128, 240);
}
.btn-action--simulate:hover {
    background-color: rgb(20, 28, 48);
}

/* ── CONTENT AREA ── */
.content-area {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}

.content-scroll {
    flex-grow: 1;
}
.content-scroll > #unity-content-viewport > #unity-content-container {
    flex-direction: column;
    padding: 20px;
}

/* ── GRID DE PANELS ── */
.panels-grid {
    flex-direction: column;
    padding: 20px;
}

.panels-row {
    flex-direction: row;
    margin-bottom: 16px;
    align-items: stretch;
}
.center-column {
    flex-direction: column;
    flex-grow: 3;
    flex-basis: 650px;
    max-width: 650px;
    margin-right: 16px;
}
.center-column > .panel {
    margin-right: 0;
}
.center-column > .panel-player-stats {
    margin-bottom: 16px;
}
.right-column {
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 16px;
}
.right-column > .panel {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 0;
}
.right-column > .panel-team-stats {
    margin-bottom: 16px;
}

/* Panel base */
.panel {
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 2px;
    margin-right: 16px;
    padding: 0;
    overflow: hidden;
}
.panel-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    flex-shrink: 0;
}
.panel-header-left {
    flex-direction: row;
    align-items: center;
}
.panel-more-btn {
    width: 18px;
    height: 18px;
    margin-right: 16px;
    flex-shrink: 0;
    cursor: pointer;
}
.panel-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    color: rgb(208, 216, 232);
}
.panel-date {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(85, 102, 119);
}
.panel-body {
    flex-direction: column;
    padding: 16px 18px;
    flex-grow: 1;
}

/* ══════════════════════════════════════════
   PANEL ÚLTIMO / PRÓXIMO PARTIDO
   ══════════════════════════════════════════ */
.panel-game {
    flex-grow: 1;
    flex-basis: 0;
}

.game-result {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
}
.game-team-block {
    flex-direction: column;
    align-items: center;
    width: 260px;
    flex-shrink: 0;
}
.game-team-logo-lg {
    width: 64px;
    height: 64px;
    margin-bottom: 8px;
}
.game-team-name-lg {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    white-space: normal;
}
.game-score-block {
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
    min-width: 150px;
    flex-shrink: 0;
}
.game-score-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 40px;
    letter-spacing: 4px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    flex-shrink: 0;
    min-width: 60px;
}
.game-score-sep {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 20px;
    color: rgb(58, 74, 99);
    -unity-text-align: middle-center;
    margin: 0 4px;
    flex-shrink: 0;
}
.game-vs-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 4px;
    color: rgb(58, 74, 99);
    -unity-text-align: middle-center;
}
.game-result-badge {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    padding: 5px 14px;
    -unity-text-align: middle-center;
    margin-top: 4px;
}
.badge-win {
    background-color: rgb(39, 174, 96);
    color: rgb(255, 255, 255);
}
.badge-loss {
    background-color: rgb(192, 57, 43);
    color: rgb(255, 255, 255);
}

.no-games-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(58, 74, 99);
    -unity-text-align: middle-center;
    padding: 24px;
    flex-grow: 1;
}

/* ── GAME META ROW ── */
.game-meta-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}
.game-meta-location {
    flex-direction: row;
    align-items: center;
    padding: 6px 12px;
    border-radius: 2px;
    margin-right: 10px;
    flex-shrink: 0;
}
.game-meta-location-icon {
    width: 20px;
    height: 20px;
    margin-right: 6px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}
.game-meta-location-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}
.game-meta-location--home {
    background-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
}
.game-meta-location--home .game-meta-location-label {
    color: rgb(255, 255, 255);
}
.game-meta-location--away {
    background-color: rgb(42, 51, 71);
    color: rgb(122, 138, 170);
}
.game-meta-arena {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    flex-grow: 1;
}
.game-meta-type {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-center;
    margin-left: 10px;
    flex-shrink: 0;
}

/* ══════════════════════════════════════════
   PANEL CLASIFICACIÓN
   ══════════════════════════════════════════ */
.panel-standings {
    flex-grow: 1;
    flex-basis: 0;
}

.conf-tabs {
    flex-direction: row;
}
.conf-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 12px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 6px 16px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-right: 4px;
}
.conf-tab:hover {
    color: rgb(208, 216, 232);
}
.conf-tab--active {
    background-color: rgb(28, 33, 48);
    border-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
}

.standings-table {
    flex-direction: column;
    flex-grow: 1;
}
.standings-header-row {
    flex-direction: row;
    padding: 6px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}
.standings-row {
    flex-direction: row;
    align-items: center;
    padding: 7px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}
.standings-row--my-team {
    background-color: rgb(20, 28, 48);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}
.standings-row--playoff {
    border-left-width: 2px;
    border-left-color: rgb(39, 174, 96);
}
.standings-row--playin {
    border-left-width: 2px;
    border-left-color: rgb(212, 160, 23);
}

.col-rank {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 24px;
    font-size: 16px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.col-team-logo {
    width: 32px;
    height: 32px;
    margin-right: 8px;
    flex-shrink: 0;
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
}
.col-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-rEGULAR.ttf");
    flex-grow: 1;
    font-size: 16px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    -unity-text-transform: upper;
}
.col-stat {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    width: 36px;
    font-size: 16px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.col-stat--header {
    color: rgb(58, 74, 99);
    font-size: 12px;
    letter-spacing: 1px;
}
.col-wins {
    color: rgb(39, 174, 96);
}
.col-losses {
    color: rgb(192, 57, 43);
}
.col-streak {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 55px;
    font-size: 16px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.streak-win  { color: rgb(39, 174, 96); }
.streak-loss { color: rgb(192, 57, 43); }
.streak-none { color: rgb(58, 74, 99); }

/* ══════════════════════════════════════════
   PANEL ESTADÍSTICAS JUGADORES
   ══════════════════════════════════════════ */
.panel-player-stats {
    min-height: 470px;
}
.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
}
.stat-card {
    width: 49%;
    padding: 8px 12px;
    margin: 2px;
    background-color: rgb(17, 24, 34);
    border-color: rgb(28, 40, 56);
    border-width: 1px;
}

.stat-card-two-column {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 100%;  
}

.stat-card-left {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 60px;
    margin-right: 10px;
}

.stat-card-photo-wrapper {
    width: 68px;
    height: 68px;
    border-radius: 5px;
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/Icons/mancha_blanca.png");
    background-size: cover;
    background-position: center;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.stat-card-photo {
    width: 64px;
    height: 64px;
    border-radius: 50px;
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
}

.stat-card-right {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.stat-card-abbr {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
    margin-top: 2px;
}

.stat-card-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-center;
}

.stat-card-player {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
}

.stat-card-games {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
    margin-top: 1px;
}

/* ══════════════════════════════════════════
   PANEL MENSAJES
   ══════════════════════════════════════════ */
.panel-messages {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 180px;
}
.messages-scroll {
    flex-grow: 1;
    min-height: 0;
    padding-top: 8px;
    padding-bottom: 8px;
}
.messages-scroll .unity-scroll-view__content-viewport {
    overflow: hidden;
    padding: 8px 0;
}
.messages-scroll .unity-scroll-view__content-container {
    flex-grow: 1;
}
.messages-body {
    flex-direction: column;
    padding: 8px 18px;
}
.message-item {
    flex-direction: column;
    flex-shrink: 0;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
}
.message-item-subject {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(212, 160, 23);
    margin-bottom: 4px;
    white-space: normal;
}
.message-item-body {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    white-space: normal;
}

/* ══════════════════════════════════════════
   PANEL ESTADÍSTICAS DEL EQUIPO
   ══════════════════════════════════════════ */
.panel-team-stats {
    min-height: 350px;
}
.team-stat-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 51, 71, 0.4);
}
.team-stat-icon-bg {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background-color: rgb(212, 160, 23);
    align-items: center;
    justify-content: center;
    margin-right: 10px;
    flex-shrink: 0;
}
.team-stat-icon-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 12px;
    color: rgb(255, 255, 255);
}
.team-stat-arena-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/Icons/arena.png");
    -unity-background-scale-mode: scale-to-fit;
}
.team-stat-trophy-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/Icons/trofeo.png");
    -unity-background-scale-mode: scale-to-fit;
}
.team-stat-logo {
    width: 32px;
    height: 32px;
    margin-right: 12px;
    flex-shrink: 0;
}
.team-stat-info {
    flex-direction: column;
    flex-grow: 1;
    justify-content: center;
}
.team-stat-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    letter-spacing: 0.5px;
}
.team-stat-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    margin-top: 1px;
}
.team-stat-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-right;
    min-width: 32px;
    flex-shrink: 0;
}
.team-stat-value--green {
    color: rgb(39, 174, 96);
}
.team-stat-value--red {
    color: rgb(192, 57, 43);
}
.team-stat-status-icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
    margin-right: 5px;
}
.team-stat-ring {
    width: 42px;
    height: 42px;
    border-radius: 18px;
    border-width: 3px;
    border-color: rgb(212, 160, 23);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.team-stat-ring-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
}
.team-stat-stars {
    flex-direction: row;
    flex-shrink: 0;
}
.team-stat-star {
    font-size: 14px;
    margin-right: 2px;
}

/* ══════════════════════════════════════════
   PANEL RELACIONES
   ══════════════════════════════════════════ */
.panel-board {
}
.board-columns {
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    padding: 6px 0;
}
.board-col {
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
}
.board-circle {
    width: 72px;
    height: 72px;
    border-radius: 50px;
    border-width: 3px;
    border-color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.15);
    align-items: center;
    justify-content: center;
    margin-top: 10px;
    margin-bottom: 10px;
    flex-shrink: 0;
}
.board-circle-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
}
.board-col-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    white-space: normal;
}
.board-col-sep {
    width: 0px;
    height: 136px;
    background-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

/* ══ FIRED MODAL ══ */

.fired-modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    display: none;
}

.fired-modal-box {
    width: 720px;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-top-width: 3px;
    border-top-color: rgb(192, 57, 43);
    padding: 32px;
    flex-direction: column;
    align-items: center;
}

.fired-modal-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 8px;
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/Icons/boton-x.png");
    -unity-background-scale-mode: scale-to-fit;
}

.fired-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 36px;
    letter-spacing: 4px;
    color: rgb(192, 57, 43);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.fired-modal-title--negative {
    color: rgb(192, 57, 43);
}

.fired-modal-results {
    width: 100%;
    margin-bottom: 24px;
    align-items: center;
}

.fired-modal-result-line {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 20px;
    width: 100%;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.fired-modal-result-line--positive {
    color: rgb(46, 204, 113);
}

.fired-modal-result-line--negative {
    color: rgb(231, 76, 60);
}

.fired-modal-result-line--neutral {
    color: rgb(179, 190, 214);
}

.fired-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 20px;
    color: rgb(179, 190, 214);
    -unity-text-align: middle-center;
    margin-bottom: 24px;
    white-space: normal;
}

.fired-modal-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    background-color: rgb(192, 57, 43);
    color: white;
    border-width: 0;
    border-radius: 4px;
    padding: 12px 32px;
    cursor: pointer;
}

.fired-modal-box--warning {
    border-top-color: rgb(212, 160, 23);
}

.fired-modal-title--warning {
    color: rgb(212, 160, 23);
}

.fired-modal-box--positive {
    border-top-color: rgb(39, 174, 96);
}
.fired-modal-title--positive {
    color: rgb(39, 174, 96);
}
.fired-modal-btn--positive {
    background-color: rgb(39, 174, 96);
}
.fired-modal-btn--warning {
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
}

/* ══ DEADLINE DAY & SUMMARY OVERLAYS ══ */

.deadline-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.88);
    align-items: center;
    justify-content: center;
    display: none;
    z-index: 600;
}

.deadline-box {
    width: 580px;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-top-width: 4px;
    border-top-color: rgb(212, 160, 23);
    padding: 36px;
    flex-direction: column;
    align-items: center;
}

.deadline-icon {
    font-size: 48px;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.deadline-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 34px;
    letter-spacing: 4px;
    color: rgb(212, 160, 23);
    margin-bottom: 12px;
    -unity-text-transform: upper;
    -unity-text-align: middle-center;
}

.deadline-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(179, 190, 214);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
    white-space: normal;
}

.deadline-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 20px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    white-space: normal;
}

.deadline-btn-group {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 16px;
}

.deadline-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    letter-spacing: 2px;
    border-width: 0;
    border-radius: 4px;
    padding: 12px 28px;
    margin-left: 6px;
    margin-right: 6px;
    cursor: pointer;
}

.deadline-btn--primary {
    background-color: rgb(42, 95, 201);
    color: white;
}

.deadline-btn--warning {
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
}

.deadline-btn--danger {
    background-color: rgb(192, 57, 43);
    color: white;
}

.deadline-summary-stats {
    margin: 8px 0 20px 0;
    padding: 16px;
    background-color: rgb(22, 26, 36);
    border-radius: 4px;
    align-items: center;
}

.deadline-stat-row {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
    white-space: normal;
}

/* ══ INJURED LINEUP MODAL ══ */

.injured-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 20px;
    color: rgb(179, 190, 214);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    white-space: normal;
}

.injured-modal-list {
    margin: 8px 0 16px 0;
    padding: 8px 16px;
    background-color: rgb(25, 20, 20);
    border-radius: 4px;
    align-self: stretch;
}

.injured-modal-player-row {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(192, 57, 43);
    padding: 2px 0;
}

.injured-modal-btn-group {
    flex-direction: row;
    align-self: stretch;
}

.injured-modal-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    letter-spacing: 2px;
    background-color: rgb(42, 51, 71);
    color: white;
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-radius: 4px;
    padding: 12px 16px;
    cursor: pointer;
    flex-grow: 1;
    -unity-text-align: middle-center;
    margin-right: 6px;
}

.injured-modal-btn--primary {
    background-color: rgb(192, 57, 43);
    border-color: rgb(192, 57, 43);
    margin-right: 0;
    margin-left: 6px;
}

/* Botones del modal de GESTIÓN DE DESCANSO (load management).
   Solo se aplican dentro de ShowLoadManagementModal para no
   alterar el modal de quinteto con lesionados. */
.load-mgmt-modal-box {
    width: 870px;
}
.injured-modal-btn.load-mgmt-modal-btn--blue {
    background-color: rgb(42, 95, 201);
    border-color: rgb(42, 95, 201);
}
.injured-modal-btn.load-mgmt-modal-btn--green {
    background-color: rgb(39, 174, 96);
    border-color: rgb(39, 174, 96);
}

/* ══ Config modal settings styles (inlined from Settings.uss) ══ */

.settings-section {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(150, 160, 180);
    margin-top: 16px;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}
.settings-section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(150, 160, 180);
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
}
.settings-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}
.settings-label {
    width: 160px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
}
.custom-slider {
    cursor: pointer;
    position: relative;
    flex-grow: 1;
    height: 30px;
    min-height: 30px;
    margin: 0;
    margin-right: 12px;
    padding: 0;
}
.custom-slider-track {
    position: absolute;
    left: 0;
    right: 0;
    top: 13px;
    height: 4px;
    background-color: rgb(42, 51, 71);
    border-radius: 2px;
}
.custom-slider-fill {
    position: absolute;
    left: 0;
    top: 13px;
    height: 4px;
    width: 0%;
    background-color: rgb(248, 196, 64);
    border-top-left-radius: 2px;
    border-bottom-left-radius: 2px;
}
.custom-slider-dragger {
    cursor: pointer;
    position: absolute;
    top: 7px;
    width: 16px;
    height: 16px;
    margin-left: -8px;
    left: 0%;
    background-color: rgb(248, 196, 64);
    border-radius: 8px;
}
.settings-value {
    width: 50px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(248, 196, 64);
    -unity-text-align: middle-right;
}
.settings-quality-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}
.settings-quality-options {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-end;
}
.settings-quality-btn {
    cursor: pointer;
    width: 70px;
    height: 36px;
    margin-left: 6px;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    color: rgb(208, 216, 232);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    -unity-text-align: middle-center;
    -unity-text-transform: upper;
    transition-property: background-color, border-color, color;
    transition-duration: 0.15s;
}
.settings-quality-btn:hover {
    background-color: rgb(28, 33, 48);
    border-color: rgb(58, 74, 99);
}
.settings-quality-btn--active {
    background-color: rgb(248, 196, 64);
    border-color: rgb(248, 196, 64);
    color: rgb(15, 17, 23);
}
.settings-quality-btn--active:hover {
    background-color: rgb(255, 215, 90);
    border-color: rgb(255, 215, 90);
}
.settings-quality-btn--wide {
    width: 130px;
}
.settings-columns {
    flex-direction: row;
    align-items: flex-start;
}
.settings-columns .settings-section--column {
    flex-grow: 1;
    flex-basis: 0;
}
.settings-columns .settings-section--column:first-child {
    margin-right: 24px;
}
.settings-columns .settings-section--column .settings-quality-row {
    flex-direction: column;
    align-items: flex-start;
}
.settings-columns .settings-section--column .settings-quality-row .settings-label {
    width: auto;
    white-space: nowrap;
    margin-bottom: 8px;
}
.settings-btn {
    cursor: pointer;
    height: 48px;
    width: 100%;
    border-width: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    -unity-text-transform: upper;
    margin-top: 8px;
    align-self: center;
    transition-property: background-color;
    transition-duration: 0.15s;
}
.settings-btn--secondary {
    background-color: rgb(42, 51, 71);
    color: rgb(208, 216, 232);
}
.settings-btn--secondary:hover {
    background-color: rgb(58, 74, 99);
}
.settings-btn--danger {
    background-color: rgb(192, 57, 43);
    color: rgb(255, 255, 255);
}
.settings-btn--danger:hover {
    background-color: rgb(231, 76, 60);
}

/* ══ TRADE OFFER MODAL ══ */

.trade-offer-modal-box {
    width: 680px;
}

.trade-offer-columns {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    margin-top: 12px;
}

.trade-offer-col {
    flex-direction: column;
    align-items: center;
    width: 300px;
    margin-left: 10px;
    margin-right: 10px;
}

.trade-offer-col-header {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(192, 57, 43);
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.trade-offer-col-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.trade-offer-player-card {
    flex-direction: row;
    align-items: center;
    background-color: rgb(25, 27, 32);
    border-radius: 6px;
    padding: 8px;
    margin-bottom: 6px;
    width: 100%;
}

.trade-offer-photo {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background-color: rgb(34, 36, 42);
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.trade-offer-player-info {
    flex-direction: column;
    align-items: flex-start;
    margin-left: 10px;
    flex-grow: 1;
    overflow: hidden;
}

.trade-offer-player-name-row {
    flex-direction: row;
    align-items: center;
}
.trade-offer-player-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 160px;
}
.trade-offer-player-ovr {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    flex-shrink: 0;
    margin-left: 6px;
}

.trade-offer-player-detail {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    margin-top: 1px;
}

.trade-offer-player-salary {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(46, 204, 113);
    margin-top: 2px;
}

.trade-offer-picks-header {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 15px;
    letter-spacing: 2px;
    color: rgb(122, 138, 170);
    margin-top: 12px;
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}

.trade-offer-picks-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.15);
    border-radius: 4px;
    padding: 4px 12px;
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}

/* ── Resumen de simulación rápida ── */
.fastsim-summary-box {
    max-height: 600px;
    border-top-color: rgb(42, 95, 201);
}

.fastsim-summary-title {
    color: rgb(255, 255, 255);
}

.fastsim-summary-btn {
    border-radius: 0;
    flex-grow: 0;
    margin-left: auto;
    margin-right: auto;
    padding: 8px 40px;
}

/* ── Toast de logro desbloqueado ── */
.toast-achievement-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.toast-achievement-desc {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    -unity-font-style: bold;
}
