/* ══════════════════════════════════════════
   DASHBOARD — Dashboard.uss
   ══════════════════════════════════════════ */

/* ── ROOT ── */
.dashboard-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ══════════════════════════════════════════
   SIDEBAR
   ══════════════════════════════════════════ */
.sidebar {
    width: 200px;
    flex-shrink: 0;
    flex-direction: column;
    background-color: rgb(11, 14, 20);
    border-right-width: 1px;
    border-right-color: rgb(28, 33, 48);
}

.sidebar-logo {
    flex-direction: row;
    align-items: center;
    padding: 0 16px;
    height: 56px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    flex-shrink: 0;
}
.sidebar-logo-icon {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
    font-size: 14px;
    padding: 4px 8px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-right: 10px;
}
.sidebar-logo-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
}
.sidebar-logo-text-gold {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
    -unity-text-transform: upper;
    margin-left: 4px;
}

.sidebar-nav {
    flex-direction: column;
    flex-grow: 1;
    padding: 8px 0;
    overflow: hidden;
}

.nav-item {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    flex-direction: row;
    align-items: center;
    padding: 10px 20px;
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(122, 138, 170);
    border-width: 0;
    background-color: rgb(0, 0, 0);
    -unity-text-align: middle-left;
}
.nav-item:hover {
    background-color: rgb(22, 26, 36);
    color: rgb(208, 216, 232);
}
.nav-item--active {
    background-color: rgb(20, 28, 48);
    color: rgb(255, 255, 255);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}

.sidebar-footer {
    flex-direction: column;
    padding: 12px 16px;
    border-top-width: 1px;
    border-top-color: rgb(28, 33, 48);
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    flex-shrink: 0;
}
.btn-reset {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    flex-direction: row;
    align-items: center;
    background-color: rgb(0, 0, 0);
    border-width: 0;
    color: rgb(85, 102, 119);
    font-size: 13px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    padding: 8px 0;
    -unity-text-align: middle-left;
}
.btn-reset:hover {
    color: rgb(192, 57, 43);
}
.sidebar-version {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(58, 74, 99);
    -unity-text-align: middle-left;
    margin-top: 4px;
}

/* ══════════════════════════════════════════
   MAIN AREA
   ══════════════════════════════════════════ */
.main-area {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

/* ── TOP HEADER ── */
.top-header {
    flex-direction: row;
    align-items: center;
    height: 64px;
    padding: 0 24px;
    background-color: rgb(17, 24, 34);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

.header-team-logo {
    width: 44px;
    height: 44px;
    margin-right: 14px;
    flex-shrink: 0;
}
.header-team-info {
    flex-direction: column;
    margin-right: 32px;
    flex-shrink: 0;
}
.header-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 20px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
}
.header-manager-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
}

.header-stat {
    flex-direction: column;
    margin-right: 28px;
    flex-shrink: 0;
}
.header-stat-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 11px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(85, 102, 119);
}
.header-stat-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    color: rgb(39, 174, 96);
}
.header-stat-value--negative {
    color: rgb(192, 57, 43);
}
.header-stat-value--neutral {
    color: rgb(208, 216, 232);
}

.header-spacer {
    flex-grow: 1;
}

.header-season-info {
    flex-direction: column;
    align-items: flex-end;
    margin-right: 24px;
    flex-shrink: 0;
}
.header-season-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 15px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
    -unity-text-transform: upper;
}
.header-date-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
}

/* Botón acción principal */
.btn-action {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 24px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.btn-action:hover {
    background-color: rgb(74, 128, 240);
}
.btn-action--match {
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
}
.btn-action--match:hover {
    background-color: rgb(240, 192, 64);
}
.btn-action--simulate {
    background-color: rgb(30, 37, 53);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    color: rgb(74, 128, 240);
}
.btn-action--simulate:hover {
    background-color: rgb(20, 28, 48);
}

/* ── CONTENT AREA ── */
.content-area {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}

.content-scroll {
    flex-grow: 1;
}
.content-scroll > #unity-content-viewport > #unity-content-container {
    flex-direction: column;
    padding: 20px;
}

/* ── GRID DE PANELS ── */
.panels-grid {
    flex-direction: column;
    padding: 20px;
}

.panels-row {
    flex-direction: row;
    margin-bottom: 16px;
    align-items: stretch;
}

/* Panel base */
.panel {
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 2px;
    margin-right: 16px;
    padding: 0;
    overflow: hidden;
}
.panel-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    flex-shrink: 0;
}
.panel-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 13px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    color: rgb(208, 216, 232);
}
.panel-date {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(85, 102, 119);
}
.panel-body {
    flex-direction: column;
    padding: 16px 18px;
    flex-grow: 1;
}

/* ══════════════════════════════════════════
   PANEL ÚLTIMO / PRÓXIMO PARTIDO
   ══════════════════════════════════════════ */
.panel-game {
    flex-grow: 1;
    flex-basis: 0;
}

.game-result {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
}
.game-team-block {
    flex-direction: column;
    align-items: center;
    width: 160px;
    flex-shrink: 0;
}
.game-team-logo-lg {
    width: 64px;
    height: 64px;
    margin-bottom: 8px;
}
.game-team-name-lg {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    white-space: normal;
}
.game-score-block {
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
}
.game-score-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 40px;
    letter-spacing: 4px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}
.game-score-sep {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 20px;
    color: rgb(58, 74, 99);
    -unity-text-align: middle-center;
    margin: 0 4px;
}
.game-vs-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 4px;
    color: rgb(58, 74, 99);
    -unity-text-align: middle-center;
}
.game-result-badge {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 12px;
    letter-spacing: 2px;
    padding: 3px 10px;
    -unity-text-align: middle-center;
    margin-top: 4px;
}
.badge-win {
    background-color: rgb(39, 174, 96);
    color: rgb(255, 255, 255);
}
.badge-loss {
    background-color: rgb(192, 57, 43);
    color: rgb(255, 255, 255);
}

.no-games-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(58, 74, 99);
    -unity-text-align: middle-center;
    padding: 24px;
    flex-grow: 1;
}

/* ── GAME META ROW ── */
.game-meta-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}
.game-meta-location {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 2px;
    -unity-text-align: middle-center;
    margin-right: 10px;
    flex-shrink: 0;
}
.game-meta-location--home {
    background-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
}
.game-meta-location--away {
    background-color: rgb(42, 51, 71);
    color: rgb(122, 138, 170);
}
.game-meta-arena {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 13px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    flex-grow: 1;
}
.game-meta-type {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-center;
    margin-left: 10px;
    flex-shrink: 0;
}

/* ══════════════════════════════════════════
   PANEL CLASIFICACIÓN
   ══════════════════════════════════════════ */
.panel-standings {
    flex-grow: 1;
    flex-basis: 0;
}

.conf-tabs {
    flex-direction: row;
}
.conf-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 12px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 6px 16px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-right: 4px;
}
.conf-tab:hover {
    color: rgb(208, 216, 232);
}
.conf-tab--active {
    background-color: rgb(28, 33, 48);
    border-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
}

.standings-table {
    flex-direction: column;
    flex-grow: 1;
}
.standings-header-row {
    flex-direction: row;
    padding: 6px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}
.standings-row {
    flex-direction: row;
    align-items: center;
    padding: 7px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}
.standings-row--my-team {
    background-color: rgb(20, 28, 48);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}
.standings-row--playoff {
    border-left-width: 2px;
    border-left-color: rgb(39, 174, 96);
}
.standings-row--playin {
    border-left-width: 2px;
    border-left-color: rgb(212, 160, 23);
}

.col-rank {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    width: 24px;
    font-size: 13px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.col-team-logo {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    flex-shrink: 0;
}
.col-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    flex-grow: 1;
    font-size: 13px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    -unity-text-transform: upper;
}
.col-stat {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    width: 36px;
    font-size: 13px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.col-stat--header {
    color: rgb(58, 74, 99);
    font-size: 11px;
    letter-spacing: 1px;
}
.col-wins {
    color: rgb(39, 174, 96);
}
.col-losses {
    color: rgb(192, 57, 43);
}
.col-streak {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    width: 40px;
    font-size: 12px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.streak-win  { color: rgb(39, 174, 96); }
.streak-loss { color: rgb(192, 57, 43); }
.streak-none { color: rgb(58, 74, 99); }

/* ══════════════════════════════════════════
   PANEL ESTADÍSTICAS JUGADORES
   ══════════════════════════════════════════ */
.panel-player-stats {
    flex-grow: 1;
    flex-basis: 0;
}
.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
}
.stat-card {
    width: 50%;
    flex-direction: column;
    align-items: center;
    padding: 16px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    border-right-width: 1px;
    border-right-color: rgb(28, 33, 48);
    border-top-width: 0;
    border-left-width: 0;
}
.stat-card-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 11px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}
.stat-card-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 36px;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-center;
}
.stat-card-player {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 13px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    margin-top: 4px;
}
.stat-card-games {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 11px;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
    margin-top: 2px;
}

/* ══════════════════════════════════════════
   PANEL RELACIONES
   ══════════════════════════════════════════ */
.panel-board {
    flex-grow: 1;
    flex-basis: 0;
}
.board-item {
    flex-direction: column;
    margin-bottom: 14px;
}
.board-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 12px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(122, 138, 170);
    margin-bottom: 6px;
}
.board-bar-bg {
    height: 6px;
    background-color: rgb(28, 33, 48);
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 4px;
}
.board-bar-fill {
    height: 6px;
    border-radius: 3px;
    background-color: rgb(212, 160, 23);
}
.board-bar-fill--green  { background-color: rgb(39, 174, 96); }
.board-bar-fill--gold   { background-color: rgb(212, 160, 23); }
.board-bar-fill--red    { background-color: rgb(192, 57, 43); }
.board-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 13px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-right;
}