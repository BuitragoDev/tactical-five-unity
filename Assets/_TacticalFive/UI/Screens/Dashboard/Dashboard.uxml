<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_TacticalFive/UI/Screens/Dashboard/Dashboard.uss?fileID=7433441132597879392&amp;guid=4ea72934f300e2fc78940e1d76d7e1a8&amp;type=3#Dashboard"/>
    <Style src="../LegalNotice/LegalNotice.uss" />
<ui:VisualElement name="DashboardRoot" class="dashboard-root">
        
        <ui:VisualElement class="main-area">
            <ui:VisualElement name="TopHeader" class="top-header">
                <ui:VisualElement class="header-brand">
                    <ui:Label text="TF" class="header-brand-icon"/>
                    <ui:Label text="TACTICAL" class="header-brand-text"/>
                    <ui:Label text="FIVE" class="header-brand-text-gold"/>
                </ui:VisualElement>
                <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo"/>
                <ui:VisualElement class="header-team-info">
                    <ui:Label name="HeaderTeamName" text="" class="header-team-name"/>
                    <ui:Label name="HeaderManagerName" text="" class="header-manager-name"/>
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label text="PRESUPUESTO" class="header-stat-label"/>
                    <ui:Label name="HeaderBudget" text="" class="header-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label text="MASA SALARIAL" class="header-stat-label"/>
                    <ui:Label name="HeaderPayroll" text="" class="header-stat-value header-stat-value--neutral"/>
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label text="MARGEN SALARIAL" class="header-stat-label"/>
                    <ui:Label name="HeaderMargin" text="" class="header-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label text="QUÍMICA DE EQUIPO" class="header-stat-label"/>
                    <ui:Label name="HeaderChemistry" text="" class="header-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="header-spacer"/>
                <ui:VisualElement class="header-season-info">
                    <ui:Label name="HeaderSeason" text="" class="header-season-label"/>
                    <ui:Label name="HeaderDate" text="" class="header-date-label"/>
                </ui:VisualElement>
                <ui:VisualElement name="LoadingSpinner" class="loading-spinner" />
                <ui:Button name="BtnAction" text="CONTINUAR" class="btn-action"/>
                <ui:VisualElement name="ConfigIcon" class="header-config-icon" />
            </ui:VisualElement>
            <ui:ScrollView name="ContentScroll" horizontal-scrolling-enabled="false" mode="Vertical" class="content-scroll">
                <ui:VisualElement class="panels-grid">
                    <ui:VisualElement class="panels-row">
                        <ui:VisualElement name="PanelLastGame" class="panel panel-game">
                            <ui:VisualElement class="panel-header">
                                <ui:VisualElement class="panel-header-left">
                                    <ui:VisualElement name="BtnLastGameMore" class="panel-more-btn" />
                                    <ui:Label text="ÚLTIMO PARTIDO" class="panel-title"/>
                                </ui:VisualElement>
                                <ui:Label name="LastGameDate" text="" class="panel-date"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="LastGameBody" class="panel-body">
                                <ui:Label name="NoLastGame" text="AÚN NO SE HAN JUGADO PARTIDOS" class="no-games-text"/>
                                <ui:VisualElement name="LastGameResult" class="game-result">
                                    <ui:VisualElement name="LastGameHome" class="game-team-block">
                                        <ui:VisualElement name="LastHomeLog" class="game-team-logo-lg"/>
                                        <ui:Label name="LastHomeName" text="" class="game-team-name-lg"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="game-score-block">
                                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                                            <ui:Label name="LastHomeScore" text="" class="game-score-text"/>
                                            <ui:Label text="-" class="game-score-sep"/>
                                            <ui:Label name="LastAwayScore" text="" class="game-score-text"/>
                                        </ui:VisualElement>
                                        <ui:Label name="LastResultBadge" text="" class="game-result-badge"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="LastGameAway" class="game-team-block">
                                        <ui:VisualElement name="LastAwayLog" class="game-team-logo-lg"/>
                                        <ui:Label name="LastAwayName" text="" class="game-team-name-lg"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="LastGameMeta" class="game-meta-row">
                                    <ui:VisualElement name="LastGameLocation" class="game-meta-location">
                                    <ui:VisualElement name="LastGameLocationIcon" class="game-meta-location-icon"/>
                                    <ui:Label name="LastGameLocationText" text="LOCAL" class="game-meta-location-label"/>
                                </ui:VisualElement>
                                    <ui:Label name="LastGameArena" text="" class="game-meta-arena"/>
                                    <ui:Label name="LastGameType" text="" class="game-meta-type"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="PanelNextGame" class="panel panel-game">
                            <ui:VisualElement class="panel-header">
                                <ui:VisualElement class="panel-header-left">
                                    <ui:VisualElement name="BtnNextGameMore" class="panel-more-btn" />
                                    <ui:Label text="PRÓXIMO PARTIDO" class="panel-title"/>
                                </ui:VisualElement>
                                <ui:Label name="NextGameDate" text="" class="panel-date"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="NextGameBody" class="panel-body">
                                <ui:Label name="NoNextGame" text="NO HAY MÁS PARTIDOS PROGRAMADOS" class="no-games-text"/>
                                <ui:VisualElement name="NextGameResult" class="game-result">
                                    <ui:VisualElement name="NextGameHome" class="game-team-block">
                                        <ui:VisualElement name="NextHomeLog" class="game-team-logo-lg"/>
                                        <ui:Label name="NextHomeName" text="" class="game-team-name-lg"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="game-score-block">
                                        <ui:Label text="VS" class="game-vs-text"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="NextGameAway" class="game-team-block">
                                        <ui:VisualElement name="NextAwayLog" class="game-team-logo-lg"/>
                                        <ui:Label name="NextAwayName" text="" class="game-team-name-lg"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="NextGameMeta" class="game-meta-row">
                                    <ui:VisualElement name="NextGameLocation" class="game-meta-location">
                                    <ui:VisualElement name="NextGameLocationIcon" class="game-meta-location-icon"/>
                                    <ui:Label name="NextGameLocationText" text="VISITANTE" class="game-meta-location-label"/>
                                </ui:VisualElement>
                                    <ui:Label name="NextGameArena" text="" class="game-meta-arena"/>
                                    <ui:Label name="NextGameType" text="" class="game-meta-type"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="panels-row">
                        <ui:VisualElement name="PanelStandings" class="panel panel-standings">
                            <ui:VisualElement class="panel-header">
                                <ui:VisualElement class="panel-header-left">
                                    <ui:VisualElement name="BtnStandingsMore" class="panel-more-btn" />
                                    <ui:Label text="CLASIFICACIÓN" class="panel-title"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="conf-tabs">
                                    <ui:Button name="TabEast" text="ESTE" class="conf-tab"/>
                                    <ui:Button name="TabWest" text="OESTE" class="conf-tab conf-tab--active"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="standings-header-row">
                                <ui:Label text="#" class="col-rank col-stat--header"/>
                                <ui:Label class="col-team-logo"/>
                                <ui:Label text="EQUIPO" class="col-team-name col-stat--header"/>
                                <ui:Label text="PJ" class="col-stat col-stat--header"/>
                                <ui:Label text="G" class="col-stat col-stat--header"/>
                                <ui:Label text="P" class="col-stat col-stat--header"/>
                                <ui:Label text="%" class="col-stat col-stat--header"/>
                                <ui:Label text="RACHA" class="col-streak col-stat--header"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="StandingsBody" class="standings-table"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="center-column">
                            <ui:VisualElement name="PanelPlayerStats" class="panel panel-player-stats">
                                <ui:VisualElement class="panel-header">
                                    <ui:VisualElement class="panel-header-left">
                                        <ui:VisualElement name="BtnPlayerStatsMore" class="panel-more-btn" />
                                        <ui:Label text="ESTADÍSTICAS DE JUGADORES" class="panel-title"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="panel-body">
                                    <ui:VisualElement class="stats-grid">
                                        <ui:VisualElement class="stat-card">
                                            <ui:VisualElement class="stat-card-two-column">
                                                <ui:VisualElement class="stat-card-left">
                                                    <ui:VisualElement class="stat-card-photo-wrapper">
                                                        <ui:VisualElement name="StatScorerPhoto" class="stat-card-photo" />
                                                    </ui:VisualElement>
                                                    <ui:Label class="stat-card-abbr" text="PTS" />
                                                </ui:VisualElement>
                                                <ui:VisualElement class="stat-card-right">
                                                    <ui:Label name="StatScorer" text="--" class="stat-card-val" />
                                                    <ui:Label name="StatScorerName" text="" class="stat-card-player" />
                                                    <ui:Label name="StatScorerGames" text="" class="stat-card-games" />
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                        <ui:VisualElement class="stat-card">
                                            <ui:VisualElement class="stat-card-two-column">
                                                <ui:VisualElement class="stat-card-left">
                                                    <ui:VisualElement class="stat-card-photo-wrapper">
                                                        <ui:VisualElement name="StatRebounderPhoto" class="stat-card-photo" />
                                                    </ui:VisualElement>
                                                    <ui:Label class="stat-card-abbr" text="REB" />
                                                </ui:VisualElement>
                                                <ui:VisualElement class="stat-card-right">
                                                    <ui:Label name="StatRebounder" text="--" class="stat-card-val" />
                                                    <ui:Label name="StatRebounderName" text="" class="stat-card-player" />
                                                    <ui:Label name="StatRebounderGames" text="" class="stat-card-games" />
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                        <ui:VisualElement class="stat-card">
                                            <ui:VisualElement class="stat-card-two-column">
                                                <ui:VisualElement class="stat-card-left">
                                                    <ui:VisualElement class="stat-card-photo-wrapper">
                                                        <ui:VisualElement name="StatAssisterPhoto" class="stat-card-photo" />
                                                    </ui:VisualElement>
                                                    <ui:Label class="stat-card-abbr" text="ASI" />
                                                </ui:VisualElement>
                                                <ui:VisualElement class="stat-card-right">
                                                    <ui:Label name="StatAssister" text="--" class="stat-card-val" />
                                                    <ui:Label name="StatAssisterName" text="" class="stat-card-player" />
                                                    <ui:Label name="StatAssisterGames" text="" class="stat-card-games" />
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                        <ui:VisualElement class="stat-card">
                                            <ui:VisualElement class="stat-card-two-column">
                                                <ui:VisualElement class="stat-card-left">
                                                    <ui:VisualElement class="stat-card-photo-wrapper">
                                                        <ui:VisualElement name="StatStealerPhoto" class="stat-card-photo" />
                                                    </ui:VisualElement>
                                                    <ui:Label class="stat-card-abbr" text="ROB" />
                                                </ui:VisualElement>
                                                <ui:VisualElement class="stat-card-right">
                                                    <ui:Label name="StatStealer" text="--" class="stat-card-val" />
                                                    <ui:Label name="StatStealerName" text="" class="stat-card-player" />
                                                    <ui:Label name="StatStealerGames" text="" class="stat-card-games" />
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                        <ui:VisualElement class="stat-card">
                                            <ui:VisualElement class="stat-card-two-column">
                                                <ui:VisualElement class="stat-card-left">
                                                    <ui:VisualElement class="stat-card-photo-wrapper">
                                                        <ui:VisualElement name="StatBlockerPhoto" class="stat-card-photo" />
                                                    </ui:VisualElement>
                                                    <ui:Label class="stat-card-abbr" text="TAP" />
                                                </ui:VisualElement>
                                                <ui:VisualElement class="stat-card-right">
                                                    <ui:Label name="StatBlocker" text="--" class="stat-card-val" />
                                                    <ui:Label name="StatBlockerName" text="" class="stat-card-player" />
                                                    <ui:Label name="StatBlockerGames" text="" class="stat-card-games" />
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                        <ui:VisualElement class="stat-card">
                                            <ui:VisualElement class="stat-card-two-column">
                                                <ui:VisualElement class="stat-card-left">
                                                    <ui:VisualElement class="stat-card-photo-wrapper">
                                                        <ui:VisualElement name="StatRatedPhoto" class="stat-card-photo" />
                                                    </ui:VisualElement>
                                                    <ui:Label class="stat-card-abbr" text="VAL" />
                                                </ui:VisualElement>
                                                <ui:VisualElement class="stat-card-right">
                                                    <ui:Label name="StatRated" text="--" class="stat-card-val" />
                                                    <ui:Label name="StatRatedName" text="" class="stat-card-player" />
                                                    <ui:Label name="StatRatedGames" text="" class="stat-card-games" />
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="PanelBoard" class="panel panel-board">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label text="RELACIONES" class="panel-title"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="panel-body">
                                    <ui:VisualElement class="board-columns">
                                        <ui:VisualElement class="board-col">
                                            <ui:VisualElement name="CircleTrust" class="board-circle">
                                                <ui:Label name="ValTrust" class="board-circle-val" text="50%" />
                                            </ui:VisualElement>
                                            <ui:Label class="board-col-label" text="CONFIANZA DIRECTIVA" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="board-col-sep" />
                                        <ui:VisualElement class="board-col">
                                            <ui:VisualElement name="CircleMorale" class="board-circle">
                                                <ui:Label name="ValMorale" class="board-circle-val" text="50%" />
                                            </ui:VisualElement>
                                            <ui:Label class="board-col-label" text="MORAL DEL EQUIPO" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="board-col-sep" />
                                        <ui:VisualElement class="board-col">
                                            <ui:VisualElement name="CircleFanConfidence" class="board-circle">
                                                <ui:Label name="ValFanConfidence" class="board-circle-val" text="50%" />
                                            </ui:VisualElement>
                                            <ui:Label class="board-col-label" text="CONFIANZA FANS" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="right-column">
                            <ui:VisualElement name="PanelTeamStats" class="panel panel-team-stats">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label text="ESTADÍSTICAS DEL EQUIPO" class="panel-title"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="panel-body">
                                    <ui:VisualElement class="team-stat-row">
                                        <ui:VisualElement class="team-stat-trophy-icon"/>
                                        <ui:VisualElement class="team-stat-info">
                                            <ui:Label text="Objetivo de la temporada" class="team-stat-title"/>
                                            <ui:Label name="TeamObjective" text="--" class="team-stat-subtitle"/>
                                        </ui:VisualElement>
                                        <ui:VisualElement name="TeamObjectiveStatus" class="team-stat-status-icon"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="team-stat-row">
                                        <ui:VisualElement name="TeamStatsLogo" class="team-stat-logo"/>
                                        <ui:VisualElement class="team-stat-info">
                                            <ui:Label text="Media equipo" class="team-stat-title"/>
                                            <ui:Label name="TeamOverallLabel" text="--" class="team-stat-subtitle"/>
                                        </ui:VisualElement>
                                        <ui:VisualElement name="TeamOverallRing" class="team-stat-ring">
                                            <ui:Label name="TeamOverallRingVal" text="--" class="team-stat-ring-val"/>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="team-stat-row">
                                        <ui:VisualElement name="TeamChemistryIcon" class="team-stat-logo"/>
                                        <ui:VisualElement class="team-stat-info">
                                            <ui:Label text="Química equipo" class="team-stat-title" />
                                            <ui:Label name="TeamChemistryLabel" text="--" class="team-stat-subtitle"/>
                                        </ui:VisualElement>
                                        <ui:VisualElement name="TeamChemistryRing" class="team-stat-ring">
                                            <ui:Label name="TeamChemistryRingVal" text="--" class="team-stat-ring-val"/>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="team-stat-row">
                                        <ui:VisualElement class="team-stat-arena-icon"/>
                                        <ui:VisualElement class="team-stat-info">
                                            <ui:Label name="TeamArenaName" text="Pabellón" class="team-stat-title"/>
                                            <ui:Label name="TeamArenaCapacity" text="--" class="team-stat-subtitle"/>
                                        </ui:VisualElement>
                                        <ui:VisualElement name="TeamReputationStars" class="team-stat-stars"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="PanelMessages" class="panel panel-messages">
                                <ui:VisualElement class="panel-header">
                                    <ui:VisualElement class="panel-header-left">
                                        <ui:Label text="NOTICIAS" class="panel-title"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:ScrollView name="MessagesScroll" class="messages-scroll" horizontal-scrolling-enabled="false" mode="Vertical">
                                    <ui:VisualElement name="MessagesBody" class="messages-body" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIGURACIÓN ══ -->
        <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigModalBox" class="modal-box">
                <ui:Label class="modal-title" text="CONFIGURACIÓN" />
                <ui:VisualElement class="modal-body">
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="AUDIO" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="Volumen General" />
                            <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="Música" />
                            <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="Efectos" />
                            <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-columns">
                        <ui:VisualElement class="settings-section settings-section--column">
                            <ui:Label class="settings-section-title" text="GRÁFICOS" />
                            <ui:VisualElement class="settings-quality-row">
                                <ui:Label class="settings-label" text="Calidad" />
                                <ui:VisualElement class="settings-quality-options">
                                    <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="Baja" />
                                    <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="Media" />
                                    <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="Alta" />
                                    <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="Ultra" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-section settings-section--column">
                            <ui:Label class="settings-section-title" text="SIMULACIÓN" />
                            <ui:VisualElement class="settings-quality-row">
                                <ui:Label class="settings-label" text="Vista de Partido" />
                                <ui:VisualElement class="settings-quality-options">
                                    <ui:Button name="ConfigBtnSimDirect" class="settings-quality-btn" text="Directa" />
                                    <ui:Button name="ConfigBtnSimPlay" class="settings-quality-btn settings-quality-btn--wide" text="Play-by-play" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="JUEGO" />
                        <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="VOLVER AL MENÚ PRINCIPAL" />
                        <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="SALIR DEL JUEGO" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ConfigBtnCerrar" class="modal-close" text="CERRAR" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR VOLVER AL MENÚ PRINCIPAL ══ -->
        <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="VOLVER AL MENÚ PRINCIPAL" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="¿Estás seguro de que quieres volver al menú principal?" />
                    <ui:Label class="modal-paragraph" text="Se perderá el progreso no guardado de la partida actual. Asegúrate de haber guardado antes de continuar." />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="NO, QUEDARME" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="SÍ, VOLVER" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR SALIR DEL JUEGO ══ -->
        <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="SALIR DEL JUEGO" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="¿Estás seguro de que quieres salir del juego?" />
                    <ui:Label class="modal-paragraph" text="Tu progreso se guarda automáticamente durante la partida. Al volver a cargarla continuarás desde el último estado guardado." />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="NO" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="SÍ, SALIR" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
