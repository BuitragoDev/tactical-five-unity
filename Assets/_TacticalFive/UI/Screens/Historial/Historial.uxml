<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Historial.uss" />
    <Style src="../Dashboard/Dashboard.uss" />

    <ui:VisualElement name="HistorialRoot" class="historial-root">

        <!-- ══ SIDEBAR ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="historial-main">

            <!-- TOP HEADER -->
            <ui:VisualElement name="TopHeader" class="top-header">
                <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo" />
                <ui:VisualElement class="header-team-info">
                    <ui:Label name="HeaderTeamName"    class="header-team-name"    text="" />
                    <ui:Label name="HeaderManagerName" class="header-manager-name" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="PRESUPUESTO" />
                    <ui:Label name="HeaderBudget" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MASA SALARIAL" />
                    <ui:Label name="HeaderPayroll" class="header-stat-value header-stat-value--neutral" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MARGEN SALARIAL" />
                    <ui:Label name="HeaderMargin" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="QUÍMICA DE EQUIPO" />
                    <ui:Label name="HeaderChemistry" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-spacer" />
                <ui:VisualElement class="header-season-info">
                    <ui:Label name="HeaderSeason" class="header-season-label" text="" />
                    <ui:Label name="HeaderDate"   class="header-date-label"   text="" />
                </ui:VisualElement>
                <ui:Button name="BtnAction" class="btn-action" text="DASHBOARD" />
                <ui:VisualElement name="ConfigIcon" class="header-config-icon" />
            </ui:VisualElement>

            <!-- TITLE BOX -->
            <ui:VisualElement class="historial-title-box">
                <ui:Label class="historial-title-box-label" text="HISTORIAL DE TRANSFERENCIAS" />
            </ui:VisualElement>

            <!-- HISTORIAL CONTENT -->
            <ui:VisualElement class="historial-content">
                <ui:VisualElement class="historial-table">
                    <ui:VisualElement class="historial-table-header">
                        <ui:Label class="historial-table-header-label historial-col historial-col-first" text="FECHA" />
                        <ui:Label class="historial-table-header-label historial-col historial-col-player" text="JUGADOR" />
                        <ui:Label class="historial-table-header-label historial-col-logo" text="" />
                        <ui:Label class="historial-table-header-label historial-col" text="ORIGEN" />
                        <ui:Label class="historial-table-header-label historial-col-logo" text="" />
                        <ui:Label class="historial-table-header-label historial-col" text="DESTINO" />
                        <ui:Label class="historial-table-header-label historial-col historial-col-center historial-col-bold" text="POS" />
                        <ui:Label class="historial-table-header-label historial-col historial-col-center historial-col-bold" text="OVR" />
                    </ui:VisualElement>
                    <ui:ScrollView class="historial-table-body-scroll"
                                   horizontal-scrolling-enabled="false"
                                   mode="Vertical">
                        <ui:VisualElement name="HistorialBody" class="historial-table-body" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
