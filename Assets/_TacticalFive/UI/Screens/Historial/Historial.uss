/* ══════════════════════════════════════════
   HISTORIAL — Historial.uss
   ══════════════════════════════════════════ */

.historial-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ══ SCREEN HEADER ══ */
.screen-header.panel--gold {
    flex-shrink: 0;
    padding: 0;
    margin: 16px 20px 12px 20px;
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    background-color: rgba(120, 95, 30, 0.15);
    border-radius: 4px;
    overflow: hidden;
}
.screen-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    background-color: rgba(120, 95, 30, 0.15);
}
.screen-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    white-space: normal;
}

.historial-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.historial-content {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    padding: 16px 28px 24px 28px;
    gap: 12px;
}

.historial-section-title {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 14px 20px;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    flex-shrink: 0;
}

.historial-section-title-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1.5px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
}

/* ── TABLE ── */
.historial-table {
    flex-direction: column;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    overflow: hidden;
    flex-grow: 1;
    min-height: 0;
}

.historial-table-header {
    flex-direction: row;
    align-items: center;
    padding: 10px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    background-color: rgba(18, 103, 195, 0.04);
    flex-shrink: 0;
}

.historial-table-header-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

.historial-table-body {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}

/* ══ PAGINATOR ══ */
.historial-paginator {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: auto;
    padding: 8px 0 4px 0;
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
}
.historial-paginator-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.10);
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    border-radius: 4px;
    padding: 4px 10px;
    margin: 0 4px;
    -unity-text-align: middle-center;
    cursor: pointer;
}
.historial-paginator-btn:hover {
    background-color: rgba(212, 160, 23, 0.25);
}
.historial-paginator-btn:disabled {
    color: rgb(58, 74, 99);
    border-color: rgb(42, 51, 71);
    background-color: transparent;
    cursor: default;
}
.historial-paginator-info {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 13px;
    color: rgb(122, 138, 170);
    margin: 0 8px;
    -unity-text-align: middle-center;
    min-width: 50px;
}

.historial-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 0;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 51, 71, 0.3);
}

.historial-row:hover {
    background-color: rgba(255, 255, 255, 0.02);
}

.historial-col {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    padding: 0 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
    min-width: 0;
}

.historial-col-center {
    -unity-text-align: middle-center;
}

.historial-col-bold {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.historial-col-player {
    -unity-text-transform: upper;
}

.historial-col-logo {
    flex: 0 0 36px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
    padding: 0 4px;
}

.historial-col-ovr {
    color: rgb(212, 160, 23);
}

.historial-col-first {
    padding-left: 20px;
}

/* ── EMPTY ── */
.historial-empty {
    padding: 60px 20px;
    align-items: center;
}

.historial-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}
