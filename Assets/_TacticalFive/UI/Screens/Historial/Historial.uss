/* ══════════════════════════════════════════
   HISTORIAL — Historial.uss
   ══════════════════════════════════════════ */

.historial-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ══ SCREEN HEADER ══ */
.screen-header.panel--gold {
    flex-shrink: 0;
    padding: 0;
    margin: 16px 20px 12px 20px;
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    background-color: rgb(33, 32, 28);
    border-radius: 4px;
    overflow: hidden;
}
.screen-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    background-color: rgb(33, 32, 28);
}
.screen-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    white-space: normal;
}

.historial-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.historial-content {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    padding: 16px 28px 24px 28px;
    gap: 12px;
}

.historial-section-title {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 14px 20px;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    flex-shrink: 0;
}

.historial-section-title-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1.5px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
}

/* ── TABLE ── */
.historial-table {
    flex-direction: column;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    overflow: hidden;
    flex-grow: 1;
    min-height: 0;
}

.historial-table-header {
    flex-direction: row;
    align-items: center;
    padding: 4px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    background-color: rgb(18, 24, 35);
    flex-shrink: 0;
    margin-right: 16px;
}

.historial-table-header-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

.historial-table-body {
    flex-direction: column;
    flex-shrink: 0;
}

/* ══ SCROLLBAR (gold) ══ */

.historial-scroll-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.historial-viewport {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    position: relative;
}

.historial-scrollbar {
    width: 12px;
    min-width: 12px;
    flex-shrink: 0;
    align-self: stretch;
    margin-left: 4px;
    background-color: rgb(24, 18, 10);
    border-left-width: 1px;
    border-left-color: rgb(54, 47, 29);
    position: relative;
}

.historial-scrollbar-thumb {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 0;
    height: 40px;
    background-color: rgb(160, 128, 30);
    border-radius: 3px;
}
.historial-scrollbar:hover .historial-scrollbar-thumb {
    background-color: rgb(212, 160, 23);
}

.historial-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 0;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(25, 30, 41);
}

.historial-row:hover {
    background-color: rgb(23, 26, 33);
}

.historial-col {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    padding: 0 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
    min-width: 0;
}

.historial-col-center {
    -unity-text-align: middle-center;
}

.historial-col-bold {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.historial-col-player {
    -unity-text-transform: upper;
}

.historial-col-logo {
    flex: 0 0 36px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
    padding: 0 4px;
}

.historial-col-ovr {
    color: rgb(212, 160, 23);
}

.historial-col-wide {
    flex-grow: 2.2;
}

.historial-col-narrow {
    flex-grow: 0.5;
    min-width: 0;
}

.historial-col-sal {
    flex-grow: 1.3;
    min-width: 150px;
}

.historial-col-first {
    padding-left: 20px;
}

/* ── EMPTY ── */
.historial-empty {
    padding: 60px 20px;
    align-items: center;
}

.historial-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

/* ── FILTROS Y ORDEN ── */
.historial-filter-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 4px;
}
.historial-filter-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    letter-spacing: 1px;
    padding: 6px 14px;
    margin-right: 6px;
    background-color: rgb(20, 27, 42);
    border-width: 1px;
    border-color: rgb(60, 70, 92);
    color: rgb(179, 190, 214);
    border-radius: 6px;
    cursor: pointer;
}
.historial-filter-btn:hover {
    background-color: rgb(23, 36, 63);
    color: rgb(220, 230, 245);
}
.historial-filter-btn--active {
    border-color: rgb(212, 160, 23);
    background-color: rgb(41, 38, 27);
    color: rgb(248, 196, 64);
}
.historial-filter-spacer {
    flex-grow: 1;
}
