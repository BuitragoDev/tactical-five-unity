/* ══════════════════════════════════════════
   ROSTER — Roster.uss
   ══════════════════════════════════════════ */

/* ── ROOT ── */
.roster-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ── MAIN AREA ── */
.roster-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

/* ── SUMMARY BAR ── */
.summary-bar {
    flex-direction: row;
    flex-shrink: 0;
    margin: 16px 20px 12px;
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    background-color: rgb(22, 26, 36);
}
.summary-item {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 8px;
    border-right-width: 1px;
    border-right-color: rgb(42, 51, 71);
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}
.summary-item-last {
    border-right-width: 0;
}
.summary-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 28px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}
.summary-value--gold {
    color: rgb(212, 160, 23);
}
.summary-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
    margin-top: 2px;
}

/* ── CONTENT AREA ── */
.roster-content {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    margin: 0 20px 16px;
}

/* ── LEFT: lista de jugadores ── */
.roster-list {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    margin-right: 16px;
}
.roster-scroll {
    flex-grow: 1;
    min-height: 0;
}

/* Sección por posición */
.pos-section {
    flex-direction: column;
    margin-bottom: 8px;
}
.pos-header {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    background-color: rgb(17, 24, 34);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
    border-top-width: 0;
    border-bottom-width: 0;
    border-right-width: 0;
    margin-bottom: 2px;
}
.player-row-role-icon {
    width: 24px;
    height: 24px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    margin-left: 8px;
    margin-right: 8px;
    flex-shrink: 0;
}

.pos-badge {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    background-color: rgb(42, 95, 201);
    padding: 2px 8px;
    margin-right: 10px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.pos-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgb(122, 138, 170);
}

/* Fila de jugador */
.player-row {
    flex-direction: row;
    align-items: center;
    padding: 2px 12px;
    background-color: rgb(22, 26, 36);
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}
.player-row:hover {
    background-color: rgb(28, 33, 48);
}
.player-row--selected {
    background-color: rgb(20, 28, 48);
    border-left-width: 3px;
    border-left-color: rgb(212, 160, 23);
}
.player-row--injured {
    background-color: rgb(30, 20, 20);
}

.player-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
    -unity-text-align: middle-left;
    text-transform: uppercase;
}
.player-name--injured {
    color: rgb(192, 57, 43);
}
.player-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(85, 102, 119);
    width: 100px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.player-ovr {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(255, 255, 255);
    width: 40px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.player-ovr--high {
    color: rgb(39, 174, 96);
}
.player-ovr--mid {
    color: rgb(212, 160, 23);
}
.player-ovr--low {
    color: rgb(192, 57, 43);
}
.player-meta {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(85, 102, 119);
    width: 140px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.player-contract {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    width: 90px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.player-contract--expiring {
    color: rgb(212, 160, 23);
}
.player-salary {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    width: 130px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.player-icon {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    width: 28px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.player-injury-icon {
    width: 24px;
    height: 24px;
    margin-left: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* ── RIGHT: detalle jugador ── */
.player-detail {
    width: 580px;
    flex-shrink: 0;
    flex-direction: column;
    background-color: rgb(17, 24, 34);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    min-height: 0;
}

.detail-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}
.detail-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(58, 74, 99);
    -unity-text-align: middle-center;
}

.detail-scroll {
    flex-grow: 1;
    min-height: 0;
}

/* Cabecera detalle */
.detail-top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    flex-shrink: 0;
}
.detail-photo {
    width: 72px;
    height: 72px;
    border-radius: 36px;
    background-color: rgb(200, 200, 200);
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
    margin-right: 12px;
}
.detail-name-block {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}
.detail-player-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(255, 255, 255);
    text-transform: uppercase;
    letter-spacing: 1px;
    white-space: normal;
}
.detail-player-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    margin-top: 2px;
}
.detail-player-meta {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    margin-top: 2px;
}
.detail-link-trajectory {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(42, 95, 201);
    margin-top: 4px;
    cursor: pointer;
    -unity-text-align: middle-left;
}
.detail-link-trajectory:hover {
    color: rgb(82, 135, 241);
}
.detail-ovr-block {
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    margin-left: 12px;
}
.detail-ovr-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 36px;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-center;
}
.detail-ovr--high {
    color: rgb(39, 174, 96);
}
.detail-ovr--mid {
    color: rgb(212, 160, 23);
}
.detail-ovr--low {
    color: rgb(192, 57, 43);
}
.detail-ovr-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
}

/* Estado salud */
.detail-health {
    flex-direction: row;
    align-items: center;
    padding: 8px 16px;
    flex-shrink: 0;
}
.detail-health-ok {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(39, 174, 96);
}
.detail-health-injured {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(192, 57, 43);
}

/* Atributos */
.detail-attrs {
    flex-direction: column;
    padding: 2px 16px;
    flex-shrink: 0;
}
.attr-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}
.attr-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    width: 90px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}
.attr-bar-bg {
    flex-grow: 1;
    height: 8px;
    background-color: rgb(28, 33, 48);
    border-radius: 4px;
    overflow: hidden;
    margin: 0 8px;
}
.attr-bar-fill {
    height: 8px;
    border-radius: 4px;
    background-color: rgb(39, 174, 96);
}
.attr-bar-fill--mid {
    background-color: rgb(212, 160, 23);
}
.attr-bar-fill--low {
    background-color: rgb(192, 57, 43);
}
.attr-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    width: 32px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

.morale-dot {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin-left: 10px;
    margin-right: 4px;
    flex-shrink: 0;
}

.fisico-dot {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin-right: 16px;
    flex-shrink: 0;
}

/* Stats temporada */
.detail-season-stats {
    flex-direction: row;
    justify-content: space-around;
    padding: 0 16px;
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    flex-shrink: 0;
}
.season-stat-card {
    flex-direction: column;
    align-items: center;
}
.season-stat-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-center;
}
.season-stat-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
}

/* Footer contrato / potencial */
.detail-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 6px 16px;
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    flex-shrink: 0;
}
.detail-contract-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(85, 102, 119);
}
.detail-contract-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    margin-top: 2px;
}
.detail-potential-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-right;
}
.detail-potential-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 26px;
    color: rgb(74, 128, 240);
    -unity-text-align: middle-right;
}

/* Rol */
.detail-role-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
}
.detail-role-icon {
    width: 32px;
    height: 32px;
    margin-top: 4px;
    cursor: pointer;
}
.detail-role-icon:hover {
    opacity: 0.8;
}
.detail-role-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    text-transform: uppercase;
    color: rgb(255, 255, 255);
    margin-left: 8px;
    -unity-text-align: middle-left;
}

/* Botón despedir */
/* Fila de 3 botones: despedir | rescindir | renovar */
.detail-button-row {
    flex-direction: row;
    margin: 12px 16px 0 16px;
}

.btn-dismiss {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    flex-grow: 1;
    padding: 18px 4px;
    background-color: rgb(192, 57, 43);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 1px;
    text-transform: uppercase;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-shrink: 0;
}
.btn-dismiss:hover {
    background-color: rgb(220, 80, 60);
}

/* Botón rescisión (buyout) */
.btn-buyout {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    flex-grow: 1;
    margin: 0 4px;
    padding: 18px 4px;
    background-color: rgb(200, 130, 30);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 1px;
    text-transform: uppercase;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-shrink: 0;
}
.btn-buyout:hover {
    background-color: rgb(220, 150, 40);
}

/* Botón renovar contrato */
.btn-renew {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    flex-grow: 1;
    padding: 18px 4px;
    background-color: rgb(41, 128, 185);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 1px;
    text-transform: uppercase;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-shrink: 0;
}
.btn-renew:hover {
    background-color: rgb(52, 152, 219);
}

/* Formulario de renovación */
.renew-form {
    margin: 0 16px 12px 16px;
    padding: 12px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    flex-direction: column;
    display: none;
}
.renew-form-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}
.renew-form-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 80px;
    font-size: 14px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    -unity-text-align: middle-left;
}
.renew-form-dropdown {
    flex-grow: 1;
    font-size: 14px;
    color: rgb(208, 216, 232);
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
}
.btn-submit-offer {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    margin-top: 8px;
    padding: 10px;
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.btn-submit-offer:hover {
    background-color: rgb(60, 120, 230);
}

/* Modales renovación */
.renew-modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0.95;
    align-items: center;
    justify-content: center;
    display: none;
}
.renew-modal-overlay--visible {
    display: flex;
}
.renew-modal-box {
    position: absolute;
    width: 520px;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-top-width: 3px;
    border-top-color: rgb(39, 174, 96);
    padding: 32px;
    flex-direction: column;
    align-items: center;
}
.renew-modal-box--positive {
    border-top-color: rgb(39, 174, 96);
}
.renew-modal-box--negative {
    border-top-color: rgb(192, 57, 43);
}
.renew-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}
.renew-modal-title--positive {
    color: rgb(39, 174, 96);
}
.renew-modal-title--negative {
    color: rgb(192, 57, 43);
}
.renew-modal-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-to-fit;
}
.renew-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    margin-bottom: 18px;
    -unity-text-align: middle-center;
}
.renew-modal-buttons {
    flex-direction: row;
    margin-top: 24px;
    gap: 12px;
}

.renew-form-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 12px;
}
.renew-form-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    width: 120px;
    flex-shrink: 0;
}
.renew-form-field {
    flex-grow: 1;
    height: 36px;
    font-size: 18px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(208, 216, 232);
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    padding: 4px 8px;
    -unity-text-align: middle-left;
}
.renew-modal-text--pending {
    color: rgb(212, 160, 23);
    font-size: 20px;
    margin-top: 8px;
}
.renew-modal-text--warning {
    color: rgb(212, 160, 23);
    font-size: 18px;
    margin-top: 4px;
    -unity-text-align: middle-center;
}
.renew-modal-text--info {
    color: rgb(122, 138, 170);
    font-size: 18px;
    margin-top: 6px;
    -unity-text-align: middle-center;
}

/* Modal confirmar despido */
.dismiss-modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0.95;
    align-items: center;
    justify-content: center;
    display: none;
}
.dismiss-modal-overlay--visible {
    display: flex;
}
.dismiss-modal-box {
    position: absolute;
    width: 600px;
    background-color: rgb(30, 37, 53);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-top-width: 3px;
    border-top-color: rgb(192, 57, 43);
    padding: 32px 36px;
    flex-direction: column;
    display: none;
}
.dismiss-modal-box--visible {
    display: flex;
}
.dismiss-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgb(255, 255, 255);
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}
.dismiss-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    white-space: normal;
    margin-bottom: 8px;
}
.dismiss-modal-text--warning {
    color: rgb(212, 160, 23);
}
.dismiss-modal-penalty {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(192, 57, 43);
}
.dismiss-modal-buttons {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 24px;
}
.btn-modal-cancel {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(30, 37, 53);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    color: rgb(122, 138, 170);
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 10px 24px;
    margin-right: 10px;
    -unity-text-align: middle-center;
}
.btn-modal-cancel:hover {
    border-color: rgb(122, 138, 170);
    color: rgb(208, 216, 232);
}
.btn-modal-confirm {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(23, 110, 59);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 10px 24px;
    -unity-text-align: middle-center;
}
.btn-modal-confirm:hover {
    background-color: rgb(39, 174, 96);
}

/* ── Spinner (increment/decrement buttons + label) ── */
.renew-spinner-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    margin-left: 8px;
}

.renew-spin-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    flex-grow: 1;
    padding: 0 4px;
}

.btn-spin {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    width: 36px;
    height: 36px;
    background-color: rgb(42, 51, 71);
    flex-shrink: 0;
    border-width: 0;
    padding: 0;
}

.btn-spin:hover {
    background-color: rgb(58, 74, 99);
}

.btn-spin--disabled {
    background-color: rgb(30, 34, 46);
    color: rgb(80, 90, 110);
}