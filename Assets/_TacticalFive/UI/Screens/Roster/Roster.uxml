<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Roster.uss" />
    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />

    <ui:VisualElement name="RosterRoot" class="roster-root">

        <!-- ══ SIDEBAR (reutilizamos del dashboard) ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="roster-main">

            <!-- TOP HEADER (reutilizamos clases del dashboard) -->
            <!-- SCREEN HEADER -->
            <ui:VisualElement class="roster-screen-header panel--gold">
                <ui:VisualElement class="roster-screen-header-row">
                    <ui:VisualElement name="RosterScreenIcon" class="roster-screen-icon" />
                    <ui:Label text="{loc:ui.roster.jugadores_de_la_plantilla}" class="roster-screen-title" />
                </ui:VisualElement>
                <ui:Label name="RosterSubtitle" text="" class="roster-screen-subtitle" />
            </ui:VisualElement>

            <!-- CONTENT -->
            <ui:VisualElement class="roster-content">

                <!-- LEFT: lista -->
                <ui:VisualElement class="roster-list">
                    <ui:ScrollView name="RosterScroll" class="roster-scroll"
                                   horizontal-scrolling-enabled="false"
                                   mode="Vertical">
                        <ui:VisualElement name="RosterBody" />
                    </ui:ScrollView>
                </ui:VisualElement>

                <!-- RIGHT: stats panel + detail -->
                <ui:VisualElement class="roster-right-col">

                    <!-- Panel de estadísticas del equipo (2×2) -->
                    <ui:VisualElement class="roster-stats-panel panel--gold">
                        <ui:VisualElement class="panel-header">
                            <ui:Label name="RosterTeamName" class="panel-title" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement class="roster-stats-grid">
                            <ui:VisualElement class="roster-stat-item">
                                <ui:Label name="SummaryPlayers" class="roster-stat-value" text="0" />
                                <ui:Label class="roster-stat-label" text="{loc:ui.roster.jugadores}" />
                            </ui:VisualElement>
                            <ui:VisualElement class="roster-stat-item">
                                <ui:Label name="SummaryOverall" class="roster-stat-value roster-stat-value--gold" text="0" />
                                <ui:Label class="roster-stat-label" text="{loc:ui.roster.media}" />
                            </ui:VisualElement>
                            <ui:VisualElement class="roster-stat-item">
                                <ui:Label name="SummaryBudget" class="roster-stat-value roster-stat-value--gold" text="" />
                                <ui:Label class="roster-stat-label" text="{loc:ui.roster.masa_salarial}" />
                            </ui:VisualElement>
                            <ui:VisualElement class="roster-stat-item">
                                <ui:Label name="SummaryTwoWay" class="roster-stat-value" text="{loc:ui.roster.summary_two_way}" />
                                <ui:Label class="roster-stat-label" text="{loc:ui.roster.contratos_two_way}" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Panel detalle jugador -->
                    <ui:VisualElement name="PlayerDetail" class="player-detail">

                        <!-- Placeholder -->
                        <ui:VisualElement name="DetailEmpty" class="detail-empty">
                            <ui:Label class="detail-empty-text"
                                      text="{loc:ui.roster.selecciona_un_jugador}" />
                        </ui:VisualElement>

                        <!-- Panel detalle (oculto hasta selección) -->
                        <ui:ScrollView name="DetailScroll" class="detail-scroll"
                                       horizontal-scrolling-enabled="false"
                                       mode="Vertical">
                            <ui:VisualElement name="DetailContent">

                                <!-- Cabecera -->
                                <ui:VisualElement class="detail-top">
                                    <ui:VisualElement name="DetailPhoto" class="detail-photo" />
                                    <ui:VisualElement class="detail-name-block">
                                        <ui:Label name="DetailPlayerName" class="detail-player-name" text="" />
                                        <ui:Label name="DetailPlayerPos"  class="detail-player-pos"  text="" />
                                        <ui:Label name="DetailPlayerMeta" class="detail-player-meta" text="" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="detail-ovr-block">
                                        <ui:Label name="DetailOvr"      class="detail-ovr-val"   text="" />
                                        <ui:Label class="detail-ovr-label" text="{loc:ui.roster.med}" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <!-- Botones link -->
                                <ui:VisualElement class="detail-links-row">
                                    <ui:Button name="DetailLinkTrajectory" class="detail-link-btn" text="{loc:ui.roster.detail_link_trajectory}" />
                                    <ui:Button name="DetailLinkProfile" class="detail-link-btn" text="{loc:ui.roster.detail_link_profile}" />
                                </ui:VisualElement>

                                <!-- Salud -->
                                <ui:VisualElement class="detail-health">
                                    <ui:Label name="DetailHealth" class="detail-health-ok" text="{loc:ui.roster.detail_health}" />
                                </ui:VisualElement>

                                <!-- Atributos -->
                                <ui:VisualElement name="DetailAttrs" class="detail-attrs" />

                                <!-- Stats temporada -->
                                <ui:VisualElement name="DetailSeasonStats" class="detail-season-stats">
                                    <ui:VisualElement class="season-stat-card">
                                        <ui:Label name="StatPts"   class="season-stat-val"   text="0.0" />
                                        <ui:Label class="season-stat-label" text="{loc:ui.roster.pts}" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="season-stat-card">
                                        <ui:Label name="StatReb"   class="season-stat-val"   text="0.0" />
                                        <ui:Label class="season-stat-label" text="{loc:ui.roster.reb}" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="season-stat-card">
                                        <ui:Label name="StatAst"   class="season-stat-val"   text="0.0" />
                                        <ui:Label class="season-stat-label" text="{loc:ui.roster.ast}" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="season-stat-card">
                                        <ui:Label name="StatStl"   class="season-stat-val"   text="0.0" />
                                        <ui:Label class="season-stat-label" text="{loc:ui.roster.rob}" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="season-stat-card">
                                        <ui:Label name="StatBlk"   class="season-stat-val"   text="0.0" />
                                        <ui:Label class="season-stat-label" text="{loc:ui.roster.tap}" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <!-- Stats G-League -->
                                <ui:VisualElement name="GLeagueStats" class="detail-gleague" style="display: none;">
                                    <ui:Label class="detail-gleague-label" text="{loc:ui.roster.g_league}" />
                                    <ui:Label name="GLeagueStatsText" class="detail-gleague-text" text="" />
                                </ui:VisualElement>

                                <!-- Footer contrato / rol / potencial -->
                                <ui:VisualElement class="detail-footer">
                                    <ui:VisualElement class="flex-col">
                                        <ui:Label class="detail-contract-label" text="{loc:ui.roster.contrato}" />
                                        <ui:Label name="DetailContract" class="detail-contract-value" text="" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="flex-col" style="align-items: center;">
                                        <ui:Label class="detail-role-label" text="{loc:ui.roster.rol}" />
                                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                                            <ui:VisualElement name="DetailRoleIcon" class="detail-role-icon" />
                                            <ui:Label name="DetailRoleName" class="detail-role-name" text="" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="flex-col" style="align-items: flex-end;">
                                        <ui:Label class="detail-potential-label" text="{loc:ui.roster.potencial}" />
                                        <ui:Label name="DetailPotential" class="detail-potential-value" text="" />
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <!-- Botones de acción -->
                                <ui:VisualElement class="detail-button-row">
                                    <ui:Button name="BtnBuyout" class="btn-buyout"
                                               text="{loc:ui.roster.btn_buyout}" />
                                    <ui:Button name="BtnRenew" class="btn-renew"
                                               text="{loc:ui.roster.btn_renew}" />
                                </ui:VisualElement>

                            </ui:VisualElement>
                        </ui:ScrollView>

                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ══ MODAL RENOVAR CONTRATO ══ -->
        <ui:VisualElement name="RenewOverlay" class="renew-modal-overlay">
            <ui:VisualElement name="RenewBox" class="renew-modal-box">
                <ui:VisualElement class="renew-modal-header">
                    <ui:VisualElement class="renew-modal-heading">
                        <ui:VisualElement name="RenewIcon" class="renew-modal-icon"/>
                        <ui:VisualElement>
                            <ui:Label name="RenewTitle" class="renew-modal-title" text="{loc:ui.roster.renew_title}" />
                            <ui:Label name="RenewText1" class="renew-modal-subtitle" text="" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="renew-modal-body">
                    <ui:VisualElement name="RenewFormRowSalary" class="renew-form-row">
                        <ui:Label class="renew-form-label" text="{loc:ui.roster.salario}" />
                        <ui:VisualElement class="renew-spinner-row">
                            <ui:Label name="RenewSalaryDec" class="btn-spin" text="&#9664;" />
                            <ui:Label name="RenewSalaryValue" class="renew-spin-label" text="" />
                            <ui:Label name="RenewSalaryInc" class="btn-spin" text="&#9654;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="RenewFormRowYears" class="renew-form-row">
                        <ui:Label class="renew-form-label" text="{loc:ui.roster.duracion_anos}" />
                        <ui:VisualElement class="renew-spinner-row">
                            <ui:Label name="RenewYearsDec" class="btn-spin" text="&#9664;" />
                            <ui:Label name="RenewYearsValue" class="renew-spin-label" text="" />
                            <ui:Label name="RenewYearsInc" class="btn-spin" text="&#9654;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="RenewFormRowOptions" class="renew-form-row renew-options-row">
                        <ui:Label class="renew-form-label" text="{loc:ui.roster.opciones}" />
                        <ui:VisualElement class="renew-options-toggles">
                            <ui:Button name="RenewTeamOption" class="renew-toggle-btn" text="{loc:ui.roster.renew_team_option}" />
                            <ui:Button name="RenewPlayerOption" class="renew-toggle-btn" text="{loc:ui.roster.renew_player_option}" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="RenewFormRowTwoWay" class="renew-form-row renew-options-row" style="display: none;">
                        <ui:Label class="renew-form-label" text="{loc:ui.roster.contrato}" />
                        <ui:VisualElement class="renew-options-toggles">
                            <ui:Button name="RenewTwoWayToggle" class="renew-toggle-btn" text="{loc:ui.roster.renew_two_way_toggle}" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="RenewText2" class="renew-modal-text" text="" />
                    <ui:Label name="RenewWarningText" class="renew-modal-text renew-modal-text--warning" style="display: none;" text="" />
                    <ui:Label name="RenewMaxInfo" class="renew-modal-text renew-modal-text--info" style="display: none;" text="" />
                    <ui:Label name="RenewPendingText" class="renew-modal-text renew-modal-text--pending" style="display: none;" text="{loc:ui.roster.renew_pending_text}" />
                    <ui:VisualElement class="renew-modal-actions">
                        <ui:Button name="BtnRenewCancel" class="btn-modal-cancel" text="{loc:ui.roster.btn_renew_cancel}" />
                        <ui:Button name="BtnRenewConfirm" class="btn-modal-confirm" text="{loc:ui.roster.btn_renew_confirm}" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL COOLDOWN RENOVACIÓN ══ -->
        <ui:VisualElement name="RenewCooldownOverlay" class="renew-modal-overlay">
            <ui:VisualElement name="RenewCooldownBox" class="renew-modal-box renew-modal-box--negative" style="width: 650px;">
                <ui:VisualElement class="renew-modal-header" style="background-color: rgb(53, 28, 31); border-bottom-color: rgb(192, 57, 43);">
                    <ui:VisualElement class="renew-modal-heading">
                        <ui:VisualElement name="RenewCooldownIcon" class="renew-modal-icon"/>
                        <ui:VisualElement>
                            <ui:Label name="RenewCooldownTitle" class="renew-modal-title" text="{loc:ui.roster.renew_cooldown_title}" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="renew-modal-body">
                    <ui:Label name="RenewCooldownText" class="renew-modal-text" text="" />
                    <ui:VisualElement class="renew-modal-actions">
                        <ui:Button name="BtnRenewCooldownOk" class="btn-modal-cancel" text="{loc:ui.roster.btn_renew_cooldown_ok}" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL NO SE PUEDE RENOVAR ══ -->
        <ui:VisualElement name="RenewBlockOverlay" class="renew-modal-overlay">
            <ui:VisualElement name="RenewBlockBox" class="renew-modal-box renew-modal-box--negative" style="width: 650px;">
                <ui:VisualElement class="renew-modal-header" style="background-color: rgb(53, 28, 31); border-bottom-color: rgb(192, 57, 43);">
                    <ui:VisualElement class="renew-modal-heading">
                        <ui:VisualElement name="RenewBlockIcon" class="renew-modal-icon"/>
                        <ui:VisualElement>
                            <ui:Label name="RenewBlockTitle" class="renew-modal-title" text="{loc:ui.roster.renew_block_title}" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="renew-modal-body">
                    <ui:Label name="RenewBlockText" class="renew-modal-text" text="" />
                    <ui:VisualElement class="renew-modal-actions">
                        <ui:Button name="BtnRenewBlockOk" class="btn-modal-cancel" text="{loc:ui.roster.btn_renew_block_ok}" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL RESULTADO RENOVACIÓN ══ -->
        <ui:VisualElement name="RenewResultOverlay" class="renew-modal-overlay">
            <ui:VisualElement name="RenewResultBox" class="renew-modal-box" style="width: 650px;">
                <ui:VisualElement name="RenewResultIcon" class="renew-modal-icon"/>
                <ui:Label name="RenewResultTitle" class="renew-modal-title" text="" />
                <ui:Label name="RenewResultText1" class="renew-modal-text" text="" />
                <ui:Label name="RenewResultText2" class="renew-modal-text" text="" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL RESCISIÓN (BUYOUT) ══ -->
        <ui:VisualElement name="BuyoutOverlay" class="dismiss-modal-overlay">
          <ui:VisualElement name="BuyoutBox" class="dismiss-modal-box">
            <ui:VisualElement class="dismiss-modal-header">
              <ui:Label class="dismiss-modal-title" text="{loc:ui.roster.rescision_de_contrato}" />
            </ui:VisualElement>
            <ui:VisualElement class="dismiss-modal-body">
              <ui:Label name="BuyoutText1" class="dismiss-modal-text" text="" />
              <ui:Label name="BuyoutText2" class="dismiss-modal-text" text="" />
              <ui:Label name="BuyoutInfo" class="dismiss-modal-text dismiss-modal-text--warning"
                        text="{loc:ui.roster.buyout_info}" />
              <ui:VisualElement class="dismiss-modal-buttons">
                <ui:Button name="BtnBuyoutCancel" class="btn-modal-cancel" text="{loc:ui.roster.btn_buyout_cancel}" />
                <ui:Button name="BtnBuyoutStretch" class="btn-modal-confirm btn-modal-confirm--danger" text="{loc:ui.roster.btn_buyout_stretch}" />
              </ui:VisualElement>
            </ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIGURACIÓN ══ -->
        <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigModalBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.roster.configuracion}" />
                <ui:VisualElement class="modal-body">
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.roster.audio}" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.roster.volumen_general}" />
                            <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.roster.musica}" />
                            <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.roster.efectos}" />
                            <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.roster.graficos}" />
                        <ui:VisualElement class="settings-quality-row">
                            <ui:Label class="settings-label" text="{loc:ui.roster.calidad}" />
                            <ui:VisualElement class="settings-quality-options">
                                <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="{loc:ui.roster.config_btn_quality_low}" />
                                <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="{loc:ui.roster.config_btn_quality_medium}" />
                                <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="{loc:ui.roster.config_btn_quality_high}" />
                                <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="{loc:ui.roster.config_btn_quality_ultra}" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.roster.juego}" />
                        <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="{loc:ui.roster.config_btn_main_menu}" />
                        <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="{loc:ui.roster.config_btn_exit}" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ConfigBtnCerrar" class="modal-close" text="{loc:ui.roster.config_btn_cerrar}" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR VOLVER AL MENÚ PRINCIPAL ══ -->
        <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.roster.volver_al_menu_principal}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.roster.estas_seguro_de_que_quieres_volver_al_me_6f548452}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.roster.se_perdera_el_progreso_no_guardado_de_la_b10b7334}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="{loc:ui.roster.config_btn_main_menu_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="{loc:ui.roster.config_btn_main_menu_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR SALIR DEL JUEGO ══ -->
        <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.roster.salir_del_juego}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.roster.estas_seguro_de_que_quieres_salir_del_ju_c65dd5f1}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.roster.tu_progreso_se_guarda_automaticamente_du_10fb1edb}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="{loc:ui.roster.config_btn_exit_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="{loc:ui.roster.config_btn_exit_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
