<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Roster.uss" />
    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />

    <ui:VisualElement name="RosterRoot" class="roster-root">

        <!-- ══ SIDEBAR (reutilizamos del dashboard) ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="roster-main">

            <!-- TOP HEADER (reutilizamos clases del dashboard) -->
            <!-- SUMMARY BAR -->
            <ui:VisualElement class="summary-bar">
                <ui:VisualElement class="summary-item">
                    <ui:Label name="SummaryPlayers" class="summary-value" text="0" />
                    <ui:Label class="summary-label" text="JUGADORES" />
                </ui:VisualElement>
                <ui:VisualElement class="summary-item">
                    <ui:Label name="SummaryOverall" class="summary-value summary-value--gold" text="0" />
                    <ui:Label class="summary-label" text="MEDIA" />
                </ui:VisualElement>
                <ui:VisualElement class="summary-item summary-item-last">
                    <ui:Label name="SummaryBudget" class="summary-value summary-value--gold" text="" />
                    <ui:Label class="summary-label" text="MASA SALARIAL" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- CONTENT -->
            <ui:VisualElement class="roster-content">

                <!-- LEFT: lista -->
                <ui:VisualElement class="roster-list">
                    <ui:ScrollView name="RosterScroll" class="roster-scroll"
                                   horizontal-scrolling-enabled="false"
                                   mode="Vertical">
                        <ui:VisualElement name="RosterBody" />
                    </ui:ScrollView>
                </ui:VisualElement>

                <!-- RIGHT: detalle -->
                <ui:VisualElement name="PlayerDetail" class="player-detail">

                    <!-- Placeholder -->
                    <ui:VisualElement name="DetailEmpty" class="detail-empty">
                        <ui:Label class="detail-empty-text"
                                  text="SELECCIONA UN JUGADOR" />
                    </ui:VisualElement>

                    <!-- Panel detalle (oculto hasta selección) -->
                    <ui:ScrollView name="DetailScroll" class="detail-scroll"
                                   horizontal-scrolling-enabled="false"
                                   mode="Vertical">
                        <ui:VisualElement name="DetailContent">

                            <!-- Cabecera -->
                            <ui:VisualElement class="detail-top">
                                <ui:VisualElement name="DetailPhoto" class="detail-photo" />
                                <ui:VisualElement class="detail-name-block">
                                    <ui:Label name="DetailPlayerName" class="detail-player-name" text="" />
                                    <ui:Label name="DetailPlayerPos"  class="detail-player-pos"  text="" />
                                    <ui:Label name="DetailPlayerMeta" class="detail-player-meta" text="" />
                                    <ui:Label name="DetailLinkTrajectory" class="detail-link-trajectory" text="VER TRAYECTORIA" />
                                </ui:VisualElement>
                                <ui:VisualElement class="detail-ovr-block">
                                    <ui:Label name="DetailOvr"      class="detail-ovr-val"   text="" />
                                    <ui:Label class="detail-ovr-label" text="MED" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- Salud -->
                            <ui:VisualElement class="detail-health">
                                <ui:Label name="DetailHealth" class="detail-health-ok" text="✓ DISPONIBLE" />
                            </ui:VisualElement>

                            <!-- Atributos -->
                            <ui:VisualElement name="DetailAttrs" class="detail-attrs" />

                            <!-- Stats temporada -->
                            <ui:VisualElement name="DetailSeasonStats" class="detail-season-stats">
                                <ui:VisualElement class="season-stat-card">
                                    <ui:Label name="StatPts"   class="season-stat-val"   text="0.0" />
                                    <ui:Label class="season-stat-label" text="PTS" />
                                </ui:VisualElement>
                                <ui:VisualElement class="season-stat-card">
                                    <ui:Label name="StatReb"   class="season-stat-val"   text="0.0" />
                                    <ui:Label class="season-stat-label" text="REB" />
                                </ui:VisualElement>
                                <ui:VisualElement class="season-stat-card">
                                    <ui:Label name="StatAst"   class="season-stat-val"   text="0.0" />
                                    <ui:Label class="season-stat-label" text="AST" />
                                </ui:VisualElement>
                                <ui:VisualElement class="season-stat-card">
                                    <ui:Label name="StatStl"   class="season-stat-val"   text="0.0" />
                                    <ui:Label class="season-stat-label" text="ROB" />
                                </ui:VisualElement>
                                <ui:VisualElement class="season-stat-card">
                                    <ui:Label name="StatBlk"   class="season-stat-val"   text="0.0" />
                                    <ui:Label class="season-stat-label" text="TAP" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- Footer contrato / rol / potencial -->
                            <ui:VisualElement class="detail-footer">
                                <ui:VisualElement class="flex-col">
                                    <ui:Label class="detail-contract-label" text="CONTRATO" />
                                    <ui:Label name="DetailContract" class="detail-contract-value" text="" />
                                </ui:VisualElement>
                                <ui:VisualElement class="flex-col" style="align-items: center;">
                                    <ui:Label class="detail-role-label" text="ROL" />
                                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                                        <ui:VisualElement name="DetailRoleIcon" class="detail-role-icon" />
                                        <ui:Label name="DetailRoleName" class="detail-role-name" text="" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="flex-col" style="align-items: flex-end;">
                                    <ui:Label class="detail-potential-label" text="POTENCIAL" />
                                    <ui:Label name="DetailPotential" class="detail-potential-value" text="" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- Botones de acción en 3 columnas -->
                            <ui:VisualElement class="detail-button-row">
                                <ui:Button name="BtnDismiss" class="btn-dismiss"
                                           text="DESPEDIR JUGADOR" />
                                <ui:Button name="BtnBuyout" class="btn-buyout"
                                           text="RESCINDIR CONTRATO" />
                                <ui:Button name="BtnRenew" class="btn-renew"
                                           text="RENOVAR CONTRATO" />
                            </ui:VisualElement>

                        </ui:VisualElement>
                    </ui:ScrollView>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ══ MODAL RENOVAR CONTRATO ══ -->
        <ui:VisualElement name="RenewOverlay" class="renew-modal-overlay">
            <ui:VisualElement name="RenewBox" class="renew-modal-box">
                <ui:VisualElement name="RenewIcon" class="renew-modal-icon"/>
                <ui:Label name="RenewTitle" class="renew-modal-title" text="RENOVAR CONTRATO" />
                <ui:Label name="RenewText1" class="renew-modal-text" text="" />
                <ui:VisualElement name="RenewFormRowSalary" class="renew-form-row">
                    <ui:Label class="renew-form-label" text="SALARIO ($)" />
                    <ui:VisualElement class="renew-spinner-row">
                        <ui:Label name="RenewSalaryDec" class="btn-spin" text="◀" />
                        <ui:Label name="RenewSalaryValue" class="renew-spin-label" text="" />
                        <ui:Label name="RenewSalaryInc" class="btn-spin" text="▶" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="RenewFormRowYears" class="renew-form-row">
                    <ui:Label class="renew-form-label" text="DURACIÓN (años)" />
                    <ui:VisualElement class="renew-spinner-row">
                        <ui:Label name="RenewYearsDec" class="btn-spin" text="◀" />
                        <ui:Label name="RenewYearsValue" class="renew-spin-label" text="" />
                        <ui:Label name="RenewYearsInc" class="btn-spin" text="▶" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="RenewFormRowOptions" class="renew-form-row renew-options-row">
                    <ui:Label class="renew-form-label" text="OPCIONES" />
                    <ui:VisualElement class="renew-options-toggles">
                        <ui:Button name="RenewTeamOption" class="renew-toggle-btn" text="TO (Team Option)" />
                        <ui:Button name="RenewPlayerOption" class="renew-toggle-btn" text="PO (Player Option)" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="RenewText2" class="renew-modal-text" text="" />
                <ui:Label name="RenewWarningText" class="renew-modal-text renew-modal-text--warning" style="display: none;" text="" />
                <ui:Label name="RenewMaxInfo" class="renew-modal-text renew-modal-text--info" style="display: none;" text="" />
                <ui:Label name="RenewPendingText" class="renew-modal-text renew-modal-text--pending" style="display: none;" text="OFERTA ENVIADA. Recibirás la respuesta en tu Dashboard en 7 días." />
                <ui:VisualElement class="renew-modal-buttons">
                    <ui:Button name="BtnRenewCancel"  class="btn-modal-cancel"  text="CERRAR" />
                    <ui:Button name="BtnRenewConfirm" class="btn-modal-confirm" text="ENVIAR OFERTA" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL COOLDOWN RENOVACIÓN ══ -->
        <ui:VisualElement name="RenewCooldownOverlay" class="renew-modal-overlay">
            <ui:VisualElement name="RenewCooldownBox" class="renew-modal-box">
                <ui:VisualElement name="RenewCooldownIcon" class="renew-modal-icon"/>
                <ui:Label name="RenewCooldownTitle" class="renew-modal-title" text="RENOVACIÓN NO DISPONIBLE" />
                <ui:Label name="RenewCooldownText" class="renew-modal-text" text="" />
                <ui:VisualElement class="renew-modal-buttons">
                    <ui:Button name="BtnRenewCooldownOk" class="btn-modal-cancel" text="ENTENDIDO" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL NO SE PUEDE RENOVAR ══ -->
        <ui:VisualElement name="RenewBlockOverlay" class="renew-modal-overlay">
            <ui:VisualElement name="RenewBlockBox" class="renew-modal-box">
                <ui:VisualElement name="RenewBlockIcon" class="renew-modal-icon"/>
                <ui:Label name="RenewBlockTitle" class="renew-modal-title" text="RENOVACIÓN NO DISPONIBLE" />
                <ui:Label name="RenewBlockText" class="renew-modal-text" text="" />
                <ui:VisualElement class="renew-modal-buttons">
                    <ui:Button name="BtnRenewBlockOk" class="btn-modal-cancel" text="ENTENDIDO" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL RESULTADO RENOVACIÓN ══ -->
        <ui:VisualElement name="RenewResultOverlay" class="renew-modal-overlay">
            <ui:VisualElement name="RenewResultBox" class="renew-modal-box">
                <ui:VisualElement name="RenewResultIcon" class="renew-modal-icon"/>
                <ui:Label name="RenewResultTitle" class="renew-modal-title" text="" />
                <ui:Label name="RenewResultText1" class="renew-modal-text" text="" />
                <ui:Label name="RenewResultText2" class="renew-modal-text" text="" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR DESPIDO ══ -->
        <ui:VisualElement name="DismissOverlay" class="dismiss-modal-overlay">
            <ui:VisualElement name="DismissBox" class="dismiss-modal-box">
                <ui:Label class="dismiss-modal-title" text="DESPEDIR JUGADOR" />
                <ui:Label name="DismissText1" class="dismiss-modal-text" text="" />
                <ui:Label name="DismissText2" class="dismiss-modal-text" text="" />
                <ui:Label class="dismiss-modal-text dismiss-modal-text--warning"
                          text="El jugador quedará sin equipo como agente libre." />
                <ui:VisualElement class="dismiss-modal-buttons">
                    <ui:Button name="BtnDismissCancel"  class="btn-modal-cancel"  text="CANCELAR" />
                    <ui:Button name="BtnDismissConfirm" class="btn-modal-confirm" text="CONFIRMAR DESPIDO" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL RESCISIÓN (BUYOUT) ══ -->
        <ui:VisualElement name="BuyoutOverlay" class="dismiss-modal-overlay">
          <ui:VisualElement name="BuyoutBox" class="dismiss-modal-box">
            <ui:Label class="dismiss-modal-title" text="RESCISIÓN DE CONTRATO (BUYOUT)" />
            <ui:Label name="BuyoutText1" class="dismiss-modal-text" text="" />
            <ui:Label name="BuyoutText2" class="dismiss-modal-text" text="" />
            <ui:Label name="BuyoutInfo" class="dismiss-modal-text dismiss-modal-text--warning"
                      style="margin-top: 8px; font-size: 18px;"
                      text="El jugador quedará libre. El salario restante se reparte en pagos anuales progresivos durante el doble de años pendientes." />
            <ui:VisualElement class="dismiss-modal-buttons">
              <ui:Button name="BtnBuyoutCancel" class="btn-modal-cancel" text="CANCELAR" />
              <ui:Button name="BtnBuyoutStretch" class="btn-modal-confirm" text="CONFIRMAR RESCISIÓN" />
            </ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIGURACIÓN ══ -->
        <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigModalBox" class="modal-box">
                <ui:Label class="modal-title" text="CONFIGURACIÓN" />
                <ui:VisualElement class="modal-body">
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="AUDIO" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="Volumen General" />
                            <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="Música" />
                            <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="Efectos" />
                            <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="GRÁFICOS" />
                        <ui:VisualElement class="settings-quality-row">
                            <ui:Label class="settings-label" text="Calidad" />
                            <ui:VisualElement class="settings-quality-options">
                                <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="Baja" />
                                <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="Media" />
                                <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="Alta" />
                                <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="Ultra" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="JUEGO" />
                        <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="VOLVER AL MENÚ PRINCIPAL" />
                        <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="SALIR DEL JUEGO" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ConfigBtnCerrar" class="modal-close" text="CERRAR" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR VOLVER AL MENÚ PRINCIPAL ══ -->
        <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="VOLVER AL MENÚ PRINCIPAL" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="¿Estás seguro de que quieres volver al menú principal?" />
                    <ui:Label class="modal-paragraph" text="Se perderá el progreso no guardado de la partida actual. Asegúrate de haber guardado antes de continuar." />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="NO, QUEDARME" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="SÍ, VOLVER" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR SALIR DEL JUEGO ══ -->
        <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="SALIR DEL JUEGO" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="¿Estás seguro de que quieres salir del juego?" />
                    <ui:Label class="modal-paragraph" text="Se cerrará la aplicación. Asegúrate de haber guardado tu progreso si lo deseas." />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="NO" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="SÍ, SALIR" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>