<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Roster.uss" />
    <Style src="../Dashboard/Dashboard.uss" />

    <ui:VisualElement name="RosterRoot" class="roster-root">

        <!-- ══ SIDEBAR (reutilizamos del dashboard) ══ -->
        <ui:VisualElement name="Sidebar" class="sidebar">
            <ui:VisualElement class="sidebar-logo">
                <ui:Label class="sidebar-logo-icon" text="TF" />
                <ui:Label class="sidebar-logo-text" text="TACTICAL" />
                <ui:Label class="sidebar-logo-text-gold" text="FIVE" />
            </ui:VisualElement>
            <ui:VisualElement class="sidebar-nav">
                <ui:Button name="NavDashboard" class="nav-item">
                    <ui:VisualElement name="NavDashboardIcon" class="nav-icon"/>
                    <ui:Label text="Inicio" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavRoster" class="nav-item nav-item--active">
                    <ui:VisualElement name="NavRosterIcon" class="nav-icon"/>
                    <ui:Label text="Plantilla" class="nav-label"/>
                </ui:Button>
                <ui:VisualElement name="RosterSubmenu" class="nav-submenu">
                    <ui:Button name="SubmenuJugadores" class="nav-submenu-item nav-submenu-item--active">
                        <ui:Label text="Jugadores" class="nav-submenu-label"/>
                    </ui:Button>
                    <ui:Button name="SubmenuEmpleados" class="nav-submenu-item">
                        <ui:Label text="Empleados" class="nav-submenu-label"/>
                    </ui:Button>
                    <ui:Button name="SubmenuLesionados" class="nav-submenu-item">
                        <ui:Label text="Lesionados" class="nav-submenu-label"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:Button name="NavCalendar" class="nav-item">
                    <ui:VisualElement name="NavCalendarIcon" class="nav-icon"/>
                    <ui:Label text="Calendario" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavStandings" class="nav-item">
                    <ui:VisualElement name="NavStandingsIcon" class="nav-icon"/>
                    <ui:Label text="Clasificación" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavPalmares" class="nav-item">
                    <ui:VisualElement name="NavPalmaresIcon" class="nav-icon"/>
                    <ui:Label text="Palmarés" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavResults" class="nav-item">
                    <ui:VisualElement name="NavResultsIcon" class="nav-icon"/>
                    <ui:Label text="Resultados" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavPlayoffs" class="nav-item">
                    <ui:VisualElement name="NavPlayoffsIcon" class="nav-icon"/>
                    <ui:Label text="Playoffs" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavStats" class="nav-item">
                    <ui:VisualElement name="NavStatsIcon" class="nav-icon"/>
                    <ui:Label text="Estadísticas" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavRecords" class="nav-item">
                    <ui:VisualElement name="NavRecordsIcon" class="nav-icon"/>
                    <ui:Label text="Records" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavMarket" class="nav-item">
                    <ui:VisualElement name="NavMarketIcon" class="nav-icon"/>
                    <ui:Label text="Mercado" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavFinances" class="nav-item">
                    <ui:VisualElement name="NavFinancesIcon" class="nav-icon"/>
                    <ui:Label text="Finanzas" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavSponsors" class="nav-item">
                    <ui:VisualElement name="NavSponsorsIcon" class="nav-icon"/>
                    <ui:Label text="Patrocinadores" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavTV" class="nav-item">
                    <ui:VisualElement name="NavTVIcon" class="nav-icon"/>
                    <ui:Label text="Televisión" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavArena" class="nav-item">
                    <ui:VisualElement name="NavArenaIcon" class="nav-icon"/>
                    <ui:Label text="Pabellón" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavMessages" class="nav-item">
                    <ui:VisualElement name="NavMessagesIcon" class="nav-icon"/>
                    <ui:Label text="Mensajes" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavConfig" class="nav-item">
                    <ui:VisualElement name="NavConfigIcon" class="nav-icon"/>
                    <ui:Label text="Configuración" class="nav-label"/>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="roster-main">

            <!-- TOP HEADER (reutilizamos clases del dashboard) -->
            <ui:VisualElement name="TopHeader" class="top-header">
                <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo" />
                <ui:VisualElement class="header-team-info">
                    <ui:Label name="HeaderTeamName"    class="header-team-name"    text="" />
                    <ui:Label name="HeaderManagerName" class="header-manager-name" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="PRESUPUESTO" />
                    <ui:Label name="HeaderBudget" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MASA SALARIAL" />
                    <ui:Label name="HeaderPayroll" class="header-stat-value header-stat-value--neutral" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MARGEN SALARIAL" />
                    <ui:Label name="HeaderMargin" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-spacer" />
                <ui:VisualElement class="header-season-info">
                    <ui:Label name="HeaderSeason" class="header-season-label" text="" />
                    <ui:Label name="HeaderDate"   class="header-date-label"   text="" />
                </ui:VisualElement>
                <ui:Button name="BtnAction" class="btn-action" text="CONTINUAR" />
            </ui:VisualElement>

            <!-- SUMMARY BAR -->
            <ui:VisualElement class="summary-bar">
                <ui:VisualElement class="summary-item">
                    <ui:Label name="SummaryPlayers" class="summary-value" text="0" />
                    <ui:Label class="summary-label" text="JUGADORES" />
                </ui:VisualElement>
                <ui:VisualElement class="summary-item">
                    <ui:Label name="SummaryOverall" class="summary-value summary-value--gold" text="0" />
                    <ui:Label class="summary-label" text="OVERALL" />
                </ui:VisualElement>
                <ui:VisualElement class="summary-item summary-item-last">
                    <ui:Label name="SummaryBudget" class="summary-value summary-value--gold" text="" />
                    <ui:Label class="summary-label" text="PRESUPUESTO" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- CONTENT -->
            <ui:VisualElement class="roster-content">

                <!-- LEFT: lista -->
                <ui:VisualElement class="roster-list">
                    <ui:ScrollView name="RosterScroll" class="roster-scroll"
                                   horizontal-scrolling-enabled="false"
                                   mode="Vertical">
                        <ui:VisualElement name="RosterBody" />
                    </ui:ScrollView>
                </ui:VisualElement>

                <!-- RIGHT: detalle -->
                <ui:VisualElement name="PlayerDetail" class="player-detail">

                    <!-- Placeholder -->
                    <ui:VisualElement name="DetailEmpty" class="detail-empty">
                        <ui:Label class="detail-empty-text"
                                  text="SELECCIONA UN JUGADOR" />
                    </ui:VisualElement>

                    <!-- Panel detalle (oculto hasta selección) -->
                    <ui:ScrollView name="DetailScroll" class="detail-scroll"
                                   horizontal-scrolling-enabled="false"
                                   mode="Vertical">
                        <ui:VisualElement name="DetailContent">

                            <!-- Cabecera -->
                            <ui:VisualElement class="detail-top">
                                <ui:Label name="DetailPosBadge" class="detail-pos-badge" text="" />
                                <ui:VisualElement class="detail-name-block">
                                    <ui:Label name="DetailPlayerName" class="detail-player-name" text="" />
                                    <ui:Label name="DetailPlayerMeta" class="detail-player-meta" text="" />
                                </ui:VisualElement>
                                <ui:VisualElement class="detail-ovr-block">
                                    <ui:Label name="DetailOvr"      class="detail-ovr-val"   text="" />
                                    <ui:Label class="detail-ovr-label" text="OVR" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- Salud -->
                            <ui:VisualElement class="detail-health">
                                <ui:Label name="DetailHealth" class="detail-health-ok" text="✓ DISPONIBLE" />
                            </ui:VisualElement>

                            <!-- Atributos -->
                            <ui:VisualElement name="DetailAttrs" class="detail-attrs" />

                            <!-- Stats temporada -->
                            <ui:VisualElement name="DetailSeasonStats" class="detail-season-stats">
                                <ui:VisualElement class="season-stat-card">
                                    <ui:Label name="StatPts"   class="season-stat-val"   text="0.0" />
                                    <ui:Label class="season-stat-label" text="PTS" />
                                </ui:VisualElement>
                                <ui:VisualElement class="season-stat-card">
                                    <ui:Label name="StatReb"   class="season-stat-val"   text="0.0" />
                                    <ui:Label class="season-stat-label" text="REB" />
                                </ui:VisualElement>
                                <ui:VisualElement class="season-stat-card">
                                    <ui:Label name="StatAst"   class="season-stat-val"   text="0.0" />
                                    <ui:Label class="season-stat-label" text="AST" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- Footer contrato / potencial -->
                            <ui:VisualElement class="detail-footer">
                                <ui:VisualElement class="flex-col">
                                    <ui:Label class="detail-contract-label" text="CONTRATO" />
                                    <ui:Label name="DetailContract" class="detail-contract-value" text="" />
                                </ui:VisualElement>
                                <ui:VisualElement class="flex-col" style="align-items: flex-end;">
                                    <ui:Label class="detail-potential-label" text="POTENCIAL" />
                                    <ui:Label name="DetailPotential" class="detail-potential-value" text="" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- Botón despedir -->
                            <ui:Button name="BtnDismiss" class="btn-dismiss"
                                       text="DESPEDIR JUGADOR" />

                            <!-- Renovar contrato -->
                            <ui:Button name="BtnRenew" class="btn-renew"
                                       text="RENOVAR CONTRATO" />

                        </ui:VisualElement>
                    </ui:ScrollView>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ══ MODAL RENOVAR CONTRATO ══ -->
        <ui:VisualElement name="RenewOverlay" class="renew-modal-overlay">
            <ui:VisualElement name="RenewBox" class="renew-modal-box">
                <ui:VisualElement name="RenewIcon" class="renew-modal-icon"/>
                <ui:Label name="RenewTitle" class="renew-modal-title" text="RENOVAR CONTRATO" />
                <ui:Label name="RenewText1" class="renew-modal-text" text="" />
                <ui:Label name="RenewText2" class="renew-modal-text" text="" />
                <ui:Label name="RenewText3" class="renew-modal-text" text="" />
                <ui:VisualElement class="renew-modal-buttons">
                    <ui:Button name="BtnRenewCancel"  class="btn-modal-cancel"  text="CANCELAR" />
                    <ui:Button name="BtnRenewConfirm" class="btn-modal-confirm" text="CONFIRMAR RENOVACIÓN" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL COOLDOWN RENOVACIÓN ══ -->
        <ui:VisualElement name="RenewCooldownOverlay" class="renew-modal-overlay">
            <ui:VisualElement name="RenewCooldownBox" class="renew-modal-box">
                <ui:VisualElement name="RenewCooldownIcon" class="renew-modal-icon"/>
                <ui:Label name="RenewCooldownTitle" class="renew-modal-title" text="RENOVACIÓN NO DISPONIBLE" />
                <ui:Label name="RenewCooldownText" class="renew-modal-text" text="" />
                <ui:VisualElement class="renew-modal-buttons">
                    <ui:Button name="BtnRenewCooldownOk" class="btn-modal-cancel" text="ENTENDIDO" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL NO SE PUEDE RENOVAR ══ -->
        <ui:VisualElement name="RenewBlockOverlay" class="renew-modal-overlay">
            <ui:VisualElement name="RenewBlockBox" class="renew-modal-box">
                <ui:VisualElement name="RenewBlockIcon" class="renew-modal-icon"/>
                <ui:Label name="RenewBlockTitle" class="renew-modal-title" text="RENOVACIÓN NO DISPONIBLE" />
                <ui:Label name="RenewBlockText" class="renew-modal-text" text="" />
                <ui:VisualElement class="renew-modal-buttons">
                    <ui:Button name="BtnRenewBlockOk" class="btn-modal-cancel" text="ENTENDIDO" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL RESULTADO RENOVACIÓN ══ -->
        <ui:VisualElement name="RenewResultOverlay" class="renew-modal-overlay">
            <ui:VisualElement name="RenewResultBox" class="renew-modal-box">
                <ui:VisualElement name="RenewResultIcon" class="renew-modal-icon"/>
                <ui:Label name="RenewResultTitle" class="renew-modal-title" text="" />
                <ui:Label name="RenewResultText1" class="renew-modal-text" text="" />
                <ui:Label name="RenewResultText2" class="renew-modal-text" text="" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR DESPIDO ══ -->
        <ui:VisualElement name="DismissOverlay" class="dismiss-modal-overlay">
            <ui:VisualElement name="DismissBox" class="dismiss-modal-box">
                <ui:Label class="dismiss-modal-title" text="DESPEDIR JUGADOR" />
                <ui:Label name="DismissText1" class="dismiss-modal-text" text="" />
                <ui:Label name="DismissText2" class="dismiss-modal-text" text="" />
                <ui:Label class="dismiss-modal-text dismiss-modal-text--warning"
                          text="El jugador quedará sin equipo como agente libre." />
                <ui:VisualElement class="dismiss-modal-buttons">
                    <ui:Button name="BtnDismissCancel"  class="btn-modal-cancel"  text="CANCELAR" />
                    <ui:Button name="BtnDismissConfirm" class="btn-modal-confirm" text="CONFIRMAR DESPIDO" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>