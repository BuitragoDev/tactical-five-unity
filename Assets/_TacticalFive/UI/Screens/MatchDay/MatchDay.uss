/* ── MATCHDAY SCREEN ──────────────────────────── */

.matchday-root {
    position: relative;
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: #0f1117;
}

.matchday-main {
    flex: 1;
    flex-direction: column;
    overflow: hidden;
    background-color: #0f1117;
}

.matchday-scroll {
    flex: 1;
    background-color: #0f1117;
}

.matchday-content {
    flex-direction: column;
    padding: 24px 28px;
    background-color: #0f1117;
}

.matchday-content > * {
    margin-bottom: 20px;
}

/* ── TOP HEADER ──────────────────── */

.top-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 28px;
    background-color: #161a24;
    border-bottom-width: 2px;
    border-bottom-color: #d4a017;
    flex-shrink: 0;
    min-height: 100px;
}

.header-left {
    flex-direction: row;
    align-items: center;
    gap: 16px;
}

.header-team-logo {
    width: 64px;
    height: 64px;
}

.header-team-info {
    flex-direction: column;
    gap: 2px;
}

.header-team-name-row {
    flex-direction: row;
    align-items: baseline;
    gap: 12px;
}

.header-team-name {
    font-size: 24px;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 1px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.header-subtitle {
    font-size: 18px;
    font-weight: 500;
    color: #d4a017;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-left: 12px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
}

.header-manager-name {
    font-size: 18px;
    color: #7a8aaa;
}

.header-right-group {
    flex-direction: row;
    align-items: center;
    gap: 20px;
}

.header-season-info {
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
}

.header-season-label {
    font-size: 18px;
    font-weight: 600;
    color: #d4a017;
    letter-spacing: 1px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.header-date-label {
    font-size: 18px;
    font-weight: 500;
    color: #7a8aaa;
    letter-spacing: 1px;
    padding: 0 12px;
    border-left-width: 1px;
    border-left-color: #2a3347;
    border-right-width: 1px;
    border-right-color: #2a3347;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

.header-game-day-label {
    font-size: 18px;
    font-weight: 600;
    color: #4a80f0;
    letter-spacing: 1px;
    text-transform: uppercase;
    background-color: rgba(42, 95, 201, 0.15);
    padding: 6px 14px;
    border-radius: 4px;
    margin-left: 20px;
    margin-right: 20px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.btn-action {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 250px;
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 18px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

/* ── MATCH BANNER ──────────────────── */

.match-banner {
    background-color: #1c2130;
    border-width: 1px;
    border-color: #2a3347;
    border-radius: 8px;
    padding: 14px 24px;
    flex-direction: column;
}

.match-teams {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.match-team {
    flex-direction: column;
    align-items: center;
    flex: 1;
}

.match-team > * {
    margin-bottom: 6px;
}

.match-team-logo {
    width: 80px;
    height: 80px;
}

.match-team-name {
    font-size: 24px;
    font-weight: 700;
    color: #d0d8e8;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 1px;
    line-height: 1.2;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.match-team.my-team .match-team-name {
    color: #d4a017;
}

.my-team-badge {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #d4a017;
    background-color: rgba(212, 160, 23, 0.12);
    padding: 2px 8px;
    border-radius: 3px;
    text-transform: uppercase;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.match-score {
    flex-direction: row;
    align-items: center;
    padding: 0 16px;
}

.match-score > * {
    margin-right: 10px;
}

.score-home, .score-away {
    font-size: 48px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.score-sep {
    font-size: 28px;
    font-weight: 400;
    color: #7a8aaa;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

.match-venue {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
    height: 24px;
}

.match-venue-label {
    font-size: 18px;
    color: #d0d8e8;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

/* ── BOX SCORES ─────────────────────── */

.box-scores {
    flex-direction: row;
    width: 100%;
}

.box-score-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    background-color: #1c2130;
    border-width: 1px;
    border-color: #2a3347;
    border-radius: 8px;
    overflow: hidden;
}

.box-score-header {
    flex-direction: row;
    align-items: center;
    padding: 14px 20px;
    background-color: #1c2130;
    border-bottom-width: 1px;
    border-bottom-color: #2a3347;
}

.box-score-header > * {
    margin-right: 12px;
}

.box-logo {
    width: 64px;
    height: 64px;
}

.box-team-name {
    font-size: 24px;
    font-weight: 600;
    color: #d0d8e8;
    text-transform: uppercase;
    letter-spacing: 1px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.box-table-wrapper {
    flex-direction: column;
}

.box-table-header {
    flex-direction: row;
    padding: 10px 8px;
    border-bottom-width: 1px;
    border-bottom-color: #2a3347;
    min-height: 40px;
    align-items: center;
}

.box-table-header .col-stat--header {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    text-align: center;
    text-transform: uppercase;
    color: #7a8aaa;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.box-table-header .col-stat--header.col-player {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    text-align: left;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

.box-table-header .col-stat--header.col-min { width: 36px; }
.box-table-header .col-stat--header.col-pts { width: 36px; }
.box-table-header .col-stat--header.col-fg { width: 50px; }
.box-table-header .col-stat--header.col-3p { width: 46px; }
.box-table-header .col-stat--header.col-ft { width: 44px; }
.box-table-header .col-stat--header.col-reb { width: 36px; }
.box-table-header .col-stat--header.col-ast { width: 36px; }
.box-table-header .col-stat--header.col-stl { width: 36px; }
.box-table-header .col-stat--header.col-blk { width: 36px; }
.box-table-header .col-stat--header.col-to { width: 36px; }
.box-table-header .col-stat--header.col-pf { width: 36px; }
.box-table-header .col-stat--header.col-val { width: 36px; }

.box-table-body {
    flex-direction: column;
}

.box-row {
    flex-direction: row;
    padding: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 51, 71, 0.3);
    align-items: center;
    min-height: 30px;
}

.box-row.my-player {
    background-color: transparent;
}

.box-row--starter .player-name {
    color: rgb(212, 160, 23);
}

.box-row .col-player {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    font-size: 16px;
    font-weight: 500;
    color: #d0d8e8;
    letter-spacing: 0.5px;
    white-space: nowrap;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

.player-pos {
    font-size: 16px;
    font-weight: 700;
    color: #7a8aaa;
    background-color: #161a24;
    padding: 2px 6px;
    border-radius: 3px;
    letter-spacing: 1px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.mvp-star {
    font-size: 16px;
    font-weight: 700;
    color: #d4a017;
    margin-right: 4px;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.player-name {
    font-size: 16px;
    font-weight: 500;
    color: #d0d8e8;
    letter-spacing: 0.5px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

.col-min, .col-pts,
.col-fg, .col-3p, .col-ft,
.col-reb, .col-ast, .col-stl, .col-blk, .col-to, .col-pf, .col-val {
    flex-shrink: 0;
    text-align: center;
    font-size: 16px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

.col-min { width: 36px; color: #7a8aaa; }
.col-pts { width: 36px; font-weight: 700; color: #ffffff; -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf"); }
.col-fg { width: 50px; color: #d0d8e8; }
.col-3p { width: 46px; color: #d0d8e8; }
.col-ft { width: 44px; color: #d0d8e8; }
.col-reb { width: 36px; color: #d0d8e8; }
.col-ast { width: 36px; color: #d0d8e8; }
.col-stl { width: 36px; color: #d0d8e8; }
.col-blk { width: 36px; color: #d0d8e8; }
.col-to { width: 36px; color: #d0d8e8; }
.col-pf { width: 36px; color: #d0d8e8; }
.col-val { width: 36px; font-weight: 700; color: #ffffff; -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf"); }

.box-table-footer {
    background-color: rgba(0, 0, 0, 0.2);
    flex-direction: row;
    padding: 10px 8px;
    min-height: 40px;
    align-items: center;
}

.box-total-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.box-total-row .col-player {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    font-size: 16px;
    font-weight: 700;
    color: #d4a017;
    text-transform: uppercase;
    letter-spacing: 1px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.box-total-row .col-min,
.box-total-row .col-pts,
.box-total-row .col-reb,
.box-total-row .col-ast,
.box-total-row .col-stl,
.box-total-row .col-blk,
.box-total-row .col-to,
.box-total-row .col-pf,
.box-total-row .col-val {
    flex-shrink: 0;
    width: 36px;
    text-align: center;
    font-size: 16px;
    font-weight: 700;
    color: #d4a017;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.box-total-row .col-fg {
    flex-shrink: 0;
    width: 50px;
    text-align: center;
    font-size: 16px;
    font-weight: 700;
    color: #d4a017;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.box-total-row .col-3p {
    flex-shrink: 0;
    width: 46px;
    text-align: center;
    font-size: 16px;
    font-weight: 700;
    color: #d4a017;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.box-total-row .col-ft {
    flex-shrink: 0;
    width: 44px;
    text-align: center;
    font-size: 16px;
    font-weight: 700;
    color: #d4a017;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

/* ── PLAY-BY-PLAY OVERLAY ──────────── */

.pbp-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #0b0e16;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 36px 48px 24px 48px;
    z-index: 100;
}

.pbp-header {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.pbp-team-side {
    flex: 1;
    flex-direction: row;
    align-items: center;
}

.pbp-team-side--home {
    justify-content: flex-end;
}

.pbp-team-side--away {
    justify-content: flex-start;
}

.pbp-team-logo {
    width: 120px;
    height: 120px;
    margin-left: 16px;
    margin-right: 16px;
    flex-shrink: 0;
}

.pbp-team {
    font-size: 32px;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 1px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    max-width: 300px;
}

.pbp-team-side--home .pbp-team { text-align: right; }
.pbp-team-side--away .pbp-team { text-align: left; }

.pbp-score {
    font-size: 72px;
    font-weight: 700;
    color: #d4a017;
    text-align: center;
    line-height: 1;
    flex-shrink: 0;
    padding: 0 20px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.pbp-meta-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.pbp-quarter {
    font-size: 18px;
    font-weight: 700;
    color: #4a80f0;
    letter-spacing: 2px;
    text-transform: uppercase;
    background-color: rgba(42, 95, 201, 0.15);
    padding: 4px 14px;
    border-radius: 4px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    margin-right: 16px;
}

.pbp-clock {
    font-size: 18px;
    font-weight: 700;
    color: #d4a017;
    letter-spacing: 2px;
    text-transform: uppercase;
    background-color: rgba(212, 160, 23, 0.12);
    padding: 4px 14px;
    border-radius: 4px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.pbp-progress {
    width: 100%;
    height: 10px;
    background-color: #161a24;
    border-radius: 5px;
    overflow: hidden;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.pbp-progress-fill {
    height: 100%;
    background-color: rgb(42, 95, 201);
    width: 0%;
}

.pbp-progress-label {
    display: none;
}

.pbp-text {
    font-size: 28px;
    font-weight: 500;
    color: #e8ecf5;
    text-align: center;
    min-height: 42px;
    margin-bottom: 10px;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    -unity-text-align: middle-center;
}

.pbp-boxes {
    flex-direction: row;
    width: 100%;
    flex: 1;
    min-height: 0;
    margin-bottom: 10px;
}

.pbp-box-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: column;
    background-color: #1c2130;
    border-width: 1px;
    border-color: #2a3347;
    border-radius: 6px;
    overflow: hidden;
    margin-right: 12px;
}

.pbp-box-panel:last-child {
    margin-right: 0;
}

.pbp-box-panel .box-table-header {
    flex-shrink: 0;
    min-height: 30px;
    padding: 6px 6px;
}

.pbp-box-panel .box-table-header .col-stat--header {
    font-size: 16px;
}

.pbp-box-panel .box-table-body {
    overflow-y: auto;
    flex: 1;
}

.pbp-box-panel .box-row {
    min-height: 22px;
    padding: 2px 4px;
}

.pbp-box-panel .player-name,
.pbp-box-panel .player-pos,
.pbp-box-panel .mvp-star {
    font-size: 16px;
}

.pbp-box-panel .col-min, .pbp-box-panel .col-pts,
.pbp-box-panel .col-fg, .pbp-box-panel .col-3p, .pbp-box-panel .col-ft,
.pbp-box-panel .col-reb, .pbp-box-panel .col-ast, .pbp-box-panel .col-stl,
.pbp-box-panel .col-blk, .pbp-box-panel .col-to, .pbp-box-panel .col-pf,
.pbp-box-panel .col-val {
    font-size: 16px;
}

.pbp-box-panel .box-table-footer {
    flex-shrink: 0;
    min-height: 26px;
    padding: 4px 6px;
}

.pbp-box-panel .box-total-row .col-player,
.pbp-box-panel .box-total-row .col-min,
.pbp-box-panel .box-total-row .col-pts,
.pbp-box-panel .box-total-row .col-fg,
.pbp-box-panel .box-total-row .col-3p,
.pbp-box-panel .box-total-row .col-ft,
.pbp-box-panel .box-total-row .col-reb,
.pbp-box-panel .box-total-row .col-ast,
.pbp-box-panel .box-total-row .col-stl,
.pbp-box-panel .box-total-row .col-blk,
.pbp-box-panel .box-total-row .col-to,
.pbp-box-panel .box-total-row .col-pf,
.pbp-box-panel .box-total-row .col-val {
    font-size: 16px;
}

.pbp-controls {
    flex-direction: row;
    align-items: center;
    width: 100%;
    flex-shrink: 0;
}

.pbp-speed-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: #1c2130;
    border-width: 1px;
    border-color: #2a3347;
    color: #7a8aaa;
    font-size: 18px;
    padding: 8px 20px;
    border-radius: 4px;
    -unity-text-align: middle-center;
    margin-right: 10px;
}

.pbp-speed-btn--active {
    background-color: rgb(42, 95, 201);
    border-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
}

.pbp-spacer {
    flex: 1;
}

.pbp-skip {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 24px;
    border-radius: 4px;
    -unity-text-align: middle-center;
    margin-left: 10px;
}

/* ===================== Matchup Preview (NEW) ===================== */

.mpv-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: #0b0e16;
    flex-direction: column;
    align-items: stretch;
    padding: 20px 32px;
    z-index: 150;
    overflow: hidden;
}

.mpv-logo-lg {
    width: 100px;
    height: 100px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    flex-shrink: 0;
    margin: 10px 20px;
}

.mpv-team-info {
    flex-direction: column;
    flex-grow: 1;
}

.mpv-team-info--right {
    align-items: flex-end;
}

.mpv-city {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: #7a8aaa;
    letter-spacing: 1px;
}

.mpv-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 36px;
    color: #ffffff;
    letter-spacing: 2px;
    line-height: 1;
    margin-bottom: 4px;
}

.mpv-record {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    color: #ffffff;
    letter-spacing: 1px;
}

.mpv-conf {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 15px;
    color: #7a8aaa;
    letter-spacing: 1px;
    margin-bottom: 6px;
}

.mpv-streak-row {
    flex-direction: row;
    align-items: center;
    margin-top: 20px;
    margin-bottom: 20px;
    width: 100%;
}

.mpv-divider {
    width: 100%;
    height: 1px;
    background-color: #2a3347;
    margin: 20px 0;
    flex-shrink: 0;
}

.mpv-streak-row--right {
    justify-content: flex-end;
}

.mpv-streak-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 12px;
    color: #7a8aaa;
    letter-spacing: 1px;
    margin-right: 8px;
}

.mpv-streak-dots {
    flex-direction: row;
    align-items: center;
}

.mpv-streak-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 11px;
    color: #ffffff;
    margin-right: 3px;
    justify-content: center;
    align-items: center;
}

.mpv-streak-dot--win { background-color: #27ae60; }
.mpv-streak-dot--loss { background-color: #c0392b; }

/* ── Center Info ── */
.mpv-date {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: #d4a017;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.mpv-arena {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: #ffffff;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.mpv-city-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: #7a8aaa;
    letter-spacing: 1px;
    margin-bottom: 6px;
}

.mpv-vs {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 28px;
    color: #2a3347;
    margin-bottom: 12px;
}

/* ── Favorite Badge ── */
.mpv-favorite {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: #d4a017;
    letter-spacing: 2px;
    -unity-text-align: middle-right;
    align-self: flex-end;
    margin-bottom: 6px;
    flex-shrink: 0;
}

/* ── 3-Column Layout ── */
.mpv-3cols {
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
    width: 100%;
    min-height: 0;
}

.mpv-col {
    flex: 1;
    flex-direction: column;
    padding: 0 12px;
    overflow: hidden;
}

.mpv-col--center {
    align-items: center;
    justify-content: flex-start;
    padding-top: 10px;
}

.mpv-col-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 10px;
    width: 100%;
}

.mpv-col-header--right {
    justify-content: flex-end;
}

.mpv-col-header--right .mpv-team-info {
    align-items: flex-end;
}

.mpv-col-stats {
    flex-direction: row;
    justify-content: center;
    width: 100%;
    flex-shrink: 0;
    margin-bottom: 12px;
}

/* ── Stat Cards ── */
.mpv-stat-card {
    flex-direction: column;
    align-items: center;
    padding: 10px 16px;
    background-color: #141824;
    border-width: 1px;
    border-color: #2a3347;
    border-radius: 6px;
    margin: 0 4px;
    flex: 1;
}

.mpv-stat-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: #7a8aaa;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.mpv-stat-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    color: #ffffff;
    letter-spacing: 1px;
}

.mpv-stat-rank {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: #7a8aaa;
    margin-top: 2px;
}

/* ── Bajas ── */
.mpv-bajas-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    color: #7a8aaa;
    letter-spacing: 2px;
    margin-bottom: 8px;
}

.mpv-bajas-list {
    flex-direction: column;
    align-items: stretch;
    width: 100%;
}

.mpv-bajas-cols {
    flex-direction: row;
    width: 100%;
    margin-bottom: 12px;
}

.mpv-bajas-col {
    flex: 1;
    flex-direction: column;
    padding: 0 4px;
}

.mpv-bajas-col-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: #7a8aaa;
    letter-spacing: 1px;
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}

.mpv-baja-item {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    background-color: #141824;
    border-width: 1px;
    border-color: #2a3347;
    border-radius: 6px;
    margin-bottom: 4px;
}

.mpv-baja-photo {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-size: contain;
    background-position: center;
    flex-shrink: 0;
    margin-right: 8px;
}

.mpv-baja-info {
    flex-direction: column;
    flex-grow: 1;
}

.mpv-baja-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    color: #ffffff;
}

.mpv-baja-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 13px;
    color: #7a8aaa;
}

.mpv-baja-status {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 13px;
    letter-spacing: 1px;
    margin-right: 8px;
}

.mpv-baja-status--doubt { color: #d4a017; }
.mpv-baja-status--out { color: #c0392b; }

.mpv-baja-injury {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 13px;
    color: #7a8aaa;
}

/* ── Roster titles (inside columns) ── */
.mpv-roster-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    color: #7a8aaa;
    margin-top: 8px;
    margin-bottom: 6px;
}

/* ── Starter Cards ── */
.mpv-starter-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.mpv-starter-card {
    flex: 1;
    height: 255px;
    background-color: #1c2130;
    border-width: 1px;
    border-color: #2a3347;
    border-radius: 8px;
    padding: 8px 4px;
    margin-right: 4px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
}

.mpv-starter-card:last-child { margin-right: 0; }

.mpv-starter-photo {
    width: 100px;
    height: 100px;
    margin-bottom: 8px;
    background-size: contain;
    background-position: center;
}

.mpv-starter-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: #7a8aaa;
    margin-bottom: 4px;
}

.mpv-starter-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: #ffffff;
    -unity-text-align: middle-center;
    white-space: normal;
    line-height: 0.9;
    flex-grow: 1;
}

.mpv-starter-ovr {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    color: #d4a017;
}

/* ── Bench ── */
.mpv-bench-list {
    flex-direction: row;
    flex-wrap: wrap;
    width: 100%;
}

.mpv-bench-card {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    margin-bottom: 4px;
    margin-right: 4px;
    background-color: #1c2130;
    border-width: 1px;
    border-color: #2a3347;
    border-radius: 6px;
    flex-basis: 47%;
    flex-grow: 1;
    flex-shrink: 0;
    min-width: 0;
}

.mpv-bench-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: #ffffff;
    flex-grow: 1;
    margin-right: 6px;
}

.mpv-bench-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: #7a8aaa;
    width: 90px;
    -unity-text-align: middle-left;
}

.mpv-bench-ovr {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: #d4a017;
    width: 36px;
    -unity-text-align: middle-right;
}

/* ── Key Players (center column) ── */
.mpv-key-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: #7a8aaa;
    margin-bottom: 10px;
}

.mpv-key-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 6px 0;
    border-bottom-width: 1px;
    border-bottom-color: #2a3347;
}

.mpv-key-row:last-child { border-bottom-width: 0; }

.mpv-key-player {
    flex-direction: row;
    align-items: center;
    flex: 1;
}

.mpv-key-player--right {
    justify-content: flex-end;
}

.mpv-key-photo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-size: contain;
    background-position: center;
    flex-shrink: 0;
}

.mpv-key-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: #ffffff;
    margin-left: 6px;
    margin-right: 6px;
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.mpv-key-player--right .mpv-key-name {
    margin-left: 6px;
    margin-right: 0;
}

.mpv-key-stat {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    color: #ffffff;
    width: 50px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.mpv-key-stat--left { -unity-text-align: middle-right; }
.mpv-key-stat--right { -unity-text-align: middle-left; }

.mpv-key-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 12px;
    letter-spacing: 1px;
    color: #7a8aaa;
    width: 40px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    margin: 0 6px;
}

/* ── Start Button ── */
.mpv-start-btn-spacer {
    flex-grow: 1;
}

.mpv-start-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: #ffffff;
    font-size: 20px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 12px 32px;
    border-radius: 4px;
    -unity-text-align: middle-center;
    margin-top: 12px;
    align-self: stretch;
    flex-shrink: 0;
}

.mpv-start-btn:hover {
    background-color: rgb(52, 120, 230);
}

