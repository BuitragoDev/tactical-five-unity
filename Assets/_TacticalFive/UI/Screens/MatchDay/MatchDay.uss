/* ── MATCHDAY SCREEN ──────────────────────────── */

.matchday-root {
    position: relative;
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: #0f1117;
}

.matchday-main {
    flex: 1;
    flex-direction: column;
    overflow: hidden;
    background-color: #0f1117;
}

.matchday-scroll {
    flex: 1;
    background-color: #0f1117;
}

.matchday-content {
    flex-direction: column;
    padding: 24px 28px;
    background-color: #0f1117;
}

.matchday-content > * {
    margin-bottom: 20px;
}

/* ── TOP HEADER ──────────────────── */

.top-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 28px;
    background-color: #161a24;
    border-bottom-width: 2px;
    border-bottom-color: #d4a017;
    flex-shrink: 0;
    min-height: 100px;
}

.header-left {
    flex-direction: row;
    align-items: center;
    gap: 16px;
}

.header-team-logo {
    width: 64px;
    height: 64px;
}

.header-team-info {
    flex-direction: column;
    gap: 2px;
}

.header-team-name-row {
    flex-direction: row;
    align-items: baseline;
    gap: 12px;
}

.header-team-name {
    font-size: 24px;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 1px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.header-subtitle {
    font-size: 18px;
    font-weight: 500;
    color: #d4a017;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-left: 12px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
}

.header-manager-name {
    font-size: 18px;
    color: #7a8aaa;
}

.header-right-group {
    flex-direction: row;
    align-items: center;
    gap: 20px;
}

.header-season-info {
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
}

.header-season-label {
    font-size: 18px;
    font-weight: 600;
    color: #d4a017;
    letter-spacing: 1px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.header-date-label {
    font-size: 18px;
    font-weight: 500;
    color: #7a8aaa;
    letter-spacing: 1px;
    padding: 0 12px;
    border-left-width: 1px;
    border-left-color: #2a3347;
    border-right-width: 1px;
    border-right-color: #2a3347;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

.header-game-day-label {
    font-size: 18px;
    font-weight: 600;
    color: #4a80f0;
    letter-spacing: 1px;
    text-transform: uppercase;
    background-color: rgb(22, 32, 54);
    padding: 6px 14px;
    border-radius: 4px;
    margin-left: 20px;
    margin-right: 20px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.btn-action {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    min-width: 250px;
    background-color: rgb(20, 28, 45);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(120, 160, 230);
    font-size: 24px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 10px 18px;
    -unity-text-align: middle-center;
    border-radius: 8px;
    flex-shrink: 0;
    cursor: pointer;
}

.btn-action:hover {
    background-color: rgb(24, 40, 71);
    color: rgb(150, 190, 255);
}

/* ── MATCH BANNER ──────────────────── */

.match-banner {
    background-color: #1c2130;
    border-width: 1px;
    border-color: #2a3347;
    border-radius: 8px;
    padding: 14px 24px;
    flex-direction: column;
}

.match-teams {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.match-team {
    flex-direction: column;
    align-items: center;
    flex: 1;
}

.match-team > * {
    margin-bottom: 6px;
}

.match-team-logo {
    width: 80px;
    height: 80px;
}

.match-team-name {
    font-size: 24px;
    font-weight: 700;
    color: #d0d8e8;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 1px;
    line-height: 1.2;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.match-team.my-team .match-team-name {
    color: #d4a017;
}

.my-team-badge {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #d4a017;
    background-color: rgb(41, 38, 27);
    padding: 2px 8px;
    border-radius: 3px;
    text-transform: uppercase;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.match-score {
    flex-direction: row;
    align-items: center;
    padding: 0 16px;
}

.match-score > * {
    margin-right: 10px;
}

.score-home, .score-away {
    font-size: 48px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.score-sep {
    font-size: 28px;
    font-weight: 400;
    color: #7a8aaa;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

.match-venue {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
    height: 24px;
}

.match-venue-label {
    font-size: 18px;
    color: #d0d8e8;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

/* ── BOX SCORES ─────────────────────── */

.box-scores {
    flex-direction: row;
    width: 100%;
}

.box-score-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    background-color: #1c2130;
    border-width: 1px;
    border-color: #2a3347;
    border-radius: 8px;
    overflow: hidden;
}

.box-score-header {
    flex-direction: row;
    align-items: center;
    padding: 14px 20px;
    background-color: #1c2130;
    border-bottom-width: 1px;
    border-bottom-color: #2a3347;
}

.box-score-header > * {
    margin-right: 12px;
}

.box-logo {
    width: 64px;
    height: 64px;
}

.box-team-name {
    font-size: 24px;
    font-weight: 600;
    color: #d0d8e8;
    text-transform: uppercase;
    letter-spacing: 1px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.box-table-wrapper {
    flex-direction: column;
}

.box-table-header {
    flex-direction: row;
    padding: 10px 8px;
    border-bottom-width: 1px;
    border-bottom-color: #2a3347;
    min-height: 40px;
    align-items: center;
}

.box-table-header .col-stat--header {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    text-align: center;
    text-transform: uppercase;
    color: #7a8aaa;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.box-table-header .col-stat--header.col-player {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    text-align: left;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

.box-table-header .col-stat--header.col-min { width: 36px; }
.box-table-header .col-stat--header.col-pts { width: 36px; }
.box-table-header .col-stat--header.col-fg { width: 50px; }
.box-table-header .col-stat--header.col-3p { width: 46px; }
.box-table-header .col-stat--header.col-ft { width: 44px; }
.box-table-header .col-stat--header.col-reb { width: 36px; }
.box-table-header .col-stat--header.col-ast { width: 36px; }
.box-table-header .col-stat--header.col-stl { width: 36px; }
.box-table-header .col-stat--header.col-blk { width: 36px; }
.box-table-header .col-stat--header.col-to { width: 36px; }
.box-table-header .col-stat--header.col-pf { width: 36px; }
.box-table-header .col-stat--header.col-val { width: 36px; }

.box-table-body {
    flex-direction: column;
}

.box-row {
    flex-direction: row;
    padding: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(25, 30, 41);
    align-items: center;
    min-height: 30px;
}

.box-row.my-player {
    background-color: transparent;
}

.box-row--starter .player-name {
    color: rgb(212, 160, 23);
}

.box-row .col-player {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    font-size: 16px;
    font-weight: 500;
    color: #d0d8e8;
    letter-spacing: 0.5px;
    white-space: nowrap;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

.player-pos {
    font-size: 16px;
    font-weight: 700;
    color: #7a8aaa;
    background-color: #161a24;
    padding: 2px 6px;
    border-radius: 3px;
    letter-spacing: 1px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.mvp-star {
    font-size: 16px;
    font-weight: 700;
    color: #d4a017;
    margin-right: 4px;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.player-name {
    font-size: 16px;
    font-weight: 500;
    color: #d0d8e8;
    letter-spacing: 0.5px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

.col-min, .col-pts,
.col-fg, .col-3p, .col-ft,
.col-reb, .col-ast, .col-stl, .col-blk, .col-to, .col-pf, .col-val {
    flex-shrink: 0;
    text-align: center;
    font-size: 16px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

.col-min { width: 36px; color: #7a8aaa; }
.col-pts { width: 36px; font-weight: 700; color: #ffffff; -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf"); }
.col-fg { width: 50px; color: #d0d8e8; }
.col-3p { width: 46px; color: #d0d8e8; }
.col-ft { width: 44px; color: #d0d8e8; }
.col-reb { width: 36px; color: #d0d8e8; }
.col-ast { width: 36px; color: #d0d8e8; }
.col-stl { width: 36px; color: #d0d8e8; }
.col-blk { width: 36px; color: #d0d8e8; }
.col-to { width: 36px; color: #d0d8e8; }
.col-pf { width: 36px; color: #d0d8e8; }
.col-val { width: 36px; font-weight: 700; color: #ffffff; -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf"); }

.box-table-footer {
    background-color: rgb(14, 17, 22);
    flex-direction: row;
    padding: 10px 8px;
    min-height: 40px;
    align-items: center;
}

.box-total-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.box-total-row .col-player {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    font-size: 16px;
    font-weight: 700;
    color: #d4a017;
    text-transform: uppercase;
    letter-spacing: 1px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.box-total-row .col-min,
.box-total-row .col-pts,
.box-total-row .col-reb,
.box-total-row .col-ast,
.box-total-row .col-stl,
.box-total-row .col-blk,
.box-total-row .col-to,
.box-total-row .col-pf,
.box-total-row .col-val {
    flex-shrink: 0;
    width: 36px;
    text-align: center;
    font-size: 16px;
    font-weight: 700;
    color: #d4a017;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.box-total-row .col-fg {
    flex-shrink: 0;
    width: 50px;
    text-align: center;
    font-size: 16px;
    font-weight: 700;
    color: #d4a017;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.box-total-row .col-3p {
    flex-shrink: 0;
    width: 46px;
    text-align: center;
    font-size: 16px;
    font-weight: 700;
    color: #d4a017;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.box-total-row .col-ft {
    flex-shrink: 0;
    width: 44px;
    text-align: center;
    font-size: 16px;
    font-weight: 700;
    color: #d4a017;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

/* ── PLAY-BY-PLAY OVERLAY ──────────── */

.pbp-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #0b0e16;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 36px 48px 24px 48px;
    z-index: 100;
}

.pbp-header {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.pbp-team-side {
    flex: 1;
    flex-direction: row;
    align-items: center;
}

.pbp-team-side--home {
    justify-content: flex-end;
}

.pbp-team-side--away {
    justify-content: flex-start;
}

.pbp-team-logo {
    width: 120px;
    height: 120px;
    margin-left: 16px;
    margin-right: 16px;
    flex-shrink: 0;
}

.pbp-team {
    font-size: 32px;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 1px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    max-width: 300px;
}

.pbp-team-side--home .pbp-team { text-align: right; }
.pbp-team-side--away .pbp-team { text-align: left; }

.pbp-score {
    font-size: 72px;
    font-weight: 700;
    color: #d4a017;
    text-align: center;
    line-height: 1;
    flex-shrink: 0;
    padding: 0 20px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.pbp-meta-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.pbp-quarter {
    font-size: 18px;
    font-weight: 700;
    color: #4a80f0;
    letter-spacing: 2px;
    text-transform: uppercase;
    background-color: rgb(22, 32, 54);
    padding: 4px 14px;
    border-radius: 4px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    margin-right: 16px;
}

.pbp-clock {
    font-size: 18px;
    font-weight: 700;
    color: #d4a017;
    letter-spacing: 2px;
    text-transform: uppercase;
    background-color: rgb(41, 38, 27);
    padding: 4px 14px;
    border-radius: 4px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.pbp-progress {
    width: 100%;
    height: 10px;
    background-color: #161a24;
    border-radius: 5px;
    overflow: hidden;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.pbp-progress-fill {
    height: 100%;
    background-color: rgb(42, 95, 201);
    width: 0%;
}

.pbp-progress-label {
    display: none;
}

.pbp-text {
    font-size: 28px;
    font-weight: 500;
    color: #e8ecf5;
    text-align: center;
    min-height: 42px;
    margin-bottom: 10px;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    -unity-text-align: middle-center;
}

.pbp-boxes {
    flex-direction: row;
    width: 100%;
    flex: 1;
    min-height: 0;
    margin-bottom: 10px;
}

.pbp-box-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: column;
    background-color: #1c2130;
    border-width: 1px;
    border-color: #2a3347;
    border-radius: 6px;
    overflow: hidden;
    margin-right: 12px;
}

.pbp-box-panel:last-child {
    margin-right: 0;
}

.pbp-box-panel .box-table-header {
    flex-shrink: 0;
    min-height: 30px;
    padding: 6px 6px;
}

.pbp-box-panel .box-table-header .col-stat--header {
    font-size: 16px;
}

.pbp-box-panel .box-table-body {
    overflow-y: auto;
    flex: 1;
}

.pbp-box-panel .box-row {
    min-height: 22px;
    padding: 2px 4px;
}

.pbp-box-panel .player-name,
.pbp-box-panel .player-pos,
.pbp-box-panel .mvp-star {
    font-size: 16px;
}

.pbp-box-panel .col-min, .pbp-box-panel .col-pts,
.pbp-box-panel .col-fg, .pbp-box-panel .col-3p, .pbp-box-panel .col-ft,
.pbp-box-panel .col-reb, .pbp-box-panel .col-ast, .pbp-box-panel .col-stl,
.pbp-box-panel .col-blk, .pbp-box-panel .col-to, .pbp-box-panel .col-pf,
.pbp-box-panel .col-val {
    font-size: 16px;
}

.pbp-box-panel .box-table-footer {
    flex-shrink: 0;
    min-height: 26px;
    padding: 4px 6px;
}

.pbp-box-panel .box-total-row .col-player,
.pbp-box-panel .box-total-row .col-min,
.pbp-box-panel .box-total-row .col-pts,
.pbp-box-panel .box-total-row .col-fg,
.pbp-box-panel .box-total-row .col-3p,
.pbp-box-panel .box-total-row .col-ft,
.pbp-box-panel .box-total-row .col-reb,
.pbp-box-panel .box-total-row .col-ast,
.pbp-box-panel .box-total-row .col-stl,
.pbp-box-panel .box-total-row .col-blk,
.pbp-box-panel .box-total-row .col-to,
.pbp-box-panel .box-total-row .col-pf,
.pbp-box-panel .box-total-row .col-val {
    font-size: 16px;
}

.pbp-controls {
    flex-direction: row;
    align-items: center;
    width: 100%;
    flex-shrink: 0;
}

.pbp-speed-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    min-width: 64px;
    background-color: rgb(20, 24, 33);
    border-width: 2px;
    border-color: rgb(42, 51, 71);
    color: rgb(122, 138, 170);
    font-size: 18px;
    letter-spacing: 1px;
    padding: 9px 18px;
    border-radius: 8px;
    -unity-text-align: middle-center;
    margin-right: 8px;
    cursor: pointer;
}

.pbp-speed-btn:hover {
    background-color: rgb(28, 33, 48);
    border-color: rgb(58, 74, 99);
    color: rgb(208, 216, 232);
}

.pbp-speed-btn--active {
    background-color: rgb(37, 35, 28);
    border-color: rgb(212, 160, 23);
    color: rgb(212, 160, 23);
}

.pbp-speed-btn--active:hover {
    background-color: rgb(66, 56, 27);
    border-color: rgb(240, 192, 64);
    color: rgb(240, 192, 64);
}

.pbp-spacer {
    flex: 1;
}

.pbp-skip {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(20, 36, 35);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    color: rgb(100, 200, 140);
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 10px 24px;
    border-radius: 8px;
    -unity-text-align: middle-center;
    margin-left: 10px;
    cursor: pointer;
}

.pbp-skip:hover {
    background-color: rgb(23, 59, 45);
    border-color: rgb(80, 210, 130);
    color: rgb(150, 220, 180);
}


/* ── SIMULACIÓN VISUAL 2D ─────────────────────────────── */

.sim2d-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(10, 14, 22);
    flex-direction: column;
    padding: 18px 24px 16px 24px;
    z-index: 110;
}

.sim2d-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 88px;
    flex-shrink: 0;
    padding: 8px 18px;
    background-color: rgb(19, 24, 35);
    border-width: 1px;
    border-color: rgb(45, 56, 78);
    border-radius: 10px;
    margin-bottom: 14px;
}

.sim2d-team {
    flex-direction: row;
    align-items: center;
    flex: 1;
    min-width: 0;
}

.sim2d-team--home {
    justify-content: flex-start;
}

.sim2d-team--away {
    justify-content: flex-end;
}

.sim2d-team-logo {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    margin-left: 8px;
    margin-right: 8px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.sim2d-team-copy {
    flex-direction: column;
    min-width: 0;
}

.sim2d-team-copy--home {
    align-items: flex-start;
}

.sim2d-team-copy--away {
    align-items: flex-end;
}

.sim2d-team-abbr {
    font-size: 25px;
    color: rgb(255, 255, 255);
    letter-spacing: 1px;
    max-width: 360px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.sim2d-team-name {
    font-size: 19px;
    color: rgb(220, 226, 238);
    text-transform: uppercase;
    letter-spacing: 1px;
    max-width: 260px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.sim2d-scoreboard {
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    padding: 0 24px;
}

.sim2d-score {
    font-size: 52px;
    color: rgb(212, 160, 23);
    line-height: 1;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.sim2d-clock-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.sim2d-quarter {
    font-size: 14px;
    color: rgb(100, 150, 245);
    letter-spacing: 2px;
    text-transform: uppercase;
    background-color: rgb(25, 38, 62);
    padding: 3px 10px;
    border-radius: 4px;
    margin-right: 8px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.sim2d-clock {
    font-size: 16px;
    color: rgb(212, 160, 23);
    letter-spacing: 1px;
    background-color: rgb(41, 38, 27);
    padding: 3px 10px;
    border-radius: 4px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.sim2d-body {
    flex-direction: row;
    flex: 1;
    min-height: 0;
    margin-bottom: 12px;
}

.sim2d-side {
    width: 40%;
    min-width: 0;
    flex-shrink: 0;
    flex-direction: column;
    background-color: rgb(19, 24, 35);
    border-width: 1px;
    border-color: rgb(45, 56, 78);
    border-radius: 10px;
    overflow: hidden;
    margin-right: 14px;
}

.sim2d-tabs {
    flex-direction: row;
    flex-shrink: 0;
    padding: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 56, 78);
}

.sim2d-tab {
    flex: 1;
    min-width: 0;
    height: 38px;
    background-color: rgb(24, 30, 44);
    border-width: 1px;
    border-color: rgb(49, 61, 84);
    border-radius: 6px;
    color: rgb(122, 138, 170);
    font-size: 17px;
    letter-spacing: 1px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    -unity-text-align: middle-center;
    margin-right: 6px;
    cursor: pointer;
}

.sim2d-tab:last-child {
    margin-right: 0;
}

.sim2d-tab--active {
    background-color: rgb(37, 35, 28);
    border-color: rgb(212, 160, 23);
    color: rgb(212, 160, 23);
}

.sim2d-roster-head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 42px;
    padding: 8px;
    background-color: rgb(24, 30, 44);
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 56, 78);
}

.sim2d-col-player {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 16px;
    color: rgb(180, 191, 210);
    letter-spacing: 1px;
    text-transform: uppercase;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.sim2d-col-stat {
    width: 52px;
    flex-shrink: 0;
    font-size: 18px;
    font-weight: 700;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.sim2d-team-list {
    flex: 1;
    flex-direction: column;
    overflow-y: auto;
    padding: 6px;
}

.sim2d-roster-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 66px;
    padding: 7px 8px;
    border-radius: 6px;
    margin-bottom: 4px;
}

.sim2d-roster-row--active {
    background-color: rgb(28, 38, 55);
}

.sim2d-roster-photo {
    width: 50px;
    height: 50px;
    border-radius: 25px;
    background-color: rgb(38, 47, 65);
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
    margin-right: 10px;
    border-width: 2px;
    border-color: rgb(100, 150, 245);
}

.sim2d-roster-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 22px;
    color: rgb(235, 239, 247);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

.sim2d-roster-pos {
    width: 30px;
    flex-shrink: 0;
    font-size: 22px;
    font-weight: 700;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-center;
    margin-right: 8px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.sim2d-roster-stat {
    width: 52px;
    flex-shrink: 0;
    font-size: 24px;
    color: rgb(235, 239, 247);
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.sim2d-court-wrap {
    flex: 1;
    flex-direction: column;
    min-width: 0;
    width: 60%;
}

.sim2d-court-top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    min-height: 28px;
    margin-bottom: 6px;
}

.sim2d-possession {
    font-size: 18px;
    color: rgb(100, 200, 140);
    letter-spacing: 1px;
    text-transform: uppercase;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.sim2d-venue {
    font-size: 18px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

.sim2d-court {
    position: relative;
    flex: 1;
    min-height: 0;
    background-color: rgb(91, 62, 38);
    border-width: 3px;
    border-color: rgb(211, 174, 112);
    border-radius: 8px;
    overflow: hidden;
}

.sim2d-court-line {
    position: absolute;
    background-color: rgb(226, 197, 145);
    opacity: 0.75;
}

.sim2d-center-line {
    left: 50%;
    top: 0;
    width: 2px;
    height: 100%;
}

.sim2d-court-circle {
    position: absolute;
    border-width: 2px;
    border-color: rgb(226, 197, 145);
    border-radius: 45px;
    opacity: 0.75;
}

.sim2d-center-circle {
    left: 50%;
    top: 50%;
    width: 90px;
    height: 90px;
    margin-left: -45px;
    margin-top: -45px;
}

.sim2d-paint {
    position: absolute;
    top: 28%;
    width: 17%;
    height: 44%;
    border-width: 2px;
    border-color: rgb(226, 197, 145);
    opacity: 0.75;
}

.sim2d-paint--left {
    left: 0;
}

.sim2d-paint--right {
    right: 0;
}

.sim2d-three {
    position: absolute;
    top: 18%;
    width: 22%;
    height: 64%;
    border-width: 2px;
    border-color: rgb(226, 197, 145);
    border-radius: 100px;
    opacity: 0.65;
}

.sim2d-three--left {
    left: -10%;
}

.sim2d-three--right {
    right: -10%;
}

.sim2d-hoop {
    position: absolute;
    top: 47%;
    width: 18px;
    height: 18px;
    border-width: 3px;
    border-color: rgb(240, 140, 60);
    border-radius: 9px;
    background-color: rgb(120, 45, 30);
}

.sim2d-hoop--left {
    left: 2%;
}

.sim2d-hoop--right {
    right: 2%;
}

.sim2d-player-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.sim2d-player {
    position: absolute;
    width: 140px;
    height: 72px;
    align-items: center;
    flex-direction: column;
    margin-left: -70px;
    margin-top: -36px;
}

.sim2d-player-photo {
    width: 46px;
    height: 46px;
    border-radius: 23px;
    background-color: rgb(38, 47, 65);
    background-size: cover;
    background-position: center;
    border-width: 3px;
    border-color: rgb(220, 226, 238);
    flex-shrink: 0;
}

.sim2d-player--home .sim2d-player-photo {
    border-color: rgb(100, 150, 245);
}

.sim2d-player--away .sim2d-player-photo {
    border-color: rgb(230, 120, 100);
}

.sim2d-player--pressure .sim2d-player-photo {
    border-color: rgb(212, 160, 23);
}

.sim2d-player--action .sim2d-player-photo {
    border-width: 4px;
    border-color: rgb(255, 206, 84);
}

.sim2d-player-plate {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    align-self: center;
    flex-shrink: 0;
    background-color: rgb(20, 24, 33);
    border-radius: 4px;
    padding: 1px 5px;
    margin-top: -2px;
    max-width: none;
}

.sim2d-player-number {
    font-size: 11px;
    color: rgb(212, 160, 23);
    margin-right: 3px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.sim2d-player-name {
    flex-shrink: 0;
    font-size: 11px;
    color: rgb(220, 226, 238);
    white-space: nowrap;
    overflow: visible;
    text-overflow: clip;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.sim2d-ball {
    position: absolute;
    width: 32px;
    height: 32px;
    border-radius: 0;
    background-color: transparent;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    border-width: 0;
    margin-left: -16px;
    margin-top: -16px;
}

.sim2d-footer {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    min-height: 72px;
    background-color: rgb(19, 24, 35);
    border-width: 1px;
    border-color: rgb(45, 56, 78);
    border-radius: 10px;
    padding: 10px 14px;
}

.sim2d-ticker {
    flex: 1;
    min-width: 0;
    align-self: stretch;
    flex-direction: row;
    align-items: center;
    padding: 0 12px;
}

.sim2d-ticker-icon {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    margin-right: 20px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.sim2d-ticker-text {
    flex-grow: 1;
    font-size: 22px;
    color: rgb(232, 236, 245);
    white-space: normal;
    -unity-text-align: middle-left;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
}

.sim2d-controls {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.sim2d-control-btn,
.sim2d-speed-btn,
.sim2d-skip {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    border-width: 2px;
    border-radius: 7px;
    font-size: 15px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    cursor: pointer;
}

.sim2d-control-btn {
    min-width: 86px;
    background-color: rgb(20, 24, 33);
    border-color: rgb(42, 51, 71);
    color: rgb(122, 138, 170);
    padding: 8px 12px;
    margin-right: 6px;
}

.sim2d-speed-btn {
    min-width: 48px;
    background-color: rgb(20, 24, 33);
    border-color: rgb(42, 51, 71);
    color: rgb(122, 138, 170);
    padding: 8px 10px;
    margin-right: 4px;
}

.sim2d-speed-btn:hover,
.sim2d-control-btn:hover {
    background-color: rgb(28, 33, 48);
    border-color: rgb(58, 74, 99);
    color: rgb(208, 216, 232);
}

.sim2d-speed-btn--active {
    background-color: rgb(37, 35, 28);
    border-color: rgb(212, 160, 23);
    color: rgb(212, 160, 23);
}

.sim2d-spacer {
    flex: 1;
    min-width: 10px;
}

.sim2d-skip {
    background-color: rgb(20, 36, 35);
    border-color: rgb(39, 174, 96);
    color: rgb(100, 200, 140);
    padding: 8px 16px;
    margin-left: 6px;
}

.sim2d-skip:hover {
    background-color: rgb(23, 59, 45);
    border-color: rgb(80, 210, 130);
    color: rgb(150, 220, 180);
}
