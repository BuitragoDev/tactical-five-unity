<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="MatchDay.uss" />

    <ui:VisualElement name="MatchDayRoot" class="matchday-root">

        <!-- MAIN -->
        <ui:VisualElement class="matchday-main">

            <!-- TOP HEADER -->
            <ui:VisualElement name="TopHeader" class="top-header">
                <ui:VisualElement class="header-left">
                    <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo" />
                    <ui:VisualElement class="header-team-info">
                        <ui:VisualElement class="header-team-name-row">
                            <ui:Label name="HeaderTeamName" class="header-team-name" text="" />
                            <ui:Label name="HeaderSubtitle" class="header-subtitle" text="(RESUMEN DE PARTIDO)" />
                        </ui:VisualElement>
                        <ui:Label name="HeaderManagerName" class="header-manager-name" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="header-right-group">
                    <ui:VisualElement class="header-season-info">
                        <ui:Label name="HeaderSeason" class="header-season-label" text="" />
                    </ui:VisualElement>
                    <ui:Label name="HeaderDate" class="header-date-label" text="" />
                    <ui:Label name="HeaderGameDay" class="header-game-day-label" text="" />
                    <ui:Button name="ConfigBtn" class="header-config-btn" text="⚙" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- SCORE / PREVIEW AREA -->
            <ui:VisualElement class="matchday-content">

                <ui:VisualElement class="matchday-score-row">
                    <ui:VisualElement class="matchday-team-block">
                        <ui:VisualElement name="HomeLogo" class="matchday-logo" />
                        <ui:Label name="HomeName" class="matchday-team-name" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement class="matchday-center-block">
                        <ui:Label name="ScoreText" class="matchday-score" text="" />
                        <ui:Label name="VenueLabel" class="matchday-venue" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement class="matchday-team-block">
                        <ui:VisualElement name="AwayLogo" class="matchday-logo" />
                        <ui:Label name="AwayName" class="matchday-team-name" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- MATCHDAY BOXSCORE / RESULT -->
                <ui:VisualElement class="matchday-boxscore-area">
                    <ui:VisualElement class="matchday-boxscore-col">
                        <ui:VisualElement class="matchday-boxscore-header">
                            <ui:VisualElement name="HomeBoxLogo" class="matchday-boxscore-logo" />
                            <ui:Label name="HomeBoxName" class="matchday-boxscore-name" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement name="HomeBoxBody" class="matchday-boxscore-body" />
                        <ui:VisualElement name="HomeBoxFooter" class="matchday-boxscore-footer" />
                    </ui:VisualElement>
                    <ui:VisualElement class="matchday-boxscore-col">
                        <ui:VisualElement class="matchday-boxscore-header">
                            <ui:VisualElement name="AwayBoxLogo" class="matchday-boxscore-logo" />
                            <ui:Label name="AwayBoxName" class="matchday-boxscore-name" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement name="AwayBoxBody" class="matchday-boxscore-body" />
                        <ui:VisualElement name="AwayBoxFooter" class="matchday-boxscore-footer" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- HOME MY TEAM BADGE -->
                <ui:Label name="HomeMyTeamBadge" class="matchday-myteam-badge" text="" style="display: none;" />
                <ui:Label name="AwayMyTeamBadge" class="matchday-myteam-badge matchday-myteam-badge--right" text="" style="display: none;" />

                <ui:Button name="BtnContinue" class="matchday-continue-btn" text="CONTINUAR ►" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- MATCHUP PREVIEW OVERLAY -->
        <ui:VisualElement name="MatchupPreviewOverlay" class="mpv-overlay" style="display: none;">

            <!-- TEAM HEADERS -->
            <ui:VisualElement class="mpv-headers">
                <!-- HOME HEADER -->
                <ui:VisualElement class="mpv-team-header">
                    <ui:VisualElement name="MPVHomeLogo" class="mpv-logo-lg" />
                    <ui:VisualElement class="mpv-team-info">
                        <ui:Label name="MPVHomeCity" class="mpv-city" text="" />
                        <ui:Label name="MPVHomeName" class="mpv-team-name" text="" />
                        <ui:Label name="MPVHomeRecord" class="mpv-record" text="" />
                        <ui:Label name="MPVHomeConf" class="mpv-conf" text="" />
                        <ui:VisualElement class="mpv-streak-row">
                            <ui:Label class="mpv-streak-label" text="ÚLTIMOS 10" />
                            <ui:VisualElement name="MPVHomeLast10" class="mpv-streak-dots" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- CENTER: DATE / ARENA / VS -->
                <ui:VisualElement class="mpv-center-info">
                    <ui:Label name="MPVDate" class="mpv-date" text="" />
                    <ui:Label name="MPVArena" class="mpv-arena" text="" />
                    <ui:Label name="MPVCity" class="mpv-city-label" text="" />
                    <ui:Label class="mpv-vs" text="VS" />
                </ui:VisualElement>

                <!-- AWAY HEADER -->
                <ui:VisualElement class="mpv-team-header mpv-team-header--right">
                    <ui:VisualElement class="mpv-team-info mpv-team-info--right">
                        <ui:Label name="MPVAwayCity" class="mpv-city" text="" />
                        <ui:Label name="MPVAwayName" class="mpv-team-name" text="" />
                        <ui:Label name="MPVAwayRecord" class="mpv-record" text="" />
                        <ui:Label name="MPVAwayConf" class="mpv-conf" text="" />
                        <ui:VisualElement class="mpv-streak-row mpv-streak-row--right">
                            <ui:Label class="mpv-streak-label" text="ÚLTIMOS 10" />
                            <ui:VisualElement name="MPVAwayLast10" class="mpv-streak-dots" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="MPVAwayLogo" class="mpv-logo-lg" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- FAVORITE BADGE -->
            <ui:Label name="MPVFavorite" class="mpv-favorite" text="" />

            <!-- STATS ROW -->
            <ui:VisualElement class="mpv-stats-row">
                <ui:VisualElement class="mpv-stats-team">
                    <ui:VisualElement class="mpv-stat-card">
                        <ui:Label class="mpv-stat-label" text="ATAQUE" />
                        <ui:Label name="MPVHomeOff" class="mpv-stat-val" text="" />
                        <ui:Label name="MPVHomeOffRank" class="mpv-stat-rank" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mpv-stat-card">
                        <ui:Label class="mpv-stat-label" text="DEFENSA" />
                        <ui:Label name="MPVHomeDef" class="mpv-stat-val" text="" />
                        <ui:Label name="MPVHomeDefRank" class="mpv-stat-rank" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mpv-stat-card">
                        <ui:Label class="mpv-stat-label" text="RITMO" />
                        <ui:Label name="MPVHomePace" class="mpv-stat-val" text="" />
                        <ui:Label name="MPVHomePaceRank" class="mpv-stat-rank" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mpv-stat-card">
                        <ui:Label class="mpv-stat-label" text="NET RATING" />
                        <ui:Label name="MPVHomeNet" class="mpv-stat-val mpv-stat-val--net" text="" />
                        <ui:Label name="MPVHomeNetRank" class="mpv-stat-rank" text="" />
                    </ui>
                </ui:VisualElement>

                <!-- CENTER: BAJAS -->
                <ui:VisualElement class="mpv-bajas">
                    <ui:Label class="mpv-bajas-title" text="BAJAS" />
                    <ui:VisualElement class="mpv-bajas-cols">
                        <ui:VisualElement class="mpv-bajas-col">
                            <ui:Label class="mpv-bajas-col-title" text="ATAQUE" />
                            <ui:VisualElement name="MPVHomeBajas" class="mpv-bajas-list" />
                        </ui:VisualElement>
                        <ui:VisualElement class="mpv-bajas-col">
                            <ui:Label class="mpv-bajas-col-title" text="DEFENSA" />
                            <ui:VisualElement name="MPVAwayBajas" class="mpv-bajas-list" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="mpv-stats-team mpv-stats-team--right">
                    <ui:VisualElement class="mpv-stat-card">
                        <ui:Label class="mpv-stat-label" text="ATAQUE" />
                        <ui:Label name="MPVAwayOff" class="mpv-stat-val" text="" />
                        <ui:Label name="MPVAwayOffRank" class="mpv-stat-rank" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mpv-stat-card">
                        <ui:Label class="mpv-stat-label" text="DEFENSA" />
                        <ui:Label name="MPVAwayDef" class="mpv-stat-val" text="" />
                        <ui:Label name="MPVAwayDefRank" class="mpv-stat-rank" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mpv-stat-card">
                        <ui:Label class="mpv-stat-label" text="RITMO" />
                        <ui:Label name="MPVAwayPace" class="mpv-stat-val" text="" />
                        <ui:Label name="MPVAwayPaceRank" class="mpv-stat-rank" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mpv-stat-card">
                        <ui:Label class="mpv-stat-label" text="NET RATING" />
                        <ui:Label name="MPVAwayNet" class="mpv-stat-val mpv-stat-val--net" text="" />
                        <ui:Label name="MPVAwayNetRank" class="mpv-stat-rank" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- QUINTETO + KEY PLAYERS + BANQUILLO ROW -->
            <ui:VisualElement class="mpv-bottom-row">
                <!-- HOME ROSTER -->
                <ui:VisualElement class="mpv-roster-col">
                    <ui:Label class="mpv-roster-title" text="QUINTETO PROBABLE" />
                    <ui:VisualElement name="MPVHomeStarters" class="mpv-starter-row" />
                    <ui:Label class="mpv-roster-title" text="BANQUILLO" />
                    <ui:VisualElement name="MPVHomeBench" class="mpv-bench-list" />
                </ui:VisualElement>

                <!-- KEY PLAYERS -->
                <ui:VisualElement class="mpv-key-players">
                    <ui:Label class="mpv-key-title" text="JUGADORES CLAVE" />
                    <ui:VisualElement name="MPVKeyRow1" class="mpv-key-row" />
                    <ui:VisualElement name="MPVKeyRow2" class="mpv-key-row" />
                    <ui:VisualElement name="MPVKeyRow3" class="mpv-key-row" />
                    <ui:VisualElement name="MPVKeyRow4" class="mpv-key-row" />
                </ui:VisualElement>

                <!-- AWAY ROSTER -->
                <ui:VisualElement class="mpv-roster-col mpv-roster-col--right">
                    <ui:Label class="mpv-roster-title" text="QUINTETO PROBABLE" />
                    <ui:VisualElement name="MPVAwayStarters" class="mpv-starter-row" />
                    <ui:Label class="mpv-roster-title" text="BANQUILLO" />
                    <ui:VisualElement name="MPVAwayBench" class="mpv-bench-list" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- BUTTON -->
            <ui:Button name="BtnStartGame" class="mpv-start-btn" text="IR AL PARTIDO ►" />
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
