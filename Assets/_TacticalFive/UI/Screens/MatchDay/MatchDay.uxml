<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="MatchDay.uss" />

    <ui:VisualElement name="MatchDayRoot" class="matchday-root">

        <!-- MAIN -->
        <ui:VisualElement class="matchday-main">

            <!-- TOP HEADER -->
            <ui:VisualElement name="TopHeader" class="top-header">
                <ui:VisualElement class="header-left">
                    <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo" />
                    <ui:VisualElement class="header-team-info">
                        <ui:VisualElement class="header-team-name-row">
                            <ui:Label name="HeaderTeamName" class="header-team-name" text="" />
                            <ui:Label name="HeaderSubtitle" class="header-subtitle" text="(RESUMEN DE PARTIDO)" />
                        </ui:VisualElement>
                        <ui:Label name="HeaderManagerName" class="header-manager-name" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="header-right-group">
                    <ui:VisualElement class="header-season-info">
                        <ui:Label name="HeaderSeason" class="header-season-label" text="" />
                    </ui:VisualElement>
                    <ui:Label name="HeaderDate" class="header-date-label" text="" />
                    <ui:Label name="HeaderGameDay" class="header-game-day-label" text="" />
                    <ui:Button name="BtnContinue" class="btn-action" text="CONTINUAR" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- CONTENT -->
            <ui:ScrollView class="matchday-scroll"
                           horizontal-scrolling-enabled="false"
                           mode="Vertical">
                <ui:VisualElement class="matchday-content">

                    <!-- Match Banner -->
                    <ui:VisualElement name="MatchBanner" class="match-banner">
                        <ui:VisualElement class="match-teams">
                            <ui:VisualElement name="HomeTeamBlock" class="match-team">
                                <ui:VisualElement name="HomeLogo" class="match-team-logo" />
                                <ui:Label name="HomeName" class="match-team-name" text="" />
                                <ui:Label name="HomeMyTeamBadge" class="my-team-badge" text="MI EQUIPO" style="display: none;" />
                            </ui:VisualElement>
                            <ui:VisualElement class="match-score">
                                <ui:Label name="HomeScore" class="score-home" text="" />
                                <ui:Label class="score-sep" text="-" />
                                <ui:Label name="AwayScore" class="score-away" text="" />
                            </ui:VisualElement>
                            <ui:VisualElement name="AwayTeamBlock" class="match-team">
                                <ui:VisualElement name="AwayLogo" class="match-team-logo" />
                                <ui:Label name="AwayName" class="match-team-name" text="" />
                                <ui:Label name="AwayMyTeamBadge" class="my-team-badge" text="MI EQUIPO" style="display: none;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="match-venue">
                            <ui:Label name="VenueLabel" class="match-venue-label" text="" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Box Scores -->
                    <ui:VisualElement class="box-scores">
                        <ui:VisualElement name="HomeBoxScore" class="box-score-panel" style="margin-right: 20px;">
                            <ui:VisualElement class="box-score-header">
                                <ui:VisualElement name="HomeBoxLogo" class="box-logo" />
                                <ui:Label name="HomeBoxName" class="box-team-name" text="" />
                            </ui:VisualElement>
                            <ui:VisualElement class="box-table-wrapper">
                                <ui:VisualElement class="box-table-header">
                                    <ui:Label class="col-player col-stat--header" text="Jugador" />
                                    <ui:Label class="col-min col-stat--header" text="MIN" />
                                    <ui:Label class="col-pts col-stat--header" text="PTS" />
                                    <ui:Label class="col-fg col-stat--header" text="TC" />
                                    <ui:Label class="col-3p col-stat--header" text="3P" />
                                    <ui:Label class="col-ft col-stat--header" text="TL" />
                                    <ui:Label class="col-reb col-stat--header" text="REB" />
                                    <ui:Label class="col-ast col-stat--header" text="AST" />
                                    <ui:Label class="col-stl col-stat--header" text="ROB" />
                                    <ui:Label class="col-blk col-stat--header" text="TAP" />
                                    <ui:Label class="col-to col-stat--header" text="PER" />
                                    <ui:Label class="col-pf col-stat--header" text="FP" />
                                    <ui:Label class="col-val col-stat--header" text="VAL" />
                                </ui:VisualElement>
                                <ui:VisualElement name="HomeBoxBody" class="box-table-body" />
                                <ui:VisualElement name="HomeBoxFooter" class="box-table-footer" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="AwayBoxScore" class="box-score-panel">
                            <ui:VisualElement class="box-score-header">
                                <ui:VisualElement name="AwayBoxLogo" class="box-logo" />
                                <ui:Label name="AwayBoxName" class="box-team-name" text="" />
                            </ui:VisualElement>
                            <ui:VisualElement class="box-table-wrapper">
                                <ui:VisualElement class="box-table-header">
                                    <ui:Label class="col-player col-stat--header" text="Jugador" />
                                    <ui:Label class="col-min col-stat--header" text="MIN" />
                                    <ui:Label class="col-pts col-stat--header" text="PTS" />
                                    <ui:Label class="col-fg col-stat--header" text="TC" />
                                    <ui:Label class="col-3p col-stat--header" text="3P" />
                                    <ui:Label class="col-ft col-stat--header" text="TL" />
                                    <ui:Label class="col-reb col-stat--header" text="REB" />
                                    <ui:Label class="col-ast col-stat--header" text="AST" />
                                    <ui:Label class="col-stl col-stat--header" text="ROB" />
                                    <ui:Label class="col-blk col-stat--header" text="TAP" />
                                    <ui:Label class="col-to col-stat--header" text="PER" />
                                    <ui:Label class="col-pf col-stat--header" text="FP" />
                                    <ui:Label class="col-val col-stat--header" text="VAL" />
                                </ui:VisualElement>
                                <ui:VisualElement name="AwayBoxBody" class="box-table-body" />
                                <ui:VisualElement name="AwayBoxFooter" class="box-table-footer" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:ScrollView>

        </ui:VisualElement>

        <!-- PLAY-BY-PLAY OVERLAY -->
        <ui:VisualElement name="PlayByPlayOverlay" class="pbp-overlay" style="display: none;">
            <ui:VisualElement class="pbp-header">
                <ui:VisualElement class="pbp-team-side pbp-team-side--home">
                    <ui:Label name="PbpHomeName" class="pbp-team" text="" />
                    <ui:VisualElement name="PbpHomeLogo" class="pbp-team-logo" />
                </ui:VisualElement>
                <ui:Label name="PbpScore" class="pbp-score" text="0 - 0" />
                <ui:VisualElement class="pbp-team-side pbp-team-side--away">
                    <ui:VisualElement name="PbpAwayLogo" class="pbp-team-logo" />
                    <ui:Label name="PbpAwayName" class="pbp-team" text="" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="pbp-meta-row">
                <ui:Label name="PbpQuarter" class="pbp-quarter" text="" />
                <ui:Label name="PbpClock" class="pbp-clock" text="12:00" />
            </ui:VisualElement>
            <ui:VisualElement class="pbp-progress">
                <ui:VisualElement name="PbpProgressFill" class="pbp-progress-fill" />
                <ui:Label name="PbpProgressLabel" class="pbp-progress-label" text="0%" />
            </ui:VisualElement>
            <ui:Label name="PbpText" class="pbp-text" text="" />
            <ui:VisualElement name="PbpBoxes" class="pbp-boxes">
                <ui:VisualElement name="PbpHomeBox" class="pbp-box-panel" />
                <ui:VisualElement name="PbpAwayBox" class="pbp-box-panel" />
            </ui:VisualElement>
            <ui:VisualElement class="pbp-controls">
                <ui:Button name="PbpBtnSpeed1" class="pbp-speed-btn" text="x1" />
                <ui:Button name="PbpBtnSpeed3" class="pbp-speed-btn" text="x3" />
                <ui:Button name="PbpBtnSpeed5" class="pbp-speed-btn pbp-speed-btn--active" text="x5" />
                <ui:Button name="PbpBtnSpeed10" class="pbp-speed-btn" text="x10" />
                <ui:VisualElement class="pbp-spacer" />
                <ui:Button name="PbpSkip" class="pbp-skip" text="SALTAR ►" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- MATCHUP PREVIEW OVERLAY -->
        <ui:VisualElement name="MatchupPreviewOverlay" class="matchup-preview-overlay" style="display: none;">
            <ui:VisualElement class="matchup-preview-header">
                <ui:Label class="matchup-preview-title" text="PRONÓSTICO DEL PARTIDO" />
                <ui:Label name="PreviewFavorite" class="matchup-preview-favorite" text="" />
            </ui:VisualElement>

            <ui:VisualElement class="matchup-preview-teams">
                <ui:VisualElement name="PreviewHomeBlock" class="matchup-preview-team">
                    <ui:VisualElement name="PreviewHomeLogo" class="matchup-preview-logo" />
                    <ui:Label name="PreviewHomeName" class="matchup-preview-team-name" text="" />
                    <ui:Label name="PreviewHomeProb" class="matchup-preview-prob" text="" />
                </ui:VisualElement>
                <ui:Label class="matchup-preview-vs" text="VS" />
                <ui:VisualElement name="PreviewAwayBlock" class="matchup-preview-team">
                    <ui:VisualElement name="PreviewAwayLogo" class="matchup-preview-logo" />
                    <ui:Label name="PreviewAwayName" class="matchup-preview-team-name" text="" />
                    <ui:Label name="PreviewAwayProb" class="matchup-preview-prob" text="" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="matchup-preview-rosters">
                <ui:VisualElement class="matchup-preview-roster-col">
                    <ui:Label class="matchup-preview-roster-title" text="QUINTETO" />
                    <ui:VisualElement name="PreviewHomeStarters" class="matchup-preview-starter-row" />
                    <ui:Label class="matchup-preview-roster-title" text="BANQUILLO" />
                    <ui:VisualElement name="PreviewHomeBench" class="matchup-preview-bench-list" />
                </ui:VisualElement>
                <ui:VisualElement class="matchup-preview-roster-col">
                    <ui:Label class="matchup-preview-roster-title" text="QUINTETO" />
                    <ui:VisualElement name="PreviewAwayStarters" class="matchup-preview-starter-row" />
                    <ui:Label class="matchup-preview-roster-title" text="BANQUILLO" />
                    <ui:VisualElement name="PreviewAwayBench" class="matchup-preview-bench-list" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Button name="BtnStartGame" class="matchup-preview-btn" text="IR AL PARTIDO ►" />
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
