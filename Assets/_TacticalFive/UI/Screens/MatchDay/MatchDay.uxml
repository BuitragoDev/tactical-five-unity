<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="MatchDay.uss" />

    <ui:VisualElement name="MatchDayRoot" class="matchday-root">

        <!-- MAIN -->
        <ui:VisualElement class="matchday-main">

            <!-- TOP HEADER -->
            <ui:VisualElement name="TopHeader" class="top-header">
                <ui:VisualElement class="header-left">
                    <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo" />
                    <ui:VisualElement class="header-team-info">
                        <ui:VisualElement class="header-team-name-row">
                            <ui:Label name="HeaderTeamName" class="header-team-name" text="" />
                            <ui:Label name="HeaderSubtitle" class="header-subtitle" text="{loc:ui.match_day.header_subtitle}" />
                        </ui:VisualElement>
                        <ui:Label name="HeaderManagerName" class="header-manager-name" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="header-right-group">
                    <ui:VisualElement class="header-season-info">
                        <ui:Label name="HeaderSeason" class="header-season-label" text="" />
                    </ui:VisualElement>
                    <ui:Label name="HeaderDate" class="header-date-label" text="" />
                    <ui:Label name="HeaderGameDay" class="header-game-day-label" text="" />
                    <ui:Button name="BtnContinue" class="btn-action" text="{loc:ui.match_day.btn_continue}" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- CONTENT -->
            <ui:ScrollView class="matchday-scroll"
                           horizontal-scrolling-enabled="false"
                           mode="Vertical">
                <ui:VisualElement class="matchday-content">

                    <!-- Match Banner -->
                    <ui:VisualElement name="MatchBanner" class="match-banner">
                        <ui:VisualElement class="match-teams">
                            <ui:VisualElement name="HomeTeamBlock" class="match-team">
                                <ui:VisualElement name="HomeLogo" class="match-team-logo" />
                                <ui:Label name="HomeName" class="match-team-name" text="" />
                                <ui:Label name="HomeMyTeamBadge" class="my-team-badge" text="{loc:ui.match_day.home_my_team_badge}" style="display: none;" />
                            </ui:VisualElement>
                            <ui:VisualElement class="match-score">
                                <ui:Label name="HomeScore" class="score-home" text="" />
                                <ui:Label class="score-sep" text="-" />
                                <ui:Label name="AwayScore" class="score-away" text="" />
                            </ui:VisualElement>
                            <ui:VisualElement name="AwayTeamBlock" class="match-team">
                                <ui:VisualElement name="AwayLogo" class="match-team-logo" />
                                <ui:Label name="AwayName" class="match-team-name" text="" />
                                <ui:Label name="AwayMyTeamBadge" class="my-team-badge" text="{loc:ui.match_day.away_my_team_badge}" style="display: none;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="match-venue">
                            <ui:Label name="VenueLabel" class="match-venue-label" text="" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Box Scores -->
                    <ui:VisualElement class="box-scores">
                        <ui:VisualElement name="HomeBoxScore" class="box-score-panel" style="margin-right: 20px;">
                            <ui:VisualElement class="box-score-header">
                                <ui:VisualElement name="HomeBoxLogo" class="box-logo" />
                                <ui:Label name="HomeBoxName" class="box-team-name" text="" />
                            </ui:VisualElement>
                            <ui:VisualElement class="box-table-wrapper">
                                <ui:VisualElement class="box-table-header">
                                    <ui:Label class="col-player col-stat--header" text="{loc:ui.match_day.jugador}" />
                                    <ui:Label class="col-min col-stat--header" text="{loc:ui.match_day.min}" />
                                    <ui:Label class="col-pts col-stat--header" text="{loc:ui.match_day.pts}" />
                                    <ui:Label class="col-fg col-stat--header" text="{loc:ui.match_day.tc}" />
                                    <ui:Label class="col-3p col-stat--header" text="{loc:ui.match_day.3_p}" />
                                    <ui:Label class="col-ft col-stat--header" text="{loc:ui.match_day.tl}" />
                                    <ui:Label class="col-reb col-stat--header" text="{loc:ui.match_day.reb}" />
                                    <ui:Label class="col-ast col-stat--header" text="{loc:ui.match_day.ast}" />
                                    <ui:Label class="col-stl col-stat--header" text="{loc:ui.match_day.rob}" />
                                    <ui:Label class="col-blk col-stat--header" text="{loc:ui.match_day.tap}" />
                                    <ui:Label class="col-to col-stat--header" text="{loc:ui.match_day.to}" />
                                    <ui:Label class="col-pf col-stat--header" text="{loc:ui.match_day.fp}" />
                                    <ui:Label class="col-val col-stat--header" text="{loc:ui.match_day.val}" />
                                </ui:VisualElement>
                                <ui:VisualElement name="HomeBoxBody" class="box-table-body" />
                                <ui:VisualElement name="HomeBoxFooter" class="box-table-footer" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="AwayBoxScore" class="box-score-panel">
                            <ui:VisualElement class="box-score-header">
                                <ui:VisualElement name="AwayBoxLogo" class="box-logo" />
                                <ui:Label name="AwayBoxName" class="box-team-name" text="" />
                            </ui:VisualElement>
                            <ui:VisualElement class="box-table-wrapper">
                                <ui:VisualElement class="box-table-header">
                                    <ui:Label class="col-player col-stat--header" text="{loc:ui.match_day.jugador}" />
                                    <ui:Label class="col-min col-stat--header" text="{loc:ui.match_day.min}" />
                                    <ui:Label class="col-pts col-stat--header" text="{loc:ui.match_day.pts}" />
                                    <ui:Label class="col-fg col-stat--header" text="{loc:ui.match_day.tc}" />
                                    <ui:Label class="col-3p col-stat--header" text="{loc:ui.match_day.3_p}" />
                                    <ui:Label class="col-ft col-stat--header" text="{loc:ui.match_day.tl}" />
                                    <ui:Label class="col-reb col-stat--header" text="{loc:ui.match_day.reb}" />
                                    <ui:Label class="col-ast col-stat--header" text="{loc:ui.match_day.ast}" />
                                    <ui:Label class="col-stl col-stat--header" text="{loc:ui.match_day.rob}" />
                                    <ui:Label class="col-blk col-stat--header" text="{loc:ui.match_day.tap}" />
                                    <ui:Label class="col-to col-stat--header" text="{loc:ui.match_day.to}" />
                                    <ui:Label class="col-pf col-stat--header" text="{loc:ui.match_day.fp}" />
                                    <ui:Label class="col-val col-stat--header" text="{loc:ui.match_day.val}" />
                                </ui:VisualElement>
                                <ui:VisualElement name="AwayBoxBody" class="box-table-body" />
                                <ui:VisualElement name="AwayBoxFooter" class="box-table-footer" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:ScrollView>

        </ui:VisualElement>

        <!-- SIMULACIÓN VISUAL 2D -->
        <ui:VisualElement name="SimVisualOverlay" class="sim2d-overlay" style="display: none;">
            <ui:VisualElement class="sim2d-header">
                <ui:VisualElement class="sim2d-team sim2d-team--home">
                    <ui:VisualElement name="Sim2DHomeLogo" class="sim2d-team-logo" />
                    <ui:VisualElement class="sim2d-team-copy sim2d-team-copy--home">
                        <ui:Label name="Sim2DHomeAbbr" class="sim2d-team-abbr" text="" />
                        <ui:Label name="Sim2DHomeName" class="sim2d-team-name" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="sim2d-scoreboard">
                    <ui:Label name="Sim2DScore" class="sim2d-score" text="0 - 0" />
                    <ui:VisualElement class="sim2d-clock-row">
                        <ui:Label name="Sim2DQuarter" class="sim2d-quarter" text="" />
                        <ui:Label name="Sim2DClock" class="sim2d-clock" text="12:00" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="sim2d-team sim2d-team--away">
                    <ui:VisualElement class="sim2d-team-copy sim2d-team-copy--away">
                        <ui:Label name="Sim2DAwayAbbr" class="sim2d-team-abbr" text="" />
                        <ui:Label name="Sim2DAwayName" class="sim2d-team-name" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement name="Sim2DAwayLogo" class="sim2d-team-logo" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="sim2d-body">
                <ui:VisualElement class="sim2d-side">
                    <ui:VisualElement class="sim2d-tabs">
                        <ui:Button name="Sim2DHomeTab" class="sim2d-tab" text="" />
                        <ui:Button name="Sim2DAwayTab" class="sim2d-tab" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement class="sim2d-roster-head">
                        <ui:Label name="Sim2DHeaderPlayer" class="sim2d-col-player" text="{loc:ui.match_day.jugador}" />
                        <ui:Label name="Sim2DHeaderPts" class="sim2d-col-stat" text="{loc:ui.match_day.pts}" />
                        <ui:Label name="Sim2DHeaderReb" class="sim2d-col-stat" text="{loc:ui.match_day.reb}" />
                        <ui:Label name="Sim2DHeaderAsi" class="sim2d-col-stat" text="{loc:ui.match_day.asi}" />
                    </ui:VisualElement>
                    <ui:VisualElement name="Sim2DTeamList" class="sim2d-team-list" />
                </ui:VisualElement>

                <ui:VisualElement class="sim2d-court-wrap">
                    <ui:VisualElement class="sim2d-court-top">
                        <ui:Label name="Sim2DPossession" class="sim2d-possession" text="" />
                        <ui:Label name="Sim2DVenue" class="sim2d-venue" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement name="Sim2DCourt" class="sim2d-court">
                        <ui:VisualElement name="Sim2DHomeLayer" class="sim2d-player-layer" />
                        <ui:VisualElement name="Sim2DAwayLayer" class="sim2d-player-layer" />
                        <ui:VisualElement name="Sim2DBall" class="sim2d-ball" />
                    </ui:VisualElement>
                    <ui:VisualElement class="sim2d-hoop-owners">
                        <ui:VisualElement class="sim2d-hoop-owner sim2d-hoop-owner--left">
                            <ui:VisualElement name="Sim2DLeftHoopLogo" class="sim2d-hoop-logo" />
                            <ui:VisualElement name="Sim2DLeftAttackArrow" class="sim2d-hoop-arrow" />
                        </ui:VisualElement>
                        <ui:VisualElement class="sim2d-hoop-owner sim2d-hoop-owner--right">
                            <ui:VisualElement name="Sim2DRightAttackArrow" class="sim2d-hoop-arrow" />
                            <ui:VisualElement name="Sim2DRightHoopLogo" class="sim2d-hoop-logo" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="sim2d-footer">
                <ui:VisualElement class="sim2d-ticker">
                    <ui:VisualElement name="Sim2DTickerIcon" class="sim2d-ticker-icon" />
                    <ui:Label name="Sim2DTickerText" class="sim2d-ticker-text" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="sim2d-controls">
                    <ui:Button name="Sim2DPause" class="sim2d-control-btn" text="" />
                    <ui:Button name="Sim2DSpeed1" class="sim2d-speed-btn sim2d-speed-btn--active" text="{loc:ui.match_day.pbp_btn_speed1}" />
                    <ui:Button name="Sim2DSpeed5" class="sim2d-speed-btn" text="{loc:ui.match_day.pbp_btn_speed5}" />
                    <ui:Button name="Sim2DSpeed10" class="sim2d-speed-btn" text="{loc:ui.match_day.pbp_btn_speed10}" />
                    <ui:Button name="Sim2DSpeed20" class="sim2d-speed-btn" text="{loc:ui.match_day.pbp_btn_speed20}" />
                    <ui:VisualElement class="sim2d-spacer" />
                    <ui:Button name="Sim2DSkip" class="sim2d-skip" text="{loc:ui.code.match_day_controller.saltar}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- PLAY-BY-PLAY OVERLAY -->
        <ui:VisualElement name="PlayByPlayOverlay" class="pbp-overlay" style="display: none;">
            <ui:VisualElement class="pbp-header">
                <ui:VisualElement class="pbp-team-side pbp-team-side--home">
                    <ui:Label name="PbpHomeName" class="pbp-team" text="" />
                    <ui:VisualElement name="PbpHomeLogo" class="pbp-team-logo" />
                </ui:VisualElement>
                <ui:Label name="PbpScore" class="pbp-score" text="0 - 0" />
                <ui:VisualElement class="pbp-team-side pbp-team-side--away">
                    <ui:VisualElement name="PbpAwayLogo" class="pbp-team-logo" />
                    <ui:Label name="PbpAwayName" class="pbp-team" text="" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="pbp-meta-row">
                <ui:Label name="PbpQuarter" class="pbp-quarter" text="" />
                <ui:Label name="PbpClock" class="pbp-clock" text="12:00" />
            </ui:VisualElement>
            <ui:VisualElement class="pbp-progress">
                <ui:VisualElement name="PbpProgressFill" class="pbp-progress-fill" />
                <ui:Label name="PbpProgressLabel" class="pbp-progress-label" text="0%" />
            </ui:VisualElement>
            <ui:Label name="PbpText" class="pbp-text" text="" />
            <ui:VisualElement name="PbpBoxes" class="pbp-boxes">
                <ui:VisualElement name="PbpHomeBox" class="pbp-box-panel" />
                <ui:VisualElement name="PbpAwayBox" class="pbp-box-panel" />
            </ui:VisualElement>
            <ui:VisualElement class="pbp-controls">
                <ui:Button name="PbpBtnSpeed1" class="pbp-speed-btn" text="{loc:ui.match_day.pbp_btn_speed1}" />
                <ui:Button name="PbpBtnSpeed3" class="pbp-speed-btn" text="{loc:ui.match_day.pbp_btn_speed3}" />
                <ui:Button name="PbpBtnSpeed5" class="pbp-speed-btn pbp-speed-btn--active" text="{loc:ui.match_day.pbp_btn_speed5}" />
                <ui:Button name="PbpBtnSpeed10" class="pbp-speed-btn" text="{loc:ui.match_day.pbp_btn_speed10}" />
                <ui:VisualElement class="pbp-spacer" />
                <ui:Button name="PbpSkip" class="pbp-skip" text="{loc:ui.match_day.pbp_skip}" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
