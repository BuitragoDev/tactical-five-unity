/* ══════════════════════════════════════════
   STATS — Stats.uss
   Cargado DESPUÉS de Dashboard.uss para prevalecer
   ══════════════════════════════════════════ */

.stats-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.stats-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

/* ── SCREEN HEADER ── */
.stats-screen-header.panel--gold {
    flex-shrink: 0;
    padding: 0;
    margin: 16px 20px 12px 20px;
    border-color: rgb(212, 160, 23);
    border-width: 1px;
    background-color: rgba(120, 95, 30, 0.15);
    border-radius: 4px;
    overflow: hidden;
}
.stats-screen-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    background-color: rgba(120, 95, 30, 0.15);
}
.stats-screen-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.stats-screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    white-space: normal;
}
.stats-screen-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(212, 160, 23);
    padding: 0 14px;
    background-color: rgba(120, 95, 30, 0.15);
}

.stats-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 20px 24px;
    min-height: 0;
}

/* ══ STAT TYPE TABS ══ */

.stats-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 12px;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
}

.stats-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 16px;
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: transparent;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-right: 2px;
}

.stats-tab:hover {
    color: rgb(208, 216, 232);
}

.stats-tab--active {
    color: rgb(212, 160, 23);
    border-bottom-color: rgb(212, 160, 23);
}

/* ══ FILTER ROW ══ */

.filter-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    flex-shrink: 0;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
}

.filter-group {
    flex-direction: row;
    align-items: center;
}

.filter-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 8px 16px;
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: transparent;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-right: 2px;
}

.filter-btn:hover {
    color: rgb(208, 216, 232);
}

.filter-btn--active {
    color: rgb(212, 160, 23);
    border-bottom-color: rgb(212, 160, 23);
}

.mode-btn--active {
    color: rgb(212, 160, 23);
    border-bottom-color: rgb(212, 160, 23);
}

/* ══ STATS PANEL ══ */

.stats-panel {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    overflow: hidden;
}

.stats-panel-header {
    flex-direction: row;
    align-items: center;
    padding: 18px 24px;
    background-color: rgb(17, 24, 34);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

.stats-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    letter-spacing: 2px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.stats-table-wrapper {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}

/* ══ FIXED TABLE HEADER ══ */

.stats-header-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 24px;
    background-color: rgb(17, 24, 34);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

/* ══ SCROLLABLE BODY ══ */

.stats-scroll {
    flex-grow: 1;
    min-height: 0;
}

.stats-scroll .unity-scroll-view__content-viewport {
    overflow: hidden;
}

.stats-scroll .unity-scroll-view__content-container {
    flex-grow: 1;
}

.stats-table {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    flex-shrink: 0;
}

/* ══ CUSTOM SCROLLBAR (gold) ══ */

.stats-scroll-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.stats-viewport {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    position: relative;
}

.stats-scrollbar {
    width: 12px;
    min-width: 12px;
    flex-shrink: 0;
    align-self: stretch;
    margin-left: 4px;
    background-color: rgba(25, 18, 8, 0.92);
    border-left-width: 1px;
    border-left-color: rgba(120, 95, 30, 0.35);
    position: relative;
}

.stats-scrollbar-thumb {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 0;
    height: 40px;
    background-color: rgb(160, 128, 30);
    border-radius: 3px;
}
.stats-scrollbar:hover .stats-scrollbar-thumb {
    background-color: rgb(212, 160, 23);
}

/* ══ TABLE ROWS ══ */

.stats-row {
    flex-direction: row;
    align-items: center;
    padding: 15px 24px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    min-height: 58px;
}

.stats-row--my-team {
    background-color: rgb(20, 28, 48);
}

/* ══ COLUMN STYLES — BASE Regular, bold solo con .col-stat--bold ══ */

.col-rank {
    width: 50px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
}

.col-rank Label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

.col-player-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    width: 300px;
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    flex-shrink: 0;
}

.col-team-abbrev {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    width: 100px;
    font-size: 18px;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.col-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    width: 60px;
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.col-stat {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    width: 140px;
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

/* Bold aplicado dinámicamente por JS */
.col-stat--bold {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.stats-header-row .col-stat--header {
    color: rgb(85, 102, 119);
    font-size: 18px;
    letter-spacing: 1px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
}

.stats-header-row .col-stat--header.col-stat--bold {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.col-stat--leader {
    color: rgb(212, 160, 23);
    font-size: 22px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.col-rank .rank-badge-top {
    background-color: rgb(212, 160, 23);
    color: rgb(15, 17, 23);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 16px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.stats-empty {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
}

.stats-empty-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
    white-space: normal;
}
