/* ══════════════════════════════════════════
   SEASON SUMMARY — SeasonSummary.uss
   ══════════════════════════════════════════ */

/* ── ROOT ── */
.ss-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ── HEADER ── */
.ss-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 12px 28px;
    background-color: rgb(22, 26, 36);
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 160, 23);
    flex-shrink: 0;
    min-height: 80px;
}

.ss-header-left {
    flex-direction: row;
    align-items: center;
}

.ss-header-logo {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    margin-right: 16px;
}

.ss-header-info {
    flex-direction: column;
}

.ss-header-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
}

.ss-header-manager {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
}

.ss-header-right {
    flex-direction: row;
    align-items: center;
}

.ss-header-season {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    letter-spacing: 1px;
    margin-right: 16px;
}

.ss-header-date {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    padding: 0 16px;
    margin-right: 20px;
    border-left-width: 1px;
    border-left-color: rgb(42, 51, 71);
    border-right-width: 1px;
    border-right-color: rgb(42, 51, 71);
}

.ss-btn-awards {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 250px;
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 22px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 18px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.ss-btn-awards:hover {
    background-color: rgb(74, 128, 240);
}

/* ── CONTENT ── */
.ss-content {
    flex-grow: 1;
    flex-direction: column;
    padding: 20px 28px;
    overflow-y: auto;
}

/* ── TOP ROW ── */
.ss-top-row {
    flex-direction: row;
    align-items: stretch;
    margin-bottom: 20px;
}

/* ── SEASON INTRO ── */
.ss-season-intro {
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 24px 20px;
    margin-right: 16px;
    width: 280px;
    flex-shrink: 0;
}

.ss-intro-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    letter-spacing: 2px;
    -unity-text-transform: upper;
    margin-bottom: 12px;
}

.ss-intro-year {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 64px;
    color: rgb(255, 255, 255);
    letter-spacing: 2px;
    margin-bottom: 16px;
}

.ss-intro-desc {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    line-height: 1.4;
}

/* ── CHAMPION CARDS ── */
.ss-champ-card {
    flex-direction: column;
    flex-grow: 1;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px 20px;
    margin-right: 16px;
    position: relative;
    overflow: hidden;
}
.ss-champ-card:last-child {
    margin-right: 0;
}

.ss-champ-card--nba {
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/Backgrounds/banner_campeones1.jpeg");
    background-size: cover;
    background-position: center;
}

.ss-champ-card--gl {
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/Backgrounds/banner_campeones2.jpeg");
    background-size: cover;
    background-position: center;
}

.ss-champ-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(22, 26, 36, 0.82);
}

.ss-champ-badge {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 4px 12px;
    align-self: flex-start;
    margin-bottom: 8px;
}
.ss-champ-badge--nba {
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
}
.ss-champ-badge--gl {
    background-color: rgb(0, 188, 180);
    color: rgb(0, 0, 0);
}

.ss-champ-content {
    flex-direction: row;
    align-items: flex-end;
    flex-grow: 1;
}

.ss-champ-text-col {
    flex-direction: column;
    flex-grow: 1;
}

.ss-champ-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    letter-spacing: 2px;
    -unity-text-transform: upper;
    margin-bottom: 4px;
}

.ss-champ-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
    margin-bottom: 12px;
}

.ss-champ-logo-row {
    flex-direction: row;
    align-items: center;
}

.ss-champ-logo {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    margin-right: 10px;
}

.ss-champ-logo-large {
    width: 100px;
    height: 100px;
    flex-shrink: 0;
    margin-top: 12px;
    background-size: contain;
    background-position: center;
    align-self: flex-start;
}

.ss-champ-titles {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
}

/* ── MVP ROW ── */
.ss-mvp-row {
    flex-direction: row;
    margin-bottom: 20px;
}

.ss-mvp-card {
    flex-direction: column;
    flex-grow: 1;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    margin-right: 16px;
}
.ss-mvp-card:last-child {
    margin-right: 0;
}

.ss-mvp-card--gl {
    border-color: rgb(0, 188, 180);
}

.ss-mvp-header {
    flex-direction: row;
    align-items: center;
    padding: 12px 20px;
}

.ss-mvp-bar {
    width: 4px;
    height: 20px;
    flex-shrink: 0;
    margin-right: 12px;
}
.ss-mvp-bar--gold {
    background-color: rgb(212, 160, 23);
}
.ss-mvp-bar--teal {
    background-color: rgb(0, 188, 180);
}

.ss-mvp-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
}
.ss-mvp-title--teal {
    color: rgb(0, 188, 180);
}

.ss-mvp-body {
    flex-direction: row;
    padding: 0 20px 20px 20px;
    align-items: center;
}

.ss-mvp-photo {
    width: 160px;
    height: 160px;
    border-radius: 8px;
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
    margin-right: 20px;
}

.ss-mvp-info {
    flex-direction: column;
    flex-grow: 1;
}

.ss-mvp-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
}

.ss-mvp-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    -unity-text-transform: upper;
    margin-bottom: 12px;
}

.ss-mvp-stats {
    flex-direction: row;
}

.ss-stat-box {
    flex-direction: column;
    align-items: center;
    background-color: rgb(30, 35, 50);
    border-width: 1px;
    border-color: rgb(0, 188, 180);
    padding: 8px 14px;
    margin-right: 10px;
    min-width: 70px;
}
.ss-stat-box:last-child {
    margin-right: 0;
}

.ss-stat-box--teal {
    border-color: rgb(0, 188, 180);
}

.ss-stat-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.ss-stat-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    -unity-text-transform: upper;
    -unity-text-align: middle-center;
}

/* ── STATS SECTION (bottom) ── */
.ss-stats-section {
    flex-direction: column;
}

.ss-stats-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.ss-stats-bar {
    width: 4px;
    height: 20px;
    background-color: rgb(212, 160, 23);
    margin-right: 12px;
    flex-shrink: 0;
}

.ss-stats-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
}

.ss-stats-row {
    flex-direction: row;
}

.ss-stat-card {
    flex-direction: row;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px;
    flex-grow: 1;
    margin-right: 12px;
}
.ss-stat-card:last-child {
    margin-right: 0;
}

.ss-stat-card-icon {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    margin-right: 14px;
    background-size: contain;
    background-position: center;
}

.ss-stat-card-info {
    flex-direction: column;
    flex-grow: 1;
}

.ss-stat-card-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 28px;
    color: rgb(255, 255, 255);
    letter-spacing: 1px;
}

.ss-stat-card-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    -unity-text-transform: upper;
    margin-top: 2px;
}

.ss-stat-card-sub {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(80, 180, 100);
    letter-spacing: 0.5px;
    margin-top: 2px;
}
