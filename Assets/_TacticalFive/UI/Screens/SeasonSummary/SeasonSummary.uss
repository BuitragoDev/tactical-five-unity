/* ══════════════════════════════════════════
   SEASON SUMMARY — SeasonSummary.uss
   ══════════════════════════════════════════ */

/* ── ROOT ── */
.season-summary-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ── HEADER BRAND ── */
.season-summary-root .header-brand {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 24px;
}
.season-summary-root .header-brand-icon {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
    font-size: 28px;
    padding: 4px 8px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-right: 10px;
}
.season-summary-root .header-brand-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
}
.season-summary-root .header-brand-text-gold {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
    -unity-text-transform: upper;
}

/* ── TOP HEADER (MatchDay style) ── */
.season-summary-root .top-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 28px;
    background-color: rgb(22, 26, 36);
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 160, 23);
    flex-shrink: 0;
    min-height: 100px;
}

.season-summary-root .header-left {
    flex-direction: row;
    align-items: center;
}

.season-summary-root .header-team-logo {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    margin-right: 16px;
}

.season-summary-root .header-team-info {
    flex-direction: column;
}

.season-summary-root .header-team-name-row {
    flex-direction: row;
    align-items: baseline;
}

.season-summary-root .header-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
    margin-right: 12px;
}

.season-summary-root .header-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    letter-spacing: 2px;
    -unity-text-transform: upper;
}

.season-summary-root .header-manager-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
}

.season-summary-root .header-right-group {
    flex-direction: row;
    align-items: center;
}

.season-summary-root .header-season-info {
    flex-direction: column;
    align-items: flex-end;
    margin-right: 20px;
}

.season-summary-root .header-date-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    padding: 0 12px;
    margin-right: 20px;
    border-left-width: 1px;
    border-left-color: rgb(42, 51, 71);
    border-right-width: 1px;
    border-right-color: rgb(42, 51, 71);
}

.season-summary-root .header-season-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    letter-spacing: 1px;
}

/* ── BOTÓN ACCIÓN (reuse Dashboard btn-action) ── */
.season-summary-root .btn-action {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 250px;
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 18px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.season-summary-root .btn-action:hover {
    background-color: rgb(74, 128, 240);
}

/* ── CONTENT ── */
.content-area {
    flex-grow: 1;
    flex-direction: column;
    padding: 24px 32px;
    overflow-y: auto;
}

/* ── SUMMARY HEADER ── */
.summary-header {
    text-align: center;
    margin-bottom: 20px;
    align-items: center;
}
.season-tag {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
    font-size: 24px;
    letter-spacing: 2px;
    padding: 4px 16px;
    margin-top: 8px;
    -unity-text-align: middle-center;
}

/* ── TWO-COLUMN LAYOUT ── */
.columns-row {
    flex-direction: row;
    flex-grow: 1;
    align-items: flex-start;
}

.column {
    flex-direction: column;
    flex: 1;
    align-items: center;
}

.column--gl {
    margin-left: 32px;
}

.column-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 28px;
    letter-spacing: 4px;
    -unity-text-transform: upper;
    padding-bottom: 6px;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
    min-width: 300px;
    border-bottom-width: 2px;
}
.column-title--nba {
    color: rgb(212, 160, 23);
    border-bottom-color: rgb(212, 160, 23);
}
.column-title--gl {
    color: rgb(0, 188, 180);
    border-bottom-color: rgb(0, 188, 180);
}

.card-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    -unity-text-transform: upper;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

/* ── CHAMPION CARD ── */
.champion-card {
    background-color: rgb(17, 24, 34);
    border-width: 2px;
    border-color: rgb(212, 160, 23);
    padding: 24px;
    text-align: center;
    margin-bottom: 20px;
    align-items: center;
    width: 100%;
}
.champion-logo {
    width: 120px;
    height: 120px;
    margin-bottom: 16px;
}
.champion-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 36px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}
.finals-result-row {
    flex-direction: column;
    align-items: center;
}
.result-label {
    font-size: 24px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    -unity-text-transform: upper;
    margin-bottom: 4px;
}
.result-score {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 36px;
    letter-spacing: 2px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
}
.result-loser {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    margin-top: 4px;
    min-width: 320px;
}

/* ── FINALS MVP CARD ── */
.finals-mvp-card {
    background-color: rgb(17, 24, 34);
    border-width: 1px;
    border-color: rgb(73, 115, 205);
    padding: 20px;
    text-align: center;
    width: 100%;
    align-items: center;
}
.mvp-photo-wrapper {
    width: 108px;
    height: 108px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-bottom: 8px;
}
.mvp-photo {
    width: 100px;
    height: 100px;
    border-radius: 90px;
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
}
.mvp-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}
.mvp-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 24px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    min-width: 320px;
}
.mvp-team {
    font-size: 14px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-top: 4px;
}
.mvp-stat-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 12px;
    flex-wrap: wrap;
}
.mvp-stat-box {
    flex-direction: column;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 8px 16px;
    min-width: 80px;
    min-height: 60px;
    margin-right: 16px;
}
.mvp-stat-box .stat-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.mvp-stat-box .stat-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

/* ══════════════════════════════════════════
   G-LEAGUE SECTION
   ══════════════════════════════════════════ */

.gl-cards-col {
    flex-direction: column;
    align-items: center;
    width: 100%;
}

/* ── GL CHAMPION CARD ── */
