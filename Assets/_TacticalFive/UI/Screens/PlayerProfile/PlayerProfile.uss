/* PLAYERPROFILE — PlayerProfile.uss */

.playerprofile-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.playerprofile-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.playerprofile-content {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 16px 28px 24px 28px;
}

/* Back button */
.playerprofile-back-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 22px;
    letter-spacing: 2px;
    -unity-text-transform: uppercase;
    padding: 10px 18px;
    margin-bottom: 14px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.playerprofile-back-btn:hover {
    background-color: rgb(74, 128, 240);
}

/* Header */
.playerprofile-banner {
    flex-direction: row;
    align-items: center;
    padding: 16px 24px;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

.playerprofile-photo {
    width: 130px;
    height: 130px;
    border-radius: 8px;
    background-color: rgb(200, 200, 200);
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
    margin-right: 20px;
}

.playerprofile-identity {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.playerprofile-name-row {
    flex-direction: row;
    align-items: center;
}

.playerprofile-player-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 34px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    text-transform: uppercase;
}

.playerprofile-number {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    color: rgb(100, 150, 230);
    background-color: rgba(42, 95, 201, 0.15);
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    border-radius: 6px;
    padding: 2px 10px;
    margin-left: 12px;
    flex-shrink: 0;
}

.playerprofile-player-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    margin-top: 6px;
}

.playerprofile-team-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.playerprofile-team-logo {
    width: 34px;
    height: 34px;
    margin-right: 8px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    flex-shrink: 0;
}

.playerprofile-player-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(180, 194, 220);
}

.playerprofile-honors {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 24px;
    margin-left: auto;
}

.playerprofile-honor-item {
    flex-direction: column;
    align-items: center;
    margin-right: 14px;
    padding: 8px 14px;
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    border-radius: 4px;
    background-color: rgb(13, 17, 26);
}

.playerprofile-honor-row {
    flex-direction: row;
    align-items: center;
}

.playerprofile-honor-icon {
    width: 64px;
    height: 64px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    margin-right: 4px;
}

.playerprofile-honor-count {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 42px;
    color: rgb(212, 160, 23);
}

.playerprofile-honor-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.playerprofile-ovr-block {
    flex-direction: column;
    align-items: center;
    padding: 12px 24px;
    background-color: rgb(22, 26, 36);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    margin-left: 24px;
}

.playerprofile-ovr-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 42px;
    color: rgb(255, 255, 255);
}

.playerprofile-ovr-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    margin-top: 2px;
    letter-spacing: 2px;
}

/* Section labels */
.playerprofile-section-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(212, 160, 23);
    margin-bottom: 12px;
    letter-spacing: 2px;
    -unity-text-transform: uppercase;
}

/* Season stats grid */
.playerprofile-season-section {
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px 24px;
    margin-top: 16px;
    flex-shrink: 0;
}

.playerprofile-stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.playerprofile-stat-card {
    width: 105px;
    background-color: rgb(22, 26, 36);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 12px;
    margin-right: 10px;
    margin-bottom: 10px;
    flex-direction: column;
    align-items: center;
}

.playerprofile-stat-card-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(230, 230, 230);
}

.playerprofile-stat-card-value--accent {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(39, 174, 96);
}

.playerprofile-stat-card-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    margin-top: 4px;
}

/* Columnas: Información · Atributos · Lesiones */
.playerprofile-columns {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: 16px;
    align-items: flex-start;
}

.playerprofile-panel {
    flex-grow: 1;
    flex-basis: 0;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px 20px;
    margin-right: 14px;
    min-width: 0;
}

.playerprofile-panel:last-child,
.playerprofile-columns > .playerprofile-panel:nth-child(3) {
    margin-right: 0;
}

/* ── INFORMACIÓN PERSONAL ── */

.playerprofile-info-body {
    flex-direction: row;
    flex-wrap: wrap;
}

.playerprofile-info-field {
    width: 50%;
    flex-direction: column;
    padding: 6px 8px 6px 0;
    flex-shrink: 0;
}

.playerprofile-info-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 4px;
}

.playerprofile-info-value-row {
    flex-direction: row;
    align-items: center;
}

.playerprofile-info-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(220, 226, 240);
}

.playerprofile-info-flag {
    width: 26px;
    height: 18px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.playerprofile-info-role-icon {
    width: 22px;
    height: 22px;
    margin-right: 6px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

/* ── ÚLTIMAS LESIONES ── */

.playerprofile-injuries-body {
    flex-direction: column;
}

.playerprofile-injury-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 51, 71, 0.4);
    flex-shrink: 0;
}

.playerprofile-injury-date {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(150, 162, 190);
    width: 90px;
    flex-shrink: 0;
}

.playerprofile-injury-type {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    color: rgb(179, 190, 214);
    letter-spacing: 1px;
    flex-grow: 1;
    min-width: 0;
}

.playerprofile-injury-days {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(150, 162, 190);
    width: 50px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

.playerprofile-injury-outcome {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 12px;
    letter-spacing: 1px;
    width: 96px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
    color: rgb(150, 162, 190);
}

.playerprofile-injury-outcome--forced {
    color: rgb(230, 120, 100);
}

.playerprofile-injury-empty {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 15px;
    color: rgb(122, 138, 170);
    padding: 8px 0;
}

/* ── ATRIBUTOS (badges) ── */

.playerprofile-attrs-body {
    flex-direction: row;
    flex-wrap: wrap;
}

.playerprofile-attr-badge {
    width: 88px;
    background-color: rgb(22, 26, 36);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 8px 4px;
    margin: 0 8px 8px 0;
    flex-direction: column;
    align-items: center;
}

.playerprofile-attr-badge-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    color: rgb(220, 226, 240);
}

.playerprofile-attr-badge-value--high {
    color: rgb(39, 174, 96);
}

.playerprofile-attr-badge-value--mid {
    color: rgb(212, 160, 23);
}

.playerprofile-attr-badge-value--low {
    color: rgb(192, 57, 43);
}

.playerprofile-attr-badge-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(122, 138, 170);
    margin-top: 2px;
    text-transform: uppercase;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

/* Trajectory link (en el banner) */
.playerprofile-link-row {
    flex-direction: row;
    justify-content: flex-end;
    flex-shrink: 0;
    margin-top: 16px;
}

.playerprofile-trajectory-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.10);
    border-width: 2px;
    border-color: rgb(212, 160, 23);
    border-radius: 8px;
    padding: 10px 16px;
    letter-spacing: 1px;
    -unity-text-transform: uppercase;
    cursor: pointer;
    flex-shrink: 0;
    margin-left: 20px;
    align-self: flex-start;
}

.playerprofile-trajectory-btn:hover {
    background-color: rgba(212, 160, 23, 0.25);
    color: rgb(240, 200, 80);
}

/* Attributes locked (dentro del panel de atributos) */
.playerprofile-locked {
    display: none;
    padding: 20px 8px;
    align-items: center;
    justify-content: center;
}

.playerprofile-locked-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    white-space: normal;
}

/* Empty state */
.playerprofile-empty {
    display: none;
    padding: 40px;
    align-items: center;
    justify-content: center;
}

.playerprofile-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
}
