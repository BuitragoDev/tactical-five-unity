/* PLAYERPROFILE — PlayerProfile.uss */

.playerprofile-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.playerprofile-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.playerprofile-content {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 16px 28px 24px 28px;
}

/* Back button */
.playerprofile-back-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 22px;
    letter-spacing: 2px;
    -unity-text-transform: uppercase;
    padding: 10px 18px;
    margin-bottom: 14px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.playerprofile-back-btn:hover {
    background-color: rgb(74, 128, 240);
}

/* Header */
.playerprofile-header {
    flex-direction: row;
    align-items: center;
    padding: 16px 24px;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

.playerprofile-photo {
    width: 100px;
    height: 100px;
    border-radius: 8px;
    background-color: rgb(200, 200, 200);
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
    margin-right: 20px;
}

.playerprofile-name-block {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.playerprofile-player-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 28px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    text-transform: uppercase;
}

.playerprofile-player-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(212, 160, 23);
    margin-top: 4px;
}

.playerprofile-player-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(42, 95, 201);
    margin-top: 2px;
}

.playerprofile-role-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.playerprofile-role-icon {
    width: 20px;
    height: 20px;
    margin-right: 6px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.playerprofile-role-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
}

.playerprofile-meta {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 15px;
    color: rgb(122, 138, 170);
}

.playerprofile-honors {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 24px;
    margin-left: auto;
}

.playerprofile-honor-item {
    flex-direction: column;
    align-items: center;
    margin-right: 14px;
    padding: 8px 14px;
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    border-radius: 4px;
    background-color: rgb(13, 17, 26);
}

.playerprofile-honor-row {
    flex-direction: row;
    align-items: center;
}

.playerprofile-honor-icon {
    width: 64px;
    height: 64px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    margin-right: 4px;
}

.playerprofile-honor-count {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 42px;
    color: rgb(212, 160, 23);
}

.playerprofile-honor-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.playerprofile-ovr-block {
    flex-direction: column;
    align-items: center;
    padding: 12px 24px;
    background-color: rgb(22, 26, 36);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    margin-left: 24px;
}

.playerprofile-ovr-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 42px;
    color: rgb(255, 255, 255);
}

.playerprofile-ovr-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    margin-top: 2px;
    letter-spacing: 2px;
}

/* Section labels */
.playerprofile-section-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(212, 160, 23);
    margin-bottom: 12px;
    letter-spacing: 2px;
    -unity-text-transform: uppercase;
}

/* Season stats grid */
.playerprofile-season-section {
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px 24px;
    margin-top: 16px;
    flex-shrink: 0;
}

.playerprofile-stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.playerprofile-stat-card {
    width: 105px;
    background-color: rgb(22, 26, 36);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 12px;
    margin-right: 10px;
    margin-bottom: 10px;
    flex-direction: column;
    align-items: center;
}

.playerprofile-stat-card-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(230, 230, 230);
}

.playerprofile-stat-card-value--accent {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(39, 174, 96);
}

.playerprofile-stat-card-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    margin-top: 4px;
}

/* Attributes section */
.playerprofile-injuries {
    flex-direction: column;
    margin-top: 12px;
    padding: 10px 14px;
    border-width: 1px;
    border-color: rgb(120, 95, 30);
    background-color: rgb(18, 21, 28);
    border-radius: 4px;
}

.playerprofile-injuries-body {
    flex-direction: column;
    margin-top: 6px;
}

.playerprofile-injury-row {
    flex-direction: row;
    align-items: center;
    height: 26px;
    flex-shrink: 0;
}

.playerprofile-injury-date {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(150, 162, 190);
    width: 90px;
    flex-shrink: 0;
}

.playerprofile-injury-type {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    color: rgb(179, 190, 214);
    letter-spacing: 1px;
    flex-grow: 1;
    min-width: 0;
}

.playerprofile-injury-days {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(150, 162, 190);
    width: 70px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

.playerprofile-injury-outcome {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 13px;
    letter-spacing: 1px;
    width: 110px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
    color: rgb(150, 162, 190);
}

.playerprofile-injury-outcome--forced {
    color: rgb(230, 120, 100);
}

.playerprofile-attrs-section {
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px 24px;
    margin-top: 16px;
    flex-shrink: 0;
}

.playerprofile-attrs-body {
    flex-direction: row;
    flex-wrap: wrap;
}

/* Attribute card rows */

.playerprofile-attr-card {
    width: 205px;
    background-color: rgb(22, 26, 36);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 6px 8px;
    margin-right: 6px;
    margin-bottom: 6px;
    flex-direction: column;
    align-items: center;
}

.playerprofile-attr-card-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
}

.playerprofile-attr-card-value--high {
    color: rgb(39, 174, 96);
}

.playerprofile-attr-card-value--mid {
    color: rgb(212, 160, 23);
}

.playerprofile-attr-card-value--low {
    color: rgb(192, 57, 43);
}

.playerprofile-attr-card-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    margin-top: -8px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Trajectory link */
.playerprofile-link-row {
    flex-direction: row;
    justify-content: flex-end;
    flex-shrink: 0;
    margin-top: 16px;
}

.playerprofile-trajectory-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.10);
    border-width: 2px;
    border-color: rgb(212, 160, 23);
    border-radius: 8px;
    padding: 11px 20px;
    letter-spacing: 1px;
    -unity-text-transform: uppercase;
    cursor: pointer;
}

.playerprofile-trajectory-btn:hover {
    background-color: rgba(212, 160, 23, 0.25);
    color: rgb(240, 200, 80);
}

/* Attributes locked */
.playerprofile-locked {
    display: none;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 30px 24px;
    margin-top: 16px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.playerprofile-locked-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
}

/* Empty state */
.playerprofile-empty {
    display: none;
    padding: 40px;
    align-items: center;
    justify-content: center;
}

.playerprofile-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
}

/* ── HITOS DE CARRERA (E1) ── */
.playerprofile-milestones {
    flex-direction: column;
    margin-top: 8px;
}
.playerprofile-milestones-body {
    flex-direction: row;
    flex-wrap: wrap;
}
.playerprofile-milestone {
    flex-direction: row;
    align-items: center;
    margin: 0 6px 6px 0;
    padding: 4px 10px;
    background-color: rgba(212, 160, 23, 0.10);
    border-width: 1px;
    border-color: rgb(120, 95, 30);
    border-radius: 8px;
}
.playerprofile-milestone-icon {
    width: 18px;
    height: 18px;
    margin-right: 6px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.playerprofile-milestone-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    color: rgb(248, 196, 64);
}
.playerprofile-milestone--next {
    background-color: rgba(42, 95, 201, 0.10);
    border-color: rgb(60, 90, 150);
}
.playerprofile-milestone--next .playerprofile-milestone-text { color: rgb(150, 190, 255); }
.playerprofile-milestone-pct {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 12px;
    color: rgb(179, 190, 214);
    margin-left: 8px;
}
