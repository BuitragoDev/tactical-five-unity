<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="LoadGame.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />

    <ui:VisualElement name="LoadGameRoot" class="loadgame-root">

        <!-- ══ HEADER ══ -->
        <ui:VisualElement class="loadgame-header">
            <ui:VisualElement class="header-logo-wrap">
                <ui:Label class="header-logo-icon" text="{loc:ui.load_game.tf}" />
                <ui:Label class="header-logo-text" text="{loc:ui.load_game.tactical}" />
                <ui:Label class="header-logo-text-gold" text="{loc:ui.load_game.five}" />
            </ui:VisualElement>
            <ui:VisualElement class="header-spacer" />
            <ui:Button name="BtnBack" class="btn-back" text="{loc:ui.load_game.btn_back}" />
        </ui:VisualElement>

        <!-- ══ TITLE ══ -->
        <ui:VisualElement class="loadgame-title-wrap">
            <ui:Label class="loadgame-title" text="{loc:ui.load_game.cargar_partida}" />
            <ui:Label class="loadgame-subtitle" text="{loc:ui.load_game.selecciona_una_partida_guardada_para_con_94180361}" />
            <ui:VisualElement class="loadgame-divider" />
        </ui:VisualElement>

        <!-- ══ SLOTS ══ -->
        <ui:VisualElement name="SlotsArea" class="slots-area">
            <ui:VisualElement name="SlotsGrid" class="slots-grid" />
        </ui:VisualElement>
        <ui:VisualElement name="SlotsPaginator" class="loadgame-paginator" />

        <!-- ══ EMPTY STATE ══ -->
        <ui:VisualElement name="EmptyState" class="empty-state" style="display: none;">
            <ui:Label class="empty-icon" text="📁" />
            <ui:Label class="empty-label" text="{loc:ui.load_game.no_hay_partidas_guardadas}" />
            <ui:Label class="empty-hint" text="{loc:ui.load_game.empieza_una_nueva_partida_desde_el_menu_0dc2c75a}" />
        </ui:VisualElement>

        <!-- ══ CONTENT OVERLAY (difuminado detrás del modal) ══ -->
        <ui:VisualElement name="ContentOverlay" class="content-overlay" style="display: none;" />

        <!-- ══ MODAL BORRAR PARTIDA ══ -->
        <ui:VisualElement name="DeleteModalOverlay" class="modal-overlay">
            <ui:VisualElement name="DeleteModalBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.load_game.borrar_partida}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph"
                        text="{loc:ui.load_game.estas_seguro_de_que_quieres_borrar_esta_ff5a3c70}" />
                    <ui:Label class="modal-paragraph"
                        text="{loc:ui.load_game.esta_accion_no_se_puede_deshacer_y_todos_90d6ff3b}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="BtnDeleteNo" class="modal-btn modal-btn--secondary" text="{loc:ui.load_game.btn_delete_no}" />
                    <ui:Button name="BtnDeleteYes" class="modal-btn modal-btn--danger" text="{loc:ui.load_game.btn_delete_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
