<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="LoadGame.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />

    <ui:VisualElement name="LoadGameRoot" class="loadgame-root">

        <!-- ══ HEADER ══ -->
        <ui:VisualElement class="loadgame-header">
            <ui:VisualElement class="header-logo-wrap">
                <ui:Label class="header-logo-icon" text="TF" />
                <ui:Label class="header-logo-text" text="TACTICAL" />
                <ui:Label class="header-logo-text-gold" text="FIVE" />
            </ui:VisualElement>
            <ui:VisualElement class="header-spacer" />
            <ui:Button name="BtnBack" class="btn-back" text="VOLVER AL MENU" />
        </ui:VisualElement>

        <!-- ══ TITLE ══ -->
        <ui:VisualElement class="loadgame-title-wrap">
            <ui:Label class="loadgame-title" text="CARGAR PARTIDA" />
            <ui:Label class="loadgame-subtitle" text="Selecciona una partida guardada para continuar" />
            <ui:VisualElement class="loadgame-divider" />
        </ui:VisualElement>

        <!-- ══ SLOTS ══ -->
        <ui:VisualElement name="SlotsArea" class="slots-area">
            <ui:VisualElement name="SlotsGrid" class="slots-grid" />
        </ui:VisualElement>
        <ui:VisualElement name="SlotsPaginator" class="loadgame-paginator" />

        <!-- ══ EMPTY STATE ══ -->
        <ui:VisualElement name="EmptyState" class="empty-state" style="display: none;">
            <ui:Label class="empty-icon" text="📁" />
            <ui:Label class="empty-label" text="NO HAY PARTIDAS GUARDADAS" />
            <ui:Label class="empty-hint" text="Empieza una nueva partida desde el menu principal" />
        </ui:VisualElement>

        <!-- ══ CONTENT OVERLAY (difuminado detrás del modal) ══ -->
        <ui:VisualElement name="ContentOverlay" class="content-overlay" style="display: none;" />

        <!-- ══ MODAL BORRAR PARTIDA ══ -->
        <ui:VisualElement name="DeleteModalOverlay" class="modal-overlay">
            <ui:VisualElement name="DeleteModalBox" class="modal-box">
                <ui:Label class="modal-title" text="BORRAR PARTIDA" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph"
                        text="¿Estás seguro de que quieres borrar esta partida?" />
                    <ui:Label class="modal-paragraph"
                        text="Esta acción no se puede deshacer y todos los datos de la partida se perderán." />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="BtnDeleteNo" class="modal-btn modal-btn--secondary" text="NO" />
                    <ui:Button name="BtnDeleteYes" class="modal-btn modal-btn--danger" text="SÍ, BORRAR" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
