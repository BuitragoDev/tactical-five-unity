/* ══════════════════════════════════════════
   LOAD GAME — LoadGame.uss
   ══════════════════════════════════════════ */

.loadgame-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ══ HEADER ══ */

.loadgame-header {
    flex-direction: row;
    align-items: center;
    padding: 0 40px;
    height: 100px;
    background-color: rgb(22, 26, 36);
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 160, 23);
    flex-shrink: 0;
}

.header-logo-wrap {
    flex-direction: row;
    align-items: center;
}

.header-logo-icon {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
    font-size: 32px;
    letter-spacing: 1px;
    padding: 2px 12px 2px 12px;
    -unity-text-align: middle-center;
}

.header-logo-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    padding-left: 16px;
    -unity-text-align: middle-left;
    -unity-text-transform: upper;
}

.header-logo-text-gold {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-left;
    -unity-text-transform: upper;
}

.header-spacer {
    flex-grow: 1;
}

.btn-back {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 250px;
    background-color: rgba(42, 95, 201, 0.10);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(120, 160, 230);
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 26px;
    border-radius: 8px;
    -unity-text-align: middle-center;
    cursor: pointer;
}

.btn-back:hover {
    background-color: rgba(42, 95, 201, 0.25);
    color: rgb(150, 190, 255);
}

/* ══ TITLE ══ */

.loadgame-title-wrap {
    flex-direction: column;
    align-items: center;
    margin-top: 30px;
    margin-bottom: 24px;
    flex-shrink: 0;
}

.loadgame-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 48px;
    letter-spacing: 4px;
    -unity-text-transform: upper;
    color: rgb(208, 216, 232);
}

.loadgame-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(85, 102, 119);
    margin-top: 6px;
}

.loadgame-divider {
    width: 120px;
    height: 3px;
    background-color: rgb(42, 95, 201);
    margin-top: 14px;
    border-radius: 2px;
}

/* ══ SLOTS GRID ══ */

.slots-area {
    flex-grow: 1;
    width: 100%;
    align-self: stretch;
    padding: 0 20px;
    overflow: hidden;
}

.slots-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
}

.slots-grid > * {
    margin: 10px;
}

/* ══ SLOT CARD (vertical) ══ */

.slot-card {
    flex-direction: column;
    width: 350px;
    background-color: rgb(22, 26, 36);
    border-width: 2px;
    border-color: rgb(42, 51, 71);
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    transition-property: border-color;
    transition-duration: 0.15s;
}

.slot-card:hover {
    border-color: rgb(85, 102, 119);
}

/* Saved date footer */
.slot-saved-date-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 8px 16px 10px;
}

.slot-saved-date-icon {
    width: 20px;
    height: 20px;
    margin-right: 6px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    opacity: 0.5;
}

.slot-saved-date-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    color: rgb(65, 75, 95);
}

/* Arena photo */
.slot-arena-photo {
    width: 100%;
    height: 170px;
    background-size: cover;
    background-position: center;
    background-color: rgb(17, 20, 28);
}

/* Team section */
.slot-team-section {
    flex-direction: row;
    align-items: center;
    padding: 16px;
}

/* Manager name row */
.slot-manager-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 16px 0;
}

.slot-manager-icon {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    opacity: 0.7;
}

.slot-manager-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(212, 160, 23);
}

.slot-team-logo {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    margin-right: 12px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.slot-team-info {
    flex-direction: column;
    flex-grow: 1;
}

.slot-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
}

.slot-team-season {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(85, 102, 119);
    margin-top: 2px;
}

/* Stats */
.slot-stats {
    flex-direction: column;
    padding: 0 16px;
}

.slot-stat-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 36px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(30, 34, 44);
}

.slot-stat-left {
    flex-direction: row;
    align-items: center;
}

.slot-stat-icon {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    opacity: 0.6;
}

.slot-stat-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    color: rgb(85, 102, 119);
    -unity-text-transform: upper;
}

.slot-stat-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
}

/* Status badge */
.slot-status-badge {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 12px 16px 0;
    padding: 8px;
}

.slot-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 8px;
    flex-shrink: 0;
}

.slot-status-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
}

.slot-status-badge--active {
    background-color: rgba(39, 174, 96, 0.08);
}
.slot-status-badge--active .slot-status-dot {
    background-color: rgb(39, 174, 96);
}
.slot-status-badge--active .slot-status-label {
    color: rgb(100, 200, 140);
}

.slot-status-badge--fired {
    background-color: rgba(192, 57, 43, 0.08);
}
.slot-status-badge--fired .slot-status-dot {
    background-color: rgb(192, 57, 43);
}
.slot-status-badge--fired .slot-status-label {
    color: rgb(230, 120, 100);
}

/* Game mode badge */
.slot-mode-badge {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 6px 16px 0;
    padding: 6px;
    background-color: rgba(212, 160, 23, 0.08);
}

.slot-mode-badge .slot-mode-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
}

/* Card actions */
.slot-actions {
    flex-direction: column;
    margin: 12px 16px 0;
    padding: 0;
}

.slot-actions > * {
    margin: 0 0 8px 0;
}
.slot-actions > *:last-child {
    margin-bottom: 0;
}

.btn-load {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgba(42, 95, 201, 0.10);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(120, 160, 230);
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    padding: 10px 0;
    min-width: 0;
    border-radius: 8px;
    -unity-text-align: middle-center;
    cursor: pointer;
}

.btn-load:hover {
    background-color: rgba(42, 95, 201, 0.25);
    color: rgb(150, 190, 255);
}

.btn-load--disabled {
    background-color: rgba(60, 60, 70, 0.25);
    border-color: rgb(60, 60, 70);
    color: rgb(80, 85, 95);
    cursor: default;
}

.btn-delete {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgba(192, 57, 43, 0.10);
    border-width: 2px;
    border-color: rgb(192, 57, 43);
    color: rgb(230, 120, 100);
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    padding: 10px 0;
    min-width: 0;
    border-radius: 8px;
    -unity-text-align: middle-center;
    cursor: pointer;
}

.btn-delete:hover {
    background-color: rgba(192, 57, 43, 0.25);
    color: rgb(240, 145, 125);
}

/* ══ PAGINATOR ══ */

.loadgame-paginator {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin: 16px 0 24px;
}

.loadgame-paginator-btn {
    width: 40px;
    height: 40px;
    background-color: rgba(42, 95, 201, 0.10);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(120, 160, 230);
    border-radius: 8px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    -unity-text-align: middle-center;
    cursor: pointer;
}

.loadgame-paginator-btn:hover {
    background-color: rgba(42, 95, 201, 0.25);
    color: rgb(150, 190, 255);
}

.loadgame-paginator-btn--disabled {
    opacity: 0.35;
    cursor: default;
}

.loadgame-paginator-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    color: rgb(122, 138, 170);
    margin: 0 16px;
    -unity-text-align: middle-center;
    min-width: 60px;
}

/* ══ EMPTY STATE ══ */

.empty-state {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.empty-icon {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 48px;
    color: rgb(42, 51, 71);
    margin-bottom: 16px;
}

.empty-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(58, 74, 99);
    margin-bottom: 8px;
}

.empty-hint {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(42, 51, 71);
    margin-bottom: 24px;
}

/* ══ MODAL OVERRIDE ══ */

.loadgame-root > .content-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(15, 17, 23, 0.65);
    z-index: 5;
}

.loadgame-root > .modal-overlay {
    background-color: rgba(0, 0, 0, 0.6);
}

/* ══ MODAL BORRAR PARTIDA ══ */

#DeleteModalBox {
    width: 720px;
    background-color: rgb(13, 14, 18);
    border-width: 1px;
    border-color: rgb(192, 57, 43);
    border-radius: 12px;
    padding: 0;
    flex-direction: column;
    overflow: hidden;
}

#DeleteModalBox .modal-title {
    padding: 10px 24px;
    margin: 0;
    background-color: rgba(192, 57, 43, 0.15);
    border-bottom-width: 1px;
    border-bottom-color: rgb(192, 57, 43);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 34px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
}

#DeleteModalBox .modal-body {
    padding: 20px 24px;
}

#DeleteModalBox .modal-paragraph {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 20px;
    color: rgb(179, 190, 214);
    white-space: normal;
    -unity-text-align: middle-center;
}

#DeleteModalBox .modal-actions {
    width: auto;
    align-self: stretch;
    margin: 8px 20px 16px;
    justify-content: space-between;
}

#BtnDeleteNo {
    flex-grow: 1;
    min-width: 0;
    background-color: rgba(100, 110, 130, 0.10);
    border-width: 2px;
    border-color: rgb(100, 110, 130);
    color: rgb(160, 170, 190);
    border-radius: 8px;
}

#BtnDeleteNo:hover {
    background-color: rgba(100, 110, 130, 0.25);
    color: rgb(190, 200, 220);
}

#BtnDeleteYes {
    flex-grow: 1;
    min-width: 0;
    margin-left: 16px;
    background-color: rgba(192, 57, 43, 0.10);
    border-width: 2px;
    border-color: rgb(192, 57, 43);
    color: rgb(230, 120, 100);
    border-radius: 8px;
}

#BtnDeleteYes:hover {
    background-color: rgba(192, 57, 43, 0.25);
    color: rgb(240, 145, 125);
}
