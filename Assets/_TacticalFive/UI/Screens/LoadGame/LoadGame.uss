/* ── LOAD GAME SCREEN ──────────────────────────── */

.loadgame-root {
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    flex-direction: column;
    align-items: center;
    padding: 40px 60px;
}

.loadgame-header {
    flex-direction: column;
    align-items: center;
    margin-bottom: 32px;
}

.loadgame-title {
    font-size: 32px;
    font-weight: 700;
    color: #d0d8e8;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    letter-spacing: 4px;
    -unity-text-transform: upper;
}

.loadgame-subtitle {
    font-size: 14px;
    color: #7a8aaa;
    margin-top: 8px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
}

/* ── SLOTS CONTAINER ──────────────────────────── */

.slots-container {
    flex-direction: column;
    width: 720px;
    flex: 1;
}

.slots-container > * {
    margin-bottom: 12px;
}

/* ── EMPTY STATE ──────────────────────────────── */

.empty-state {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    margin-top: 40px;
}

.empty-label {
    font-size: 22px;
    font-weight: 600;
    color: #556677;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-SemiBold.ttf");
    margin-bottom: 8px;
}

.empty-hint {
    font-size: 14px;
    color: #3a4659;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
}

/* ── SLOT CARD ────────────────────────────────── */

.slot-card {
    flex-direction: row;
    align-items: center;
    background-color: #1c2130;
    border: 1px solid #2a3347;
    border-radius: 8px;
    padding: 16px 20px;
    transition: background-color 0.15s ease;
}

.slot-card:hover {
    background-color: #23293a;
}

.slot-info {
    flex: 1;
    flex-direction: column;
    margin-right: 16px;
}

.slot-info > * {
    margin-bottom: 2px;
}

.slot-manager {
    font-size: 18px;
    font-weight: 600;
    color: #d0d8e8;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-SemiBold.ttf");
}

.slot-empty-label {
    font-size: 18px;
    font-weight: 600;
    color: #556677;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-SemiBold.ttf");
}

.slot-meta {
    font-size: 13px;
    color: #7a8aaa;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
}

.slot-meta-accent {
    color: #d4a017;
}

.slot-date {
    font-size: 12px;
    color: #556677;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
}

.slot-actions {
    flex-direction: row;
    align-items: center;
}

.slot-actions > * {
    margin-right: 8px;
}

/* ── BUTTONS ──────────────────────────────────── */

.btn-load {
    background-color: #2a5fc9;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-SemiBold.ttf");
    cursor: pointer;
}

.btn-load:hover {
    background-color: #3a7ff0;
}

.btn-new {
    background-color: #1a7a3e;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-SemiBold.ttf");
    cursor: pointer;
}

.btn-new:hover {
    background-color: #27ae60;
}

.btn-delete {
    background-color: transparent;
    color: #c0392b;
    border: 1px solid #c0392b;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 600;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-SemiBold.ttf");
    cursor: pointer;
}

.btn-delete:hover {
    background-color: rgba(192, 57, 43, 0.1);
}

.btn-back {
    background-color: transparent;
    color: #7a8aaa;
    border: 1px solid #2a3347;
    border-radius: 6px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 600;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-SemiBold.ttf");
    cursor: pointer;
}

.btn-back:hover {
    background-color: rgba(255, 255, 255, 0.03);
    color: #d0d8e8;
}

/* ── FOOTER ───────────────────────────────────── */

.loadgame-footer {
    margin-top: 24px;
    flex-direction: row;
    justify-content: center;
}
