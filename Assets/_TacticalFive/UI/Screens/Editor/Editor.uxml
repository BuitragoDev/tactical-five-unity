<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="Editor.uss" />

    <ui:VisualElement name="EditorRoot" class="editor-root">

        <!-- MAIN -->
        <ui:VisualElement class="editor-main">

            <!-- TOP HEADER -->
            <ui:VisualElement name="TopHeader" class="top-header">
                <ui:Label class="editor-header-title" text="EDITOR DE BASE DE DATOS" />
                <ui:VisualElement class="header-spacer" />
                <ui:VisualElement name="LoadingSpinner" class="loading-spinner" />
                <ui:Button name="BtnReset" class="btn-action btn-action--reset" text="RESETEAR BASE DE DATOS" />
                <ui:Button name="BtnAction" class="btn-action" text="VOLVER AL MENÚ" style="min-width:200px; margin-left:10px;" />
            </ui:VisualElement>

            <!-- CONTENT -->
            <ui:VisualElement class="editor-content">

                <!-- Tab buttons -->
                <ui:VisualElement name="EditorTabRow" class="editor-tab-row">
                    <ui:Button name="BtnTeams" class="editor-tab editor-tab--active" text="EQUIPOS" />
                    <ui:Button name="BtnPlayers" class="editor-tab" text="JUGADORES" />
                </ui:VisualElement>

                <!-- Panel wrapper (teams or players) -->
                <ui:VisualElement name="EditorPanel" class="editor-panel">

                    <!-- ===== TEAMS TAB ===== -->
                    <ui:VisualElement name="EditorTeamPanel" class="editor-team-panel editor-tab-panel">
                        <ui:VisualElement class="editor-list-panel">
                            <ui:VisualElement class="editor-scroll-wrapper">
                                <ui:ScrollView class="editor-list-scroll">
                                    <ui:VisualElement name="TeamList" class="editor-list" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                            <ui:TextField name="TeamFilter" class="editor-filter-input" placeholder="Buscar equipo..." />
                        </ui:VisualElement>
                        <ui:VisualElement class="editor-detail-panel">
                            <ui:ScrollView class="editor-detail-scroll">
                                <ui:VisualElement name="TeamDetail" class="editor-detail" />
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ===== PLAYERS TAB ===== -->
                    <ui:VisualElement name="EditorPlayerPanel" class="editor-player-panel editor-tab-panel" style="display: none;">
                        <ui:VisualElement class="editor-list-panel">
                            <ui:VisualElement class="editor-scroll-wrapper">
                                <ui:ScrollView class="editor-list-scroll">
                                    <ui:VisualElement name="PlayerList" class="editor-list" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                            <ui:VisualElement name="PlayerTeamFilter" class="custom-filter-dropdown">
                                <ui:Button class="custom-dropdown__trigger" name="PlayerTeamFilterTrigger">
                                    <ui:Label class="custom-dropdown__value" name="PlayerTeamFilterValue" text="TODOS" />
                                    <ui:Label class="custom-dropdown__arrow" text="▾" />
                                </ui:Button>
                                <ui:VisualElement class="custom-dropdown__list" name="PlayerTeamFilterList" style="display: none;" />
                            </ui:VisualElement>
                            <ui:VisualElement name="PlayerPosFilter" class="custom-filter-dropdown">
                                <ui:Button class="custom-dropdown__trigger" name="PlayerPosFilterTrigger">
                                    <ui:Label class="custom-dropdown__value" name="PlayerPosFilterValue" text="TODOS" />
                                    <ui:Label class="custom-dropdown__arrow" text="▾" />
                                </ui:Button>
                                <ui:VisualElement class="custom-dropdown__list" name="PlayerPosFilterList" style="display: none;" />
                            </ui:VisualElement>
                            <ui:TextField name="PlayerSearch" class="editor-filter-input" placeholder="Buscar jugador..." />
                        </ui:VisualElement>
                        <ui:VisualElement class="editor-detail-panel">
                            <ui:ScrollView class="editor-detail-scroll">
                                <ui:VisualElement name="PlayerDetail" class="editor-detail" />
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
