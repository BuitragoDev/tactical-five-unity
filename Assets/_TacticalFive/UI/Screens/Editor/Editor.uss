/* ══════════════════════════════════════════
   EDITOR — Editor.uss
   ══════════════════════════════════════════ */

.editor-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.editor-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.editor-header-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.editor-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 16px 24px;
    min-height: 0;
}

/* ══ TAB ROW ══ */

.editor-tab-row {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 12px;
}

.editor-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1.5px;
    padding: 10px 24px;
    background-color: rgb(22, 26, 36);
    border-color: rgb(42, 51, 71);
    border-width: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-right: 4px;
    border-top-left-radius: 2px;
    cursor: pointer;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    margin-right: 16px;
}

.editor-tab:hover {
    color: rgb(208, 216, 232);
    border-color: rgb(85, 102, 119);
}

.editor-tab--active {
    color: rgb(212, 160, 23);
    border-color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.08);
}

/* ══ MAIN PANEL ══ */

.editor-panel {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    overflow: hidden;
}

.editor-tab-panel {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

/* ══ LIST PANEL (left side) ══ */

.editor-list-panel {
    width: 280px;
    flex-shrink: 0;
    flex-direction: column-reverse;
    min-height: 0;
    max-height: 100%;
    overflow: hidden;
    border-right-width: 1px;
    border-right-color: rgb(42, 51, 71);
    background-color: rgb(17, 24, 34);
}

.editor-scroll-wrapper {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}

.editor-filter-input {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(208, 216, 232);
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 8px 12px;
    margin: 8px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    flex-shrink: 0;
}

.editor-filter-input:focus {
    border-color: rgb(42, 95, 201);
}

.editor-list-scroll {
    flex-grow: 1;
    min-height: 0;
    margin: 0 4px;
}

.editor-list {
    flex-direction: column;
}

.editor-list-item {
    flex-direction: row;
    align-items: center;
    min-height: 60px;
    padding: 0 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    cursor: pointer;
}

.editor-list-item:hover {
    background-color: rgb(28, 33, 48);
}

.editor-list-item--selected {
    background-color: rgba(42, 95, 201, 0.15);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}

.editor-list-item-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.editor-list-item-sub {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-right;
    margin-left: 8px;
}

.editor-list-item-logo {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    flex-shrink: 0;
}

/* ══ DETAIL PANEL (right side) ══ */

.editor-detail-panel {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.editor-detail-scroll {
    flex-grow: 1;
    min-height: 0;
}

.editor-detail {
    flex-direction: column;
    padding: 16px 24px;
}

.editor-detail-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 1.5px;
    color: rgb(212, 160, 23);
    margin-bottom: 16px;
    -unity-text-align: middle-left;
}

.editor-field-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    min-height: 32px;
}

.editor-field-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    width: 140px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

.editor-field-input {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 12px 10px;
    flex-grow: 1;
    min-width: 300px;
    max-width: 300px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    height: 36px;
    -unity-text-align: middle-left;
}

.editor-field-input:focus {
    border-color: rgb(42, 95, 201);
}

.editor-field-input--wide {
    max-width: none;
}

.editor-field-display {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

/* ══ SECTION DIVIDER ══ */

.editor-section-divider {
    height: 1px;
    background-color: rgb(42, 51, 71);
    margin: 12px 0;
    flex-shrink: 0;
}

.editor-section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(85, 102, 119);
    margin: 8px 0;
    -unity-text-align: middle-left;
}

/* ══ SAVE BUTTON ══ */

.editor-save-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 1.5px;
    padding: 10px 24px;
    background-color: rgb(24, 118, 63);
    border-width: 0;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin: 8px 16px;
    align-self: flex-start;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    min-width: 98%;
    min-height: 50px;
    border-radius: 0px;
}

.editor-save-btn:hover {
    background-color: rgb(60, 105, 79);
}

/* ══ INPUT TEXT OVERRIDES ══ */
.editor-field-input .unity-text-element {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.editor-filter-input .unity-text-element {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(208, 216, 232);
}

/* ══ TWO-COLUMN LAYOUT ══ */

.editor-columns-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.editor-column {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    padding-right: 12px;
}

.editor-column:last-child {
    padding-right: 0;
    padding-left: 12px;
}

.btn-action--reset {
    background-color: rgb(201, 48, 48);
    margin-right: 8px;
    border-radius: 4px;
    min-width: 300px;
    border-radius: 0px;
}

.btn-action--reset:hover {
    background-color: rgb(230, 70, 70);
}

/* ══ CUSTOM DROPDOWN ══ */

.custom-dropdown {
    position: relative;
    flex-grow: 1;
    max-width: 300px;
}

.custom-dropdown__trigger {
    flex-direction: row;
    align-items: center;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 6px 10px;
    height: 36px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    flex-grow: 1;
    cursor: pointer;
}

.custom-dropdown__trigger:hover {
    border-color: rgb(85, 102, 119);
}

.custom-dropdown__value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.custom-dropdown__arrow {
    font-size: 14px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-right;
    margin-left: 6px;
}

.custom-dropdown__list {
    position: absolute;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    flex-direction: column;
}

.custom-dropdown__item {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    background-color: rgb(28, 33, 48);
    border-width: 0;
    padding: 4px 16px;
    -unity-text-align: middle-left;
    cursor: pointer;
}

.custom-dropdown__item:hover {
    background-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
}

.custom-dropdown__item--selected {
    color: rgb(212, 160, 23);
}

/* ══ CUSTOM DROPDOWN (filter variant) ══ */

.custom-filter-dropdown {
    position: relative;
    flex-shrink: 0;
    margin: 4px 8px;
}

.custom-filter-dropdown .custom-dropdown__trigger {
    height: 36px;
    padding: 8px 12px;
}

.custom-filter-dropdown .custom-dropdown__list {
    top: 38px;
}

/* ══ SAVE MODAL ══ */

.editor-modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    display: none;
}

.editor-modal-box {
    width: 520px;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-top-width: 3px;
    border-top-color: rgb(39, 174, 96);
    padding: 32px;
    flex-direction: column;
    align-items: center;
}

.editor-modal-box--error {
    border-top-color: rgb(192, 57, 43);
}

.editor-modal-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.editor-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.editor-modal-title--success {
    color: rgb(39, 174, 96);
}

.editor-modal-title--error {
    color: rgb(192, 57, 43);
}

.editor-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    margin-bottom: 24px;
    -unity-text-align: middle-center;
}

.editor-modal-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    background-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
    border-width: 0;
    padding: 10px 32px;
}

.editor-modal-btn:hover {
    background-color: rgb(74, 128, 240);
}


