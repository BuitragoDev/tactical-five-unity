/* ══════════════════════════════════════════
   EDITOR — Editor.uss
   ══════════════════════════════════════════ */

.editor-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.editor-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.editor-header-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 20px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.editor-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 16px 24px;
    min-height: 0;
}

/* ══ TAB ROW ══ */

.editor-tab-row {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 12px;
}

.editor-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1.5px;
    padding: 10px 24px;
    background-color: rgb(22, 26, 36);
    border-color: rgb(42, 51, 71);
    border-width: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-right: 4px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.editor-tab:hover {
    color: rgb(208, 216, 232);
    border-color: rgb(85, 102, 119);
}

.editor-tab--active {
    color: rgb(212, 160, 23);
    border-color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.08);
}

/* ══ MAIN PANEL ══ */

.editor-panel {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    overflow: hidden;
}

.editor-tab-panel {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

/* ══ LIST PANEL (left side) ══ */

.editor-list-panel {
    width: 280px;
    flex-shrink: 0;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    border-right-width: 1px;
    border-right-color: rgb(42, 51, 71);
    background-color: rgb(17, 24, 34);
}

.editor-scroll-wrapper {
    flex-grow: 1;
    min-height: 0;
}

.editor-filter-input {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 14px;
    color: rgb(208, 216, 232);
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 8px 12px;
    margin: 8px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    flex-shrink: 0;
}

.editor-filter-input:focus {
    border-color: rgb(42, 95, 201);
}

.editor-filter-dropdown {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 14px;
    color: rgb(208, 216, 232);
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 8px 12px;
    margin: 4px 8px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    flex-shrink: 0;
    height: 36px;
    -unity-text-align: middle-left;
}

.editor-list-scroll {
    flex-grow: 1;
    min-height: 0;
    margin: 0 4px;
}

.editor-list {
    flex-direction: column;
}

.editor-list-item {
    flex-direction: row;
    align-items: center;
    min-height: 60px;
    padding: 0 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    cursor: pointer;
}

.editor-list-item:hover {
    background-color: rgb(28, 33, 48);
}

.editor-list-item--selected {
    background-color: rgba(42, 95, 201, 0.15);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}

.editor-list-item-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 15px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.editor-list-item-sub {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 13px;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-right;
    margin-left: 8px;
}

.editor-list-item-logo {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    flex-shrink: 0;
}

/* ══ DETAIL PANEL (right side) ══ */

.editor-detail-panel {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.editor-detail-scroll {
    flex-grow: 1;
    min-height: 0;
}

.editor-detail {
    flex-direction: column;
    padding: 16px 24px;
}

.editor-detail-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1.5px;
    color: rgb(212, 160, 23);
    margin-bottom: 16px;
    -unity-text-align: middle-left;
}

.editor-field-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    min-height: 32px;
}

.editor-field-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 14px;
    color: rgb(122, 138, 170);
    width: 140px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

.editor-field-input {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 14px;
    color: rgb(208, 216, 232);
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 6px 10px;
    flex-grow: 1;
    max-width: 300px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    height: 30px;
}

.editor-field-input:focus {
    border-color: rgb(42, 95, 201);
}

.editor-field-input--wide {
    max-width: none;
}

.editor-field-dropdown {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 14px;
    color: rgb(208, 216, 232);
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 6px 10px;
    flex-grow: 1;
    max-width: 300px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    height: 30px;
    -unity-text-align: middle-left;
}

.editor-field-display {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

/* ══ SECTION DIVIDER ══ */

.editor-section-divider {
    height: 1px;
    background-color: rgb(42, 51, 71);
    margin: 12px 0;
    flex-shrink: 0;
}

.editor-section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 15px;
    letter-spacing: 1px;
    color: rgb(85, 102, 119);
    margin: 8px 0;
    -unity-text-align: middle-left;
}

/* ══ IMAGE SELECTOR ══ */

.editor-image-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 12px;
}

.editor-image-preview {
    width: 80px;
    height: 80px;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    margin-right: 12px;
    flex-shrink: 0;
}

.editor-image-grid {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
}

.editor-image-option {
    width: 48px;
    height: 48px;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    margin-right: 6px;
    margin-bottom: 6px;
    cursor: pointer;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.editor-image-option:hover {
    border-color: rgb(85, 102, 119);
}

.editor-image-option--selected {
    border-color: rgb(42, 95, 201);
    border-width: 2px;
}

/* ══ SAVE BUTTON ══ */

.editor-save-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 15px;
    letter-spacing: 1.5px;
    padding: 10px 24px;
    background-color: rgb(39, 174, 96);
    border-width: 0;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-top: 12px;
    align-self: flex-start;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.editor-save-btn:hover {
    background-color: rgb(46, 204, 113);
}

/* ══ LABEL OVERRIDES ══ */
.editor-field-input .unity-text-element {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 14px;
    color: rgb(208, 216, 232);
}

.editor-filter-input .unity-text-element {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 14px;
    color: rgb(208, 216, 232);
}
