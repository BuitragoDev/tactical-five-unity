/* ══════════════════════════════════════════
   EDITOR — Editor.uss
   ══════════════════════════════════════════ */

.editor-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.editor-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.editor-header-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

/* ── HEADER ACTION BUTTONS (formato moderno) ── */

.editor-root .btn-action {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgba(42, 95, 201, 0.10);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(120, 160, 230);
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    border-radius: 8px;
    -unity-text-align: middle-center;
    cursor: pointer;
}

.editor-root .btn-action:hover {
    background-color: rgba(42, 95, 201, 0.25);
    color: rgb(150, 190, 255);
}

.editor-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 16px 24px;
    min-height: 0;
}

/* ══ TAB ROW ══ */

.editor-tab-row {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 12px;
}

.editor-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1.5px;
    padding: 10px 24px;
    background-color: rgb(22, 26, 36);
    border-color: rgb(42, 51, 71);
    border-width: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-right: 4px;
    border-top-left-radius: 2px;
    cursor: pointer;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    margin-right: 16px;
}

.editor-tab:hover {
    color: rgb(208, 216, 232);
    border-color: rgb(85, 102, 119);
}

.editor-tab--active {
    color: rgb(212, 160, 23);
    border-color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.08);
}

/* ══ MAIN PANEL ══ */

.editor-panel {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    overflow: hidden;
}

.editor-tab-panel {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

/* ══ LIST PANEL (left side) ══ */

.editor-list-panel {
    width: 280px;
    flex-shrink: 0;
    flex-direction: column-reverse;
    min-height: 0;
    max-height: 100%;
    overflow: hidden;
    border-right-width: 1px;
    border-right-color: rgb(42, 51, 71);
    background-color: rgb(17, 24, 34);
}

.editor-scroll-wrapper {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}

.editor-filter-input {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(208, 216, 232);
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 8px 12px;
    margin: 8px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    flex-shrink: 0;
}

.editor-filter-input:focus {
    border-color: rgb(42, 95, 201);
}

.editor-list-scroll {
    flex-grow: 1;
    min-height: 0;
    margin: 0 4px;
}

.editor-list {
    flex-direction: column;
}

.editor-list-item {
    flex-direction: row;
    align-items: center;
    min-height: 60px;
    padding: 0 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
    cursor: pointer;
}

.editor-list-item:hover {
    background-color: rgb(28, 33, 48);
}

.editor-list-item--selected {
    background-color: rgba(42, 95, 201, 0.15);
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}

.editor-list-item-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.editor-list-item-sub {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-right;
    margin-left: 8px;
}

.editor-list-item-logo {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    flex-shrink: 0;
}

/* ══ DETAIL PANEL (right side) ══ */

.editor-detail-panel {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.editor-detail-scroll {
    flex-grow: 1;
    min-height: 0;
}

.editor-detail {
    flex-direction: column;
    padding: 16px 24px;
}

.editor-detail-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 1.5px;
    color: rgb(212, 160, 23);
    margin-bottom: 16px;
    -unity-text-align: middle-left;
}

.editor-field-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    min-height: 32px;
}

.editor-field-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    width: 140px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

.editor-field-input {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 12px 10px;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    max-width: none;
    overflow: hidden;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    height: 36px;
    -unity-text-align: middle-left;
}

.editor-field-input:focus {
    border-color: rgb(42, 95, 201);
}

.editor-field-input--wide {
    max-width: none;
}

.editor-field-display {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

/* ══ SECTION DIVIDER ══ */

.editor-section-divider {
    height: 1px;
    background-color: rgb(42, 51, 71);
    margin: 12px 0;
    flex-shrink: 0;
}

.editor-section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(85, 102, 119);
    margin: 8px 0;
    -unity-text-align: middle-left;
}

/* ══ SAVE BUTTON ══ */

.editor-save-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 1.5px;
    padding: 10px 24px;
    background-color: rgba(39, 174, 96, 0.10);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    color: rgb(100, 200, 140);
    -unity-text-align: middle-center;
    margin: 8px 16px;
    align-self: flex-start;
    min-width: 98%;
    min-height: 50px;
    border-radius: 8px;
    cursor: pointer;
}

.editor-save-btn:hover {
    background-color: rgba(39, 174, 96, 0.25);
    color: rgb(150, 220, 180);
}

/* ══ INPUT TEXT OVERRIDES ══ */
.editor-field-input .unity-text-element {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.editor-filter-input .unity-text-element {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(208, 216, 232);
}

/* ══ TWO-COLUMN LAYOUT ══ */

.editor-columns-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.editor-column {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    padding-right: 12px;
}

.editor-root .btn-action--reset {
    background-color: rgba(192, 57, 43, 0.10);
    border-width: 2px;
    border-color: rgb(192, 57, 43);
    color: rgb(230, 120, 100);
    margin-right: 8px;
    min-width: 300px;
    border-radius: 8px;
    cursor: pointer;
}

.editor-root .btn-action--reset:hover {
    background-color: rgba(192, 57, 43, 0.25);
    color: rgb(240, 145, 125);
}

/* ══ CUSTOM DROPDOWN ══ */

.custom-dropdown {
    position: relative;
    flex-grow: 1;
    max-width: 300px;
}

.custom-dropdown__trigger {
    flex-direction: row;
    align-items: center;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 6px 10px;
    height: 36px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    flex-grow: 1;
    cursor: pointer;
}

.custom-dropdown__trigger:hover {
    border-color: rgb(85, 102, 119);
}

.custom-dropdown__value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.custom-dropdown__arrow {
    font-size: 14px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-right;
    margin-left: 6px;
}

.custom-dropdown__list {
    position: absolute;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    flex-direction: column;
}

.custom-dropdown__item {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    background-color: rgb(28, 33, 48);
    border-width: 0;
    padding: 4px 16px;
    -unity-text-align: middle-left;
    cursor: pointer;
}

.custom-dropdown__item:hover {
    background-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
}

.custom-dropdown__item--selected {
    color: rgb(212, 160, 23);
}

/* ══ CUSTOM DROPDOWN (filter variant) ══ */

.custom-filter-dropdown {
    position: relative;
    flex-shrink: 0;
    margin: 4px 8px;
}

.custom-filter-dropdown .custom-dropdown__trigger {
    height: 36px;
    padding: 8px 12px;
}

.custom-filter-dropdown .custom-dropdown__list {
    top: 38px;
}

/* ══ SAVE MODAL (estilo moderno) ══ */

.editor-modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    display: none;
}

.editor-modal-box {
    width: 650px;
    background-color: rgb(13, 14, 18);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    border-radius: 12px;
    padding: 0;
    flex-direction: column;
    overflow: hidden;
}

.editor-modal-box--error {
    border-color: rgb(192, 57, 43);
}

.editor-modal-header {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 16px 24px;
    background-color: rgba(39, 174, 96, 0.15);
    border-bottom-width: 1px;
    border-bottom-color: rgb(39, 174, 96);
}

.editor-modal-header--error {
    background-color: rgba(192, 57, 43, 0.15);
    border-bottom-color: rgb(192, 57, 43);
}

.editor-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 34px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.editor-modal-body {
    flex-direction: column;
    align-items: center;
    padding: 24px;
}

.editor-modal-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 20px;
    color: rgb(179, 190, 214);
    -unity-text-align: middle-center;
    white-space: normal;
}

.editor-modal-actions {
    flex-direction: row;
    justify-content: center;
    padding: 0 24px 24px;
}

.editor-modal-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    background-color: rgba(39, 174, 96, 0.10);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    color: rgb(100, 200, 140);
    border-radius: 8px;
    padding: 12px 48px;
    min-width: 200px;
    -unity-text-align: middle-center;
    cursor: pointer;
}

.editor-modal-btn:hover {
    background-color: rgba(39, 174, 96, 0.25);
    color: rgb(150, 220, 180);
}

.editor-modal-btn--danger {
    background-color: rgba(192, 57, 43, 0.10);
    border-color: rgb(192, 57, 43);
    color: rgb(230, 120, 100);
}

.editor-modal-btn--danger:hover {
    background-color: rgba(192, 57, 43, 0.25);
    color: rgb(240, 145, 125);
}


/* ══ EXPLORADOR DE ARCHIVOS ══ */
.editor-browser-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.75);
    align-items: center;
    justify-content: center;
}

.editor-browser-box {
    width: 760px;
    max-height: 80%;
    background-color: rgb(13, 14, 18);
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    border-radius: 12px;
    padding: 0;
    flex-direction: column;
    overflow: hidden;
}

.editor-browser-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    padding: 16px 20px;
    background-color: rgba(120, 95, 30, 0.18);
    border-bottom-width: 1px;
    border-bottom-color: rgb(120, 95, 30);
}

.editor-browser-path {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(122, 138, 170);
    padding: 8px 20px;
    white-space: normal;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
}

.editor-browser-quick {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 10px 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
}

.editor-browser-quick-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(212, 160, 23);
    background-color: rgba(120, 95, 30, 0.15);
    border-width: 1px;
    border-color: rgb(120, 95, 30);
    border-radius: 6px;
    padding: 6px 14px;
    margin: 0 8px 8px 0;
    cursor: pointer;
}

.editor-browser-quick-btn:hover {
    background-color: rgba(120, 95, 30, 0.35);
}

.editor-browser-scroll {
    flex-grow: 1;
    min-height: 220px;
    max-height: 420px;
    background-color: rgb(18, 21, 28);
}

.editor-browser-list {
    flex-direction: column;
    padding: 6px 0;
}

.editor-browser-entry {
    flex-direction: row;
    align-items: center;
    padding: 8px 20px;
    cursor: pointer;
}

.editor-browser-entry:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.editor-browser-entry-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
}

.editor-browser-entry--folder .editor-browser-entry-name {
    color: rgb(212, 160, 23);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
}

.editor-browser-actions {
    flex-direction: row;
    justify-content: flex-end;
    padding: 14px 20px;
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
}

.editor-browser-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    border-width: 2px;
    border-radius: 8px;
    padding: 10px 28px;
    cursor: pointer;
    -unity-text-align: middle-center;
}

.editor-browser-btn--cancel {
    background-color: rgba(192, 57, 43, 0.10);
    border-color: rgb(192, 57, 43);
    color: rgb(230, 120, 100);
}

.editor-browser-btn--cancel:hover {
    background-color: rgba(192, 57, 43, 0.25);
    color: rgb(240, 145, 125);
}

/* ══ TEAM DETAIL: BANNER + PANELES ══ */
.editor-team-banner {
    height: 190px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 10px;
    overflow: hidden;
    position: relative;
    margin-bottom: 16px;
}

.editor-team-banner-bg {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-size: cover;
    background-position: center;
    opacity: 0.35;
}

.editor-team-banner-content {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 24px;
}

.editor-team-banner-logo {
    width: 110px;
    height: 110px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    flex-shrink: 0;
    margin-right: 22px;
}

.editor-team-banner-info {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.editor-team-banner-name-row {
    flex-direction: row;
    align-items: center;
}

.editor-team-banner-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 40px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
}

.editor-team-banner-abbr {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    color: rgb(120, 220, 160);
    background-color: rgba(39, 174, 96, 0.18);
    border-width: 1px;
    border-color: rgb(39, 174, 96);
    border-radius: 6px;
    padding: 2px 10px;
    margin-left: 14px;
}

.editor-team-banner-city {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    margin-top: 4px;
}

.editor-team-banner-meta {
    flex-direction: row;
    margin-top: 10px;
}

.editor-team-banner-meta-item {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(160, 175, 205);
    margin-right: 22px;
}

.editor-banner-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    background-color: rgba(20, 24, 32, 0.75);
    border-width: 1px;
    border-color: rgb(90, 105, 135);
    border-radius: 8px;
    padding: 12px 20px;
    flex-shrink: 0;
    cursor: pointer;
}

.editor-banner-btn:hover {
    border-color: rgb(212, 160, 23);
    color: rgb(212, 160, 23);
}

.editor-team-panels-row {
    flex-direction: row;
    align-items: flex-start;
}

.editor-section-panel {
    flex-direction: column;
    background-color: rgb(20, 24, 32);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 10px;
    overflow: hidden;
    padding-bottom: 14px;
    margin-bottom: 16px;
    min-width: 0;
}

.editor-section-panel--info {
    flex-grow: 4;
    flex-basis: 0;
    margin-right: 16px;
}

.editor-section-panel--stadium {
    flex-grow: 2;
    flex-basis: 0;
}

.editor-panel-header {
    flex-direction: row;
    align-items: center;
    padding: 12px 16px;
    background-color: rgba(120, 95, 30, 0.15);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    margin-bottom: 12px;
}

.editor-panel-header-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
}

.editor-panel-fields {
    flex-direction: row;
    align-items: flex-start;
}

.editor-panel-col {
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    padding: 0 12px;
}

.editor-stadium-image {
    height: 170px;
    background-size: cover;
    background-position: center;
    border-radius: 8px;
    margin: 0 14px 12px 14px;
    background-color: rgb(30, 35, 46);
}

.editor-stadium-stats {
    flex-direction: row;
    padding: 0 14px;
    margin-bottom: 12px;
}

.editor-stadium-stat {
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    padding: 10px 6px;
    margin-right: 8px;
}

.editor-stadium-stat-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    color: rgb(255, 255, 255);
}

.editor-stadium-stat-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    margin-top: 2px;
}

.editor-stadium-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(100, 200, 140);
    background-color: rgba(39, 174, 96, 0.10);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    border-radius: 8px;
    padding: 12px 20px;
    margin: 0 14px;
    -unity-text-align: middle-center;
    cursor: pointer;
}

.editor-stadium-btn:hover {
    background-color: rgba(39, 174, 96, 0.25);
    color: rgb(150, 220, 180);
}

.editor-stadium-field {
    padding: 0 14px;
}
