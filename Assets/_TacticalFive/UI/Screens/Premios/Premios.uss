.premios-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.premios-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.premios-content {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    padding: 20px 24px;
}

.premios-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: white;
    font-weight: bold;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

/* ── TABS ── */
.premios-tabs {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
}

/* ── TABLE ── */
.premios-table-wrapper {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 4px;
    overflow: hidden;
}

.premios-table-header {
    flex-direction: row;
    align-items: center;
    padding: 8px 0;
    background-color: rgb(17, 24, 34);
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

.premios-table-body {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}

/* Header columns */
.premios-th {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    padding: 0 4px;
}

.premios-th-month      { width: 100px; flex-shrink: 0; }
.premios-th-photo      { width: 50px;  flex-shrink: 0; }
.premios-th-name       { flex-grow: 1; min-width: 0; -unity-text-align: middle-left; }
.premios-th-team       { width: 180px; flex-shrink: 0; -unity-text-align: middle-left; }
.premios-th-stat       { width: 70px;  flex-shrink: 0; }

/* Data rows */
.premios-data-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 51, 71, 0.4);
    min-height: 48px;
}

.premios-data-row:last-child {
    border-bottom-width: 0;
}

.premios-data-row:hover {
    background-color: rgba(42, 51, 71, 0.2);
}

/* Data columns */
.premios-td {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 15px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    padding: 0 4px;
}

.premios-td-month {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(212, 160, 23);
    width: 100px;
    flex-shrink: 0;
}

.premios-td-photo {
    width: 50px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.premios-td-photo-img {
    width: 36px;
    height: 36px;
    border-radius: 4px;
}

.premios-td-name {
    flex-grow: 1;
    min-width: 0;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.premios-td-team {
    width: 180px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
    color: rgb(130, 146, 175);
}

.premios-td-stat {
    width: 70px;
    flex-shrink: 0;
}

.premios-td-stat-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 15px;
    color: rgb(100, 200, 255);
}

.premios-td-empty {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 15px;
    color: rgb(80, 80, 80);
    font-style: italic;
}
