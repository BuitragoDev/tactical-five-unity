<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Premios.uss" />
    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />

    <ui:VisualElement name="PremiosRoot" class="premios-root">

        <ui:VisualElement class="premios-main">

            <ui:VisualElement class="premios-content">

                <ui:Label name="PremiosTitle" class="premios-title" text="PREMIOS MENSUALES" />

                <ui:VisualElement class="premios-scroll-wrapper">
                    <ui:ScrollView name="PremiosScroll" class="premios-scroll" horizontal-scrolling-enabled="false" mode="Vertical">
                        <ui:VisualElement name="PremiosBody" class="premios-body" />
                    </ui:ScrollView>
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
