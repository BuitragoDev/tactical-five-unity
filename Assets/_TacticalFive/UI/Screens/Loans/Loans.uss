/* ══════════════════════════════════════════
   LOANS — Loans.uss
   ══════════════════════════════════════════ */

.loans-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.loans-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.loans-content {
    flex-direction: column;
    flex-grow: 1;
    overflow-y: auto;
    padding: 20px;
}

/* ── FINANCIAL STAFF ── */

.fin-staff-section {
    flex-direction: column;
    margin-bottom: 24px;
}

.fin-staff-body {
    flex-direction: row;
}

.fin-staff-card {
    flex-direction: row;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 14px 18px;
    min-width: 320px;
}

.fin-staff-icon {
    width: 64px;
    height: 64px;
    margin-right: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.fin-staff-info {
    flex-direction: column;
    flex-grow: 1;
}

.fin-staff-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-transform: upper;
}

.fin-staff-star {
    width: 18px;
    height: 18px;
    margin-right: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.fin-staff-star--empty {
    opacity: 0.25;
}

.fin-staff-interest {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 14px;
    color: rgb(212, 160, 23);
    margin-top: 4px;
}

.section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
    margin-bottom: 12px;
}

.fin-staff-empty {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px 18px;
    min-width: 320px;
}

/* ── LOANS ── */

.loans-section {
    flex-direction: column;
    flex-grow: 1;
}

.loans-container {
    flex-direction: row;
}

.loan-slot {
    flex: 1;
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 14px;
    margin-right: 12px;
}

.loan-slot--active {
    border-color: rgb(212, 160, 23);
}

.loan-header {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
    -unity-text-transform: upper;
    margin-bottom: 14px;
}

.loan-amount-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.loan-months-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.loan-spin-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    flex-grow: 1;
}

.btn-spin {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 20px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    width: 36px;
    height: 36px;
    background-color: rgb(42, 51, 71);
    flex-shrink: 0;
    border-width: 0;
    padding: 0;
}

.btn-spin:hover {
    background-color: rgb(58, 74, 99);
}

.btn-spin--disabled {
    background-color: rgb(30, 34, 46);
    color: rgb(80, 90, 110);
}

.loan-payment-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
    padding: 10px 0;
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
}

.loan-payment-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    flex-grow: 1;
}

.loan-payment-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 20px;
    color: rgb(39, 174, 96);
}

.loan-actions-row {
    flex-direction: row;
    justify-content: flex-end;
    gap: 10px;
}

.btn-pay {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    background-color: rgb(192, 57, 43);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 8px 20px;
    -unity-text-align: middle-center;
}

.btn-pay:hover {
    background-color: rgb(231, 76, 60);
}

.btn-pay--disabled {
    background-color: rgb(42, 51, 71);
    color: rgb(90, 103, 128);
}

.btn-contract {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    background-color: rgb(39, 174, 96);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 8px 20px;
    -unity-text-align: middle-center;
}

.btn-contract:hover {
    background-color: rgb(46, 204, 113);
}

.btn-contract--disabled {
    background-color: rgb(42, 51, 71);
    color: rgb(90, 103, 128);
}

.loan-empty {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    margin-top: 10px;
}
