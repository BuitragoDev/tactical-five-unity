/* ══════════════════════════════════════════
   LOANS — Loans.uss
   ══════════════════════════════════════════ */

.loans-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ══ SCREEN HEADER ══ */
.screen-header.panel--gold {
    flex-shrink: 0;
    padding: 0;
    margin: 16px 20px 12px 20px;
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    background-color: rgb(33, 32, 28);
    border-radius: 4px;
    overflow: hidden;
}
.screen-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    background-color: rgb(33, 32, 28);
}
.screen-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    white-space: normal;
}

.loans-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.loans-content {
    flex-direction: column;
    flex-grow: 1;
    overflow-y: auto;
    padding: 16px 20px 20px 20px;
}

/* ── FINANCIAL STAFF ── */

.fin-staff-section {
    flex-direction: column;
    margin-bottom: 24px;
}

.fin-staff-body {
    flex-direction: row;
}

.fin-staff-card {
    flex-direction: row;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 14px 18px;
    min-width: 320px;
}

.fin-staff-icon {
    width: 64px;
    height: 64px;
    margin-right: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.fin-staff-info {
    flex-direction: column;
    flex-grow: 1;
}

.fin-staff-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(208, 216, 232);
    -unity-text-transform: upper;
}

.fin-staff-star {
    width: 18px;
    height: 18px;
    margin-right: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.fin-staff-star--empty {
    opacity: 0.25;
}

.fin-staff-interest {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    margin-top: 4px;
}

.section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
    margin-bottom: 12px;
}

.fin-staff-empty {
    flex-direction: column;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px 18px;
    min-width: 320px;
}

.fin-staff-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
}

/* ── LOANS ── */

.loans-section {
    flex-direction: column;
    flex-grow: 1;
}

.loans-container {
    flex-direction: row;
}

.loan-slot {
    flex: 1;
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 14px;
    margin-right: 12px;
}

.loan-slot--active {
    border-color: rgb(212, 160, 23);
}

.loan-header {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
    -unity-text-transform: upper;
    margin-bottom: 14px;
}

.loan-amount-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.loan-months-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.loan-spin-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    flex-grow: 1;
}

.btn-spin {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
    width: 36px;
    height: 36px;
    background-color: rgb(42, 51, 71);
    flex-shrink: 0;
    border-width: 0;
    padding: 0;
}

.btn-spin:hover {
    background-color: rgb(58, 74, 99);
}

.btn-spin--disabled {
    background-color: rgb(30, 34, 46);
    color: rgb(80, 90, 110);
}

.loan-payment-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
    padding: 10px 0;
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
}

.loan-payment-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    flex-grow: 1;
}

.loan-payment-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    color: rgb(39, 174, 96);
}

.loan-actions-row {
    flex-direction: row;
    justify-content: flex-end;
    gap: 10px;
}

.btn-pay {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(35, 25, 30);
    border-width: 2px;
    border-color: rgb(192, 57, 43);
    color: rgb(230, 120, 100);
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 8px 20px;
    border-radius: 6px;
    -unity-text-align: middle-center;
    cursor: pointer;
}

.btn-pay:hover {
    background-color: rgb(62, 30, 32);
    color: rgb(240, 145, 125);
}

.btn-pay--disabled {
    background-color: rgb(26, 30, 38);
    border-color: rgb(100, 110, 130);
    color: rgb(120, 130, 150);
    cursor: default;
}

.btn-contract {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(20, 36, 35);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
    color: rgb(100, 200, 140);
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 8px 20px;
    border-radius: 6px;
    -unity-text-align: middle-center;
    cursor: pointer;
    margin-left: 8px;
}

.btn-contract:hover {
    background-color: rgb(23, 59, 45);
    color: rgb(150, 220, 180);
}

.btn-contract--disabled {
    background-color: rgb(26, 30, 38);
    border-color: rgb(100, 110, 130);
    color: rgb(120, 130, 150);
    cursor: default;
}

.loan-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    margin-top: 10px;
}

.btn-hire {
    width: 100%;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    letter-spacing: 2px;
    background-color: rgb(20, 28, 45);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(120, 160, 230);
    border-radius: 8px;
    padding: 12px 20px;
    cursor: pointer;
    -unity-text-align: middle-center;
    margin-top: 8px;
}

.btn-hire:hover {
    background-color: rgb(24, 40, 71);
    color: rgb(150, 190, 255);
}
