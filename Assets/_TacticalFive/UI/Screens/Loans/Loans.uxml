<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="../Loans/Loans.uss" />
    <Style src="../Dashboard/Dashboard.uss" />

    <ui:VisualElement name="LoansRoot" class="loans-root">

        <!-- ══ SIDEBAR ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="loans-main">

            <!-- TOP HEADER -->

            <!-- CONTENT -->
            <ui:VisualElement class="loans-content">

                <!-- FINANCIAL STAFF -->
                <ui:VisualElement name="FinanceStaffSection" class="fin-staff-section">
                    <ui:Label class="section-title" text="DIRECTOR FINANCIERO" />
                    <ui:VisualElement name="FinStaffBody" class="fin-staff-body" />
                </ui:VisualElement>

                <!-- LOAN SLOTS -->
                <ui:VisualElement name="LoansSection" class="loans-section">
                    <ui:Label class="section-title" text="PRÉSTAMOS ACTIVOS" />
                    <ui:VisualElement name="LoansContainer" class="loans-container" />

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
