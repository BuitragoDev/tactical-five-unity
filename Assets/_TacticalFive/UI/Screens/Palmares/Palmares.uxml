<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_TacticalFive/UI/Screens/Palmares/Palmares.uss?fileID=7433441132597879392&amp;guid=bcb1c02da2808c2d3adecb6499a1fffc&amp;type=3#Palmares"/>
    <Style src="project://database/Assets/_TacticalFive/UI/Screens/Dashboard/Dashboard.uss?fileID=7433441132597879392&amp;guid=4ea72934f300e2fc78940e1d76d7e1a8&amp;type=3#Dashboard"/>
    <Style src="../LegalNotice/LegalNotice.uss" />
<ui:VisualElement name="PalmaresRoot" class="palmares-root">
        
        <ui:VisualElement class="palmares-main">

            <ui:VisualElement class="palmares-content">
                <ui:VisualElement class="palmares-tabs" style="border-left-width: 17px; border-top-width: 10px;">
                    <ui:Button name="TabEquipos" text="EQUIPOS" class="palmares-tab"/>
                    <ui:Button name="TabJugadores" text="JUGADORES" class="palmares-tab"/>
                    <ui:Button name="TabQuintetos" text="QUINTETOS" class="palmares-tab"/>
                </ui:VisualElement>

                <!-- ══ TAB: EQUIPOS ══ -->
                <ui:VisualElement name="TabContentEquipos" class="palmares-tab-content">
                    <ui:VisualElement class="palmares-split">
                        <ui:VisualElement class="palmares-left">
                            <ui:Label class="palmares-section-title" text="CLASIFICACIÓN POR TÍTULOS" />
                            <ui:VisualElement class="palmares-scroll-wrapper">
                                <ui:ScrollView name="TitlesRankingScroll" class="palmares-left-scroll" horizontal-scrolling-enabled="false" mode="Vertical">
                                    <ui:VisualElement name="TitlesRankingBody" class="champs-list" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="palmares-right">
                            <ui:Label class="palmares-section-title" text="HISTORIAL DE FINALES" />
                            <ui:VisualElement class="palmares-table-header">
                                <ui:Label class="th-season" text="TEMPORADA" />
                                <ui:Label class="th-champ" text="CAMPEÓN" />
                                <ui:Label class="th-finalist" text="FINALISTA" />
                                <ui:Label class="th-result" text="RESULTADO" />
                                <ui:Label class="th-mvp" text="MVP FINALES" />
                            </ui:VisualElement>
                            <ui:VisualElement class="palmares-scroll-wrapper">
                                <ui:ScrollView name="FinalsHistoryScroll" class="palmares-right-scroll" horizontal-scrolling-enabled="false" mode="Vertical">
                                    <ui:VisualElement name="FinalsHistoryBody" class="palmares-table-body" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ══ TAB: JUGADORES ══ -->
                <ui:VisualElement name="TabContentJugadores" class="palmares-tab-content" style="display: none;">
                    <ui:VisualElement class="palmares-split">
                        <ui:VisualElement class="palmares-left">
                            <ui:Label class="palmares-section-title" text="CLASIFICACIÓN MVP" />
                            <ui:VisualElement class="palmares-scroll-wrapper">
                                <ui:ScrollView name="MVPRankingScroll" class="palmares-left-scroll" horizontal-scrolling-enabled="false" mode="Vertical">
                                    <ui:VisualElement name="MVPRankingBody" class="champs-list" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="palmares-right">
                            <ui:Label class="palmares-section-title" text="HISTORIAL DE PREMIOS" />
                            <ui:VisualElement class="palmares-table-header">
                                <ui:Label class="th-season" text="TEMPORADA" />
                                <ui:Label class="th-mvp" text="MVP TEMPORADA" />
                                <ui:Label class="th-rating" text="VAL. MEDIA" />
                                <ui:Label class="th-rookie" text="ROOKIE DEL AÑO" />
                                <ui:Label class="th-rating" text="VAL. MEDIA" />
                            </ui:VisualElement>
                            <ui:VisualElement class="palmares-scroll-wrapper">
                                <ui:ScrollView name="AwardsHistoryScroll" class="palmares-right-scroll" horizontal-scrolling-enabled="false" mode="Vertical">
                                    <ui:VisualElement name="AwardsHistoryBody" class="palmares-table-body" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ══ TAB: QUINTETOS ══ -->
                <ui:VisualElement name="TabContentQuintetos" class="palmares-tab-content" style="display: none;">
                    <ui:VisualElement class="palmares-split">
                        <ui:VisualElement class="palmares-left">
                            <ui:Label class="palmares-section-title" text="APARICIONES EN QUINTETO" />
                            <ui:VisualElement class="palmares-scroll-wrapper">
                                <ui:ScrollView name="QuintetAppearancesScroll" class="palmares-left-scroll" horizontal-scrolling-enabled="false" mode="Vertical">
                                    <ui:VisualElement name="QuintetAppearancesBody" class="champs-list" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="palmares-right">
                            <ui:Label class="palmares-section-title" text="HISTORIAL DE QUINTETOS" />
                            <ui:VisualElement class="palmares-table-header">
                                <ui:Label class="th-season" text="TEMPORADA" />
                                <ui:Label class="th-quintet-pos" text="BASE" />
                                <ui:Label class="th-quintet-pos" text="ESCOLTA" />
                                <ui:Label class="th-quintet-pos" text="ALERO" />
                                <ui:Label class="th-quintet-pos" text="ALA-PIVOT" />
                                <ui:Label class="th-quintet-pos" text="PIVOT" />
                            </ui:VisualElement>
                            <ui:VisualElement class="palmares-scroll-wrapper">
                                <ui:ScrollView name="QuintetHistoryScroll" class="palmares-right-scroll" horizontal-scrolling-enabled="false" mode="Vertical">
                                    <ui:VisualElement name="QuintetHistoryBody" class="palmares-table-body" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

        <!-- ══ MODAL CONFIGURACIÓN ══ -->
        <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigModalBox" class="modal-box">
                <ui:Label class="modal-title" text="CONFIGURACIÓN" />
                <ui:VisualElement class="modal-body">
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="AUDIO" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="Volumen General" />
                            <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="Música" />
                            <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="Efectos" />
                            <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="GRÁFICOS" />
                        <ui:VisualElement class="settings-quality-row">
                            <ui:Label class="settings-label" text="Calidad" />
                            <ui:VisualElement class="settings-quality-options">
                                <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="Baja" />
                                <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="Media" />
                                <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="Alta" />
                                <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="Ultra" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="JUEGO" />
                        <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="VOLVER AL MENÚ PRINCIPAL" />
                        <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="SALIR DEL JUEGO" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ConfigBtnCerrar" class="modal-close" text="CERRAR" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR VOLVER AL MENÚ PRINCIPAL ══ -->
        <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="VOLVER AL MENÚ PRINCIPAL" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="¿Estás seguro de que quieres volver al menú principal?" />
                    <ui:Label class="modal-paragraph" text="Se perderá el progreso no guardado de la partida actual. Asegúrate de haber guardado antes de continuar." />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="NO, QUEDARME" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="SÍ, VOLVER" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR SALIR DEL JUEGO ══ -->
        <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="SALIR DEL JUEGO" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="¿Estás seguro de que quieres salir del juego?" />
                    <ui:Label class="modal-paragraph" text="Se cerrará la aplicación. Asegúrate de haber guardado tu progreso si lo deseas." />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="NO" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="SÍ, SALIR" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
</ui:UXML>
