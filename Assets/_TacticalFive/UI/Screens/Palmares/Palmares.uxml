<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_TacticalFive/UI/Screens/Palmares/Palmares.uss?fileID=7433441132597879392&amp;guid=bcb1c02da2808c2d3adecb6499a1fffc&amp;type=3#Palmares"/>
    <Style src="project://database/Assets/_TacticalFive/UI/Screens/Dashboard/Dashboard.uss?fileID=7433441132597879392&amp;guid=4ea72934f300e2fc78940e1d76d7e1a8&amp;type=3#Dashboard"/>
    <ui:VisualElement name="PalmaresRoot" class="palmares-root">
        <ui:VisualElement name="Sidebar" class="sidebar">
            <ui:VisualElement class="sidebar-logo">
                <ui:Label text="TF" class="sidebar-logo-icon"/>
                <ui:Label text="TACTICAL" class="sidebar-logo-text"/>
                <ui:Label text="FIVE" class="sidebar-logo-text-gold"/>
            </ui:VisualElement>
            <ui:VisualElement class="sidebar-nav">
                <ui:Button name="NavDashboard" text="INICIO" class="nav-item"/>
                <ui:Button name="NavRoster" text="PLANTILLA" class="nav-item"/>
                <ui:Button name="NavCalendar" text="CALENDARIO" class="nav-item"/>
                <ui:Button name="NavStandings" text="CLASIFICACIÓN" class="nav-item"/>
                <ui:Button name="NavPalmares" text="PALMARES" class="nav-item nav-item--active"/>
                <ui:Button name="NavResults" text="RESULTADOS" class="nav-item"/>
                <ui:Button name="NavPlayoffs" text="PLAYOFFS" class="nav-item"/>
                <ui:Button name="NavStats" text="ESTADÍSTICAS" class="nav-item"/>
                <ui:Button name="NavRecords" text="RECORDS" class="nav-item"/>
                <ui:Button name="NavMarket" text="MERCADO" class="nav-item"/>
                <ui:Button name="NavFinances" text="FINANZAS" class="nav-item"/>
                <ui:Button name="NavSponsors" text="PATROCINADORES" class="nav-item"/>
                <ui:Button name="NavTV" text="TELEVISIÓN" class="nav-item"/>
                <ui:Button name="NavArena" text="PABELLÓN" class="nav-item"/>
                <ui:Button name="NavMessages" text="MENSAJES" class="nav-item"/>
            </ui:VisualElement>
            <ui:VisualElement class="sidebar-footer">
                <ui:Button name="BtnReset" text="  REINICIAR PARTIDA" class="btn-reset"/>
                <ui:Label text="v0.1.0 · Alpha" class="sidebar-version"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="palmares-main">
            <ui:VisualElement name="TopHeader" class="top-header">
                <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo"/>
                <ui:VisualElement class="header-team-info">
                    <ui:Label name="HeaderTeamName" text="" class="header-team-name"/>
                    <ui:Label name="HeaderManagerName" text="" class="header-manager-name"/>
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label text="PRESUPUESTO" class="header-stat-label"/>
                    <ui:Label name="HeaderBudget" text="" class="header-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label text="MASA SALARIAL" class="header-stat-label"/>
                    <ui:Label name="HeaderPayroll" text="" class="header-stat-value header-stat-value--neutral"/>
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label text="MARGEN SALARIAL" class="header-stat-label"/>
                    <ui:Label name="HeaderMargin" text="" class="header-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="header-spacer"/>
                <ui:VisualElement class="header-season-info">
                    <ui:Label name="HeaderSeason" text="" class="header-season-label"/>
                    <ui:Label name="HeaderDate" text="" class="header-date-label"/>
                </ui:VisualElement>
                <ui:Button name="BtnAction" text="CONTINUAR →" class="btn-action"/>
            </ui:VisualElement>
            <ui:VisualElement class="palmares-content">
                <ui:VisualElement class="palmares-tabs" style="border-left-width: 17px; border-top-width: 10px;">
                    <ui:Button name="TabEquipos" text="EQUIPOS" class="palmares-tab"/>
                    <ui:Button name="TabJugadores" text="JUGADORES" class="palmares-tab"/>
                    <ui:Button name="TabQuintetos" text="QUINTETOS" class="palmares-tab"/>
                </ui:VisualElement>
                <ui:VisualElement name="TabContentEquipos" class="palmares-tab-content">
                    <ui:ScrollView horizontal-scrolling-enabled="false" mode="Vertical" class="palmares-scroll">
                        <ui:VisualElement class="palmares-tab-inner">
                            <ui:VisualElement class="panel panel-palmares">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label text="CAMPEONES NBA" class="panel-title"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="ChampionsBody" class="palmares-table"/>
                                <ui:Label name="NoChampionsText" text="AÚN NO HAY TEMPORADAS FINALIZADAS" class="no-data-text"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="panel panel-palmares">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label text="CAMPEONES DE CONFERENCIA" class="panel-title"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="ConfChampionsBody" class="palmares-table"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="panel panel-palmares">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label text="CAMPEONES DE DIVISIÓN" class="panel-title"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="DivChampionsBody" class="palmares-table"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement name="TabContentJugadores" class="palmares-tab-content" style="display: none;">
                    <ui:ScrollView horizontal-scrolling-enabled="false" mode="Vertical" class="palmares-scroll">
                        <ui:VisualElement class="palmares-tab-inner">
                            <ui:VisualElement class="panel panel-palmares">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label text="MVP" class="panel-title"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="MVPBody" class="palmares-table"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="panel panel-palmares">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label text="ROOKIE DEL AÑO" class="panel-title"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="RookieBody" class="palmares-table"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="panel panel-palmares">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label text="MEJOR DEFENSOR" class="panel-title"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="DefenderBody" class="palmares-table"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="panel panel-palmares">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label text="MEJOR SEXTO HOMBRE" class="panel-title"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="SixthManBody" class="palmares-table"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="panel panel-palmares">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label text="JUGADOR MÁS MEJORADO" class="panel-title"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="ImprovedBody" class="palmares-table"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement name="TabContentQuintetos" class="palmares-tab-content" style="display: none;">
                    <ui:ScrollView horizontal-scrolling-enabled="false" mode="Vertical" class="palmares-scroll">
                        <ui:VisualElement class="palmares-tab-inner">
                            <ui:VisualElement class="panel panel-palmares">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label text="MEJOR QUINTETO" class="panel-title"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="FirstTeamBody" class="palmares-quinteto"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="panel panel-palmares">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label text="SEGUNDO MEJOR QUINTETO" class="panel-title"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="SecondTeamBody" class="palmares-quinteto"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
