<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Palmares.uss" />
    <Style src="../Dashboard/Dashboard.uss" />

    <ui:VisualElement name="PalmaresRoot" class="palmares-root">

        <!-- ══ SIDEBAR ══ -->
        <ui:VisualElement name="Sidebar" class="sidebar">
            <ui:VisualElement class="sidebar-logo">
                <ui:Label class="sidebar-logo-icon" text="TF" />
                <ui:Label class="sidebar-logo-text" text="TACTICAL" />
                <ui:Label class="sidebar-logo-text-gold" text="FIVE" />
            </ui:VisualElement>
            <ui:VisualElement class="sidebar-nav">
                <ui:Button name="NavDashboard"  class="nav-item" text="INICIO" />
                <ui:Button name="NavRoster"     class="nav-item" text="PLANTILLA" />
                <ui:Button name="NavCalendar"   class="nav-item" text="CALENDARIO" />
                <ui:Button name="NavStandings"  class="nav-item" text="CLASIFICACIÓN" />
                <ui:Button name="NavPalmares"   class="nav-item nav-item--active" text="PALMARES" />
                <ui:Button name="NavResults"    class="nav-item" text="RESULTADOS" />
                <ui:Button name="NavPlayoffs"   class="nav-item" text="PLAYOFFS" />
                <ui:Button name="NavStats"      class="nav-item" text="ESTADÍSTICAS" />
                <ui:Button name="NavRecords"    class="nav-item" text="RECORDS" />
                <ui:Button name="NavMarket"     class="nav-item" text="MERCADO" />
                <ui:Button name="NavFinances"   class="nav-item" text="FINANZAS" />
                <ui:Button name="NavSponsors"   class="nav-item" text="PATROCINADORES" />
                <ui:Button name="NavTV"         class="nav-item" text="TELEVISIÓN" />
                <ui:Button name="NavArena"      class="nav-item" text="PABELLÓN" />
                <ui:Button name="NavMessages"   class="nav-item" text="MENSAJES" />
            </ui:VisualElement>
            <ui:VisualElement class="sidebar-footer">
                <ui:Button name="BtnReset" class="btn-reset" text="  REINICIAR PARTIDA" />
                <ui:Label class="sidebar-version" text="v0.1.0 · Alpha" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="palmares-main">

            <!-- TOP HEADER -->
            <ui:VisualElement name="TopHeader" class="top-header">
                <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo" />
                <ui:VisualElement class="header-team-info">
                    <ui:Label name="HeaderTeamName"    class="header-team-name"    text="" />
                    <ui:Label name="HeaderManagerName" class="header-manager-name" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="PRESUPUESTO" />
                    <ui:Label name="HeaderBudget" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MASA SALARIAL" />
                    <ui:Label name="HeaderPayroll" class="header-stat-value header-stat-value--neutral" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label class="header-stat-label" text="MARGEN SALARIAL" />
                    <ui:Label name="HeaderMargin" class="header-stat-value" text="" />
                </ui:VisualElement>
                <ui:VisualElement class="header-spacer" />
                <ui:VisualElement class="header-season-info">
                    <ui:Label name="HeaderSeason" class="header-season-label" text="" />
                    <ui:Label name="HeaderDate"   class="header-date-label"   text="" />
                </ui:VisualElement>
                <ui:Button name="BtnAction" class="btn-action" text="CONTINUAR →" />
            </ui:VisualElement>

            <!-- PALMARES CONTENT -->
            <ui:VisualElement class="palmares-content">

                <!-- Tabs -->
                <ui:VisualElement class="palmares-tabs">
                    <ui:Button name="TabEquipos" class="palmares-tab" text="EQUIPOS" />
                    <ui:Button name="TabJugadores" class="palmares-tab" text="JUGADORES" />
                    <ui:Button name="TabQuintetos" class="palmares-tab" text="QUINTETOS" />
                </ui:VisualElement>

                <!-- EQUIPOS TAB -->
                <ui:VisualElement name="TabContentEquipos" class="palmares-tab-content">
                    <ui:ScrollView class="palmares-scroll"
                                   horizontal-scrolling-enabled="false"
                                   mode="Vertical">
                        <ui:VisualElement class="palmares-tab-inner">

                            <!-- Champions -->
                            <ui:VisualElement class="panel panel-palmares">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label class="panel-title" text="CAMPEONES NBA" />
                                </ui:VisualElement>
                                <ui:VisualElement name="ChampionsBody" class="palmares-table" />
                                <ui:Label name="NoChampionsText" class="no-data-text" text="AÚN NO HAY TEMPORADAS FINALIZADAS" />
                            </ui:VisualElement>

                            <!-- Conference Champions -->
                            <ui:VisualElement class="panel panel-palmares">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label class="panel-title" text="CAMPEONES DE CONFERENCIA" />
                                </ui:VisualElement>
                                <ui:VisualElement name="ConfChampionsBody" class="palmares-table" />
                            </ui:VisualElement>

                            <!-- Division Champions -->
                            <ui:VisualElement class="panel panel-palmares">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label class="panel-title" text="CAMPEONES DE DIVISIÓN" />
                                </ui:VisualElement>
                                <ui:VisualElement name="DivChampionsBody" class="palmares-table" />
                            </ui:VisualElement>

                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>

                <!-- JUGADORES TAB -->
                <ui:VisualElement name="TabContentJugadores" class="palmares-tab-content" style="display: none;">
                    <ui:ScrollView class="palmares-scroll"
                                   horizontal-scrolling-enabled="false"
                                   mode="Vertical">
                        <ui:VisualElement class="palmares-tab-inner">

                            <!-- MVP -->
                            <ui:VisualElement class="panel panel-palmares">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label class="panel-title" text="MVP" />
                                </ui:VisualElement>
                                <ui:VisualElement name="MVPBody" class="palmares-table" />
                            </ui:VisualElement>

                            <!-- Rookie -->
                            <ui:VisualElement class="panel panel-palmares">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label class="panel-title" text="ROOKIE DEL AÑO" />
                                </ui:VisualElement>
                                <ui:VisualElement name="RookieBody" class="palmares-table" />
                            </ui:VisualElement>

                            <!-- Best Defender -->
                            <ui:VisualElement class="panel panel-palmares">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label class="panel-title" text="MEJOR DEFENSOR" />
                                </ui:VisualElement>
                                <ui:VisualElement name="DefenderBody" class="palmares-table" />
                            </ui:VisualElement>

                            <!-- Best Sixth Man -->
                            <ui:VisualElement class="panel panel-palmares">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label class="panel-title" text="MEJOR SEXTO HOMBRE" />
                                </ui:VisualElement>
                                <ui:VisualElement name="SixthManBody" class="palmares-table" />
                            </ui:VisualElement>

                            <!-- Most Improved -->
                            <ui:VisualElement class="panel panel-palmares">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label class="panel-title" text="JUGADOR MÁS MEJORADO" />
                                </ui:VisualElement>
                                <ui:VisualElement name="ImprovedBody" class="palmares-table" />
                            </ui:VisualElement>

                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>

                <!-- QUINTETOS TAB -->
                <ui:VisualElement name="TabContentQuintetos" class="palmares-tab-content" style="display: none;">
                    <ui:ScrollView class="palmares-scroll"
                                   horizontal-scrolling-enabled="false"
                                   mode="Vertical">
                        <ui:VisualElement class="palmares-tab-inner">

                            <!-- First Team -->
                            <ui:VisualElement class="panel panel-palmares">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label class="panel-title" text="MEJOR QUINTETO" />
                                </ui:VisualElement>
                                <ui:VisualElement name="FirstTeamBody" class="palmares-quinteto" />
                            </ui:VisualElement>

                            <!-- Second Team -->
                            <ui:VisualElement class="panel panel-palmares">
                                <ui:VisualElement class="panel-header">
                                    <ui:Label class="panel-title" text="SEGUNDO MEJOR QUINTETO" />
                                </ui:VisualElement>
                                <ui:VisualElement name="SecondTeamBody" class="palmares-quinteto" />
                            </ui:VisualElement>

                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
