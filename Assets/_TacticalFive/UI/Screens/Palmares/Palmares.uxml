<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_TacticalFive/UI/Screens/Palmares/Palmares.uss?fileID=7433441132597879392&amp;guid=bcb1c02da2808c2d3adecb6499a1fffc&amp;type=3#Palmares"/>
    <Style src="project://database/Assets/_TacticalFive/UI/Screens/Dashboard/Dashboard.uss?fileID=7433441132597879392&amp;guid=4ea72934f300e2fc78940e1d76d7e1a8&amp;type=3#Dashboard"/>
    <ui:VisualElement name="PalmaresRoot" class="palmares-root">
        <ui:VisualElement name="Sidebar" class="sidebar">
            <ui:VisualElement class="sidebar-logo">
                <ui:Label text="TF" class="sidebar-logo-icon"/>
                <ui:Label text="TACTICAL" class="sidebar-logo-text"/>
                <ui:Label text="FIVE" class="sidebar-logo-text-gold"/>
            </ui:VisualElement>
            <ui:VisualElement class="sidebar-nav">
                <ui:Button name="NavDashboard" class="nav-item">
                    <ui:VisualElement name="NavDashboardIcon" class="nav-icon"/>
                    <ui:Label text="Inicio" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavRoster" class="nav-item">
                    <ui:VisualElement name="NavRosterIcon" class="nav-icon"/>
                    <ui:Label text="Plantilla" class="nav-label"/>
                    <ui:Label text="▼" class="nav-arrow" />
                </ui:Button>
                <ui:VisualElement name="RosterSubmenu" class="nav-submenu">
                    <ui:Button name="SubmenuJugadores" class="nav-submenu-item">
                        <ui:Label text="Jugadores" class="nav-submenu-label"/>
                    </ui:Button>
                    <ui:Button name="SubmenuEmpleados" class="nav-submenu-item">
                        <ui:Label text="Empleados" class="nav-submenu-label"/>
                    </ui:Button>
                    <ui:Button name="SubmenuLesionados" class="nav-submenu-item">
                        <ui:Label text="Lesionados" class="nav-submenu-label"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:Button name="NavCalendar" class="nav-item">
                    <ui:VisualElement name="NavCalendarIcon" class="nav-icon"/>
                    <ui:Label text="Calendario" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavStandings" class="nav-item">
                    <ui:VisualElement name="NavStandingsIcon" class="nav-icon"/>
                    <ui:Label text="Clasificación" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavPalmares" class="nav-item nav-item--active">
                    <ui:VisualElement name="NavPalmaresIcon" class="nav-icon"/>
                    <ui:Label text="Palmarés" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavResults" class="nav-item">
                    <ui:VisualElement name="NavResultsIcon" class="nav-icon"/>
                    <ui:Label text="Resultados" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavPlayoffs" class="nav-item">
                    <ui:VisualElement name="NavPlayoffsIcon" class="nav-icon"/>
                    <ui:Label text="Playoffs" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavStats" class="nav-item">
                    <ui:VisualElement name="NavStatsIcon" class="nav-icon"/>
                    <ui:Label text="Estadísticas" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavRecords" class="nav-item">
                    <ui:VisualElement name="NavRecordsIcon" class="nav-icon"/>
                    <ui:Label text="Records" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavMarket" class="nav-item">
                    <ui:VisualElement name="NavMarketIcon" class="nav-icon" />
                    <ui:Label class="nav-label" text="Mercado" />
                    <ui:Label text="▼" class="nav-arrow" />
                </ui:Button>
                <ui:VisualElement name="MarketSubmenu" class="nav-submenu">
                    <ui:Button name="SubmenuOfertas" class="nav-submenu-item">
                        <ui:Label text="Ofertas" class="nav-submenu-label"/>
                    </ui:Button>
                    <ui:Button name="SubmenuCartera" class="nav-submenu-item">
                        <ui:Label text="Cartera" class="nav-submenu-label"/>
                    </ui:Button>
                    <ui:Button name="SubmenuHistorial" class="nav-submenu-item">
                        <ui:Label text="Historial" class="nav-submenu-label"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:Button name="NavFinances" class="nav-item">
                    <ui:VisualElement name="NavFinancesIcon" class="nav-icon"/>
                    <ui:Label text="Finanzas" class="nav-label"/>
                    <ui:Label text="▼" class="nav-arrow" />
                </ui:Button>
                <ui:VisualElement name="FinanceSubmenu" class="nav-submenu">
                    <ui:Button name="SubmenuDecisiones" class="nav-submenu-item">
                        <ui:Label text="Decisiones" class="nav-submenu-label"/>
                    </ui:Button>
                    <ui:Button name="SubmenuPrestamos" class="nav-submenu-item">
                        <ui:Label text="Préstamos Bancarios" class="nav-submenu-label"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:Button name="NavSponsors" class="nav-item">
                    <ui:VisualElement name="NavSponsorsIcon" class="nav-icon"/>
                    <ui:Label text="Patrocinadores" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavTV" class="nav-item">
                    <ui:VisualElement name="NavTVIcon" class="nav-icon"/>
                    <ui:Label text="Televisión" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavArena" class="nav-item">
                    <ui:VisualElement name="NavArenaIcon" class="nav-icon"/>
                    <ui:Label text="Pabellón" class="nav-label"/>
                </ui:Button>
                <ui:Button name="NavMessages" class="nav-item">
                    <ui:VisualElement name="NavMessagesIcon" class="nav-icon"/>
                    <ui:Label text="Mensajes" class="nav-label"/>
                </ui:Button>

            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="palmares-main">
            <ui:VisualElement name="TopHeader" class="top-header">
                <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo"/>
                <ui:VisualElement class="header-team-info">
                    <ui:Label name="HeaderTeamName" text="" class="header-team-name"/>
                    <ui:Label name="HeaderManagerName" text="" class="header-manager-name"/>
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label text="PRESUPUESTO" class="header-stat-label"/>
                    <ui:Label name="HeaderBudget" text="" class="header-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label text="MASA SALARIAL" class="header-stat-label"/>
                    <ui:Label name="HeaderPayroll" text="" class="header-stat-value header-stat-value--neutral"/>
                </ui:VisualElement>
                <ui:VisualElement class="header-stat">
                    <ui:Label text="MARGEN SALARIAL" class="header-stat-label"/>
                    <ui:Label name="HeaderMargin" text="" class="header-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="header-spacer"/>
                <ui:VisualElement class="header-season-info">
                    <ui:Label name="HeaderSeason" text="" class="header-season-label"/>
                    <ui:Label name="HeaderDate" text="" class="header-date-label"/>
                </ui:VisualElement>
                <ui:Button name="BtnAction" text="CONTINUAR" class="btn-action"/>
                <ui:VisualElement name="ConfigIcon" class="header-config-icon" />
            </ui:VisualElement>
            <ui:VisualElement class="palmares-content">
                <ui:VisualElement class="palmares-tabs" style="border-left-width: 17px; border-top-width: 10px;">
                    <ui:Button name="TabEquipos" text="EQUIPOS" class="palmares-tab"/>
                    <ui:Button name="TabJugadores" text="JUGADORES" class="palmares-tab"/>
                    <ui:Button name="TabQuintetos" text="QUINTETOS" class="palmares-tab"/>
                </ui:VisualElement>

                <!-- ══ TAB: EQUIPOS ══ -->
                <ui:VisualElement name="TabContentEquipos" class="palmares-tab-content">
                    <ui:VisualElement class="palmares-split">
                        <ui:VisualElement class="palmares-left">
                            <ui:Label class="palmares-section-title" text="CLASIFICACIÓN POR TÍTULOS" />
                            <ui:VisualElement class="palmares-scroll-wrapper">
                                <ui:ScrollView name="TitlesRankingScroll" class="palmares-left-scroll" horizontal-scrolling-enabled="false" mode="Vertical">
                                    <ui:VisualElement name="TitlesRankingBody" class="champs-list" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="palmares-right">
                            <ui:Label class="palmares-section-title" text="HISTORIAL DE FINALES" />
                            <ui:VisualElement class="palmares-table-header">
                                <ui:Label class="th-season" text="TEMPORADA" />
                                <ui:Label class="th-champ" text="CAMPEÓN" />
                                <ui:Label class="th-finalist" text="FINALISTA" />
                                <ui:Label class="th-result" text="RESULTADO" />
                                <ui:Label class="th-mvp" text="MVP FINALES" />
                            </ui:VisualElement>
                            <ui:VisualElement class="palmares-scroll-wrapper">
                                <ui:ScrollView name="FinalsHistoryScroll" class="palmares-right-scroll" horizontal-scrolling-enabled="false" mode="Vertical">
                                    <ui:VisualElement name="FinalsHistoryBody" class="palmares-table-body" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ══ TAB: JUGADORES ══ -->
                <ui:VisualElement name="TabContentJugadores" class="palmares-tab-content" style="display: none;">
                    <ui:VisualElement class="palmares-split">
                        <ui:VisualElement class="palmares-left">
                            <ui:Label class="palmares-section-title" text="CLASIFICACIÓN MVP" />
                            <ui:VisualElement class="palmares-scroll-wrapper">
                                <ui:ScrollView name="MVPRankingScroll" class="palmares-left-scroll" horizontal-scrolling-enabled="false" mode="Vertical">
                                    <ui:VisualElement name="MVPRankingBody" class="champs-list" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="palmares-right">
                            <ui:Label class="palmares-section-title" text="HISTORIAL DE PREMIOS" />
                            <ui:VisualElement class="palmares-table-header">
                                <ui:Label class="th-season" text="TEMPORADA" />
                                <ui:Label class="th-mvp" text="MVP TEMPORADA" />
                                <ui:Label class="th-rating" text="VAL. MEDIA" />
                                <ui:Label class="th-rookie" text="ROOKIE DEL AÑO" />
                                <ui:Label class="th-rating" text="VAL. MEDIA" />
                            </ui:VisualElement>
                            <ui:VisualElement class="palmares-scroll-wrapper">
                                <ui:ScrollView name="AwardsHistoryScroll" class="palmares-right-scroll" horizontal-scrolling-enabled="false" mode="Vertical">
                                    <ui:VisualElement name="AwardsHistoryBody" class="palmares-table-body" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ══ TAB: QUINTETOS ══ -->
                <ui:VisualElement name="TabContentQuintetos" class="palmares-tab-content" style="display: none;">
                    <ui:VisualElement class="palmares-split">
                        <ui:VisualElement class="palmares-left">
                            <ui:Label class="palmares-section-title" text="APARICIONES EN QUINTETO" />
                            <ui:VisualElement class="palmares-scroll-wrapper">
                                <ui:ScrollView name="QuintetAppearancesScroll" class="palmares-left-scroll" horizontal-scrolling-enabled="false" mode="Vertical">
                                    <ui:VisualElement name="QuintetAppearancesBody" class="champs-list" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="palmares-right">
                            <ui:Label class="palmares-section-title" text="HISTORIAL DE QUINTETOS" />
                            <ui:VisualElement class="palmares-table-header">
                                <ui:Label class="th-season" text="TEMPORADA" />
                                <ui:Label class="th-quintet-pos" text="PG" />
                                <ui:Label class="th-quintet-pos" text="SG" />
                                <ui:Label class="th-quintet-pos" text="SF" />
                                <ui:Label class="th-quintet-pos" text="PF" />
                                <ui:Label class="th-quintet-pos" text="C" />
                            </ui:VisualElement>
                            <ui:VisualElement class="palmares-scroll-wrapper">
                                <ui:ScrollView name="QuintetHistoryScroll" class="palmares-right-scroll" horizontal-scrolling-enabled="false" mode="Vertical">
                                    <ui:VisualElement name="QuintetHistoryBody" class="palmares-table-body" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
