/* ══════════════════════════════════════════
   PALMARES — Palmares.uss
   ══════════════════════════════════════════ */

.palmares-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.palmares-title-box {
    flex-direction: row;
    align-items: center;
    margin: 16px 20px 0;
    padding: 10px 18px;
    border-width: 1px;
    border-color: rgb(42, 95, 201);
    background-color: rgba(42, 95, 201, 0.08);
}
.palmares-title-box-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 3px;
    color: rgb(208, 216, 232);
    text-transform: uppercase;
}

.palmares-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.palmares-content {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
}

.palmares-tabs {
    flex-direction: row;
    margin-bottom: 16px;
    margin-left: 3px;
    flex-shrink: 0;
}

.palmares-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 24px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-right: 6px;
}

.palmares-tab:hover {
    color: rgb(208, 216, 232);
    border-color: rgb(74, 128, 240);
}

.palmares-tab--active {
    background-color: rgb(28, 33, 48);
    border-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
}

.palmares-tab-content {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
}

/* ══ SPLIT LAYOUT ══ */

.palmares-split {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    padding: 0 20px 20px 20px;
    gap: 20px;
}

.palmares-left {
    flex: 0 0 20%;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    margin-right: 20px;
}

.palmares-right {
    flex: 1 1 80%;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}

.palmares-left-scroll {
    flex-grow: 1;
    height: 100%;
}

.palmares-scroll-wrapper {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    flex-direction: column;
}

.palmares-right-scroll {
    flex-grow: 1;
    height: 100%;
}

.palmares-section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

/* ══ LEFT: CHAMPS LIST (RANKING) ══ */

.champs-list {
    flex-direction: column;
    gap: 4px;
}

.champ-row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 10px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: transparent;
    transition-property: border-color;
    transition-duration: 0.15s;
}

.champ-row:hover {
    border-color: rgb(85, 102, 119);
}

.champ-rank {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    color: rgb(85, 102, 119);
    min-width: 20px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.champ-logo {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin-right: 10px;
}

.champ-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.champ-count {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    color: rgb(212, 160, 23);
    min-width: 24px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

/* ══ RIGHT: TABLE ══ */

.palmares-table {
    flex-direction: column;
    width: 100%;
}

.palmares-table-header {
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    padding-bottom: 0;
    flex-shrink: 0;
}

.palmares-table-header > Label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(85, 102, 119);
    height: 48px;
    padding: 0 12px;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.palmares-table-body {
    flex-direction: column;
}

.palmares-table-body > .palmares-data-row {
    flex-direction: row;
    align-items: center;
    height: 48px;
    padding: 0;
    flex-shrink: 0;
    overflow: hidden;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 51, 71, 0.5);
    transition-property: background-color;
    transition-duration: 0.1s;
}

.palmares-table-body > .palmares-data-row:hover {
    background-color: rgba(255, 255, 255, 0.02);
}

.palmares-table-body > .palmares-data-row > Label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    padding: 0 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mini-logo {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin-right: 10px;
}

/* --- Column widths: Equipos tab --- */

#TabContentEquipos .th-season,
#TabContentEquipos .td-season {
    width: 100px;
    flex-shrink: 0;
}

#TabContentEquipos .th-champ,
#TabContentEquipos .td-champ {
    flex: 1;
}

#TabContentEquipos .th-finalist,
#TabContentEquipos .td-finalist {
    flex: 1;
}

#TabContentEquipos .th-result,
#TabContentEquipos .td-result {
    width: 100px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

#TabContentEquipos .th-mvp,
#TabContentEquipos .td-mvp {
    flex: 1;
}

.td-season {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf") !important;
    font-size: 16px !important;
    color: rgb(85, 102, 119) !important;
    letter-spacing: 1px;
    white-space: nowrap !important;
}

.td-result {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf") !important;
    font-size: 16px !important;
    color: rgb(212, 160, 23) !important;
    -unity-text-align: middle-center;
    white-space: nowrap !important;
}

/* --- Column widths: Jugadores tab --- */

#TabContentJugadores .th-season,
#TabContentJugadores .td-season {
    width: 100px;
    flex-shrink: 0;
}

#TabContentJugadores .th-mvp,
#TabContentJugadores .td-mvp {
    flex: 1;
}

#TabContentJugadores .th-rating,
#TabContentJugadores .td-rating {
    width: 100px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

#TabContentJugadores .th-rookie,
#TabContentJugadores .td-rookie {
    flex: 1;
}

.td-rating {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf") !important;
    font-size: 16px !important;
    color: rgb(85, 102, 119) !important;
    -unity-text-align: middle-center;
    white-space: nowrap !important;
}

/* --- Column widths: Quintetos tab --- */

#TabContentQuintetos .th-season,
#TabContentQuintetos .td-season {
    width: 100px;
    flex-shrink: 0;
}

#TabContentQuintetos .th-quintet-pos,
#TabContentQuintetos .td-quintet-pos {
    flex: 1;
    -unity-text-align: middle-left;
}

/* Data row cell with logo + name */
.cell-with-logo {
    flex-direction: row;
    align-items: center;
    flex: 1;
    padding: 0 12px;
    overflow: hidden;
}

.cell-with-logo > Label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* No data */
.no-data-cell {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 14px;
    color: rgb(58, 74, 99);
    -unity-text-align: middle-center;
    padding: 24px;
    flex-grow: 1;
}

/* Hide scrollbar */
.palmares-left-scroll .unity-scroll-view__vertical-scroller,
.palmares-right-scroll .unity-scroll-view__vertical-scroller {
    display: none;
}

/* Sidebar / header from Dashboard.uss are inherited */
