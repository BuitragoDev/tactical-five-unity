/* ══════════════════════════════════════════
   PALMARES — Palmares.uss
   ══════════════════════════════════════════ */

.palmares-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ══ SCREEN HEADER ══ */
.screen-header.panel--gold {
    flex-shrink: 0;
    padding: 0;
    margin: 16px 20px 12px 20px;
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    background-color: rgba(120, 95, 30, 0.15);
    border-radius: 4px;
    overflow: hidden;
}
.screen-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    background-color: rgba(120, 95, 30, 0.15);
}
.screen-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    white-space: normal;
}
.screen-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(212, 160, 23);
    padding: 0 14px;
    background-color: rgba(120, 95, 30, 0.15);
}

.palmares-main {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
}

.palmares-content {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
}

.palmares-tabs {
    flex-direction: row;
    margin-bottom: 16px;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
}

.palmares-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 16px;
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: transparent;
    color: rgb(122, 138, 170);
    -unity-text-align: middle-center;
    margin-right: 2px;
}

.palmares-tab:hover {
    color: rgb(208, 216, 232);
}

.palmares-tab--active {
    color: rgb(212, 160, 23);
    border-bottom-color: rgb(212, 160, 23);
    background-color: transparent;
}

.palmares-tab-content {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
}

/* ══ SPLIT LAYOUT ══ */

.palmares-split {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    padding: 0 20px 20px 20px;
    gap: 20px;
}

/* La pantalla Rivalidades da ~200px más a la columna DINASTÍAS (su .uxml reutiliza estas clases). */
.palmares-root.rivalidades-split .palmares-left {
    flex: 0 0 34%;
}
.palmares-root.rivalidades-split .palmares-right {
    flex: 0 0 66%;
}

/* En Rivalidades el escudo de las filas es más grande (logos de 64). */
.palmares-root.rivalidades-split .rival-logo {
    width: 64px;
    height: 64px;
}

.palmares-left {
    flex: 0 0 20%;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    margin-right: 20px;
}

.palmares-right {
    flex: 1 1 80%;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}

.palmares-section-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

/* ══ LEFT: CHAMPS LIST (RANKING) ══ */

.champs-list {
    flex-direction: column;
    gap: 4px;
    flex-grow: 1;
    min-height: 0;
    flex-shrink: 0;
}

.champ-row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 10px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: transparent;
    transition-property: border-color;
    transition-duration: 0.15s;
}

.champ-row:hover {
    border-color: rgb(85, 102, 119);
}

.champ-rank {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: rgb(85, 102, 119);
    min-width: 20px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.champ-logo {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin-right: 10px;
}

.champ-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.champ-count {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(212, 160, 23);
    min-width: 24px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

/* ══ RIGHT: TABLE ══ */

.palmares-table {
    flex-direction: column;
    width: 100%;
}

.palmares-table-header {
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    padding-bottom: 0;
    flex-shrink: 0;
}

.palmares-table-header > Label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(85, 102, 119);
    height: 48px;
    padding: 0 12px;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.palmares-table-body {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    flex-shrink: 0;
}

.palmares-table-body > .palmares-data-row {
    flex-direction: row;
    align-items: center;
    height: 47px;
    padding: 0;
    flex-shrink: 0;
    overflow: hidden;
    border-bottom-width: 1px;
    border-bottom-color: rgba(42, 51, 71, 0.5);
    transition-property: background-color;
    transition-duration: 0.1s;
}

.palmares-table-body > .palmares-data-row:hover {
    background-color: rgba(255, 255, 255, 0.02);
}

.palmares-table-body > .palmares-data-row > Label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    padding: 0 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mini-logo {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin-right: 10px;
}

/* --- Column widths: Equipos tab --- */

#TabContentEquipos .th-season,
#TabContentEquipos .td-season {
    width: 100px;
    flex-shrink: 0;
}

#TabContentEquipos .th-champ,
#TabContentEquipos .td-champ {
    flex: 1;
}

#TabContentEquipos .th-finalist,
#TabContentEquipos .td-finalist {
    flex: 1;
}

#TabContentEquipos .th-result,
#TabContentEquipos .td-result {
    width: 100px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

#TabContentEquipos .th-mvp,
#TabContentEquipos .td-mvp {
    flex: 1;
}

.td-season {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf") !important;
    font-size: 16px !important;
    color: rgb(85, 102, 119) !important;
    letter-spacing: 1px;
    white-space: nowrap !important;
}

.td-result {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf") !important;
    font-size: 16px !important;
    color: rgb(212, 160, 23) !important;
    -unity-text-align: middle-center;
    white-space: nowrap !important;
}

/* --- Column widths: Jugadores tab --- */

#TabContentJugadores .th-season,
#TabContentJugadores .td-season {
    width: 100px;
    flex-shrink: 0;
}

#TabContentJugadores .th-mvp,
#TabContentJugadores .td-mvp {
    flex: 1;
}

#TabContentJugadores .th-rating,
#TabContentJugadores .td-rating {
    width: 100px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

#TabContentJugadores .th-rookie,
#TabContentJugadores .td-rookie {
    flex: 1;
}

.td-rating {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf") !important;
    font-size: 16px !important;
    color: rgb(85, 102, 119) !important;
    -unity-text-align: middle-center;
    white-space: nowrap !important;
}

/* --- Column widths: All-Star tab --- */

#TabContentAllStar .th-season,
#TabContentAllStar .td-season {
    width: 100px;
    flex-shrink: 0;
}

#TabContentAllStar .th-result,
#TabContentAllStar .td-result {
    width: 100px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

#TabContentAllStar .th-winner,
#TabContentAllStar .td-winner {
    flex: 1;
    -unity-text-align: middle-left;
}

#TabContentAllStar .th-loser,
#TabContentAllStar .td-loser {
    flex: 1;
    -unity-text-align: middle-left;
}

#TabContentAllStar .th-mvp,
#TabContentAllStar .td-mvp {
    flex: 1;
    -unity-text-align: middle-left;
}

.td-winner {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf") !important;
    font-size: 16px !important;
    color: rgb(212, 160, 23) !important;
    white-space: nowrap !important;
}

.td-loser {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf") !important;
    font-size: 16px !important;
    color: rgb(208, 216, 232) !important;
    white-space: nowrap !important;
}

/* --- Column widths: Quintetos tab --- */

#TabContentQuintetos .th-season,
#TabContentQuintetos .td-season {
    width: 100px;
    flex-shrink: 0;
}

#TabContentQuintetos .th-quintet-pos,
#TabContentQuintetos .td-quintet-pos {
    flex: 1;
    -unity-text-align: middle-left;
}

/* Data row cell with logo + name */
.cell-with-logo {
    flex-direction: row;
    align-items: center;
    flex: 1;
    padding: 0 12px;
    overflow: hidden;
}

.cell-with-logo > Label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* No data */
.no-data-cell {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(58, 74, 99);
    -unity-text-align: middle-center;
    padding: 24px;
    flex-grow: 1;
}

/* ══ TAB: SALÓN DE LA FAMA ══ */

.palmares-full {
    flex: 1 1 100%;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}

#TabContentSalonFama .th-hof-rank,
#TabContentSalonFama .td-hof-rank {
    width: 56px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

#TabContentSalonFama .th-hof-name,
#TabContentSalonFama .td-hof-name {
    flex: 2.2;
}

#TabContentSalonFama .th-hof-pos,
#TabContentSalonFama .td-hof-pos {
    width: 90px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

#TabContentSalonFama .th-hof-team,
#TabContentSalonFama .td-hof-team {
    flex: 1.6;
    -unity-text-align: middle-left;
}

#TabContentSalonFama .th-hof-rings,
#TabContentSalonFama .td-hof-rings {
    width: 80px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

#TabContentSalonFama .th-hof-fmvp,
#TabContentSalonFama .td-hof-fmvp {
    width: 110px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

#TabContentSalonFama .th-hof-points,
#TabContentSalonFama .td-hof-points,
#TabContentSalonFama .th-hof-rebounds,
#TabContentSalonFama .td-hof-rebounds,
#TabContentSalonFama .th-hof-assists,
#TabContentSalonFama .td-hof-assists {
    width: 110px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

#TabContentSalonFama .th-hof-season,
#TabContentSalonFama .td-hof-season {
    width: 100px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.td-hof-rank {
    color: rgb(85, 102, 119) !important;
    font-size: 16px !important;
    -unity-text-align: middle-center;
}

.td-hof-name {
    color: rgb(255, 255, 255) !important;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf") !important;
}

.td-hof-rings {
    color: rgb(212, 160, 23) !important;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf") !important;
}

.td-hof-season {
    color: rgb(85, 102, 119) !important;
    white-space: nowrap !important;
}

/* ══ SCROLLBAR (reemplaza paginadores) ══ */

.palmares-scroll-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.palmares-viewport {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    position: relative;
}

.palmares-scrollbar {
    width: 12px;
    min-width: 12px;
    flex-shrink: 0;
    align-self: stretch;
    margin-left: 4px;
    background-color: rgba(25, 18, 8, 0.92);
    border-left-width: 1px;
    border-left-color: rgba(120, 95, 30, 0.35);
    position: relative;
}

.palmares-scrollbar-thumb {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 0;
    height: 40px;
    background-color: rgb(160, 128, 30);
    border-radius: 3px;
}
.palmares-scrollbar:hover .palmares-scrollbar-thumb {
    background-color: rgb(212, 160, 23);
}

/* Sidebar / header from Dashboard.uss are inherited */

/* ── PESTAÑA HISTORIA (hilos narrativos) ── */
.historia-hint {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(150, 162, 186);
    margin-bottom: 10px;
}
.historia-body {
    flex-direction: column;
    flex-shrink: 0; /* el contenido desborda el viewport: así el scroll tiene recorrido */
}
.historia-row {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    padding: 10px 12px;
    margin-bottom: 6px;
    background-color: rgba(42, 95, 201, 0.08);
    border-width: 1px;
    border-color: rgb(60, 70, 92);
    border-radius: 8px;
}
.historia-row--active {
    border-color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.10);
}
.historia-badge {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 96px;
    flex-shrink: 0;
    font-size: 14px;
    letter-spacing: 1px;
    padding: 3px 0;
    border-width: 1px;
    border-radius: 6px;
    margin-right: 12px;
    -unity-text-align: middle-center;
}
.historia-badge--active {
    color: rgb(248, 196, 64);
    border-color: rgb(212, 160, 23);
}
.historia-badge--closed {
    color: rgb(150, 162, 186);
    border-color: rgb(60, 70, 92);
}
.historia-col {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}
.historia-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    color: rgb(240, 244, 250);
}
.historia-summary {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(179, 190, 214);
}
.historia-meta {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(120, 132, 158);
    margin-top: 4px;
}
.historia-empty {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(150, 162, 186);
    padding: 12px;
    white-space: normal;
}

/* ── PESTAÑA RIVALIDADES (dinastías + series de playoffs) ── */
.rival-hint {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(150, 162, 186);
    margin-bottom: 10px;
}
.rival-body {
    flex-direction: column;
    flex-shrink: 0; /* el contenido desborda el viewport: así el scroll tiene recorrido */
}
.rival-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 8px 10px;
    margin-bottom: 6px;
    background-color: rgba(42, 95, 201, 0.08);
    border-width: 1px;
    border-color: rgb(60, 70, 92);
    border-radius: 8px;
}
.rival-logo {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin-right: 10px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.rival-col {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}
.rival-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    color: rgb(240, 244, 250);
}
.rival-meta {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(179, 190, 214);
}
.rival-badge {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    flex-shrink: 0;
    font-size: 18px;
    letter-spacing: 1px;
    padding: 3px 10px;
    margin-left: 8px;
    border-width: 1px;
    border-radius: 6px;
    cursor: default;
    color: rgb(179, 190, 214);
    border-color: rgb(70, 82, 110);
    background-color: rgba(42, 51, 71, 0.45);
}
.rival-badge--hot {
    color: rgb(248, 196, 64);
    border-color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.12);
}

/* Badges de títulos/finales/conferencias de una franquicia */
.rival-stats {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}
.rival-stat-badge {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    padding: 2px 8px;
    margin: 2px 6px 2px 0;
    border-width: 1px;
    border-radius: 6px;
    flex-shrink: 0;
}
.rival-stat--titles {
    color: rgb(248, 196, 64);
    border-color: rgb(212, 160, 23);
    background-color: rgba(212, 160, 23, 0.12);
}
.rival-stat--finals {
    color: rgb(150, 190, 255);
    border-color: rgb(60, 90, 150);
    background-color: rgba(42, 95, 201, 0.12);
}
.rival-empty {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(150, 162, 186);
    padding: 12px;
    white-space: normal;
}
