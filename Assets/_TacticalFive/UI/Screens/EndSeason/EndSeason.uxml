<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_TacticalFive/UI/Screens/EndSeason/EndSeason.uss?fileID=7433441132597879392&amp;guid=00000000000000000000000000000000&amp;type=3#EndSeason"/>
    <ui:VisualElement name="EndSeasonRoot" class="end-season-root">
        <!-- TOP HEADER -->
        <ui:VisualElement name="TopHeader" class="top-header">
            <ui:VisualElement class="header-left">
                <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo"/>
                <ui:VisualElement class="header-team-info">
                    <ui:Label name="HeaderTeamName" class="header-team-name" text=""/>
                    <ui:Label name="HeaderManagerName" class="header-manager-name" text=""/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="header-right-group">
                <ui:VisualElement class="header-season-info">
                    <ui:Label name="HeaderSeason" class="header-season-label" text=""/>
                </ui:VisualElement>
                <ui:Label name="HeaderDate" class="header-date-label" text=""/>
                <ui:Button name="BtnLottery" class="btn-lottery" text="LOTERIA DRAFT"/>
                <ui:Button name="BtnNextSeason" class="btn-action" text="FINALIZAR DRAFT"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- CONTENT -->
        <ui:VisualElement name="ContentArea" class="content-area">
            <!-- PAGE TITLE (shown before draft starts) -->
            <ui:VisualElement name="PreDraftHeader" class="end-season-header">
                <ui:Label text="Fin de Temporada" class="page-title"/>
                <ui:Label name="SeasonTag" text="" class="season-tag"/>
                <ui:Label name="PageSubtitle" text="CIERRE DE UNA ERA, COMIENZO DE UNA NUEVA." class="page-subtitle"/>
            </ui:VisualElement>

            <!-- PRE-DRAFT: retiring + fame lists + draft card (hidden once draft starts) -->
            <ui:VisualElement name="PreDraftContent" class="end-season-split">
                <!-- LEFT COLUMN: Retiring + Hall of Fame -->
                <ui:VisualElement class="es-lists-col">
                    <!-- Retiring Panel -->
                    <ui:VisualElement class="es-panel es-panel--retiring">
                        <ui:VisualElement class="es-panel-overlay"/>
                        <ui:VisualElement class="es-panel-content">
                            <ui:Label text="JUGADORES RETIRADOS" class="es-panel-title"/>
                            <ui:VisualElement class="es-pre-pagination-row">
                                <ui:Button name="BtnRetiringPrev" class="es-pre-page-btn">
                                    <ui:Label text="◀" class="draft-page-icon"/>
                                </ui:Button>
                                <ui:VisualElement name="RetiringList" class="es-player-list"/>
                                <ui:Button name="BtnRetiringNext" class="es-pre-page-btn">
                                    <ui:Label text="▶" class="draft-page-icon"/>
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <!-- Hall of Fame Panel -->
                    <ui:VisualElement name="FamePanel" class="es-panel es-panel--fame">
                        <ui:VisualElement class="es-panel-overlay"/>
                        <ui:VisualElement class="es-panel-content">
                            <ui:Label text="SALÓN DE LA FAMA" class="es-panel-title"/>
                            <ui:VisualElement class="es-pre-pagination-row">
                                <ui:Button name="BtnFamePrev" class="es-pre-page-btn">
                                    <ui:Label text="◀" class="draft-page-icon"/>
                                </ui:Button>
                                <ui:VisualElement name="FameList" class="es-player-list"/>
                                <ui:Button name="BtnFameNext" class="es-pre-page-btn">
                                    <ui:Label text="▶" class="draft-page-icon"/>
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- RIGHT COLUMN: Draft Card -->
                <ui:VisualElement class="es-draft-col">
                    <ui:VisualElement class="es-panel es-panel--draft">
                        <ui:VisualElement class="es-panel-overlay"/>
                        <ui:VisualElement class="es-panel-content es-draft-card-content">
                            <ui:Label name="DraftYearTitle" class="es-draft-title" text="DRAFT"/>
                            <ui:Label name="DraftYearLabel" class="es-draft-year" text="2025"/>
                            <ui:VisualElement class="es-draft-features">
                                <ui:VisualElement class="es-draft-feature">
                                    <ui:VisualElement name="DraftIconTalents" class="es-draft-feature-icon-img"/>
                                    <ui:Label text="NUEVOS TALENTOS" class="es-draft-feature-title"/>
                                    <ui:Label text="75 PROSPECTOS DISPONIBLES" class="es-draft-feature-sub"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="es-draft-feature">
                                    <ui:VisualElement name="DraftIconOpps" class="es-draft-feature-icon-img"/>
                                    <ui:Label text="NUEVAS OPORTUNIDADES" class="es-draft-feature-title"/>
                                    <ui:Label text="EL FUTURO DE TU FRANQUICIA" class="es-draft-feature-sub"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="es-draft-feature">
                                    <ui:VisualElement name="DraftIconStories" class="es-draft-feature-icon-img"/>
                                    <ui:Label text="GRANDES HISTORIAS" class="es-draft-feature-title"/>
                                    <ui:Label text="NACEN AQUÍ" class="es-draft-feature-sub"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Button name="BtnDraft" class="btn-draft" text="EMPEZAR DRAFT 2027"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- DRAFT ROOM (hidden until draft starts) -->
            <ui:VisualElement name="DraftRoom" class="draft-room" style="display: none;">
                <!-- BANNER -->
                <ui:VisualElement class="draft-banner">
                    <ui:VisualElement class="draft-banner-overlay"/>
                    <ui:VisualElement class="draft-banner-left">
                        <ui:Label class="draft-banner-title" text="DRAFT DE LA NBA"/>
                        <ui:Label class="draft-banner-subtitle" text="Selecciona el próximo gran talento de la NBA"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="draft-banner-pick-box">
                        <ui:Label name="DraftBannerRound" class="draft-banner-round" text="Ronda 1"/>
                        <ui:Label name="DraftBannerPick" class="draft-banner-pick" text="Pick 1"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 3-COLUMN LAYOUT -->
                <ui:VisualElement class="draft-columns">
                    <!-- LEFT: Available Prospects -->
                    <ui:VisualElement class="draft-col-left">
                        <ui:VisualElement class="draft-col-header">
                            <ui:Label text="JUGADORES DISPONIBLES" class="draft-col-title"/>
                            <ui:Label name="ProspectCount" class="draft-col-count" text="60"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="ProspectList" class="draft-list-body"/>
                        <ui:VisualElement class="draft-pagination">
                            <ui:Button name="BtnProspectPrev" class="draft-page-btn">
                                <ui:Label text="◀" class="draft-page-icon"/>
                            </ui:Button>
                            <ui:Label name="ProspectPageLabel" class="draft-page-label" text="1 de 1"/>
                            <ui:Button name="BtnProspectNext" class="draft-page-btn">
                                <ui:Label text="▶" class="draft-page-icon"/>
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- CENTER: My Picks + Player Card + Team Needs -->
                    <ui:VisualElement class="draft-col-center">
                        <ui:VisualElement name="DraftMyPicksPanel" class="draft-my-picks-panel">
                            <ui:VisualElement name="DraftMyPicksLogo" class="draft-my-picks-logo"/>
                            <ui:VisualElement name="DraftMyPicksBadges" class="draft-my-picks-badges"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="DraftPlayerCard" class="draft-player-card">
                            <!-- Top: pick box, name, photo, OVR -->
                            <ui:VisualElement class="draft-card-top">
                                <ui:VisualElement class="draft-card-pick-box">
                                    <ui:Label name="DraftCardPickNum" class="draft-card-pick-num" text="#1"/>
                                    <ui:Label name="DraftCardPickPos" class="draft-card-pick-pos" text=""/>
                                </ui:VisualElement>
                                <ui:VisualElement class="draft-card-info">
                                    <ui:Label name="DraftCardName" class="draft-card-name" text="Selecciona un prospecto"/>
                                    <ui:Label name="DraftCardCollege" class="draft-card-college" text=""/>
                                    <ui:Label name="DraftCardBio" class="draft-card-bio" text=""/>
                                </ui:VisualElement>
                                <ui:VisualElement name="DraftCardPhoto" class="draft-card-photo"/>
                                <ui:VisualElement name="DraftCardOvrBadge" class="draft-card-ovr-badge">
                                    <ui:Label name="DraftCardOvr" class="draft-card-ovr-value" text="--"/>
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- Stat boxes -->
                            <ui:VisualElement class="draft-stat-boxes">
                                <ui:VisualElement class="draft-stat-box">
                                    <ui:Label class="draft-stat-label" text="TIRO"/>
                                    <ui:Label name="DraftStatShooting" class="draft-stat-value" text="--"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="draft-stat-box">
                                    <ui:Label class="draft-stat-label" text="TRIPLE"/>
                                    <ui:Label name="DraftStat3pt" class="draft-stat-value" text="--"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="draft-stat-box">
                                    <ui:Label class="draft-stat-label" text="PASES"/>
                                    <ui:Label name="DraftStatPassing" class="draft-stat-value" text="--"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="draft-stat-box">
                                    <ui:Label class="draft-stat-label" text="BOTE"/>
                                    <ui:Label name="DraftStatDribbling" class="draft-stat-value" text="--"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="draft-stat-box">
                                    <ui:Label class="draft-stat-label" text="DEFENSA"/>
                                    <ui:Label name="DraftStatDefense" class="draft-stat-value" text="--"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="draft-stat-box">
                                    <ui:Label class="draft-stat-label" text="REBOTES"/>
                                    <ui:Label name="DraftStatRebounding" class="draft-stat-value" text="--"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="draft-stat-box">
                                    <ui:Label class="draft-stat-label" text="ROBOS"/>
                                    <ui:Label name="DraftStatSteals" class="draft-stat-value" text="--"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="draft-stat-box">
                                    <ui:Label class="draft-stat-label" text="TAPONES"/>
                                    <ui:Label name="DraftStatBlocks" class="draft-stat-value" text="--"/>
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- Description -->
                            <ui:Label name="DraftCardDesc" class="draft-card-desc" text=""/>

                            <!-- Team Needs -->
                            <ui:VisualElement class="draft-team-needs">
                                <ui:Label class="draft-needs-title" text="NECESIDADES DEL EQUIPO"/>
                                <ui:VisualElement name="DraftTeamLogo" class="draft-team-logo"/>
                                <ui:VisualElement class="draft-needs-row">
                                    <ui:VisualElement class="draft-need">
                                        <ui:VisualElement name="DraftNeedPG" class="draft-need-badge">
                                            <ui:Label name="DraftNeedPGVal" class="draft-need-val" text="--"/>
                                        </ui:VisualElement>
                                        <ui:Label class="draft-need-pos" text="B"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="draft-need">
                                        <ui:VisualElement name="DraftNeedSG" class="draft-need-badge">
                                            <ui:Label name="DraftNeedSGVal" class="draft-need-val" text="--"/>
                                        </ui:VisualElement>
                                        <ui:Label class="draft-need-pos" text="E"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="draft-need">
                                        <ui:VisualElement name="DraftNeedSF" class="draft-need-badge">
                                            <ui:Label name="DraftNeedSFVal" class="draft-need-val" text="--"/>
                                        </ui:VisualElement>
                                        <ui:Label class="draft-need-pos" text="AL"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="draft-need">
                                        <ui:VisualElement name="DraftNeedPF" class="draft-need-badge">
                                            <ui:Label name="DraftNeedPFVal" class="draft-need-val" text="--"/>
                                        </ui:VisualElement>
                                        <ui:Label class="draft-need-pos" text="AP"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="draft-need">
                                        <ui:VisualElement name="DraftNeedC" class="draft-need-badge">
                                            <ui:Label name="DraftNeedCVal" class="draft-need-val" text="--"/>
                                        </ui:VisualElement>
                                        <ui:Label class="draft-need-pos" text="P"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- Action Buttons -->
                        <ui:VisualElement class="draft-actions">
                            <ui:Button name="BtnDraftPick" class="btn-draft-pick" text="SELECCIONAR JUGADOR"/>
                            <ui:Button name="BtnAutoPick" class="btn-auto-pick" text="AUTO"/>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- RIGHT: Draft Log -->
                    <ui:VisualElement class="draft-col-right">
                        <ui:VisualElement class="draft-col-header">
                            <ui:Label text="ORDEN DEL DRAFT" class="draft-col-title"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="DraftLog" class="draft-list-body"/>
                        <ui:VisualElement class="draft-pagination">
                            <ui:Button name="BtnLogPrev" class="draft-page-btn">
                                <ui:Label text="◀" class="draft-page-icon"/>
                            </ui:Button>
                            <ui:Label name="LogPageLabel" class="draft-page-label" text="1 de 1"/>
                            <ui:Button name="BtnLogNext" class="draft-page-btn">
                                <ui:Label text="▶" class="draft-page-icon"/>
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
