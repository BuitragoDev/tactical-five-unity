<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_TacticalFive/UI/Screens/EndSeason/EndSeason.uss?fileID=7433441132597879392&amp;guid=00000000000000000000000000000000&amp;type=3#EndSeason"/>
    <ui:VisualElement name="EndSeasonRoot" class="end-season-root">
        <ui:VisualElement name="TopHeader" class="top-header">
            <ui:VisualElement class="header-left">
                <ui:VisualElement name="HeaderTeamLogo" class="header-team-logo"/>
                <ui:VisualElement class="header-team-info">
                    <ui:VisualElement class="header-team-name-row">
                        <ui:Label name="HeaderTeamName" class="header-team-name" text=""/>
                        <ui:Label name="HeaderSubtitle" class="header-subtitle" text="(FIN DE TEMPORADA)"/>
                    </ui:VisualElement>
                    <ui:Label name="HeaderManagerName" class="header-manager-name" text=""/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="header-right-group">
                <ui:Button name="BtnLottery" class="btn-lottery" text="LOTERÍA DRAFT"/>
                <ui:VisualElement class="header-season-info">
                    <ui:Label name="HeaderSeason" class="header-season-label" text=""/>
                </ui:VisualElement>
                <ui:Label name="HeaderDate" class="header-date-label" text=""/>
                <ui:Button name="BtnNextSeason" class="btn-action" text="PRÓXIMA TEMPORADA"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ContentArea" class="content-area">
            <ui:VisualElement class="end-season-header">
                <ui:Label text="Fin de Temporada" class="page-title"/>
                <ui:Label name="SeasonTag" text="" class="season-tag"/>
            </ui:VisualElement>
            <ui:VisualElement class="end-season-split">
                <!-- LEFT COLUMN -->
                <ui:VisualElement class="es-lists-col">
                    <ui:VisualElement class="es-panel">
                        <ui:Label text="Jugadores que se Retiran" class="es-panel-title"/>
                        <ui:VisualElement class="es-scroll-wrapper">
                            <ui:ScrollView name="RetiringList" class="es-player-scroll" mode="Vertical"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="ExpiringPanel" class="es-panel">
                        <ui:VisualElement class="es-panel-title-row">
                            <ui:Label text="Contratos Expirando (1 año)" class="es-panel-title"/>
                            <ui:Button name="BtnRenewAll" class="btn-renew-all" text="RENOVAR TODOS"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="es-scroll-wrapper">
                            <ui:ScrollView name="ExpiringList" class="es-player-scroll" mode="Vertical"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <!-- RIGHT COLUMN -->
                <ui:VisualElement class="es-draft-col">
                    <ui:Button name="BtnDraft" class="btn-draft" text="EMPEZAR DRAFT"/>
                    <ui:VisualElement class="draft-results-wrapper">
                        <ui:ScrollView name="DraftResults" class="draft-results-container" mode="Vertical"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
