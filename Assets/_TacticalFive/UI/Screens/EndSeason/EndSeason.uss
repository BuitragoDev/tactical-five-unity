/* ── ROOT ── */
.end-season-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ── TOP HEADER (same as PlayerAwards) ── */
.end-season-root .top-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 28px;
    background-color: rgb(22, 26, 36);
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 160, 23);
    flex-shrink: 0;
    min-height: 100px;
}
.end-season-root .header-left {
    flex-direction: row;
    align-items: center;
}
.end-season-root .header-team-logo {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    margin-right: 16px;
}
.end-season-root .header-team-info {
    flex-direction: column;
}
.end-season-root .header-team-name-row {
    flex-direction: row;
    align-items: baseline;
}
.end-season-root .header-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
    margin-right: 12px;
}
.end-season-root .header-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    letter-spacing: 2px;
    -unity-text-transform: upper;
}
.end-season-root .header-manager-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
}
.end-season-root .header-right-group {
    flex-direction: row;
    align-items: center;
}
.end-season-root .header-season-info {
    flex-direction: column;
    align-items: flex-end;
    margin-right: 20px;
}
.end-season-root .header-date-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    padding: 0 12px;
    margin-right: 20px;
    border-left-width: 1px;
    border-left-color: rgb(42, 51, 71);
    border-right-width: 1px;
    border-right-color: rgb(42, 51, 71);
}
.end-season-root .header-season-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    letter-spacing: 1px;
}

/* ── BOTÓN ACCIÓN ── */
.end-season-root .btn-action {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 250px;
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 18px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.end-season-root .btn-action:hover {
    background-color: rgb(74, 128, 240);
}
.end-season-root .btn-action:disabled {
    opacity: 0.4;
    background-color: rgb(42, 51, 71);
}

/* ── CONTENT ── */
.end-season-root .content-area {
    flex-grow: 1;
    flex-direction: column;
    padding: 24px 28px;
    overflow-y: auto;
}

/* ── PAGE HEADER ── */
.end-season-root .end-season-header {
    align-items: center;
    margin-bottom: 32px;
}
.end-season-root .page-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 36px;
    letter-spacing: 4px;
    -unity-text-transform: upper;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
}
.end-season-root .season-tag {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
    font-size: 18px;
    letter-spacing: 2px;
    padding: 4px 16px;
    margin-top: 8px;
    -unity-text-align: middle-center;
}

/* ── SPLIT LAYOUT ── */
.end-season-split {
    flex-direction: row;
    flex-grow: 1;
    overflow: hidden;
    min-height: 0;
}
.es-lists-col {
    flex: 1;
    flex-direction: column;
    margin-right: 24px;
    overflow: hidden;
    min-height: 0;
}
.es-draft-col {
    flex: 1;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
}

/* ── PANELS ── */
.es-panel {
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px;
    margin-bottom: 20px;
    overflow: hidden;
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}
.es-panel:last-child {
    margin-bottom: 0;
}
.es-panel-title-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    flex-shrink: 0;
}
.es-panel-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}
.es-panel-title-row .es-panel-title {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom-width: 0;
}

/* ── PLAYER LIST ── */
.es-scroll-wrapper {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    min-height: 200px;
}
.es-player-scroll {
    flex-grow: 1;
}
.es-player-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: transparent;
    margin-bottom: 4px;
    flex-shrink: 0;
    min-height: 40px;
}
.es-mini-logo {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin-right: 12px;
}
.es-fa-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 12px;
    color: rgb(140, 156, 188);
    font-style: italic;
    margin-right: 12px;
    width: 100px;
    flex-shrink: 0;
}
.es-player-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
}
.es-player-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    background-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
    padding: 2px 8px;
    margin-right: 12px;
    flex-shrink: 0;
}
.es-player-age {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    flex-shrink: 0;
}
.es-player-salary {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(39, 174, 96);
    flex-shrink: 0;
    margin-right: 12px;
}
.es-player-expiry-row .es-player-pos {
    min-width: 40px;
    -unity-text-align: middle-center;
}
.es-player-expiry-row .es-player-salary {
    min-width: 100px;
    -unity-text-align: middle-center;
}
.btn-renew {
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    padding: 4px 12px;
    flex-shrink: 0;
    border-radius: 3px;
}
.btn-renew:hover {
    background-color: rgb(74, 128, 240);
}
.btn-renew-all {
    background-color: rgb(39, 174, 96);
    border-width: 0;
    color: rgb(0, 0, 0);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    padding: 6px 16px;
    flex-shrink: 0;
    border-radius: 3px;
}
.btn-renew-all:hover {
    background-color: rgb(212, 160, 23);
}
.es-empty {
    -unity-text-align: middle-center;
    color: rgb(122, 138, 170);
    padding: 16px;
    font-size: 13px;
}

/* ── DRAFT BUTTON ── */
.btn-draft {
    background-color: rgb(212, 160, 23);
    border-width: 0;
    color: rgb(0, 0, 0);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 12px 28px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-bottom: 16px;
}
.btn-draft:hover {
    background-color: rgb(240, 192, 64);
}

/* ── DRAFT RESULTS ── */
.draft-results-wrapper {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}
.draft-results-container {
    flex-grow: 1;
    height: 100%;
}
.draft-pick {
    flex-direction: column;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 10px 12px;
    margin-bottom: 8px;
    flex-shrink: 0;
}
.draft-pick-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}
.draft-pick-num {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    min-width: 36px;
    flex-shrink: 0;
    margin-right: 8px;
}
.draft-team-row {
    flex-direction: row;
    align-items: center;
}
.draft-team-logo {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin-right: 6px;
}
.draft-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
}
.draft-player-info {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 6px;
}
.draft-player-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    margin-right: 8px;
}
.draft-player-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    background-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
    padding: 2px 8px;
    margin-right: 8px;
    flex-shrink: 0;
}
.draft-player-detail {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    margin-right: 8px;
}
.draft-player-ovr {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(212, 160, 23);
}
.draft-player-attrs {
    flex-direction: row;
    flex-wrap: wrap;
}
.draft-attr {
    flex-direction: column;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 3px 8px;
    min-width: 36px;
    margin-right: 6px;
    margin-bottom: 4px;
}
.draft-attr-lbl {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
}
.draft-attr-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
}

/* ══ LOTTERY BUTTON ══ */
.btn-lottery {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 250px;
    background-color: rgb(192, 57, 43);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 18px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-right: 20px;
}
.btn-lottery:hover {
    background-color: rgb(220, 80, 66);
}

/* ══ LOTTERY MODAL ══ */
.lottery-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    display: none;
}
.lottery-box {
    width: 800px;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-top-width: 3px;
    border-top-color: rgb(212, 160, 23);
    padding: 32px;
    flex-direction: column;
    align-items: center;
}
.lottery-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 4px;
    color: rgb(212, 160, 23);
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}
.lottery-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    margin-bottom: 24px;
    -unity-text-align: middle-center;
}
.lottery-grid {
    flex-direction: row;
    width: 100%;
}
.lottery-column {
    flex: 1;
    flex-direction: column;
}
.lottery-column:first-child {
    margin-right: 24px;
}
.lottery-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    margin-bottom: 4px;
    min-height: 44px;
}
.lottery-rank {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    min-width: 30px;
    flex-shrink: 0;
}
.lottery-logo {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin-right: 10px;
}
.lottery-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.lottery-pct {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(212, 160, 23);
    min-width: 50px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}
.lottery-close-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 32px;
    border-radius: 4px;
    margin-top: 24px;
}
.lottery-close-btn:hover {
    background-color: rgb(74, 128, 240);
}

.lottery-draft-row {
    min-height: 64px;
}

.lottery-draft-row .lottery-rank {
    color: rgb(212, 160, 23);
}

.lottery-draft-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(212, 160, 23);
    margin-bottom: 2px;
    white-space: normal;
}

.lottery-draft-player {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
}
