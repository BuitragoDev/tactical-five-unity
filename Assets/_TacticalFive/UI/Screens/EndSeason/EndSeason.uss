/* ── ROOT ── */
.end-season-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ── TOP HEADER ── */
.end-season-root .top-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 28px;
    background-color: rgb(22, 26, 36);
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 160, 23);
    flex-shrink: 0;
    min-height: 100px;
}
.end-season-root .header-left {
    flex-direction: row;
    align-items: center;
}
.end-season-root .header-brand {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 24px;
}
.end-season-root .header-brand-icon {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
    font-size: 28px;
    padding: 4px 8px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-right: 10px;
}
.end-season-root .header-brand-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
}
.end-season-root .header-brand-text-gold {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
    -unity-text-transform: upper;
}
.end-season-root .header-team-logo {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    margin-right: 16px;
}
.end-season-root .header-team-info {
    flex-direction: column;
}
.end-season-root .header-team-name-row {
    flex-direction: row;
    align-items: baseline;
}
.end-season-root .header-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
    margin-right: 12px;
}
.end-season-root .header-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    letter-spacing: 2px;
    -unity-text-transform: upper;
}
.end-season-root .header-manager-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
}
.end-season-root .header-right-group {
    flex-direction: row;
    align-items: center;
}
.end-season-root .header-season-info {
    flex-direction: column;
    align-items: flex-end;
    margin-right: 20px;
}
.end-season-root .header-date-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    padding: 0 12px;
    margin-right: 20px;
    border-left-width: 1px;
    border-left-color: rgb(42, 51, 71);
    border-right-width: 1px;
    border-right-color: rgb(42, 51, 71);
}
.end-season-root .header-season-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    letter-spacing: 1px;
}

/* ── BUTTONS ── */
.end-season-root .btn-action {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 250px;
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 18px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.end-season-root .btn-action:hover {
    background-color: rgb(74, 128, 240);
}
.end-season-root .btn-action:disabled {
    opacity: 0.4;
    background-color: rgb(42, 51, 71);
}
.btn-lottery {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 250px;
    background-color: rgb(192, 57, 43);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 18px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-right: 20px;
}
.btn-lottery:hover {
    background-color: rgb(220, 80, 66);
}

/* ── CONTENT ── */
.end-season-root .content-area {
    flex-grow: 1;
    flex-direction: column;
    padding: 24px 28px;
    overflow-y: auto;
}

/* ── PAGE HEADER ── */
.end-season-root .end-season-header {
    align-items: center;
    margin-bottom: 32px;
}
.end-season-root .page-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 36px;
    letter-spacing: 4px;
    -unity-text-transform: upper;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
}
.end-season-root .season-tag {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
    font-size: 18px;
    letter-spacing: 2px;
    padding: 4px 16px;
    margin-top: 8px;
    -unity-text-align: middle-center;
}

/* ── PRE-DRAFT SPLIT LAYOUT ── */
.end-season-split {
    flex-direction: row;
    flex-grow: 1;
    overflow: hidden;
    min-height: 0;
}
.es-lists-col {
    flex: 1;
    flex-direction: column;
    margin-right: 24px;
    overflow: hidden;
    min-height: 0;
}
.es-draft-col {
    flex: 1;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
}

/* ── PANELS ── */
.es-panel {
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px;
    margin-bottom: 20px;
    overflow: hidden;
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}
.es-panel-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
    flex-shrink: 0;
}

/* ── PLAYER LIST ── */
.es-scroll-wrapper {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    min-height: 200px;
}
.es-player-scroll {
    flex-grow: 1;
}
.es-player-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: transparent;
    margin-bottom: 4px;
    flex-shrink: 0;
    min-height: 40px;
}
.es-mini-logo {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin-right: 12px;
}
.es-player-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
}
.es-player-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    background-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
    padding: 2px 8px;
    margin-right: 12px;
    flex-shrink: 0;
}
.es-player-age {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    flex-shrink: 0;
}
.es-player-fame-row .es-player-credentials {
    min-width: 220px;
    -unity-text-align: middle-center;
    font-size: 16px;
    color: rgb(212, 212, 212);
}
.es-player-fame-row .es-player-fame {
    font-size: 16px;
    font-weight: bold;
    color: rgb(212, 160, 23);
}
.es-empty {
    -unity-text-align: middle-center;
    color: rgb(122, 138, 170);
    padding: 16px;
    font-size: 13px;
}

/* ── DRAFT BUTTON (pre-draft) ── */
.btn-draft {
    background-color: rgb(212, 160, 23);
    border-width: 0;
    color: rgb(0, 0, 0);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 12px 28px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-bottom: 16px;
}
.btn-draft:hover {
    background-color: rgb(240, 192, 64);
}

/* ═══════════════════════════════════════════════════════════════════
   DRAFT ROOM
   ═══════════════════════════════════════════════════════════════════ */
.draft-room {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
}

/* ── PROGRESS BAR ── */
.draft-progress-bar {
    flex-direction: row;
    align-items: center;
    padding: 12px 0;
    margin-bottom: 16px;
    flex-shrink: 0;
}
.draft-progress-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(212, 160, 23);
    min-width: 120px;
    flex-shrink: 0;
}
.draft-progress-track {
    flex-grow: 1;
    height: 8px;
    background-color: rgb(42, 51, 71);
    margin: 0 16px;
}
.draft-progress-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(212, 160, 23);
}
.draft-class-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(122, 138, 170);
    min-width: 120px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

/* ── 3-COLUMN LAYOUT ── */
.draft-columns {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}
.draft-col-left {
    flex: 3;
    flex-direction: column;
    margin-right: 16px;
    min-height: 0;
    overflow: hidden;
}
.draft-col-center {
    flex: 4;
    flex-direction: column;
    margin-right: 16px;
    min-height: 0;
    overflow: hidden;
}
.draft-col-right {
    flex: 3;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}
.draft-col-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    flex-shrink: 0;
}
.draft-col-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
}
.draft-col-count {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(122, 138, 170);
}

/* ── PROSPECT LIST ── */
.draft-list-body {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
}
.draft-prospect {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    margin-bottom: 4px;
    flex-shrink: 0;
    min-height: 42px;
}
.draft-prospect:hover {
    background-color: rgb(38, 44, 64);
}
.draft-prospect--selected {
    background-color: rgba(42, 95, 201, 0.25);
    border-color: rgb(42, 95, 201);
}
.draft-prospect--top {
    border-left-width: 3px;
    border-left-color: rgb(212, 160, 23);
}
.draft-prospect-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    background-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
    padding: 2px 6px;
    min-width: 28px;
    -unity-text-align: middle-center;
    margin-right: 8px;
    flex-shrink: 0;
}
.draft-prospect-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.draft-prospect-info {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(122, 138, 170);
    margin-right: 8px;
    flex-shrink: 0;
}
.draft-prospect-med {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    min-width: 30px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.draft-prospect-med--high {
    color: rgb(39, 174, 96);
}
.draft-prospect-med--mid {
    color: rgb(212, 160, 23);
}
.draft-prospect-med--low {
    color: rgb(192, 57, 43);
}

/* ── CURRENT PICK ── */
.draft-current-pick {
    flex-direction: row;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-top-width: 3px;
    border-top-color: rgb(212, 160, 23);
    padding: 16px 20px;
    margin-bottom: 16px;
    flex-shrink: 0;
}
.draft-pick-number-box {
    flex-direction: column;
    align-items: center;
    margin-right: 20px;
    flex-shrink: 0;
}
.draft-pick-round {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
}
.draft-pick-number {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    color: rgb(212, 160, 23);
}
.draft-pick-team {
    flex-direction: row;
    align-items: center;
}
.draft-pick-team-logo {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    margin-right: 12px;
}
.draft-pick-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    color: rgb(208, 216, 232);
    -unity-text-transform: upper;
}

/* ── PLAYER CARD (center) ── */
.draft-player-card {
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px 20px;
    margin-bottom: 16px;
    flex-shrink: 0;
}
.draft-player-card-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    color: rgb(255, 255, 255);
    margin-bottom: 8px;
}
.draft-player-card-meta {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 10px;
}
.draft-player-card-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    background-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
    padding: 2px 8px;
    margin-right: 6px;
    flex-shrink: 0;
}
.draft-player-card-sec-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    background-color: rgb(39, 174, 96);
    color: rgb(255, 255, 255);
    padding: 2px 8px;
    margin-right: 10px;
    flex-shrink: 0;
}
.draft-player-card-detail {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(122, 138, 170);
    margin-right: 10px;
}
.draft-player-card-trait {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(212, 160, 23);
    margin-bottom: 10px;
    -unity-text-transform: upper;
}
.draft-player-card-attrs {
    flex-direction: row;
    flex-wrap: wrap;
}

/* ── ATTRIBUTE BOXES ── */
.draft-attr {
    flex-direction: column;
    align-items: center;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 4px 8px;
    min-width: 38px;
    margin-right: 6px;
    margin-bottom: 4px;
}
.draft-attr-lbl {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
}
.draft-attr-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
}
.draft-attr-med--high {
    background-color: rgba(39, 174, 96, 0.12);
    border-color: rgb(39, 174, 96);
}
.draft-attr-med--high .draft-attr-lbl,
.draft-attr-med--high .draft-attr-val {
    color: rgb(39, 174, 96);
}
.draft-attr-med--mid {
    background-color: rgba(212, 160, 23, 0.12);
    border-color: rgb(212, 160, 23);
}
.draft-attr-med--mid .draft-attr-lbl,
.draft-attr-med--mid .draft-attr-val {
    color: rgb(212, 160, 23);
}
.draft-attr-med--low {
    background-color: rgba(192, 57, 43, 0.12);
    border-color: rgb(192, 57, 43);
}
.draft-attr-med--low .draft-attr-lbl,
.draft-attr-med--low .draft-attr-val {
    color: rgb(192, 57, 43);
}

/* ── ACTION BUTTONS ── */
.draft-actions {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: auto;
    padding-top: 12px;
}
.btn-draft-pick {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 260px;
    background-color: rgb(39, 174, 96);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 20px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 12px 24px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.btn-draft-pick:hover {
    background-color: rgb(55, 200, 115);
}
.btn-draft-pick:disabled {
    opacity: 0.4;
    background-color: rgb(42, 51, 71);
}
.btn-auto-pick {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 220px;
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 20px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-left: 12px;
}
.btn-auto-pick:hover {
    background-color: rgb(74, 128, 240);
}

/* ── DRAFT LOG ── */
.draft-log-entry {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    margin-bottom: 4px;
    flex-shrink: 0;
    min-height: 44px;
}
.draft-log-entry--user {
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}
.draft-log-num {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: rgb(212, 160, 23);
    min-width: 32px;
    flex-shrink: 0;
}
.draft-log-logo {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin-right: 8px;
}
.draft-log-info {
    flex-direction: column;
    flex-grow: 1;
    overflow: hidden;
}
.draft-log-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 13px;
    color: rgb(122, 138, 170);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.draft-log-player {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 15px;
    color: rgb(208, 216, 232);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* ══ LOTTERY MODAL ══ */
.lottery-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    display: none;
}
.lottery-box {
    width: 1100px;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-top-width: 3px;
    border-top-color: rgb(212, 160, 23);
    padding: 32px;
    flex-direction: column;
    align-items: center;
}
.lottery-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 4px;
    color: rgb(212, 160, 23);
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}
.lottery-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    margin-bottom: 24px;
    -unity-text-align: middle-center;
}
.lottery-grid {
    flex-direction: row;
    width: 100%;
}
.lottery-column {
    flex: 1;
    flex-direction: column;
}
.lottery-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    margin-bottom: 4px;
    min-height: 44px;
}
.lottery-rank {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    min-width: 30px;
    flex-shrink: 0;
}
.lottery-logo {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin-right: 10px;
}
.lottery-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.lottery-pct {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(212, 160, 23);
    min-width: 50px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}
.lottery-close-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 32px;
    border-radius: 4px;
    margin-top: 24px;
}
.lottery-close-btn:hover {
    background-color: rgb(74, 128, 240);
}
.lottery-draft-row {
    min-height: 64px;
}
.lottery-draft-row .lottery-rank {
    color: rgb(212, 160, 23);
}
.lottery-draft-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(212, 160, 23);
    margin-bottom: 2px;
    white-space: normal;
}
.lottery-draft-player {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
}

/* ══ PAGINATION ══ */
.draft-pagination {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-height: 40px;
    padding: 4px 12px;
    background-color: rgb(17, 24, 34);
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
}
.draft-page-btn {
    width: 34px;
    height: 28px;
    padding: 4px;
    margin: 0 8px;
    align-items: center;
    justify-content: center;
    color: rgb(122, 138, 170);
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 3px;
    -unity-text-align: middle-center;
}
.draft-page-btn:hover {
    color: rgb(212, 160, 23);
    border-color: rgb(212, 160, 23);
}
.draft-page-btn:disabled {
    color: rgb(55, 65, 84);
    background-color: rgb(17, 24, 34);
    border-color: rgb(28, 33, 48);
}
.draft-page-icon {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 12px;
}
.draft-page-label {
    min-width: 60px;
    height: 24px;
    flex-shrink: 0;
    font-size: 14px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
}
