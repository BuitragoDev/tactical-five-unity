/* ── ROOT ── */
.end-season-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ── TOP HEADER ── */
.end-season-root .top-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 28px;
    background-color: rgb(22, 26, 36);
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 160, 23);
    flex-shrink: 0;
    min-height: 80px;
}
.end-season-root .header-left {
    flex-direction: row;
    align-items: center;
}
.end-season-root .header-brand {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 24px;
}
.end-season-root .header-brand-icon {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
    font-size: 28px;
    padding: 4px 8px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-right: 10px;
}
.end-season-root .header-brand-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
}
.end-season-root .header-brand-text-gold {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(212, 160, 23);
    -unity-text-transform: upper;
}
.end-season-root .header-team-logo {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    margin-right: 16px;
}
.end-season-root .header-team-info {
    flex-direction: column;
}
.end-season-root .header-team-name-row {
    flex-direction: row;
    align-items: baseline;
}
.end-season-root .header-team-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
    margin-right: 12px;
}
.end-season-root .header-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-SemiBold.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    letter-spacing: 2px;
    -unity-text-transform: upper;
}
.end-season-root .header-manager-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
}
.end-season-root .header-right-group {
    flex-direction: row;
    align-items: center;
}
.end-season-root .header-season-info {
    flex-direction: column;
    align-items: flex-end;
    margin-right: 20px;
}
.end-season-root .header-date-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    letter-spacing: 1px;
    padding: 0 12px;
    margin-right: 20px;
    border-left-width: 1px;
    border-left-color: rgb(42, 51, 71);
    border-right-width: 1px;
    border-right-color: rgb(42, 51, 71);
}
.end-season-root .header-season-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(212, 160, 23);
    letter-spacing: 1px;
}

/* ── BUTTONS ── */
.end-season-root .btn-action {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 250px;
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 18px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.end-season-root .btn-action:hover {
    background-color: rgb(74, 128, 240);
}
.end-season-root .btn-action:disabled {
    opacity: 0.4;
    background-color: rgb(42, 51, 71);
}
.btn-lottery {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 250px;
    background-color: rgb(192, 57, 43);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 18px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-right: 20px;
}
.btn-lottery:hover {
    background-color: rgb(220, 80, 66);
}

/* ── CONTENT ── */
.end-season-root .content-area {
    flex-grow: 1;
    flex-direction: column;
    padding: 24px 28px;
    overflow-y: auto;
}

/* ── PAGE HEADER ── */
.end-season-root .end-season-header {
    align-items: center;
    margin-bottom: 24px;
}
.end-season-root .page-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 36px;
    letter-spacing: 4px;
    -unity-text-transform: upper;
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
}
.end-season-root .season-tag {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(212, 160, 23);
    color: rgb(0, 0, 0);
    font-size: 18px;
    letter-spacing: 2px;
    padding: 4px 16px;
    margin-top: 8px;
    -unity-text-align: middle-center;
}
.end-season-root .page-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(122, 138, 170);
    margin-top: 10px;
    -unity-text-align: middle-center;
}

/* ═══════════════════════════════════════════════════════════════════
   PRE-DRAFT SPLIT LAYOUT
   ═══════════════════════════════════════════════════════════════════ */
.end-season-split {
    flex-direction: row;
    flex-grow: 1;
    overflow: hidden;
    min-height: 0;
}
.es-lists-col {
    flex: 1;
    flex-direction: column;
    margin-right: 20px;
    overflow: hidden;
    min-height: 0;
}
.es-draft-col {
    flex: 1;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
}

/* ── PANELS (base) ── */
.es-panel {
    position: relative;
    overflow: hidden;
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    margin-bottom: 16px;
    border-width: 1px;
    border-color: rgb(42, 51, 71);
}
.es-panel:last-child {
    margin-bottom: 0;
}

/* ── OVERLAY ── */
.es-panel-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(22, 26, 36, 0.95);
}

/* ── PANEL CONTENT (above overlay) ── */
.es-panel-content {
    position: relative;
    flex-direction: column;
    flex-grow: 1;
    padding: 18px 20px;
    min-height: 0;
    overflow: hidden;
}

/* ── PANEL BACKGROUNDS ── */
.es-panel--retiring {
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/Backgrounds/retirados_fondo.png");
    background-size: cover;
    background-position: center;
}
.es-panel--fame {
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/Backgrounds/hallOfFame_fondo.png");
    background-size: cover;
    background-position: center;
}
.es-panel--draft {
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/Backgrounds/draft_fondo.png");
    background-size: cover;
    background-position: center;
}

/* ── PANEL TITLES ── */
.es-panel-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(212, 160, 23, 0.3);
    flex-shrink: 0;
}

/* ═══════════════════════════════════════════════════════════════════
   PLAYER LIST (pre-draft, 4-column grid)
   ═══════════════════════════════════════════════════════════════════ */
.es-player-list {
    flex-direction: row;
    flex-wrap: nowrap;
    flex-grow: 1;
    overflow: hidden;
    min-height: 0;
}

/* ── PLAYER CARD (retiring) ── */
.es-player-row {
    flex-direction: column;
    align-items: center;
    padding: 12px 8px 12px 8px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    margin-right: 4px;
    flex-shrink: 0;
    width: 194px;
}
.es-player-photo {
    width: 100px;
    height: 100px;
    border-radius: 4px;
    flex-shrink: 0;
    margin-bottom: 8px;
}
.es-player-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(255, 255, 255);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}
.es-player-age {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(160, 170, 190);
    margin-bottom: 6px;
}
.es-player-bottom-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.es-player-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 13px;
    background-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
    padding: 2px 8px;
    flex-shrink: 0;
}
.es-player-logo {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin-left: 18px;
}
.es-player-team-abbr {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    margin-left: 18px;
    flex-shrink: 0;
}
.es-player-team-col {
    flex-direction: column;
    align-items: center;
}

/* ── HOF CARD ── */
.es-player-fame-row {
    flex-direction: column;
    align-items: center;
    padding: 12px 8px 12px 8px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    margin-right: 4px;
    flex-shrink: 0;
    width: 194px;
}

/* ── EMPTY STATE ── */
.es-empty {
    -unity-text-align: middle-center;
    color: rgb(122, 138, 170);
    padding: 16px;
    font-size: 14px;
    flex-shrink: 0;
}

/* ═══════════════════════════════════════════════════════════════════
   PRE-DRAFT PAGINATION (arrows beside cards)
   ═══════════════════════════════════════════════════════════════════ */
.es-pre-pagination-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    align-items: stretch;
}
.es-pre-page-btn {
    width: 36px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    color: rgb(122, 138, 170);
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    margin-right: 8px;
    -unity-text-align: middle-center;
}
.es-pre-page-btn:last-child {
    margin-right: 0;
    margin-left: 8px;
}
.es-pre-page-btn:hover {
    color: rgb(212, 160, 23);
    border-color: rgb(212, 160, 23);
}
.es-pre-page-btn:disabled {
    color: rgb(55, 65, 84);
    background-color: rgb(17, 24, 34);
    border-color: rgb(28, 33, 48);
}

/* ═══════════════════════════════════════════════════════════════════
   DRAFT CARD (right column)
   ═══════════════════════════════════════════════════════════════════ */
.es-draft-card-content {
    align-items: flex-start;
    justify-content: flex-end;
    padding: 0 16px 16px 16px;
}
.es-draft-year {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 96px;
    color: rgb(255, 255, 255);
    letter-spacing: 2px;
    position: absolute;
    top: 78px;
    left: 20px;
}
.es-draft-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 96px;
    color: rgb(255, 255, 255);
    letter-spacing: 2px;
    position: absolute;
    top: 10px;
    left: 20px;
}
.es-draft-subtitle {
    display: none;
}
.es-draft-features {
    flex-direction: row;
    width: 100%;
    padding: 0 16px;
    margin-bottom: 16px;
    position: absolute;
    bottom: 80px;
    left: 0;
}
.es-draft-feature {
    flex: 1;
    flex-direction: column;
    align-items: center;
}
.es-draft-feature-icon {
    font-size: 28px;
    margin-bottom: 6px;
}
.es-draft-feature-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    margin-bottom: 2px;
    -unity-text-align: middle-center;
}
.es-draft-feature-sub {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(160, 170, 190);
    -unity-text-align: middle-center;
}

/* ── DRAFT BUTTON (pre-draft) ── */
.btn-draft {
    background-color: rgb(212, 160, 23);
    border-width: 0;
    color: rgb(0, 0, 0);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 14px 0;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    width: 100%;
}
.btn-draft:hover {
    background-color: rgb(240, 192, 64);
}

/* ═══════════════════════════════════════════════════════════════════
   DRAFT ROOM
   ═══════════════════════════════════════════════════════════════════ */
.draft-room {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
}

/* ── BANNER ── */
.draft-banner {
    position: relative;
    flex-direction: row;
    align-items: center;
    padding: 16px 24px;
    background-image: url("project://database/Assets/_TacticalFive/Art/Resources/Backgrounds/banner_premios.png");
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
    min-height: 90px;
}
.draft-banner-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(15, 17, 23, 0.80);
}
.draft-banner-left {
    position: relative;
    flex-direction: column;
    flex-grow: 1;
}
.draft-banner-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 28px;
    letter-spacing: 3px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
    margin-bottom: 4px;
}
.draft-banner-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(160, 170, 190);
}
.draft-banner-pick-box {
    position: relative;
    flex-direction: row;
    align-items: center;
    background-color: rgba(212, 160, 23, 0.15);
    border-width: 2px;
    border-color: rgb(212, 160, 23);
    padding: 8px 20px;
    flex-shrink: 0;
}
.draft-banner-round {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    color: rgb(212, 160, 23);
    margin-right: 12px;
}
.draft-banner-pick {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 20px;
    color: rgb(255, 255, 255);
}

/* ── 3-COLUMN LAYOUT ── */
.draft-columns {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    padding: 12px;
}
.draft-col-left {
    flex: 3;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    margin-right: 12px;
}
.draft-col-center {
    flex: 5;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    margin-right: 12px;
}
.draft-col-right {
    flex: 3;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}
.draft-col-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    flex-shrink: 0;
}
.draft-col-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
}
.draft-col-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin-right: 8px;
    background-size: contain;
    background-position: center;
    opacity: 0.7;
}
.draft-col-count {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 12px;
    color: rgb(122, 138, 170);
    margin-left: auto;
}

/* ── PROSPECT LIST ── */
.draft-list-body {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
}
.draft-prospect {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    margin-bottom: 2px;
    flex-shrink: 0;
    min-height: 56px;
}
.draft-prospect:hover {
    background-color: rgb(28, 33, 48);
}
.draft-prospect--selected {
    background-color: rgba(212, 160, 23, 0.15);
    border-color: rgb(212, 160, 23);
    border-width: 2px;
}
.draft-prospect-num {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(212, 160, 23);
    min-width: 28px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-right: 8px;
}
.draft-prospect-photo {
    width: 44px;
    height: 44px;
    border-radius: 4px;
    flex-shrink: 0;
    margin-right: 10px;
    background-size: cover;
    background-position: center;
    background-color: rgb(42, 51, 71);
}
.draft-prospect-info {
    flex-direction: column;
    flex-grow: 1;
    overflow: hidden;
    min-width: 0;
}
.draft-prospect-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: rgb(255, 255, 255);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.draft-prospect-meta {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 11px;
    color: rgb(122, 138, 170);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.draft-prospect-med {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    min-width: 32px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-left: 6px;
}
.draft-prospect-med--high {
    color: rgb(39, 174, 96);
}
.draft-prospect-med--mid {
    color: rgb(212, 160, 23);
}
.draft-prospect-med--low {
    color: rgb(192, 57, 43);
}

/* ── CENTER: PLAYER CARD ── */
.draft-player-card {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}
.draft-card-top {
    flex-direction: row;
    align-items: flex-start;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 16px;
    margin-bottom: 10px;
    flex-shrink: 0;
}
.draft-card-pick-box {
    flex-direction: column;
    align-items: center;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 8px 12px;
    margin-right: 16px;
    flex-shrink: 0;
}
.draft-card-pick-num {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 28px;
    color: rgb(255, 255, 255);
}
.draft-card-pick-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 12px;
    background-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
    padding: 2px 8px;
    margin-top: 4px;
}
.draft-card-info {
    flex-direction: column;
    flex-grow: 1;
}
.draft-card-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    color: rgb(255, 255, 255);
    -unity-text-transform: upper;
    margin-bottom: 4px;
}
.draft-card-college {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(122, 138, 170);
    margin-bottom: 4px;
}
.draft-card-bio {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 13px;
    color: rgb(160, 170, 190);
}
.draft-card-photo {
    width: 120px;
    height: 120px;
    border-radius: 6px;
    flex-shrink: 0;
    margin-left: 16px;
    background-size: cover;
    background-position: top;
    background-color: rgb(42, 51, 71);
}
.draft-card-ovr-badge {
    flex-direction: column;
    align-items: center;
    margin-left: 16px;
    flex-shrink: 0;
}
.draft-card-ovr-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 10px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(160, 170, 190);
    margin-bottom: 4px;
}
.draft-card-ovr-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 42px;
    color: rgb(212, 160, 23);
}

/* ── STAT BOXES ── */
.draft-stat-boxes {
    flex-direction: row;
    margin-bottom: 10px;
    flex-shrink: 0;
}
.draft-stat-box {
    flex: 1;
    flex-direction: column;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 10px 8px;
    margin-right: 10px;
}
.draft-stat-box:last-child {
    margin-right: 0;
}
.draft-stat-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 11px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(122, 138, 170);
    margin-bottom: 4px;
}
.draft-stat-value {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 24px;
    color: rgb(255, 255, 255);
}

/* ── PLAYER DESCRIPTION ── */
.draft-card-desc {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 13px;
    color: rgb(160, 170, 190);
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 10px 14px;
    margin-bottom: 10px;
    flex-shrink: 0;
    flex-grow: 1;
    overflow: hidden;
}

/* ── TEAM NEEDS ── */
.draft-team-needs {
    flex-direction: column;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    padding: 12px 16px;
    margin-bottom: 10px;
    flex-shrink: 0;
}
.draft-needs-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 13px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(212, 160, 23);
    margin-bottom: 8px;
}
.draft-team-logo {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    margin-bottom: 10px;
}
.draft-needs-row {
    flex-direction: row;
    justify-content: space-around;
}
.draft-need {
    flex-direction: column;
    align-items: center;
}
.draft-need-badge {
    width: 40px;
    height: 40px;
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
}
.draft-need-val {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
}
.draft-need-pos {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 11px;
    color: rgb(122, 138, 170);
}
.draft-need-badge--high {
    background-color: rgba(39, 174, 96, 0.20);
    border-width: 2px;
    border-color: rgb(39, 174, 96);
}
.draft-need-badge--high .draft-need-val {
    color: rgb(39, 174, 96);
}
.draft-need-badge--mid {
    background-color: rgba(212, 160, 23, 0.20);
    border-width: 2px;
    border-color: rgb(212, 160, 23);
}
.draft-need-badge--mid .draft-need-val {
    color: rgb(212, 160, 23);
}
.draft-need-badge--low {
    background-color: rgba(192, 57, 43, 0.20);
    border-width: 2px;
    border-color: rgb(192, 57, 43);
}
.draft-need-badge--low .draft-need-val {
    color: rgb(192, 57, 43);
}

/* ── ACTION BUTTONS ── */
.draft-actions {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 8px 0;
}
.btn-draft-pick {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    width: 280px;
    background-color: rgb(212, 160, 23);
    border-width: 0;
    color: rgb(0, 0, 0);
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 12px 24px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.btn-draft-pick:hover {
    background-color: rgb(240, 192, 64);
}
.btn-draft-pick:disabled {
    opacity: 0.4;
    background-color: rgb(42, 51, 71);
    color: rgb(122, 138, 170);
}
.btn-auto-pick {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 14px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    padding: 10px 20px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-left: 12px;
}
.btn-auto-pick:hover {
    background-color: rgb(74, 128, 240);
}
.draft-action-arrow {
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    background-color: rgb(28, 33, 48);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    flex-shrink: 0;
    margin: 0 8px;
}
.draft-action-arrow:hover {
    border-color: rgb(212, 160, 23);
}
.draft-action-arrow-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
}

/* ── DRAFT LOG ── */
.draft-log-entry {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    margin-bottom: 2px;
    flex-shrink: 0;
    min-height: 44px;
}
.draft-log-entry--user {
    border-left-width: 3px;
    border-left-color: rgb(42, 95, 201);
}
.draft-log-entry--current {
    border-color: rgb(212, 160, 23);
    border-width: 2px;
    background-color: rgba(212, 160, 23, 0.08);
}
.draft-log-num {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 14px;
    color: rgb(212, 160, 23);
    min-width: 30px;
    flex-shrink: 0;
    margin-right: 6px;
}
.draft-log-logo {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin-right: 8px;
}
.draft-log-info {
    flex-direction: column;
    flex-grow: 1;
    overflow: hidden;
}
.draft-log-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 12px;
    color: rgb(208, 216, 232);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.draft-log-player {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 11px;
    color: rgb(122, 138, 170);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.draft-log-pend {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 11px;
    color: rgb(82, 98, 130);
    font-style: italic;
}

/* ══ LOTTERY MODAL ══ */
.lottery-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    display: none;
}
.lottery-box {
    width: 1100px;
    background-color: rgb(15, 17, 23);
    border-width: 1px;
    border-color: rgb(58, 74, 99);
    border-top-width: 3px;
    border-top-color: rgb(212, 160, 23);
    padding: 32px;
    flex-direction: column;
    align-items: center;
}
.lottery-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 4px;
    color: rgb(212, 160, 23);
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}
.lottery-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    margin-bottom: 24px;
    -unity-text-align: middle-center;
}
.lottery-grid {
    flex-direction: row;
    width: 100%;
}
.lottery-column {
    flex: 1;
    flex-direction: column;
}
.lottery-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    margin-bottom: 4px;
    min-height: 44px;
}
.lottery-rank {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(122, 138, 170);
    min-width: 30px;
    flex-shrink: 0;
}
.lottery-logo {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin-right: 10px;
}
.lottery-name {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.lottery-pct {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(212, 160, 23);
    min-width: 50px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}
.lottery-close-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(42, 95, 201);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    padding: 10px 32px;
    border-radius: 4px;
    margin-top: 24px;
}
.lottery-close-btn:hover {
    background-color: rgb(74, 128, 240);
}
.lottery-draft-row {
    min-height: 64px;
}
.lottery-draft-row .lottery-rank {
    color: rgb(212, 160, 23);
}
.lottery-draft-team {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    color: rgb(212, 160, 23);
    margin-bottom: 2px;
    white-space: normal;
}
.lottery-draft-player {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
}

/* ══ PAGINATION (shared) ══ */
.draft-pagination {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-height: 40px;
    padding: 4px 12px;
    background-color: rgb(17, 24, 34);
    border-top-width: 1px;
    border-top-color: rgb(42, 51, 71);
}
.draft-page-btn {
    width: 34px;
    height: 28px;
    padding: 4px;
    margin: 0 8px;
    align-items: center;
    justify-content: center;
    color: rgb(122, 138, 170);
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 3px;
    -unity-text-align: middle-center;
}
.draft-page-btn:hover {
    color: rgb(212, 160, 23);
    border-color: rgb(212, 160, 23);
}
.draft-page-btn:disabled {
    color: rgb(55, 65, 84);
    background-color: rgb(17, 24, 34);
    border-color: rgb(28, 33, 48);
}
.draft-page-icon {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 12px;
}
.draft-page-label {
    min-width: 60px;
    height: 24px;
    flex-shrink: 0;
    font-size: 14px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    color: rgb(208, 216, 232);
    -unity-text-align: middle-center;
}
