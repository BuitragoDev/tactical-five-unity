/* ── GAME RESULTS SCREEN ─────────────────────── */

.gresults-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: #0f1117;
}

.gresults-main {
    flex: 1;
    flex-direction: column;
    overflow: hidden;
}

.gresults-scroll {
    flex: 1;
}

.gresults-content {
    flex-direction: column;
    padding: 20px 28px;
}

.gresults-layout {
    flex-direction: row;
    align-items: flex-start;
}

.gresults-layout > * {
    margin-right: 24px;
}

.gresults-left {
    flex: 1;
    flex-direction: column;
}

.gresults-left > * {
    margin-bottom: 10px;
}

.gresults-right {
    width: 420px;
    flex-shrink: 0;
    flex-direction: column;
}

.gresults-right > * {
    margin-bottom: 16px;
}

.gresults-section-header {
    flex-direction: row;
    align-items: center;
    padding-bottom: 12px;
    border-bottom: 1px solid #2a3347;
    margin-bottom: 4px;
}

.gresults-section-header > * {
    margin-right: 10px;
}

.gresults-section-title {
    font-size: 16px;
    font-weight: 600;
    color: #d4a017;
    -unity-text-transform: upper;
    letter-spacing: 2px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
}

.games-body {
    flex-direction: column;
}

.games-body > * {
    margin-bottom: 10px;
}

/* ── TOP HEADER (MatchDay style) ─────────── */

.top-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 28px;
    background-color: #161a24;
    border-bottom-width: 2px;
    border-bottom-color: #d4a017;
    flex-shrink: 0;
}

.header-left {
    flex-direction: row;
    align-items: center;
    gap: 16px;
}

.header-team-logo {
    width: 52px;
    height: 52px;
}

.header-team-info {
    flex-direction: column;
    gap: 2px;
}

.header-team-name-row {
    flex-direction: row;
    align-items: baseline;
    gap: 12px;
}

.header-team-name {
    font-size: 22px;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 1px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
}

.header-subtitle {
    font-size: 13px;
    font-weight: 500;
    color: #d4a017;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-left: 12px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-SemiBold.ttf");
}

.header-manager-name {
    font-size: 14px;
    color: #7a8aaa;
}

.header-right-group {
    flex-direction: row;
    align-items: center;
    gap: 20px;
}

.header-season-info {
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
}

.header-season-label {
    font-size: 16px;
    font-weight: 600;
    color: #d4a017;
    letter-spacing: 1px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
}

.header-date-label {
    font-size: 16px;
    font-weight: 500;
    color: #7a8aaa;
    letter-spacing: 1px;
    padding: 0 12px;
    border-left-width: 1px;
    border-left-color: #2a3347;
    border-right-width: 1px;
    border-right-color: #2a3347;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
}

.header-game-day-label {
    font-size: 14px;
    font-weight: 600;
    color: #4a80f0;
    letter-spacing: 1px;
    text-transform: uppercase;
    background-color: rgba(42, 95, 201, 0.15);
    padding: 6px 14px;
    border-radius: 4px;
    margin-left: 20px;
    margin-right: 20px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
}

.btn-action {
    background-color: #2a5fc9;
    border-width: 0;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 8px 18px;
    border-radius: 4px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
}

/* ── GAME CARDS ────────────────────── */

.game-card {
    background-color: #1c2130;
    border: 1px solid #2a3347;
    border-radius: 8px;
    padding: 6px 24px;
}

.game-card.my-game {
    border-color: #d4a017;
    background-color: rgba(212, 160, 23, 0.04);
}

.game-card-content {
    flex-direction: row;
    align-items: center;
}

.game-card-team-side {
    flex: 1;
    flex-direction: row;
    align-items: center;
}

.game-card-team-side.team-side-first {
    justify-content: flex-end;
}

.game-card-logo {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    margin-right: 20px;
}

.game-card-team-side.team-side-first .game-card-logo {
    margin-left: 20px;
    margin-right: 0;
}

.game-card-team-name {
    font-size: 18px;
    font-weight: 600;
    color: #d0d8e8;
    letter-spacing: 0.5px;
    -unity-text-transform: upper;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
}

.game-card-team-name.my-team {
    color: #d4a017;
    font-weight: 700;
}

.game-card-team-side.team-side-first .game-card-team-name {
    text-align: right;
}

.game-card-score {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 6px 16px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 4px;
    margin: 0 16px;
    flex-shrink: 0;
    width: 120px;
}

.game-card-score-home {
    flex: 1;
    font-size: 24px;
    font-weight: 700;
    color: #ffffff;
    -unity-text-align: middle-left;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
}

.game-card-score-sep {
    flex-shrink: 0;
    font-size: 18px;
    font-weight: 400;
    color: #7a8aaa;
    min-width: 14px;
    -unity-text-align: middle-center;
    margin-left: 4px;
    margin-right: 4px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
}

.game-card-score-away {
    flex: 1;
    font-size: 24px;
    font-weight: 700;
    color: #ffffff;
    -unity-text-align: middle-right;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
}

/* ── MVP PANEL ──────────────────────── */

.mvp-panel {
    background-color: #1c2130;
    border: 1px solid #d4a017;
    border-radius: 8px;
    padding: 20px;
    min-height: 130px;
}

.mvp-badge {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid #2a3347;
}

.mvp-badge > * {
    margin-right: 8px;
}

.mvp-badge-text {
    font-size: 13px;
    font-weight: 700;
    color: #d4a017;
    -unity-text-transform: upper;
    letter-spacing: 2px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
}

.mvp-content {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 70px;
}

.mvp-player-info {
    flex-direction: row;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
}

.mvp-team-logo {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    margin-right: 16px;
}

.mvp-player-details {
    flex-direction: column;
    gap: 4px;
    flex-shrink: 0;
}

.mvp-player-name {
    font-size: 18px;
    font-weight: 700;
    color: #ffffff;
    -unity-text-transform: upper;
    letter-spacing: 0.5px;
    line-height: 1.15;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
}

.mvp-player-team {
    font-size: 12px;
    color: #7a8aaa;
    margin-top: 2px;
    margin-bottom: 2px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
}

.mvp-player-pos {
    font-size: 11px;
    font-weight: 600;
    color: #7a8aaa;
    letter-spacing: 1.5px;
    -unity-text-transform: upper;
    background-color: #161a24;
    padding: 2px 6px;
    border-radius: 3px;
    margin-top: 2px;
    align-self: flex-start;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
}

.mvp-stats {
    flex-direction: row;
    flex-shrink: 0;
    gap: 30px;
    margin-left: 30px;
}

.mvp-stat {
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-width: 30px;
}

.mvp-stat-val {
    font-size: 22px;
    font-weight: 700;
    color: #ffffff;
    min-width: 30px;
    text-align: center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
}

.mvp-stat-label {
    font-size: 10px;
    font-weight: 600;
    color: #7a8aaa;
    letter-spacing: 1.5px;
    -unity-text-transform: upper;
    min-width: 30px;
    text-align: center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
}

.mvp-rating .mvp-stat-val {
    color: #d4a017;
}

/* ── LEADERBOARDS ───────────────────── */

.leaderboards {
    flex-direction: column;
    gap: 16px;
}

.leaderboard-section {
    background-color: #1c2130;
    border: 1px solid #2a3347;
    border-radius: 8px;
    overflow: hidden;
}

.leaderboard-title {
    flex-direction: row;
    align-items: center;
    padding: 10px 16px;
    background-color: rgba(212, 160, 23, 0.06);
    border-bottom: 1px solid #2a3347;
    font-size: 13px;
    font-weight: 600;
    color: #d4a017;
    -unity-text-transform: upper;
    letter-spacing: 1.5px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
}

.leaderboard-title > * {
    margin-right: 8px;
}

.leaderboard-body {
    flex-direction: column;
}

.lb-row {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    border-bottom: 1px solid rgba(42, 51, 71, 0.4);
}

.lb-row:last-child {
    border-bottom: none;
}

.lb-row.my-player {
    background-color: transparent;
}

.lb-rank {
    width: 20px;
    text-align: center;
    font-size: 14px;
    font-weight: 700;
    color: #7a8aaa;
    flex-shrink: 0;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
}

.lb-rank.lb-first {
    color: #d4a017;
}

.lb-logo {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-right: 6px;
}

.lb-info {
    flex: 1;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
}

.lb-name {
    font-size: 14px;
    font-weight: 600;
    color: #d0d8e8;
    letter-spacing: 0.3px;
    -unity-text-wrap-mode: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
}

.lb-team {
    font-size: 11px;
    color: #7a8aaa;
    letter-spacing: 0.5px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
}

.lb-value {
    font-size: 18px;
    font-weight: 700;
    color: #ffffff;
    flex-shrink: 0;
    min-width: 30px;
    text-align: right;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
}
