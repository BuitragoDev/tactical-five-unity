<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Messages.uss" />
    <Style src="../Dashboard/Dashboard.uss" />
    <Style src="../LegalNotice/LegalNotice.uss" />

    <ui:VisualElement name="MessagesRoot" class="messages-root">

        <!-- ══ SIDEBAR ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="messages-main">

            <!-- ══ HEADER ══ -->
            <ui:VisualElement class="screen-header panel--gold">
                <ui:VisualElement class="screen-header-row">
                    <ui:VisualElement name="MessagesScreenIcon" class="screen-icon" />
                    <ui:Label class="screen-title" text="{loc:ui.messages.tablon_de_noticias}" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- MESSAGES CONTENT -->
            <ui:VisualElement class="messages-content">

                <!-- Title -->
                <ui:VisualElement class="messages-header-row">
                    <ui:Label class="messages-header-icon" text="&#128227;" />
                    <ui:VisualElement class="messages-header-text">
                        <ui:Label class="messages-title" text="{loc:ui.messages.noticias}" />
                        <ui:Label class="messages-subtitle" text="{loc:ui.messages.lo_ultimo_en_el_mundo_del_baloncesto}" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Toolbar -->
                <ui:VisualElement class="messages-toolbar">
                    <ui:VisualElement name="FilterTabs" class="messages-filter-tabs">
                        <ui:Button name="FilterTodas" class="messages-filter-tab messages-filter-tab--active" text="{loc:ui.messages.filter_todas}" />
                        <ui:Button name="FilterClub" class="messages-filter-tab" text="{loc:ui.messages.filter_club}" />
                        <ui:Button name="FilterLiga" class="messages-filter-tab" text="{loc:ui.messages.filter_liga}" />
                        <ui:Button name="FilterTraspasos" class="messages-filter-tab" text="{loc:ui.messages.filter_traspasos}" />
                        <ui:Button name="FilterLesiones" class="messages-filter-tab" text="{loc:ui.messages.filter_lesiones}" />
                        <ui:Button name="FilterPrensa" class="messages-filter-tab" text="{loc:ui.messages.filter_prensa}" />
                    </ui:VisualElement>
                    <ui:VisualElement class="messages-search-box">
                        <ui:Label class="messages-search-icon" text="&#128269;" />
                        <ui:TextField name="SearchField" class="messages-search-field" placeholder-text="{loc:ui.messages.search_field}" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Content: list + detail -->
                <ui:VisualElement class="messages-content-row">

                    <!-- List column -->
                    <ui:VisualElement class="messages-list-col">
                        <ui:VisualElement class="messages-scroll-row">
                            <ui:VisualElement name="MessagesViewport" class="messages-viewport">
                                <ui:VisualElement name="MessagesBody" class="messages-body" />
                            </ui:VisualElement>
                            <ui:VisualElement name="MessagesScrollTrack" class="messages-scrollbar">
                                <ui:VisualElement name="MessagesScrollThumb" class="messages-scrollbar-thumb" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Detail panel -->
                    <ui:VisualElement name="NewsDetailPanel" class="news-detail-panel">
                        <ui:VisualElement name="NewsDetailContent" class="news-detail-content">
                            <ui:VisualElement name="NewsDetailPhoto" class="news-detail-photo" />
                            <ui:Label name="NewsDetailDate" class="news-detail-date" text="" />
                            <ui:Label name="NewsDetailTitle" class="news-detail-title" text="" />
                            <ui:Label name="NewsDetailBody" class="news-detail-body" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement name="NewsDetailFooter" class="news-detail-footer">
                            <ui:Button name="BtnDeleteNews" text="{loc:ui.messages.btn_delete_news}" class="news-delete-button" />
                        </ui:VisualElement>
                        <ui:Label name="NewsDetailEmpty" class="news-detail-empty" text="{loc:ui.messages.news_detail_empty}" />
                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

        <!-- ══ MODAL CONFIGURACIÓN ══ -->
        <ui:VisualElement name="ConfigModalOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigModalBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.messages.configuracion}" />
                <ui:VisualElement class="modal-body">
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.messages.audio}" />
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.messages.volumen_general}" />
                            <ui:VisualElement name="ConfigSliderMaster" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMaster" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMaster" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMaster" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.messages.musica}" />
                            <ui:VisualElement name="ConfigSliderMusic" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillMusic" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerMusic" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelMusic" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:VisualElement class="settings-row">
                            <ui:Label class="settings-label" text="{loc:ui.messages.efectos}" />
                            <ui:VisualElement name="ConfigSliderSFX" class="custom-slider">
                                <ui:VisualElement class="custom-slider-track" />
                                <ui:VisualElement name="ConfigFillSFX" class="custom-slider-fill" />
                                <ui:VisualElement name="ConfigDraggerSFX" class="custom-slider-dragger" />
                            </ui:VisualElement>
                            <ui:Label name="ConfigLabelSFX" class="settings-value" text="100%" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.messages.graficos}" />
                        <ui:VisualElement class="settings-quality-row">
                            <ui:Label class="settings-label" text="{loc:ui.messages.calidad}" />
                            <ui:VisualElement class="settings-quality-options">
                                <ui:Button name="ConfigBtnQualityLow" class="settings-quality-btn" text="{loc:ui.messages.config_btn_quality_low}" />
                                <ui:Button name="ConfigBtnQualityMedium" class="settings-quality-btn" text="{loc:ui.messages.config_btn_quality_medium}" />
                                <ui:Button name="ConfigBtnQualityHigh" class="settings-quality-btn" text="{loc:ui.messages.config_btn_quality_high}" />
                                <ui:Button name="ConfigBtnQualityUltra" class="settings-quality-btn" text="{loc:ui.messages.config_btn_quality_ultra}" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section">
                        <ui:Label class="settings-section-title" text="{loc:ui.messages.juego}" />
                        <ui:Button name="ConfigBtnMainMenu" class="settings-btn settings-btn--secondary" text="{loc:ui.messages.config_btn_main_menu}" />
                        <ui:Button name="ConfigBtnExit" class="settings-btn settings-btn--danger" text="{loc:ui.messages.config_btn_exit}" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="ConfigBtnCerrar" class="modal-close" text="{loc:ui.messages.config_btn_cerrar}" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR VOLVER AL MENÚ PRINCIPAL ══ -->
        <ui:VisualElement name="ConfigMainMenuConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigMainMenuConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.messages.volver_al_menu_principal}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.messages.estas_seguro_de_que_quieres_volver_al_me_6f548452}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.messages.se_perdera_el_progreso_no_guardado_de_la_b10b7334}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnMainMenuNo" class="modal-btn modal-btn--secondary" text="{loc:ui.messages.config_btn_main_menu_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnMainMenuYes" class="modal-btn modal-btn--danger" text="{loc:ui.messages.config_btn_main_menu_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ══ MODAL CONFIRMAR SALIR DEL JUEGO ══ -->
        <ui:VisualElement name="ConfigExitConfirmOverlay" class="modal-overlay">
            <ui:VisualElement name="ConfigExitConfirmBox" class="modal-box">
                <ui:Label class="modal-title" text="{loc:ui.messages.salir_del_juego}" />
                <ui:VisualElement class="modal-body">
                    <ui:Label class="modal-paragraph modal-paragraph--highlight" text="{loc:ui.messages.estas_seguro_de_que_quieres_salir_del_ju_c65dd5f1}" />
                    <ui:Label class="modal-paragraph" text="{loc:ui.messages.tu_progreso_se_guarda_automaticamente_du_10fb1edb}" />
                </ui:VisualElement>
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="ConfigBtnExitNo" class="modal-btn modal-btn--secondary" text="{loc:ui.messages.config_btn_exit_no}" />
                    <ui:VisualElement class="modal-spacer" />
                    <ui:Button name="ConfigBtnExitYes" class="modal-btn modal-btn--danger" text="{loc:ui.messages.config_btn_exit_yes}" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

</ui:UXML>
