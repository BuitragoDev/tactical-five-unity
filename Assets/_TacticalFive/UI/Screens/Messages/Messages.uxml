<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">

    <Style src="Messages.uss" />
    <Style src="../Dashboard/Dashboard.uss" />

    <ui:VisualElement name="MessagesRoot" class="messages-root">

        <!-- ══ SIDEBAR ══ -->

        <!-- ══ MAIN ══ -->
        <ui:VisualElement class="messages-main">

            <!-- TOP HEADER -->

            <!-- MESSAGES TITLE BOX -->
            <ui:VisualElement class="messages-title-box">
                <ui:Label class="messages-title-box-label" text="MENSAJES" />
            </ui:VisualElement>

            <!-- MESSAGES CONTENT -->
            <ui:VisualElement class="messages-content">

                <!-- Title -->
                <ui:VisualElement class="messages-title-row">
                    <ui:Label class="messages-icon" text="📫" />
                    <ui:Label class="messages-title" text="BANDEJA DE ENTRADA" />
                </ui:VisualElement>

                <!-- Message list -->
                <ui:ScrollView class="messages-scroll"
                               horizontal-scrolling-enabled="false"
                               mode="Vertical">
                    <ui:VisualElement name="MessagesBody" class="messages-body" />
                </ui:ScrollView>

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
