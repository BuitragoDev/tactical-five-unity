/* ══════════════════════════════════════════
   MESSAGES — Messages.uss
   ══════════════════════════════════════════ */

.messages-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.messages-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.messages-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 24px 30px;
    min-height: 0;
    overflow: hidden;
}

/* ── HEADER ── */
.messages-header-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
    flex-shrink: 0;
}

.messages-header-icon {
    font-size: 32px;
    margin-right: 12px;
    color: rgb(248, 196, 64);
}

.messages-header-text {
    flex-direction: column;
}

.messages-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 28px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(255, 255, 255);
}

.messages-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(122, 138, 170);
    margin-top: 2px;
}

/* ── TOOLBAR ── */
.messages-toolbar {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 16px;
    flex-shrink: 0;
}

.messages-filter-tabs {
    flex-direction: row;
    align-items: center;
}

.messages-filter-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 6px;
    padding: 8px 14px;
    margin-right: 4px;
    cursor: pointer;
    -unity-text-align: middle-center;
    min-width: 0;
    white-space: nowrap;
}

.messages-filter-tab:hover {
    background-color: rgb(30, 36, 52);
}

.messages-filter-tab--active {
    background-color: rgb(42, 95, 201);
    border-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
}

.messages-filter-tab--active:hover {
    background-color: rgb(52, 105, 211);
}

/* Search bar */
.messages-search-box {
    flex-direction: row;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 6px;
    padding: 8px 12px;
    margin-left: 12px;
    min-width: 410px;
}

.messages-search-icon {
    font-size: 18px;
    color: rgb(122, 138, 170);
    margin-right: 8px;
}

.messages-search-field {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    background-color: transparent;
    border-width: 0;
    min-width: 300px;
}

.messages-search-field::placeholder {
    color: rgb(85, 102, 119);
    font-size: 18px;
}

/* ── SCROLL ── */
.messages-scroll {
    flex-grow: 1;
    min-height: 0;
}

.messages-root .messages-scroll .unity-scroll-view__content-viewport {
    overflow: hidden;
    padding: 0;
}

.messages-root .messages-scroll .unity-scroll-view__content-container {
    flex-grow: 1;
    padding: 0;
}

.messages-root .messages-body {
    flex-direction: column;
    width: 100%;
    padding: 0;
}

/* ── NEWS CARD ── */
.news-card {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    width: 50%;
    flex-shrink: 0;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    padding: 14px 16px;
    margin-bottom: 10px;
}

.news-card:hover {
    background-color: rgb(28, 33, 48);
    border-color: rgb(58, 74, 99);
}

.news-card--unread {
    border-color: rgb(212, 160, 23);
}

/* ── Card Photo ── */
.news-card-photo {
    width: 100px;
    height: 100px;
    border-radius: 6px;
    flex-shrink: 0;
    margin-right: 16px;
    overflow: hidden;
    -unity-background-scale-mode: scale-to-fit;
}

/* ── Card Text ── */
.news-card-text {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.news-card-badge-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.news-card-date {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    background-color: rgba(42, 95, 201, 0.85);
    border-radius: 3px;
    padding: 2px 8px;
    margin-right: 8px;
    flex-shrink: 0;
}

.news-card-badge {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    padding: 2px 8px;
    border-radius: 3px;
    margin-right: 8px;
    flex-shrink: 0;
}

.news-card-badge--club {
    background-color: rgba(42, 95, 201, 0.20);
    color: rgb(100, 150, 230);
}

.news-card-badge--liga {
    background-color: rgba(39, 174, 96, 0.20);
    color: rgb(100, 200, 140);
}

.news-card-badge--traspasos {
    background-color: rgba(168, 85, 247, 0.20);
    color: rgb(180, 140, 240);
}

.news-card-badge--lesiones {
    background-color: rgba(192, 57, 43, 0.20);
    color: rgb(230, 120, 100);
}

.news-card-badge--prensa {
    background-color: rgba(122, 138, 170, 0.20);
    color: rgb(179, 190, 214);
}

.news-card-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(255, 255, 255);
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.news-card--unread .news-card-title {
    color: rgb(255, 255, 255);
}

.news-card-body {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 2px;
    max-height: 56px;
}

/* ── Card Arrow ── */
.news-card-arrow {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-left: 12px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(85, 102, 119);
}

/* ── PAGINATOR ── */
.messages-paginator {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    flex-shrink: 0;
    padding-top: 12px;
}

.messages-paginator-btn {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: transparent;
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(100, 150, 230);
    font-size: 14px;
    padding: 6px 14px;
    border-radius: 6px;
    cursor: pointer;
    -unity-text-align: middle-center;
    min-width: 0;
}

.messages-paginator-btn:hover {
    background-color: rgba(42, 95, 201, 0.15);
}

.messages-paginator-btn--disabled {
    border-color: rgb(42, 51, 71);
    color: rgb(60, 70, 90);
    cursor: default;
}

.messages-paginator-btn--disabled:hover {
    background-color: transparent;
}

.messages-paginator-label {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    color: rgb(208, 216, 232);
    margin-left: 16px;
    margin-right: 16px;
}

/* ── EMPTY STATE ── */
.messages-empty {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 60px 0;
}

.messages-empty-icon {
    font-size: 48px;
    margin-bottom: 16px;
    color: rgb(85, 102, 119);
}

.messages-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-left;
}

/* ── NEWS MODAL ── */
.news-modal-box {
    width: 600px;
    background-color: rgb(13, 14, 18);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    border-radius: 12px;
    padding: 0;
    flex-direction: column;
    align-items: flex-start;
    overflow: hidden;
    position: relative;
}

.news-modal-photo {
    width: 128px;
    height: 128px;
    border-radius: 8px;
    margin-top: 24px;
    margin-left: 24px;
    -unity-background-scale-mode: scale-to-fit;
}

.news-modal-date {
    position: absolute;
    top: 10px;
    right: 10px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    background-color: rgba(42, 95, 201, 0.85);
    border-radius: 4px;
    padding: 4px 10px;
}

.news-modal-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(255, 255, 255);
    letter-spacing: 1px;
    -unity-text-align: middle-left;
    white-space: normal;
    margin-top: 16px;
    margin-left: 24px;
    margin-right: 24px;
}

.news-modal-body {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 16px;
    color: rgb(179, 190, 214);
    white-space: normal;
    -unity-text-align: middle-left;
    margin-top: 12px;
    margin-left: 24px;
    margin-right: 24px;
}

.news-modal-close {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    align-self: stretch;
    background-color: rgba(42, 95, 201, 0.10);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    color: rgb(100, 150, 230);
    font-size: 16px;
    letter-spacing: 1px;
    padding: 9px 20px;
    -unity-text-align: middle-center;
    border-radius: 8px;
    cursor: pointer;
    margin-top: 20px;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 20px;
    min-width: 0;
    white-space: normal;
}

.news-modal-close:hover {
    background-color: rgba(42, 95, 201, 0.25);
}
