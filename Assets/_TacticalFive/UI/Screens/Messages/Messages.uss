/* ══════════════════════════════════════════
   MESSAGES — Messages.uss
   ══════════════════════════════════════════ */

.messages-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.messages-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.messages-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 20px;
    min-height: 0;
}

.messages-scroll {
    flex-grow: 1;
    min-height: 0;
}

.messages-body {
    flex-direction: column;
}

.message-item {
    flex-direction: row;
    align-items: center;
    padding: 12px 16px;
    background-color: rgb(22, 26, 36);
    border-bottom-width: 1px;
    border-bottom-color: rgb(28, 33, 48);
}

.message-item--unread {
    background-color: rgb(28, 33, 48);
    border-left-width: 3px;
    border-left-color: rgb(248, 196, 64);
}

.message-sender {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 12px;
    color: rgb(85, 102, 119);
    width: 120px;
    flex-shrink: 0;
}

.message-subject-preview {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 14px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
    margin-right: 16px;
}

.message-date-preview {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 12px;
    color: rgb(58, 74, 99);
    width: 80px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

.message-detail {
    flex-direction: column;
    padding: 20px;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 2px;
    margin-top: 20px;
}

.btn-back {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 12px;
    letter-spacing: 1px;
    -unity-text-transform: upper;
    color: rgb(208, 216, 232);
    background-color: rgb(42, 51, 71);
    border-width: 0;
    border-radius: 2px;
    padding: 8px 16px;
    min-width: 100px;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
    align-self: flex-start;
}

.btn-back:hover {
    background-color: rgb(58, 74, 99);
}

.message-subject {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 20px;
    color: rgb(208, 216, 232);
    margin-bottom: 8px;
}

.message-date {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 12px;
    color: rgb(58, 74, 99);
    margin-bottom: 16px;
}

.message-body {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 14px;
    color: rgb(208, 216, 232);
    -unity-text-align: upper-left;
    white-space: normal;
}
