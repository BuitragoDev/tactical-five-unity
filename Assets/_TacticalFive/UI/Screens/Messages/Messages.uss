/* ══════════════════════════════════════════
   MESSAGES — Messages.uss
   ══════════════════════════════════════════ */

.messages-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ══ SCREEN HEADER ══ */
.screen-header.panel--gold {
    flex-shrink: 0;
    padding: 0;
    margin: 16px 20px 12px 20px;
    border-width: 1px;
    border-color: rgb(212, 160, 23);
    background-color: rgb(33, 32, 28);
    border-radius: 4px;
    overflow: hidden;
}
.screen-header-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 14px;
    background-color: rgb(33, 32, 28);
}
.screen-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}
.screen-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 32px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    white-space: normal;
}

.messages-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.messages-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 24px 30px;
    min-height: 0;
    overflow: hidden;
}

.messages-content-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
}

.messages-list-col {
    flex-direction: column;
    /* Ancho fijo: con flex-grow el ancho dependía del contenido de cada noticia y
       la columna se movía al ir seleccionando. */
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 875px;
    width: 875px;
    min-height: 0;
}

/* ── HEADER ── */
.messages-header-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
    flex-shrink: 0;
}

.messages-header-icon {
    font-size: 32px;
    margin-right: 12px;
    color: rgb(248, 196, 64);
}

.messages-header-text {
    flex-direction: column;
}

.messages-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 28px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgb(255, 255, 255);
}

.messages-subtitle {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 14px;
    color: rgb(122, 138, 170);
    margin-top: 2px;
}

/* ── TOOLBAR ── */
.messages-toolbar {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 16px;
    flex-shrink: 0;
}

.messages-filter-tabs {
    flex-direction: row;
    align-items: center;
}

.messages-filter-tab {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 1px;
    color: rgb(122, 138, 170);
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 6px;
    padding: 8px 14px;
    margin-right: 4px;
    cursor: pointer;
    -unity-text-align: middle-center;
    min-width: 0;
    white-space: nowrap;
}

.messages-filter-tab:hover {
    background-color: rgb(30, 36, 52);
}

.messages-filter-tab--active {
    background-color: rgb(42, 95, 201);
    border-color: rgb(42, 95, 201);
    color: rgb(255, 255, 255);
}

.messages-filter-tab--active:hover {
    background-color: rgb(52, 105, 211);
}

/* Search bar */
.messages-search-box {
    flex-direction: row;
    align-items: center;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 6px;
    padding: 8px 12px;
    margin-left: 12px;
    min-width: 360px;
}

.messages-search-icon {
    font-size: 18px;
    color: rgb(122, 138, 170);
    margin-right: 8px;
}

.messages-search-field {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(208, 216, 232);
    background-color: transparent;
    border-width: 0;
    min-width: 300px;
}

.messages-search-field::placeholder {
    color: rgb(85, 102, 119);
    font-size: 18px;
}

/* ── SCROLL ── */
.messages-scroll {
    flex-grow: 1;
    min-height: 0;
}

.messages-root .messages-scroll .unity-scroll-view__content-viewport {
    overflow: hidden;
    padding: 0;
}

.messages-root .messages-scroll .unity-scroll-view__content-container {
    flex-grow: 1;
    padding: 0;
}

.messages-root .messages-body {
    flex-direction: column;
    width: 100%;
    padding: 0;
}

/* ── NEWS CARD ── */
.news-card {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    flex-shrink: 0;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 8px;
    padding: 19px 16px;
    margin-bottom: 10px;
}

.news-card:hover {
    background-color: rgb(28, 33, 48);
    border-color: rgb(58, 74, 99);
}

.news-card--unread {
    border-color: rgb(212, 160, 23);
}

/* ── Card Photo ── */
.news-card-photo {
    width: 100px;
    height: 100px;
    border-radius: 6px;
    flex-shrink: 0;
    margin-right: 16px;
    overflow: hidden;
    -unity-background-scale-mode: scale-to-fit;
}

/* ── Card Text ── */
.news-card-text {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.news-card-badge-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.news-card-date {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    background-color: rgb(38, 84, 175);
    border-radius: 3px;
    padding: 2px 8px;
    margin-right: 8px;
    flex-shrink: 0;
}

.news-card-badge {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    padding: 2px 8px;
    border-radius: 3px;
    margin-right: 8px;
    flex-shrink: 0;
}

.news-card-badge--club {
    background-color: rgb(23, 36, 63);
    color: rgb(100, 150, 230);
}

.news-card-badge--liga {
    background-color: rgb(22, 52, 42);
    color: rgb(100, 200, 140);
}

.news-card-badge--traspasos {
    background-color: rgb(48, 34, 72);
    color: rgb(180, 140, 240);
}

.news-card-badge--lesiones {
    background-color: rgb(53, 28, 31);
    color: rgb(230, 120, 100);
}

.news-card-badge--prensa {
    background-color: rgb(39, 44, 56);
    color: rgb(179, 190, 214);
}

.news-card-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 18px;
    color: rgb(255, 255, 255);
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.news-card--unread .news-card-title {
    color: rgb(255, 255, 255);
}

.news-card-body {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(122, 138, 170);
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 2px;
    max-height: 56px;
}

/* ── Card Arrow ── */
.news-card-arrow {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-left: 12px;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(85, 102, 119);
}

/* ── SCROLLBAR (blue) ── */

.messages-scroll-row {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.messages-viewport {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    position: relative;
}

.messages-body {
    flex-shrink: 0;
}

.messages-scrollbar {
    width: 12px;
    min-width: 12px;
    flex-shrink: 0;
    align-self: stretch;
    margin-left: 4px;
    background-color: rgb(18, 24, 34);
    border-left-width: 1px;
    border-left-color: rgb(26, 47, 89);
    position: relative;
}

.messages-scrollbar-thumb {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 0;
    height: 40px;
    background-color: rgb(42, 95, 201);
    border-radius: 3px;
}
.messages-scrollbar:hover .messages-scrollbar-thumb {
    background-color: rgb(70, 130, 230);
}

/* ── EMPTY STATE ── */
.messages-empty {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 60px 0;
}

.messages-empty-icon {
    font-size: 48px;
    margin-bottom: 16px;
    color: rgb(85, 102, 119);
}

.messages-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-left;
}

/* ── NEWS DETAIL PANEL ── */
.news-detail-panel {
    /* Ocupa el espacio restante: con flex-basis 0 su tamaño no depende del texto. */
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-left: 16px;
    background-color: rgb(13, 14, 18);
    border-width: 2px;
    border-color: rgb(42, 95, 201);
    border-radius: 12px;
    padding: 0;
    flex-direction: column;
    align-items: flex-start;
    overflow: hidden;
    position: relative;
}

.news-detail-content {
    flex-direction: column;
    align-items: flex-start;
    flex-grow: 1;
    align-self: stretch;
    overflow: hidden;
}

.news-detail-photo {
    width: 128px;
    height: 128px;
    border-radius: 8px;
    margin-top: 24px;
    margin-left: 24px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.news-detail-date {
    position: absolute;
    top: 10px;
    right: 10px;
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    background-color: rgb(38, 84, 175);
    border-radius: 4px;
    padding: 4px 10px;
}

.news-detail-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    font-size: 22px;
    color: rgb(255, 255, 255);
    letter-spacing: 1px;
    -unity-text-align: middle-left;
    white-space: normal;
    margin-top: 16px;
    margin-left: 24px;
    margin-right: 24px;
}

.news-detail-body {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(179, 190, 214);
    white-space: normal;
    -unity-text-align: middle-left;
    margin-top: 12px;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 24px;
}

.news-detail-empty {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Regular.ttf");
    font-size: 18px;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
    align-self: stretch;
    flex-grow: 1;
    padding: 40px 24px;
}

.news-detail-footer {
    flex-direction: row;
    justify-content: flex-end;
    align-self: stretch;
    padding: 12px 24px;
    flex-shrink: 0;
}

.news-delete-button {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/Saira_Condensed-Bold.ttf");
    background-color: rgb(35, 25, 30);
    border-width: 2px;
    border-color: rgb(192, 57, 43);
    color: rgb(230, 120, 100);
    font-size: 18px;
    letter-spacing: 1px;
    padding: 6px 14px;
    -unity-text-align: middle-center;
    border-radius: 8px;
    min-width: 0;
    white-space: normal;
    cursor: pointer;
}

.news-delete-button:hover {
    background-color: rgb(62, 30, 32);
    color: rgb(240, 145, 125);
}

.news-card--selected {
    border-color: rgb(42, 95, 201);
    background-color: rgb(28, 33, 48);
}
