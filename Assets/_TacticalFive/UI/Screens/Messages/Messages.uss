/* ══════════════════════════════════════════
   MESSAGES — Messages.uss
   ══════════════════════════════════════════ */

.messages-root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: rgb(15, 17, 23);
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.messages-main {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.messages-content {
    flex-direction: column;
    flex-grow: 1;
    padding: 24px 30px;
    min-height: 0;
}

/* Title row */
.messages-title-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(42, 51, 71);
}

.messages-icon {
    font-size: 20px;
    margin-right: 10px;
    color: rgb(248, 196, 64);
}

.messages-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-transform: upper;
    color: rgb(248, 196, 64);
}

/* Scroll area */
.messages-scroll {
    flex-grow: 1;
    min-height: 0;
}

.messages-body {
    flex-direction: column;
}

/* Message Card */
.message-card {
    flex-direction: column;
    background-color: rgb(22, 26, 36);
    border-width: 1px;
    border-color: rgb(42, 51, 71);
    border-radius: 6px;
    padding: 16px 20px;
    margin-bottom: 12px;
}

.message-card--unread {
    background-color: rgb(28, 33, 48);
    border-color: rgb(58, 74, 99);
}

.message-card-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.message-card-title {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    color: rgb(208, 216, 232);
    flex-grow: 1;
}

.message-card--unread .message-card-title {
    color: rgb(255, 255, 255);
}

.message-card-delete {
    width: 32px;
    height: 32px;
    background-color: transparent;
    border-width: 0;
    color: rgb(85, 102, 119);
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 16px;
    -unity-text-align: middle-center;
    padding: 0;
    margin-left: 8px;
}

.message-card-delete:hover {
    color: rgb(192, 57, 43);
}

.message-card-date {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 12px;
    color: rgb(85, 102, 119);
    margin-bottom: 8px;
}

.message-card-body {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 13px;
    color: rgb(150, 160, 180);
    white-space: normal;
}

/* Empty state */
.messages-empty {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.messages-empty-text {
    -unity-font: url("project://database/Assets/_TacticalFive/Art/Fonts/BarlowCondensed-Regular.ttf");
    font-size: 14px;
    color: rgb(85, 102, 119);
    -unity-text-align: middle-center;
}
